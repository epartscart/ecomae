<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EcomAE.Platform</RootNamespace>
    <AssemblyName>EcomAE.Platform</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="FluentFTP" Version="54.2.1" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Migration/Data/erp-guide-modules.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Storefront/Captcha/*" />
    <EmbeddedResource Include="Storefront/Captcha/*" LogicalName="EcomAE.Platform.Captcha.%(Filename)%(Extension)" />
    <None Remove="Storefront/Templates/MyOrder*.html" />
    <EmbeddedResource Include="Storefront/Templates/MyOrder*.html" LogicalName="EcomAE.Platform.Storefront.Templates.%(Filename)%(Extension)" />
    <None Remove="Storefront/Templates/Cart*.html" />
    <EmbeddedResource Include="Storefront/Templates/Cart*.html" LogicalName="EcomAE.Platform.Storefront.Templates.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
