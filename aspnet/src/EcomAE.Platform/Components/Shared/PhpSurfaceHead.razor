@using EcomAE.Platform.Presentation
@*
  Puts PHP-matching webfonts + stylesheets (+ optional hero/login scripts) into <head> via HeadOutlet.
  Body-scoped <link> tags were unreliable for presentation parity probes.
*@
<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    @foreach (var href in FontHrefs)
    {
        <link rel="stylesheet" href="@href" />
    }
    <link rel="stylesheet" href="@LegacyPhpFontAssets.FontAwesomeCdn" />
    @foreach (var href in StylesheetHrefs)
    {
        <link rel="stylesheet" href="@href" />
    }
    @if (IncludeStorefrontAnalytics)
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@GaMeasurementId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){ dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', '@GaMeasurementId');
        </script>
        @if (!string.IsNullOrWhiteSpace(ClarityProjectId))
        {
            <script type="text/javascript">
                window.addEventListener("load", function () {
                    (function (c, l, a, r, i, t, y) {
                        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments) };
                        t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
                        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
                    })(window, document, "clarity", "script", "@ClarityProjectId");
                }, { once: true });
            </script>
        }
    }
    @if (ApplyStorefrontIndustryAttrs)
    {
        <script>
            (function () {
                var root = document.documentElement;
                root.setAttribute('data-epc-industry', '@_industryCode');
                root.setAttribute('data-epc-storefront', '@_storefrontPackage');
            })();
        </script>
    }
    @if (IncludePublicSeo && _request is not null)
    {
        <meta name="theme-color" content="#dc2626" />
        <meta name="description" content="@_seoDescription" />
        <meta name="keywords" content="@StorefrontPublicSeo.DefaultKeywords" />
        <meta name="robots" content="index,follow" />
        <link rel="canonical" href="@_canonical" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="@_canonical" />
        <meta property="og:title" content="@_seoTitle" />
        <meta property="og:description" content="@_seoDescription" />
        @foreach (var alt in StorefrontPublicSeo.HreflangAlternates(_request))
        {
            <link rel="alternate" hreflang="@alt.Hreflang" href="@alt.Href" />
        }
        @((MarkupString)StorefrontPublicSeo.JsonLdBlock(_request, _seoTitle))
    }
    @if (IncludeBosLoginScripts)
    {
        @foreach (var src in LegacyPresentationAssets.BosLoginScripts)
        {
            <script src="@src" defer></script>
        }
    }
    @if (IncludeMarketingScripts)
    {
        @foreach (var src in LegacyPresentationAssets.MarketingScripts)
        {
            <script src="@src" defer></script>
        }
    }
    <meta name="ecomae-chrome-surface" content="@Surface" />
    <meta name="ecomae-chrome-hero" content="@(IncludeLoginCss || ApplyStorefrontIndustryAttrs || IncludeBosLoginScripts || IncludeMarketingScripts || IsBosSurface ? "1" : "0")" />

@if (Surface.Equals("cp", StringComparison.OrdinalIgnoreCase)
     || Surface.Equals("erp", StringComparison.OrdinalIgnoreCase))
{
    @* Delegated BOC mega-menu + Super ERP tab binder installs on the FIRST full
       page load (often the login page) — Blazor enhanced navigation never
       executes scripts that arrive with swapped content, which left the Super
       CP top menu (and Super ERP tabs) dead. *@
    <PhpBocTopnavBinder />
}
</HeadContent>

@code {
    [Parameter, EditorRequired] public string Surface { get; set; } = "cp";
    [Parameter] public bool IncludeLoginCss { get; set; }
    [Parameter] public bool IncludeStorefrontAnalytics { get; set; }
    [Parameter] public bool ApplyStorefrontIndustryAttrs { get; set; }
    [Parameter] public bool IncludeBosLoginScripts { get; set; }
    [Parameter] public bool IncludeMarketingScripts { get; set; }
    /// <summary>Emit PHP-parity public SEO (canonical, OG, hreflang, JSON-LD). Storefront home only.</summary>
    [Parameter] public bool IncludePublicSeo { get; set; }
    [Parameter] public string GaMeasurementId { get; set; } = "G-J19D1KHXCG";
    /// <summary>Matches PHP epc_portal_clarity_project_id for epartscart.com.</summary>
    [Parameter] public string ClarityProjectId { get; set; } = "xoflbamawu";

    [Inject] private IHttpContextAccessor Http { get; set; } = default!;

    private string _industryCode = "auto_parts";
    private string _storefrontPackage = "automotive_spareparts_pro";
    private HttpRequest? _request;
    private string _canonical = "/";
    private string _seoTitle = StorefrontPublicSeo.DefaultDescription;
    private string _seoDescription = StorefrontPublicSeo.DefaultDescription;

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        _request = ctx?.Request;
        if (_request is not null && IncludePublicSeo)
        {
            var host = _request.Host.Host;
            _seoTitle = StorefrontIndustryHostResolver.ResolveStorefrontTitle(host);
            _seoDescription = StorefrontPublicSeo.DefaultDescription;
            _canonical = StorefrontPublicSeo.CanonicalForStorefrontHome(_request);
        }

        if (!ApplyStorefrontIndustryAttrs)
        {
            return;
        }

        var attrs = StorefrontIndustryHostResolver.Resolve(ctx?.Request.Host.Host);
        _industryCode = attrs.IndustryCode;
        _storefrontPackage = attrs.StorefrontPackage;
    }

    private bool IsBosSurface => Surface.Equals("bos", StringComparison.OrdinalIgnoreCase);

    private IEnumerable<string> FontHrefs => LegacyPhpFontAssets.FontHrefsFor(Surface);

    private IEnumerable<string> StylesheetHrefs
    {
        get
        {
            var list = new List<string>(LegacyPresentationAssets.StylesheetsFor(Surface));
            if (IncludeLoginCss)
            {
                foreach (var href in LegacyPresentationAssets.LoginStylesheets)
                {
                    if (!list.Contains(href, StringComparer.OrdinalIgnoreCase))
                    {
                        list.Add(href);
                    }
                }

                if (Surface.Equals("erp", StringComparison.OrdinalIgnoreCase))
                {
                    foreach (var href in LegacyPresentationAssets.ErpLoginStylesheets)
                    {
                        if (!list.Contains(href, StringComparer.OrdinalIgnoreCase))
                        {
                            list.Add(href);
                        }
                    }
                }
            }

            return list;
        }
    }
}
