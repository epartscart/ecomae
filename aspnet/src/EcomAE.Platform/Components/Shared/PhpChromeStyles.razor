    @@media (max-width: 700px) {
        .epc-module-visual-frame { grid-template-columns: auto minmax(0, 1fr); }
        .epc-module-visual-frame__flow,
        .epc-module-visual-frame__scope { grid-column: 2; text-align: left; }
