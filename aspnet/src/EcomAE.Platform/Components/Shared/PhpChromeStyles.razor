        display: grid;
        width: 38px;
        height: 38px;
        place-items: center;
        border-radius: 11px;
        background: linear-gradient(145deg, #0b1f3a, #1769aa);
        color: #fff;
        box-shadow: 0 5px 12px rgba(23, 105, 170, .22);
    }

    .epc-module-visual-frame__eyebrow {
        color: var(--epc-enterprise-blue);
        font-size: 9px;
        font-weight: 850;
        letter-spacing: .13em;
        text-transform: uppercase;
