@using EcomAE.Platform.Presentation
@*
  PHP chrome stylesheet/font injection for product shells.
  Delegates to PhpSurfaceHead so assets land in <head> (HeadOutlet).
  Always applies PHP document.body classes so body.epc-cp-shell selectors fire.
*@
<PhpChromeBodyClass Surface="@Surface" LoginChrome="false" />
<link rel="stylesheet" href="/platform-assets/eparts-animated-logo.css" />
<PhpSurfaceHead
    Surface="@Surface"
    IncludeLoginCss="false"
    IncludeStorefrontAnalytics="@(Surface.Equals("storefront", StringComparison.OrdinalIgnoreCase))"
    ApplyStorefrontIndustryAttrs="@(Surface.Equals("storefront", StringComparison.OrdinalIgnoreCase))"
    IncludeMarketingScripts="@(Surface.Equals("marketing", StringComparison.OrdinalIgnoreCase))" />
@* Body <style> duplicates HeadContent — live SSR drops HeadOutlet on product shells. *@
<HeadContent>
<style>
    :root {
        --epc-php-font: @(LegacyPhpFontAssets.StackFor(Surface));
        --epc-php-font-size: @(LegacyPhpFontAssets.FontSizeFor(Surface));
    }
    .epc-php-font-root,
    html, body {
        font-family: var(--epc-php-font);
        font-size: var(--epc-php-font-size);
    }
</style>
</HeadContent>
<style>
    :root {
        --epc-php-font: @(LegacyPhpFontAssets.StackFor(Surface));
        --epc-php-font-size: @(LegacyPhpFontAssets.FontSizeFor(Surface));
    }
    .epc-php-font-root,
    html, body {
        font-family: var(--epc-php-font);
        font-size: var(--epc-php-font-size);
    }
</style>


@code {
    [Parameter, EditorRequired] public string Surface { get; set; } = "cp";
}
