@using System.Globalization
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject IHttpContextAccessor Http

<section class="eg-guide" aria-label="How to use every area">
    <nav class="eg-guide__jump" aria-label="Guide sections">
        @foreach (var board in ErpAreaUseGuide.Boards)
        {
            <a href="@("#cat-" + board.CategoryId)">@board.Category</a>
        }
    </nav>
    @foreach (var board in ErpAreaUseGuide.Boards)
    {
        <h2 class="eg-guide__cat" id="@("cat-" + board.CategoryId)">@board.Category</h2>
        @foreach (var lane in board.Lanes)
        {
            <div class="eg-guide__lane" id="@ErpAreaUseGuide.Anchor(lane.AreaId)">
                <p class="eg-guide__lane-name"><i class="fa @lane.Icon" aria-hidden="true"></i> @lane.Title</p>
                <p class="eg-guide__use">@lane.Use</p>
                @StepTrack(lane.Steps, 0)
                @if (lane.JewellerySteps.Count > 0)
                {
                    <p class="eg-guide__more">Jewellery</p>
                    @StepTrack(lane.JewellerySteps, lane.Steps.Count)
                }
            </div>
        }
    }
</section>

<style>
    .eg-guide { margin: 0 0 16px; display: flex; flex-direction: column; gap: 14px; }
    .eg-guide__jump { display: flex; flex-wrap: wrap; gap: 6px; }
    .eg-guide__jump a { display: inline-flex; padding: .35rem .65rem; border-radius: 999px; border: 1px solid #c5d4de; background: #fff; color: #1d4ed8; text-decoration: none; font-size: 12px; font-weight: 700; }
    .eg-guide__cat { margin: 8px 0 0; font-size: 15px; color: #0f2744; }
    .eg-guide__lane {
        padding: 14px 16px 16px;
        border: 1px solid #d5e3f2;
        border-radius: 16px;
        background:
            radial-gradient(720px 120px at 8% 0%, rgba(37, 99, 235, .10), transparent 60%),
            linear-gradient(180deg, #f8fbff 0%, #f3f7fb 100%);
    }
    .eg-guide__lane-name {
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #1d4ed8;
    }
    .eg-guide__use { margin: 6px 0 0; max-width: 68rem; color: #1e3a5f; font-size: 13px; font-weight: 600; line-height: 1.4; }
    .eg-guide__more { margin: 12px 0 0; font-size: 11px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: #0f766e; }
    .eg-guide__track { list-style: none; display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: 6px 0; margin: 10px 0 0; padding: 4px 0 0; }
    .eg-guide__step { display: flex; align-items: center; }
    .eg-guide__step a { position: relative; display: flex; flex-direction: column; align-items: center; width: 118px; text-decoration: none; color: #1e3a5f; }
    .eg-guide__step a:hover .eg-guide__icon, .eg-guide__step a:focus-visible .eg-guide__icon { transform: translateY(-2px); }
    .eg-guide__step a:focus-visible { outline: 2px solid #2563eb; outline-offset: 3px; border-radius: 12px; }
    .eg-guide__badge { position: absolute; top: -2px; left: 22px; min-width: 18px; height: 18px; padding: 0 4px; border-radius: 999px; background: #fff; border: 1px solid #d5e3f2; color: #3d4f66; font-size: 10px; font-weight: 800; line-height: 16px; text-align: center; z-index: 1; }
    .eg-guide__icon { width: 58px; height: 58px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; box-shadow: 0 8px 16px rgba(15, 39, 68, .14); transition: transform .16s ease; }
    .eg-guide__icon i { font-size: 22px; }
    .eg-guide__name { margin-top: 8px; font-size: 12px; font-weight: 700; line-height: 1.25; text-align: center; }
    .tone-0 .eg-guide__icon { background: linear-gradient(160deg, #3b82f6, #1d4ed8); }
    .tone-1 .eg-guide__icon { background: linear-gradient(160deg, #14b8a6, #0f766e); }
    .tone-2 .eg-guide__icon { background: linear-gradient(160deg, #f59e0b, #b45309); }
    .tone-3 .eg-guide__icon { background: linear-gradient(160deg, #8b5cf6, #6d28d9); }
    .tone-4 .eg-guide__icon { background: linear-gradient(160deg, #fb7185, #be123c); }
    .eg-guide__join { display: flex; align-items: center; justify-content: center; width: 44px; margin-top: 18px; }
    .eg-guide__svg { display: block; width: 52px; height: 16px; }
    .eg-guide__line { fill: none; stroke: #3b82f6; stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 5 7; animation: eg-guide-dash 1.05s linear infinite; }
    .eg-guide__head { fill: none; stroke: #1d4ed8; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
    @@keyframes eg-guide-dash { to { stroke-dashoffset: -24; } }
    @@media (max-width: 720px) {
        .eg-guide__track { flex-direction: column; align-items: stretch; }
        .eg-guide__step { width: 100%; }
        .eg-guide__step a { flex-direction: row; width: auto; gap: 12px; }
        .eg-guide__name { margin-top: 0; text-align: left; }
        .eg-guide__badge { left: 0; top: -4px; }
        .eg-guide__join { transform: rotate(90deg); margin: 2px auto; width: auto; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .eg-guide__line { animation: none; stroke-dasharray: none; }
        .eg-guide__step a:hover .eg-guide__icon { transform: none; }
    }
</style>

@code {
    private string Href(string href)
        => ClientErpPath.PrefixIfBound(Http.HttpContext, href);

    private RenderFragment StepTrack(IReadOnlyList<ErpAreaUseGuide.Step> steps, int toneStart) => builder =>
    {
        builder.OpenElement(0, "ol");
        builder.AddAttribute(1, "class", "eg-guide__track");
        var seq = 2;
        for (var i = 0; i < steps.Count; i++)
        {
            var step = steps[i];
            var paint = "tone-" + ((toneStart + i) % 5).ToString(CultureInfo.InvariantCulture);
            builder.OpenElement(seq++, "li");
            builder.AddAttribute(seq++, "class", "eg-guide__step " + paint);
            builder.OpenElement(seq++, "a");
            builder.AddAttribute(seq++, "href", Href(step.Href));
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "eg-guide__badge");
            builder.AddContent(seq++, step.Number.ToString(CultureInfo.InvariantCulture));
            builder.CloseElement();
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "eg-guide__icon");
            builder.AddAttribute(seq++, "aria-hidden", "true");
            builder.OpenElement(seq++, "i");
            builder.AddAttribute(seq++, "class", "fa " + step.Icon);
            builder.CloseElement();
            builder.CloseElement();
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "eg-guide__name");
            builder.AddContent(seq++, step.Label);
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();
            if (i < steps.Count - 1)
            {
                builder.OpenElement(seq++, "li");
                builder.AddAttribute(seq++, "class", "eg-guide__join");
                builder.AddAttribute(seq++, "aria-hidden", "true");
                builder.AddMarkupContent(seq++, """<svg class="eg-guide__svg" viewBox="0 0 56 16" focusable="false"><line class="eg-guide__line" x1="2" y1="8" x2="44" y2="8" /><polyline class="eg-guide__head" points="36,3 48,8 36,13" /></svg>""");
                builder.CloseElement();
            }
        }

        builder.CloseElement();
    };
}
