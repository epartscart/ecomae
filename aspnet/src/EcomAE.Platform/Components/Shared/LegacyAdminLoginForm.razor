@using EcomAE.Platform.Auth
@inject ILegacyAdminLoginService LoginService
@inject IHttpContextAccessor Http

<div class="epc-login-form">
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="epc-login-error" id="wrong_authentication">@ErrorMessage</div>
    }
    else
    {
        <div class="epc-login-error" id="wrong_authentication" style="display:none"></div>
    }

    @if (!LoginService.IsConfigured)
    {
        <div class="epc-login-error" style="display:block;background:#fff7ed;color:#9a3412;border-color:#fdba74;margin-bottom:.85rem;">
            Sign-in is temporarily unavailable on this host. Please contact your platform administrator.
            Guest browse is disabled — confidential data requires login.
        </div>
    }

    <PhpOAuthLoginButtons Context="@OAuthContext"
                          ReturnUrl="@RedirectPath"
                          Heading="Sign in faster — no password autofill"
                          ShowDividerBelow="true"
                          Tone="default" />
    <LoginAntiAutofill />

    @* Post to the same surface login URL (already nginx-proxied). Middleware handles the POST. *@
    <form method="post" action="@LoginPostHref" class="epc-login-html-form"
          autocomplete="off" data-lpignore="true" data-1p-ignore="true" data-form-type="other"
          aria-disabled="@(!LoginService.IsConfigured)">
        <input type="hidden" name="surface" value="@SurfaceKey" />
        <input type="hidden" name="redirect" value="@RedirectPath" />
        @* Decoy fields absorb browser autofill so real credentials stay blank. *@
        <div aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;">
            <input type="text" name="epc_autofill_decoy_user" tabindex="-1" autocomplete="username" value="" />
            <input type="password" name="epc_autofill_decoy_pass" tabindex="-1" autocomplete="current-password" value="" />
        </div>
        <div class="epc-login-field">
            <label for="auth_contact_select_@SurfaceKey">Log in by</label>
            <select id="auth_contact_select_@SurfaceKey" name="contact_type" disabled="@(!LoginService.IsConfigured)" autocomplete="off">
                <option value="email">E-mail</option>
                <option value="phone">Phone</option>
            </select>
        </div>
        <div class="epc-login-field">
            <label for="auth_contact_@SurfaceKey">E-mail</label>
            <input id="auth_contact_@SurfaceKey" class="form-control" name="contact" type="text"
                   placeholder="Enter your E-mail" autocomplete="off"
                   autocapitalize="none" autocorrect="off" spellcheck="false"
                   data-lpignore="true" data-1p-ignore="true" data-bwignore="true"
                   data-epc-anti-autofill="1" readonly="readonly"
                   disabled="@(!LoginService.IsConfigured)" required="@LoginService.IsConfigured" />
        </div>
        <div class="epc-login-field">
            <label for="password_@SurfaceKey">Password</label>
            <input id="password_@SurfaceKey" class="form-control" name="password" type="password"
                   placeholder="Enter password" autocomplete="new-password"
                   data-lpignore="true" data-1p-ignore="true" data-bwignore="true"
                   data-epc-anti-autofill="1" readonly="readonly"
                   disabled="@(!LoginService.IsConfigured)" required="@LoginService.IsConfigured" />
        </div>
        <div class="epc-login-field epc-login-row">
            <label>
                <input type="checkbox" name="remember_me" value="1" disabled="@(!LoginService.IsConfigured)" /> Remember me
            </label>
        </div>
        @if (LoginService.IsConfigured)
        {
            <button type="submit" class="epc-login-submit epc-login-submit-@Accent">@SubmitLabel</button>
        }
        else
        {
            <button type="button" class="epc-login-submit epc-login-submit-@Accent" disabled
                    style="opacity:.55;cursor:not-allowed;">@SubmitLabel (unavailable)</button>
        }
    </form>

    <p class="epc-login-bridge-note">
        After login you continue in <a class="epc-login-shell" href="@ShellHref">@ShellLabel</a>.
    </p>
</div>

@code {
    [Parameter, EditorRequired] public LegacyLoginSurface Surface { get; set; }
    [Parameter, EditorRequired] public string SurfaceLabel { get; set; } = "CP";
    /// <summary>Legacy parameter name kept for call sites; must be a /php-reference/* URL only.</summary>
    [Parameter, EditorRequired] public string PhpLoginHref { get; set; } = "/php-reference/cp";
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string SubmitLabel { get; set; } = "Log in";
    [Parameter] public string Accent { get; set; } = "blue";

    private string SurfaceKey => Surface switch
    {
        LegacyLoginSurface.Erp => "erp",
        LegacyLoginSurface.Bos => "bos",
        LegacyLoginSurface.Storefront => "storefront",
        _ => "cp"
    };

    private string OAuthContext => Surface == LegacyLoginSurface.Storefront ? "storefront" : "cp";

    private string LoginPostHref => Surface switch
    {
        LegacyLoginSurface.Erp => EcomAE.Platform.Routing.EcomAeRoutes.ErpLogin,
        LegacyLoginSurface.Bos => EcomAE.Platform.Routing.EcomAeRoutes.BosLogin,
        LegacyLoginSurface.Storefront => EcomAE.Platform.Routing.EcomAeRoutes.StorefrontLogin,
        _ => EcomAE.Platform.Routing.EcomAeRoutes.ControlPanelLogin
    };

    private string RedirectPath
    {
        get
        {
            var q = Http.HttpContext?.Request.Query["returnUrl"].ToString();
            if (!string.IsNullOrWhiteSpace(q)
                && q.StartsWith('/')
                && !q.StartsWith("//", StringComparison.Ordinal)
                && !q.Contains("://", StringComparison.Ordinal))
            {
                return q;
            }

            return Surface switch
            {
                LegacyLoginSurface.Erp => "/erp",
                LegacyLoginSurface.Bos => "/bos",
                LegacyLoginSurface.Storefront => "/",
                _ => "/cp"
            };
        }
    }

    private string ShellHref => Surface switch
    {
        LegacyLoginSurface.Erp => "/erp",
        LegacyLoginSurface.Bos => "/bos",
        LegacyLoginSurface.Storefront => "/",
        _ => "/cp"
    };

    private string ShellLabel => Surface switch
    {
        LegacyLoginSurface.Erp => "ERP",
        LegacyLoginSurface.Bos => "BOS",
        LegacyLoginSurface.Storefront => "the storefront",
        _ => "Control Panel"
    };
}
