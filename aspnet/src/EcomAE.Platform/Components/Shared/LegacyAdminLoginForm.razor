@using EcomAE.Platform.Auth
@inject ILegacyAdminLoginService LoginService

<div class="epc-login-form">
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="epc-login-error" id="wrong_authentication">@ErrorMessage</div>
    }
    else
    {
        <div class="epc-login-error" id="wrong_authentication" style="display:none"></div>
    }

    @* Guest browse first — works even when SecretSuccession is unset. *@
    <div class="epc-login-guest" style="margin:0 0 1rem;padding:.85rem 1rem;border-radius:.5rem;background:#eff6ff;border:1px solid #bfdbfe;color:#1e3a8a;">
        <strong style="display:block;margin-bottom:.35rem;">Enter without credentials</strong>
        <p style="margin:0 0 .75rem;font-size:.9rem;line-height:1.45;">
            Open the ASP.NET @SurfaceLabel shell now. Sign-in is only needed for live KPIs / writes.
        </p>
        <a class="epc-login-submit epc-login-submit-@Accent"
           style="display:inline-flex;width:auto;padding:.75rem 1.2rem;text-decoration:none;align-items:center;font-size:1rem;"
           href="@ShellHref"
           data-epc-guest-browse="1">Enter @SurfaceLabel (no login)</a>
    </div>

    @if (!LoginService.IsConfigured)
    {
        <div class="epc-login-error" style="display:block;background:#fff7ed;color:#9a3412;border-color:#fdba74;margin-bottom:.85rem;">
            Sign-in bridge is not configured on this host yet
            (<code>EcomAE__SecretSuccession</code>). Credential submit will fail until that is set —
            use <strong>Enter @SurfaceLabel (no login)</strong> above.
        </div>
    }

    <p style="margin:.15rem 0 .65rem;font-size:.82rem;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:.04em;">
        @(LoginService.IsConfigured ? "Or sign in with credentials" : "Credential fields (bridge not configured)")
    </p>

    <form method="post" action="@EcomAE.Platform.Routing.EcomAeRoutes.LegacyAdminLogin" class="epc-login-html-form" aria-disabled="@(!LoginService.IsConfigured)">
        <input type="hidden" name="surface" value="@SurfaceKey" />
        <input type="hidden" name="redirect" value="@RedirectPath" />
        <div class="epc-login-field">
            <label for="auth_contact_select_@SurfaceKey">Log in by</label>
            <select id="auth_contact_select_@SurfaceKey" name="contact_type" disabled="@(!LoginService.IsConfigured)">
                <option value="email">E-mail</option>
                <option value="phone">Phone</option>
            </select>
        </div>
        <div class="epc-login-field">
            <label for="auth_contact_@SurfaceKey">E-mail</label>
            <input id="auth_contact_@SurfaceKey" class="form-control" name="contact" type="text"
                   placeholder="Enter your E-mail" autocomplete="username"
                   disabled="@(!LoginService.IsConfigured)" required="@LoginService.IsConfigured" />
        </div>
        <div class="epc-login-field">
            <label for="password_@SurfaceKey">Password</label>
            <input id="password_@SurfaceKey" class="form-control" name="password" type="password"
                   placeholder="Enter password" autocomplete="current-password"
                   disabled="@(!LoginService.IsConfigured)" required="@LoginService.IsConfigured" />
        </div>
        <div class="epc-login-field epc-login-row">
            <label>
                <input type="checkbox" name="remember_me" value="1" disabled="@(!LoginService.IsConfigured)" /> Remember me
            </label>
        </div>
        @if (LoginService.IsConfigured)
        {
            <button type="submit" class="epc-login-submit epc-login-submit-@Accent">@SubmitLabel</button>
        }
        else
        {
            <button type="button" class="epc-login-submit epc-login-submit-@Accent" disabled
                    style="opacity:.55;cursor:not-allowed;">@SubmitLabel (unavailable)</button>
        }
    </form>

    <p class="epc-login-bridge-note">
        Shell: <a class="epc-login-php" href="@ShellHref">@ShellHref</a>
        · Archive: <a class="epc-login-php" href="@PhpReferenceHref">@PhpReferenceHref</a>
    </p>
</div>

@code {
    [Parameter, EditorRequired] public LegacyLoginSurface Surface { get; set; }
    [Parameter, EditorRequired] public string SurfaceLabel { get; set; } = "CP";
    /// <summary>Legacy parameter name kept for call sites; must be a /php-reference/* URL only.</summary>
    [Parameter, EditorRequired] public string PhpLoginHref { get; set; } = "/php-reference/cp";
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string SubmitLabel { get; set; } = "Log in";
    [Parameter] public string Accent { get; set; } = "blue";

    private string SurfaceKey => Surface switch
    {
        LegacyLoginSurface.Erp => "erp",
        LegacyLoginSurface.Bos => "bos",
        LegacyLoginSurface.Storefront => "storefront",
        _ => "cp"
    };

    private string RedirectPath => Surface switch
    {
        LegacyLoginSurface.Erp => "/erp",
        LegacyLoginSurface.Bos => "/bos",
        LegacyLoginSurface.Storefront => "/",
        _ => "/cp"
    };

    private string ShellHref => Surface switch
    {
        LegacyLoginSurface.Erp => "/erp",
        LegacyLoginSurface.Bos => "/bos",
        LegacyLoginSurface.Storefront => "/",
        _ => "/cp"
    };

    private string PhpReferenceHref =>
        string.IsNullOrWhiteSpace(PhpLoginHref) || !PhpLoginHref.StartsWith("/php-reference/", StringComparison.OrdinalIgnoreCase)
            ? Surface switch
            {
                LegacyLoginSurface.Erp => "/php-reference/erp",
                LegacyLoginSurface.Bos => "/php-reference/bos",
                LegacyLoginSurface.Storefront => "/php-reference/home",
                _ => "/php-reference/cp"
            }
            : PhpLoginHref;
}
