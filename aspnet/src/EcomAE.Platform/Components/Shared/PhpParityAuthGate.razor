@using EcomAE.Platform.Auth
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

@*
  Guest-browse gate: never hard-redirect to login.
  Product shells must remain visible without credentials; Sign in stays a soft CTA.
*@
@if (_ready)
{
    @ChildContent
}

@code {
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    /// <summary>Retained for call sites; unused — guest browse does not force login.</summary>
    [Parameter] public string LoginPath { get; set; } = "/cp/login";
    /// <summary>Retained for call sites; unused — guest browse does not require admin.</summary>
    [Parameter] public bool RequireAdmin { get; set; } = true;

    private bool _ready = true;

    protected override Task OnInitializedAsync()
    {
        // Always render ChildContent. Session checks belong in page KPI loaders.
        _ = Sessions;
        _ = Http;
        _ = LoginPath;
        _ = RequireAdmin;
        _ready = true;
        return Task.CompletedTask;
    }
}
