@using EcomAE.Platform.Auth
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

@*
  Hard gate for confidential admin Blazor pages (belt-and-suspenders with
  AdminSurfaceAuthGateMiddleware). Guest browse of Control is not allowed.
*@
@if (_ready && _allowed)
{
    @ChildContent
}

@code {
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public string LoginPath { get; set; } = "/cp/login";
    [Parameter] public bool RequireAdmin { get; set; } = true;

    private bool _ready;
    private bool _allowed;

    protected override async Task OnInitializedAsync()
    {
        if (!RequireAdmin)
        {
            _allowed = true;
            _ready = true;
            return;
        }

        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            _allowed = false;
            _ready = true;
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _allowed = session.Kind == LegacySessionKind.Admin
            && (session.HasBackendAccess
                || session.Capabilities.Contains("cp", StringComparer.OrdinalIgnoreCase)
                || session.Capabilities.Contains("erp", StringComparer.OrdinalIgnoreCase)
                || session.Capabilities.Contains("bos", StringComparer.OrdinalIgnoreCase));

        if (!_allowed)
        {
            var path = ctx.Request.Path + ctx.Request.QueryString;
            var target = LoginPath + "?returnUrl=" + Uri.EscapeDataString(path);
            Nav.NavigateTo(target, forceLoad: true);
        }

        _ready = true;
    }
}
