@using System.Text.Json
@*
  Login universe atmosphere (background only):
  - NASA / Webb deep-space photo with slow drift
  - Falling star-dots (same bosFloat motion as before)
  - Round moons + planets (CSS spheres) falling — never glyph icons on top
*@

<div class="bos-login__bg bos-login__bg--universe bos-login__bg--@Theme"
     data-bos-atmosphere="@Theme"
     data-bos-industry="@Industry"
     aria-hidden="true">
    <div class="bos-login__universe"
         style="background-image:url('@UniverseImageUrl')"
         title="Image credit: NASA / ESA / CSA / STScI"></div>
    <div class="bos-login__universe-veil"></div>
    <div class="bos-login__grid-lines"></div>
    <div class="bos-login__sky" id="@(ParticlesId)_sky"></div>
    <div class="bos-login__particles" id="@ParticlesId"></div>
    <div class="bos-login__glow bos-login__glow--1"></div>
    <div class="bos-login__glow bos-login__glow--2"></div>
    <div class="bos-login__glow bos-login__glow--3"></div>
</div>

<script>
(function () {
  var containerId = @_particlesIdJson;
  var colors = @_particleColorsJson;
  var theme = @_themeJson;
  var industry = @_industryJson;
  function reduceMotion() {
    return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }
  function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

  function createParticles() {
    var container = document.getElementById(containerId);
    if (!container || reduceMotion()) return;
    if (container.childElementCount > 0) return;
    var palette = Array.isArray(colors) && colors.length ? colors : [
      'rgba(255,255,255,.85)', 'rgba(14,165,233,.7)', 'rgba(56,189,248,.5)'
    ];
    var count = 160;
    for (var i = 0; i < count; i++) {
      var p = document.createElement('div');
      p.className = 'bos-login__particle';
      p.style.left = Math.random() * 100 + '%';
      p.style.top = Math.random() * 10 + '%';
      var duration = 5 + Math.random() * 14;
      p.style.animationDuration = duration + 's';
      p.style.animationDelay = (Math.random() * duration) + 's';
      var size = 1 + Math.random() * 2.8;
      p.style.width = size + 'px';
      p.style.height = size + 'px';
      p.style.animationName = Math.random() < 0.4 ? 'bosFloatDrift' : 'bosFloat';
      var color = pick(palette);
      p.style.background = color;
      if (size > 1.8) p.style.boxShadow = '0 0 ' + (size * 2.5) + 'px ' + color;
      container.appendChild(p);
    }
  }

  /* Round moons / planets / bright star-orbs — CSS spheres only (no text glyphs). */
  function createFallingBodies() {
    var sky = document.getElementById(containerId + '_sky');
    if (!sky || reduceMotion()) return;
    if (sky.childElementCount > 0) return;
    var palette = Array.isArray(colors) && colors.length ? colors : [
      'rgba(255,255,255,.9)', 'rgba(251,191,36,.8)', 'rgba(56,189,248,.7)'
    ];

    function place(el, slow) {
      el.style.left = Math.random() * 100 + '%';
      el.style.top = (Math.random() * 8) + '%';
      var duration = (slow ? 12 : 7) + Math.random() * (slow ? 18 : 12);
      el.style.animationDuration = duration + 's';
      el.style.animationDelay = (Math.random() * duration) + 's';
      el.style.animationName = Math.random() < 0.45 ? 'bosFloatDrift' : 'bosFloat';
      el.style.animationTimingFunction = 'linear';
      el.style.animationIterationCount = 'infinite';
      sky.appendChild(el);
    }

    var moonCount = 5;
    var planetCount = 7;
    var orbCount = 18;
    if (industry === 'jewellery' || theme === 'sparkle') { moonCount = 7; planetCount = 8; }
    if (industry === 'auto_parts' || theme === 'autoparts') { planetCount = 6; orbCount = 22; }

    for (var m = 0; m < moonCount; m++) {
      var moon = document.createElement('div');
      moon.className = 'bos-login__body bos-login__body--moon';
      var ms = 18 + Math.random() * 28;
      moon.style.width = ms + 'px';
      moon.style.height = ms + 'px';
      place(moon, true);
    }

    var planetTones = [
      'bos-login__body--planet-a',
      'bos-login__body--planet-b',
      'bos-login__body--planet-c',
      'bos-login__body--planet-d'
    ];
    for (var p = 0; p < planetCount; p++) {
      var planet = document.createElement('div');
      planet.className = 'bos-login__body bos-login__body--planet ' + pick(planetTones);
      var ps = 10 + Math.random() * 22;
      planet.style.width = ps + 'px';
      planet.style.height = ps + 'px';
      /* tint glow from tenant palette */
      var glow = pick(palette);
      planet.style.boxShadow = '0 0 ' + (8 + Math.random() * 14) + 'px ' + glow;
      place(planet, Math.random() < 0.55);
    }

    for (var o = 0; o < orbCount; o++) {
      var orb = document.createElement('div');
      orb.className = 'bos-login__body bos-login__body--orb';
      var os = 2 + Math.random() * 5;
      orb.style.width = os + 'px';
      orb.style.height = os + 'px';
      var oc = pick(palette);
      orb.style.background = oc;
      orb.style.boxShadow = '0 0 ' + (os * 3) + 'px ' + oc;
      place(orb, false);
    }
  }

  function animateCounters() {
    var counters = document.querySelectorAll('.bos-login__stat-num[data-count]');
    if (!counters.length) return;
    if (reduceMotion()) {
      counters.forEach(function (el) { el.textContent = el.getAttribute('data-count') + '+'; });
      return;
    }
    setTimeout(function () {
      counters.forEach(function (el) {
        var target = parseInt(el.getAttribute('data-count'), 10) || 0;
        var startTime = null;
        function step(ts) {
          if (!startTime) startTime = ts;
          var progress = Math.min((ts - startTime) / 2000, 1);
          var eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target);
          if (progress < 1) requestAnimationFrame(step);
          else el.textContent = target + '+';
        }
        requestAnimationFrame(step);
      });
    }, 400);
  }

  function forceBodyClass() {
    var meta = document.querySelector('meta[name="epc-body-class"]');
    var cls = meta ? meta.getAttribute('content') : '';
    if (cls) document.body.className = cls;
  }

  function boot() {
    forceBodyClass();
    createParticles();
    createFallingBodies();
    animateCounters();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>

@code {
    [Parameter, EditorRequired] public string ParticlesId { get; set; } = "bosParticles";
    [Parameter] public string Theme { get; set; } = "cyan-stars";
    [Parameter] public string Industry { get; set; } = "platform";
    [Parameter] public string[] ParticleColors { get; set; } =
    [
        "rgba(255,255,255,.85)", "rgba(14,165,233,.7)", "rgba(56,189,248,.55)",
        "rgba(251,191,36,.45)", "rgba(168,85,247,.4)"
    ];

    /// <summary>
    /// NASA / ESA Webb public universe stills (science.nasa.gov gallery / images-assets.nasa.gov).
    /// Background only — never rendered as foreground icons.
    /// </summary>
    private string UniverseImageUrl => (Industry ?? Theme ?? "").ToLowerInvariant() switch
    {
        "auto_parts" or "autoparts" =>
            "https://images-assets.nasa.gov/image/PIA16884/PIA16884~medium.jpg", // Cassiopeia A
        "electronics" or "circuit" =>
            "https://images-assets.nasa.gov/image/PIA12348/PIA12348~medium.jpg", // Andromeda
        "fashion" =>
            "https://cdn.esawebb.org/archives/images/screen/weic2205a.jpg", // Tarantula / star factory
        "jewellery" or "sparkle" =>
            "https://cdn.esawebb.org/archives/images/screen/weic2216a.jpg", // Pillars of Creation
        "finance" or "advisory" or "teal-moon" =>
            "https://images-assets.nasa.gov/image/PIA12348/PIA12348~medium.jpg",
        "crimson-stars" =>
            "https://images-assets.nasa.gov/image/PIA16884/PIA16884~medium.jpg",
        _ =>
            "https://cdn.esawebb.org/archives/images/screen/weic2216a.jpg"
    };

    private MarkupString _particlesIdJson;
    private MarkupString _particleColorsJson;
    private MarkupString _themeJson;
    private MarkupString _industryJson;

    protected override void OnParametersSet()
    {
        _particlesIdJson = new MarkupString(JsonSerializer.Serialize(ParticlesId));
        _particleColorsJson = new MarkupString(JsonSerializer.Serialize(ParticleColors));
        _themeJson = new MarkupString(JsonSerializer.Serialize(Theme ?? "cyan-stars"));
        _industryJson = new MarkupString(JsonSerializer.Serialize(Industry ?? "platform"));
    }
}
