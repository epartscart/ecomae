@using System.Text.Json
@*
  Shared BOS login atmosphere: falling particles + stars + moons + meteors.
  Theme + ParticleColors differentiate CP / ERP / BOS / each tenant look.
*@

<div class="bos-login__bg bos-login__bg--@Theme" data-bos-atmosphere="@Theme" data-bos-industry="@Industry" aria-hidden="true">
    <div class="bos-login__grid-lines"></div>
    <div class="bos-login__sky" id="@(ParticlesId)_sky"></div>
    <div class="bos-login__particles" id="@ParticlesId"></div>
    <div class="bos-login__glow bos-login__glow--1"></div>
    <div class="bos-login__glow bos-login__glow--2"></div>
    <div class="bos-login__glow bos-login__glow--3"></div>
</div>

<script>
(function () {
  var containerId = @_particlesIdJson;
  var colors = @_particleColorsJson;
  var theme = @_themeJson;
  var industry = @_industryJson;
  function reduceMotion() {
    return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }
  function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
  function createParticles() {
    var container = document.getElementById(containerId);
    if (!container || reduceMotion()) return;
    if (container.childElementCount > 0) return;
    var palette = Array.isArray(colors) && colors.length ? colors : [
      'rgba(14,165,233,.8)', 'rgba(56,189,248,.5)', 'rgba(255,255,255,.25)'
    ];
    var count = theme === 'sparkle' || theme === 'fashion' ? 140 : 120;
    for (var i = 0; i < count; i++) {
      var p = document.createElement('div');
      p.className = 'bos-login__particle';
      p.style.left = Math.random() * 100 + '%';
      p.style.top = Math.random() * 12 + '%';
      var duration = 4 + Math.random() * 12;
      p.style.animationDuration = duration + 's';
      p.style.animationDelay = (Math.random() * duration) + 's';
      var size = 1 + Math.random() * 3.5;
      p.style.width = size + 'px';
      p.style.height = size + 'px';
      p.style.animationName = Math.random() < 0.35 ? 'bosFloatDrift' : 'bosFloat';
      var color = pick(palette);
      p.style.background = color;
      if (size > 2) p.style.boxShadow = '0 0 ' + (size * 2) + 'px ' + color;
      container.appendChild(p);
    }
  }
  function createCelestials() {
    var sky = document.getElementById(containerId + '_sky');
    if (!sky || reduceMotion()) return;
    if (sky.childElementCount > 0) return;
    var palette = Array.isArray(colors) && colors.length ? colors : ['rgba(255,255,255,.7)'];
    var stars = 36, moons = 6, meteors = 8, sparks = 14;
    if (theme === 'sparkle' || theme === 'jewellery' || theme.indexOf('sparkle') >= 0) {
      stars = 48; moons = 10; meteors = 6; sparks = 22;
    } else if (theme === 'fashion') {
      stars = 40; moons = 4; meteors = 5; sparks = 28;
    } else if (theme === 'circuit' || theme === 'autoparts') {
      stars = 28; moons = 3; meteors = 12; sparks = 18;
    } else if (theme === 'advisory') {
      stars = 32; moons = 5; meteors = 6; sparks = 12;
    } else if (theme.indexOf('moon') >= 0) {
      stars = 30; moons = 12; meteors = 7; sparks = 10;
    } else if (theme.indexOf('stars') >= 0 || theme === 'crimson-stars' || theme === 'cyan-stars') {
      stars = 52; moons = 4; meteors = 8; sparks = 10;
    }

    function place(el, slow) {
      el.style.left = Math.random() * 100 + '%';
      el.style.top = (-5 - Math.random() * 20) + '%';
      var duration = (slow ? 10 : 6) + Math.random() * (slow ? 16 : 12);
      el.style.animationDuration = duration + 's';
      el.style.animationDelay = (Math.random() * duration) + 's';
      el.style.setProperty('--bos-fall-x', (Math.random() * 80 - 40) + 'px');
      var color = pick(palette);
      el.style.color = color;
      el.style.setProperty('--bos-cel-color', color);
      sky.appendChild(el);
    }

    for (var s = 0; s < stars; s++) {
      var star = document.createElement('span');
      star.className = 'bos-login__celestial bos-login__celestial--star';
      star.textContent = Math.random() < 0.45 ? '✦' : (Math.random() < 0.5 ? '✧' : '★');
      star.style.fontSize = (8 + Math.random() * 14) + 'px';
      place(star, false);
    }
    for (var m = 0; m < moons; m++) {
      var moon = document.createElement('span');
      moon.className = 'bos-login__celestial bos-login__celestial--moon';
      moon.textContent = Math.random() < 0.5 ? '☾' : '☽';
      moon.style.fontSize = (14 + Math.random() * 22) + 'px';
      place(moon, true);
    }
    for (var e = 0; e < meteors; e++) {
      var meteor = document.createElement('span');
      meteor.className = 'bos-login__celestial bos-login__celestial--meteor';
      place(meteor, false);
    }
    for (var k = 0; k < sparks; k++) {
      var spark = document.createElement('span');
      spark.className = 'bos-login__celestial bos-login__celestial--spark'
        + (theme === 'circuit' ? ' bos-login__celestial--circuit' : '');
      place(spark, Math.random() < 0.4);
    }

    var industryGlyphs = {
      auto_parts: ['⚙', '✦', '◆', '◈'],
      electronics: ['⌁', '◈', '◆', '✦'],
      fashion: ['✧', '✦', '◇', '◆'],
      jewellery: ['✦', '✧', '☾', '◆'],
      finance: ['▣', '✦', '☽', '◇'],
      platform: ['✦', '★', '☾']
    };
    var glyphs = industryGlyphs[industry] || industryGlyphs.platform;
    var glyphCount = industry === 'platform' ? 10 : 22;
    for (var g = 0; g < glyphCount; g++) {
      var ind = document.createElement('span');
      ind.className = 'bos-login__celestial bos-login__celestial--industry bos-login__celestial--industry-' + industry;
      ind.textContent = pick(glyphs);
      ind.style.fontSize = (12 + Math.random() * 18) + 'px';
      place(ind, Math.random() < 0.5);
    }
  }
  function animateCounters() {
    var counters = document.querySelectorAll('.bos-login__stat-num[data-count]');
    if (!counters.length) return;
    if (reduceMotion()) {
      counters.forEach(function (el) { el.textContent = el.getAttribute('data-count') + '+'; });
      return;
    }
    setTimeout(function () {
      counters.forEach(function (el) {
        var target = parseInt(el.getAttribute('data-count'), 10) || 0;
        var startTime = null;
        function step(ts) {
          if (!startTime) startTime = ts;
          var progress = Math.min((ts - startTime) / 2000, 1);
          var eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target);
          if (progress < 1) requestAnimationFrame(step);
          else el.textContent = target + '+';
        }
        requestAnimationFrame(step);
      });
    }, 400);
  }
  function forceBodyClass() {
    var meta = document.querySelector('meta[name="epc-body-class"]');
    var cls = meta ? meta.getAttribute('content') : '';
    if (cls) document.body.className = cls;
  }
  function boot() {
    forceBodyClass();
    createParticles();
    createCelestials();
    animateCounters();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>

@code {
    [Parameter, EditorRequired] public string ParticlesId { get; set; } = "bosParticles";
    [Parameter] public string Theme { get; set; } = "cyan-stars";
    [Parameter] public string Industry { get; set; } = "platform";
    [Parameter] public string[] ParticleColors { get; set; } =
    [
        "rgba(14,165,233,.8)", "rgba(14,165,233,.5)", "rgba(56,189,248,.7)",
        "rgba(99,102,241,.5)", "rgba(255,255,255,.35)"
    ];

    private MarkupString _particlesIdJson;
    private MarkupString _particleColorsJson;
    private MarkupString _themeJson;
    private MarkupString _industryJson;

    protected override void OnParametersSet()
    {
        _particlesIdJson = new MarkupString(JsonSerializer.Serialize(ParticlesId));
        _particleColorsJson = new MarkupString(JsonSerializer.Serialize(ParticleColors));
        _themeJson = new MarkupString(JsonSerializer.Serialize(Theme ?? "cyan-stars"));
        _industryJson = new MarkupString(JsonSerializer.Serialize(Industry ?? "platform"));
    }
}
