@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject IHttpContextAccessor Http

<ErpJwEntryStyles />
<div class="jw-reports-bar">
    <a class="jw-reports-bar__home" href="@Href("/erp/jewellery/workspace")"><i class="fa fa-diamond" aria-hidden="true"></i> Jewellery workspace</a>
    <details class="jw-reports-dd">
        <summary><i class="fa fa-bar-chart" aria-hidden="true"></i> Reports &amp; prints</summary>
        <nav class="jw-reports-menu" aria-label="Jewellery reports">
            @foreach (var link in ErpJewelleryWorkspace.ReportLinks)
            {
                <a href="@Href(link.Href)"><i class="fa @link.Icon" aria-hidden="true"></i> @link.Label</a>
            }
        </nav>
    </details>
</div>

@code {
    private string Href(string href)
        => ClientErpPath.PrefixIfBound(Http.HttpContext, href);
}
