@code {
    private string _cmsLangs = "en,ar";
    private string _cmsLang = "en";
    private string _cfCountry = "";

    protected override void OnInitialized()
    {
        var req = Http.HttpContext?.Request;
        if (req is null)
        {
            return;
        }

        var path = req.Path.Value ?? "/";
        var m = System.Text.RegularExpressions.Regex.Match(path, "^/([a-z]{2})(?:/|$)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (m.Success)
        {
            _cmsLang = m.Groups[1].Value.ToLowerInvariant();
        }

        if (req.Headers.TryGetValue("CF-IPCountry", out var cfc))
        {
            var country = cfc.ToString().Trim().ToUpperInvariant();
            if (country is not ("" or "XX" or "T1"))
            {
                _cfCountry = country;
            }
        }
    }
}
