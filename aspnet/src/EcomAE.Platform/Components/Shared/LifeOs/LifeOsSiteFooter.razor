@using EcomAE.Platform.LifeOs.Legal
@using EcomAE.Platform.Routing

<footer class="lo-site-footer" aria-label="LifeOS site footer">
  <div class="lo-site-footer__inner">
    <div class="lo-site-footer__brand">
      <strong>Life<em>OS</em>™</strong>
      <p>
        Universal Ambient Artificial Intelligence — product of Electronic World Group / ECOM AE.
        Human control always first.
      </p>
      <div class="lo-site-footer__product">
        <a href="@EcomAeRoutes.LifeOs">Home</a>
        <a href="@EcomAeRoutes.LifeOsJoin">Join</a>
        <a href="@EcomAeRoutes.LifeOsMobile">Mobile</a>
        <a href="@EcomAeRoutes.LifeOsRoutine">24/7 routine</a>
        <a href="@EcomAeRoutes.LifeOsSpec">Spec</a>
        <a href="@EcomAeRoutes.LifeOsLogin">Sign in</a>
        <a href="https://www.ecomae.com/">ecomae.com</a>
      </div>
    </div>

    <div class="lo-site-footer__legal">
      <p class="lo-site-footer__legal-label">Legal &amp; security</p>
      <nav class="lo-site-footer__legal-links" aria-label="Legal and copyright policies">
        @foreach (var link in LifeOsLegalCatalog.FooterLegalLinks)
        {
          <a href="@link.Href" rel="noopener noreferrer">@link.Label</a>
        }
      </nav>
    </div>

    <p class="lo-site-footer__copy">
      @LifeOsLegalCatalog.CopyrightLine(DateTime.UtcNow.Year)
      · <a href="@LifeOsLegalCatalog.LegalHubHref" rel="noopener noreferrer">Legal policies</a>
      · LifeOS™ trademark &amp; copyright subject to
      <a href="@(LifeOsLegalCatalog.CanonicalHost)/trademark" rel="noopener noreferrer">Trademark</a>
      and
      <a href="@(LifeOsLegalCatalog.CanonicalHost)/copyright" rel="noopener noreferrer">Copyright</a>
      notices.
    </p>
  </div>
</footer>
