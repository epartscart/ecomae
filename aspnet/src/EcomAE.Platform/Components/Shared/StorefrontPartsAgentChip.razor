@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation

@* Collapsed launcher — an always-open panel covered the warehouse price column. *@
<div class="epc-parts-desk" data-epc-parts-desk>
    <button type="button" class="epc-parts-desk__launcher" aria-expanded="false" aria-controls="epc-parts-desk-panel">Parts desk</button>
    <form id="epc-parts-desk-panel" class="epc-parts-desk__panel" method="get" action="@StorefrontSurfaceLinks.PartSearch" hidden>
        <p style="margin:0 0 .45rem;font-weight:800;font-size:.85rem">Parts desk</p>
        <input type="text" name="article" required maxlength="64" placeholder="Part number" style="width:100%;padding:.4rem .5rem;border:0;border-radius:.35rem;margin-bottom:.45rem;color:#0f172a" />
        <button type="submit" style="width:100%;padding:.4rem .5rem;border:0;border-radius:.35rem;background:#dc2626;color:#fff;font-weight:800;cursor:pointer">Ask</button>
    </form>
</div>
<script>
(function () {
  var root = document.querySelector('[data-epc-parts-desk]');
  if (!root || root.getAttribute('data-wired') === '1') return;
  root.setAttribute('data-wired', '1');
  var btn = root.querySelector('.epc-parts-desk__launcher');
  var panel = root.querySelector('.epc-parts-desk__panel');
  if (!btn || !panel) return;
  btn.addEventListener('click', function () {
    var open = panel.hasAttribute('hidden');
    if (open) panel.removeAttribute('hidden');
    else panel.setAttribute('hidden', '');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
})();
</script>
