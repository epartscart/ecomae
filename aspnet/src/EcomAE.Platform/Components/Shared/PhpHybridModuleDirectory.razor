@using EcomAE.Platform.Presentation

@*
  Module directory for product shells.
  Primary click = ASP.NET browse route. PHP only via explicit /php-reference/* link.
  Lower modules match Dynamics 365 F&O Workspaces: compact icon + label tiles.
*@


<HeadContent>
<style>
    .epc-moddir-grid { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:10px 12px; }
    a.epc-d365-ws { display:flex; align-items:center; gap:10px; min-height:52px; padding:8px 12px; background:#fff; border:1px solid #e1e5ea; border-radius:4px; color:#323130; text-decoration:none; }
    a.epc-d365-ws i { color:#0078d4; width:18px; text-align:center; }
    a.epc-d365-ws .epc-moddir-link { color:#323130 !important; font-weight:600; text-decoration:none; }
</style>
</HeadContent>
<style data-epc-moddir="d365-workspaces">
    .epc-moddir-head h2 { margin:0 0 .45rem; color:#605e5c; font-size:12px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; }
    .epc-moddir-grid { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:10px 12px; }
    a.epc-moddir-item.epc-d365-ws { display:flex !important; flex-direction:row; align-items:center; gap:10px; min-height:52px; padding:8px 12px; background:#fff !important; border:1px solid #e1e5ea; border-radius:4px; color:#323130 !important; text-decoration:none !important; box-shadow:0 1px 2px rgba(15,23,42,.05); }
    a.epc-d365-ws i { color:#0078d4 !important; width:18px; text-align:center; font-size:15px; }
    a.epc-d365-ws .epc-moddir-link { color:#323130 !important; font-size:13px; font-weight:600; text-decoration:none !important; }
    @@media (max-width:1100px) { .epc-moddir-grid { grid-template-columns:repeat(4,minmax(0,1fr)); } }
    @@media (max-width:720px) { .epc-moddir-grid { grid-template-columns:1fr 1fr; } }
</style>


@* Primary module-directory marker: epc-moddir-aspnet. *@
<div class="epc-moddir" data-epc-moddir-style="d365-fno">
    <div class="epc-moddir-head">
        <h2>@Title</h2>
        <p>@Subtitle — <strong>@_links.Count</strong> workspaces.</p>
        <p class="epc-moddir-hint">Open a workspace below to continue.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Search))
    {
        <input class="epc-moddir-search" placeholder="Filter workspaces…" value="@Search" @oninput="OnSearch" />
    }
    else
    {
        <input class="epc-moddir-search" placeholder="Filter workspaces…" @oninput="OnSearch" />
    }

    @foreach (var group in FilteredGroups)
    {
        <section class="epc-moddir-group">
            <h3>@group.Key <span>(@group.Count())</span></h3>
            <div class="epc-moddir-grid">
                @foreach (var item in group)
                {
                    <a class="epc-moddir-item epc-d365-ws"
                       href="@PhpSurfaceLinkMap.AspNetPrimaryHref(item.Href)"
                       title="@(string.IsNullOrWhiteSpace(item.Description) ? item.Label : item.Description)">
                        @if (!string.IsNullOrWhiteSpace(item.Icon))
                        {
                            <i class="fa @item.Icon" aria-hidden="true"></i>
                        }
                        <span class="epc-moddir-link">@item.Label</span>
                    </a>
                }
            </div>
        </section>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Workspaces";
    [Parameter] public string Subtitle { get; set; } = "All modules";
    [Parameter] public IReadOnlyList<PhpModuleCatalog.ModuleLink> Links { get; set; } = Array.Empty<PhpModuleCatalog.ModuleLink>();
    [Parameter] public string? PhpWorkspaceBase { get; set; }
    [Parameter] public string Search { get; set; } = "";

    private IReadOnlyList<PhpModuleCatalog.ModuleLink> _links = Array.Empty<PhpModuleCatalog.ModuleLink>();
    private string _filter = "";

    protected override void OnParametersSet()
    {
        _links = Links ?? Array.Empty<PhpModuleCatalog.ModuleLink>();
        _filter = Search ?? "";
    }

    private IEnumerable<IGrouping<string, PhpModuleCatalog.ModuleLink>> FilteredGroups
    {
        get
        {
            IEnumerable<PhpModuleCatalog.ModuleLink> q = _links;
            if (!string.IsNullOrWhiteSpace(_filter))
            {
                var f = _filter.Trim();
                q = q.Where(x =>
                    x.Label.Contains(f, StringComparison.OrdinalIgnoreCase)
                    || x.Id.Contains(f, StringComparison.OrdinalIgnoreCase)
                    || (x.Group?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return q.GroupBy(x => string.IsNullOrWhiteSpace(x.Group) ? "general" : x.Group!)
                .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase);
        }
    }

    private void OnSearch(ChangeEventArgs e) => _filter = e.Value?.ToString() ?? "";
}
