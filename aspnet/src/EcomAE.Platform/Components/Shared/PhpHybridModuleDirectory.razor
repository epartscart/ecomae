@using EcomAE.Platform.Presentation

@*
  Full PHP-sourced module directory for hybrid shells.
  Every listed item deeplinks to live PHP so design/function remain available
  while ASP.NET chrome is brought to PHP level.
*@

<div class="epc-moddir">
    <div class="epc-moddir-head">
        <h2>@Title</h2>
        <p>@Subtitle — <strong>@_links.Count</strong> PHP modules linked (hybrid). Nothing omitted from this directory.</p>
        @if (!string.IsNullOrWhiteSpace(PhpWorkspaceBase))
        {
            <p class="epc-moddir-hint">Open in hybrid workspace (ASP.NET chrome + PHP iframe) or jump straight to PHP.</p>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Search))
    {
        <input class="epc-moddir-search" placeholder="Filter modules…" value="@Search" @oninput="OnSearch" />
    }
    else
    {
        <input class="epc-moddir-search" placeholder="Filter modules…" @oninput="OnSearch" />
    }

    @foreach (var group in FilteredGroups)
    {
        <section class="epc-moddir-group">
            <h3>@group.Key <span>(@group.Count())</span></h3>
            <div class="epc-moddir-grid">
                @foreach (var item in group)
                {
                    <div class="epc-moddir-item">
                        @if (!string.IsNullOrWhiteSpace(item.Icon))
                        {
                            <i class="fa @item.Icon" aria-hidden="true"></i>
                        }
                        <a class="epc-moddir-php" href="@item.Href" title="Open live PHP module">@item.Label</a>
                        @if (!string.IsNullOrWhiteSpace(PhpWorkspaceBase))
                        {
                            <a class="epc-moddir-hybrid" href="@PhpModuleCatalog.HybridWorkspaceHref(PhpWorkspaceBase!, item.Href)" title="Hybrid workspace">workspace</a>
                        }
                    </div>
                }
            </div>
        </section>
    }
</div>

<style>
    .epc-moddir { margin-top:1.25rem; }
    .epc-moddir-head h2 { margin:0 0 .35rem; font-size:1.1rem; }
    .epc-moddir-head p { margin:0 0 .55rem; color:#64748b; font-size:.88rem; line-height:1.4; }
    .epc-moddir-hint { color:#92400e !important; }
    .epc-moddir-search { width:100%; max-width:28rem; padding:.55rem .7rem; border:1px solid #e2e8f0; border-radius:.4rem; margin-bottom:.85rem; font:inherit; }
    .epc-moddir-group { margin:0 0 1rem; }
    .epc-moddir-group h3 { margin:0 0 .45rem; font-size:.92rem; color:#334155; }
    .epc-moddir-group h3 span { color:#94a3b8; font-weight:500; }
    .epc-moddir-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:.4rem; }
    .epc-moddir-item { display:flex; align-items:center; gap:.4rem; background:#fff; border:1px solid #e2e8f0; border-radius:.4rem; padding:.45rem .55rem; font-size:.8rem; }
    .epc-moddir-item i { color:#64748b; width:1rem; text-align:center; }
    .epc-moddir-php { flex:1; font-weight:600; color:#0f172a; text-decoration:none; }
    .epc-moddir-php:hover { text-decoration:underline; color:#1d4ed8; }
    .epc-moddir-hybrid { font-size:.72rem; color:#b45309; text-decoration:none; white-space:nowrap; }
    .epc-moddir-hybrid:hover { text-decoration:underline; }
</style>

@code {
    [Parameter] public string Title { get; set; } = "Module directory";
    [Parameter] public string Subtitle { get; set; } = "PHP-authoritative modules";
    [Parameter] public IReadOnlyList<PhpModuleCatalog.ModuleLink> Links { get; set; } = Array.Empty<PhpModuleCatalog.ModuleLink>();
    [Parameter] public string? PhpWorkspaceBase { get; set; }
    [Parameter] public string Search { get; set; } = "";

    private IReadOnlyList<PhpModuleCatalog.ModuleLink> _links = Array.Empty<PhpModuleCatalog.ModuleLink>();
    private string _filter = "";

    protected override void OnParametersSet()
    {
        _links = Links ?? Array.Empty<PhpModuleCatalog.ModuleLink>();
        _filter = Search ?? "";
    }

    private IEnumerable<IGrouping<string, PhpModuleCatalog.ModuleLink>> FilteredGroups
    {
        get
        {
            IEnumerable<PhpModuleCatalog.ModuleLink> q = _links;
            if (!string.IsNullOrWhiteSpace(_filter))
            {
                var f = _filter.Trim();
                q = q.Where(x =>
                    x.Label.Contains(f, StringComparison.OrdinalIgnoreCase)
                    || x.Id.Contains(f, StringComparison.OrdinalIgnoreCase)
                    || (x.Group?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return q.GroupBy(x => string.IsNullOrWhiteSpace(x.Group) ? "general" : x.Group!)
                .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase);
        }
    }

    private void OnSearch(ChangeEventArgs e) => _filter = e.Value?.ToString() ?? "";
}
