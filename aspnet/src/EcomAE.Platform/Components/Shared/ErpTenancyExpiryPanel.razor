@using System.Globalization
@using System.Linq
@using EcomAE.Platform.Erp

<section id="expiry-mail">
    <style>
        .expiry-letter { background: #fff; border: 1px solid #d6dee8; border-left: 4px solid #163a6b; border-radius: 8px; padding: 16px 18px; margin: 0 0 14px; max-width: 760px; }
        .expiry-letter h4 { margin: 8px 0; font-size: 16px; color: #0f172a; }
        .expiry-letter__body { white-space: pre-wrap; font-family: Georgia, "Times New Roman", serif; font-size: 15px; line-height: 1.55; color: #1e293b; }
        .expiry-detail { margin: 0 0 4px; font-size: 13px; color: #334155; }
    </style>
    <h3>Tenancy expiry email</h3>
    <p class="text-muted">Three months before a tenancy ends, this page prepares an email from the draft. Read the preview and the details first. Nothing is mailed until you press Send under that letter. A tenant can have more than one address. List every landlord address that should receive the reply. Attach that tenant's documents one at a time. Each file stays on the tenant, and an open notice carries the files you add to it. Each reply is filed on the notice, one sender at a time. Tenancies that are not on file are not invented.</p>
    @if (!string.IsNullOrWhiteSpace(Note))
    {
        <p>@Note</p>
    }
    @if (!string.IsNullOrWhiteSpace(Book.Message))
    {
        <p class="text-muted">@Book.Message</p>
    }

    <ErpPhpCreateWell Title="Draft email">
        <form method="post" action="@SaveAction">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="csrf_guard_key" value="@Csrf" />
            <input type="hidden" name="action" value="save_expiry_template" />
            @Filter
            <label>Subject <input class="form-control input-sm" type="text" name="subject" maxlength="200" value="@Book.Template.Subject" required /></label>
            <label>Message
                <textarea class="form-control" name="body" rows="10" required>@Book.Template.Body</textarea>
            </label>
            <p class="text-muted">Placeholders: {{tenant_name}} {{property}} {{unit}} {{lease_code}} {{start_date}} {{end_date}} {{notice_date}} {{annual_rent}} {{reply_emails}}</p>
            <label>Landlord addresses that receive the reply
                <textarea class="form-control" name="replyEmails" rows="3" placeholder="one address on each line, or separated by commas">@Book.Template.ReplyEmails</textarea>
            </label>
            <button type="submit" class="btn btn-primary btn-sm">Save draft</button>
        </form>
    </ErpPhpCreateWell>

    <h3 id="expiry-preview">Preview before send</h3>
    <p class="text-muted">The letter uses the saved draft. Names, dates and addresses come from the tenancy on file. Opening this tab does not send it.</p>
    @if (Book.Notices.Count == 0 && Previews.Count == 0)
    {
        var sample = ErpTenancyExpiryMail.Sample(Book.Template);
        <p class="text-muted">No tenancy is on file yet. This sample shows the shape of the letter. It cannot be sent.</p>
        @Letter(sample.Subject, sample.Body, sample.ToEmails, sample.ReplyEmails, "Sample", "Property Flat", "2026-12-31", "2026-09-30", "Sample preview")
    }

    @if (Book.Notices.Count == 0)
    {
        <p class="text-muted">No notice is prepared yet. When an active tenancy reaches three months before its end date, the letter appears here and the send button sits under the preview.</p>
    }
    else
    {
        @foreach (var notice in Book.Notices)
        {
            <div class="epc-erp-table-wrap">
                <p>
                    <strong>@(string.IsNullOrWhiteSpace(notice.LeaseCode) ? "Tenancy " + notice.LeaseId.ToString(CultureInfo.InvariantCulture) : notice.LeaseCode)</strong>
                    @notice.TenantName
                    @notice.PropertyName
                    @notice.UnitCode
                    · ends @notice.EndDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                    · prepare from @notice.DueOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                    · @ErpTenancyExpiryMail.StatusLabel(notice.Status)
                    @if (!string.IsNullOrWhiteSpace(notice.SentAt))
                    {
                        <span> · sent @notice.SentAt</span>
                    }
                </p>
                @if (!string.IsNullOrWhiteSpace(notice.SendError))
                {
                    <p>@notice.SendError</p>
                }
                <p class="text-muted">Read this letter and the details above it. Send stays under the preview.</p>
                @Letter(notice.Subject, notice.Body, notice.ToEmails, notice.ReplyEmails, string.IsNullOrWhiteSpace(notice.LeaseCode) ? "Tenancy " + notice.LeaseId.ToString(CultureInfo.InvariantCulture) : notice.LeaseCode, (notice.PropertyName + " " + notice.UnitCode).Trim(), notice.EndDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), notice.DueOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), ErpTenancyExpiryMail.StatusLabel(notice.Status))
                <p><strong>Documents on this notice</strong></p>
                @foreach (var document in TenantDocuments(notice.TenantId))
                {
                    var onNotice = OnNotice(notice.Id, document.Id);
                    <div class="re-filter">
                        <span>@ErpTenancyDocumentFiles.TypeLabel(document.DocType) @document.Title <a href="@DocumentHref(document.Id)">@document.FileName</a>@(onNotice ? " · on this email" : "")</span>
                        @if (!onNotice && ErpTenancyExpiryMail.CanSend(notice.Status))
                        {
                            <form method="post" action="@SaveAction" class="re-filter">
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="csrf_guard_key" value="@Csrf" />
                                <input type="hidden" name="action" value="include_expiry_document" />
                                <input type="hidden" name="id" value="@notice.Id.ToString(CultureInfo.InvariantCulture)" />
                                <input type="hidden" name="documentId" value="@document.Id.ToString(CultureInfo.InvariantCulture)" />
                                @Filter
                                <button type="submit" class="btn btn-default btn-sm">Add to this email</button>
                            </form>
                        }
                        <form method="post" action="@SaveAction" class="re-filter">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="csrf_guard_key" value="@Csrf" />
                            <input type="hidden" name="action" value="remove_tenant_document" />
                            <input type="hidden" name="documentId" value="@document.Id.ToString(CultureInfo.InvariantCulture)" />
                            @Filter
                            <button type="submit" class="btn btn-default btn-sm">Remove</button>
                        </form>
                    </div>
                }
                @if (notice.TenantId > 0)
                {
                    @AttachForm(notice.TenantId, notice.Id)
                }
                @if (notice.Replies.Count > 0)
                {
                    <p><strong>Replies</strong></p>
                    @foreach (var reply in notice.Replies)
                    {
                        <p>@reply.FiledAt @reply.FromEmail</p>
                        <pre style="white-space:pre-wrap">@reply.Body</pre>
                    }
                }
                @if (ErpTenancyExpiryMail.CanEdit(notice.Status))
                {
                    <form method="post" action="@SaveAction">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="csrf_guard_key" value="@Csrf" />
                        <input type="hidden" name="action" value="edit_expiry" />
                        <input type="hidden" name="id" value="@notice.Id.ToString(CultureInfo.InvariantCulture)" />
                        @Filter
                        <label>Tenant emails <textarea class="form-control" name="toEmails" rows="2">@notice.ToEmails</textarea></label>
                        <label>Reply goes to <textarea class="form-control" name="replyEmails" rows="2">@notice.ReplyEmails</textarea></label>
                        <label>Subject <input class="form-control input-sm" type="text" name="subject" maxlength="200" value="@notice.Subject" /></label>
                        <label>Message <textarea class="form-control" name="body" rows="6">@notice.Body</textarea></label>
                        <button type="submit" class="btn btn-default btn-sm">Save this notice</button>
                    </form>
                }
                @if (ErpTenancyExpiryMail.CanSend(notice.Status))
                {
                    <form method="post" action="@SaveAction">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="csrf_guard_key" value="@Csrf" />
                        <input type="hidden" name="action" value="send_expiry" />
                        <input type="hidden" name="id" value="@notice.Id.ToString(CultureInfo.InvariantCulture)" />
                        @Filter
                        <button type="submit" class="btn btn-primary btn-sm">@(notice.Status == "failed" ? "Try again" : "Send this notice")</button>
                    </form>
                }
                @if (ErpTenancyExpiryMail.CanSkip(notice.Status))
                {
                    <form method="post" action="@SaveAction">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="csrf_guard_key" value="@Csrf" />
                        <input type="hidden" name="action" value="skip_expiry" />
                        <input type="hidden" name="id" value="@notice.Id.ToString(CultureInfo.InvariantCulture)" />
                        @Filter
                        <button type="submit" class="btn btn-default btn-sm">Do not send</button>
                    </form>
                }
                @if (notice.Status != "skipped")
                {
                    <form method="post" action="@SaveAction">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="csrf_guard_key" value="@Csrf" />
                        <input type="hidden" name="action" value="file_expiry_reply" />
                        <input type="hidden" name="id" value="@notice.Id.ToString(CultureInfo.InvariantCulture)" />
                        @Filter
                        <label>Reply came from <input class="form-control input-sm" type="email" name="fromEmail" /></label>
                        <label>Reply <textarea class="form-control" name="replyBody" rows="3"></textarea></label>
                        <button type="submit" class="btn btn-default btn-sm">File this reply</button>
                    </form>
                }
            </div>
        }
    }

    @if (Previews.Count > 0)
    {
        <h4>Letters not prepared yet</h4>
        <p class="text-muted">These are filled in so you can read them. They are not on the send list until you check tenancies that are due. Nothing is mailed from this preview.</p>
        @foreach (var preview in Previews)
        {
            @Letter(preview.Subject, preview.Body, preview.ToEmails, preview.ReplyEmails, "Tenancy " + preview.LeaseId.ToString(CultureInfo.InvariantCulture), "", preview.EndDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), preview.DueOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), preview.Status == "needs_email" ? "Needs a tenant email" : "Preview only")
        }
    }

    <form method="post" action="@SaveAction" class="re-filter">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="csrf_guard_key" value="@Csrf" />
        <input type="hidden" name="action" value="prepare_expiry" />
        @Filter
        <button type="submit" class="btn btn-default btn-sm">Check tenancies due now</button>
    </form>
    <form method="post" action="@SaveAction" class="re-filter">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="csrf_guard_key" value="@Csrf" />
        <input type="hidden" name="action" value="send_expiry_due" />
        @Filter
        <button type="submit" class="btn btn-primary btn-sm">Send every ready notice</button>
    </form>

    @if (Book.Waiting.Count > 0)
    {
        <h4>Not due yet</h4>
        <div class="epc-erp-table-wrap">
            <table class="table table-condensed table-bordered table-epc">
                <thead>
                    <tr><th>Tenancy</th><th>Tenant</th><th>Property</th><th>Flat</th><th>Ends</th><th>Notice prepares on</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in Book.Waiting)
                    {
                        <tr>
                            <td>@row.LeaseCode</td>
                            <td>@row.TenantName</td>
                            <td>@row.PropertyName</td>
                            <td>@row.UnitCode</td>
                            <td>@row.EndDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                            <td>@row.DueOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @foreach (var row in Book.Waiting.Where(row => row.TenantId > 0).GroupBy(row => row.TenantId).Select(group => group.First()))
        {
            <p><strong>@row.TenantName documents</strong></p>
            @DocumentList(row.TenantId)
            @AttachForm(row.TenantId, 0)
        }
    }

    @if (Book.Ended.Count > 0)
    {
        <h4>Ended before a notice was sent</h4>
        <p class="text-muted">These tenancies are still active and the end date has passed. No automatic email is sent after the end date. Prepare the letter only when you still want to send it.</p>
        @foreach (var row in Book.Ended)
        {
            <form method="post" action="@SaveAction" class="re-filter">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="csrf_guard_key" value="@Csrf" />
                <input type="hidden" name="action" value="prepare_expiry_one" />
                <input type="hidden" name="leaseId" value="@row.LeaseId.ToString(CultureInfo.InvariantCulture)" />
                @Filter
                <span>@row.LeaseCode @row.TenantName @row.PropertyName @row.UnitCode ended @row.EndDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span>
                <button type="submit" class="btn btn-default btn-sm">Prepare this letter</button>
            </form>
        }
    }
</section>

@code {
    [Parameter] public ErpTenancyExpiryBook Book { get; set; } = ErpTenancyExpiryBook.Empty("");
    [Parameter] public string Note { get; set; } = "";
    [Parameter] public string SaveAction { get; set; } = "";
    [Parameter] public string Csrf { get; set; } = "";
    [Parameter] public int Year { get; set; }
    [Parameter] public long PropertyId { get; set; }
    [Parameter] public long UnitId { get; set; }
    [Parameter] public string ReturnUrl { get; set; } = "";

    private IReadOnlyList<ErpTenancyExpiryDraft> Previews => Book.Previews ?? [];

    private IEnumerable<ErpTenancyExpiryDocument> TenantDocuments(long tenantId)
        => (Book.Documents ?? []).Where(document => document.TenantId == tenantId);

    private bool OnNotice(long noticeId, long documentId)
        => (Book.Links ?? []).Any(link => link.NoticeId == noticeId && link.DocumentId == documentId);

    private string DocumentHref(long id)
    {
        var action = SaveAction ?? "";
        const string marker = "/erp/landlord/save";
        var index = action.IndexOf(marker, StringComparison.Ordinal);
        var href = index < 0 ? "/erp/landlord/document" : action[..index] + "/erp/landlord/document";
        return href + "?id=" + id.ToString(CultureInfo.InvariantCulture);
    }

    private RenderFragment DocumentList(long tenantId) => @<text>
        @foreach (var document in TenantDocuments(tenantId))
        {
            <div class="re-filter">
                <span>@ErpTenancyDocumentFiles.TypeLabel(document.DocType) @document.Title <a href="@DocumentHref(document.Id)">@document.FileName</a></span>
                <form method="post" action="@SaveAction" class="re-filter">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="csrf_guard_key" value="@Csrf" />
                    <input type="hidden" name="action" value="remove_tenant_document" />
                    <input type="hidden" name="documentId" value="@document.Id.ToString(CultureInfo.InvariantCulture)" />
                    @Filter
                    <button type="submit" class="btn btn-default btn-sm">Remove</button>
                </form>
            </div>
        }
    </text>;

    private RenderFragment AttachForm(long tenantId, long noticeId) => @<text>
        <form method="post" action="@SaveAction" enctype="multipart/form-data">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="csrf_guard_key" value="@Csrf" />
            <input type="hidden" name="action" value="@(noticeId > 0 ? "attach_expiry_document" : "attach_tenant_document")" />
            @if (noticeId > 0)
            {
                <input type="hidden" name="id" value="@noticeId.ToString(CultureInfo.InvariantCulture)" />
            }
            <input type="hidden" name="tenantId" value="@tenantId.ToString(CultureInfo.InvariantCulture)" />
            @Filter
            <label>Document name <input class="form-control input-sm" type="text" name="title" maxlength="190" /></label>
            <label>Kind
                <select class="form-control input-sm" name="docType">
                    <option value="emirates_id">Emirates ID</option>
                    <option value="passport">Passport</option>
                    <option value="visa">Visa</option>
                    <option value="ejari">Ejari</option>
                    <option value="contract">Tenancy contract</option>
                    <option value="other">Other</option>
                </select>
            </label>
            <label>One file <input class="form-control input-sm" type="file" name="document" accept=".pdf,.jpg,.jpeg,.png,.webp" required /></label>
            <button type="submit" class="btn btn-default btn-sm">Attach this document</button>
        </form>
    </text>;

    private RenderFragment Letter(string subject, string body, string to, string reply, string leaseCode, string place, string ends, string due, string status) => @<text>
        <article class="expiry-letter">
            <p class="expiry-detail"><strong>@leaseCode</strong> @place · ends @ends · prepare from @due · @status</p>
            <p class="expiry-detail">To: @(string.IsNullOrWhiteSpace(to) ? "No tenant email yet" : to)</p>
            <p class="expiry-detail">Reply goes to: @(string.IsNullOrWhiteSpace(reply) ? "The sending mailbox" : reply)</p>
            <h4>@subject</h4>
            <div class="expiry-letter__body">@body</div>
        </article>
    </text>;

    private RenderFragment Filter => @<text>
        <input type="hidden" name="filterYear" value="@Year.ToString(CultureInfo.InvariantCulture)" />
        <input type="hidden" name="filterPropertyId" value="@PropertyId.ToString(CultureInfo.InvariantCulture)" />
        <input type="hidden" name="filterUnitId" value="@UnitId.ToString(CultureInfo.InvariantCulture)" />
        @if (ReturnUrl.StartsWith("/erp/", StringComparison.Ordinal) && !ReturnUrl.StartsWith("//", StringComparison.Ordinal))
        {
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        }
    </text>;
}
