@*
  Optional iframe that loads PHP reference (or allowed absolute tenant URL) inside ASP.NET chrome.
  Protocol: product URLs stay ASP.NET; PHP only via /php-reference/*.
  Activated via ?php=/php-reference/cp (legacy ?php=/CP/... is rewritten to reference).
*@
@using EcomAE.Platform.Presentation


<HeadContent>
<style>
    .epc-hybrid-frame { margin:1rem 0 1.5rem; border:1px solid #e2e8f0; border-radius:.55rem; overflow:hidden; background:#fff; }
    .epc-hybrid-frame-bar { display:flex; gap:.85rem; flex-wrap:wrap; align-items:center; padding:.5rem .75rem; background:#0c4a6e; color:#e0f2fe; font-size:.8rem; font-weight:600; }
    .epc-hybrid-frame-bar a { color:#7dd3fc; text-decoration:none; }
    .epc-hybrid-frame-bar a:hover { text-decoration:underline; }
    .epc-hybrid-iframe { width:100%; min-height:70vh; border:0; background:#fff; }
</style>
</HeadContent>


@if (!string.IsNullOrWhiteSpace(SafePhpHref))
{
    <section class="epc-hybrid-frame">
        <div class="epc-hybrid-frame-bar">
            <span>Reference workspace</span>
            <a href="@SafePhpHref" target="_blank" rel="noopener">Open full page</a>
            <a href="@ClearHref">Close</a>
        </div>
        <iframe class="epc-hybrid-iframe" src="@SafePhpHref" title="Reference workspace" loading="lazy"></iframe>
    </section>
}

@code {
    [Parameter] public string? PhpHref { get; set; }
    [Parameter] public string ClearHref { get; set; } = "?";

    private string? SafePhpHref => Sanitize(PhpHref);

    private static string? Sanitize(string? href)
    {
        if (string.IsNullOrWhiteSpace(href))
        {
            return null;
        }

        // Legacy product-tree deeplinks → PHP reference shells (never load /CP through Kestrel remap).
        var rewritten = PhpSurfaceLinkMap.PhpReferenceOnlyHref(href.Trim());
        if (!string.IsNullOrWhiteSpace(rewritten)
            && rewritten.StartsWith("/php-reference/", StringComparison.OrdinalIgnoreCase))
        {
            return rewritten;
        }

        var value = href.Trim();
        if (value.StartsWith("/php-reference/", StringComparison.OrdinalIgnoreCase)
            || EcomaeMarketingPages.IsMarketingPhpPath(value))
        {
            return value;
        }

        // Absolute tenant / platform URLs only when they already target php-reference.
        if (Uri.TryCreate(value, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp)
            && (uri.Host.EndsWith("epartscart.com", StringComparison.OrdinalIgnoreCase)
                || uri.Host.EndsWith("ecomae.com", StringComparison.OrdinalIgnoreCase))
            && uri.AbsolutePath.StartsWith("/php-reference/", StringComparison.OrdinalIgnoreCase))
        {
            return value;
        }

        return null;
    }
}
