@using EcomAE.Platform.Presentation
@*
  Applies PHP-matching document.body classes (Blazor layout leaves body bare).
  Meta + data attribute keep markers visible in SSR HTML for presentation probes.
*@
<meta name="epc-body-class" content="@BodyClass" />
<div class="epc-body-class-bridge" data-epc-body-class="@BodyClass" hidden aria-hidden="true"></div>
@* Inline + head script so PHP-matching body classes apply before first paint when possible. *@
<style>/* epc-body-class:@BodyClass */</style>
<script>
(function () {
  var cls = '@BodyClass';
  if (cls) {
    document.body.className = cls;
    document.documentElement.setAttribute('data-epc-body-class', cls);
  }
})();
</script>

@code {
  [Parameter, EditorRequired] public string Surface { get; set; } = "cp";
    [Parameter] public bool LoginChrome { get; set; }

    private string BodyClass => LoginChrome
        ? LegacyPresentationAssets.LoginBodyClassFor(Surface)
        : LegacyPresentationAssets.BodyClassFor(Surface);
}
