@namespace EcomAE.Platform.Components.Shared
@*
  PHP twin: content/general_pages/epc_oauth_buttons.php
  Google-first social CTA. OAuth start/callback remain PHP-authoritative
  at /api/epc_oauth_start.php (writes / session minting stay in PHP).
*@

<link rel="stylesheet" href="/platform-assets/epc_oauth_login_buttons.css?v=20260808g" />
<div class="epc-social @_toneClass" data-oauth-context="@Context" data-lpignore="true" data-1p-ignore="true">
    @if (ShowDividerAbove)
    {
        <div class="epc-social-divider"><span>@DividerLabel</span></div>
    }
    @if (!string.IsNullOrWhiteSpace(Heading))
    {
        <p class="epc-social-heading">@Heading</p>
    }
    <a class="epc-social-btn epc-social-btn--google"
       href="@StartHref("google")"
       data-provider="google"
       rel="nofollow">
        <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        <span class="epc-social-label">Continue with Google</span>
    </a>
    @if (ShowExtraProviders)
    {
        <div class="epc-social-extra" aria-label="More sign-in providers">
            <a class="epc-social-btn epc-social-btn--compact" href="@StartHref("microsoft")" data-provider="microsoft" rel="nofollow">Microsoft</a>
            <a class="epc-social-btn epc-social-btn--compact" href="@StartHref("apple")" data-provider="apple" rel="nofollow">Apple</a>
            <a class="epc-social-btn epc-social-btn--compact" href="@StartHref("github")" data-provider="github" rel="nofollow">GitHub</a>
        </div>
    }
    @if (ShowDividerBelow)
    {
        <div class="epc-social-divider"><span>@BelowDividerLabel</span></div>
    }
</div>

@code {
    /// <summary>PHP auth mode: storefront or cp (bos/erp/ip/lifeos map to cp).</summary>
    [Parameter] public string Context { get; set; } = "cp";
    [Parameter] public string ReturnUrl { get; set; } = "/cp";
    [Parameter] public string? TenantKey { get; set; }
    [Parameter] public string? Heading { get; set; }
    [Parameter] public bool ShowDividerAbove { get; set; }
    [Parameter] public bool ShowDividerBelow { get; set; } = true;
    [Parameter] public string DividerLabel { get; set; } = "or continue with";
    [Parameter] public string BelowDividerLabel { get; set; } = "or use email and password";
    [Parameter] public bool ShowExtraProviders { get; set; } = true;
    /// <summary>Visual tone: default | dark (bos/cp/erp panels).</summary>
    [Parameter] public string Tone { get; set; } = "default";

    private string _toneClass =>
        string.Equals(Tone, "dark", StringComparison.OrdinalIgnoreCase) ? "epc-social--dark" : "";

    private string PhpAuthContext =>
        string.Equals(Context, "storefront", StringComparison.OrdinalIgnoreCase) ? "storefront" : "cp";

    private string StartHref(string provider)
    {
        var qs = new List<string>
        {
            "provider=" + Uri.EscapeDataString(provider),
            "context=" + Uri.EscapeDataString(PhpAuthContext),
        };
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            qs.Add("return_url=" + Uri.EscapeDataString(ReturnUrl));
        }
        if (!string.IsNullOrWhiteSpace(TenantKey))
        {
            qs.Add("tenant_key=" + Uri.EscapeDataString(TenantKey));
        }
        // Product path matches PHP twin; php-reference alias kept for archive probes.
        return "/api/epc_oauth_start.php?" + string.Join('&', qs);
    }
}
