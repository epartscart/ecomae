    <script>
    (function () {
        var panel = document.getElementById('epc-ai-expert-panel');
        var log = document.getElementById('epc-ai-expert-log');
        var form = document.getElementById('epc-ai-expert-panel-form');
        var input = document.getElementById('epc-ai-expert-panel-input');
        var csrf = null;
        var busy = false;
        function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
        function bubble(html, cls) {
            var d = document.createElement('div');
            d.className = 'epc-ai-expert-msg ' + (cls || 'epc-ai-expert-msg--bot');
            d.innerHTML = html;
            log.appendChild(d);
            log.scrollTop = log.scrollHeight;
            return d;
        }
        function toggle(open) {
            panel.classList.toggle('open', open);
            if (open) input.focus();
        }
        var tg = document.getElementById('epc-ai-expert-toggle');
        var cl = document.getElementById('epc-ai-expert-close');
        if (tg) tg.addEventListener('click', function () { toggle(!panel.classList.contains('open')); });
        if (cl) cl.addEventListener('click', function () { toggle(false); });
        function api(params) {
            return fetch('/api/epc_ai_parts_expert.php?' + params, { credentials: 'same-origin' }).then(function (r) { return r.json(); });
        }
        function ensureCsrf() {
            if (csrf) return Promise.resolve(csrf);
            return api('action=bootstrap').then(function (b) {
                if (b && b.csrf) { csrf = b.csrf; return csrf; }
                throw new Error('bootstrap');
            });
        }
        function renderReply(data, article) {
            if (!data || data.ok === false) {
                bubble('Sorry, I could not look that up right now. Please try again.');
                return;
            }
            var html = '';
            var stock = data.local_stock || [];
            if (stock.length > 0) {
                html += '<strong>' + esc(article) + '</strong> — found in warehouse:<ul>';
                stock.forEach(function (s) {
                    var line = esc(s.brand) + ' ' + esc(s.article) + (s.name ? ' · ' + esc(s.name) : '');
                    var det = [s.qty != null ? 'qty ' + esc(s.qty) : '', s.warehouse ? esc(s.warehouse) : '', s.price ? esc(s.price) + ' ' + esc(s.currency || '') : ''].filter(Boolean).join(' · ');
                    html += '<li>' + line + (det ? ' <em>(' + det + ')</em>' : '') + '</li>';
                });
                html += '</ul>';
            }
            var brands = data.umapi_brands || [];
            if (brands.length > 0) {
                html += (html ? '' : '<strong>' + esc(article) + '</strong> ') + 'Available in catalog under: <strong>' +
                    brands.map(function (b) { return esc(b.BRAND || b.brand || ''); }).filter(Boolean).join(', ') + '</strong>';
            }
            (data.messages || []).forEach(function (m) { html += (html ? '<br>' : '') + esc(m); });
            if (!html) html = 'No match found for <strong>' + esc(article) + '</strong> in warehouse or catalogs.';
            if (data.part_url) html += '<br><a href="' + esc(data.part_url) + '">Open part page →</a>';
            bubble(html);
        }
        if (form) form.addEventListener('submit', function (ev) {
            ev.preventDefault();
            if (busy) return;
            var article = (input.value || '').replace(/\s+/g, ' ').trim();
            var norm = article.replace(/[ \-_`'"\\\.,#\r\n\t/]/g, '');
            if (norm.length < 3) {
                bubble('Please enter a part number of at least 3 letters/digits.');
                input.focus();
                return;
            }
            busy = true;
            input.value = '';
            bubble(esc(article), 'epc-ai-expert-msg--user');
            var think = bubble('Checking stock and catalogs…');
            ensureCsrf()
                .then(function (token) {
                    return api('action=search&csrf=' + encodeURIComponent(token) + '&article=' + encodeURIComponent(article));
                })
                .then(function (data) { think.remove(); renderReply(data, article); })
                .catch(function () { think.remove(); bubble('Something went wrong — please try again.'); })
                .finally(function () { busy = false; input.focus(); });
        });
    })();
    </script>

