@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject IHttpContextAccessor Http
@inject ILegacySessionValidator Sessions
@inject EcomAE.Platform.Data.ITenantDbConnectionFactory Connections
@inject ITenantPresentationProvider TenantPresentation
@*
  PHP nero storefront chrome on ASP.NET (same-to-same vs templates/nero/desktop.php).
  Interim: catalog/search/cart/login point at working PHP /en/… pages (tenant /storefront/*
  tree often 404 until classic-entry storefront nginx is installed + dual-sample).
*@

@*
  Critical header CSS is emitted in the BODY (start of .epc-nero-shell), not only
  HeadContent. Live epartscart SSR (FORCE_LIVE prove) has dropped late HeadContent
  for this component tree while keeping body <style> from catalog widgets — so
  body emission is the durable path for header-call-box / top-menu prove markers.
*@
<HeadContent>
<meta name="ecomae-storefront-chrome-css" content="body-inline" />
@if (IsEpartscartHost)
{
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#dc2626" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="eParts Cart" />
    <link rel="apple-touch-icon" href="/icons/pwa-icon-192.svg" />
}
</HeadContent>
@if (IsEpartscartHost)
{
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#dc2626" />
    <meta name="apple-mobile-web-app-title" content="eParts Cart" />
    <link rel="apple-touch-icon" href="/icons/pwa-icon-192.svg" />
    <script>
    (function () {
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(function () {});
        }, { once: true });
      }
    })();
    </script>
}
<style>
