    private int _compareCount;
    private string _addedLabel = "";
    private string _cartScript = StorefrontBottomPanelCart.Script(string.Empty, false, false);

    private string? _tenantCss;
    private IReadOnlyDictionary<string, object>? _tenantAttrs;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        var presentation = await TenantPresentation.GetAsync(ctx, ctx.RequestAborted);
        _siteKey =
            (ctx.Items[EcomAE.Platform.Middleware.TenantResolutionMiddleware.HttpContextItemKey]
                as EcomAE.Platform.Services.TenantContext)?.SiteKey ?? string.Empty;
        var css = presentation.BuildCss();
        if (!string.IsNullOrWhiteSpace(css) || presentation.Values.Count > 0)
        {
            _tenantCss = css;
            _tenantAttrs = presentation.Attributes();
        }

        _bookmarkCount = StorefrontIntListCookie.Read(ctx.Request, StorefrontIntListCookie.BookmarksName, StorefrontIntListCookie.BookmarksMax).Count;
        _compareCount = StorefrontIntListCookie.Read(ctx.Request, StorefrontIntListCookie.CompareName, StorefrontIntListCookie.CompareMax).Count;
        await LoadCartPanelAsync(ctx);

        LegacySessionContext session;
        try
        {
            session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        }
        catch
        {
            return;
        }

        _signedIn = session.Kind is LegacySessionKind.Customer or LegacySessionKind.Admin;
        _userId = session.Kind == LegacySessionKind.Customer ? session.UserId : 0;
        if (_signedIn)
        {
            _userLabel = string.IsNullOrWhiteSpace(session.Email)
                ? (session.Kind == LegacySessionKind.Admin ? "Admin" : "Account")
                : session.Email!;
        }
    }

    /// <summary>PHP <c>bottom_panel.php</c> cart block: <c>DP_User::getUserSession()</c> key, current front template, string 4225.</summary>
    private async Task LoadCartPanelAsync(HttpContext ctx)
    {
        var sessionCookie = ctx.Request.Cookies["session"];
        var userCookie = ctx.Request.Cookies["u_id"];
        if (!Connections.IsConfigured)
        {
            _cartScript = StorefrontBottomPanelCart.Script(string.Empty, sessionCookie is not null, false);
            return;
        }

        try
        {
            var tenant = ctx.Items[EcomAE.Platform.Middleware.TenantResolutionMiddleware.HttpContextItemKey] as EcomAE.Platform.Services.TenantContext;
            await using var connection = await Connections.OpenForTenantAsync(tenant, ctx.RequestAborted);
            _cartScript = StorefrontBottomPanelCart.Script(
                await StorefrontBottomPanelCart.CsrfGuardKeyAsync(connection, sessionCookie, userCookie, ctx.RequestAborted),
                sessionCookie is not null,
                await StorefrontBottomPanelCart.FrontTemplateIdAsync(connection, ctx.RequestAborted) == StorefrontBottomPanelCart.NewFrontTemplateId);
            _addedLabel = await new StorefrontPhpTranslator(connection, StorefrontRegFormLoader.LangCode(StorefrontPhpHomeLinks.LangHref(ctx)))
                .TextAsync(StorefrontBottomPanelCart.AddedStringId, ctx.RequestAborted);
        }
        catch (System.Data.Common.DbException)
        {
            _cartScript = StorefrontBottomPanelCart.Script(string.Empty, sessionCookie is not null, false);
        }
        catch (InvalidOperationException)
        {
            _cartScript = StorefrontBottomPanelCart.Script(string.Empty, sessionCookie is not null, false);
        }
    }
}
