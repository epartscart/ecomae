@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http
@inject ILegacySessionValidator Sessions
@*
  PHP nero storefront chrome on ASP.NET (same-to-same vs templates/nero/desktop.php).
  Interim: catalog/search/cart/login point at working PHP /en/… pages (tenant /storefront/*
  tree often 404 until classic-entry storefront nginx is installed + dual-sample).
*@

<div class="epc-nero-shell epc-php-font-root">
    <header class="hidden-xs epc-nero-header">
        <div class="top-menu-line" style="background:#1a1a1a;">
            <div class="container">
                <table class="epc-nero-top-table">
                    <tr>
                        <td>
                            <nav class="navbar navbar-default navbar-header-full yamm navbar-static-top" id="header" role="navigation" aria-label="Storefront top menu">
                                <ul class="nav navbar-nav">
                                    <li><a href="/">Home</a></li>
                                    <li class="dropdown">
                                        <a href="javascript:void(0)" class="dropdown-toggle" aria-haspopup="true">Product</a>
                                        <ul class="dropdown-menu">
                                            <li><a href="@StorefrontSurfaceLinks.ProductFamily">Product Family</a></li>
                                            <li><a href="@StorefrontSurfaceLinks.AvailableBrands">Available brands</a></li>
                                            <li><a href="@StorefrontSurfaceLinks.PartsInStock">Brand in stock</a></li>
                                            <li><a href="@StorefrontSurfaceLinks.Accessories">Accessories</a></li>
                                        </ul>
                                    </li>
                                    <li class="dropdown">
                                        <a href="javascript:void(0)" class="dropdown-toggle" aria-haspopup="true">Selection catalogs</a>
                                        <ul class="dropdown-menu">
                                            <li><a href="@StorefrontSurfaceLinks.EpartsCata">EParts CATA</a></li>
                                            <li><a href="@StorefrontSurfaceLinks.EpartsMod">EParts Mod</a></li>
                                            <li><a href="@StorefrontSurfaceLinks.PartsApiCatalog">EParts CatAPI</a></li>
                                            <li><a href="@StorefrontSurfaceLinks.LevamOem">OEM</a></li>
                                            <li><a href="@StorefrontSurfaceLinks.LaximoVin">Vehicle catalog</a></li>
                                            <li><a href="@StorefrontSurfaceLinks.VehicleCatalog">Vehicle parts catalog</a></li>
                                            <li><a href="@StorefrontSurfaceLinks.UmapiCatalog">Epart Catalog</a></li>
                                            <li><a href="@StorefrontSurfaceLinks.UcatsService">Epart Service Catalog</a></li>
                                        </ul>
                                    </li>
                                    <li><a href="@StorefrontSurfaceLinks.OriginalCatalog">Original catalog</a></li>
                                    <li><a href="@StorefrontSurfaceLinks.DemandIntelligence">Vehicle Parts intelligence AI</a></li>
                                </ul>
                            </nav>
                        </td>
                        <td class="epc-nero-top-actions">
                            <div class="new-header-user-box">
                                <a href="@StorefrontSurfaceLinks.GarageLogin"><i class="fa fa-wrench" aria-hidden="true"></i> Garage Manager</a>
                            </div>
                            <div class="new-header-user-box epc-erp-header-link">
                                <a href="/erp" title="ERP Login"><i class="fa fa-line-chart" aria-hidden="true"></i> ERP Login</a>
                            </div>
                            @if (_signedIn)
                            {
                                <div class="new-header-user-box">
                                    <a href="@StorefrontSurfaceLinks.Orders"><i class="fa fa-user" aria-hidden="true"></i> @_userLabel</a>
                                </div>
                                <div class="new-header-user-box">
                                    <a href="/storefront/logout" title="Log out"><i class="fa fa-sign-out" aria-hidden="true"></i> Log out</a>
                                </div>
                            }
                            else
                            {
                                <div class="new-header-user-box">
                                    <span class="epc-auth-header-links">
                                        <span class="epc-auth-header-links__group epc-auth-header-links__group--vendor">
                                            <i class="fa fa-briefcase epc-auth-header-links__icon" aria-hidden="true"></i>
                                            <a class="epc-auth-header-links__vendor-login" href="@StorefrontSurfaceLinks.Login" title="Vendor portal login">Vendor login</a>
                                            <span class="epc-auth-header-links__slash" aria-hidden="true">/</span>
                                            <a class="epc-auth-header-links__vendor-register" href="/en/vendor/register" title="Vendor registration">Register</a>
                                        </span>
                                        <span class="epc-auth-header-links__sep" aria-hidden="true">|</span>
                                        <span class="epc-auth-header-links__group epc-auth-header-links__group--customer">
                                            <i class="fa fa-user epc-auth-header-links__icon" aria-hidden="true"></i>
                                            <a class="epc-auth-header-links__login" href="@StorefrontSurfaceLinks.Login" title="Customer login">Customer login</a>
                                            <span class="epc-auth-header-links__slash" aria-hidden="true">/</span>
                                            <a class="epc-auth-header-links__signup" href="/en/users/registration" title="Customer registration">register</a>
                                        </span>
                                    </span>
                                </div>
                            }
                            <div class="new-header-user-box">
                                <a href="javascript:void(0)" class="epc-lang-toggle" title="Language">EN <i class="fa fa-chevron-down" aria-hidden="true"></i></a>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="logo-line">
            <div class="container">
                <div class="table-group">
                    <div class="table-control">
                        <a class="header-logo" href="/">
                            <PhpEpartsCartAnimatedLogo Variant="header" />
                        </a>
                    </div>
                    <div class="table-control epc-header-contact-col">
                        <div class="epc-header-geo-phone">
                            <div class="geo-point-box text-left">
                                <table>
                                    <tr>
                                        <td><i class="fa fa-location-arrow" aria-hidden="true"></i></td>
                                        <td><span>Dubai<br />United Arab Emirates</span></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="header-phone-box text-left">
                                <a href="tel:+971567607011" class="phone call-me">+971-567607011</a>
                            </div>
                        </div>
                        <div class="timetable-box text-left">
                            <table>
                                <tr>
                                    <td><i class="fa fa-clock-o" aria-hidden="true"></i></td>
                                    <td><span>Mon-Fri from 9:00 to 18:00, Sat from 9:00 to 16:00, Sun - day off.</span></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="table-control epc-header-right-col">
                        <div class="epc-header-actions-row">
                            <div class="header-call-box"><a href="@StorefrontSurfaceLinks.SellerRequest">Request a call back</a></div>
                            <div class="header-whatsapp-box">
                                <a href="https://wa.me/971567607011" target="_blank" rel="noopener noreferrer" title="Chat on WhatsApp">
                                    <i class="fa fa-whatsapp" aria-hidden="true"></i> WhatsApp contact
                                </a>
                            </div>
                            <div class="header-bulk-upload-box">
                                <a href="/en/shop/bulk-upload"><i class="fa fa-file-excel-o" aria-hidden="true"></i> Excel bulk upload</a>
                            </div>
                            <div class="epc-currency-switcher">
                                <select id="epc_currency_select" aria-label="Display currency">
                                    <option value="AED" selected>AED</option>
                                    <option value="USD">USD</option>
                                    <option value="EUR">EUR</option>
                                    <option value="PKR">PKR</option>
                                    <option value="RUB">RUB</option>
                                    <option value="SAR">SAR</option>
                                    <option value="KWD">KWD</option>
                                    <option value="OMR">OMR</option>
                                </select>
                                <div class="epc-currency-note">Display currency</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="schearch-line">
            <div class="container">
                <div class="row epc-schearch-row">
                    <div class="col-sm-7 col-md-8 epc-schearch-main">
                        <table>
                            <tr>
                                <td>
                                    <a class="header-home-btn" href="/" aria-label="Home"><i class="fa fa-home" aria-hidden="true"></i></a>
                                    <a class="header-cat-btn" href="@StorefrontSurfaceLinks.ProductFamily"><i class="fa fa-bars" aria-hidden="true"></i> Catalog <span class="hidden-sm">of products</span></a>
                                </td>
                                <td class="search-table-td">
                                    <div class="header-search-box epc-header-search" data-active-mode="1" id="epc-header-search">
                                        <div class="epc-header-search__tabs" role="tablist" aria-label="Search type">
                                            <button type="button" class="epc-header-search__tab active" data-search-mode="1" role="tab" aria-selected="true"><i class="fa fa-barcode" aria-hidden="true"></i><span>Part number</span></button>
                                            <button type="button" class="epc-header-search__tab" data-search-mode="3" role="tab" aria-selected="false"><i class="fa fa-id-card" aria-hidden="true"></i><span>VIN</span></button>
                                            <button type="button" class="epc-header-search__tab" data-search-mode="engine" role="tab" aria-selected="false"><i class="fa fa-cogs" aria-hidden="true"></i><span>Engine</span></button>
                                            <button type="button" class="epc-header-search__tab" data-search-mode="car" role="tab" aria-selected="false"><i class="fa fa-car" aria-hidden="true"></i><span>By car</span></button>
                                            <button type="button" class="epc-header-search__tab" data-search-mode="attr" role="tab" aria-selected="false"><i class="fa fa-sliders" aria-hidden="true"></i><span>More info</span></button>
                                        </div>
                                        <div class="epc-header-search__body">
                                            <form action="@StorefrontSurfaceLinks.PartSearch" method="get" class="header_search_form_1">
                                                <div class="input-group">
                                                    <input type="text" class="form-control" name="article" placeholder="Part number or OE code" autocomplete="off" aria-label="Part number" />
                                                    <span class="input-group-btn">
                                                        <button class="btn btn-ar btn-primary" type="submit">Search</button>
                                                    </span>
                                                </div>
                                            </form>
                                            <form action="@StorefrontSurfaceLinks.NameSearch" method="get" class="header_search_form_2 hidden">
                                                <div class="input-group">
                                                    <input type="text" class="form-control" name="search_string" placeholder="In own catalog" autocomplete="off" aria-label="Search by name" />
                                                    <span class="input-group-btn">
                                                        <button class="btn btn-ar btn-primary" type="submit">Search</button>
                                                    </span>
                                                </div>
                                            </form>
                                            <form action="@StorefrontSurfaceLinks.LaximoVin" method="get" class="header_search_form_3 hidden" onsubmit="return window.epcHeaderVinSubmit(this);">
                                                <input type="hidden" name="task" value="vehicles" />
                                                <input type="hidden" name="ft" value="FindVehicle" />
                                                <input type="hidden" name="c" value="" />
                                                <input type="hidden" name="ssd" value="" />
                                                <div class="input-group">
                                                    <input type="text" class="form-control epc-header-search__vin-input" name="identString" maxlength="32" placeholder="Enter VIN / Frame" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="VIN" />
                                                    <span class="input-group-btn">
                                                        <button class="btn btn-ar btn-primary" type="submit">Search</button>
                                                    </span>
                                                </div>
                                            </form>
                                            <form action="@StorefrontSurfaceLinks.VehicleCatalog" method="get" class="header_search_form_engine hidden" onsubmit="return window.epcHeaderEngineSubmit(this);">
                                                <div class="input-group">
                                                    <input type="text" class="form-control epc-header-search__engine-input" name="engine" maxlength="12" placeholder="Engine code (e.g. 3L, 12R, 5L)" autocomplete="off" aria-label="Engine code" />
                                                    <span class="input-group-btn">
                                                        <button class="btn btn-ar btn-primary" type="submit">Search</button>
                                                    </span>
                                                </div>
                                            </form>
                                            <div class="header_search_form_car hidden">
                                                <a class="epc-header-search__car-link" href="@StorefrontSurfaceLinks.VehicleCatalog">
                                                    <span class="epc-header-search__car-copy"><i class="fa fa-list-ol" aria-hidden="true"></i> Choose year, make, model and engine</span>
                                                    <strong>Open vehicle catalog</strong>
                                                </a>
                                            </div>
                                            <form action="@StorefrontSurfaceLinks.WarehouseSearch" method="get" class="header_search_form_attr hidden" onsubmit="return window.epcHeaderAttrSubmit(this);">
                                                <div class="epc-header-search__attr-row">
                                                    <select class="form-control epc-header-search__attr-field" name="field" aria-label="Search field">
                                                        <option value="all" selected>All fields</option>
                                                        <option value="engine_code">Engine code</option>
                                                        <option value="country_code">Country code</option>
                                                        <option value="size">Size</option>
                                                        <option value="cross_reference">Cross reference</option>
                                                        <option value="oe_number">OE number</option>
                                                        <option value="color">Color</option>
                                                        <option value="weight">Weight</option>
                                                        <option value="model">Model</option>
                                                        <option value="year">Year</option>
                                                        <option value="position">Position</option>
                                                        <option value="material">Material</option>
                                                        <option value="voltage">Voltage</option>
                                                        <option value="other">Other information</option>
                                                    </select>
                                                    <div class="input-group">
                                                        <input type="text" class="form-control epc-header-search__attr-input" name="q" maxlength="120" placeholder="Engine, size, country, cross ref…" autocomplete="off" aria-label="Warehouse / more info search" />
                                                        <span class="input-group-btn">
                                                            <button class="btn btn-ar btn-primary" type="submit">Search</button>
                                                        </span>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-sm-5 col-md-4">
                        <div class="menu-box" aria-label="Account shortcuts">
                            <div class="menu-box-item"><a title="Orders" href="@StorefrontSurfaceLinks.Orders" class="orders-i"><i class="fa fa-list-alt" aria-hidden="true"></i></a></div>
                            <div class="menu-box-item"><a title="Compare" href="@StorefrontSurfaceLinks.PartSearch"><i class="fa fa-exchange" aria-hidden="true"></i></a></div>
                            <div class="menu-box-item"><a title="Bookmarks" href="@StorefrontSurfaceLinks.PartSearch"><i class="fa fa-bookmark" aria-hidden="true"></i></a></div>
                            <div class="menu-box-item"><a title="Garage" href="@StorefrontSurfaceLinks.GarageLogin"><i class="fa fa-car" aria-hidden="true"></i></a></div>
                            <div class="menu-box-item"><a title="Balance" href="@StorefrontSurfaceLinks.Orders"><i class="fa fa-money" aria-hidden="true"></i></a></div>
                            <div class="menu-box-item"><a title="Cart" href="@StorefrontSurfaceLinks.Cart"><i class="fa fa-shopping-cart" aria-hidden="true"></i></a></div>
                            <div class="menu-box-item"><a title="Quotes" href="@StorefrontSurfaceLinks.Orders"><i class="fa fa-file-text-o" aria-hidden="true"></i></a></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="header-box-mobile hidden-sm hidden-md hidden-lg">
        <div class="container">
            <a class="logo_min" href="/"><PhpEpartsCartAnimatedLogo Variant="header" /></a>
            <a class="mobile-box-phone" href="tel:+971567607011">+971-567607011</a>
            <a class="mobile-box-whatsapp" href="https://wa.me/971567607011" target="_blank" rel="noopener noreferrer"><i class="fa fa-whatsapp" aria-hidden="true"></i> WhatsApp</a>
            <a href="@StorefrontSurfaceLinks.PartSearch"><i class="fa fa-search" aria-hidden="true"></i> Search</a>
            <a href="@StorefrontSurfaceLinks.GarageLogin"><i class="fa fa-wrench" aria-hidden="true"></i> Garage</a>
            <a class="mobile-box-erp-login" href="/erp"><i class="fa fa-line-chart" aria-hidden="true"></i> ERP Login</a>
            @if (_signedIn)
            {
                <a href="@StorefrontSurfaceLinks.Orders"><i class="fa fa-user" aria-hidden="true"></i> Account</a>
                <a href="/storefront/logout"><i class="fa fa-sign-out" aria-hidden="true"></i> Log out</a>
            }
            else
            {
                <a href="@StorefrontSurfaceLinks.Login"><i class="fa fa-user" aria-hidden="true"></i> Login</a>
            }
        </div>
    </div>

    <div id="sb-site">
        <div class="boxed">
            <div class="container">
                <div class="row">
                    <div id="right_col">
                        <div id="Container">
                            @ChildContent
                        </div>
                    </div>
                </div>
            </div>

            <aside id="footer-widgets" style="background:#1a1a1a;color:#e5e7eb;">
                <div class="container">
                    <div class="row epc-footer-widgets-row">
                        <div class="col-md-8">
                            <div class="row">
                                <div class="col-sm-4">
                                    <h3 class="footer-widget-title">For customers</h3>
                                    <ul class="epc-footer-menu">
                                        <li><a href="@StorefrontSurfaceLinks.Orders">My orders</a></li>
                                        <li><a href="@StorefrontSurfaceLinks.GarageLogin">Garage</a></li>
                                        <li><a href="@StorefrontSurfaceLinks.Login">Profile</a></li>
                                        <li><a href="@StorefrontSurfaceLinks.Orders">Account summary</a></li>
                                    </ul>
                                </div>
                                <div class="col-sm-4">
                                    <h3 class="footer-widget-title">Information</h3>
                                    <ul class="epc-footer-menu">
                                        <li><a href="@StorefrontSurfaceLinks.PartSearch">Part search</a></li>
                                        <li><a href="@StorefrontSurfaceLinks.VehicleCatalog">Vehicle catalog</a></li>
                                        <li><a href="@StorefrontSurfaceLinks.WarehouseSearch">Warehouse / more info</a></li>
                                        <li><a href="/php-reference/home">PHP reference home</a></li>
                                    </ul>
                                </div>
                                <div class="col-sm-4">
                                    <h3 class="footer-widget-title">Online store</h3>
                                    <ul class="epc-footer-menu">
                                        <li><a href="@StorefrontSurfaceLinks.Cart">Cart</a></li>
                                        <li><a href="@StorefrontSurfaceLinks.Checkout">Checkout</a></li>
                                        @if (_signedIn)
                                        {
                                            <li><a href="@StorefrontSurfaceLinks.Orders">My account</a></li>
                                            <li><a href="/storefront/logout">Log out</a></li>
                                        }
                                        else
                                        {
                                            <li><a href="@StorefrontSurfaceLinks.Login">Customer login</a></li>
                                        }
                                        <li><a href="/erp">ERP Login</a></li>
                                    </ul>
                                </div>
                            </div>
                            <h3 class="footer-widget-title">Send request</h3>
                            <p>Need help finding a part? Send a request to our sales team.</p>
                            <div class="input-group">
                                <a class="btn btn-block btn-ar btn-primary" href="@StorefrontSurfaceLinks.SellerRequest">Send a request to seller</a>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <h3 class="footer-widget-title">Contacts</h3>
                            <div class="epc-footer-locations">
                                <div class="epc-footer-office">
                                    <strong><i class="fa fa-map-marker" aria-hidden="true"></i> Head Office</strong>
                                    <span>Dubai, United Arab Emirates</span>
                                    <span>+971-567607011</span>
                                    <span>info@epartscart.com</span>
                                </div>
                                <div class="epc-footer-global">
                                    <strong><i class="fa fa-globe" aria-hidden="true"></i> Global locations</strong>
                                    <span>15 countries, multiple locations</span>
                                </div>
                            </div>
                            <h3 class="footer-widget-title">Working mode</h3>
                            <div>Mon-Fri from 9:00 to 18:00, Sat from 9:00 to 16:00, Sun - day off.</div>
                            <h3 class="footer-widget-title">Accept for payment</h3>
                            <div class="epc-footer-pay">Visa · Mastercard · Bank transfer · Cash</div>
                        </div>
                    </div>
                </div>
            </aside>

            <footer id="footer" style="background:#111;color:#94a3b8;">
                <div class="container">
                    <p>&copy; @DateTime.UtcNow.Year eParts Cart</p>
                </div>
            </footer>
        </div>
    </div>

    <div id="epc-ai-expert-widget" class="epc-ai-expert-widget" aria-live="polite">
        <a class="epc-ai-expert-widget__launcher" href="@StorefrontSurfaceLinks.PartSearch" title="AI Parts Expert — part number lookup">
            <span class="epc-ai-expert-widget__launcher-icon"><i class="fa fa-search" aria-hidden="true"></i></span>
            <span class="epc-ai-expert-widget__launcher-label">AI Parts Expert</span>
            <span class="epc-ai-expert-widget__live">Live</span>
        </a>
    </div>

    <nav class="epc-bottom-dock" aria-label="Quick dock">
        <a href="/"><i class="fa fa-home" aria-hidden="true"></i><span>Home</span></a>
        <a href="@StorefrontSurfaceLinks.PartSearch"><i class="fa fa-search" aria-hidden="true"></i><span>Search</span></a>
        <a href="@StorefrontSurfaceLinks.Cart"><i class="fa fa-shopping-cart" aria-hidden="true"></i><span>Cart</span></a>
        <a href="@StorefrontSurfaceLinks.GarageLogin"><i class="fa fa-wrench" aria-hidden="true"></i><span>Garage</span></a>
        <a href="@StorefrontSurfaceLinks.Login"><i class="fa fa-user" aria-hidden="true"></i><span>Account</span></a>
    </nav>
</div>

<style>
    /*
      Header polish is inlined so live look cannot depend on a missing /content/*.css
      (tenant www often stale even after Kestrel publish). External professional shell CSS
      still loads when present and can refine further.
    */
    .epc-nero-shell {
        --red:#dc2626; --red-dark:#b91c1c; --red-hot:#ef4444; --nero-accent:#ff8040;
        font-family: @(LegacyPhpFontAssets.StackFor("storefront")); font-size: @(LegacyPhpFontAssets.BaseFontSize);
        color:#111; background:#fff; min-height:100vh;
        padding-bottom:3.5rem;
    }
    .epc-nero-shell a { text-decoration:none; }
    .epc-animated-logo__text { color:#dc2626 !important; font-family:Arial,Helvetica,sans-serif; font-style:italic; font-weight:900; text-transform:lowercase; }
    .header-logo .epc-animated-logo__text { font-size:clamp(34px, 3.2vw, 56px); transform:skewX(-8deg); }
    .header-logo .epc-animated-logo__mark { height:72px; width:158px; }
    .header-call-box a, .header-whatsapp-box a, .header-bulk-upload-box a {
        align-items:center; border-radius:999px; display:inline-flex; font-size:13px; font-weight:800; gap:8px;
        justify-content:center; min-height:46px; padding:11px 18px; text-decoration:none !important; white-space:nowrap;
        box-shadow:0 10px 22px rgba(15,23,42,.12);
    }
    .header-call-box a { background:#ef4444; color:#fff !important; }
    .header-whatsapp-box a { background:#16a34a; color:#fff !important; }
    .header-bulk-upload-box a { background:#2563eb; color:#fff !important; }
    .epc-currency-note { display:none; }
    .schearch-line {
        background:linear-gradient(135deg,#111827 0%,#0f172a 100%) !important;
        box-shadow:0 18px 36px rgba(15,23,42,.14); padding:14px 0 16px !important;
    }
    .header-home-btn {
        background:rgba(255,255,255,.1) !important; border:1px solid rgba(255,255,255,.14) !important;
        color:#fff !important; border-radius:14px !important; font-weight:800; min-height:52px; padding:12px 18px !important;
        display:inline-flex; align-items:center;
    }
    .header-cat-btn {
        background:#ef4444 !important; border:1px solid #ef4444 !important; color:#fff !important;
        border-radius:14px !important; font-weight:800; min-height:52px; padding:12px 18px !important;
        display:inline-flex; align-items:center; gap:.35rem;
    }
    .header-search-box .btn-primary, .header-search-box .btn-ar {
        background:#ef4444 !important; border-color:#ef4444 !important; color:#fff !important; font-weight:800;
    }
    .epc-header-search__tab.active { color:#ef4444 !important; border-color:#ef4444 !important; }
