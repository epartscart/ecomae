@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Home body sections rendered BEFORE #sb-site (same slot as PHP desktop.php).</summary>
    [Parameter] public RenderFragment? HomeContent { get; set; }

    private bool IsEpartscartHost =>
        StorefrontPublicSeo.IsEpartscartHostname(Http.HttpContext?.Request.Host.Host);

    private bool IsAuto247Host =>
        _siteKey == "auto247";

    private string _siteKey = string.Empty;


    private bool _signedIn;
