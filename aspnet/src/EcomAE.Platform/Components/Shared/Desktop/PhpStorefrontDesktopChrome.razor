@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation
@*
  PHP-style storefront chrome on ASP.NET (modex/nero look).
  All primary links are ASP.NET routes; PHP only via /php-reference/*.
*@

<div class="epc-modex-shell epc-php-font-root">
    <div class="header-top-line">
        <div class="container">
            <div class="row">
                <div class="col-xs-6">Dubai · Mon–Sat 9:00–18:00</div>
                <div class="col-xs-6 text-right">
                    <a href="tel:+971567607011">+971-567607011</a>
                    ·
                    <a href="/storefront/login">Customer login</a>
                    ·
                    <a href="/storefront/login">Vendor login</a>
                    ·
                    <a href="/erp">ERP Login</a>
                </div>
            </div>
        </div>
    </div>

    <div id="header-box">
        <header id="header-full-top" class="header-full-top">
            <div class="container table-group">
                <div class="table-control">
                    <a class="header-logo" href="/">
                        <img src="@LegacyPresentationAssets.EpartsCartMarkUrl" alt="eparts" />
                    </a>
                </div>
                <div class="table-control header-search-box epc-header-search" data-active-mode="1">
                    <div class="epc-header-search__tabs" role="tablist" aria-label="Search type">
                        <button type="button" class="epc-header-search__tab active" data-search-mode="1" role="tab" aria-selected="true"><i class="fa fa-barcode" aria-hidden="true"></i><span>Part number</span></button>
                        <button type="button" class="epc-header-search__tab" data-search-mode="3" role="tab" aria-selected="false"><i class="fa fa-id-card" aria-hidden="true"></i><span>VIN</span></button>
                        <button type="button" class="epc-header-search__tab" data-search-mode="engine" role="tab" aria-selected="false"><i class="fa fa-cogs" aria-hidden="true"></i><span>Engine</span></button>
                        <button type="button" class="epc-header-search__tab" data-search-mode="car" role="tab" aria-selected="false"><i class="fa fa-car" aria-hidden="true"></i><span>By car</span></button>
                        <button type="button" class="epc-header-search__tab" data-search-mode="attr" role="tab" aria-selected="false"><i class="fa fa-sliders" aria-hidden="true"></i><span>More info</span></button>
                    </div>
                    <form class="header_search_form_1" action="/storefront/search-app" method="get">
                        <input type="search" name="article" placeholder="Part number or OE code" aria-label="Part number" />
                        <button type="submit">Search</button>
                    </form>
                </div>
                <div class="table-control header-user-box">
                    <a class="header-call-box" href="/storefront/search-app">Request a call back</a>
                    <a class="header-whatsapp-box" href="https://wa.me/971567607011" target="_blank" rel="noopener noreferrer"><i class="fa fa-whatsapp" aria-hidden="true"></i> WhatsApp contact</a>
                    <a class="header-cart-box" href="/storefront/cart-app">Cart</a>
                    <a href="/storefront/login">Account</a>
                    <a href="/storefront/garage-app"><i class="fa fa-wrench" aria-hidden="true"></i> Garage Manager</a>
                    <a href="/erp"><i class="fa fa-line-chart" aria-hidden="true"></i> ERP Login</a>
                </div>
            </div>
        </header>

        <nav class="navbar navbar-default navbar-header-full yamm" id="header" aria-label="Storefront menu">
            <div class="container">
                <ul class="nav navbar-nav">
                    @foreach (var item in PhpModuleCatalog.StorefrontSurfaces)
                    {
                        <li><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(item.Href)">@item.Label</a></li>
                    }
                    <li><a href="/cp">Control Panel</a></li>
                    <li><a href="/erp">ERP</a></li>
                    <li><a href="/bos">BOS</a></li>
                </ul>
            </div>
        </nav>
    </div>

    <div id="sb-site" class="boxed">
        <div class="container">
            <div class="row">
                <div id="right_col">
                    <div id="Container">
                        @ChildContent
                    </div>
                </div>
            </div>
        </div>
        <aside id="footer-widgets">
            <div class="container">
                Parts search · garage · orders · checkout · <a href="/storefront/search-app">Open search</a>
            </div>
        </aside>
        <footer id="footer">
            <div class="container">eParts Cart</div>
        </footer>
    </div>

    <div id="epc-ai-expert-widget" class="epc-ai-expert-widget" aria-live="polite">
        <a class="epc-ai-expert-widget__launcher" href="/storefront/search-app" title="AI Parts Expert — part number lookup">
            <span class="epc-ai-expert-widget__launcher-icon"><i class="fa fa-search" aria-hidden="true"></i></span>
            <span class="epc-ai-expert-widget__launcher-label">AI Parts Expert</span>
            <span class="epc-ai-expert-widget__live">Live</span>
        </a>
    </div>

    <nav class="epc-bottom-dock" aria-label="Quick dock">
        <a href="/"><i class="fa fa-home" aria-hidden="true"></i><span>Home</span></a>
        <a href="/storefront/search-app"><i class="fa fa-search" aria-hidden="true"></i><span>Search</span></a>
        <a href="/storefront/cart-app"><i class="fa fa-shopping-cart" aria-hidden="true"></i><span>Cart</span></a>
        <a href="/storefront/garage-app"><i class="fa fa-wrench" aria-hidden="true"></i><span>Garage</span></a>
        <a href="/storefront/login"><i class="fa fa-user" aria-hidden="true"></i><span>Account</span></a>
    </nav>
</div>

<style>
    .epc-modex-shell {
        --red:#dc2626; --red-dark:#b91c1c; --red-hot:#ef4444; --modex-primary:#ff8040;
        font-family: @(LegacyPhpFontAssets.StackFor("storefront")); color:#111; background:#fff; min-height:100vh;
        padding-bottom:3.5rem;
    }
    .epc-modex-shell a { color:inherit; text-decoration:none; }
    .epc-modex-shell .container { width:min(1280px, calc(100% - 2rem)); margin:0 auto; }
    .header-top-line { background:#222; color:#fff; font-size:.78rem; padding:.4rem 0; }
    .header-top-line .row { display:flex; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
    .header-top-line a { color:#fff; }
    #header-full-top { border-bottom:1px solid #e5e7eb; padding:.75rem 0; background:linear-gradient(180deg,#fff 0%,#f8fafc 100%); }
    .table-group { display:grid; grid-template-columns:auto 1.4fr auto; gap:1rem; align-items:start; }
    .header-logo img { height:40px; }
    .epc-header-search__tabs { display:flex; flex-wrap:wrap; gap:.25rem; margin-bottom:.45rem; }
    .epc-header-search__tab {
        appearance:none; border:1px solid #e2e8f0; background:#fff; border-radius:.35rem;
        padding:.3rem .5rem; font-size:.72rem; font-weight:700; cursor:pointer; color:#334155;
        display:inline-flex; align-items:center; gap:.3rem;
    }
    .epc-header-search__tab.active, .epc-header-search__tab:hover { background:#fef2f2; border-color:#fecaca; color:#b91c1c; }
    .header_search_form_1 { display:flex; gap:.4rem; }
    .header_search_form_1 input { flex:1; min-width:140px; padding:.55rem .7rem; border:1px solid #d1d5db; border-radius:.4rem; }
    .header_search_form_1 button { padding:.55rem .85rem; border:0; border-radius:.4rem; background:var(--red); color:#fff; font-weight:700; cursor:pointer; }
    .header_search_form_1 button:hover { background:var(--red-hot); }
    .header-user-box { display:flex; flex-wrap:wrap; gap:.55rem; font-weight:700; font-size:.78rem; max-width:22rem; justify-content:flex-end; }
    .header-user-box a:hover { color:var(--red); }
    .header-whatsapp-box { color:#128c7e !important; }
    .navbar-header-full { background:#f3f4f6; border-bottom:1px solid #e5e7eb; }
    .navbar-header-full .nav { list-style:none; margin:0; padding:.45rem 0; display:flex; gap:.85rem; flex-wrap:wrap; font-size:.82rem; font-weight:700; }
    .navbar-header-full .nav a:hover { color:var(--red); }
    #Container { padding:1rem 0 2rem; }
    #footer-widgets, #footer { padding:.85rem 0; border-top:1px solid #e5e7eb; color:#64748b; font-size:.8rem; }
    .epc-ai-expert-widget { position:fixed; right:1rem; bottom:4.25rem; z-index:40; }
    .epc-ai-expert-widget__launcher {
        display:inline-flex; align-items:center; gap:.45rem; padding:.65rem .9rem; border-radius:999px;
        background:linear-gradient(135deg,#0f172a,#1e293b); color:#fff !important; font-weight:800; font-size:.8rem;
        box-shadow:0 10px 24px rgba(15,23,42,.28);
    }
    .epc-ai-expert-widget__live { background:#22c55e; color:#052e16; border-radius:999px; padding:.1rem .4rem; font-size:.65rem; }
    .epc-bottom-dock {
        position:fixed; left:0; right:0; bottom:0; z-index:45; display:flex; justify-content:space-around;
        background:#111827; color:#fff; border-top:1px solid #374151; padding:.45rem .5rem;
    }
    .epc-bottom-dock a { display:flex; flex-direction:column; align-items:center; gap:.15rem; color:#fff !important; font-size:.65rem; font-weight:700; }
    .epc-bottom-dock i { font-size:1rem; }
    @@media (max-width:900px){ .table-group{grid-template-columns:1fr;} .header-user-box{max-width:none;justify-content:flex-start;} }
</style>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
