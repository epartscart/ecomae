<script>
(function () {
    function mapSelector(mode) {
        return {
            '1': '.header_search_form_1',
            '2': '.header_search_form_2',
            '3': '.header_search_form_3',
            'engine': '.header_search_form_engine',
            'car': '.header_search_form_car',
            'attr': '.header_search_form_attr'
        }[mode] || '.header_search_form_1';
    }
    window.change_header_search_form = function (mode) {
        mode = String(mode || '1');
        var modes = ['1', '2', '3', 'engine', 'car', 'attr'];
        for (var i = 0; i < modes.length; i++) {
            var nodes = document.querySelectorAll(mapSelector(modes[i]));
            for (var j = 0; j < nodes.length; j++) {
                if (modes[i] === mode) nodes[j].classList.remove('hidden');
                else nodes[j].classList.add('hidden');
            }
        }
        var tabs = document.querySelectorAll('.epc-header-search__tab');
        for (var t = 0; t < tabs.length; t++) {
            var active = tabs[t].getAttribute('data-search-mode') === mode;
            tabs[t].classList.toggle('active', active);
            tabs[t].setAttribute('aria-selected', active ? 'true' : 'false');
        }
        var roots = document.querySelectorAll('.epc-header-search');
        for (var r = 0; r < roots.length; r++) roots[r].setAttribute('data-active-mode', mode);
        return false;
    };
    window.epcHeaderVinSubmit = function (form) {
        if (!form) return false;
        var input = form.querySelector('input[name="identString"], input[name="vin"]');
        if (!input) return true;
        var vin = String(input.value || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
        input.value = vin;
        if (vin.length < 11) {
            alert('Enter a valid VIN / Frame number (11–17 characters).');
            input.focus();
            return false;
        }
        return true;
    };
    window.epcHeaderEngineSubmit = function (form) {
        if (!form) return false;
        var input = form.querySelector('input[name="engine"]');
        if (!input) return true;
        var code = String(input.value || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
        input.value = code;
        if (code.length < 2 || code.length > 12) {
            alert('Enter a valid engine code (2–12 characters, e.g. 3L, 12R, 5L).');
            input.focus();
            return false;
        }
        return true;
    };
    window.epcHeaderAttrSubmit = function (form) {
        if (!form) return false;
        var input = form.querySelector('input[name="q"]');
        if (!input) return true;
        var q = String(input.value || '').replace(/\s+/g, ' ').trim();
        input.value = q;
        if (q.replace(/\s+/g, '').length < 2) {
            alert('Enter at least 2 characters to search product information.');
            input.focus();
            return false;
        }
        return true;
    };
    document.addEventListener('click', function (ev) {
        var tab = ev.target && ev.target.closest ? ev.target.closest('.epc-header-search__tab') : null;
        if (!tab) return;
        ev.preventDefault();
        window.change_header_search_form(tab.getAttribute('data-search-mode'));
    });
    document.addEventListener('DOMContentLoaded', function () {
        var params = new URLSearchParams(window.location.search || '');
        var mode = params.get('mode');
        if (mode === 'attr' || mode === 'vin' || mode === 'engine' || mode === 'car' || mode === 'name') {
            window.change_header_search_form(mode === 'name' ? '2' : (mode === 'vin' ? '3' : mode));
        }
    });
})();
</script>

