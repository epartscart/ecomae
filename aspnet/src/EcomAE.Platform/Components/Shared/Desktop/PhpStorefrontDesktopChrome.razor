<script>
(function () {
    function mapSelector(mode) {
        return {
            '1': '.header_search_form_1',
            '2': '.header_search_form_2',
            '3': '.header_search_form_3',
            'engine': '.header_search_form_engine',
            'car': '.header_search_form_car',
            'attr': '.header_search_form_attr',
            'supcat': '.header_search_form_supcat'
        }[mode] || '.header_search_form_1';
    }
    window.change_header_search_form = function (mode) {
        mode = String(mode || '1');
        var modes = ['1', '2', '3', 'engine', 'car', 'attr', 'supcat'];
        for (var i = 0; i < modes.length; i++) {
            var nodes = document.querySelectorAll(mapSelector(modes[i]));
            for (var j = 0; j < nodes.length; j++) {
                if (modes[i] === mode) nodes[j].classList.remove('hidden');
                else nodes[j].classList.add('hidden');
            }
        }
        var tabs = document.querySelectorAll('.epc-header-search__tab');
        for (var t = 0; t < tabs.length; t++) {
            var active = tabs[t].getAttribute('data-search-mode') === mode;
            tabs[t].classList.toggle('active', active);
            tabs[t].setAttribute('aria-selected', active ? 'true' : 'false');
        }
        var roots = document.querySelectorAll('.epc-header-search');
        for (var r = 0; r < roots.length; r++) roots[r].setAttribute('data-active-mode', mode);
        return false;
    };
    window.epcHeaderVinSubmit = function (form) {
        if (!form) return false;
        var input = form.querySelector('input[name="identString"], input[name="vin"]');
        if (!input) return true;
        var vin = String(input.value || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
        input.value = vin;
        if (vin.length < 11) {
            alert('Enter a valid VIN / Frame number (11–17 characters).');
            input.focus();
            return false;
        }
        return true;
    };
    window.epcHeaderEngineSubmit = function (form) {
        if (!form) return false;
        var input = form.querySelector('input[name="engine"]');
        if (!input) return true;
        var code = String(input.value || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
        input.value = code;
        if (code.length < 2 || code.length > 12) {
            alert('Enter a valid engine code (2–12 characters, e.g. 3L, 12R, 5L).');
            input.focus();
            return false;
        }
        return true;
    };
    window.epcHeaderAttrSubmit = function (form) {
        if (!form) return false;
        var input = form.querySelector('input[name="q"]');
        if (!input) return true;
        var q = String(input.value || '').replace(/\s+/g, ' ').trim();
        input.value = q;
        if (q.replace(/\s+/g, '').length < 2) {
            alert('Enter at least 2 characters to search product information.');
            input.focus();
            return false;
        }
        return true;
    };
    window.epcHeaderSupcatSubmit = function (form) {
        if (!form) return false;
        var input = form.querySelector('input[name="q"]');
        var box = form.querySelector('.epc-supcat-results');
        var q = String(input && input.value || '').replace(/\s+/g, ' ').trim();
        if (q.length < 2) {
            alert('Enter at least 2 characters to search the supplier catalogs.');
            if (input) input.focus();
            return false;
        }
        if (!box) return false;
        var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
        var palette = ['#dc2626', '#2563eb', '#059669', '#d97706', '#7c3aed', '#0891b2', '#be185d', '#4f46e5'];
        var colorFor = function (s) { var h = 0; for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0; return palette[h % palette.length]; };
        box.innerHTML = '<div class="epc-supcat-status">Searching supplier catalogs…</div>';
        fetch('/api/supplier_catalogs.php?action=search&q=' + encodeURIComponent(q), { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                var hits = (res && res.data) || [];
                if (!hits.length) {
                    box.innerHTML = '<div class="epc-supcat-status">No match for <strong>' + esc(q) + '</strong> in the supplier catalogs. <a href="/en/supplier-catalogs" style="font-weight:700;color:#2563eb">Browse all catalogs</a></div>';
                    return;
                }
                var html = '<div class="epc-supcat-status">' + hits.length + (hits.length >= 120 ? '+' : '') + ' match' + (hits.length === 1 ? '' : 'es') + ' — <a href="/en/supplier-catalogs?q=' + encodeURIComponent(q) + '" style="font-weight:700;color:#2563eb">open in catalog browser</a></div>';
                hits.slice(0, 30).forEach(function (h) {
                    var c = colorFor(h.supplier || 'X');
                    var refHtml = (h.refs || []).slice(0, 6).map(function (r) {
                        return '<a class="epc-supcat-ref" href="/en/shop/part_search?article=' + encodeURIComponent(r) + '&brend=' + encodeURIComponent(h.supplier) + '" title="Search warehouse for ' + esc(r) + '">' + esc(r) + '</a>';
                    }).join('');
                    var oemHtml = (h.oems || []).slice(0, 4).map(function (o) {
                        return '<a class="epc-supcat-oem" href="/en/shop/part_search?article=' + encodeURIComponent(o) + '" title="OE ref ' + esc(o) + '">OE ' + esc(o) + '</a>';
                    }).join('');
                    var ver = [h.catNo ? 'Cat. ' + esc(h.catNo) : '', h.edition ? esc(h.edition) : ''].filter(Boolean).join(' · ');
                    html += '<div class="epc-supcat-row" style="--supcat-c:' + c + '">'
                        + '<img class="epc-supcat-row__cover" src="/supplier-catalogs/' + esc(h.catalog) + '/cover.png" alt="" loading="lazy" onerror="this.style.display=\'none\'" />'
                        + '<span class="epc-supcat-row__brand">' + esc(h.supplier) + '</span>'
                        + '<span class="epc-supcat-row__meta">'
                        + '<span class="epc-supcat-row__title">' + esc(h.title) + '</span>'
                        + '<span class="epc-supcat-row__sub">' + (ver ? '<span class="epc-supcat-chip epc-supcat-chip--ver">' + ver + '</span>' : '') + '<span class="epc-supcat-chip">page ' + h.page + '</span>' + ((h.makes || []).length ? '<span class="epc-supcat-chip">' + esc(h.makes.slice(0, 4).join(', ')) + '</span>' : '') + '</span>'
                        + '</span>'
                        + '<a class="epc-supcat-open" href="' + esc(h.pdf) + '#page=' + h.page + '" target="_blank" rel="noopener">Open PDF p.' + h.page + '</a>'
                        + '<span class="epc-supcat-row__refs">' + refHtml + oemHtml + '</span>'
                        + '</div>';
                });
                box.innerHTML = html;
            })
            .catch(function () {
                box.innerHTML = '<div class="epc-supcat-status">Catalog search is unavailable right now — <a href="/en/supplier-catalogs" style="font-weight:700;color:#2563eb">open the catalog browser</a>.</div>';
            });
        return false;
    };
    document.addEventListener('click', function (ev) {
        var tab = ev.target && ev.target.closest ? ev.target.closest('.epc-header-search__tab') : null;
        if (!tab) return;
        ev.preventDefault();
        window.change_header_search_form(tab.getAttribute('data-search-mode'));
    });
    document.addEventListener('DOMContentLoaded', function () {
        var params = new URLSearchParams(window.location.search || '');
        var mode = params.get('mode');
        if (mode === 'attr' || mode === 'vin' || mode === 'engine' || mode === 'car' || mode === 'name' || mode === 'supcat' || mode === 'pdfcatalog') {
            window.change_header_search_form(mode === 'name' ? '2' : (mode === 'vin' ? '3' : (mode === 'pdfcatalog' ? 'supcat' : mode)));
        }
    });
})();
</script>
