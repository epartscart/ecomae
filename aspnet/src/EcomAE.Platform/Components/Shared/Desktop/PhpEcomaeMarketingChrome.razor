@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation
@*
  Port of epc_ecomae_platform_layout_open/close topbar — ecomae.com marketing chrome.
  Public nav/footer hrefs match PHP canonical paths (full pages). Bare /bos is product Super-CP;
  marketing "What is Blockchain BOS" uses the PHP knowledge article slug.
*@

<div class="epm-body">
    <PhpCpTranslate Context="marketing" />
    <header class="epm-topbar">
        <div class="epm-topbar__inner">
            <a class="epm-brand" href="/">
                <img class="epm-brand__logo" src="@LegacyPresentationAssets.BrandMarkUrl" alt="" width="48" height="48" />
                <span class="epm-brand__text">
                    <strong>ECOM <span class="epm-brand__ae">AE</span></strong>
                    <small>One cloud: E-commerce + ERP + CRM</small>
                </span>
            </a>
            <button type="button" class="epm-nav-toggle" id="epm_nav_toggle" aria-expanded="false" aria-controls="epm_nav_drawer" aria-label="Open menu" @onclick="ToggleNav">
                <span></span><span></span><span></span>
            </button>
            <div class="epm-nav-drawer @(_navOpen ? "is-open" : null)" id="epm_nav_drawer">
                <nav class="epm-nav">
                    @foreach (var item in Nav)
                    {
                        var isActive = item.Key == ActiveKey || (ActiveKey == "" && item.Key == "home");
                        <a class="epm-nav__link @(isActive ? "is-active" : null)" href="@item.Href">@item.Label</a>
                    }
                    @foreach (var drop in Dropdowns)
                    {
                        var groupActive = drop.Items.Any(s => s.Key == ActiveKey);
                        <div class="epm-nav__group @(_openGroup == drop.Key ? "is-open" : null)">
                            <button type="button" class="epm-nav__group-trigger @(groupActive ? "is-active" : null)" aria-expanded="@(_openGroup == drop.Key)" @onclick="() => ToggleGroup(drop.Key)">
                                @drop.Label<span class="epm-nav__caret" aria-hidden="true">&#9662;</span>
                            </button>
                            <div class="epm-nav__panel">
                                @foreach (var sub in drop.Items)
                                {
                                    var subActive = ActiveKey != "" && sub.Key == ActiveKey;
                                    <a class="epm-nav__panel-link @(subActive ? "is-active" : null)" href="@sub.Href">@sub.Label</a>
                                }
                            </div>
                        </div>
                    }
                </nav>
                <div class="epm-nav-drawer__cta">
                    <a class="epm-topbar__cta epm-topbar__cta--ghost" href="@EcomaeMarketingPages.PlatformErpUrl"><i class="fa fa-building"></i> Platform ERP</a>
                    <a class="epm-topbar__cta epm-topbar__cta--ghost" href="@EcomaeMarketingPages.ClientErpDemoUrl"><i class="fa fa-line-chart"></i> Client ERP</a>
                    <a class="epm-topbar__cta" href="@EcomaeMarketingPages.SuperCpUrl" title="Super CP — operator control panel"><i class="fa fa-cloud"></i> Super CP</a>
                </div>
            </div>
            <div class="epm-topbar__cta-row">
                <a class="epm-topbar__cta epm-topbar__cta--ghost" href="@EcomaeMarketingPages.PlatformErpUrl"><i class="fa fa-building"></i> Platform ERP</a>
                <a class="epm-topbar__cta epm-topbar__cta--ghost" href="@EcomaeMarketingPages.ClientErpDemoUrl"><i class="fa fa-line-chart"></i> Client ERP</a>
                <a class="epm-topbar__cta" href="@EcomaeMarketingPages.SuperCpUrl" title="Super CP — operator control panel"><i class="fa fa-cloud"></i> Super CP</a>
            </div>
        </div>
    </header>

    <main class="epm-main">
        @ChildContent
    </main>

    <footer class="epm-footer">
        <div class="epm-footer__inner">
            <div class="epm-footer__brand">
                <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="" class="epm-footer__logo" />
                <p><strong>ECOM AE</strong> — storefront, CP, and ERP in one hosted stack.<br />Go live in 24 hours · UAE e-invoice (Peppol / PINT-AE).</p>
            </div>
            <div class="epm-footer__links">
                <a href="/platform">Platform</a>
                <a href="/#lifeos-film">LifeOS</a>
                <a href="/platform/platform-guides">Super CP guides</a>
                <a href="/platform/capabilities">Capabilities</a>
                <a href="/brochure">Product brochure</a>
                <a href="/brochure/cp">Full CP brochure</a>
                <a href="/platform/customer-results">Customer results</a>
                <a href="/platform/industries">Industries</a>
                <a href="/platform/pricing">Pricing</a>
                <a href="/platform/demo">Demo</a>
                <a href="/platform/faq">FAQ</a>
                <a href="/documentation">Documentation</a>
                <a href="/compare">Compare</a>
                <a href="/blockchain">Blockchain BOS</a>
                <a href="@EcomaeMarketingPages.BosKnowledgePhp">What is Blockchain BOS</a>
                <a href="/solutions">Solutions</a>
                <a href="/platform/contact">Contact</a>
            </div>
            <div class="epm-footer__legal">
                <p class="epm-footer__legal-label">Legal &amp; security</p>
                <div class="epm-footer__links epm-footer__links--legal">
                    <a href="/legal">All policies</a>
                    <a href="/privacy">Privacy</a>
                    <a href="/terms">Terms</a>
                    <a href="/cookie-policy">Cookies</a>
                    <a href="/security-policy">Security</a>
                    <a href="/right-to-use">Right to use</a>
                    <a href="/trademark">Trademark</a>
                    <a href="/copyright">Copyright</a>
                    <a href="/data-protection">Data protection</a>
                    <a href="/acceptable-use">Acceptable use</a>
                    <a href="/confidentiality">Confidentiality</a>
                    <a href="/intellectual-property">Intellectual property</a>
                    <a href="/blockchain-disclaimer">Blockchain disclaimer</a>
                    <a href="/dmca">IP notice</a>
                </div>
            </div>
            <p class="epm-footer__copy">&copy; @DateTime.UtcNow.Year Electronic World Group · Dubai, UAE · <a href="/legal">Legal policies</a></p>
        </div>
    </footer>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string ActiveKey { get; set; } = "home";

    private bool _navOpen;
    private string? _openGroup;

    private void ToggleNav() => _navOpen = !_navOpen;

    private void ToggleGroup(string key)
        => _openGroup = _openGroup == key ? null : key;

    // Match epc_ecomae_platform_nav() — PHP canonical paths (full pages, not /marketing/* stubs).
    private static readonly NavItem[] Nav =
    [
        new("home", "Home", "/"),
        new("platform", "Platform", "/platform"),
        new("lifeos", "LifeOS", "/#lifeos-film"),
        new("industries", "Industries", "/platform/industries"),
        new("capabilities", "Capabilities", "/platform/capabilities"),
        new("free_tools", "Free Tools", "/platform/free-tools"),
        new("pricing", "Pricing", "/platform/pricing"),
        new("about", "About", "/platform/about"),
        new("contact", "Contact", "/platform/contact"),
    ];

    private static readonly NavDropdown[] Dropdowns =
    [
        new("solutions", "Solutions",
        [
            new("platform_guides", "Super CP guides", "/platform/platform-guides"),
            new("api_services", "Catalog & Price API", "/platform/api-services"),
            new("api_documentation", "Tenant ERP API", "/platform/api-documentation"),
            new("auto_price_ai", "Auto Price AI", "/platform/auto-price-ai"),
            new("faq", "FAQ", "/platform/faq"),
            new("customer_results", "Customer results", "/platform/customer-results"),
            new("business_continuity", "Continuity", "/platform/business-continuity"),
            new("demo", "3-day demo", "/platform/demo"),
        ]),
        new("resources", "Resources",
        [
            new("brochure", "Product brochure", "/brochure"),
            new("brochure_cp", "Full CP brochure", "/brochure/cp"),
            new("docs", "Documentation", "/documentation"),
            new("compare", "Compare", "/compare"),
            new("blockchain", "Blockchain BOS", "/blockchain"),
            new("bos", "What is Blockchain BOS", EcomaeMarketingPages.BosKnowledgePhp),
            new("solution", "Solutions", "/solutions"),
            new("legal", "Legal policies", "/legal"),
            new("privacy", "Privacy", "/privacy"),
            new("terms", "Terms", "/terms"),
            new("cookie_policy", "Cookie policy", "/cookie-policy"),
            new("security_policy", "Security policy", "/security-policy"),
            new("right_to_use", "Right to use", "/right-to-use"),
            new("trademark", "Trademark", "/trademark"),
            new("copyright", "Copyright", "/copyright"),
            new("data_protection", "Data protection", "/data-protection"),
            new("acceptable_use", "Acceptable use", "/acceptable-use"),
            new("confidentiality", "Confidentiality", "/confidentiality"),
            new("intellectual_property", "Intellectual property", "/intellectual-property"),
            new("blockchain_disclaimer", "Blockchain disclaimer", "/blockchain-disclaimer"),
            new("dmca", "DMCA", "/dmca"),
        ]),
    ];

    private sealed record NavItem(string Key, string Label, string Href);
    private sealed record NavDropdown(string Key, string Label, NavItem[] Items);
}
