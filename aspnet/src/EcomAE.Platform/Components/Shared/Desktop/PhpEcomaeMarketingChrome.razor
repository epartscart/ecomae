@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation
@*
  Port of epc_ecomae_platform_layout_open/close topbar — ecomae.com marketing chrome.
*@

<div class="epm-body">
    <header class="epm-topbar">
        <div class="epm-topbar__inner">
            <a class="epm-brand" href="@EcomaeMarketingPages.LiveBase">
                <img class="epm-brand__logo" src="@LegacyPresentationAssets.BrandMarkUrl" alt="" width="48" height="48" />
                <span class="epm-brand__text">
                    <strong>ECOM <span class="epm-brand__ae">AE</span></strong>
                    <small>One cloud: E-commerce + ERP + CRM</small>
                </span>
            </a>
            <button type="button" class="epm-nav-toggle" id="epm_nav_toggle" aria-expanded="false" aria-controls="epm_nav_drawer" aria-label="Open menu" @onclick="ToggleNav">
                <span></span><span></span><span></span>
            </button>
            <div class="epm-nav-drawer @(_navOpen ? "is-open" : null)" id="epm_nav_drawer">
                <nav class="epm-nav">
                    @foreach (var item in Nav)
                    {
                        var isActive = item.Key == ActiveKey || (ActiveKey == "" && item.Key == "home");
                        <a class="epm-nav__link @(isActive ? "is-active" : null)" href="@item.Href">@item.Label</a>
                    }
                    @foreach (var drop in Dropdowns)
                    {
                        var groupActive = drop.Items.Any(s => s.Key == ActiveKey);
                        <div class="epm-nav__group @(_openGroup == drop.Key ? "is-open" : null)">
                            <button type="button" class="epm-nav__group-trigger @(groupActive ? "is-active" : null)" aria-expanded="@(_openGroup == drop.Key)" @onclick="() => ToggleGroup(drop.Key)">
                                @drop.Label<span class="epm-nav__caret" aria-hidden="true">&#9662;</span>
                            </button>
                            <div class="epm-nav__panel">
                                @foreach (var sub in drop.Items)
                                {
                                    var subActive = ActiveKey != "" && sub.Key == ActiveKey;
                                    <a class="epm-nav__panel-link @(subActive ? "is-active" : null)" href="@sub.Href">@sub.Label</a>
                                }
                            </div>
                        </div>
                    }
                </nav>
                <div class="epm-nav-drawer__cta">
                    <a class="epm-topbar__cta epm-topbar__cta--ghost" href="@EcomaeMarketingPages.PlatformErpUrl"><i class="fa fa-building"></i> Platform ERP</a>
                    <a class="epm-topbar__cta epm-topbar__cta--ghost" href="@EcomaeMarketingPages.ClientErpDemoUrl"><i class="fa fa-line-chart"></i> Client ERP</a>
                    <a class="epm-topbar__cta" href="@EcomaeMarketingPages.SuperCpUrl" title="Super CP — operator control panel"><i class="fa fa-cloud"></i> Super CP</a>
                </div>
            </div>
            <div class="epm-topbar__cta-row">
                <a class="epm-topbar__cta epm-topbar__cta--ghost" href="@EcomaeMarketingPages.PlatformErpUrl"><i class="fa fa-building"></i> Platform ERP</a>
                <a class="epm-topbar__cta epm-topbar__cta--ghost" href="@EcomaeMarketingPages.ClientErpDemoUrl"><i class="fa fa-line-chart"></i> Client ERP</a>
                <a class="epm-topbar__cta" href="@EcomaeMarketingPages.SuperCpUrl" title="Super CP — operator control panel"><i class="fa fa-cloud"></i> Super CP</a>
            </div>
        </div>
    </header>

    <main class="epm-main">
        @ChildContent
    </main>

    <footer class="epm-footer">
        <div class="epm-footer__inner">
            <div class="epm-footer__brand">
                <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="" class="epm-footer__logo" />
                <p><strong>ECOM AE</strong> — storefront, CP, and ERP in one hosted stack.<br />Go live in 24 hours · UAE e-invoice (Peppol / PINT-AE).</p>
            </div>
            <div class="epm-footer__links">
                <a href="@(EcomaeMarketingPages.LiveBase)platform">Platform</a>
                <a href="@(EcomaeMarketingPages.LiveBase)platform/demo">Demo</a>
                <a href="@(EcomaeMarketingPages.LiveBase)documentation">Docs</a>
                <a href="@(EcomaeMarketingPages.LiveBase)legal">Legal</a>
                <a href="@EcomaeMarketingPages.SuperCpUrl">Super CP</a>
            </div>
        </div>
    </footer>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string ActiveKey { get; set; } = "home";

    private bool _navOpen;
    private string? _openGroup;

    private void ToggleNav() => _navOpen = !_navOpen;

    private void ToggleGroup(string key)
        => _openGroup = _openGroup == key ? null : key;

    private static readonly NavItem[] Nav =
    [
        new("home", "Home", EcomaeMarketingPages.LiveBase),
        new("platform", "Platform", "/marketing/platform"),
        new("industries", "Industries", "/marketing/industries"),
        new("capabilities", "Capabilities", "/marketing/capabilities"),
        new("free_tools", "Free Tools", "/marketing/free-tools"),
        new("pricing", "Pricing", "/marketing/pricing"),
        new("about", "About", "/marketing/about"),
        new("contact", "Contact", "/marketing/contact"),
    ];

    private static readonly NavDropdown[] Dropdowns =
    [
        new("solutions", "Solutions",
        [
            new("platform_guides", "Super CP guides", "/marketing/platform-guides"),
            new("api_services", "Catalog & Price API", "/marketing/api-services"),
            new("api_documentation", "Tenant ERP API", "/marketing/api-documentation"),
            new("auto_price_ai", "Auto Price AI", "/marketing/auto-price-ai"),
            new("faq", "FAQ", "/marketing/faq"),
            new("customer_results", "Customer results", "/marketing/customer-results"),
            new("business_continuity", "Continuity", "/marketing/business-continuity"),
            new("demo", "3-day demo", "/marketing/demo"),
        ]),
        new("resources", "Resources",
        [
            new("brochure", "Product brochure", "/marketing/brochure"),
            new("brochure_cp", "Full CP brochure", EcomaeMarketingPages.LiveBase + "brochure/cp"),
            new("docs", "Documentation", "/marketing/documentation"),
            new("compare", "Compare", "/marketing/compare"),
            new("blockchain", "Blockchain BOS", "/marketing/blockchain"),
            new("bos", "What is Blockchain BOS", "/marketing/bos"),
            new("solution", "Solutions", "/marketing/solutions"),
            new("legal", "Legal policies", "/marketing/legal"),
            new("privacy", "Privacy", "/marketing/privacy"),
            new("security_policy", "Security policy", EcomaeMarketingPages.LiveBase + "security-policy"),
        ]),
    ];

    private sealed record NavItem(string Key, string Label, string Href);
    private sealed record NavDropdown(string Key, string Label, NavItem[] Items);
}
