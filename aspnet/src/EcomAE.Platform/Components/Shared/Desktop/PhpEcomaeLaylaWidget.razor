@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation
@*
  Layla splash + footer widget — same markers as epc_ecomae_platform_demo_layla.php
  (shown on PHP marketing home via layout_close).
*@

<div id="epc-layla-splash" class="epc-layla-splash epc-layla-splash--hidden" role="dialog" aria-modal="true" aria-labelledby="epc-layla-splash-title">
    <div class="epc-layla-splash__card">
        <button type="button" class="epc-layla-splash__close" id="epc-layla-splash-close" aria-label="Close Layla demo">&times;</button>
        <div class="epc-layla-splash__grid">
            <div class="epc-layla-splash__stage">
                <div class="epm-layla-stage">
                    <div class="epm-layla-stage__glow" aria-hidden="true"></div>
                    <div class="epm-layla-stage__avatar">
                        <img src="@AvatarUrl" alt="Layla" width="280" height="280" />
                    </div>
                </div>
            </div>
            <div class="epc-layla-splash__copy">
                <div class="epm-badge"><i class="fa fa-magic"></i> AI demo wizard · @EcomaeMarketingPages.DemoDays days free</div>
                <h2 id="epc-layla-splash-title">Meet Layla — your ECOM AE demo guide</h2>
                <p>Watch Layla walk you through a live @EcomaeMarketingPages.DemoDays-day sandbox on isolated MySQL — full commerce or ERP-only (no storefront).</p>
                <div class="epc-layla-splash__cta">
                    <a class="epm-btn epm-btn--primary" href="/marketing/demo"><i class="fa fa-play-circle"></i> Start demo wizard</a>
                    <button type="button" class="epm-btn epm-btn--ghost" id="epc-layla-splash-later">Maybe later</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="epc-layla-footer-widget" class="epc-layla-footer-widget epc-layla-footer-widget--hidden" aria-live="polite">
    <button type="button" class="epc-layla-footer-widget__launcher" id="epc-layla-footer-launcher" aria-expanded="false" aria-controls="epc-layla-footer-panel" title="Layla — AI demo wizard">
        <span class="epc-layla-footer-widget__launcher-avatar" aria-hidden="true">
            <img src="@AvatarUrl" alt="" width="36" height="36" />
        </span>
        <span>Layla · AI demo</span>
        <span class="epc-layla-footer-widget__live">Live</span>
    </button>
    <div class="epc-layla-footer-widget__panel epc-layla-footer-widget__panel--hidden" id="epc-layla-footer-panel" role="dialog" aria-label="Layla AI demo wizard">
        <div class="epc-layla-footer-widget__head">
            <div>
                <strong>Layla · AI demo wizard</strong>
                <span>@EcomaeMarketingPages.DemoDays-day sandbox · commerce or ERP-only</span>
            </div>
            <button type="button" class="epc-layla-footer-widget__head-close" id="epc-layla-footer-close" aria-label="Close panel">&times;</button>
        </div>
        <div class="epc-layla-footer-widget__body">
            <div class="epm-layla-stage">
                <div class="epm-layla-stage__glow" aria-hidden="true"></div>
                <div class="epm-layla-stage__avatar">
                    <img src="@AvatarUrl" alt="Layla" width="200" height="200" />
                </div>
            </div>
            <div class="epc-layla-footer-widget__actions">
                <a class="epm-btn epm-btn--primary" href="/marketing/demo"><i class="fa fa-play-circle"></i> Open full wizard</a>
                <button type="button" class="epm-btn epm-btn--ghost" id="epc-layla-footer-reopen-splash">Replay intro</button>
            </div>
        </div>
    </div>
</div>

<style>
.epm-layla-stage{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:220px}
.epm-layla-stage__glow{position:absolute;width:min(92%,280px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(14,165,233,.22) 0%,transparent 68%);animation:epmLaylaPulse 3.2s ease-in-out infinite;pointer-events:none}
@@keyframes epmLaylaPulse{0%,100%{transform:scale(1);opacity:.85}50%{transform:scale(1.06);opacity:1}}
.epm-layla-stage__avatar{position:relative;width:min(100%,260px);max-width:260px;z-index:2;animation:epmLaylaFloat 4.5s ease-in-out infinite;filter:drop-shadow(0 16px 40px rgba(14,165,233,.35))}
.epm-layla-stage__avatar img{width:100%;height:auto;display:block}
@@keyframes epmLaylaFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
.epc-layla-splash{position:fixed;inset:0;z-index:10080;display:flex;align-items:center;justify-content:center;padding:clamp(12px,3vw,24px);background:rgba(10,10,10,.88);backdrop-filter:blur(8px)}
.epc-layla-splash--hidden{display:none!important}
.epc-layla-splash__card{position:relative;width:min(960px,100%);max-height:min(92vh,820px);overflow:auto;border-radius:28px;border:1px solid rgba(14,165,233,.35);background:linear-gradient(145deg,#1a0407 0%,#5a0f16 42%,#0a0a0a 100%);box-shadow:0 0 80px rgba(14,165,233,.18),0 24px 80px rgba(10,10,10,.65);padding:clamp(18px,3vw,32px)}
.epc-layla-splash__close{position:absolute;top:12px;right:14px;border:0;background:transparent;color:#fff;font-size:28px;cursor:pointer;line-height:1}
.epc-layla-splash__grid{display:grid;grid-template-columns:minmax(220px,.9fr) minmax(260px,1.1fr);gap:clamp(16px,3vw,28px);align-items:center}
@@media(max-width:860px){.epc-layla-splash__grid{grid-template-columns:1fr;text-align:center}}
.epc-layla-splash__copy h2{margin:10px 0;color:#fff;font-size:clamp(22px,3.5vw,32px);line-height:1.15}
.epc-layla-splash__copy p{color:#cbd5e1;line-height:1.6}
.epc-layla-splash__cta{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
@@media(max-width:860px){.epc-layla-splash__cta{justify-content:center}}
.epc-layla-footer-widget{position:fixed;right:1rem;bottom:1rem;z-index:10050}
.epc-layla-footer-widget--hidden{display:none!important}
.epc-layla-footer-widget__launcher{display:inline-flex;align-items:center;gap:.55rem;padding:.65rem .9rem;border:0;border-radius:999px;background:linear-gradient(135deg,#0f172a,#1e293b);color:#fff;font-weight:800;font-size:.8rem;cursor:pointer;box-shadow:0 10px 24px rgba(15,23,42,.35)}
.epc-layla-footer-widget__launcher-avatar{width:36px;height:36px;border-radius:50%;overflow:hidden;display:inline-flex;background:#111}
.epc-layla-footer-widget__launcher-avatar img{width:100%;height:100%;object-fit:cover}
.epc-layla-footer-widget__live{background:#22c55e;color:#052e16;border-radius:999px;padding:.1rem .4rem;font-size:.65rem}
.epc-layla-footer-widget__panel{position:absolute;right:0;bottom:3.4rem;width:min(360px,calc(100vw - 2rem));background:linear-gradient(160deg,#111827,#0f172a);border:1px solid rgba(14,165,233,.3);border-radius:18px;box-shadow:0 18px 40px rgba(0,0,0,.45);overflow:hidden}
.epc-layla-footer-widget__panel--hidden{display:none!important}
.epc-layla-footer-widget__head{display:flex;justify-content:space-between;gap:12px;padding:14px 16px;border-bottom:1px solid rgba(255,255,255,.08);color:#e2e8f0}
.epc-layla-footer-widget__head strong{display:block}
.epc-layla-footer-widget__head span{display:block;font-size:.75rem;color:#94a3b8;margin-top:2px}
.epc-layla-footer-widget__head-close{border:0;background:transparent;color:#fff;font-size:22px;cursor:pointer}
.epc-layla-footer-widget__body{padding:14px 16px 18px}
.epc-layla-footer-widget__actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.epm-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border-radius:12px;font-weight:700;text-decoration:none;border:1px solid transparent;cursor:pointer;font:inherit}
.epm-btn--primary{background:linear-gradient(135deg,#0ea5e9,#0284c7);color:#041525}
.epm-btn--ghost{background:transparent;border-color:rgba(14,165,233,.35);color:#7dd3fc}
.epm-badge{display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:999px;border:1px solid rgba(14,165,233,.3);background:rgba(14,165,233,.08);color:#7dd3fc;font-size:11px;font-weight:700;letter-spacing:.04em;text-transform:uppercase}
</style>

<script>
(function () {
    var SPLASH_KEY = 'epc_layla_splash_dismissed';
    function ready(fn) {
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
        else fn();
    }
    ready(function () {
        var splash = document.getElementById('epc-layla-splash');
        var footer = document.getElementById('epc-layla-footer-widget');
        var splashClose = document.getElementById('epc-layla-splash-close');
        var splashLater = document.getElementById('epc-layla-splash-later');
        var footerLauncher = document.getElementById('epc-layla-footer-launcher');
        var footerPanel = document.getElementById('epc-layla-footer-panel');
        var footerClose = document.getElementById('epc-layla-footer-close');
        var footerReopen = document.getElementById('epc-layla-footer-reopen-splash');
        function dismissed() { try { return localStorage.getItem(SPLASH_KEY) === '1'; } catch (e) { return false; } }
        function setDismissed() {
            try { localStorage.setItem(SPLASH_KEY, '1'); } catch (e) {}
            showFooter();
            hideSplash();
        }
        function showSplash() {
            if (!splash) return;
            splash.classList.remove('epc-layla-splash--hidden');
            document.documentElement.style.overflow = 'hidden';
        }
        function hideSplash() {
            if (!splash) return;
            splash.classList.add('epc-layla-splash--hidden');
            document.documentElement.style.overflow = '';
        }
        function showFooter() {
            if (footer) footer.classList.remove('epc-layla-footer-widget--hidden');
        }
        function setFooterOpen(open) {
            if (!footerPanel || !footerLauncher || !footer) return;
            footerPanel.classList.toggle('epc-layla-footer-widget__panel--hidden', !open);
            footer.classList.toggle('epc-layla-footer-widget--open', open);
            footerLauncher.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        if (splashClose) splashClose.addEventListener('click', setDismissed);
        if (splashLater) splashLater.addEventListener('click', setDismissed);
        if (splash) splash.addEventListener('click', function (e) { if (e.target === splash) setDismissed(); });
        if (footerLauncher) {
            footerLauncher.addEventListener('click', function () {
                var open = footerPanel && !footerPanel.classList.contains('epc-layla-footer-widget__panel--hidden');
                setFooterOpen(!open);
            });
        }
        if (footerClose) footerClose.addEventListener('click', function () { setFooterOpen(false); });
        if (footerReopen) {
            footerReopen.addEventListener('click', function () {
                setFooterOpen(false);
                showSplash();
            });
        }
        if (!dismissed()) showSplash();
        else showFooter();
    });
})();
</script>

@code {
    private const string AvatarUrl = "/content/files/images/ecomae-platform/layla-avatar.svg";
}
