@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation
@*
  Same-to-same port of content/shop/finance/epc_demo_portal.php :: epc_demo_portal_html().
  Injected on PHP home after blockchain section / before live clients.
  Styles: /platform-assets/epc_ecomae_demo_portal.css via MarketingStylesheets
  (not HeadContent — live SSR drops HeadOutlet).
*@

<section class="epc-demo-portal" id="demo" dir="auto">
    <div class="epc-demo-card">
        <div class="epc-demo-badge">@EcomaeMarketingPages.DemoDays-DAY FREE DEMO · NO SIGNUP</div>
        <h2>Try ecomae live</h2>
        <p class="epc-demo-sub">Explore the <strong>storefront</strong> and the full <strong>ERP</strong> with shared demo access. (Control panel is not part of the demo.)</p>

        <div class="epc-demo-cred">
            <div><span>Demo email</span><code>demo@ecomae.com</code></div>
            <div><span>Demo password</span><code>demo1234</code></div>
        </div>

        <div class="epc-demo-actions">
            <a class="epc-demo-btn primary" href="@ErpDemoUrl">Open ERP demo</a>
            <a class="epc-demo-btn" href="@StorefrontDemoUrl">View storefront</a>
        </div>

        <div class="epc-demo-industries">
            <span>Preview your industry:</span>
            @foreach (var ind in Industries)
            {
                <a class="epc-demo-chip" href="@($"{ErpDemoUrl}&industry={Uri.EscapeDataString(ind.Code)}")">@ind.Name</a>
            }
        </div>

        <p class="epc-demo-note">Shared 3-day demo. Storefront + ERP only. No CP. Data resets periodically.</p>
    </div>
</section>

@code {
    private const string ErpDemoUrl = "https://www.ecomae.com/erp-demo?demo=1";
    private const string StorefrontDemoUrl = "https://www.ecomae.com/?demo=1";

    private static readonly IndustryChip[] Industries =
    [
        new("jewellery", "Jewellery & Bullion"),
        new("trading", "Trading / Import-Export"),
        new("construction", "Construction & Contracting"),
        new("retail", "Retail / POS"),
        new("manufacturing", "Manufacturing"),
    ];

    private sealed record IndustryChip(string Code, string Name);
}
