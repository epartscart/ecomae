@code {
    private BosFleetSummary _summary = new(0, 0, 0, 0, 0, 0, 0, 0, "loading", "Loading fleet…");
    private IReadOnlyList<PortalTenantDigest> _tenants = [];
    private int _healthy;
    private int _attention;
    private int _critical;

    private static readonly (string Type, string Icon, string Label)[] FleetTypes =
    [
        ("commerce", "fa-shopping-bag", "Commerce"),
        ("erp_only", "fa-university", "ERP-only"),
        ("demo", "fa-flask", "Demo"),
    ];

    protected override async Task OnInitializedAsync()
    {
        var health = await Dashboards.BuildBosFleetHealthAsync(60);
        _summary = health.Summary;
        _tenants = health.SampleTenants;
        foreach (var t in _tenants)
        {
            switch (ClassifyHealth(t))
            {
                case "green": _healthy++; break;
                case "amber": _attention++; break;
                default: _critical++; break;
            }
        }
    }

    // PHP epc_boc_classify_tenant: demo → erp_only (industry erp*) → commerce.
    private static string ClassifyType(PortalTenantDigest t)
    {
        var industry = (t.IndustryCode ?? string.Empty).ToLowerInvariant();
        if (t.SiteKey.Contains("demo", StringComparison.OrdinalIgnoreCase)
            || t.Status.Contains("demo", StringComparison.OrdinalIgnoreCase))
        {
            return "demo";
        }

        if (t.ErpOnly || industry.StartsWith("erp", StringComparison.Ordinal))
        {
            return "erp_only";
        }

        return "commerce";
    }

    // PHP epc_boc_tenant_health: red = DB unreachable / blocked; amber = dns_pending / non-live status.
    private static string ClassifyHealth(PortalTenantDigest t)
    {
        if (!t.HasDb)
        {
            return "red";
        }

        var status = (t.Status ?? string.Empty).ToLowerInvariant();
        if (status == "dns_pending" || (!t.IsActive) || (status != "" && status != "live"))
        {
            return "amber";
        }

        return "green";
    }

    private int Bar(int n)
    {
        var total = Math.Max(1, _summary.PortalTenants);
        return Math.Max(4, Math.Min(100, (int)Math.Round(n * 100.0 / total)));
    }

    private int HealthPct()
    {
        var total = Math.Max(1, Math.Max(_tenants.Count, 1));
        return (int)Math.Round(_healthy * 100.0 / Math.Max(1, _tenants.Count == 0 ? 1 : _tenants.Count));
    }

    private static IEnumerable<(IReadOnlyList<PhpSuperCpBocNav.BocArea> Chunk, int Index)> Chunk(IReadOnlyList<PhpSuperCpBocNav.BocArea> areas, int size)
    {
        var index = 0;
        for (var i = 0; i < areas.Count; i += size)
        {
            yield return (areas.Skip(i).Take(size).ToList(), index++);
        }
    }

    private static string ColTitle(int index, int total)
    {
        if (total <= 7)
        {
            return "Modules";
        }

        return index switch
        {
            0 => "Modules",
            1 => "More",
            2 => "Also",
            3 => "More tools",
            _ => "Extra"
        };
    }
}
