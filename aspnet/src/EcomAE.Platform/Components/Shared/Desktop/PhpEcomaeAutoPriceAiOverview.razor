@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation
@*
  Scaffold of epc_ecomae_platform_page_auto_price_ai() — hero + CTA.
  Full APAi guide diagram remains PHP deeplink until dual-sample.
*@

<div class="epm-wrap" id="ehm-auto-price-ai-overview">
	<div class="epm-hero">
		<div class="epm-hero__shade" style="opacity:1;background:linear-gradient(135deg,#0f766e 0%,#115e59 45%,#0a0a0a 100%)"></div>
		<div class="epm-hero__content">
			<div class="epm-badge"><i class="fa fa-magic"></i> Discover · Price · Import · Sell</div>
			<h1>Auto Price AI — discover, price, and list across markets</h1>
			<p class="lead">Multi-source price intelligence built into ECOM AE. Crawl buy sources and sell marketplaces, find real margin, import winners to your catalogue, and cross-list — for auto parts, electronics, fashion, jewellery, and more.</p>
			<div class="epm-cta">
				<a class="epm-btn epm-btn--primary" href="/marketing/demo">Start @EcomaeMarketingPages.DemoDays-day demo</a>
				<a class="epm-btn epm-btn--ghost" href="/marketing/auto-price-ai?php=@(Uri.EscapeDataString(EcomaeMarketingPages.LiveBase + "platform/auto-price-ai"))">Open full Auto Price AI</a>
				<a class="epm-btn epm-btn--outline" href="/marketing/contact">Contact sales</a>
			</div>
		</div>
	</div>

	<div class="epm-model-cards">
		<div class="epm-model-card">
			<i class="fa fa-search"></i>
			<strong>Discover</strong>
			<p>Crawl buy sources and marketplace comps in your country.</p>
		</div>
		<div class="epm-model-card">
			<i class="fa fa-calculator"></i>
			<strong>Price</strong>
			<p>Margin intelligence before you import or list.</p>
		</div>
		<div class="epm-model-card">
			<i class="fa fa-upload"></i>
			<strong>Import &amp; sell</strong>
			<p>Push winners to catalogue and cross-list channels.</p>
		</div>
	</div>

	<div class="epm-highlight">
		<h3>Full operator guide</h3>
		<p style="color:var(--epm-muted);margin-bottom:14px">Flow diagrams, profiles, and Super CP guide are available from the linked pages.</p>
		<a class="epm-btn epm-btn--primary" href="/marketing/auto-price-ai?php=@(Uri.EscapeDataString(EcomaeMarketingPages.LiveBase + "platform/auto-price-ai"))">Open Auto Price AI page</a>
	</div>

	<p style="margin:24px 0 0;font-size:.85rem;color:var(--epm-muted,#b3b3b3)">
		</p>
</div>
