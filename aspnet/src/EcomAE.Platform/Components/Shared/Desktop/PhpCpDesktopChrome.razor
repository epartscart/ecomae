                }
            </div>
        </footer>
    </div>
</div>

@* Shell layout only — topnav fonts/panels come from epc_cp_professional.css (13/12/12.5px). *@
<script id="epc-cp-topnav-inline">
(function () {
    'use strict';
    function bindCpTopNav() {
        var root = document.getElementById('epc_cp_topnav');
        if (!root || root._epcCpTopnavBound) { return; }
        root._epcCpTopnavBound = true;
        var items = root.querySelectorAll('.epc-cp-topnav-item');
        var hoverTimer = null;

        function closeAll(except) {
            items.forEach(function (item) {
                if (except && item === except) { return; }
                item.classList.remove('is-open');
                var btn = item.querySelector('[data-topnav-toggle]');
                var panel = item.querySelector('[data-topnav-panel]');
                if (btn) { btn.setAttribute('aria-expanded', 'false'); }
                if (panel) { panel.hidden = true; }
            });
            document.body.classList.remove('epc-cp-topnav-open');
        }

        function placePanel(item, panel) {
            if (!panel || !root) { return; }
            var rootRect = root.getBoundingClientRect();
            var btn = item.querySelector('.epc-cp-topnav-btn');
            var btnRect = btn ? btn.getBoundingClientRect() : rootRect;
            var top = Math.round(rootRect.bottom);
            panel.style.top = top + 'px';
            panel.style.maxHeight = Math.max(180, Math.floor(window.innerHeight - top - 12)) + 'px';
            panel.style.left = '0px';
            panel.style.right = 'auto';
            panel.hidden = false;
            var panelWidth = panel.offsetWidth || 720;
            var left = Math.round(btnRect.left);
            var maxLeft = Math.max(8, window.innerWidth - panelWidth - 8);
            if (left > maxLeft) { left = maxLeft; }
            if (left < 8) { left = 8; }
            panel.style.left = left + 'px';
        }

        function openItem(item) {
            if (!item) { return; }
            closeAll(item);
            item.classList.add('is-open');
            var btn = item.querySelector('[data-topnav-toggle]');
            var panel = item.querySelector('[data-topnav-panel]');
            if (btn) { btn.setAttribute('aria-expanded', 'true'); }
            if (panel) { placePanel(item, panel); }
            document.body.classList.add('epc-cp-topnav-open');
        }

        function toggleItem(item) {
            if (item.classList.contains('is-open')) { closeAll(); }
            else { openItem(item); }
        }

        items.forEach(function (item) {
            var btn = item.querySelector('[data-topnav-toggle]');
            if (!btn) { return; }
            var skippedClick = false;
            function onToggle(e) {
                if (e) { e.preventDefault(); e.stopPropagation(); }
                if (hoverTimer) { clearTimeout(hoverTimer); hoverTimer = null; }
                toggleItem(item);
            }
            btn.addEventListener('pointerdown', function (e) {
                if (e.button != null && e.button !== 0) { return; }
                skippedClick = true;
                onToggle(e);
            }, { passive: false });
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (skippedClick) { skippedClick = false; return; }
                onToggle(e);
            });
            item.addEventListener('mouseleave', function () {
                hoverTimer = setTimeout(function () {
                    if (!item.matches(':hover') && item.classList.contains('is-open')) { closeAll(); }
                }, 120);
            });
            item.addEventListener('mouseenter', function () {
                if (hoverTimer) { clearTimeout(hoverTimer); hoverTimer = null; }
            });
        });

        document.addEventListener('click', function (e) {
            if (!root.contains(e.target)) { closeAll(); }
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { closeAll(); }
        });
        window.addEventListener('resize', function () {
            var open = root.querySelector('.epc-cp-topnav-item.is-open');
            if (!open) { return; }
            var panel = open.querySelector('[data-topnav-panel]');
            if (panel && !panel.hidden) { placePanel(open, panel); }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindCpTopNav);
    } else {
        bindCpTopNav();
    }

    var mobileBtn = document.querySelector('[data-target="#mobile-collapse"]');
    var mobilePane = document.getElementById('mobile-collapse');
    if (mobileBtn && mobilePane && !mobileBtn._epcMobileBound) {
        mobileBtn._epcMobileBound = true;
        mobileBtn.addEventListener('click', function (e) {
            e.preventDefault();
            mobilePane.classList.toggle('in');
            mobilePane.classList.toggle('show');
        });
    }
})();
</script>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Optional hint from the page; chrome re-validates cookies so Log out still appears when the page omits it.</summary>
    [Parameter] public bool IsAdmin { get; set; }

    private bool _useErpChrome;
    private string _erpTitle = "Module";
    private string _erpArea = "Modules";
    private bool _showBos;
    private bool _signedIn;
    private string _userLabel = "Admin session";
    private string? _industryCode;
    private string? _industryLabel;
    private string _industryIcon = "fa-cogs";
    private string? _storefrontHost;
    private string _currentPath = "/cp";
    private string _crumbTitle = "Control";

    private string ShellClass
    {
        get
        {
            var cls = "fixed-navbar fixed-sidebar epc-cp epc-cp-shell epc-cp-topnav-only epc-cp--blue-theme epc-cp-modern epc-php-font-root";
            if (_showBos)
            {
                cls += " epc-cp-bos-host epc-boc-mode";
            }
            else if (!string.IsNullOrWhiteSpace(_industryCode))
            {
                cls += " epc-cp--" + _industryCode;
            }

            return cls;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var path = Http.HttpContext?.Request.Path.Value ?? string.Empty;
        _currentPath = string.IsNullOrWhiteSpace(path) ? "/cp" : path;
        _crumbTitle = TitleFromCpPath(_currentPath);
        _useErpChrome = path.StartsWith("/erp", StringComparison.OrdinalIgnoreCase);
        if (_useErpChrome)
        {
            _erpTitle = TitleFromErpPath(path);
            _erpArea = AreaFromErpPath(path);
            return;
        }

        var host = Http.HttpContext?.Request.Host.Host;
        _showBos = PlatformHostPolicy.IsSuperCpHost(host);
        // Tenant industry (epartscart → auto_parts) drives jewellery menu filtering.
        if (!_showBos && !string.IsNullOrWhiteSpace(host))
        {
            var erpHost = ErpHostContext.Resolve(host);
            _industryCode = erpHost.IndustryCode;
            _industryLabel = erpHost.IndustryLabel;
            _industryIcon = string.Equals(_industryCode, "auto_parts", StringComparison.OrdinalIgnoreCase)
                ? "fa-car"
                : "fa-cogs";
            _storefrontHost = host.Trim();
            if (_storefrontHost.StartsWith("www.", StringComparison.OrdinalIgnoreCase))
            {
                _storefrontHost = _storefrontHost[4..];
            }
        }

        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            _signedIn = IsAdmin;
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _signedIn = session.Kind == LegacySessionKind.Admin || IsAdmin;
        if (_signedIn)
        {
            _userLabel = string.IsNullOrWhiteSpace(session.Email) ? "Admin session" : session.Email!;
        }
    }

    private bool GroupIsActive(LegacyDesktopChromeCatalog.MegaGroup group)
    {
        if (PathIsActive(group.HubHref))
        {
            return true;
        }

        return group.Links.Any(l => PathIsActive(l.Href));
    }

    private bool PathIsActive(string? href)
    {
        if (string.IsNullOrWhiteSpace(href))
        {
            return false;
        }

        var mapped = PhpSurfaceLinkMap.AspNetPrimaryHref(href).Split('?', 2)[0];
        if (string.IsNullOrWhiteSpace(mapped) || mapped == "/")
        {
            return false;
        }

        if (mapped.Equals("/cp", StringComparison.OrdinalIgnoreCase)
            || mapped.Equals("/erp", StringComparison.OrdinalIgnoreCase))
        {
            return _currentPath.Equals(mapped, StringComparison.OrdinalIgnoreCase)
                   || _currentPath.Equals(mapped + "/app", StringComparison.OrdinalIgnoreCase);
        }

        return _currentPath.Equals(mapped, StringComparison.OrdinalIgnoreCase)
               || _currentPath.StartsWith(mapped + "/", StringComparison.OrdinalIgnoreCase);
    }

    private static string TitleFromCpPath(string path)
    {
        var slug = path.Split('?', 2)[0].Trim('/').Split('/').LastOrDefault() ?? "control";
        slug = slug.Replace("-app", "", StringComparison.OrdinalIgnoreCase).Replace('-', ' ').Trim();
        if (string.IsNullOrWhiteSpace(slug)
            || slug.Equals("cp", StringComparison.OrdinalIgnoreCase)
            || slug.Equals("app", StringComparison.OrdinalIgnoreCase)
            || slug.Equals("control", StringComparison.OrdinalIgnoreCase))
        {
            return "Control";
        }

        var parts = slug.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        for (var i = 0; i < parts.Length; i++)
        {
            var p = parts[i];
            parts[i] = char.ToUpperInvariant(p[0]) + p[1..];
        }

        return string.Join(' ', parts);
    }

    private static string TitleFromErpPath(string path)
    {
        var slug = path.Split('?', 2)[0].Trim('/').Split('/').LastOrDefault() ?? "module";
        slug = slug.Replace("-app", "", StringComparison.OrdinalIgnoreCase).Replace('-', ' ').Trim();
        if (string.IsNullOrWhiteSpace(slug) || slug.Equals("erp", StringComparison.OrdinalIgnoreCase))
        {
            return "Dashboard";
        }

        var parts = slug.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        for (var i = 0; i < parts.Length; i++)
        {
            var p = parts[i];
            parts[i] = char.ToUpperInvariant(p[0]) + p[1..];
        }

        return string.Join(' ', parts);
    }

    private static string AreaFromErpPath(string path)
    {
        var title = TitleFromErpPath(path);
        if (title.Contains("Warehouse", StringComparison.OrdinalIgnoreCase)
            || title.Contains("Fulfil", StringComparison.OrdinalIgnoreCase)
            || title.Contains("Fulfill", StringComparison.OrdinalIgnoreCase))
        {
            return "Inventory";
        }

        if (title.Contains("Collection", StringComparison.OrdinalIgnoreCase)
            || title.Contains("Hr", StringComparison.OrdinalIgnoreCase)
            || title.Contains("Payroll", StringComparison.OrdinalIgnoreCase))
        {
            return title.Contains("Collection", StringComparison.OrdinalIgnoreCase) ? "Finance" : "People";
        }

        return "Modules";
    }

    private static bool IsBosNavGroup(LegacyDesktopChromeCatalog.MegaGroup group)
    {
        if (string.Equals(group.Id, "platform", StringComparison.OrdinalIgnoreCase)
            || string.Equals(group.Label, "Platform", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var hub = group.HubHref ?? string.Empty;
        return hub.StartsWith("/bos", StringComparison.OrdinalIgnoreCase)
            || group.Links.Any(l => l.Href.StartsWith("/bos", StringComparison.OrdinalIgnoreCase));
    }
}
