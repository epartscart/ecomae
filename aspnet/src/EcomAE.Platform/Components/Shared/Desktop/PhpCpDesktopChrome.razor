                                    {
                                        <i class="fa @group.Icon"></i>
                                    }
                                    @group.Label
                                    @if (!string.IsNullOrWhiteSpace(group.Subtitle))
                                    {
                                        <span class="epc-cp-topnav-panel-sub">@group.Subtitle</span>
                                    }
                                </div>
                                <a class="epc-cp-topnav-panel-hub" href="@PhpSurfaceLinkMap.AspNetPrimaryHref(group.HubHref ?? group.Links[0].Href)">
                                    Open first <i class="fa fa-arrow-right"></i>
                                </a>
                            </div>
                            <div class="epc-cp-topnav-cols">
