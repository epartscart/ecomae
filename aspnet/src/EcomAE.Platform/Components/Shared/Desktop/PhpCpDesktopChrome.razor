@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation
@*
  Mirrors cp/templates/bootstrap_admin/desktop.php chrome classes (topnav-only hybrid).
  Product module bodies render via ChildContent / workspace frame.
*@

<div class="fixed-navbar fixed-sidebar epc-cp epc-cp-shell epc-cp-topnav-only epc-cp--blue-theme epc-cp-modern epc-php-font-root">
    <div id="header">
        <div class="color-line"></div>
        <div class="epc-cp-header-bar">
            <a class="light-version ech-logo-wrap epc-cp-header-logo" href="/cp">
                <img src="@LegacyPresentationAssets.EpartsCartMarkUrl" alt="eParts Cart" />
            </a>
            <div class="epc-cp-topbar-strip hidden-xs">
                <nav class="epc-cp-topbar-ctas" aria-label="CP topbar CTAs">
                    <a class="epc-cp-topbar-cta epc-cp-topbar-cta--erp" href="/erp">ERP Operations</a>
                    <a class="epc-cp-topbar-cta epc-cp-topbar-cta--storefront" href="/">STOREFRONT</a>
                </nav>
            </div>
            <nav class="epc-cp-header-actions" aria-label="CP header actions">
                <a href="/cp">Control panel</a>
                <a href="/bos">BOS</a>
                @if (!IsAdmin)
                {
                    <a class="epc-cp-header-login" href="/cp/login">Sign in</a>
                }
                else
                {
                    <span class="epc-cp-header-user">Admin session</span>
                }
            </nav>
        </div>
    </div>

    <nav class="epc-cp-topnav" id="epc_cp_topnav" aria-label="Control Panel top navigation">
        <div class="epc-cp-topnav-inner">
            <a class="epc-cp-topnav-brand" href="/cp/app">CONTROL</a>
            <ul class="epc-cp-topnav-list" role="menubar">
                @foreach (var group in LegacyDesktopChromeCatalog.ControlPanelTopnav())
                {
                    var columns = group.Columns ?? Array.Empty<LegacyDesktopChromeCatalog.MegaAreaColumn>();
                    <li class="epc-cp-topnav-item" data-group="@group.Id" role="none">
                        <button type="button" class="epc-cp-topnav-btn" role="menuitem" aria-haspopup="true">
                            @if (!string.IsNullOrWhiteSpace(group.Icon))
                            {
                                <i class="fa @group.Icon" aria-hidden="true"></i>
                            }
                            <span>@group.Label</span>
                            <i class="fa fa-angle-down" aria-hidden="true" style="margin-left:.25rem;opacity:.65"></i>
                        </button>
                        <div class="epc-cp-topnav-panel" data-topnav-panel="@group.Id">
                            <div class="epc-cp-topnav-panel-hd">
                                <span>@group.Label</span>
                                <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(group.HubHref ?? group.Links[0].Href)" style="margin-left:auto;font-size:.72rem;color:#dc2626;font-weight:700">
                                    Open first <i class="fa fa-arrow-right"></i>
                                </a>
                            </div>
                            <div class="epc-cp-topnav-cols">
                                @if (columns.Count > 0)
                                {
                                    @foreach (var col in columns)
                                    {
                                        <div class="epc-cp-topnav-col">
                                            <div class="epc-cp-topnav-col-hd">
                                                @if (!string.IsNullOrWhiteSpace(col.Icon))
                                                {
                                                    <i class="fa @col.Icon"></i>
                                                }
                                                @col.Label
                                            </div>
                                            <ul class="epc-cp-topnav-links">
                                                @foreach (var link in col.Tabs)
                                                {
                                                    <li>
                                                        <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(link.Href)">
                                                            <i class="fa @(string.IsNullOrWhiteSpace(link.Icon) ? "fa-circle-o" : link.Icon)"></i>
                                                            @link.Label
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="epc-cp-topnav-col">
                                        <ul class="epc-cp-topnav-links">
                                            @foreach (var link in group.Links)
                                            {
                                                <li>
                                                    <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(link.Href)">@link.Label</a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </nav>

    <div id="wrapper">
        <div class="content epc-cp-main-pane">
            <div class="epc-cp-content-inner">
                <div class="row">
                    <!--epc-cp-main-begin-->
                    @ChildContent
                    <!--epc-cp-main-end-->
                </div>
            </div>
        </div>
        <footer class="footer">
            <div>Control Panel · <a href="/cp">Open control panel</a> · <a href="/erp">ERP</a> · <a href="/bos">BOS</a></div>
        </footer>
    </div>
</div>

<style>
    /* Tokens match .epc-cp--blue-theme in epc_cp_professional.css */
    .epc-cp-shell {
        --epc-cp-primary:#2563eb; --epc-cp-primary-dark:#1d4ed8; --epc-blue-900:#0c4a6e; --epc-blue-700:#0369a1; --epc-blue-500:#0ea5e9;
        --cp-ink:#0f172a; --cp-line:#e2e8f0; --cp-bg:#f0f9ff;
        background:var(--cp-bg); color:var(--cp-ink); min-height:100vh; font-family: @(LegacyPhpFontAssets.StackFor("cp"));
    }
    .epc-cp-shell a { color:inherit; text-decoration:none; }
    .epc-cp-header-bar { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:.75rem; padding:.55rem 1rem; background:rgba(255,255,255,.98); border-bottom:1px solid var(--cp-line); }
    .epc-cp-header-logo img { height:34px; }
    .epc-cp-topbar-ctas { display:flex; gap:.45rem; flex-wrap:wrap; }
    .epc-cp-topbar-cta {
        display:inline-flex; align-items:center; padding:.4rem .75rem; border-radius:10px;
        background:linear-gradient(135deg,#b91c1c 0%,#dc2626 55%,#ef4444 100%);
        border:1px solid #991b1b; box-shadow:0 4px 12px rgba(185,28,28,.28);
        color:#fff !important; font-weight:700; font-size:.8rem;
    }
    .epc-cp-header-actions { display:flex; gap:.75rem; align-items:center; font-size:.85rem; font-weight:600; }
    .epc-cp-header-login { color:var(--epc-cp-primary) !important; }
    /* PHP topnav-only: white bar + red underline (epc_cp_professional.css) */
    .epc-cp-topnav { background:#fff !important; color:#7f1d1d; border-bottom:2px solid #dc2626; box-shadow:0 2px 10px rgba(220,38,38,.1); }
    .epc-cp-topnav-inner { display:flex; gap:2px; align-items:stretch; padding:0 10px 0 12px; overflow:auto; min-height:44px; }
    .epc-cp-topnav-brand { display:flex; align-items:center; padding:0 12px 0 4px; margin-right:4px; font-weight:800; font-size:.78rem; letter-spacing:.04em; text-transform:uppercase; white-space:nowrap; color:#dc2626 !important; border-right:1px solid #fecaca; }
    .epc-cp-topnav-brand:hover { color:#991b1b !important; background:#fef2f2; }
    .epc-cp-topnav-list { list-style:none; margin:0; padding:0; display:flex; }
    .epc-cp-topnav-item { position:relative; }
    .epc-cp-topnav-btn { appearance:none; border:0; background:transparent; color:#7f1d1d; font:inherit; font-size:.78rem; font-weight:700; padding:.7rem .7rem; cursor:pointer; white-space:nowrap; }
    .epc-cp-topnav-item:hover .epc-cp-topnav-btn, .epc-cp-topnav-item:focus-within .epc-cp-topnav-btn { background:#fef2f2; color:#991b1b; }
    .epc-cp-topnav-panel { display:none; position:absolute; left:0; top:100%; z-index:40; min-width:320px; max-width:min(920px,94vw); background:#fff; color:#0f172a; border:1px solid #fecaca; border-radius:0 0 .45rem .45rem; box-shadow:0 12px 30px rgba(127,29,29,.12); }
    .epc-cp-topnav-item:hover .epc-cp-topnav-panel, .epc-cp-topnav-item:focus-within .epc-cp-topnav-panel { display:block; }
    .epc-cp-topnav-panel-hd { display:flex; align-items:center; gap:.75rem; padding:.55rem .75rem; font-size:.78rem; font-weight:700; background:#fef2f2; border-bottom:1px solid #fecaca; color:#991b1b; }
    .epc-cp-topnav-cols { display:flex; gap:0; align-items:stretch; }
    .epc-cp-topnav-col { min-width:180px; max-width:240px; border-right:1px solid #fecaca; }
    .epc-cp-topnav-col:last-child { border-right:0; }
    .epc-cp-topnav-col-hd { padding:.45rem .75rem; font-size:.72rem; font-weight:800; text-transform:uppercase; letter-spacing:.04em; color:#b91c1c; background:#fff7f7; border-bottom:1px solid #fecaca; }
    .epc-cp-topnav-links { list-style:none; margin:0; padding:.35rem 0; max-height:360px; overflow:auto; }
    .epc-cp-topnav-links li { display:flex; align-items:center; gap:.4rem; padding:.35rem .75rem; font-size:.8rem; }
    .epc-cp-topnav-links a { flex:1; font-weight:600; display:flex; align-items:center; gap:.4rem; }
    .epc-cp-topnav-links a i { width:1rem; text-align:center; color:#94a3b8; }
    .epc-cp-topnav-links a:hover { color:#dc2626; text-decoration:underline; }
    .epc-cp-main-pane { padding:1rem 1.25rem 2rem; }
    /* Match PHP desktop fluid content width (not a narrow card column). */
    .epc-cp-content-inner { width:min(1480px, calc(100% - 0.5rem)); margin:0 auto; }
    .epc-cp-shell #header, .epc-cp-shell .epc-cp-topnav { width:100%; }
    .epc-cp-shell .epc-cp-header-bar, .epc-cp-shell .epc-cp-topnav-inner { width:min(1480px, 100%); margin:0 auto; }
    .epc-cp-shell .footer { padding:1rem; border-top:1px solid var(--cp-line); color:#64748b; font-size:.8rem; background:#fff; }
</style>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
}
