                            <li><a href="/erp"><i class="fa fa-briefcase"></i> ERP</a></li>
                            <li>
                                <a href="/" target="_blank" rel="noopener noreferrer">
                                    <i class="fa fa-shopping-bag"></i> Storefront@(string.IsNullOrWhiteSpace(_storefrontHost) ? "" : " · " + _storefrontHost)
