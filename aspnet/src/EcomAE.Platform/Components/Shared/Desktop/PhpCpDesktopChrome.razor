@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation
@*
  Mirrors cp/templates/bootstrap_admin/desktop.php chrome classes (topnav-only hybrid).
  Module bodies stay PHP via ChildContent / PhpHybridWorkspaceFrame.
*@

<div class="fixed-navbar fixed-sidebar epc-cp epc-cp-shell epc-cp-topnav-only epc-cp--blue-theme epc-cp-modern epc-php-font-root">
    <div id="header">
        <div class="color-line"></div>
        <div class="epc-cp-header-bar">
            <a class="light-version ech-logo-wrap epc-cp-header-logo" href="/CP/">
                <img src="@LegacyPresentationAssets.EpartsCartMarkUrl" alt="eParts Cart" />
            </a>
            <div class="epc-cp-topbar-strip hidden-xs">
                <nav class="epc-cp-topbar-ctas" aria-label="CP topbar CTAs">
                    <a class="epc-cp-topbar-cta epc-cp-topbar-cta--erp" href="/ERP/">ERP Operations</a>
                    <a class="epc-cp-topbar-cta epc-cp-topbar-cta--storefront" href="https://epartscart.com/">STOREFRONT</a>
                </nav>
            </div>
            <nav class="epc-cp-header-actions" aria-label="CP header actions">
                <a href="/CP/">PHP CP</a>
                @if (!IsAdmin)
                {
                    <a class="epc-cp-header-login" href="/cp/login">Sign in</a>
                }
                else
                {
                    <span class="epc-cp-header-user">Admin session</span>
                }
            </nav>
        </div>
    </div>

    <nav class="epc-cp-topnav" id="epc_cp_topnav" aria-label="Control Panel top navigation">
        <div class="epc-cp-topnav-inner">
            <a class="epc-cp-topnav-brand" href="/cp/app">CONTROL</a>
            <ul class="epc-cp-topnav-list" role="menubar">
                @foreach (var group in LegacyDesktopChromeCatalog.ControlPanelTopnav())
                {
                    <li class="epc-cp-topnav-item" data-group="@group.Id" role="none">
                        <button type="button" class="epc-cp-topnav-btn" role="menuitem" aria-haspopup="true">@group.Label</button>
                        <div class="epc-cp-topnav-panel" data-topnav-panel="@group.Id">
                            <div class="epc-cp-topnav-panel-hd">@group.Label · PHP modules</div>
                            <div class="epc-cp-topnav-cols">
                                <div class="epc-cp-topnav-col">
                                    <ul class="epc-cp-topnav-links">
                                        @foreach (var link in group.Links)
                                        {
                                            <li>
                                                <a href="@PhpModuleCatalog.HybridWorkspaceHref("/cp/app", link.Href)">@link.Label</a>
                                                <a class="epc-cp-topnav-php" href="@link.Href" title="Open PHP full page">PHP</a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </nav>

    <div id="wrapper">
        <div class="content epc-cp-main-pane">
            <div class="epc-cp-content-inner">
                <div class="row">
                    <!--epc-cp-main-begin-->
                    @ChildContent
                    <!--epc-cp-main-end-->
                </div>
            </div>
        </div>
        <footer class="footer">
            <div>Hybrid CP chrome · PHP authoritative for modules · <a href="/CP/">Open live /CP/</a></div>
        </footer>
    </div>
</div>

<style>
    .epc-cp-shell { --cp-ink:#111; --cp-line:#e5e7eb; --cp-bg:#f5f5f7; background:var(--cp-bg); color:var(--cp-ink); min-height:100vh; font-family: @(LegacyPhpFontAssets.StackFor("cp")); }
    .epc-cp-shell a { color:inherit; text-decoration:none; }
    .epc-cp-header-bar { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:.75rem; padding:.55rem 1rem; background:#fff; border-bottom:1px solid var(--cp-line); }
    .epc-cp-header-logo img { height:34px; }
    .epc-cp-topbar-ctas { display:flex; gap:.45rem; flex-wrap:wrap; }
    .epc-cp-topbar-cta { display:inline-flex; padding:.4rem .75rem; border-radius:.35rem; background:#dc2626; color:#fff !important; font-weight:700; font-size:.8rem; }
    .epc-cp-header-actions { display:flex; gap:.75rem; align-items:center; font-size:.85rem; font-weight:600; }
    .epc-cp-header-login { color:#2563eb !important; }
    .epc-cp-topnav { background:#111; color:#fff; }
    .epc-cp-topnav-inner { display:flex; gap:.5rem; align-items:stretch; padding:0 .5rem; overflow:auto; }
    .epc-cp-topnav-brand { display:flex; align-items:center; padding:.65rem .75rem; font-weight:800; letter-spacing:.04em; white-space:nowrap; }
    .epc-cp-topnav-list { list-style:none; margin:0; padding:0; display:flex; }
    .epc-cp-topnav-item { position:relative; }
    .epc-cp-topnav-btn { appearance:none; border:0; background:transparent; color:#fff; font:inherit; font-size:.78rem; font-weight:700; padding:.7rem .7rem; cursor:pointer; white-space:nowrap; opacity:.9; }
    .epc-cp-topnav-item:hover .epc-cp-topnav-btn, .epc-cp-topnav-item:focus-within .epc-cp-topnav-btn { opacity:1; background:#1f1f1f; }
    .epc-cp-topnav-panel { display:none; position:absolute; left:0; top:100%; z-index:40; min-width:280px; max-width:min(520px,90vw); background:#fff; color:#111; border:1px solid #e5e7eb; border-radius:0 0 .45rem .45rem; box-shadow:0 12px 30px rgba(0,0,0,.18); }
    .epc-cp-topnav-item:hover .epc-cp-topnav-panel, .epc-cp-topnav-item:focus-within .epc-cp-topnav-panel { display:block; }
    .epc-cp-topnav-panel-hd { padding:.55rem .75rem; font-size:.78rem; font-weight:700; background:#f8fafc; border-bottom:1px solid #e5e7eb; }
    .epc-cp-topnav-links { list-style:none; margin:0; padding:.35rem 0; max-height:320px; overflow:auto; }
    .epc-cp-topnav-links li { display:flex; align-items:center; gap:.4rem; padding:.35rem .75rem; font-size:.8rem; }
    .epc-cp-topnav-links a { flex:1; font-weight:600; }
    .epc-cp-topnav-links a:hover { color:#2563eb; text-decoration:underline; }
    .epc-cp-topnav-php { flex:0; color:#b45309 !important; font-size:.7rem; font-weight:700; }
    .epc-cp-main-pane { padding:1rem 1rem 2rem; }
    .epc-cp-content-inner { width:min(1200px,100%); margin:0 auto; }
    .epc-cp-shell .footer { padding:1rem; border-top:1px solid var(--cp-line); color:#64748b; font-size:.8rem; background:#fff; }
</style>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
}
