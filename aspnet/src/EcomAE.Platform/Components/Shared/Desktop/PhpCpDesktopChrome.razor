                                            <ul class="epc-cp-topnav-links">
                                                @foreach (var link in col.Tabs)
                                                {
                                                    var href = PhpSurfaceLinkMap.AspNetPrimaryHref(link.Href);
                                                    <li class="@(PathIsActive(href) ? "is-active" : null)">
                                                        <a href="@href">
                                                            <i class="fa @(string.IsNullOrWhiteSpace(link.Icon) ? "fa-circle-o" : link.Icon)"></i>
                                                            @link.Label
                                                        </a>
                                                    </li>
