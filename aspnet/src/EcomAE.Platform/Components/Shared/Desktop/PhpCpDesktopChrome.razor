                <i class="fa fa-th-large" aria-hidden="true"></i><span>Control</span>
            </a>
            <ul class="epc-cp-topnav-list" role="menubar">
                @foreach (var group in LegacyDesktopChromeCatalog.ControlPanelTopnav(includeSuperOnly: _showBos, industryCode: _industryCode).Where(g => _showBos || !IsBosNavGroup(g)))
                {
                    var columns = group.Columns ?? Array.Empty<LegacyDesktopChromeCatalog.MegaAreaColumn>();
                    var shortLabel = string.IsNullOrWhiteSpace(group.ShortLabel) ? group.Label : group.ShortLabel;
                    var itemClass = "epc-cp-topnav-item";
                    if (GroupIsActive(group)) { itemClass += " is-active"; }
                    if (group.IsAdvanced) { itemClass += " epc-cp-topnav-item--advanced"; }
                    <li class="@itemClass" data-group="@group.Id" role="none">
                        <button type="button"
                                class="epc-cp-topnav-btn"
