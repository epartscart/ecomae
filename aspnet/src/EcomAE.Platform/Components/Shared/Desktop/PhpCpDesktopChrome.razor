<div class="@ShellClass">
    <div id="header">
        <div class="color-line"></div>
        <div class="epc-cp-header-bar">
            <a class="light-version ech-logo-wrap epc-cp-header-logo" href="/cp" id="logo">
                <PhpEpartsCartAnimatedLogo Variant="header" />
            </a>
            <div class="epc-cp-topbar-strip hidden-xs">
                <nav class="epc-cp-topbar-ctas" aria-label="Quick destinations">
