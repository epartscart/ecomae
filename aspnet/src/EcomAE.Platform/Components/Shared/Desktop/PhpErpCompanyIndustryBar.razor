@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject IHttpContextAccessor Http
@*
  PHP parity: epc_erp_company_picker_html in epc-erp-content-actions (toolbar top-right).
  Company switch uses ?company= — MAIN ↔ Jewellery (company=1 / company=2) on Super CP.
*@


<HeadContent>
<style>
    .epc-erp-company-scope {
        display: flex; flex-wrap: wrap; align-items: center; gap: .45rem .65rem;
    }
    .epc-erp-company-scope--panel {
        margin: 0 0 1rem; padding: .65rem .75rem; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px;
    }
    .epc-erp-company-scope--toolbar {
        margin: 0; padding: 0; background: transparent; border: 0;
        justify-content: flex-end;
    }
    .epc-erp-industry-chip {
        display: inline-flex; align-items: center; gap: .4rem; font-size: 12.5px; font-weight: 700; color: #0f172a;
    }
    .epc-erp-industry-chip code {
        font-size: 11px; background: #f1f5f9; border-radius: 4px; padding: 1px 6px; color: #475569;
    }
    .epc-erp-jw-badge { font-style: normal; font-size: 10px; font-weight: 800; color: #92400e; background: #fef3c7; border-radius: 999px; padding: 2px 8px; }
    .epc-erp-core-badge { font-style: normal; font-size: 10px; font-weight: 800; color: #1e3a8a; background: #dbeafe; border-radius: 999px; padding: 2px 8px; }
    .epc-erp-company-picker { display: inline-block; position: relative; z-index: 80; }
    .epc-erp-company-btn {
        list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: .4rem;
        border: 1px solid #cbd5e1; background: #fff; border-radius: .4rem; padding: .4rem .75rem;
        font-size: 12.5px; font-weight: 700; color: #0f172a; box-shadow: 0 1px 2px rgba(15,23,42,.06);
    }
    .epc-erp-company-btn::-webkit-details-marker { display: none; }
    .epc-erp-company-btn .caret {
        display: inline-block; width: 0; height: 0; margin-left: 2px;
        border-top: 4px solid #475569; border-right: 4px solid transparent; border-left: 4px solid transparent;
    }
    .epc-erp-company-picker[open] > .epc-erp-company-menu,
    .epc-erp-company-picker:not([open]) > .epc-erp-company-menu { display: none; }
    .epc-erp-company-picker[open] > .epc-erp-company-menu { display: block; }
    .epc-erp-company-menu {
        position: absolute; right: 0; top: calc(100% + 4px); min-width: 300px; max-width: min(440px, 92vw);
        background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: 0 12px 28px rgba(15,23,42,.14);
        margin: 0; padding: 6px 0; list-style: none; z-index: 4000;
    }
    .epc-erp-company-menu > .dropdown-header {
        padding: 6px 14px; font-size: 11px; font-weight: 800; text-transform: uppercase; color: #64748b;
    }
    .epc-erp-company-menu > li > a {
        display: block; padding: 9px 14px; font-size: 12.5px; color: #0f172a; line-height: 1.35; text-decoration: none;
    }
    .epc-erp-company-menu > li.active > a { background: #eff6ff; color: #1d4ed8; font-weight: 600; }
    .epc-erp-company-menu > li > a:hover { background: #f8fafc; }
    .epc-erp-company-meta { display: block; font-size: 11px; color: #64748b; margin-top: 2px; }
    .epc-erp-company-fallback { font-size: 12px; color: #64748b; font-weight: 600; }
    .epc-erp-shell-link {
        display: inline-flex; align-items: center; gap: .3rem;
        font-size: 12px; font-weight: 700; color: #1d4ed8;
        border: 1px solid #bfdbfe; background: #fff; border-radius: .35rem;
        padding: .28rem .55rem; text-decoration: none;
    }
    .epc-erp-content-toolbar {
        display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between;
        gap: .75rem 1rem; margin-bottom: .35rem;
    }
    .epc-erp-content-actions {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end;
        gap: .5rem; margin-left: auto; padding-top: .15rem;
    }
</style>
</HeadContent>


<div class="epc-erp-company-scope epc-erp-company-scope--@Variant.ToLowerInvariant()"
     data-epc-industry="@_industryCode"
     data-epc-erp-host="@_ctx.Host"
     data-epc-erp-jewellery="@(_jewellery ? "1" : "0")"
     data-epc-company-count="@_companies.Count">
    @if (Variant.Equals("Panel", StringComparison.OrdinalIgnoreCase))
    {
        <div class="epc-erp-industry-chip" title="Industry pack for the active company">
            <i class="fa fa-industry" aria-hidden="true"></i>
            <span>@_industryLabel</span>
            <code>@_industryCode</code>
            @if (_jewellery)
            {
                <em class="epc-erp-jw-badge">Jewellery modules</em>
            }
            else
            {
                <em class="epc-erp-core-badge">Core modules</em>
            }
        </div>
    }

    @if (_companies.Count > 0 && _request is not null)
    {
        <details class="epc-erp-company-picker dropdown" data-epc-company-picker="1">
            <summary class="btn btn-default btn-xs dropdown-toggle epc-erp-company-btn"
                     title="Active company (legal entity) — change without editing the URL">
                <i class="fa fa-building" aria-hidden="true"></i>
                <span class="epc-erp-company-name">@_activeLabel</span>
                <span class="caret" aria-hidden="true"></span>
            </summary>
            <ul class="dropdown-menu dropdown-menu-right epc-erp-company-menu" role="menu">
                <li class="dropdown-header">Company / legal entity</li>
                @foreach (var company in _companies)
                {
                    var selected = company.Id == _activeCompanyId;
                    var jw = ErpIndustryNav.IsJewelleryCompany(company);
                    <li class="@(selected ? "active" : null)" role="none">
                        <a role="menuitem" href="@ErpHostContext.SwitchCompanyHref(_request, (int)company.Id)">
                            <i class="fa @(selected ? "fa-check" : "fa-building-o")" aria-hidden="true"></i>
                            <strong>@company.Code</strong> · @company.Name
                            <span class="text-muted epc-erp-company-meta">
                                @(string.IsNullOrWhiteSpace(company.CurrencyCode) ? "AED" : company.CurrencyCode)
                                · @(jw ? "jewellery modules" : "core modules")
                                @if (!string.IsNullOrWhiteSpace(company.IndustryPack))
                                {
                                    <text> · @company.IndustryPack</text>
                                }
                            </span>
                        </a>
                    </li>
                }
            </ul>
        </details>
    }
    else if (!string.IsNullOrWhiteSpace(_message))
    {
        <span class="epc-erp-company-fallback" title="@_message">No companies loaded</span>
    }

    @if (Variant.Equals("Panel", StringComparison.OrdinalIgnoreCase) && PlatformHostPolicy.IsSuperCpHost(_ctx.Host))
    {
        <a class="epc-erp-shell-link" href="/erp/fleet-app" title="Operator fleet ERP view">
            <i class="fa fa-sitemap" aria-hidden="true"></i> Fleet ERP
        </a>
    }
</div>

<script>
(function () {
  if (window.__epcErpCompanyPickerBound) return;
  window.__epcErpCompanyPickerBound = true;
  function place(p) {
    var m = p.querySelector('.epc-erp-company-menu');
    var b = p.querySelector('.epc-erp-company-btn');
    if (!m || !b || !p.open) return;
    var r = b.getBoundingClientRect();
    m.style.position = 'fixed';
    m.style.top = Math.round(r.bottom + 4) + 'px';
    m.style.left = 'auto';
    m.style.right = Math.max(8, Math.round(window.innerWidth - r.right)) + 'px';
    m.style.zIndex = '4000';
  }
  document.addEventListener('toggle', function (e) {
    var p = e.target && e.target.closest ? e.target.closest('[data-epc-company-picker]') : null;
    if (!p) return;
    if (p.open) place(p);
  }, true);
  window.addEventListener('resize', function () {
    document.querySelectorAll('[data-epc-company-picker][open]').forEach(place);
  }, { passive: true });
  window.addEventListener('scroll', function () {
    document.querySelectorAll('[data-epc-company-picker][open]').forEach(place);
  }, true);
  document.addEventListener('click', function (e) {
    document.querySelectorAll('[data-epc-company-picker][open]').forEach(function (p) {
      if (!p.contains(e.target)) p.open = false;
    });
  });
})();
</script>

@code {
    /// <summary>Toolbar = PHP content-actions picker only; Panel = industry chip + picker.</summary>
    [Parameter] public string Variant { get; set; } = "Panel";

    private ErpHostContext.Context _ctx = ErpHostContext.Resolve(null);
    private HttpRequest? _request;
    private IReadOnlyList<ErpCompanyDigest> _companies = [];
    private long _activeCompanyId;
    private string _activeLabel = "Company";
    private string _industryCode = "core";
    private string _industryLabel = "Core / multi-industry";
    private bool _jewellery;
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        _request = Http.HttpContext?.Request;
        _ctx = ErpHostContext.Resolve(_request?.Host.Host);
        var active = ErpHostContext.ActiveCompanyIdFromQuery(_request);
        var digest = await Dashboards.BuildErpCompaniesDigestAsync(50, Http.HttpContext?.RequestAborted ?? default);
        var isSuper = PlatformHostPolicy.IsSuperCpHost(_ctx.Host);
        _companies = ErpIndustryNav.EnsureSwitchableCompanies(digest.Companies, isSuper, _ctx.BrandLabel);
        _message = digest.Message;
        if (_companies.Count == 0)
        {
            _industryCode = _ctx.IndustryCode;
            _industryLabel = _ctx.IndustryLabel;
            _jewellery = ErpIndustryNav.IsJewelleryFromHostOrPack(_ctx.IndustryCode, null, null);
            return;
        }

        _activeCompanyId = active is > 0 && _companies.Any(c => c.Id == active)
            ? active.Value
            : _companies[0].Id;
        var current = _companies.FirstOrDefault(c => c.Id == _activeCompanyId) ?? _companies[0];
        _activeLabel = $"{current.Code} · {current.Name}";
        _jewellery = ErpIndustryNav.IsJewelleryCompany(current);
        _industryCode = _jewellery ? "jewellery" : (string.IsNullOrWhiteSpace(current.IndustryPack) ? "core" : current.IndustryPack);
        _industryLabel = ErpIndustryNav.IndustryLabelForPack(current.IndustryPack, _jewellery);
    }
}
