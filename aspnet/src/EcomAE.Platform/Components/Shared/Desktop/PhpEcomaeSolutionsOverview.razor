@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation
@*
  Scaffold of epc_ecomae_platform_page_solution() index — hub overview.
*@

<div class="epm-wrap" id="ehm-solutions-overview">
	<div class="epm-hero">
		<div class="epm-hero__shade" style="opacity:1;background:linear-gradient(135deg,#7c2d12 0%,#9a3412 40%,#0a0a0a 100%)"></div>
		<div class="epm-hero__content">
			<div class="epm-badge"><i class="fa fa-rocket"></i> Solutions</div>
			<h1>ECOM AE solutions</h1>
			<p class="lead">Purpose-built solution pages for the platform, region, and modules ECOM AE serves — commerce, ERP, CRM, and compliance under one cloud.</p>
			<div class="epm-cta">
				<a class="epm-btn epm-btn--primary" href="/marketing/demo">Start @EcomaeMarketingPages.DemoDays-day demo</a>
				<a class="epm-btn epm-btn--ghost" href="/marketing/solutions">Open full solutions hub</a>
				<a class="epm-btn epm-btn--outline" href="/marketing/industries">Browse industries</a>
			</div>
		</div>
	</div>

	<div class="epm-model-cards">
		<div class="epm-model-card">
			<i class="fa fa-industry"></i>
			<strong>By vertical</strong>
			<p>Auto parts, jewellery, electronics, and GCC trade packs.</p>
		</div>
		<div class="epm-model-card">
			<i class="fa fa-globe"></i>
			<strong>By region</strong>
			<p>UAE &amp; GCC hosted multi-tenant deployments.</p>
		</div>
		<div class="epm-model-card">
			<i class="fa fa-puzzle-piece"></i>
			<strong>By module</strong>
			<p>Commerce, ERP, CRM, and compliance solutions.</p>
		</div>
	</div>

	<div class="epm-highlight">
		<h3>Popular solution paths</h3>
		<ul style="margin:0;padding-left:1.1rem;color:var(--epm-muted);line-height:1.55">
			<li><a href="/marketing/auto-price-ai">Auto Price AI</a> — supplier price intelligence for parts sellers</li>
			<li><a href="/marketing/bos">BOS fleet</a> — multi-tenant operator command</li>
			<li><a href="/marketing/blockchain">Blockchain proofs</a> — document integrity for compliance packs</li>
			<li><a href="/marketing/brochure-cp">Control panel brochure</a> — commerce ops overview</li>
		</ul>
		<p style="margin:1rem 0 0">
			<a class="epm-btn epm-btn--primary" href="/marketing/contact">Talk to sales</a>
			<a class="epm-btn epm-btn--ghost" href="/marketing/pricing" style="margin-left:.5rem">See pricing</a>
		</p>
	</div>
</div>
