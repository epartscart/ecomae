@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation
@*
  Scaffold of epc_ecomae_platform_page_solution() index — hub overview.
  Per-slug solution landings remain PHP deeplink until dual-sample.
*@

<div class="epm-wrap" id="ehm-solutions-overview">
	<div class="epm-hero">
		<div class="epm-hero__shade" style="opacity:1;background:linear-gradient(135deg,#7c2d12 0%,#9a3412 40%,#0a0a0a 100%)"></div>
		<div class="epm-hero__content">
			<div class="epm-badge"><i class="fa fa-rocket"></i> Solutions</div>
			<h1>ECOM AE solutions</h1>
			<p class="lead">Purpose-built solution pages for the platform, region, and modules ECOM AE serves. Full slug landings are available from the linked pages.</p>
			<div class="epm-cta">
				<a class="epm-btn epm-btn--primary" href="/marketing/demo">Start @EcomaeMarketingPages.DemoDays-day demo</a>
				<a class="epm-btn epm-btn--ghost" href="/marketing/solutions">Open full solutions hub</a>
				<a class="epm-btn epm-btn--outline" href="/marketing/industries">Browse industries</a>
			</div>
		</div>
	</div>

	<div class="epm-model-cards">
		<div class="epm-model-card">
			<i class="fa fa-industry"></i>
			<strong>By vertical</strong>
			<p>Auto parts, jewellery, electronics, and GCC trade packs.</p>
		</div>
		<div class="epm-model-card">
			<i class="fa fa-globe"></i>
			<strong>By region</strong>
			<p>UAE &amp; GCC hosted multi-tenant deployments.</p>
		</div>
		<div class="epm-model-card">
			<i class="fa fa-puzzle-piece"></i>
			<strong>By module</strong>
			<p>Commerce, ERP, CRM, and compliance solutions.</p>
		</div>
	</div>

	<p style="margin:24px 0 0;font-size:.85rem;color:var(--epm-muted,#b3b3b3)">
		</p>
</div>
