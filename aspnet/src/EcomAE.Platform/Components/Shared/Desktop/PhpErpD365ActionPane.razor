@namespace EcomAE.Platform.Components.Shared
@*
  Minimal D365 / Suntech action-pane stub matching erp_action_pane_ribbon presentation.
  Primary actions stay on ASP.NET. PHP reference is secondary compare only.
*@
@using EcomAE.Platform.Presentation

<div class="epc-erp-d365" data-epc-aspnet-d365="1">
    <div class="epc-d365-ribbon" role="toolbar" aria-label="Action pane">
        <div class="epc-d365-aptabs" role="tablist">
            <button type="button" class="epc-d365-aptab is-active" data-aptab="home" role="tab" aria-selected="true">Home</button>
        </div>
        <div class="epc-d365-ap-row is-active" data-aptab="home">
            <div class="epc-d365-actionpane" role="toolbar">
                <div class="epc-d365-ap-group">
                    <div class="epc-d365-ap-buttons">
                        @if (!string.IsNullOrWhiteSpace(PhpTabHref))
                        {
                            <a class="epc-d365-ap-btn is-primary" href="@ErpRecordOpen.NewHref(PhpTabHref)">
                                <i class="fa fa-plus" aria-hidden="true"></i><span>New</span>
                            </a>
                        }
                    </div>
                    <div class="epc-d365-ap-label">New</div>
                </div>
                <div class="epc-d365-ap-group">
                    <div class="epc-d365-ap-buttons">
                        @foreach (var action in StandardActions)
                        {
                            <button type="button"
                                    class="epc-d365-ap-btn"
                                    data-erp-standard-action="@action.Key"
                                    disabled
                                    aria-disabled="true"
                                    title="Select a record to use @action.Label">
                                <i class="fa @action.Icon" aria-hidden="true"></i><span>@action.Label</span>
                            </button>
                        }
                    </div>
                    <div class="epc-d365-ap-label">Record</div>
                </div>
                <div class="epc-d365-ap-group">
                    <div class="epc-d365-ap-buttons">
                        <a class="epc-d365-ap-btn" href="@RefreshHref">
                            <i class="fa fa-refresh" aria-hidden="true"></i><span>Refresh</span>
                        </a>
                        @if (!string.IsNullOrWhiteSpace(PhpTabHref))
                        {
                            <a class="epc-d365-ap-btn" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(PhpTabHref)" target="_blank" rel="noopener" title="Open the classic module in a new tab">
                                <i class="fa fa-code" aria-hidden="true"></i><span>Classic twin</span>
                            </a>
                        }
                    </div>
                    <div class="epc-d365-ap-label">Maintain</div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly (string Key, string Label, string Icon)[] StandardActions =
    [
        ("edit", "Edit", "fa-pencil"),
        ("delete", "Delete", "fa-trash"),
        ("void", "Void", "fa-ban"),
        ("submit", "Submit", "fa-send"),
        ("approve", "Approve", "fa-check"),
        ("post", "Post", "fa-book")
    ];

    [Parameter] public string? PhpTabHref { get; set; }
    [Parameter] public string RefreshHref { get; set; } = "?";
}
