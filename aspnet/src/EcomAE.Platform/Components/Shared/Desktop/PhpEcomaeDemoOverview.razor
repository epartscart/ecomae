@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation
@*
  Scaffold of epc_ecomae_platform_page_demo() — hero + wizard steps + CTA.
*@

<div class="epm-wrap" id="ehm-demo-overview">
	<div class="epm-hero">
		<div class="epm-hero__shade" style="opacity:1;background:linear-gradient(135deg,#0c4a6e 0%,#075985 45%,#0a0a0a 100%)"></div>
		<div class="epm-hero__content">
			<div class="epm-badge"><i class="fa fa-magic"></i> AI demo wizard</div>
			<h1>@EcomaeMarketingPages.DemoDays-day industry demo</h1>
			<p class="lead">Layla provisions an isolated tenant with <strong>storefront, control panel, and ERP</strong> in minutes. Choose an industry preset — ERP + CRM + e-commerce in one cloud.</p>
			<div class="epm-cta">
				<a class="epm-btn epm-btn--primary" href="/platform/demo">Start demo wizard</a>
				<a class="epm-btn epm-btn--ghost" href="/platform/pricing">View rental plans</a>
				<a class="epm-btn epm-btn--outline" href="/platform/contact">Contact sales</a>
			</div>
		</div>
	</div>

	<div class="epm-model-cards">
		<div class="epm-model-card">
			<i class="fa fa-list-ol"></i>
			<strong>1 · Pick industry</strong>
			<p>Auto spare parts, fashion retail, or ERP only.</p>
		</div>
		<div class="epm-model-card">
			<i class="fa fa-cloud"></i>
			<strong>2 · Provision tenant</strong>
			<p>Isolated storefront, CP, and ERP workspace for your demo company.</p>
		</div>
		<div class="epm-model-card">
			<i class="fa fa-play-circle"></i>
			<strong>3 · Explore live</strong>
			<p>Browse catalogue, place sample orders, and open finance modules.</p>
		</div>
	</div>

	<div class="epm-highlight">
		<h3>What you get in @EcomaeMarketingPages.DemoDays days</h3>
		<ul style="margin:0;padding-left:1.1rem;color:var(--epm-muted);line-height:1.55">
			<li>Storefront with search, cart, and garage-style vehicle context</li>
			<li>Control panel for catalogue, orders, payments, and marketing</li>
			<li>ERP dashboard with AR/AP, stock, and process-flow visibility</li>
			<li>Optional BOS fleet view for multi-tenant operators</li>
		</ul>
		<p style="margin:1rem 0 0">
			<a class="epm-btn epm-btn--primary" href="/platform/demo">Start demo wizard</a>
			<a class="epm-btn epm-btn--ghost" href="/brochure" style="margin-left:.5rem">Download brochure</a>
		</p>
	</div>
</div>
