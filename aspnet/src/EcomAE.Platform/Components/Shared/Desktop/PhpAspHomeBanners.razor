@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation
@*
  Port of the quick-link banner grid in content/general_pages/epc_portal_automotive_spareparts_home.php
  (data: epc_asp_home_banners() in epc_automotive_spareparts_data.php).
  Styling comes from content/general_pages/epc_automotive_spareparts.css via
  html[data-epc-industry=auto_parts][data-epc-storefront=automotive_spareparts_pro].
*@

<section class="epc-home-banners epc-asp-home-banners">
    <div class="container">
        <div class="epc-home-banners__grid">
            <a class="epc-home-banner epc-home-banner--red" href="@PartsHref">
                <span class="epc-home-banner__icon"><i class="fa fa-barcode"></i></span>
                <strong>Search by part number</strong>
                <span>Quickly check price, availability and delivery time.</span>
            </a>
            <a class="epc-home-banner epc-home-banner--blue" href="@BrandsHref">
                <span class="epc-home-banner__icon"><i class="fa fa-shield"></i></span>
                <strong>Trusted brands</strong>
                <span>Browse available manufacturers and product lines.</span>
            </a>
            <a class="epc-home-banner epc-home-banner--green" href="@CatalogHref">
                <span class="epc-home-banner__icon"><i class="fa fa-sitemap"></i></span>
                <strong>Electronic catalog</strong>
                <span>Find parts through vehicle catalog navigation.</span>
            </a>
            <a class="epc-home-banner epc-home-banner--dark" href="@VinHref">
                <span class="epc-home-banner__icon"><i class="fa fa-car"></i></span>
                <strong>VIN request</strong>
                <span>Ask sellers to identify the exact spare part.</span>
            </a>
        </div>
    </div>
</section>

@code {
    [Parameter] public string PartsHref { get; set; } = "/en/parts";
    [Parameter] public string BrandsHref { get; set; } = "/en/available-brands";
    [Parameter] public string CatalogHref { get; set; } = "/en/umapi_catalog";
    [Parameter] public string VinHref { get; set; } = "/en/zapros-prodavczu";
}
