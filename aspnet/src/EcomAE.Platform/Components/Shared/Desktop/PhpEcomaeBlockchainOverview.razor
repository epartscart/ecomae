@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation
@*
  Scaffold of epc_ecomae_platform_page_blockchain() — hero + layer teasers.
  3D hero assets / verify tool remain PHP deeplink until dual-sample.
*@

<div class="epm-wrap" id="ehm-blockchain-overview">
	<div class="epm-hero">
		<div class="epm-hero__shade" style="opacity:1;background:linear-gradient(135deg,#020617 0%,#0ea5e9 35%,#0a0a0a 100%)"></div>
		<div class="epm-hero__content">
			<div class="epm-badge"><i class="fa fa-link"></i> Blockchain BOS</div>
			<h1>ECOM AE <span style="opacity:.85">Blockchain BOS</span></h1>
			<p class="lead">Cryptographic proof for every critical business fact — without leaving MySQL operations. ERP, commerce, compliance, and workflows stay operational; the proof layer hashes, Merkle-anchors, and lets anyone verify authenticity.</p>
			<div class="epm-cta">
				<a class="epm-btn epm-btn--primary" href="/marketing/demo">Request a demo</a>
				<a class="epm-btn epm-btn--ghost" href="/marketing/blockchain?php=@(Uri.EscapeDataString(EcomaeMarketingPages.LiveBase + "blockchain"))">Open full blockchain page</a>
				<a class="epm-btn epm-btn--outline" href="/marketing/bos">BOS knowledge hub</a>
			</div>
		</div>
	</div>

	<div class="epm-model-cards">
		<div class="epm-model-card">
			<i class="fa fa-shopping-cart"></i>
			<strong>Commerce layer</strong>
			<p>Storefront and catalogue stay fast — proof does not store carts or stock.</p>
		</div>
		<div class="epm-model-card">
			<i class="fa fa-database"></i>
			<strong>MySQL system of record</strong>
			<p>Day-to-day operations remain in the operational database.</p>
		</div>
		<div class="epm-model-card">
			<i class="fa fa-shield"></i>
			<strong>Proof &amp; verify</strong>
			<p>Full layer diagram + verify tool are available from the linked page.</p>
		</div>
	</div>

	<p style="margin:24px 0 0;font-size:.85rem;color:var(--epm-muted,#b3b3b3)">
		</p>
</div>
