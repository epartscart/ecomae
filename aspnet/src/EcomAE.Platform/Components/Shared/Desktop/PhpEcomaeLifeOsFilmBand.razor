@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.LifeOs.Cinematic
@using EcomAE.Platform.Routing
@inject ILifeOsCinematicFilm Film
@*
  Marketing home — LifeOS platform film AFTER the epm-hub hero only.
  Hub markup/CSS untouched. Video is the understanding layer for LifeOS.
*@

<section id="lifeos-film" class="epm-lofilm" aria-labelledby="epm-lofilm-title">
    <div class="epm-lofilm__intro">
        <p class="epm-lofilm__kicker">LifeOS™ on ECOM AE</p>
        <h2 id="epm-lofilm-title">Understand the LifeOS platform in one day.</h2>
        <p class="epm-lofilm__lede">
            LifeOS is the personal operating layer above ERP and commerce — your day runs with a same-name clone
            that briefs, focuses, coaches, and winds down beside you. Watch the cinema, then open the product.
        </p>
    </div>

    <div class="epm-lofilm__cinema">
        <video id="epm-lofilm-video"
               class="epm-lofilm__video"
               controls
               playsinline
               preload="metadata"
               poster="@Film.PosterUrl"
               aria-label="LifeOS platform film — daily human and AI clone routine">
            <source src="@Film.VideoUrl" type="video/mp4" />
        </video>
    </div>

    <div class="epm-lofilm__below">
        <ol class="epm-lofilm__beats" aria-label="Film chapters">
            @foreach (var scene in Film.Scenes.Take(5))
            {
                <li>
                    <button type="button" class="epm-lofilm__seek" data-seek="@scene.StartSeconds">
                        <span class="epm-lofilm__time">@FormatTime(scene.StartSeconds)</span>
                        <span class="epm-lofilm__beat-title">@scene.Title</span>
                    </button>
                </li>
            }
        </ol>
        <div class="epm-lofilm__actions">
            <a class="epm-lofilm__btn epm-lofilm__btn--solid" href="@EcomAeRoutes.LifeOs">Explore LifeOS</a>
            <a class="epm-lofilm__btn epm-lofilm__btn--ghost" href="@EcomAeRoutes.LifeOsCinematicApp">Full theatre</a>
            <a class="epm-lofilm__btn epm-lofilm__btn--ghost" href="@Film.VideoDownloadUrl" download="LifeOS-Daily-Clone-Routine.mp4">Download MP4</a>
        </div>
        <p class="epm-lofilm__caption">1:22 · morning → evening · @Film.ProtagonistName with LifeOS clone</p>
    </div>
</section>

<script defer>
(function () {
  function bind() {
    var v = document.getElementById('epm-lofilm-video');
    if (!v) return;
    document.querySelectorAll('.epm-lofilm__seek').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var sec = Number(btn.getAttribute('data-seek') || 0);
        v.currentTime = Math.max(0, sec);
        v.play().catch(function () {});
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bind);
  } else {
    bind();
  }
})();
</script>

@code {
    private static string FormatTime(int seconds)
    {
        var m = seconds / 60;
        var s = seconds % 60;
        return $"{m}:{s:00}";
    }
}
