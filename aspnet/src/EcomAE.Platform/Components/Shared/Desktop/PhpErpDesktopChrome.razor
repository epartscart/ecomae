@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject IHttpContextAccessor Http
@inject ILegacySessionValidator Sessions
@inject ISurfaceDashboardSummaryReporter Dashboards
@*
  Mirrors erp_desktop.php + epc_erp_render_top_nav mega chrome.
  Topnav typography/panels come from epc_erp_professional.css (px sizes).
  Click-to-toggle JS mirrors cp/js/epc_erp_shell_nav.js bindTopNav (no hover-open).
  Industry filter: jewellery tabs only when active company pack is jewellery (PHP parity).
  BOS nav is Super-CP only — never advertise /bos on tenant hosts.
*@

@*
  Critical shell CSS is duplicated into the BODY stream. Live SSR drops late HeadContent
  for /erp/* while body chrome survives — without body emission ERP renders unaligned.
*@
<HeadContent>
<meta name="ecomae-erp-chrome-css" content="body-inline" />
<style>
    .epc-erp-cp-shell {
        --epc-erp-primary:#2563eb; --epc-erp-body-bg:#f0f9ff; --epc-blue-900:#0c4a6e; --epc-blue-500:#0ea5e9;
        --ink:#0f172a; --muted:#64748b; --line:#e2e8f0; --bg:#f0f9ff;
        background:var(--bg); color:var(--ink); min-height:100vh;
        font-family: @(LegacyPhpFontAssets.StackFor("erp")); font-size: @(LegacyPhpFontAssets.BaseFontSize);
    }
    .epc-erp-cp-shell a { color:inherit; text-decoration:none; }
    .epc-erp-topbar { background:rgba(255,255,255,.98); border-bottom:1px solid var(--line); }
    .epc-erp-topbar__inner { display:flex; flex-wrap:wrap; gap:1rem; align-items:center; justify-content:space-between; padding:.65rem 1rem; }
    .epc-erp-topbar__brand { display:flex; align-items:center; gap:.55rem; font-weight:800; font-size:15px; }
    .epc-erp-topbar__brand img { height:30px; }
    .epc-erp-topbar__nav, .epc-erp-topbar__user { display:flex; gap:.85rem; font-size:13px; font-weight:600; color:#334155; }
    .epc-erp-content { width:min(1480px, calc(100% - 1.5rem)); margin:0 auto; padding:1rem 0 2.5rem; font-size:14px; }
    .epc-erp-topbar__inner, .epc-erp-topnav-inner { width:min(1480px, 100%); margin:0 auto; }
    .epc-erp-breadcrumb { color:var(--muted); font-size:13px; margin-bottom:.35rem; }
    .epc-erp-breadcrumb .sep { margin:0 .25rem; }
    .epc-erp-content-title { margin:0 0 .35rem; font-size:22px; font-weight:700; }
    .epc-erp-host-sub { margin:0 0 .85rem; color:var(--muted); font-size:13px; font-weight:600; }
    .epc-erp-content-body { font-size:14px; }
    .epc-erp-foot { padding:.85rem 1rem; border-top:1px solid var(--line); background:#fff; color:var(--muted); font-size:13px; }
</style>
</HeadContent>
<style>
    .epc-erp-cp-shell {
        --epc-erp-primary:#2563eb; --epc-erp-body-bg:#f0f9ff; --epc-blue-900:#0c4a6e; --epc-blue-500:#0ea5e9;
        --ink:#0f172a; --muted:#64748b; --line:#e2e8f0; --bg:#f0f9ff;
        background:var(--bg); color:var(--ink); min-height:100vh;
        font-family: @(LegacyPhpFontAssets.StackFor("erp")); font-size: @(LegacyPhpFontAssets.BaseFontSize);
    }
    .epc-erp-cp-shell a { color:inherit; text-decoration:none; }
    .epc-erp-topbar { background:rgba(255,255,255,.98); border-bottom:1px solid var(--line); }
    .epc-erp-topbar__inner { display:flex; flex-wrap:wrap; gap:1rem; align-items:center; justify-content:space-between; padding:.65rem 1rem; }
    .epc-erp-topbar__brand { display:flex; align-items:center; gap:.55rem; font-weight:800; font-size:15px; }
    .epc-erp-topbar__brand img { height:30px; }
    .epc-erp-topbar__nav, .epc-erp-topbar__user { display:flex; gap:.85rem; font-size:13px; font-weight:600; color:#334155; }
    .epc-erp-content { width:min(1480px, calc(100% - 1.5rem)); margin:0 auto; padding:1rem 0 2.5rem; font-size:14px; }
    .epc-erp-topbar__inner, .epc-erp-topnav-inner { width:min(1480px, 100%); margin:0 auto; }
    .epc-erp-breadcrumb { color:var(--muted); font-size:13px; margin-bottom:.35rem; }
    .epc-erp-breadcrumb .sep { margin:0 .25rem; }
    .epc-erp-content-title { margin:0 0 .35rem; font-size:22px; font-weight:700; }
    .epc-erp-host-sub { margin:0 0 .85rem; color:var(--muted); font-size:13px; font-weight:600; }
    .epc-erp-content-body { font-size:14px; }
    .epc-erp-foot { padding:.85rem 1rem; border-top:1px solid var(--line); background:#fff; color:var(--muted); font-size:13px; }
</style>

<div class="epc-erp-standalone epc-erp-cp-shell epc-cp-shell epc-cp--blue-theme epc-cp-modern epc-php-font-root"
     data-epc-industry="@_industryCode"
     data-epc-erp-tenant="@_ctx.BrandLabel"
     data-epc-erp-company="@_activeCompanyId"
     data-epc-erp-jewellery="@(_jewellery ? "1" : "0")">
    <header class="epc-erp-topbar epc-erp-topbar--cp">
        <div class="epc-erp-topbar__inner">
            <a class="epc-erp-topbar__brand epc-erp-topbar__brand--hub" href="@ErpHomeHref">
                <span class="epc-erp-topbar__brand-mark--animated">
                    <PhpEpartsCartAnimatedLogo Variant="header" />
                </span>
                <span>@_ctx.BrandLabel ERP</span>
            </a>
            <nav class="epc-erp-topbar__nav epc-erp-topbar__nav--compact" aria-label="ERP topbar">
                <a href="@ErpHomeHref">Dashboard</a>
                <a href="/erp/guide-app">Guide</a>
                <a href="/erp/approvals-app">Approvals</a>
                <a href="/cp">Control panel</a>
                @if (_showBos)
                {
                    <a href="/erp/fleet-app">Fleet ERP</a>
                    <a href="/bos">BOS</a>
                }
            </nav>
            <div class="epc-erp-topbar__user">
                <PhpCpTranslate Context="erp" />
                @if (!_signedIn)
                {
                    <a href="/erp/login">Sign in</a>
                }
                else
                {
                    <span title="@_userLabel">@_userLabel</span>
                    <a class="btn btn-default btn-xs" href="/erp/logout" title="Log out"><i class="fa fa-sign-out" aria-hidden="true"></i> Logout</a>
                }
                <a href="/erp">ERP workspace</a>
            </div>
        </div>
    </header>

    <main class="epc-erp-main epc-erp-main--cp">
        <div class="epc-erp-shell epc-erp-shell--layout epc-erp-shell--topnav epc-erp-shell--topnav-only">
            <nav class="epc-erp-topnav" id="epc_erp_topnav" aria-label="ERP process areas">
                <div class="epc-erp-topnav-inner">
                    <a class="epc-erp-topnav-brand" href="@ErpHomeHref">
                        <i class="fa fa-cubes" aria-hidden="true"></i><span>@_ctx.BrandLabel</span>
                    </a>
                    <ul class="epc-erp-topnav-list" role="menubar">
                        @foreach (var group in _nav)
                        {
                            var columns = group.Columns ?? Array.Empty<LegacyDesktopChromeCatalog.MegaAreaColumn>();
                            var shortLabel = string.IsNullOrWhiteSpace(group.ShortLabel) ? group.Label : group.ShortLabel;
                            <li class="epc-erp-topnav-item" data-category="@group.Id" role="none">
                                <button type="button"
                                        class="epc-erp-topnav-btn"
                                        role="menuitem"
                                        aria-haspopup="true"
                                        aria-expanded="false"
                                        data-topnav-toggle="@group.Id">
                                    @if (!string.IsNullOrWhiteSpace(group.Icon))
                                    {
                                        <i class="fa @group.Icon" aria-hidden="true"></i>
                                    }
                                    @* PHP erp_nav_areas paints full category label; CSS swaps to data-short under 1280px. *@
                                    <span class="epc-erp-topnav-label" data-full="@group.Label" data-short="@shortLabel">@group.Label</span>
                                    <i class="fa fa-angle-down epc-erp-topnav-caret" aria-hidden="true"></i>
                                </button>
                                <div class="epc-erp-topnav-panel" role="menu" hidden data-topnav-panel="@group.Id">
                                    <div class="epc-erp-topnav-panel-hd">
                                        <div class="epc-erp-topnav-panel-title">
                                            @if (!string.IsNullOrWhiteSpace(group.Icon))
                                            {
                                                <i class="fa @group.Icon"></i>
                                            }
                                            @group.Label
                                        </div>
                                        <a class="epc-erp-topnav-panel-hub" href="@ModuleHref(group.HubHref ?? group.Links[0].Href)">
                                            Open first module <i class="fa fa-arrow-right"></i>
                                        </a>
                                    </div>
                                    <div class="epc-erp-topnav-cols">
                                        @foreach (var col in columns)
                                        {
                                            <div class="epc-erp-topnav-col">
                                                <div class="epc-erp-topnav-col-hd">
                                                    @if (!string.IsNullOrWhiteSpace(col.Icon))
                                                    {
                                                        <i class="fa @col.Icon"></i>
                                                    }
                                                    @col.Label
                                                </div>
                                                <ul class="epc-erp-topnav-links">
                                                    @foreach (var link in col.Tabs)
                                                    {
                                                        <li>
                                                            <a href="@ModuleHref(link.Href)">
                                                                <i class="fa @(string.IsNullOrWhiteSpace(link.Icon) ? "fa-circle-o" : link.Icon)"></i>
                                                                @link.Label
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </nav>

            <div class="epc-erp-layout epc-erp-layout--topnav epc-erp-layout--full">
                <div class="epc-erp-content">
                    <div class="epc-erp-content-toolbar">
                        <div class="epc-erp-content-toolbar-main">
                            <div class="epc-erp-content-header">
                                <nav class="epc-erp-breadcrumb" aria-label="Breadcrumb">
                                    <a href="@ErpHomeHref">ERP</a>
                                    <span class="sep">/</span>
                                    <span>@BreadcrumbArea</span>
                                    <span class="sep">/</span>
                                    <span class="epc-erp-breadcrumb-current">@BreadcrumbTab</span>
                                </nav>
                                <h1 class="epc-erp-content-title">@Title</h1>
                                <p class="epc-erp-host-sub">@_companyLabel · @_industryLabel@(_jewellery ? " · jewellery modules on" : " · core modules")</p>
                            </div>
                        </div>
                        @* PHP erp_main.php epc-erp-content-actions — company picker top-right *@
                        <div class="epc-erp-content-actions">
                            <PhpErpCompanyIndustryBar Variant="Toolbar" />
                        </div>
                    </div>
                    <PhpErpCompanyIndustryBar Variant="Panel" />
                    @if (!_signedIn)
                    {
                        <div class="epc-erp-guest-banner alert alert-warning" role="status" style="margin:0 0 12px;padding:8px 10px;">
                            Sign in required for live ERP data.
                            <a href="/erp/login">Sign in</a>
                        </div>
                    }
                    else if (!IsAdmin)
                    {
                        <div class="epc-erp-guest-banner alert alert-info" role="status" style="margin:0 0 12px;padding:8px 10px;">
                            Session lacks <code>erp</code> capability for live digests. Interactive writes remain on the PHP reference module.
                        </div>
                    }
                    <div class="epc-erp-content-body">
                        <!--epc-cp-main-begin-->
                        @ChildContent
                        <!--epc-cp-main-end-->
                    </div>
                </div>
            </div>
        </div>
    </main>
    <footer class="epc-erp-foot">
        ERP · <a href="@ErpHomeHref">Dashboard</a> · <a href="/cp">Control panel</a>
        @if (_showBos)
        {
            <text> · <a href="/erp/fleet-app">Fleet</a> · <a href="/bos">BOS</a></text>
        }
    </footer>
</div>

@* Shell layout only — topnav fonts/panels come from epc_erp_professional.css (13/12/12.5px). *@
<script id="epc-erp-topnav-inline">
(function () {
    'use strict';
    function bindErpTopNav() {
        var root = document.getElementById('epc_erp_topnav');
        if (!root || root._epcErpTopnavBound) { return; }
        root._epcErpTopnavBound = true;
        var items = root.querySelectorAll('.epc-erp-topnav-item');
        var hoverTimer = null;

        function closeAll(except) {
            items.forEach(function (item) {
                if (except && item === except) { return; }
                item.classList.remove('is-open');
                var btn = item.querySelector('[data-topnav-toggle]');
                var panel = item.querySelector('[data-topnav-panel]');
                if (btn) { btn.setAttribute('aria-expanded', 'false'); }
                if (panel) { panel.hidden = true; }
            });
            document.body.classList.remove('epc-erp-topnav-open');
        }

        function placePanel(item, panel) {
            if (!panel || !root) { return; }
            var rootRect = root.getBoundingClientRect();
            var btn = item.querySelector('.epc-erp-topnav-btn');
            var btnRect = btn ? btn.getBoundingClientRect() : rootRect;
            var top = Math.round(rootRect.bottom);
            panel.style.top = top + 'px';
            panel.style.maxHeight = Math.max(180, Math.floor(window.innerHeight - top - 12)) + 'px';
            panel.style.left = '0px';
            panel.style.right = 'auto';
            panel.hidden = false;
            var panelWidth = panel.offsetWidth || 720;
            var left = Math.round(btnRect.left);
            var maxLeft = Math.max(8, window.innerWidth - panelWidth - 8);
            if (left > maxLeft) { left = maxLeft; }
            if (left < 8) { left = 8; }
            panel.style.left = left + 'px';
        }

        function openItem(item) {
            if (!item) { return; }
            closeAll(item);
            item.classList.add('is-open');
            var btn = item.querySelector('[data-topnav-toggle]');
            var panel = item.querySelector('[data-topnav-panel]');
            if (btn) { btn.setAttribute('aria-expanded', 'true'); }
            if (panel) { placePanel(item, panel); }
            document.body.classList.add('epc-erp-topnav-open');
        }

        function toggleItem(item) {
            if (item.classList.contains('is-open')) { closeAll(); }
            else { openItem(item); }
        }

        items.forEach(function (item) {
            var btn = item.querySelector('[data-topnav-toggle]');
            if (!btn) { return; }
            var skippedClick = false;
            function onToggle(e) {
                if (e) { e.preventDefault(); e.stopPropagation(); }
                if (hoverTimer) { clearTimeout(hoverTimer); hoverTimer = null; }
                toggleItem(item);
            }
            btn.addEventListener('pointerdown', function (e) {
                if (e.button != null && e.button !== 0) { return; }
                skippedClick = true;
                onToggle(e);
            }, { passive: false });
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (skippedClick) { skippedClick = false; return; }
                onToggle(e);
            });
            item.addEventListener('mouseleave', function () {
                hoverTimer = setTimeout(function () {
                    if (!item.matches(':hover') && item.classList.contains('is-open')) { closeAll(); }
                }, 120);
            });
            item.addEventListener('mouseenter', function () {
                if (hoverTimer) { clearTimeout(hoverTimer); hoverTimer = null; }
            });
        });

        document.addEventListener('click', function (e) {
            if (!root.contains(e.target)) { closeAll(); }
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { closeAll(); }
        });
        window.addEventListener('resize', function () {
            var open = root.querySelector('.epc-erp-topnav-item.is-open');
            if (!open) { return; }
            var panel = open.querySelector('[data-topnav-panel]');
            if (panel && !panel.hidden) { placePanel(open, panel); }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindErpTopNav);
    } else {
        bindErpTopNav();
    }
})();
</script>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public string Title { get; set; } = "Dashboard";
    [Parameter] public string BreadcrumbArea { get; set; } = "Home";
    [Parameter] public string BreadcrumbTab { get; set; } = "Dashboard";

    private bool _showBos;
    private bool _signedIn;
    private bool _jewellery;
    private long _activeCompanyId;
    private string _userLabel = "Admin session";
    private string _companyLabel = "MAIN";
    private string _industryCode = "core";
    private string _industryLabel = "Core / multi-industry";
    private ErpHostContext.Context _ctx = ErpHostContext.Resolve(null);
    private IReadOnlyList<LegacyDesktopChromeCatalog.MegaGroup> _nav = LegacyDesktopChromeCatalog.ErpTopnav();

    private string ErpHomeHref => _activeCompanyId > 0 ? $"/erp?company={_activeCompanyId}" : "/erp";

    private string ModuleHref(string? href)
    {
        var mapped = PhpSurfaceLinkMap.AspNetPrimaryHref(href);
        if (_activeCompanyId <= 0)
        {
            return mapped;
        }

        var sep = mapped.Contains('?', StringComparison.Ordinal) ? "&" : "?";
        return mapped + sep + "company=" + _activeCompanyId;
    }

    protected override async Task OnInitializedAsync()
    {
        var host = Http.HttpContext?.Request.Host.Host;
        _showBos = PlatformHostPolicy.IsSuperCpHost(host);
        _ctx = ErpHostContext.Resolve(host);
        _industryCode = _ctx.IndustryCode;
        _industryLabel = _ctx.IndustryLabel;

        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            _signedIn = IsAdmin;
            _nav = ErpIndustryNav.FilterTopnav(LegacyDesktopChromeCatalog.ErpTopnav(), false);
            return;
        }

        var companies = ErpIndustryNav.EnsureSwitchableCompanies(
            (await Dashboards.BuildErpCompaniesDigestAsync(50, ctx.RequestAborted)).Companies,
            _showBos,
            _ctx.BrandLabel);

        var activeQ = ErpHostContext.ActiveCompanyIdFromQuery(ctx.Request);
        var active = companies.FirstOrDefault(c => activeQ is > 0 && c.Id == activeQ)
            ?? companies.FirstOrDefault();
        if (active is not null)
        {
            _activeCompanyId = active.Id;
            _companyLabel = $"{active.Code} · {active.Name}";
            _jewellery = ErpIndustryNav.IsJewelleryCompany(active);
            _industryCode = _jewellery ? "jewellery" : (string.IsNullOrWhiteSpace(active.IndustryPack) ? "core" : active.IndustryPack);
            _industryLabel = ErpIndustryNav.IndustryLabelForPack(active.IndustryPack, _jewellery);
        }
        else
        {
            _jewellery = ErpIndustryNav.IsJewelleryFromHostOrPack(_ctx.IndustryCode, null, null);
        }

        _nav = ErpIndustryNav.FilterTopnav(LegacyDesktopChromeCatalog.ErpTopnav(), _jewellery);

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _signedIn = session.Kind == LegacySessionKind.Admin || IsAdmin;
        if (_signedIn)
        {
            _userLabel = string.IsNullOrWhiteSpace(session.Email) ? "Admin session" : session.Email!;
        }
    }
}
