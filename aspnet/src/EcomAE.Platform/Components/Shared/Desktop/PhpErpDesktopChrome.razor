@* Shell layout only — topnav fonts/panels come from epc_erp_professional.css (13/12/12.5px). *@
<script id="epc-erp-topnav-inline">
(function () {
    'use strict';
    function bindErpTopNav() {
        var root = document.getElementById('epc_erp_topnav');
        if (!root || root._epcErpTopnavBound) { return; }
        root._epcErpTopnavBound = true;
        var items = root.querySelectorAll('.epc-erp-topnav-item');
        var hoverTimer = null;

        function closeAll(except) {
            items.forEach(function (item) {
                if (except && item === except) { return; }
                item.classList.remove('is-open');
                var btn = item.querySelector('[data-topnav-toggle]');
                var panel = item.querySelector('[data-topnav-panel]');
                if (btn) { btn.setAttribute('aria-expanded', 'false'); }
                if (panel) { panel.hidden = true; }
            });
            document.body.classList.remove('epc-erp-topnav-open');
        }

        function placePanel(item, panel) {
            if (!panel || !root) { return; }
            var rootRect = root.getBoundingClientRect();
            var btn = item.querySelector('.epc-erp-topnav-btn');
            var btnRect = btn ? btn.getBoundingClientRect() : rootRect;
            var top = Math.round(rootRect.bottom);
            panel.style.top = top + 'px';
            panel.style.maxHeight = Math.max(180, Math.floor(window.innerHeight - top - 12)) + 'px';
            panel.style.left = '0px';
            panel.style.right = 'auto';
            panel.hidden = false;
            var panelWidth = panel.offsetWidth || 720;
            var left = Math.round(btnRect.left);
            var maxLeft = Math.max(8, window.innerWidth - panelWidth - 8);
            if (left > maxLeft) { left = maxLeft; }
            if (left < 8) { left = 8; }
            panel.style.left = left + 'px';
        }

        function openItem(item) {
            if (!item) { return; }
            closeAll(item);
            item.classList.add('is-open');
            var btn = item.querySelector('[data-topnav-toggle]');
            var panel = item.querySelector('[data-topnav-panel]');
            if (btn) { btn.setAttribute('aria-expanded', 'true'); }
            if (panel) { placePanel(item, panel); }
            document.body.classList.add('epc-erp-topnav-open');
        }

        function toggleItem(item) {
            if (item.classList.contains('is-open')) { closeAll(); }
            else { openItem(item); }
        }

        items.forEach(function (item) {
            var btn = item.querySelector('[data-topnav-toggle]');
            if (!btn) { return; }
            var skippedClick = false;
            function onToggle(e) {
                if (e) { e.preventDefault(); e.stopPropagation(); }
                if (hoverTimer) { clearTimeout(hoverTimer); hoverTimer = null; }
                toggleItem(item);
            }
            btn.addEventListener('pointerdown', function (e) {
                if (e.button != null && e.button !== 0) { return; }
                skippedClick = true;
                onToggle(e);
            }, { passive: false });
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (skippedClick) { skippedClick = false; return; }
                onToggle(e);
            });
            item.addEventListener('mouseleave', function () {
                hoverTimer = setTimeout(function () {
                    if (!item.matches(':hover') && item.classList.contains('is-open')) { closeAll(); }
                }, 120);
            });
            item.addEventListener('mouseenter', function () {
                if (hoverTimer) { clearTimeout(hoverTimer); hoverTimer = null; }
            });
        });

        document.addEventListener('click', function (e) {
            if (!root.contains(e.target)) { closeAll(); }
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { closeAll(); }
        });
        window.addEventListener('resize', function () {
            var open = root.querySelector('.epc-erp-topnav-item.is-open');
            if (!open) { return; }
            var panel = open.querySelector('[data-topnav-panel]');
            if (panel && !panel.hidden) { placePanel(open, panel); }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindErpTopNav);
    } else {
        bindErpTopNav();
    }
})();
</script>
<script>
(function () {
  if (window.__epcErpGlobalSearchBound) return;
  window.__epcErpGlobalSearchBound = true;
  function catalog(root) {
    var tag = root.querySelector('[data-epc-global-search-catalog]');
    if (!tag) return [];
    try { return JSON.parse(tag.textContent || '[]'); } catch (e) { return []; }
  }
  function place(input, box) {
    var rect = input.getBoundingClientRect();
    var width = Math.min(576, Math.max(280, window.innerWidth - 16));
    var left = Math.max(8, Math.min(rect.left, window.innerWidth - width - 8));
    box.style.left = left + 'px';
    box.style.top = (rect.bottom + 4) + 'px';
    box.style.width = width + 'px';
  }
  function hay(r) {
    return (String(r.label || '') + ' ' + String(r.group || '') + ' ' + String(r.keywords || '')).toLowerCase();
  }
  function hitToken(text, token) {
    if (text.indexOf(token) >= 0) return true;
    return token === 'exempt' && text.indexOf('exemption') >= 0;
  }
  function render(root, q) {
    var box = root.querySelector('[data-epc-global-search-results]');
    var input = root.querySelector('[data-epc-global-search-input]');
    if (!box) return;
    var rows = catalog(root);
    var needle = (q || '').trim().toLowerCase();
    var parts = needle ? needle.split(/\s+/).filter(Boolean) : [];
    var hits = rows.map(function (r) {
      if (!needle) return { row: r, score: 0 };
      var text = hay(r);
      var label = String(r.label || '').toLowerCase();
      for (var i = 0; i < parts.length; i++) {
        if (!hitToken(text, parts[i])) return null;
      }
      var score = label.indexOf(needle) >= 0 ? 100 : 0;
      parts.forEach(function (part) {
        score += label.indexOf(part) >= 0 ? 10 : 1;
      });
      return { row: r, score: score };
    }).filter(Boolean).sort(function (a, b) {
      return b.score - a.score || String(a.row.label || '').localeCompare(String(b.row.label || ''));
    }).slice(0, 24).map(function (x) { return x.row; });
    if (input) place(input, box);
    if (!hits.length) {
      box.hidden = needle.length === 0;
      box.innerHTML = needle ? '<div class="epc-erp-global-search__hit">No matching pages</div>' : '';
      return;
    }
    box.hidden = false;
    box.innerHTML = hits.map(function (r) {
      var href = String(r.href || '#');
      var company = root.getAttribute('data-company') || '';
      if (company && href.indexOf('company=') < 0 && href.charAt(0) !== '#') {
        href += (href.indexOf('?') >= 0 ? '&' : '?') + 'company=' + encodeURIComponent(company);
      }
      return '<a class="epc-erp-global-search__hit" href="' + href.replace(/"/g, '') + '">'
        + '<i class="fa ' + String(r.icon || 'fa-th-large').replace(/"/g, '') + '"></i>'
        + '<span>' + String(r.label || '').replace(/</g, '&lt;') + '</span>'
        + '<small>' + String(r.group || '').replace(/</g, '&lt;') + '</small></a>';
    }).join('');
  }
  document.addEventListener('input', function (e) {
    var input = e.target && e.target.closest ? e.target.closest('[data-epc-global-search-input]') : null;
    if (!input) return;
    var root = input.closest('[data-epc-global-search]');
    if (root) render(root, input.value);
  });
  document.addEventListener('focusin', function (e) {
    var input = e.target && e.target.closest ? e.target.closest('[data-epc-global-search-input]') : null;
    if (!input) return;
    var root = input.closest('[data-epc-global-search]');
    if (root) render(root, input.value);
  });
  document.addEventListener('click', function (e) {
    document.querySelectorAll('[data-epc-global-search]').forEach(function (root) {
      if (!root.contains(e.target)) {
        var box = root.querySelector('[data-epc-global-search-results]');
        if (box) box.hidden = true;
      }
    });
  });
})();
</script>
