@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation
@*
  Mirrors erp_desktop.php outer topbar + erp_main.php / epc_erp_render_top_nav mega chrome
  (area columns + Open first + panel sizing from epc_erp_professional.css).
*@

<div class="epc-erp-standalone epc-erp-cp-shell epc-cp-shell epc-cp--blue-theme epc-cp-modern epc-php-font-root">
    <header class="epc-erp-topbar epc-erp-topbar--cp">
        <div class="epc-erp-topbar__inner">
            <a class="epc-erp-topbar__brand epc-erp-topbar__brand--hub" href="/ERP/">
                <img src="@LegacyPresentationAssets.EpartsCartMarkUrl" alt="ECOM AE" />
                <span>Ecom BOS</span>
            </a>
            <nav class="epc-erp-topbar__nav epc-erp-topbar__nav--compact" aria-label="ERP topbar">
                <a href="/ERP/">Guide</a>
                <a href="/CP/control/portal">Tenants</a>
                <a href="/CP/">E-commerce CP</a>
            </nav>
            <div class="epc-erp-topbar__user">
                @if (!IsAdmin)
                {
                    <a href="/erp/login">Sign in</a>
                }
                else
                {
                    <span>Admin session</span>
                }
                <a href="/ERP/">PHP ERP</a>
            </div>
        </div>
    </header>

    <main class="epc-erp-main epc-erp-main--cp">
        <div class="epc-erp-shell epc-erp-shell--layout epc-erp-shell--topnav epc-erp-shell--topnav-only">
            <nav class="epc-erp-topnav" id="epc_erp_topnav" aria-label="ERP process areas">
                <div class="epc-erp-topnav-inner">
                    <a class="epc-erp-topnav-brand" href="/ERP/?epc_erp_shell=1&amp;area=overview&amp;tab=dashboard">
                        <i class="fa fa-cubes" aria-hidden="true"></i><span>Ecom BOS</span>
                    </a>
                    <ul class="epc-erp-topnav-list" role="menubar">
                        @foreach (var group in LegacyDesktopChromeCatalog.ErpTopnav())
                        {
                            var columns = group.Columns ?? Array.Empty<LegacyDesktopChromeCatalog.MegaAreaColumn>();
                            <li class="epc-erp-topnav-item" data-category="@group.Id" role="none">
                                <button type="button" class="epc-erp-topnav-btn" role="menuitem" aria-haspopup="true" aria-expanded="false" data-topnav-toggle="@group.Id">
                                    @if (!string.IsNullOrWhiteSpace(group.Icon))
                                    {
                                        <i class="fa @group.Icon" aria-hidden="true"></i>
                                    }
                                    <span class="epc-erp-topnav-label" data-full="@group.Label" data-short="@(group.ShortLabel ?? group.Label)">@group.Label</span>
                                    <i class="fa fa-angle-down epc-erp-topnav-caret" aria-hidden="true"></i>
                                </button>
                                <div class="epc-erp-topnav-panel" role="menu" data-topnav-panel="@group.Id">
                                    <div class="epc-erp-topnav-panel-hd">
                                        <div class="epc-erp-topnav-panel-title">
                                            @if (!string.IsNullOrWhiteSpace(group.Icon))
                                            {
                                                <i class="fa @group.Icon"></i>
                                            }
                                            @group.Label
                                        </div>
                                        <a class="epc-erp-topnav-panel-hub" href="@PhpModuleCatalog.HybridWorkspaceHref("/erp/app", group.HubHref ?? group.Links[0].Href)">
                                            Open first module <i class="fa fa-arrow-right"></i>
                                        </a>
                                    </div>
                                    <div class="epc-erp-topnav-cols">
                                        @foreach (var col in columns)
                                        {
                                            <div class="epc-erp-topnav-col">
                                                <div class="epc-erp-topnav-col-hd">
                                                    @if (!string.IsNullOrWhiteSpace(col.Icon))
                                                    {
                                                        <i class="fa @col.Icon"></i>
                                                    }
                                                    @col.Label
                                                </div>
                                                <ul class="epc-erp-topnav-links">
                                                    @foreach (var link in col.Tabs)
                                                    {
                                                        <li>
                                                            <a href="@PhpModuleCatalog.HybridWorkspaceHref("/erp/app", link.Href)">
                                                                <i class="fa @(string.IsNullOrWhiteSpace(link.Icon) ? "fa-circle-o" : link.Icon)"></i>
                                                                @link.Label
                                                            </a>
                                                            <a class="epc-erp-topnav-php" href="@link.Href" title="Open live PHP tab">PHP</a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </nav>

            <div class="epc-erp-layout epc-erp-layout--topnav epc-erp-layout--full">
                <div class="epc-erp-content">
                    <div class="epc-erp-content-toolbar">
                        <div class="epc-erp-content-toolbar-main">
                            <div class="epc-erp-content-header">
                                <nav class="epc-erp-breadcrumb" aria-label="Breadcrumb">
                                    <a href="/ERP/">ERP</a>
                                    <span class="sep">/</span>
                                    <span>@BreadcrumbArea</span>
                                    <span class="sep">/</span>
                                    <span class="epc-erp-breadcrumb-current">@BreadcrumbTab</span>
                                </nav>
                                <h1 class="epc-erp-content-title">@Title</h1>
                            </div>
                        </div>
                    </div>
                    <div class="epc-erp-content-body">
                        <!--epc-cp-main-begin-->
                        @ChildContent
                        <!--epc-cp-main-end-->
                    </div>
                </div>
            </div>
        </div>
    </main>
    <footer class="epc-erp-foot">Hybrid ERP chrome · PHP tab bodies authoritative · <a href="/ERP/">/ERP/</a></footer>
</div>

<style>
    .epc-erp-cp-shell { --ink:#0f172a; --muted:#64748b; --line:#e2e8f0; --bg:#f8fafc; background:var(--bg); color:var(--ink); min-height:100vh; font-family: @(LegacyPhpFontAssets.StackFor("erp")); }
    .epc-erp-cp-shell a { color:inherit; text-decoration:none; }
    .epc-erp-topbar { background:#fff; border-bottom:1px solid var(--line); }
    .epc-erp-topbar__inner { display:flex; flex-wrap:wrap; gap:1rem; align-items:center; justify-content:space-between; padding:.65rem 1rem; }
    .epc-erp-topbar__brand { display:flex; align-items:center; gap:.55rem; font-weight:800; }
    .epc-erp-topbar__brand img { height:30px; }
    .epc-erp-topbar__nav, .epc-erp-topbar__user { display:flex; gap:.85rem; font-size:.85rem; font-weight:600; color:#334155; }
    .epc-erp-topnav { background:#fff; border-bottom:1px solid var(--line); position:sticky; top:0; z-index:30; }
    .epc-erp-topnav-inner { display:flex; gap:.35rem; overflow:visible; padding:0 .4rem; }
    .epc-erp-topnav-brand { display:flex; align-items:center; gap:.4rem; padding:.65rem .7rem; font-weight:800; color:#1d4ed8; white-space:nowrap; }
    .epc-erp-topnav-list { list-style:none; margin:0; padding:0; display:flex; }
    .epc-erp-topnav-item { position:relative; }
    .epc-erp-topnav-btn { appearance:none; border:0; background:transparent; font:inherit; font-size:.8rem; font-weight:700; color:#334155; padding:.7rem .65rem; cursor:pointer; white-space:nowrap; display:inline-flex; align-items:center; gap:.35rem; }
    .epc-erp-topnav-caret { font-size:.7rem; opacity:.75; }
    .epc-erp-topnav-item:hover .epc-erp-topnav-btn, .epc-erp-topnav-item:focus-within .epc-erp-topnav-btn { color:#1d4ed8; background:#eff6ff; }
    .epc-erp-topnav-panel {
        display:none; position:absolute; left:0; top:100%; z-index:40;
        min-width:min(920px, calc(100vw - 24px)); max-width:min(1100px, calc(100vw - 16px));
        max-height:min(70vh, 560px); overflow:auto;
        background:#fff; border:1px solid #dbe3ec; border-radius:0 0 8px 8px;
        box-shadow:0 14px 36px rgba(15,23,42,.22);
    }
    .epc-erp-topnav-item:hover .epc-erp-topnav-panel, .epc-erp-topnav-item:focus-within .epc-erp-topnav-panel { display:block; }
    .epc-erp-topnav-panel-hd { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 16px; font-size:.78rem; font-weight:700; background:#f1f5f9; border-bottom:1px solid #e2e8f0; position:sticky; top:0; z-index:1; }
    .epc-erp-topnav-panel-title { font-size:13px; font-weight:700; color:#0c4a6e; }
    .epc-erp-topnav-panel-title .fa { margin-right:6px; }
    .epc-erp-topnav-panel-hub { font-size:12px; font-weight:600; color:#0369a1 !important; white-space:nowrap; }
    .epc-erp-topnav-panel-hub:hover { color:#0c4a6e !important; text-decoration:underline; }
    .epc-erp-topnav-cols { display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:0; padding:8px 4px 12px; }
    .epc-erp-topnav-col { padding:8px 12px 10px; border-right:1px solid #eef2f7; min-width:0; }
    .epc-erp-topnav-col:last-child { border-right:0; }
    .epc-erp-topnav-col-hd { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:#475569; margin-bottom:6px; padding-bottom:5px; border-bottom:1px solid #e2e8f0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .epc-erp-topnav-col-hd .fa { margin-right:5px; color:#0369a1; }
    .epc-erp-topnav-links { list-style:none; margin:0; padding:0; }
    .epc-erp-topnav-links li { display:flex; gap:.35rem; align-items:center; }
    .epc-erp-topnav-links a { flex:1; display:flex; align-items:center; gap:7px; padding:5px 6px; border-radius:4px; font-size:12.5px; font-weight:600; color:#1e293b; line-height:1.3; }
    .epc-erp-topnav-links a:hover { background:#f0f9ff; color:#1d4ed8; }
    .epc-erp-topnav-links a .fa { width:14px; text-align:center; color:#64748b; }
    .epc-erp-topnav-php { flex:0; color:#b45309; font-size:.68rem; font-weight:700; padding-right:4px; }
    .epc-erp-content { width:min(1480px, calc(100% - 1.5rem)); margin:0 auto; padding:1rem 0 2.5rem; }
    .epc-erp-topbar__inner, .epc-erp-topnav-inner { width:min(1480px, 100%); margin:0 auto; }
    .epc-erp-breadcrumb { color:var(--muted); font-size:.8rem; margin-bottom:.35rem; }
    .epc-erp-breadcrumb .sep { margin:0 .25rem; }
    .epc-erp-content-title { margin:0 0 .85rem; font-size:1.45rem; }
    .epc-erp-foot { padding:.85rem 1rem; border-top:1px solid var(--line); background:#fff; color:var(--muted); font-size:.8rem; }
    @@media (max-width:900px) {
        .epc-erp-topnav-panel { min-width:min(96vw, 920px); left:auto; right:0; }
        .epc-erp-topnav-cols { grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); }
    }
</style>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public string Title { get; set; } = "Dashboard";
    [Parameter] public string BreadcrumbArea { get; set; } = "Home";
    [Parameter] public string BreadcrumbTab { get; set; } = "Dashboard";
}
