@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public string Title { get; set; } = "Dashboard";
    [Parameter] public string BreadcrumbArea { get; set; } = "Home";
    [Parameter] public string BreadcrumbTab { get; set; } = "Dashboard";

    private bool IsDashboardHome =>
        string.Equals(Title, "Dashboard", StringComparison.OrdinalIgnoreCase)
        && IsErpHomePath(_currentPath);

    private static bool IsErpHomePath(string path)
    {
        var p = (path ?? "").Split('?', 2)[0].TrimEnd('/');
        return p.Equals("/erp", StringComparison.OrdinalIgnoreCase)
               || p.Equals("/erp/app", StringComparison.OrdinalIgnoreCase)
               || p.EndsWith("/erp/app", StringComparison.OrdinalIgnoreCase);
    }

    private bool _showBos;
    private bool _clientErp;
    private bool _showControlPanel = true;
    private bool _signedIn;
    private bool _jewellery;
    private bool _fitOut;
    private bool _realEstate;
    private long _activeCompanyId;
    private string _userLabel = "Admin session";
    private string _companyLabel = "MAIN";
    private string _industryCode = "core";
    private string _industryLabel = "Core / multi-industry";
    private string _currentPath = "/erp";
    private ErpHostContext.Context _ctx = ErpHostContext.Resolve(null);
    private IReadOnlyList<LegacyDesktopChromeCatalog.MegaGroup> _nav = LegacyDesktopChromeCatalog.ErpTopnav();
    private List<FavChip> _favs = [];
    private readonly Dictionary<string, long> _favIds = new(StringComparer.OrdinalIgnoreCase);

    private sealed record FavChip(long Id, string Label, string Href, string Icon);

    private string ErpHomeHref => _activeCompanyId > 0 ? $"/erp?company={_activeCompanyId}" : "/erp";

    private string FavoriteReturnHref
    {
        get
        {
            var path = Http.HttpContext?.Request.Path.Value;
            if (string.IsNullOrWhiteSpace(path))
            {
                path = "/erp";
            }

            var query = Http.HttpContext?.Request.QueryString.Value;
            return string.IsNullOrEmpty(query) ? path : path + query;
        }
    }

    private bool CurrentPageIsFavorite => IsFavoriteHref(FavoriteReturnHref);

    private long FavoriteIdForHref(string? href)
        => !string.IsNullOrWhiteSpace(href) && _favIds.TryGetValue(NormalizeFavHref(href), out var id) ? id : 0;

    private bool IsFavoriteHref(string? href)
        => !string.IsNullOrWhiteSpace(href) && _favIds.ContainsKey(NormalizeFavHref(href));

    private static string FavIcon(string? icon)
        => string.IsNullOrWhiteSpace(icon) ? "fa fa-star" : (icon.StartsWith("fa ", StringComparison.Ordinal) ? icon : "fa " + icon);

    private static string NormalizeFavHref(string href)
    {
        var path = href.Split('?', 2)[0].TrimEnd('/');
        return path.Length == 0 ? "/" : path;
    }

    private async Task LoadFavouritesAsync(int userId, CancellationToken cancellationToken)
    {
        if (userId <= 0)
        {
            return;
        }

        try
        {
            var listed = await Shortcuts.ListAsync(userId, "erp", cancellationToken);
            if (listed.Rows.Count == 0)
            {
                return;
            }

            var chips = new List<FavChip>(listed.Rows.Count);
            foreach (var row in listed.Rows)
            {
                var label = Convert.ToString(row.GetValueOrDefault("label"));
                var url = System.Net.WebUtility.HtmlDecode(Convert.ToString(row.GetValueOrDefault("url")) ?? string.Empty)
                    .Replace("&amp;", "&", StringComparison.Ordinal);
                var icon = Convert.ToString(row.GetValueOrDefault("icon"));
                var id = 0L;
                if (row.TryGetValue("id", out var rawId) && rawId is not null)
                {
                    id = Convert.ToInt64(rawId, System.Globalization.CultureInfo.InvariantCulture);
                }

                if (string.IsNullOrWhiteSpace(url) || !url.StartsWith('/'))
                {
                    continue;
                }

                chips.Add(new FavChip(
                    id,
                    string.IsNullOrWhiteSpace(label) ? "Favourite" : label.Trim(),
                    url.Trim(),
                    string.IsNullOrWhiteSpace(icon) ? "fa-star" : icon.Trim()));
            }

            _favs = chips;
            IndexFavourites();
        }
        catch (Exception)
        {
            _favs = [];
            _favIds.Clear();
        }
    }

    private void IndexFavourites()
    {
        _favIds.Clear();
        foreach (var fav in _favs)
        {
            _favIds.TryAdd(NormalizeFavHref(fav.Href), fav.Id);
        }
    }

    private string LogoutHref
    {
        get
        {
            var key = ClientErpPath.BoundSiteKey(Http.HttpContext);
            return string.IsNullOrWhiteSpace(key)
                ? "/erp/logout"
                : ClientErpPath.PrefixErpPath(key, "/erp/logout");
        }
    }

    private string ModuleHref(string? href)
    {
        var mapped = ErpPhpTabRouteMap.PreferErpSurface(PhpSurfaceLinkMap.AspNetPrimaryHref(href));
        if (_activeCompanyId <= 0)
        {
            return mapped;
        }

        var sep = mapped.Contains('?', StringComparison.Ordinal) ? "&" : "?";
        return mapped + sep + "company=" + _activeCompanyId;
    }

    private bool GroupIsActive(LegacyDesktopChromeCatalog.MegaGroup group)
        => PathIsActive(group.HubHref) || group.Links.Any(l => PathIsActive(l.Href));

    private bool PathIsActive(string? href)
    {
        if (string.IsNullOrWhiteSpace(href))
        {
            return false;
        }

        var mapped = ErpPhpTabRouteMap.PreferErpSurface(PhpSurfaceLinkMap.AspNetPrimaryHref(href)).Split('?', 2)[0];
        if (string.IsNullOrWhiteSpace(mapped) || mapped == "/")
        {
            return false;
        }

        if (mapped.Equals("/erp", StringComparison.OrdinalIgnoreCase)
            || mapped.Equals("/cp", StringComparison.OrdinalIgnoreCase))
        {
            return _currentPath.Equals(mapped, StringComparison.OrdinalIgnoreCase)
                   || _currentPath.Equals(mapped + "/app", StringComparison.OrdinalIgnoreCase);
        }

        return _currentPath.Equals(mapped, StringComparison.OrdinalIgnoreCase)
               || _currentPath.StartsWith(mapped + "/", StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        var host = Http.HttpContext?.Request.Host.Host;
        _currentPath = Http.HttpContext?.Request.Path.Value ?? "/erp";
        _showBos = SuperCpHostGate.IsAllowed(Http.HttpContext);
        _clientErp = ClientErpPath.IsBound(Http.HttpContext);
        _ctx = ErpHostContext.Resolve(host);
        _industryCode = _ctx.IndustryCode;
        _industryLabel = _ctx.IndustryLabel;

        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            _signedIn = IsAdmin;
            _showControlPanel = true;
            _nav = ErpIndustryNav.FilterTopnav(
                LegacyDesktopChromeCatalog.ErpTopnav(),
                new ErpIndustryNav.ErpNavAudience(
                    "current",
                    _ctx.IndustryCode,
                    null,
                    _showBos && !_clientErp));
            return;
        }

        // ERP-only tenants have no Control Panel surface — never advertise /cp.
        if (ctx.Items[TenantResolutionMiddleware.HttpContextItemKey] is TenantContext tenant)
        {
            _showControlPanel = tenant.Mode is not TenantMode.ErpOnlyTenant;
            if (_showControlPanel && tenant.Mode is TenantMode.DemoTenant)
            {
                // Demo rows keep erp_only_shared alongside is_demo; the registry record is the
                // only place that still says whether the tenant has a Control Panel surface.
                var record = await Registry.FindByHostAsync(tenant.Host, ctx.RequestAborted);
                _showControlPanel = record?.ControlPanelEnabled ?? true;
            }
        }

        var companies = ErpIndustryNav.EnsureSwitchableCompanies(
            (await Dashboards.BuildErpCompaniesDigestAsync(50, ctx.RequestAborted)).Companies,
            _showBos,
            _ctx.BrandLabel);

        var activeQ = ErpHostContext.ActiveCompanyIdFromQuery(ctx.Request);
        var active = companies.FirstOrDefault(c => activeQ is > 0 && c.Id == activeQ)
            ?? companies.FirstOrDefault();
        var countryCode = active?.CountryCode;
        var tenantSiteKey = ctx.Items[TenantResolutionMiddleware.HttpContextItemKey] is TenantContext tenantContext
            ? tenantContext.SiteKey
            : ctx.Request.Host.Host;
        var tenantRules = await NavTenantRules.ResolveAsync(tenantSiteKey, ctx.RequestAborted);
        if (active is not null)
        {
            _activeCompanyId = active.Id;
            _companyLabel = LegalOrganizationLabel.Display(active.Code, active.Name, null, _ctx.BrandLabel);
            _jewellery = ErpIndustryNav.ShowJewelleryModules(_ctx.IndustryCode, active, TenantContext.IndustryFrom(ctx));
            _fitOut = ErpIndustryNav.ShowFitOutModules(_ctx.IndustryCode, active, TenantContext.IndustryFrom(ctx));
            _realEstate = ErpIndustryNav.ShowRealEstateModules(_ctx.IndustryCode, active, TenantContext.IndustryFrom(ctx));
            _industryCode = _jewellery ? "jewellery"
                : _realEstate ? (string.IsNullOrWhiteSpace(active.IndustryPack) ? "real_estate" : active.IndustryPack)
                : _fitOut ? (string.IsNullOrWhiteSpace(active.IndustryPack) ? "fit_out" : active.IndustryPack)
                : (string.IsNullOrWhiteSpace(active.IndustryPack) ? "core" : active.IndustryPack);
            _industryLabel = ErpIndustryNav.IndustryLabelForPack(_industryCode, _jewellery);
        }
        else
        {
            _jewellery = ErpIndustryNav.ShowJewelleryModules(_ctx.IndustryCode, null, TenantContext.IndustryFrom(ctx));
            _fitOut = ErpIndustryNav.ShowFitOutModules(_ctx.IndustryCode, null, TenantContext.IndustryFrom(ctx));
            _realEstate = ErpIndustryNav.ShowRealEstateModules(_ctx.IndustryCode, null, TenantContext.IndustryFrom(ctx));
        }

        _nav = ErpIndustryNav.FilterTopnav(
            LegacyDesktopChromeCatalog.ErpTopnav(),
            new ErpIndustryNav.ErpNavAudience(
                "current",
                _industryCode,
                countryCode,
                _showBos && !_clientErp,
                DisabledTabIds: tenantRules.DisabledTabIds,
                EnabledModuleIds: tenantRules.EnabledModuleIds,
                Company: active));

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _signedIn = session.Kind == LegacySessionKind.Admin || IsAdmin;
        if (_signedIn)
        {
            _userLabel = string.IsNullOrWhiteSpace(session.Email) ? "Admin session" : session.Email!;
            await LoadFavouritesAsync(session.UserId, ctx.RequestAborted);
        }
    }
}
