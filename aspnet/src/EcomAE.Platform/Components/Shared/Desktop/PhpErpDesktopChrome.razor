@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Middleware
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@using EcomAE.Platform.Erp
@inject IHttpContextAccessor Http
@inject IErpShortcutReadService Shortcuts
@inject ILegacySessionValidator Sessions
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject IErpNavTenantRules NavTenantRules
@inject ITenantRegistry Registry
@*
  Mirrors erp_desktop.php + epc_erp_render_top_nav mega chrome.
  Topnav typography/panels come from epc_erp_professional.css (px sizes).
  Click-to-toggle JS mirrors cp/js/epc_erp_shell_nav.js bindTopNav (no hover-open).
  Industry filter: jewellery tabs only when active company pack is jewellery (PHP parity).
  BOS nav is Super-CP only — never advertise /bos on tenant hosts.
  Control panel link is hidden for ERP-only tenants (no CP surface).
*@

@*
  Critical shell CSS is duplicated into the BODY stream. Live SSR drops late HeadContent
  for /erp/* while body chrome survives — without body emission ERP renders unaligned.
*@
<HeadContent>
<meta name="ecomae-erp-chrome-css" content="body-inline" />
<style>
    .epc-erp-cp-shell {
        --epc-erp-primary:#2563eb; --epc-erp-body-bg:#f0f9ff; --epc-blue-900:#0c4a6e; --epc-blue-500:#0ea5e9;
        --ink:#0f172a; --muted:#64748b; --line:#e2e8f0; --bg:#f0f9ff;
        background:var(--bg); color:var(--ink); min-height:100vh;
        font-family: @(LegacyPhpFontAssets.StackFor("erp")); font-size: @(LegacyPhpFontAssets.BaseFontSize);
    }
    .epc-erp-cp-shell a { color:inherit; text-decoration:none; }
    .epc-erp-topbar { background:rgba(255,255,255,.98); border-bottom:1px solid var(--line); position:relative; z-index:80; overflow:visible; }
    .epc-erp-topbar__inner { display:flex; flex-wrap:wrap; gap:.45rem; align-items:center; justify-content:flex-start; padding:.4rem .7rem .4rem .2rem; }
    .epc-erp-topbar__brand { display:flex; flex-direction:row; flex-wrap:nowrap; align-items:center; gap:.35rem; font-weight:800; font-size:15px; margin:0 .1rem 0 0; white-space:nowrap; }
    .epc-erp-topbar__brand img { height:30px; }
    .epc-erp-topbar__nav, .epc-erp-topbar__user { display:flex; gap:.7rem; font-size:13px; font-weight:600; color:#334155; margin-left:auto; }
    /* epc-erp-right-clip: stay inside the viewport — do not size to 100vw then shift. */
    .epc-erp-main { max-width:none; width:100%; min-width:0; padding:0; box-sizing:border-box; }
    .epc-erp-layout { min-width:0; max-width:100%; }
    .epc-erp-content { width:auto; max-width:100%; min-width:0; margin:0; padding:0; font-size:14px; box-sizing:border-box; }
    .epc-erp-topbar__inner, .epc-erp-topnav-inner { width:100%; max-width:none; margin:0; padding-left:.2rem; box-sizing:border-box; }
    .epc-erp-breadcrumb { color:var(--muted); font-size:13px; margin-bottom:.35rem; }
    .epc-erp-breadcrumb .sep { margin:0 .25rem; }
    .epc-erp-content-title { margin:0 0 .35rem; font-size:22px; font-weight:700; }
    .epc-erp-host-sub { margin:0 0 .85rem; color:var(--muted); font-size:13px; font-weight:600; }
    .epc-erp-content-body { min-width:0; max-width:100%; overflow-x:auto; box-sizing:border-box; font-size:14px; }
    .epc-erp-foot { padding:.85rem 1rem; border-top:1px solid var(--line); background:#fff; color:var(--muted); font-size:13px; }
    .epc-erp-global-search__label { color:#64748b !important; }
    .epc-erp-global-search__input { background:#fff !important; color:#0f172a !important; caret-color:#0f172a; -webkit-text-fill-color:#0f172a; }
    .epc-erp-global-search__input::placeholder { color:#64748b !important; opacity:1; -webkit-text-fill-color:#64748b; }
    a.epc-erp-global-search__hit, a.epc-erp-global-search__hit span, a.epc-erp-global-search__hit i { color:#0f172a !important; }
    .epc-erp-global-search__hit small { color:#64748b !important; }
    .epc-erp-cp-shell:has(.ns-dash) .epc-module-visual-frame,
    .epc-erp-cp-shell:has(.ns-dash) .epc-op-context,
    .epc-erp-cp-shell:has(.ns-dash) .epc-dash-repeat,
    .epc-erp-cp-shell[data-epc-dash-home="1"] .epc-module-visual-frame,
    .epc-erp-cp-shell[data-epc-dash-home="1"] .epc-op-context,
    .epc-erp-cp-shell[data-epc-dash-home="1"] .epc-erp-company-scope--panel { display:none !important; }
    .epc-erp-cp-shell[data-epc-dash-home="1"] .epc-erp-content-toolbar { margin-bottom:.15rem; }
    .epc-erp-cp-shell[data-epc-dash-home="1"] .epc-erp-host-sub { margin:0; }
    .epc-erp-cp-shell[data-epc-dash-home="1"] .epc-erp-content-title { margin-bottom:.2rem; }
    .epc-erp-cp-shell[data-epc-dash-home="1"] .epc-erp-content-body { padding-top:.15rem; }
</style>
</HeadContent>
<style>
    .epc-erp-cp-shell {
        --epc-erp-primary:#2563eb; --epc-erp-body-bg:#f0f9ff; --epc-blue-900:#0c4a6e; --epc-blue-500:#0ea5e9;
        --ink:#0f172a; --muted:#64748b; --line:#e2e8f0; --bg:#f0f9ff;
        background:var(--bg); color:var(--ink); min-height:100vh;
        font-family: @(LegacyPhpFontAssets.StackFor("erp")); font-size: @(LegacyPhpFontAssets.BaseFontSize);
    }
    .epc-erp-cp-shell a { color:inherit; text-decoration:none; }
    .epc-erp-topbar { background:rgba(255,255,255,.98); border-bottom:1px solid var(--line); position:relative; z-index:80; overflow:visible; }
    .epc-erp-topbar__inner { display:flex; flex-wrap:wrap; gap:.45rem; align-items:center; justify-content:flex-start; padding:.4rem .7rem .4rem .2rem; }
    .epc-erp-topbar__brand { display:flex; flex-direction:row; flex-wrap:nowrap; align-items:center; gap:.35rem; font-weight:800; font-size:15px; margin:0 .1rem 0 0; white-space:nowrap; }
    .epc-erp-topbar__brand img { height:30px; }
    .epc-erp-topbar__nav, .epc-erp-topbar__user { display:flex; gap:.7rem; font-size:13px; font-weight:600; color:#334155; margin-left:auto; }
    /* epc-erp-right-clip: stay inside the viewport — do not size to 100vw then shift. */
    .epc-erp-main { max-width:none; width:100%; min-width:0; padding:0; box-sizing:border-box; }
    .epc-erp-layout { min-width:0; max-width:100%; }
    .epc-erp-content { width:auto; max-width:100%; min-width:0; margin:0; padding:0; font-size:14px; box-sizing:border-box; }
    .epc-erp-topbar__inner, .epc-erp-topnav-inner { width:100%; max-width:none; margin:0; padding-left:.2rem; box-sizing:border-box; }
    .epc-erp-breadcrumb { color:var(--muted); font-size:13px; margin-bottom:.35rem; }
    .epc-erp-breadcrumb .sep { margin:0 .25rem; }
    .epc-erp-content-title { margin:0 0 .35rem; font-size:22px; font-weight:700; }
    .epc-erp-host-sub { margin:0 0 .85rem; color:var(--muted); font-size:13px; font-weight:600; }
    .epc-erp-content-body { min-width:0; max-width:100%; overflow-x:auto; box-sizing:border-box; font-size:14px; }
    .epc-erp-foot { padding:.85rem 1rem; border-top:1px solid var(--line); background:#fff; color:var(--muted); font-size:13px; }
    .epc-erp-global-search { position:relative; z-index:90; flex:1 1 16rem; max-width:28rem; min-width:12rem; overflow:visible; }
    .epc-erp-global-search__label { position:absolute; left:.7rem; top:50%; transform:translateY(-50%); color:#64748b !important; pointer-events:none; }
    .epc-erp-global-search__input { width:100%; height:2.15rem; padding:.35rem .7rem .35rem 2rem; border:1px solid #cbd5e1; border-radius:.4rem; background:#fff !important; color:#0f172a !important; caret-color:#0f172a; font:inherit; -webkit-text-fill-color:#0f172a; }
    .epc-erp-global-search__input::placeholder { color:#64748b !important; opacity:1; -webkit-text-fill-color:#64748b; }
    .epc-erp-cp-shell:has(.ns-dash) .epc-module-visual-frame,
    .epc-erp-cp-shell:has(.ns-dash) .epc-op-context,
    .epc-erp-cp-shell:has(.ns-dash) .epc-dash-repeat,
    .epc-erp-cp-shell[data-epc-dash-home="1"] .epc-module-visual-frame,
    .epc-erp-cp-shell[data-epc-dash-home="1"] .epc-op-context,
    .epc-erp-cp-shell[data-epc-dash-home="1"] .epc-erp-company-scope--panel { display:none !important; }
    .epc-erp-cp-shell[data-epc-dash-home="1"] .epc-erp-content-toolbar { margin-bottom:.15rem; }
    .epc-erp-cp-shell[data-epc-dash-home="1"] .epc-erp-host-sub { margin:0; }
    .epc-erp-cp-shell[data-epc-dash-home="1"] .epc-erp-content-title { margin-bottom:.2rem; }
    .epc-erp-cp-shell[data-epc-dash-home="1"] .epc-erp-content-body { padding-top:.15rem; }
    .epc-erp-global-search__results { position:fixed; z-index:9000; width:min(36rem, calc(100vw - 16px)); background:#fff; border:1px solid #e2e8f0; border-radius:8px; box-shadow:0 12px 28px rgba(15,23,42,.14); max-height:min(70vh, 28rem); overflow:auto; color:#0f172a; }
    .epc-erp-global-search__hit { display:flex; gap:.55rem; align-items:center; padding:.55rem .7rem; color:#0f172a !important; text-decoration:none; }
    a.epc-erp-global-search__hit, a.epc-erp-global-search__hit span, a.epc-erp-global-search__hit i { color:#0f172a !important; }
    .epc-erp-global-search__hit:hover, .epc-erp-global-search__hit.is-active { background:#eff6ff; }
    .epc-erp-global-search__hit small { color:#64748b !important; margin-left:auto; }
    .epc-erp-fav { position:relative; flex:0 0 auto; }
    .epc-erp-fav__btn { display:inline-flex; align-items:center; gap:.35rem; height:2.15rem; padding:0 .7rem; border:1px solid rgba(255,255,255,.28); border-radius:.4rem; background:rgba(255,255,255,.1); color:#fff; font:inherit; font-weight:700; font-size:13px; cursor:pointer; }
    .epc-erp-fav__btn:hover, .epc-erp-fav__btn[aria-expanded="true"] { background:rgba(255,255,255,.2); }
    .epc-erp-fav__count { display:inline-flex; min-width:1.15rem; justify-content:center; padding:0 .3rem; border-radius:999px; background:rgba(255,255,255,.2); font-size:11px; }
    .epc-erp-fav__panel { position:absolute; left:0; top:calc(100% + 6px); z-index:5200; width:22rem; max-width:min(22rem, calc(100vw - 16px)); max-height:min(70vh, 28rem); overflow:auto; background:#fff; color:#0f172a; border:1px solid #e2e8f0; border-radius:8px; box-shadow:0 12px 28px rgba(15,23,42,.16); padding:.45rem; }
    .epc-erp-fav__filter { width:100%; height:2rem; margin:0 0 .35rem; padding:.3rem .55rem; border:1px solid #cbd5e1; border-radius:6px; font:inherit; color:#0f172a; background:#fff; box-sizing:border-box; }
    .epc-erp-fav__row { display:flex; align-items:center; gap:.2rem; }
    .epc-erp-fav__row a { display:flex; flex:1 1 auto; min-width:0; align-items:center; gap:.45rem; padding:.4rem .5rem; color:#0f172a; text-decoration:none; border-radius:6px; }
    .epc-erp-fav__row a:hover { background:#eff6ff; }
    .epc-erp-fav__row a span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .epc-erp-fav__remove { flex:0 0 auto; margin:0; }
    .epc-erp-fav__remove button { display:inline-flex; width:auto; padding:.35rem .5rem; border:0; background:transparent; color:#94a3b8; border-radius:6px; cursor:pointer; }
    .epc-erp-fav__remove button:hover { background:#fef2f2; color:#b91c1c; }
    .epc-erp-fav__panel > form button { display:flex; width:100%; align-items:center; gap:.45rem; padding:.45rem .55rem; border:0; background:transparent; color:#0f172a; text-align:left; font:inherit; border-radius:6px; cursor:pointer; }
    .epc-erp-fav__panel > form button:hover { background:#eff6ff; }
    .epc-erp-fav__empty { margin:0; padding:.45rem .55rem; color:#64748b; font-size:12px; }
    .epc-erp-fav-pin { display:inline-flex; margin-left:.15rem; }
    .epc-erp-fav-pin button { border:0; background:transparent; color:#94a3b8; padding:0 .15rem; cursor:pointer; }
    .epc-erp-fav-pin button:hover, .epc-erp-fav-pin.is-on button, .epc-erp-fav-pin.is-on { color:#d97706; }
    .epc-erp-content-title .epc-erp-fav-pin { vertical-align:middle; }
    .epc-erp-topnav-links li { display:flex; align-items:center; }
    .epc-erp-topnav-links li > a { flex:1 1 auto; min-width:0; }
</style>

<div class="epc-erp-standalone epc-erp-cp-shell epc-cp-shell epc-cp--blue-theme epc-cp-modern epc-php-font-root"
     data-epc-industry="@_industryCode"
     data-epc-erp-tenant="@_ctx.BrandLabel"
     data-epc-erp-company="@_activeCompanyId"
     data-epc-erp-jewellery="@(_jewellery ? "1" : "0")"
     data-epc-dash-home="@(IsDashboardHome ? "1" : "0")">
    <header class="epc-erp-topbar epc-erp-topbar--cp">
        <div class="epc-erp-topbar__inner">
            <a class="epc-erp-topbar__brand epc-erp-topbar__brand--hub" href="@ErpHomeHref">
                <span class="epc-erp-topbar__brand-mark--animated">
                    <PhpSurfaceHostLogo Surface="erp" Variant="header" ShowLabel="false" />
                </span>
                <span>@_ctx.BrandLabel ERP</span>
            </a>
            @if (_signedIn)
            {
                <div class="epc-erp-fav" data-epc-fav>
                    <button type="button" class="epc-erp-fav__btn" data-epc-fav-toggle aria-expanded="false" aria-haspopup="true">
                        <i class="fa fa-star" aria-hidden="true"></i> Favourites
                        @if (_favs.Count > 0)
                        {
                            <span class="epc-erp-fav__count">@_favs.Count</span>
                        }
                    </button>
                    <div class="epc-erp-fav__panel" hidden data-epc-fav-panel>
                        @if (_favs.Count > 4)
                        {
                            <input type="search" class="epc-erp-fav__filter" data-epc-fav-filter placeholder="Find a favourite" aria-label="Find a favourite" />
                        }
                        @if (_favs.Count == 0)
                        {
                            <p class="epc-erp-fav__empty">Star a module in the menu, or add this page. Open it from this list next time — nothing is added as a tab.</p>
                        }
                        @foreach (var fav in _favs)
                        {
                            <div class="epc-erp-fav__row" data-epc-fav-row="@fav.Label">
                                <a href="@fav.Href" title="@fav.Label"><i class="fa @fav.Icon" aria-hidden="true"></i> <span>@fav.Label</span></a>
                                @if (fav.Id > 0)
                                {
                                    <form class="epc-erp-fav__remove" method="post" action="/erp/ajax/shortcut-delete">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="@FavoriteReturnHref" />
                                        <input type="hidden" name="id" value="@fav.Id" />
                                        <button type="submit" aria-label="Remove @fav.Label from favourites" title="Remove"><i class="fa fa-times" aria-hidden="true"></i></button>
                                    </form>
                                }
                            </div>
                        }
                        @if (!CurrentPageIsFavorite)
                        {
                            <form method="post" action="/erp/ajax/shortcut-add">
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="@FavoriteReturnHref" />
                                <input type="hidden" name="label" value="@Title" />
                                <input type="hidden" name="targetUrl" value="@FavoriteReturnHref" />
                                <input type="hidden" name="surface" value="erp" />
                                <input type="hidden" name="iconClass" value="fa fa-star" />
                                <button type="submit"><i class="fa fa-star-o" aria-hidden="true"></i> Add this page</button>
                            </form>
                        }
                    </div>
                </div>
            }
            <ErpGlobalSearch Jewellery="_jewellery" FitOut="_fitOut" RealEstate="_realEstate" CompanyId="_activeCompanyId" />
            <nav class="epc-erp-topbar__nav epc-erp-topbar__nav--compact" aria-label="ERP topbar">
                <a href="@ErpHomeHref">Dashboard</a>
                <a href="/attention">Attention</a>
                <a href="/erp/guide-app">Guide</a>
                <a href="/erp/approvals-app">Approvals</a>
                @if (IsAdmin)
                {
                    <a href="/erp/navigation-coverage-app">Coverage</a>
                    <a href="/erp/user-control-app">User control</a>
                    <a href="/erp/users-app">Users</a>
                }
                @if (_showControlPanel)
                {
                    <a href="/cp">Control panel</a>
                }
                @if (_showBos && !_clientErp)
                {
                    <a href="/erp/super-mail-app">Mail</a>
                    <a href="/erp/fleet-app">Fleet ERP</a>
                    <a href="/bos">BOS</a>
                }
            </nav>
            <div class="epc-erp-topbar__user">
                <PhpCpTranslate Context="erp" />
                @if (!_signedIn)
                {
                    <a href="/erp/login">Sign in</a>
                }
                else
                {
                    <span title="@_userLabel">@_userLabel</span>
                    <a class="btn btn-default btn-xs" href="@LogoutHref" title="Log out" data-enhance-nav="false" rel="nofollow"><i class="fa fa-sign-out" aria-hidden="true"></i> Logout</a>
                }
                <a href="/erp">ERP workspace</a>
            </div>
        </div>
    </header>

    <main class="epc-erp-main epc-erp-main--cp">
        <div class="epc-erp-shell epc-erp-shell--layout epc-erp-shell--topnav epc-erp-shell--topnav-only">
            <nav class="epc-erp-topnav" id="epc_erp_topnav" aria-label="ERP process areas">
                <div class="epc-erp-topnav-inner">
                    <a class="epc-erp-topnav-brand" href="@ErpHomeHref">
                        <i class="fa fa-cubes" aria-hidden="true"></i><span>@_ctx.BrandLabel</span>
                    </a>
                    <ul class="epc-erp-topnav-list" role="menubar">
                        @foreach (var group in _nav)
                        {
                            var columns = group.Columns ?? Array.Empty<LegacyDesktopChromeCatalog.MegaAreaColumn>();
                            var shortLabel = string.IsNullOrWhiteSpace(group.ShortLabel) ? group.Label : group.ShortLabel;
                            var itemClass = GroupIsActive(group) ? "epc-erp-topnav-item is-active" : "epc-erp-topnav-item";
                            <li class="@itemClass" data-category="@group.Id" role="none">
                                <button type="button"
                                        class="epc-erp-topnav-btn"
                                        role="menuitem"
                                        aria-haspopup="true"
                                        aria-expanded="false"
                                        data-topnav-toggle="@group.Id">
                                    @if (!string.IsNullOrWhiteSpace(group.Icon))
                                    {
                                        <i class="fa @group.Icon" aria-hidden="true"></i>
                                    }
                                    @* PHP erp_nav_areas paints the full category label; CSS swaps to data-short under 1280px. *@
                                    <span class="epc-erp-topnav-label" data-full="@group.Label" data-short="@shortLabel">@group.Label</span>
                                    <i class="fa fa-angle-down epc-erp-topnav-caret" aria-hidden="true"></i>
                                </button>
                                <div class="epc-erp-topnav-panel" role="menu" hidden data-topnav-panel="@group.Id">
                                    <div class="epc-erp-topnav-panel-hd">
                                        <div class="epc-erp-topnav-panel-title">
                                            @if (!string.IsNullOrWhiteSpace(group.Icon))
                                            {
                                                <i class="fa @group.Icon"></i>
                                            }
                                            @group.Label
                                        </div>
                                        <a class="epc-erp-topnav-panel-hub" href="@ModuleHref(group.HubHref ?? group.Links[0].Href)">
                                            Open first module <i class="fa fa-arrow-right"></i>
                                        </a>
                                    </div>
                                    <div class="epc-erp-topnav-cols">
                                        @foreach (var col in columns)
                                        {
                                            <div class="epc-erp-topnav-col">
                                                <div class="epc-erp-topnav-col-hd">
                                                    @if (!string.IsNullOrWhiteSpace(col.Icon))
                                                    {
                                                        <i class="fa @col.Icon"></i>
                                                    }
                                                    @col.Label
                                                </div>
                                                <ul class="epc-erp-topnav-links">
                                                    @foreach (var link in col.Tabs)
                                                    {
                                                        var href = ModuleHref(link.Href);
                                                        var pinned = IsFavoriteHref(href);
                                                        <li class="@(PathIsActive(link.Href) ? "is-active" : null)">
                                                            <a href="@href">
                                                                <i class="fa @(string.IsNullOrWhiteSpace(link.Icon) ? "fa-circle-o" : link.Icon)"></i>
                                                                @link.Label
                                                            </a>
                                                            @if (_signedIn && !pinned)
                                                            {
                                                                <button type="button" class="epc-erp-fav-pin" title="Add to favourites" data-epc-fav-add="1" data-label="@link.Label" data-url="@href" data-icon="@FavIcon(link.Icon)" aria-label="Add @link.Label to favourites"><i class="fa fa-star-o" aria-hidden="true"></i></button>
                                                            }
                                                            else if (_signedIn)
                                                            {
                                                                var pinnedId = FavoriteIdForHref(href);
                                                                if (pinnedId > 0)
                                                                {
                                                                    <button type="button" class="epc-erp-fav-pin is-on" title="Remove from favourites" data-epc-fav-remove="@pinnedId" aria-label="Remove @link.Label from favourites"><i class="fa fa-star" aria-hidden="true"></i></button>
                                                                }
                                                                else
                                                                {
                                                                    <span class="epc-erp-fav-pin is-on" title="In favourites"><i class="fa fa-star" aria-hidden="true"></i></span>
                                                                }
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </nav>

            <div class="epc-erp-layout epc-erp-layout--topnav epc-erp-layout--full">
                <div class="epc-erp-content">
                    <div class="epc-erp-content-toolbar">
                        <div class="epc-erp-content-toolbar-main">
                            <div class="epc-erp-content-header">
                                <nav class="epc-erp-breadcrumb" aria-label="Breadcrumb">
                                    <a href="@ErpHomeHref">ERP</a>
                                    <span class="sep">/</span>
                                    <span>@BreadcrumbArea</span>
                                    <span class="sep">/</span>
                                    <span class="epc-erp-breadcrumb-current">@BreadcrumbTab</span>
                                </nav>
                                <h1 class="epc-erp-content-title">
                                    @Title
                                    @if (_signedIn && !CurrentPageIsFavorite)
                                    {
