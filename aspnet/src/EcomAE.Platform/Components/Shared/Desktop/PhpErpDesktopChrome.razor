<script>
(function () {
  if (window.__epcErpFavBound) return;
  window.__epcErpFavBound = true;
  document.addEventListener('click', function (e) {
    var add = e.target && e.target.closest ? e.target.closest('[data-epc-fav-add]') : null;
    if (add) {
      e.preventDefault();
      var addForm = document.getElementById('epc-fav-add');
      if (!addForm) return;
      addForm.querySelector('[name=label]').value = add.getAttribute('data-label') || '';
      addForm.querySelector('[name=targetUrl]').value = add.getAttribute('data-url') || '';
      addForm.querySelector('[name=iconClass]').value = add.getAttribute('data-icon') || 'fa fa-star';
      addForm.submit();
      return;
    }
    var remove = e.target && e.target.closest ? e.target.closest('[data-epc-fav-remove]') : null;
    if (remove) {
      e.preventDefault();
      var removeForm = document.getElementById('epc-fav-remove');
      if (!removeForm) return;
      removeForm.querySelector('[name=id]').value = remove.getAttribute('data-epc-fav-remove') || '';
      removeForm.submit();
    }
  });
  function closeFav(except) {
    document.querySelectorAll('[data-epc-fav]').forEach(function (root) {
      if (except && root === except) return;
      var btn = root.querySelector('[data-epc-fav-toggle]');
      var panel = root.querySelector('[data-epc-fav-panel]');
      if (btn) btn.setAttribute('aria-expanded', 'false');
      if (panel) panel.hidden = true;
    });
  }
  document.addEventListener('click', function (e) {
    var toggle = e.target && e.target.closest ? e.target.closest('[data-epc-fav-toggle]') : null;
    if (toggle) {
      e.preventDefault();
      e.stopPropagation();
      var root = toggle.closest('[data-epc-fav]');
      var panel = root && root.querySelector('[data-epc-fav-panel]');
      var open = toggle.getAttribute('aria-expanded') === 'true';
      closeFav();
      if (!open && panel) {
        toggle.setAttribute('aria-expanded', 'true');
        panel.hidden = false;
      }
      return;
    }
    if (!e.target.closest || !e.target.closest('[data-epc-fav]')) closeFav();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeFav();
  });
  document.addEventListener('input', function (e) {
    var filter = e.target && e.target.closest ? e.target.closest('[data-epc-fav-filter]') : null;
    if (!filter) return;
    var root = filter.closest('[data-epc-fav]');
    if (!root) return;
    var needle = String(filter.value || '').trim().toLowerCase();
    root.querySelectorAll('[data-epc-fav-row]').forEach(function (row) {
      var label = String(row.getAttribute('data-epc-fav-row') || '').toLowerCase();
      row.hidden = needle.length > 0 && label.indexOf(needle) < 0;
    });
  });
})();
</script>
