@* D365 SalesQuotationListPage + SalesQuotationDetails parity: list grid, header/lines detail, lifecycle, print, CSV. *@
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@using System.Globalization
@using System.Web
@inject IHttpContextAccessor Http
@inject ILegacySessionValidator Sessions
@inject EcomAE.Platform.Cp.ICpCsrfGuard Csrf
@inject IErpWriteConnectionFactory Connections
@inject IErpD365DocCycleService D365

<div class="epc-erp-table-wrap" style="margin-bottom:14px">
    <p style="margin:0 0 .4rem"><strong>All quotations — D365 (SalesQuotationListPage)</strong>
        <a class="btn btn-xs btn-default" href="@Get("/erp/d365/quote-pdf")" target="_blank">print view</a>
    </p>
    <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
        <thead>
            <tr>
                <th>Quotation</th><th>Name</th><th>Account</th><th>Type</th><th>Status</th>
                <th>Currency</th><th>Salesman</th><th>Entity</th><th>Expiry</th><th>Created</th><th></th>
            </tr>
        </thead>
        <tbody>
            @if (_list.Count == 0)
            {
                <tr><td colspan="11">No D365 quotations yet — create below or import the CSV.</td></tr>
            }
            @foreach (var q in _list)
            {
                <tr>
                    <td>@V(q, "quote_no")</td>
                    <td>@V(q, "quote_name")</td>
                    <td>@V(q, "customer_account")</td>
                    <td>@V(q, "quotation_type")</td>
                    <td>@V(q, "status")</td>
                    <td>@V(q, "currency_code")</td>
                    <td>@V(q, "salesman")</td>
                    <td>@V(q, "entity_id")</td>
                    <td>@V(q, "expiry_date")</td>
                    <td>@Fmt(V(q, "time_created"))</td>
                    <td><a class="btn btn-xs btn-primary" href="@Href(q)">Open</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (_open is not null)
{
    <div class="epc-erp-table-wrap" style="margin-bottom:14px">
        <p style="margin:0 0 .5rem"><strong>Quotation @V(_open, "quote_no") — header + lines (SalesQuotationDetails)</strong>
            <a class="btn btn-xs btn-default" href="@Get("/erp/d365/quote-pdf")?id=@V(_open, "id")" target="_blank">Print quotation PDF</a>
            <a class="btn btn-xs btn-default" href="@ListHref">Close</a>
        </p>
        <table class="table table-bordered table-condensed table-epc epc-erp-table">
            <tbody>
                @foreach (var col in ErpD365DocCycleService.QuotationHeaderColumns)
                {
                    <tr><th style="width:220px">@col</th><td>@V(_open, col)</td></tr>
                }
            </tbody>
        </table>
        <p style="margin:.8rem 0 .3rem"><strong>Lines</strong></p>
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr>
                @foreach (var col in ErpD365DocCycleService.QuotationLineColumns)
                {
                    <th>@col</th>
                }
            </tr></thead>
            <tbody>
                @if (_openLines.Count == 0)
                {
                    <tr><td colspan="@ErpD365DocCycleService.QuotationLineColumns.Length">No lines — add below.</td></tr>
                }
                @foreach (var l in _openLines)
                {
                    <tr>
                        @foreach (var col in ErpD365DocCycleService.QuotationLineColumns)
                        {
                            <td>@V(l, col)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        @if (_isAdmin)
        {
            <form method="post" action="@Post("/erp/d365/fields-save")" style="margin-top:10px">
                @Hidden()
                <input type="hidden" name="kind" value="quote_line" />
                <input type="hidden" name="id" value="@V(_open, "id")" />
                <label>Add line — fields <code>name=value</code> per line (variant_id, item_id, product_name, category, quantity, unit, unit_price, discount, tax)</label>
                <textarea name="fields_kv" rows="2" style="width:100%" placeholder="item_id=101&#10;product_name=Brake pad&#10;quantity=2&#10;unit_price=120.00"></textarea>
                <button type="submit" class="btn btn-primary btn-sm">Add line</button>
            </form>
            <form method="post" action="@Post("/erp/d365/quote-status")" style="margin-top:10px;display:flex;gap:8px;align-items:end">
                @Hidden()
                <input type="hidden" name="id" value="@V(_open, "id")" />
                <label>Lifecycle
                    <select name="status">
                        <option value="sent">Sent</option>
                        <option value="confirmed">Confirmed</option>
                        <option value="rejected">Rejected</option>
                        <option value="expired">Expired</option>
                        <option value="cancelled">Cancelled</option>
                    </select>
                </label>
                <button type="submit" class="btn btn-primary btn-sm">Set status</button>
            </form>
        }
    </div>
}

@if (_isAdmin)
{
    <div class="epc-erp-table-wrap" style="margin-bottom:14px">
        <p style="margin:0 0 .4rem"><strong>New quotation — full D365 header fields</strong></p>
        <form method="post" action="@Post("/erp/d365/fields-save")">
            @Hidden()
            <input type="hidden" name="kind" value="quote" />
            <input type="hidden" name="id" value="0" />
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:6px">
                @foreach (var col in ErpD365DocCycleService.QuotationHeaderColumns)
                {
                    <label style="font-size:11px">@col <input name="f_@col" style="width:100%" /></label>
                }
            </div>
            <p class="help-block" style="margin:.5rem 0">Every SalesQuotationDetails header field — blank fields are skipped.</p>
            <button type="submit" class="btn btn-primary btn-sm">Create quotation</button>
        </form>
    </div>
}

<ErpD365CsvArea Area="quotations" Title="Sales quotations" Placeholder="quote_no,customer_name,status,…&#10;QT-1001,Customer,crafted,…" />

@code {
    private bool _isAdmin;
    private string _csrf = "";
    private List<Dictionary<string, string?>> _list = [];
    private Dictionary<string, string?>? _open;
    private List<Dictionary<string, string?>> _openLines = [];
    private long _openId;

    private string ListHref => (Http.HttpContext?.Request.Path.Value ?? "") + "?company=" + (Http.HttpContext?.Request.Query["company"].ToString() ?? "") + "&cmp=" + (Http.HttpContext?.Request.Query["cmp"].ToString() ?? "");

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted).ConfigureAwait(false);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        _csrf = await Csrf.KeyForAsync(ctx, session, ctx.RequestAborted).ConfigureAwait(false);
        _openId = long.TryParse(ctx.Request.Query["d365_quote"], out var qid) ? qid : 0;
        try
        {
            if (Connections.IsConfigured)
            {
                await using var conn = await Connections.OpenAsync(ctx.RequestAborted).ConfigureAwait(false);
                _list = await D365.QuotationsListAsync(conn, 500, ctx.RequestAborted).ConfigureAwait(false);
                if (_openId > 0)
                {
                    var (h, l) = await D365.QuotationAsync(conn, _openId, ctx.RequestAborted).ConfigureAwait(false);
                    _open = h; _openLines = l;
                }
            }
        }
        catch { /* tenant schema best-effort */ }
    }

    private static string V(Dictionary<string, string?> row, string key) => row.TryGetValue(key, out var v) && v is { Length: > 0 } ? v : "—";
    private static string Fmt(string unix) => long.TryParse(unix, out var u) && u > 0 ? DateTimeOffset.FromUnixTimeSeconds(u).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) : "—";
    private string Href(Dictionary<string, string?> q) => ListHref + "&d365_quote=" + V(q, "id");

    private string Post(string path) => ClientErpPath.PrefixIfBound(Http.HttpContext!, path);
    private string Get(string path) => ClientErpPath.PrefixIfBound(Http.HttpContext!, path);

    private MarkupString Hidden()
    {
        var returnUrl = HttpUtility.HtmlAttributeEncode(
            (Http.HttpContext?.Request.Path.Value ?? "") + Http.HttpContext?.Request.QueryString.Value);
        return (MarkupString)(
            "<input type=\"hidden\" name=\"confirmWrites\" value=\"true\" />"
            + $"<input type=\"hidden\" name=\"returnUrl\" value=\"{returnUrl}\" />"
            + $"<input type=\"hidden\" name=\"csrf_guard_key\" value=\"{HttpUtility.HtmlAttributeEncode(_csrf)}\" />");
    }
}
