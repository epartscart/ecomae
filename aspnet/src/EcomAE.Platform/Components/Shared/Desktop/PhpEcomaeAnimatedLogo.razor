@namespace EcomAE.Platform.Components.Shared
@*
  Compact animated ECOM AE mark for Super CP / Super ERP / Super BOS chrome.
  Host-only — never borrow a tenant cart or tenant PNG.
*@
<span class="epc-ecomae-logo @(string.IsNullOrWhiteSpace(Variant) ? "" : $"epc-ecomae-logo--{Variant}")" role="img" aria-label="ECOM AE">
    <svg class="epc-ecomae-logo__mark" viewBox="0 0 96 96" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
        <defs>
            <linearGradient id="@_gradId" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#2a6df4"/>
                <stop offset="1" stop-color="#1a56db"/>
            </linearGradient>
        </defs>
        <rect x="2" y="2" width="92" height="92" rx="22" fill="@($"url(#{_gradId})")"/>
        <rect x="2" y="2" width="92" height="92" rx="22" fill="none" stroke="#ffffff" stroke-opacity="0.18" stroke-width="2"/>
        <path d="M67 38c-4.5-7.2-12.6-12-21.8-12C31.3 26 20 37.3 20 51.2 20 65 31.3 76.3 45.2 76.3c9.2 0 17.3-4.9 21.8-12.2"
              fill="none" stroke="#ffffff" stroke-width="8" stroke-linecap="round"/>
        <path d="M45 51.2h22.5" fill="none" stroke="#ffffff" stroke-width="8" stroke-linecap="round"/>
        <circle class="epc-ecomae-logo__pulse" cx="70" cy="30" r="6.5" fill="#bfe0ff"/>
    </svg>
    @if (ShowWordmark)
    {
        <span class="epc-ecomae-logo__word">ECOM <em>AE</em></span>
    }
</span>

<style>
    .epc-ecomae-logo { display:inline-flex; align-items:center; gap:.45rem; line-height:1; }
    .epc-ecomae-logo__mark { width:32px; height:32px; display:block; flex:0 0 auto; }
    .epc-ecomae-logo--header .epc-ecomae-logo__mark { width:34px; height:34px; }
    .epc-ecomae-logo--compact .epc-ecomae-logo__mark { width:26px; height:26px; }
    .epc-ecomae-logo--dash .epc-ecomae-logo__mark { width:44px; height:44px; }
    .epc-ecomae-logo--dash .epc-ecomae-logo__word { font-size:22px; }
    .epc-ecomae-logo__word { font-weight:800; letter-spacing:.04em; color:#0f172a; font-size:14px; }
    .epc-ecomae-logo__word em { font-style:normal; color:#1a56db; }
    .epc-ecomae-logo__pulse { transform-origin:70px 30px; animation:epc-ecomae-pulse 2.4s ease-in-out infinite; }
    @@keyframes epc-ecomae-pulse {
        0%,100% { opacity:1; }
        50% { opacity:.55; }
    }
</style>

@code {
    /// <summary>header | compact | login</summary>
    [Parameter] public string Variant { get; set; } = "header";
    [Parameter] public bool ShowWordmark { get; set; } = true;

    private readonly string _gradId = "eaG-" + Guid.NewGuid().ToString("N")[..8];
}
