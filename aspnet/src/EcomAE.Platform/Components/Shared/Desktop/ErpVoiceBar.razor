@namespace EcomAE.Platform.Components.Shared

<div class="epc-voice" data-erp-voice data-erp-voice-ajax="@AjaxHref" data-erp-ai-ajax="@ToolsAjaxHref">
    <button type="button" class="epc-voice__btn" data-erp-voice-mic aria-pressed="false">
        <i class="fa fa-microphone" aria-hidden="true"></i> Voice
    </button>
    <div class="epc-voice__panel" hidden data-erp-voice-panel>
        <label class="epc-voice__label" for="epc-voice-text">Speak, or type the same command</label>
        <div class="epc-voice__row">
            <input id="epc-voice-text" type="text" data-erp-voice-text maxlength="400" placeholder="Ask ChatGPT to create a receipt voucher for customer Ahmed for 1500 from the main cash account" />
            <button type="button" class="epc-voice__go" data-erp-voice-go>Prepare</button>
        </div>
        <p class="epc-voice__say" data-erp-voice-say>Try a receipt, a payment, a country sales report, or open any page by name. You can also ask ChatGPT, Cursor, or Devin. Voice fills the form. You press Validate and post.</p>
        <a class="epc-voice__open" data-erp-voice-open hidden>Open the prepared page</a>
        <a class="epc-voice__open" data-erp-voice-external hidden target="_blank" rel="noopener">Open the tool</a>
        <div class="epc-voice__tools">
            <p class="epc-voice__hint">Paste the key from the account you log in to. ChatGPT, Cursor, and Devin each use your own key. The key stays on the server and is not shown again.</p>
            <details class="epc-voice__tool" data-erp-ai-tool="chatgpt">
                <summary>ChatGPT <span data-erp-ai-state>Not connected</span></summary>
                <input type="password" data-erp-ai-token maxlength="512" autocomplete="off" spellcheck="false" placeholder="Key from your ChatGPT account" />
                <input type="text" data-erp-ai-model maxlength="64" autocomplete="off" spellcheck="false" placeholder="Model, optional" />
                <button type="button" data-erp-ai-save>Save</button>
                <button type="button" data-erp-ai-remove>Remove</button>
            </details>
            <details class="epc-voice__tool" data-erp-ai-tool="cursor">
                <summary>Cursor <span data-erp-ai-state>Not connected</span></summary>
                <input type="password" data-erp-ai-token maxlength="512" autocomplete="off" spellcheck="false" placeholder="Key from your Cursor account" />
                <input type="text" data-erp-ai-repo maxlength="300" autocomplete="off" spellcheck="false" placeholder="Repository https address, optional" />
                <button type="button" data-erp-ai-save>Save</button>
                <button type="button" data-erp-ai-remove>Remove</button>
            </details>
            <details class="epc-voice__tool" data-erp-ai-tool="devin">
                <summary>Devin <span data-erp-ai-state>Not connected</span></summary>
                <input type="password" data-erp-ai-token maxlength="512" autocomplete="off" spellcheck="false" placeholder="Key from your Devin account" />
                <input type="text" data-erp-ai-org maxlength="80" autocomplete="off" spellcheck="false" placeholder="Organisation id, if Devin asks for it" />
                <button type="button" data-erp-ai-save>Save</button>
                <button type="button" data-erp-ai-remove>Remove</button>
            </details>
        </div>
    </div>
</div>

<style>
    .epc-voice { position: relative; }
    .epc-voice__btn { border: 1px solid #cbd5e1; background: #fff; border-radius: 999px; padding: .28rem .7rem; font-weight: 700; font-size: 13px; color: #1e3a8a; cursor: pointer; }
    .epc-voice__btn[aria-pressed="true"] { background: #1d4ed8; color: #fff; border-color: #1d4ed8; }
    .epc-voice__panel { position: absolute; top: calc(100% + 6px); left: 0; width: min(480px, 86vw); max-height: 70vh; overflow: auto; background: #fff; border: 1px solid #dbe4ee; border-radius: 12px; box-shadow: 0 16px 40px rgba(15, 23, 42, .18); padding: .75rem; z-index: 10060; }
    .epc-voice__label { display: block; font-size: 12px; font-weight: 700; color: #334155; margin-bottom: .35rem; }
    .epc-voice__row { display: flex; gap: .4rem; }
    .epc-voice__row input { flex: 1; border: 1px solid #cbd5e1; border-radius: 8px; padding: .4rem .55rem; font-size: 13px; }
    .epc-voice__go, .epc-voice__tool button { border: 0; background: #1d4ed8; color: #fff; border-radius: 8px; padding: .4rem .7rem; font-weight: 700; cursor: pointer; }
    .epc-voice__tool button[data-erp-ai-remove] { background: #e2e8f0; color: #1e293b; }
    .epc-voice__say { margin: .55rem 0 0; font-size: 13px; color: #1e293b; line-height: 1.4; }
    .epc-voice__open { display: inline-block; margin-top: .45rem; margin-right: .7rem; font-weight: 700; }
    .epc-voice__tools { margin-top: .7rem; border-top: 1px solid #e2e8f0; padding-top: .55rem; }
    .epc-voice__hint { margin: 0 0 .4rem; font-size: 12px; color: #475569; line-height: 1.4; }
    .epc-voice__tool { margin-top: .35rem; }
    .epc-voice__tool summary { cursor: pointer; font-size: 13px; font-weight: 700; color: #1e3a8a; }
    .epc-voice__tool span { font-weight: 600; color: #64748b; }
    .epc-voice__tool input { display: block; width: 100%; margin-top: .35rem; border: 1px solid #cbd5e1; border-radius: 8px; padding: .35rem .5rem; font-size: 13px; }
    .epc-voice__tool button { margin-top: .4rem; margin-right: .35rem; }
</style>

<script>
    (function () {
        var root = document.querySelector("[data-erp-voice]");
        if (!root || root.getAttribute("data-erp-voice-bound") === "1") return;
        root.setAttribute("data-erp-voice-bound", "1");
        var mic = root.querySelector("[data-erp-voice-mic]");
        var panel = root.querySelector("[data-erp-voice-panel]");
        var input = root.querySelector("[data-erp-voice-text]");
        var go = root.querySelector("[data-erp-voice-go]");
        var say = root.querySelector("[data-erp-voice-say]");
        var open = root.querySelector("[data-erp-voice-open]");
        var external = root.querySelector("[data-erp-voice-external]");
        var ajax = root.getAttribute("data-erp-voice-ajax") || "/erp/ajax/voice-command";
        var toolsAjax = root.getAttribute("data-erp-ai-ajax") || "/erp/ajax/ai-tools";
        var Rec = window.SpeechRecognition || window.webkitSpeechRecognition;
        var hearing = null;
        var statusLoaded = false;

        function show() {
            panel.hidden = false;
            if (!statusLoaded) {
                statusLoaded = true;
                loadStatus();
            }
        }
        mic.addEventListener("click", function () {
            show();
            if (!Rec) {
                say.textContent = "This browser has no speech recognition. Type the command and press Prepare.";
                input.focus();
                return;
            }
            if (hearing) {
                hearing.stop();
                return;
            }
            hearing = new Rec();
            hearing.lang = (navigator.language || "en-GB");
            hearing.interimResults = false;
            hearing.onresult = function (event) {
                var text = "";
                for (var i = 0; i < event.results.length; i++) text += event.results[i][0].transcript + " ";
                input.value = text.trim();
                prepare(input.value);
            };
            hearing.onerror = function () {
                say.textContent = "The microphone did not catch that. Type the command and press Prepare.";
            };
            hearing.onend = function () {
                hearing = null;
                mic.setAttribute("aria-pressed", "false");
            };
            mic.setAttribute("aria-pressed", "true");
            say.textContent = "Listening…";
            hearing.start();
        });
        go.addEventListener("click", function () { prepare(input.value); });
        input.addEventListener("keydown", function (event) {
            if (event.key === "Enter") { event.preventDefault(); prepare(input.value); }
        });
        document.addEventListener("click", function (event) {
            if (!root.contains(event.target)) panel.hidden = true;
        });
        root.querySelectorAll("[data-erp-ai-save]").forEach(function (button) {
            button.addEventListener("click", function () { saveTool(button.closest("[data-erp-ai-tool]")); });
        });
        root.querySelectorAll("[data-erp-ai-remove]").forEach(function (button) {
            button.addEventListener("click", function () { removeTool(button.closest("[data-erp-ai-tool]")); });
        });

        function safeHref(href) {
            if (typeof href !== "string") return "";
            if (href.indexOf("/erp") === 0 || href.indexOf("/cp/client-erp/") === 0) return href;
            return "";
        }

        function safeExternal(href) {
            try {
                var url = new URL(href);
                if (url.protocol !== "https:" || url.username || url.password) return "";
                if (url.hostname === "cursor.com" && url.pathname.indexOf("/agents/") === 0) return url.href;
                if (url.hostname === "app.devin.ai" && url.pathname.indexOf("/sessions/") === 0) return url.href;
                return "";
            } catch (e) {
                return "";
            }
        }

        function paint(body) {
            say.textContent = body.say || body.message || "I could not prepare that.";
            var href = safeHref(body.href);
            if (href) {
                open.hidden = false;
                open.href = href;
                open.textContent = body.ready ? "Open the filled form" : "Open the page";
            } else {
                open.hidden = true;
            }
            var outside = safeExternal(body.externalUrl);
            if (outside) {
                external.hidden = false;
                external.href = outside;
            } else {
                external.hidden = true;
            }
            if (window.speechSynthesis && body.say) {
                window.speechSynthesis.cancel();
                window.speechSynthesis.speak(new SpeechSynthesisUtterance(body.say));
            }
            if (body.ready && href) window.location.assign(href);
        }

        function post(url, payload) {
            return fetch(url, {
                method: "POST",
                credentials: "same-origin",
                headers: { "Content-Type": "application/json", "Accept": "application/json" },
                body: JSON.stringify(payload)
            }).then(function (response) {
                return response.json().then(function (body) { return { ok: response.ok, body: body || {} }; });
            });
        }

        function prepare(text) {
            var spoken = (text || "").trim();
            if (!spoken) {
                say.textContent = "Say or type a command first.";
                show();
                return;
            }
            say.textContent = "Preparing…";
            show();
            post(ajax, { transcript: spoken }).then(function (result) {
                paint(result.body);
            }).catch(function () {
                say.textContent = "The command did not reach the server. Try again.";
            });
        }

        function paintStatus(connected) {
            var list = connected || [];
            root.querySelectorAll("[data-erp-ai-tool]").forEach(function (box) {
                var state = box.querySelector("[data-erp-ai-state]");
                if (!state) return;
                state.textContent = list.indexOf(box.getAttribute("data-erp-ai-tool")) >= 0 ? "Connected" : "Not connected";
            });
        }

        function loadStatus() {
            post(toolsAjax, { action: "status" }).then(function (result) {
                paintStatus(result.body.connected);
            }).catch(function () { statusLoaded = false; });
        }

        function field(box, name) {
            var node = box.querySelector(name);
            return node ? (node.value || "").trim() : "";
        }

        function saveTool(box) {
            if (!box) return;
            say.textContent = "Checking the key…";
            show();
            post(toolsAjax, {
                action: "connect",
                provider: box.getAttribute("data-erp-ai-tool"),
                token: field(box, "[data-erp-ai-token]"),
                model: field(box, "[data-erp-ai-model]"),
                repo: field(box, "[data-erp-ai-repo]"),
                org: field(box, "[data-erp-ai-org]")
            }).then(function (result) {
                var token = box.querySelector("[data-erp-ai-token]");
                if (result.body.ok && token) token.value = "";
                paintStatus(result.body.connected);
                say.textContent = result.body.say || result.body.message || "The key was not saved.";
            }).catch(function () {
                say.textContent = "The key did not reach the server. Try again.";
            });
        }

        function removeTool(box) {
            if (!box) return;
            post(toolsAjax, { action: "disconnect", provider: box.getAttribute("data-erp-ai-tool") }).then(function (result) {
                paintStatus(result.body.connected);
                say.textContent = result.body.say || "The tool was removed.";
            }).catch(function () {
                say.textContent = "The request did not reach the server. Try again.";
            });
        }
    })();
</script>

@code {
    [Parameter] public string AjaxHref { get; set; } = "/erp/ajax/voice-command";

    [Parameter] public string ToolsAjaxHref { get; set; } = "/erp/ajax/ai-tools";
}
