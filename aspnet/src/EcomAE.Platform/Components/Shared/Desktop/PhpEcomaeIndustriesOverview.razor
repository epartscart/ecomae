@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation
@*
  Scaffold of epc_ecomae_platform_page_industries() — hero + full *.ecomae.com industry host grid.
  Marketing grid links use same-host ASP.NET /cp and /erp (not uppercase PHP /CP /ERP).
  ASP.NET preview on www /marketing/industries — same epm chrome tokens as PHP look.
*@

<div class="epm-wrap" id="ehm-industries-overview">
	<div class="epm-hero">
		<img class="epm-hero__img" src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&amp;fit=crop&amp;w=1600&amp;q=75" alt="" loading="lazy" />
		<div class="epm-hero__shade"></div>
		<div class="epm-hero__content">
			<div class="epm-badge">Industry templates</div>
			<h1>Industries we run on ECOM AE</h1>
			<p class="lead">@EcomaeIndustryShowcaseHosts.Count vertical showcase hosts on *.ecomae.com — each with storefront, CP, and ERP chrome.</p>
			<div class="epm-cta">
				<a class="epm-btn epm-btn--primary" href="/marketing/industries">Open full industries</a>
				<a class="epm-btn epm-btn--ghost" href="/marketing/demo">Book @EcomaeMarketingPages.DemoDays-day demo</a>
			</div>
		</div>
	</div>

	<div class="epm-model-cards" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr));">
		@foreach (var host in EcomaeIndustryShowcaseHosts.All)
		{
			<div class="epm-model-card">
				<strong>@host.Title</strong>
				<p style="margin:8px 0 12px;color:var(--epm-muted,#6b7280);font-size:.9rem;">@(host.Slug).ecomae.com — storefront · CP · ERP</p>
				<p style="margin:0;display:flex;flex-wrap:wrap;gap:8px;">
					<a class="epm-btn epm-btn--primary" style="font-size:.8rem;padding:.35rem .7rem;" href="@host.HomeUrl" rel="noopener">Frontend</a>
					<a class="epm-btn epm-btn--ghost" style="font-size:.8rem;padding:.35rem .7rem;" href="@host.CpUrl" rel="noopener">CP</a>
					<a class="epm-btn epm-btn--ghost" style="font-size:.8rem;padding:.35rem .7rem;" href="@host.ErpUrl" rel="noopener">ERP</a>
				</p>
			</div>
		}
	</div>

	<div class="epm-highlight">
		<h3>Browse every vertical</h3>
		<p style="color:var(--epm-muted);margin-bottom:14px">Full industry cards, consolidation groups, and DED activity mapping are available from the linked pages.</p>
		<a class="epm-btn epm-btn--primary" href="/marketing/industries">Browse industries</a>
	</div>
</div>
