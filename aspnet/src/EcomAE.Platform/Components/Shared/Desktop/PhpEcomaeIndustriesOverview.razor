@namespace EcomAE.Platform.Components.Shared
@using EcomAE.Platform.Presentation
@*
  Scaffold of epc_ecomae_platform_page_industries() — hero + vertical teasers.
  Full searchable industry grid / DED mapping remains PHP deeplink until dual-sample.
*@

<div class="epm-wrap" id="ehm-industries-overview">
	<div class="epm-hero">
		<img class="epm-hero__img" src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=800&q=75" alt="" loading="lazy" />
		<div class="epm-hero__shade"></div>
		<div class="epm-hero__content">
			<div class="epm-badge">Industry templates</div>
			<h1>Industries we run on ECOM AE</h1>
			<p class="lead">Automotive parts, jewellery, fashion, electronics, food, healthcare, and more — each with storefront themes, CP modules, and Super CP onboarding packs.</p>
			<div class="epm-cta">
				<a class="epm-btn epm-btn--primary" href="/marketing/industries?php=@(Uri.EscapeDataString(EcomaeMarketingPages.LiveBase + "platform/industries"))">Open full PHP industries (hybrid)</a>
				<a class="epm-btn epm-btn--ghost" href="@(EcomaeMarketingPages.LiveBase)platform/demo">Book @EcomaeMarketingPages.DemoDays-day demo</a>
			</div>
		</div>
	</div>

	<div class="epm-model-cards">
		<div class="epm-model-card">
			<i class="fa fa-car"></i>
			<strong>Automotive</strong>
			<p>Catalog, VIN, supplier feeds, garage — eParts Cart live template.</p>
		</div>
		<div class="epm-model-card">
			<i class="fa fa-diamond"></i>
			<strong>Jewellery &amp; luxury</strong>
			<p>Stock verification, forming, hallmarking workflows.</p>
		</div>
		<div class="epm-model-card">
			<i class="fa fa-shopping-bag"></i>
			<strong>Retail &amp; fashion</strong>
			<p>POS, promotions, multi-warehouse commerce.</p>
		</div>
	</div>

	<div class="epm-highlight">
		<h3>Browse every vertical</h3>
		<p style="color:var(--epm-muted);margin-bottom:14px">Full industry cards, consolidation groups, and DED activity mapping remain on live PHP until dual-sample.</p>
		<a class="epm-btn epm-btn--primary" href="/marketing/industries?php=@(Uri.EscapeDataString(EcomaeMarketingPages.LiveBase + "platform/industries"))">Browse industries</a>
	</div>

	<p style="margin:24px 0 0;font-size:.85rem;color:var(--epm-muted,#b3b3b3)">
		ASP.NET industries overview scaffold — dual-sample against live PHP <code>/platform/industries</code> before exact-route cutover.
		Target: 100% ASP.NET / 0 PHP.
	</p>
</div>
