@namespace EcomAE.Platform.Components.Shared
@*
  Same-to-same storefront homepage depth mirrored from templates/modex + automotive spareparts pro.
  Uses existing PHP class names / CSS hooks — no new brand look. Compare-only scaffold depth.
*@

<section class="epc-sf-home-depth" aria-label="Storefront homepage">
    <div class="container">
        <div class="epc-sf-trust-strip">
            <div class="epc-sf-trust"><i class="fa fa-truck"></i><span>Fast dispatch</span><small>UAE &amp; GCC lanes</small></div>
            <div class="epc-sf-trust"><i class="fa fa-shield"></i><span>Genuine lines</span><small>OEM &amp; aftermarket</small></div>
            <div class="epc-sf-trust"><i class="fa fa-refresh"></i><span>Easy returns</span><small>Clear policy</small></div>
            <div class="epc-sf-trust"><i class="fa fa-headphones"></i><span>Parts desk</span><small>VIN &amp; article help</small></div>
        </div>

        <div class="epc-sf-cat-grid">
            @foreach (var cat in Categories)
            {
                <a class="epc-sf-cat" href="@cat.Href">
                    <i class="fa @cat.Icon"></i>
                    <strong>@cat.Title</strong>
                    <span>@cat.Subtitle</span>
                </a>
            }
        </div>

        <div class="epc-sf-section-head">
            <h2>Popular brands</h2>
            <a href="@BrandsHref">View all</a>
        </div>
        <div class="epc-sf-brand-grid">
            @foreach (var brand in Brands)
            {
                <a class="epc-sf-brand" href="@brand.Href">@brand.Name</a>
            }
        </div>

        <div class="epc-sf-section-head">
            <h2>How search works</h2>
        </div>
        <div class="epc-sf-steps">
            <div class="epc-sf-step"><span>1</span><strong>Enter article / OEM</strong><p>Search by part number, brand, or VIN request.</p></div>
            <div class="epc-sf-step"><span>2</span><strong>Compare offers</strong><p>See availability, delivery window, and clear AED pricing.</p></div>
            <div class="epc-sf-step"><span>3</span><strong>Cart &amp; checkout</strong><p>Confirm how you get parts, then place the order.</p></div>
        </div>

        <div class="epc-sf-promo-row">
            <a class="epc-sf-promo epc-sf-promo--red" href="@SearchHref">
                <strong><i class="fa fa-barcode"></i> Search by part number</strong>
                <span>Browse offers, account, and checkout surfaces.</span>
            </a>
            <a class="epc-sf-promo epc-sf-promo--blue" href="@BrandsHref">
                <strong><i class="fa fa-tags"></i> Trusted brands</strong>
                <span>Browse available manufacturers and product lines.</span>
            </a>
            <a class="epc-sf-promo epc-sf-promo--green" href="@CatalogHref">
                <strong><i class="fa fa-sitemap"></i> Electronic catalog</strong>
                <span>Find parts through vehicle catalog navigation.</span>
            </a>
        </div>

        <div class="epc-sf-help">
            <h3>Need the right part first time?</h3>
            <p>Use article search for OEM numbers, or open the catalog when you know the vehicle. Account tools keep garage vehicles, orders, and profile in one place.</p>
            <div class="epc-sf-help-actions">
                <a class="epc-sf-btn" href="@SearchHref">Start search</a>
                <a class="epc-sf-btn epc-sf-btn--ghost" href="@AccountHref">My account</a>
                <a class="epc-sf-btn epc-sf-btn--ghost" href="@OrdersHref">Orders</a>
            </div>
        </div>
    </div>
</section>

<style>
    .epc-sf-home-depth { margin: 0 0 1.5rem; color: #0f172a; }
    .epc-sf-trust-strip { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.75rem; margin:0 0 1.25rem; }
    .epc-sf-trust { background:#fff; border:1px solid #e2e8f0; border-radius:.65rem; padding:.85rem .9rem; }
    .epc-sf-trust i { color:#dc2626; margin-right:.35rem; }
    .epc-sf-trust span { display:block; font-weight:700; font-size:.92rem; }
    .epc-sf-trust small { color:#64748b; font-size:.78rem; }
    .epc-sf-cat-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.75rem; margin:0 0 1.4rem; }
    .epc-sf-cat { display:block; background:#fff; border:1px solid #e2e8f0; border-radius:.7rem; padding:1rem; text-decoration:none; color:inherit; min-height:7.5rem; }
    .epc-sf-cat i { color:#dc2626; font-size:1.25rem; margin-bottom:.45rem; display:block; }
    .epc-sf-cat strong { display:block; margin-bottom:.25rem; }
    .epc-sf-cat span { color:#64748b; font-size:.82rem; line-height:1.35; }
    .epc-sf-section-head { display:flex; justify-content:space-between; align-items:baseline; gap:1rem; margin:0 0 .75rem; }
    .epc-sf-section-head h2 { margin:0; font-size:1.2rem; }
    .epc-sf-section-head a { color:#dc2626; font-weight:700; font-size:.88rem; text-decoration:none; }
    .epc-sf-brand-grid { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:.55rem; margin:0 0 1.4rem; }
    .epc-sf-brand { display:flex; align-items:center; justify-content:center; min-height:3.2rem; background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; font-weight:700; font-size:.82rem; text-decoration:none; color:#0f172a; }
    .epc-sf-steps { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.75rem; margin:0 0 1.25rem; }
    .epc-sf-step { background:#fff; border:1px solid #e2e8f0; border-radius:.7rem; padding:1rem; }
    .epc-sf-step span { display:inline-flex; width:1.6rem; height:1.6rem; align-items:center; justify-content:center; border-radius:999px; background:#dc2626; color:#fff; font-weight:800; font-size:.8rem; margin-bottom:.45rem; }
    .epc-sf-step p { margin:.35rem 0 0; color:#64748b; font-size:.84rem; line-height:1.4; }
    .epc-sf-promo-row { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.75rem; margin:0 0 1.25rem; }
    .epc-sf-promo { display:block; padding:1.05rem 1rem; border-radius:.7rem; color:#fff; text-decoration:none; min-height:7rem; }
    .epc-sf-promo strong { display:block; margin-bottom:.35rem; }
    .epc-sf-promo span { font-size:.85rem; opacity:.92; line-height:1.35; }
    .epc-sf-promo--red { background:linear-gradient(135deg,#dc2626,#991b1b); }
    .epc-sf-promo--blue { background:linear-gradient(135deg,#2563eb,#1e3a8a); }
    .epc-sf-promo--green { background:linear-gradient(135deg,#059669,#065f46); }
    .epc-sf-help { background:#fff; border:1px solid #e2e8f0; border-radius:.8rem; padding:1.2rem 1.25rem; }
    .epc-sf-help h3 { margin:0 0 .4rem; }
    .epc-sf-help p { margin:0 0 .9rem; color:#475569; max-width:46rem; line-height:1.45; }
    .epc-sf-help-actions { display:flex; flex-wrap:wrap; gap:.5rem; }
    .epc-sf-btn { display:inline-flex; padding:.55rem .9rem; border-radius:.45rem; background:#dc2626; color:#fff; font-weight:700; font-size:.86rem; text-decoration:none; }
    .epc-sf-btn--ghost { background:#fff; color:#0f172a; border:1px solid #cbd5e1; }
    @@media (max-width:980px){
        .epc-sf-trust-strip,.epc-sf-cat-grid,.epc-sf-promo-row,.epc-sf-steps{grid-template-columns:1fr 1fr;}
        .epc-sf-brand-grid{grid-template-columns:repeat(3,minmax(0,1fr));}
    }
    @@media (max-width:640px){
        .epc-sf-trust-strip,.epc-sf-cat-grid,.epc-sf-promo-row,.epc-sf-steps,.epc-sf-brand-grid{grid-template-columns:1fr;}
    }
</style>

@code {
    [Parameter] public string SearchHref { get; set; } = "/storefront/search-app";
    [Parameter] public string BrandsHref { get; set; } = "https://epartscart.com/";
    [Parameter] public string CatalogHref { get; set; } = "https://epartscart.com/";
    [Parameter] public string AccountHref { get; set; } = "/storefront/account-summary-app";
    [Parameter] public string OrdersHref { get; set; } = "/storefront/orders-app";

    private static readonly Cat[] Categories =
    [
        new("fa-cogs", "Engine & filters", "Oil, air, fuel, cabin", "/storefront/search-app"),
        new("fa-car", "Brakes & chassis", "Pads, discs, arms", "/storefront/search-app"),
        new("fa-bolt", "Electrical", "Sensors, batteries, lighting", "/storefront/search-app"),
        new("fa-tint", "Fluids & care", "Oils, chemicals, detailing", "/storefront/search-app"),
        new("fa-snowflake-o", "Cooling & AC", "Radiators, condensers", "/storefront/search-app"),
        new("fa-compass", "Steering", "Racks, pumps, joints", "/storefront/search-app"),
        new("fa-road", "Suspension", "Shocks, springs, mounts", "/storefront/search-app"),
        new("fa-wrench", "Service kits", "Timing, clutch, gasket sets", "/storefront/search-app"),
    ];

    private static readonly Brand[] Brands =
    [
        new("Bosch", "https://epartscart.com/"),
        new("Mann-Filter", "https://epartscart.com/"),
        new("NGK", "https://epartscart.com/"),
        new("Brembo", "https://epartscart.com/"),
        new("Sachs", "https://epartscart.com/"),
        new("Valeo", "https://epartscart.com/"),
        new("Dayco", "https://epartscart.com/"),
        new("Gates", "https://epartscart.com/"),
        new("Mahle", "https://epartscart.com/"),
        new("Febi", "https://epartscart.com/"),
        new("TRW", "https://epartscart.com/"),
        new("Hella", "https://epartscart.com/"),
    ];

    private sealed record Cat(string Icon, string Title, string Subtitle, string Href);
    private sealed record Brand(string Name, string Href);
}
