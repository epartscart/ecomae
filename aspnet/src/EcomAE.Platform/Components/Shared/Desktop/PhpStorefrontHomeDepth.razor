@namespace EcomAE.Platform.Components.Shared
@*
  Same-to-same storefront homepage depth mirrored from templates/nero + automotive spareparts pro.
  Uses existing PHP class names / CSS hooks — no new brand look. Compare-only scaffold depth.
*@

<section class="epc-sf-home-depth" aria-label="Storefront homepage">
    <div class="container">
        <div class="epc-sf-hero-slider" aria-label="Featured promotions">
            <a class="epc-sf-slide epc-sf-slide--1" href="/storefront/search-app">
                <strong>OEM &amp; aftermarket parts</strong>
                <span>Search by part number, VIN, engine, or vehicle</span>
            </a>
            <a class="epc-sf-slide epc-sf-slide--2" href="/storefront/garage-app">
                <strong>Garage Manager</strong>
                <span>Save vehicles and reopen workshop orders</span>
            </a>
            <a class="epc-sf-slide epc-sf-slide--3" href="/storefront/search-app">
                <strong>UAE dispatch lanes</strong>
                <span>Same-day and GCC export windows</span>
            </a>
        </div>

        <div class="epc-sf-trust-strip">
            @foreach (var trust in TrustItems)
            {
                <div class="epc-sf-trust">
                    <i class="fa @trust.Icon"></i>
                    <span>@trust.Title</span>
                    <small>@trust.Subtitle</small>
                </div>
            }
        </div>

        <div class="epc-sf-vin-cta">
            <div class="epc-sf-vin-cta__copy">
                <h2><i class="fa fa-car"></i> VIN &amp; vehicle request</h2>
                <p>Send your VIN or vehicle details when the part number is unknown. Workshop desks identify the correct OEM line, cross-references, and delivery window before you add to cart.</p>
                <div class="epc-sf-vin-cta__actions">
                    <a class="epc-sf-btn" href="@VinHref"><i class="fa fa-paper-plane"></i> Send VIN request</a>
                    <a class="epc-sf-btn epc-sf-btn--ghost" href="@CatalogHref"><i class="fa fa-sitemap"></i> Open vehicle catalog</a>
                </div>
            </div>
            <div class="epc-sf-vin-cta__badges">
                @foreach (var badge in VinBadges)
                {
                    <span class="epc-sf-vin-badge"><i class="fa @badge.Icon"></i> @badge.Label</span>
                }
            </div>
        </div>

        <div class="epc-sf-section-head">
            <h2>Shop by category</h2>
            <a href="@CatalogHref">Full catalog</a>
        </div>
        <div class="epc-sf-cat-grid">
            @foreach (var cat in Categories)
            {
                <a class="epc-sf-cat" href="@cat.Href">
                    <i class="fa @cat.Icon"></i>
                    <strong>@cat.Title</strong>
                    <span>@cat.Subtitle</span>
                </a>
            }
        </div>

        <div class="epc-sf-section-head">
            <h2>Popular vehicle makes</h2>
            <a href="@CatalogHref">Browse by make</a>
        </div>
        <div class="epc-sf-make-grid">
            @foreach (var make in VehicleMakes)
            {
                <a class="epc-sf-make" href="@make.Href">@make.Name</a>
            }
        </div>

        <div class="epc-sf-section-head">
            <h2>Popular brands</h2>
            <a href="@BrandsHref">View all</a>
        </div>
        <div class="epc-sf-brand-grid">
            @foreach (var brand in Brands)
            {
                <a class="epc-sf-brand" href="@brand.Href">@brand.Name</a>
            }
        </div>

        @foreach (var strip in FeaturedStrips)
        {
            <div class="epc-sf-section-head">
                <h2>@strip.Title</h2>
                <a href="@strip.Href">View strip</a>
            </div>
            <div class="epc-sf-featured-strip">
                @foreach (var item in strip.Items)
                {
                    <a class="epc-sf-featured" href="@item.Href">
                        <span class="epc-sf-featured__badge">@item.Badge</span>
                        <strong>@item.Name</strong>
                        <span class="epc-sf-featured__sku">@item.Sku</span>
                        <span class="epc-sf-featured__price">@item.Price</span>
                        <small>@item.Note</small>
                    </a>
                }
            </div>
        }

        <div class="epc-sf-section-head">
            <h2>How search works</h2>
        </div>
        <div class="epc-sf-steps">
            @foreach (var step in Steps)
            {
                <div class="epc-sf-step">
                    <span>@step.Number</span>
                    <strong>@step.Title</strong>
                    <p>@step.Body</p>
                </div>
            }
        </div>

        <div class="epc-sf-promo-row">
            @foreach (var promo in PromoBanners)
            {
                <a class="epc-sf-promo epc-sf-promo--@promo.Tone" href="@promo.Href">
                    <strong><i class="fa @promo.Icon"></i> @promo.Title</strong>
                    <span>@promo.Text</span>
                </a>
            }
        </div>

        <div class="epc-sf-workshop">
            <h3>Built for workshops, garages, and fleet buyers</h3>
            <div class="epc-sf-workshop-grid">
                @foreach (var tip in WorkshopTips)
                {
                    <div class="epc-sf-workshop-card">
                        <i class="fa @tip.Icon"></i>
                        <strong>@tip.Title</strong>
                        <p>@tip.Body</p>
                    </div>
                }
            </div>
        </div>

        <div class="epc-sf-testimonials">
            <h3>What buyers say</h3>
            <div class="epc-sf-testimonial-grid">
                @foreach (var quote in Testimonials)
                {
                    <blockquote class="epc-sf-testimonial">
                        <p>@quote.Text</p>
                        <footer><strong>@quote.Name</strong> · @quote.Role</footer>
                    </blockquote>
                }
            </div>
        </div>

        <div class="epc-sf-faq">
            <h3>Frequently asked questions</h3>
            @foreach (var faq in FaqItems)
            {
                <details class="epc-sf-faq-item">
                    <summary>@faq.Question</summary>
                    <p>@faq.Answer</p>
                </details>
            }
        </div>

        <div class="epc-sf-help">
            <h3>Need the right part first time?</h3>
            <p>Use article search for OEM numbers, or open the catalog when you know the vehicle. Account tools keep garage vehicles, orders, and profile in one place.</p>
            <div class="epc-sf-help-actions">
                <a class="epc-sf-btn" href="@SearchHref">Start search</a>
                <a class="epc-sf-btn epc-sf-btn--ghost" href="@AccountHref">My account</a>
                <a class="epc-sf-btn epc-sf-btn--ghost" href="@OrdersHref">Orders</a>
                <a class="epc-sf-btn epc-sf-btn--ghost" href="@GarageHref">My garage</a>
            </div>
        </div>

        <div class="epc-sf-delivery">
            <h3>Delivery &amp; dispatch lanes</h3>
            <div class="epc-sf-delivery-grid">
                @foreach (var lane in DeliveryLanes)
                {
                    <div class="epc-sf-delivery-card">
                        <strong><i class="fa @lane.Icon"></i> @lane.Region</strong>
                        <span>@lane.Window</span>
                        <small>@lane.Detail</small>
                    </div>
                }
            </div>
        </div>

        <div class="epc-sf-footer-trust">
            <div class="epc-sf-footer-trust__payments">
                @foreach (var pay in PaymentMethods)
                {
                    <span class="epc-sf-pay-badge"><i class="fa @pay.Icon"></i> @pay.Label</span>
                }
            </div>
            <div class="epc-sf-footer-trust__certs">
                @foreach (var cert in TrustCerts)
                {
                    <span class="epc-sf-cert-badge"><i class="fa @cert.Icon"></i> @cert.Label</span>
                }
            </div>
            <p class="epc-sf-store-hours"><i class="fa fa-clock-o"></i> @StoreHours</p>
        </div>
    </div>
</section>

<style>
    .epc-sf-home-depth { margin: 0 0 1.5rem; color: #0f172a; }
    .epc-sf-hero-slider { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.75rem; margin:0 0 1.25rem; }
    .epc-sf-slide { display:block; min-height:9.5rem; border-radius:.85rem; padding:1.2rem 1.25rem; color:#fff; text-decoration:none; background-size:cover; }
    .epc-sf-slide strong { display:block; font-size:1.15rem; margin-bottom:.4rem; }
    .epc-sf-slide span { font-size:.9rem; opacity:.92; line-height:1.4; }
    .epc-sf-slide--1 { background:linear-gradient(135deg,#0b1220 0%,#b91c1c 100%); }
    .epc-sf-slide--2 { background:linear-gradient(135deg,#0f172a 0%,#0369a1 100%); }
    .epc-sf-slide--3 { background:linear-gradient(135deg,#14532d 0%,#0f766e 100%); }
    .epc-sf-trust-strip { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.75rem; margin:0 0 1.25rem; }
    .epc-sf-trust { background:#fff; border:1px solid #e2e8f0; border-radius:.65rem; padding:.85rem .9rem; }
    .epc-sf-trust i { color:#dc2626; margin-right:.35rem; }
    .epc-sf-trust span { display:block; font-weight:700; font-size:.92rem; }
    .epc-sf-trust small { color:#64748b; font-size:.78rem; }
    .epc-sf-vin-cta { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(0,1fr); gap:1rem; margin:0 0 1.4rem; background:linear-gradient(135deg,#0b1220,#1e293b); color:#fff; border-radius:.85rem; padding:1.25rem 1.35rem; }
    .epc-sf-vin-cta h2 { margin:0 0 .5rem; font-size:1.25rem; }
    .epc-sf-vin-cta p { margin:0 0 .85rem; color:rgba(255,255,255,.82); line-height:1.45; font-size:.9rem; }
    .epc-sf-vin-cta__actions { display:flex; flex-wrap:wrap; gap:.5rem; }
    .epc-sf-vin-cta__badges { display:flex; flex-wrap:wrap; gap:.45rem; align-content:flex-start; }
    .epc-sf-vin-badge { display:inline-flex; align-items:center; gap:.35rem; background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.14); border-radius:999px; padding:.4rem .65rem; font-size:.78rem; font-weight:700; }
    .epc-sf-cat-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.75rem; margin:0 0 1.4rem; }
    .epc-sf-cat { display:block; background:#fff; border:1px solid #e2e8f0; border-radius:.7rem; padding:1rem; text-decoration:none; color:inherit; min-height:7.5rem; }
    .epc-sf-cat i { color:#dc2626; font-size:1.25rem; margin-bottom:.45rem; display:block; }
    .epc-sf-cat strong { display:block; margin-bottom:.25rem; }
    .epc-sf-cat span { color:#64748b; font-size:.82rem; line-height:1.35; }
    .epc-sf-make-grid { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:.5rem; margin:0 0 1.4rem; }
    .epc-sf-make { display:flex; align-items:center; justify-content:center; min-height:2.8rem; background:#fff; border:1px solid #e2e8f0; border-radius:.5rem; font-weight:700; font-size:.8rem; text-decoration:none; color:#0f172a; }
    .epc-sf-section-head { display:flex; justify-content:space-between; align-items:baseline; gap:1rem; margin:0 0 .75rem; }
    .epc-sf-section-head h2 { margin:0; font-size:1.2rem; }
    .epc-sf-section-head a { color:#dc2626; font-weight:700; font-size:.88rem; text-decoration:none; }
    .epc-sf-brand-grid { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:.55rem; margin:0 0 1.4rem; }
    .epc-sf-brand { display:flex; align-items:center; justify-content:center; min-height:3.2rem; background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; font-weight:700; font-size:.82rem; text-decoration:none; color:#0f172a; }
    .epc-sf-featured-strip { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin:0 0 1.35rem; }
    .epc-sf-featured { display:block; background:#fff; border:1px solid #e2e8f0; border-radius:.65rem; padding:.85rem .9rem; text-decoration:none; color:inherit; min-height:6.5rem; }
    .epc-sf-featured__badge { display:inline-block; background:#fef2f2; color:#dc2626; font-size:.68rem; font-weight:800; padding:.15rem .45rem; border-radius:999px; margin-bottom:.35rem; }
    .epc-sf-featured strong { display:block; font-size:.88rem; margin-bottom:.2rem; }
    .epc-sf-featured__sku { display:block; color:#64748b; font-size:.75rem; }
    .epc-sf-featured__price { display:block; color:#dc2626; font-weight:800; font-size:.9rem; margin:.25rem 0; }
    .epc-sf-featured small { color:#94a3b8; font-size:.72rem; line-height:1.35; }
    .epc-sf-steps { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.75rem; margin:0 0 1.25rem; }
    .epc-sf-step { background:#fff; border:1px solid #e2e8f0; border-radius:.7rem; padding:1rem; }
    .epc-sf-step span { display:inline-flex; width:1.6rem; height:1.6rem; align-items:center; justify-content:center; border-radius:999px; background:#dc2626; color:#fff; font-weight:800; font-size:.8rem; margin-bottom:.45rem; }
    .epc-sf-step p { margin:.35rem 0 0; color:#64748b; font-size:.84rem; line-height:1.4; }
    .epc-sf-promo-row { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.75rem; margin:0 0 1.25rem; }
    .epc-sf-promo { display:block; padding:1.05rem 1rem; border-radius:.7rem; color:#fff; text-decoration:none; min-height:7rem; }
    .epc-sf-promo strong { display:block; margin-bottom:.35rem; }
    .epc-sf-promo span { font-size:.85rem; opacity:.92; line-height:1.35; }
    .epc-sf-promo--red { background:linear-gradient(135deg,#dc2626,#991b1b); }
    .epc-sf-promo--blue { background:linear-gradient(135deg,#2563eb,#1e3a8a); }
    .epc-sf-promo--green { background:linear-gradient(135deg,#059669,#065f46); }
    .epc-sf-promo--dark { background:linear-gradient(135deg,#0f172a,#334155); }
    .epc-sf-workshop { background:#fff; border:1px solid #e2e8f0; border-radius:.8rem; padding:1.2rem 1.25rem; margin:0 0 1.25rem; }
    .epc-sf-workshop h3 { margin:0 0 .85rem; }
    .epc-sf-workshop-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.75rem; }
    .epc-sf-workshop-card { border:1px solid #e2e8f0; border-radius:.65rem; padding:.9rem; }
    .epc-sf-workshop-card i { color:#dc2626; margin-bottom:.35rem; }
    .epc-sf-workshop-card p { margin:.35rem 0 0; color:#64748b; font-size:.84rem; line-height:1.4; }
    .epc-sf-testimonials { margin:0 0 1.25rem; }
    .epc-sf-testimonials h3 { margin:0 0 .75rem; }
    .epc-sf-testimonial-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.75rem; }
    .epc-sf-testimonial { background:#fff; border:1px solid #e2e8f0; border-radius:.65rem; padding:.9rem 1rem; margin:0; }
    .epc-sf-testimonial p { margin:0 0 .5rem; color:#475569; font-size:.86rem; line-height:1.45; }
    .epc-sf-testimonial footer { font-size:.78rem; color:#64748b; }
    .epc-sf-faq { background:#fff; border:1px solid #e2e8f0; border-radius:.8rem; padding:1.1rem 1.2rem; margin:0 0 1.25rem; }
    .epc-sf-faq h3 { margin:0 0 .75rem; }
    .epc-sf-faq-item { border-bottom:1px solid #e2e8f0; padding:.55rem 0; }
    .epc-sf-faq-item summary { font-weight:700; cursor:pointer; font-size:.9rem; }
    .epc-sf-faq-item p { margin:.45rem 0 0; color:#64748b; font-size:.86rem; line-height:1.45; }
    .epc-sf-help { background:#fff; border:1px solid #e2e8f0; border-radius:.8rem; padding:1.2rem 1.25rem; margin:0 0 1.25rem; }
    .epc-sf-help h3 { margin:0 0 .4rem; }
    .epc-sf-help p { margin:0 0 .9rem; color:#475569; max-width:46rem; line-height:1.45; }
    .epc-sf-help-actions { display:flex; flex-wrap:wrap; gap:.5rem; }
    .epc-sf-delivery { margin:0 0 1.25rem; }
    .epc-sf-delivery h3 { margin:0 0 .75rem; }
    .epc-sf-delivery-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; }
    .epc-sf-delivery-card { background:#fff; border:1px solid #e2e8f0; border-radius:.65rem; padding:.85rem .9rem; }
    .epc-sf-delivery-card span { display:block; color:#dc2626; font-weight:700; font-size:.82rem; margin:.25rem 0; }
    .epc-sf-delivery-card small { color:#64748b; font-size:.76rem; line-height:1.35; }
    .epc-sf-footer-trust { background:#f8fafc; border:1px solid #e2e8f0; border-radius:.8rem; padding:1rem 1.1rem; }
    .epc-sf-footer-trust__payments,.epc-sf-footer-trust__certs { display:flex; flex-wrap:wrap; gap:.45rem; margin-bottom:.65rem; }
    .epc-sf-pay-badge,.epc-sf-cert-badge { display:inline-flex; align-items:center; gap:.3rem; background:#fff; border:1px solid #e2e8f0; border-radius:.45rem; padding:.35rem .55rem; font-size:.76rem; font-weight:700; }
    .epc-sf-store-hours { margin:0; color:#64748b; font-size:.82rem; }
    .epc-sf-btn { display:inline-flex; padding:.55rem .9rem; border-radius:.45rem; background:#dc2626; color:#fff; font-weight:700; font-size:.86rem; text-decoration:none; align-items:center; gap:.35rem; }
    .epc-sf-btn--ghost { background:#fff; color:#0f172a; border:1px solid #cbd5e1; }
  @@media (max-width:980px){
        .epc-sf-hero-slider,.epc-sf-trust-strip,.epc-sf-cat-grid,.epc-sf-promo-row,.epc-sf-steps,.epc-sf-workshop-grid,.epc-sf-testimonial-grid,.epc-sf-delivery-grid,.epc-sf-featured-strip{grid-template-columns:1fr 1fr;}
        .epc-sf-brand-grid,.epc-sf-make-grid{grid-template-columns:repeat(3,minmax(0,1fr));}
        .epc-sf-vin-cta{grid-template-columns:1fr;}
    }
    @@media (max-width:640px){
        .epc-sf-hero-slider,.epc-sf-trust-strip,.epc-sf-cat-grid,.epc-sf-promo-row,.epc-sf-steps,.epc-sf-brand-grid,.epc-sf-make-grid,.epc-sf-workshop-grid,.epc-sf-testimonial-grid,.epc-sf-delivery-grid,.epc-sf-featured-strip{grid-template-columns:1fr;}
    }
</style>

