    private static FeaturedStrip[] BuildFeaturedStrips()
    {
        var strips = new List<FeaturedStrip>();
        var titles = new[] { "Featured filters & service", "Brakes & chassis picks", "Electrical & lighting", "Fluids & workshop essentials" };
        var badges = new[] { "OEM", "Stock", "Deal", "Fleet", "New", "Top" };
        for (var s = 0; s < titles.Length; s++)
        {
            var items = new List<FeaturedItem>();
            for (var i = 1; i <= 12; i++)
            {
                var idx = s * 12 + i;
                items.Add(new FeaturedItem(
                    $"Line {idx} — workshop grade component",
                    $"ASP-{idx:D4}-OEM",
                    $"AED {(idx * 17 + 42):N0}",
                    badges[idx % badges.Length],
                    "Dispatch lane shown on offer · cross-ref available",
                    "/storefront/search-app"));
            }
            strips.Add(new FeaturedStrip(titles[s], "/storefront/search-app", items));
        }
        return strips.ToArray();
    }

