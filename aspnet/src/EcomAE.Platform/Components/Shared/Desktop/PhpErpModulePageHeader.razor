@namespace EcomAE.Platform.Components.Shared
@*
  PHP erp_page_header parity — compact page chrome (not marketing hero).
  Product CTAs stay ASP.NET-primary. PHP reference is a secondary compare link only.
*@
@using EcomAE.Platform.Presentation

<div class="epc-erp-page-hd">
    <div class="epc-erp-page-hd-main">
        <h3 class="epc-erp-page-title">@Title</h3>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="epc-erp-page-sub">@Subtitle</p>
        }
    </div>
    <div class="epc-erp-page-actions">
        @if (!string.IsNullOrWhiteSpace(PhpTabHref))
        {
            <a class="btn btn-sm btn-primary" href="@PhpSurfaceLinkMap.AspNetPrimaryHref(PhpTabHref)">
                <i class="fa fa-refresh" aria-hidden="true"></i> Open module
            </a>
            <a class="btn btn-sm btn-default" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(PhpTabHref)" target="_blank" rel="noopener" title="Open the classic module in a new tab">
                <i class="fa fa-code" aria-hidden="true"></i> Classic twin
            </a>
        }
        @ChildContent
        <a class="btn btn-sm btn-default" href="/erp">ERP workspace</a>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>PHP-shaped /ERP/?… tab href — primary maps to ASP.NET; compare uses /php-reference only.</summary>
    [Parameter] public string? PhpTabHref { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
