@namespace EcomAE.Platform.Components.Shared

<div class="epc-erp-create-card well well-sm epc-erp-section">
    <div class="epc-erp-create-card__hd">
        <i class="fa fa-plus-circle" aria-hidden="true"></i>
        <span>@Title</span>
    </div>
    <div class="epc-erp-create-card__bd">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "New record";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
