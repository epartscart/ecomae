@namespace EcomAE.Platform.Components.Shared
@*
  Shared BOS-parity 3D login atmosphere (grid + particles + glows + slabs).
  ParticlesId must match presentation probes (#epcCpParticles / #erpPortalParticles).
*@

<div class="eel-login__bg eel-scene" aria-hidden="true">
    <div class="eel-login__grid-lines"></div>
    <div class="eel-login__glow eel-login__glow--1"></div>
    <div class="eel-login__glow eel-login__glow--2"></div>
    <div class="eel-login__glow eel-login__glow--3"></div>
    <div class="eel-login__slab eel-login__slab--a"></div>
    <div class="eel-login__slab eel-login__slab--b"></div>
    <div id="@ParticlesId"
         class="eel-login__particles eel-particles @ParticlesExtraClass"
         data-eel-particles="@ParticleCount"
         data-eel-colors="@ColorsCsv"></div>
</div>

<script>
(function () {
  function seed(c) {
    if (!c || c.dataset.eelReady === '1') return;
    c.dataset.eelReady = '1';
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      c.style.display = 'none';
      return;
    }
    var colors = (c.getAttribute('data-eel-colors') || '').split('|').filter(Boolean);
    if (!colors.length) colors = ['rgba(255,255,255,.35)'];
    var n = parseInt(c.getAttribute('data-eel-particles') || '40', 10) || 40;
    var frag = document.createDocumentFragment();
    for (var i = 0; i < n; i++) {
      var d = document.createElement('span');
      var size = 1.3 + Math.random() * 2.8;
      var speed = 8 + Math.random() * 16;
      var color = colors[Math.floor(Math.random() * colors.length)];
      d.className = 'eel-login__particle eel-particle';
      d.style.cssText =
        'width:' + size + 'px;height:' + size + 'px;left:' + (Math.random() * 100) + '%;top:110%;' +
        'background:' + color + ';animation-duration:' + speed + 's;animation-delay:' + (-(Math.random() * speed)) + 's;' +
        'opacity:' + (0.28 + Math.random() * 0.5) + ';';
      frag.appendChild(d);
    }
    c.appendChild(frag);
  }
  document.querySelectorAll('.eel-particles[data-eel-particles]').forEach(seed);
})();
</script>

@code {
    [Parameter] public string ParticlesId { get; set; } = "epcCpParticles";
    [Parameter] public string ParticlesExtraClass { get; set; } = "";
    [Parameter] public int ParticleCount { get; set; } = 48;
    [Parameter] public string[] ParticleColors { get; set; } =
    [
        "rgba(251,113,133,.55)",
        "rgba(255,255,255,.28)",
        "rgba(244,63,94,.4)"
    ];

    private string ColorsCsv => string.Join('|', ParticleColors);
}
