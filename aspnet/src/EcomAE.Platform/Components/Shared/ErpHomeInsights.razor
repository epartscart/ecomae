@using System.Globalization

<section class="epc-qb-insights" aria-label="Company insights">
    <article class="epc-qb-widget">
        <header>Income and expense trend <a href="@Href("/erp/report-center-app")">Open reports</a></header>
        <div class="epc-qb-bars" aria-label="Income and expense by period">
            @for (var i = 0; i < Bars; i++)
            {
                var income = i < TrendRevenue.Count ? TrendRevenue[i] : 0;
                var profit = i < TrendProfit.Count ? TrendProfit[i] : 0;
                var expense = income - profit;
                if (expense < 0) expense = 0;
                <div class="epc-qb-bar">
                    <span class="in" style="height:@Pct(income, Peak)%" title="Income"></span>
                    <span class="ex" style="height:@Pct(expense, Peak)%" title="Expense"></span>
                    <em>@(i < TrendLabels.Count ? TrendLabels[i] : "")</em>
                </div>
            }
        </div>
        <p class="epc-qb-legend"><i class="in"></i> Income <i class="ex"></i> Expense</p>
    </article>

    <article class="epc-qb-widget">
        <header>Previous year income <a href="@Href("/erp/accounts-summary-app")">View</a></header>
        <div class="epc-qb-compare">
            <div><span style="height:@Pct(PreviousRevenue, ComparePeak)%"></span><em>Prior</em><strong>@Money(PreviousRevenue)</strong></div>
            <div class="now"><span style="height:@Pct(Revenue, ComparePeak)%"></span><em>This year</em><strong>@Money(Revenue)</strong></div>
        </div>
    </article>

    <article class="epc-qb-widget">
        <header>Who owes money <a href="@Href("/erp/aging-app")">Receive payments</a></header>
        <p class="epc-qb-big">@Money(Receivables)</p>
        <p>@InvoicesDue.ToString("N0", CultureInfo.InvariantCulture) invoices with a balance. @OverdueInvoices.ToString("N0", CultureInfo.InvariantCulture) are overdue.</p>
        <a class="epc-qb-go" href="@Href("/erp/receivables-app")">Open receivables</a>
    </article>

    <article class="epc-qb-widget">
        <header>Account balances <a href="@Href("/erp/coa-accounts-app")">Chart of accounts</a></header>
        <table>
            <tbody>
                <tr><td>Cash</td><td>@Money(Cash)</td></tr>
                <tr><td>Accounts receivable</td><td>@Money(Receivables)</td></tr>
                <tr><td>Accounts payable</td><td>@Money(Payables)</td></tr>
                <tr><td>Stock</td><td>@Money(Stock)</td></tr>
                <tr><td>VAT net</td><td>@Money(Vat)</td></tr>
                <tr><td>Profit</td><td>@Money(Profit)</td></tr>
            </tbody>
        </table>
    </article>

    <article class="epc-qb-widget">
        <header>Expense breakdown <a href="@Href("/erp/purchases-app")">Purchases</a></header>
        <div class="epc-qb-pie" style="background:@Pie" aria-label="Expense mix"></div>
        <ul class="epc-qb-slices">
            <li><i style="background:#b91c1c"></i> Purchases @Money(Expense)</li>
            <li><i style="background:#f97316"></i> Payables still open @Money(Payables)</li>
            <li><i style="background:#facc15"></i> Stock on hand @Money(Stock)</li>
        </ul>
    </article>

    <article class="epc-qb-widget">
        <header>Previous year expense <a href="@Href("/erp/payables-app")">Payables</a></header>
        <div class="epc-qb-compare">
            <div class="exp"><span style="height:@Pct(PreviousExpense, ExpensePeak)%"></span><em>Prior</em><strong>@Money(PreviousExpense)</strong></div>
            <div class="exp now"><span style="height:@Pct(Expense, ExpensePeak)%"></span><em>This year</em><strong>@Money(Expense)</strong></div>
        </div>
    </article>

    <article class="epc-qb-widget">
        <header>Quick links</header>
        <div class="epc-qb-links">
            <a href="@Href("/erp/receivables-app")"><i class="fa fa-money"></i> Receive payment</a>
            <a href="@Href("/erp/invoices-app")"><i class="fa fa-file-text-o"></i> Create invoice</a>
            <a href="@Href("/erp/invoices-app")"><i class="fa fa-undo"></i> Credits and refunds</a>
            <a href="@Href("/erp/product-info-app")"><i class="fa fa-barcode"></i> New inventory part</a>
        </div>
    </article>

    <article class="epc-qb-widget">
        <header>Invoice payment status <a href="@Href("/erp/invoices-app")">Invoices</a></header>
        <p class="epc-qb-big">@Money(Receivables)</p>
        <p>Open balance on the customer side. Paid work this period is inside income @Money(Revenue).</p>
    </article>

    <article class="epc-qb-widget epc-qb-widget--wide">
        <header>Receivables snapshot <a href="@Href("/erp/receivables-app")">Customers</a></header>
        <dl class="epc-qb-facts">
            <div><dt>Open balance</dt><dd>@Money(Receivables)</dd></div>
            <div><dt>Invoices due</dt><dd>@InvoicesDue.ToString("N0", CultureInfo.InvariantCulture)</dd></div>
            <div><dt>Overdue</dt><dd>@OverdueInvoices.ToString("N0", CultureInfo.InvariantCulture)</dd></div>
            <div><dt>Sales this period</dt><dd>@Money(Revenue)</dd></div>
            <div><dt>Sales prior period</dt><dd>@Money(PreviousRevenue)</dd></div>
        </dl>
        <p><a href="@Href("/erp/aging-app")">Open ageing and statements</a> · <a href="@Href("/erp/receivables-app")">Settle an invoice</a></p>
    </article>
</section>

<style>
    .epc-qb-insights { display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:12px; margin:0 0 16px; }
    .epc-qb-widget { background:#fff; border:1px solid #d5deea; border-radius:8px; padding:10px 12px 12px; min-height:180px; }
    .epc-qb-widget--wide { grid-column:1 / -1; }
    .epc-qb-widget header { display:flex; justify-content:space-between; gap:8px; font-weight:700; color:#334155; margin-bottom:8px; }
    .epc-qb-widget header a, .epc-qb-go { font-weight:600; font-size:12px; }
    .epc-qb-bars { display:flex; align-items:flex-end; gap:6px; height:120px; }
    .epc-qb-bar { flex:1; display:flex; align-items:flex-end; justify-content:center; gap:2px; height:100%; position:relative; }
    .epc-qb-bar span { width:8px; min-height:2px; border-radius:2px 2px 0 0; }
    .epc-qb-bar span.in, .epc-qb-legend i.in { background:#16a34a; }
    .epc-qb-bar span.ex, .epc-qb-legend i.ex { background:#f97316; }
    .epc-qb-bar em { position:absolute; bottom:-16px; font-style:normal; font-size:10px; color:#64748b; }
    .epc-qb-legend { margin:18px 0 0; font-size:12px; color:#475569; }
    .epc-qb-legend i { display:inline-block; width:10px; height:10px; margin-right:4px; }
    .epc-qb-compare { display:flex; align-items:flex-end; gap:18px; height:130px; }
    .epc-qb-compare div { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%; }
    .epc-qb-compare span { width:36px; background:#86efac; border-radius:3px 3px 0 0; min-height:4px; }
    .epc-qb-compare .now span { background:#16a34a; }
    .epc-qb-compare .exp span { background:#fdba74; }
    .epc-qb-compare .exp.now span { background:#ea580c; }
    .epc-qb-compare em, .epc-qb-compare strong { font-size:11px; font-style:normal; }
    .epc-qb-big { font-size:22px; font-weight:700; margin:0 0 6px; }
    .epc-qb-widget table { width:100%; font-size:13px; }
    .epc-qb-widget td:last-child { text-align:right; font-variant-numeric:tabular-nums; }
    .epc-qb-pie { width:120px; height:120px; border-radius:50%; margin:8px auto; }
    .epc-qb-slices { list-style:none; padding:0; margin:8px 0 0; font-size:12px; }
    .epc-qb-slices i { display:inline-block; width:10px; height:10px; margin-right:6px; }
    .epc-qb-links { display:flex; flex-direction:column; gap:8px; }
    .epc-qb-links a { text-decoration:none; }
    .epc-qb-facts { display:grid; grid-template-columns:repeat(5, minmax(0,1fr)); gap:8px; margin:0 0 8px; }
    .epc-qb-facts dt { font-size:11px; color:#64748b; }
    .epc-qb-facts dd { margin:0; font-weight:700; }
    @@media (max-width: 1100px) {
        .epc-qb-insights { grid-template-columns:1fr; }
        .epc-qb-facts { grid-template-columns:1fr 1fr; }
    }
</style>

@code {
    [Parameter] public long CompanyId { get; set; }
    [Parameter] public decimal Revenue { get; set; }
    [Parameter] public decimal PreviousRevenue { get; set; }
    [Parameter] public decimal Expense { get; set; }
    [Parameter] public decimal PreviousExpense { get; set; }
    [Parameter] public decimal Profit { get; set; }
    [Parameter] public decimal Receivables { get; set; }
    [Parameter] public decimal Payables { get; set; }
    [Parameter] public decimal Cash { get; set; }
    [Parameter] public decimal Stock { get; set; }
    [Parameter] public decimal Vat { get; set; }
    [Parameter] public int InvoicesDue { get; set; }
    [Parameter] public int OverdueInvoices { get; set; }
    [Parameter] public IReadOnlyList<string> TrendLabels { get; set; } = [];
    [Parameter] public IReadOnlyList<decimal> TrendRevenue { get; set; } = [];
    [Parameter] public IReadOnlyList<decimal> TrendProfit { get; set; } = [];

    private int Bars => Math.Max(TrendLabels.Count, 1);

    private decimal Peak
    {
        get
        {
            decimal peak = 1;
            for (var i = 0; i < TrendRevenue.Count; i++)
            {
                var income = TrendRevenue[i];
                var profit = i < TrendProfit.Count ? TrendProfit[i] : 0;
                var expense = income - profit;
                if (income > peak) peak = income;
                if (expense > peak) peak = expense;
            }

            return peak;
        }
    }

    private decimal ComparePeak => Math.Max(1, Math.Max(Revenue, PreviousRevenue));
    private decimal ExpensePeak => Math.Max(1, Math.Max(Expense, PreviousExpense));

    private string Pie
    {
        get
        {
            var total = Expense + Payables + Stock;
            if (total <= 0)
            {
                return "#e2e8f0";
            }

            var a = Expense / total * 100m;
            var b = Payables / total * 100m;
            return "conic-gradient(#b91c1c 0 " + a.ToString("0.##", CultureInfo.InvariantCulture)
                + "%, #f97316 0 " + (a + b).ToString("0.##", CultureInfo.InvariantCulture)
                + "%, #facc15 0 100%)";
        }
    }

    private static int Pct(decimal value, decimal peak)
    {
        if (peak <= 0 || value <= 0) return 2;
        var n = (int)Math.Round(value / peak * 100m, MidpointRounding.AwayFromZero);
        return Math.Clamp(n, 4, 100);
    }

    private static string Money(decimal value) => value.ToString("N2", CultureInfo.InvariantCulture);

    private string Href(string path)
        => CompanyId <= 0
            ? path
            : path + "?company=" + CompanyId.ToString(CultureInfo.InvariantCulture);
}
