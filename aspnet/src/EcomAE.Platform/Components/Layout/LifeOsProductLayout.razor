@inherits LayoutComponentBase
@using EcomAE.Platform.LifeOs.Clients
@using EcomAE.Platform.Presentation
@*
  LifeOS product layout: shared editorial chrome + footer.
  Page-local CSS may still exist; product CSS sets the law.
*@
@layout Layout.PhpChromeLayout

<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<link rel="stylesheet" href="@ProductCssHref" />

<div class="lo-product-shell">
  <LifeOsSiteChrome ActiveKey="@ActiveChromeKey" />
  @Body
  <LifeOsSiteFooter />
</div>

@code {
    /// <summary>Optional: pages can set via cascading — default home-aware from path is not available here, so home is default.</summary>
    [Parameter] public string ActiveChromeKey { get; set; } = "home";

    private const string ProductCssHref = "/lifeos/lifeos-product.css?v=20260807a";
}
