@page "/storefront/cart-app"
@page "/en/shop/cart"
@page "/shop/cart"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IStorefrontGuestSessionService Guests
@inject IHttpContextAccessor Http

<PageTitle>Cart · @_brand</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        #cart_area .table th,
        #cart_area .table td { vertical-align:middle; white-space:nowrap; }
        #cart_area .table input[type="checkbox"] { width:25px; height:25px; }
        #cart_area .cart_table button.linkish {
            color:#b91c1c; font-weight:700; text-decoration:none; background:none; border:0; cursor:pointer; padding:0; font-size:.82rem;
        }
        #cart_area .cart_qty { width:4.2rem; padding:.25rem .35rem; border:1px solid #cbd5e1; }
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontTenantChrome>

    <PhpStorefrontPageHeader Title="Cart"
                            Subtitle="Lines in your cart. Quantity and checkout stay on this storefront.">
        <a class="btn btn-sm btn-primary" href="@StorefrontSurfaceLinks.Checkout">Checkout</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.PartSearch">Continue shopping</a>
    </PhpStorefrontPageHeader>

    <div id="cart_area">
    @if (!_hasShopper)
    {
        <div class="epc-cart-login-gate">
            <h2>Sign in to use your cart</h2>
            <p>Please log in or register to continue.</p>
            <p>Prices, checkout, quotes, and WhatsApp ordering are available after you log in or register.</p>
            <div class="epc-commerce-login-cta">
                <a class="btn btn-sm btn-primary" href="/storefront/login?returnUrl=/storefront/cart-app">Log in</a>
                <span class="epc-commerce-login-cta__sep">or</span>
                <a class="btn btn-sm btn-default" href="/storefront/register-app">Register</a>
                <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.CheckoutLoginOffer">Login offer</a>
            </div>
        </div>
    }
    else if (_lines.Count == 0)
    {
        <p>Your cart is empty.</p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_flash))
        {
            <div class="alert @(_flashOk ? "alert-success" : "alert-warning")">@_flash</div>
        }

        <div style="overflow: hidden; overflow-x: auto;">
            <table class="table cart_table">
                <thead>
                    <tr>
                        <th></th>
                        <th>Brand</th>
                        <th>Article</th>
                        <th>Name</th>
                        <th>Qty</th>
                        <th>Price</th>
                        <th>Line</th>
                        <th>ETA</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in _lines)
                    {
                        var lineTotal = line.Price * line.CountNeed;
                        <tr>
                            <td>
                                <form method="post" action="/storefront/cart/check-for-order" style="margin:0">
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="/storefront/cart-app" />
                                    <input type="hidden" name="id" value="@line.Id.ToString(CultureInfo.InvariantCulture)" />
                                    <input type="hidden" name="checked" value="@(line.CheckedForOrder ? "0" : "1")" />
                                    <input type="checkbox" @(line.CheckedForOrder ? "checked" : null) onclick="this.form.submit()" />
                                </form>
                            </td>
                            <td><strong>@(string.IsNullOrWhiteSpace(line.Manufacturer) ? "—" : line.Manufacturer)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(line.Article) ? "—" : line.Article)</td>
                            <td>@(string.IsNullOrWhiteSpace(line.Name) ? "—" : line.Name)</td>
                            <td>
                                <form method="post" action="/storefront/cart/change-count-need" style="display:flex;gap:.3rem;align-items:center;margin:0">
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="/storefront/cart-app" />
                                    <input type="hidden" name="id" value="@line.Id.ToString(CultureInfo.InvariantCulture)" />
                                    <input class="cart_qty" type="number" min="1" step="1" name="countNeed"
                                           value="@line.CountNeed.ToString("0.###", CultureInfo.InvariantCulture)" />
                                    <button class="linkish" type="submit">Update</button>
                                </form>
                            </td>
                            <td>@line.Price.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@lineTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(line.TimeToExe) ? "—" : line.TimeToExe)</td>
                            <td>
                                <form method="post" action="/storefront/cart/delete" style="display:inline;margin:0">
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="/storefront/cart-app" />
                                    <input type="hidden" name="id" value="@line.Id.ToString(CultureInfo.InvariantCulture)" />
                                    <button class="linkish" type="submit">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="cart-note">
            Add to cart is live on ASP.NET. Quantity, check, and delete write here. Continue to checkout when you are ready.
            @if (!_isCustomer)
            {
                <span> Guest cart uses your session cookie; checkout asks for a phone number.</span>
            }
        </p>
    }
    </div>

</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private bool _isCustomer;
    private bool _hasShopper;
    private StorefrontCartSummary _summary = new(0, 0m, "n/a", "");
    private IReadOnlyList<StorefrontCartLineDigest> _lines = [];
    private string _flash = "";
    private bool _flashOk;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);

        // Prefer storefront customer cookies (PHP DP_User) even if admin cookies are also set.
        var session = await Sessions.ValidateCustomerAsync(ctx, ctx.RequestAborted);
        var shopper = session.Kind == LegacySessionKind.Customer && session.UserId > 0
            ? new StorefrontShopper(session.UserId, 0, session.SessionId ?? "", false)
            : await Guests.ResolveAsync(ctx, createIfMissing: true, ctx.RequestAborted);
        if (!shopper.IsSignedIn)
        {
            Guests.ApplyGuestCookies(ctx.Response, shopper);
        }

        if (!shopper.CanShop)
        {
            _isCustomer = false;
            _hasShopper = false;
            return;
        }

        _isCustomer = shopper.IsSignedIn;
        _hasShopper = true;
        var ok = ctx.Request.Query["ok"].ToString();
        var err = ctx.Request.Query["err"].ToString();
        if (!string.IsNullOrWhiteSpace(ok))
        {
            _flash = ok;
            _flashOk = true;
        }
        else if (!string.IsNullOrWhiteSpace(err))
        {
            _flash = err;
            _flashOk = false;
        }

        var result = await Dashboards.ListStorefrontCartAsync(shopper.UserId, 100, ctx.RequestAborted, shopper.SessionRecordId);
        _summary = result.Summary;
        _lines = result.Lines;
    }
}
