@page "/storefront/cart-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Cart · eParts Cart</PageTitle>
<PhpChromeStyles Surface="storefront" />
<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<PhpStorefrontDesktopChrome>
    <style>
        .epc-sf-cart-hero {
            margin-bottom:1rem; padding:1.15rem 1.25rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0f172a 0%,#1e293b 45%,#7f1d1d 100%);
        }
        .epc-sf-cart-hero h1 { margin:.2rem 0 .35rem; font-size:clamp(1.4rem,3vw,1.95rem); }
        .epc-sf-cart-hero p { margin:0; color:#fecaca; max-width:40rem; font-size:.92rem; line-height:1.45; }
        .epc-sf-cart-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-sf-cart-cta a {
            display:inline-flex; padding:.5rem .85rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#fff; background:#dc2626;
        }
        .epc-sf-cart-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); }
        .epc-sf-cart-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-sf-cart-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-sf-cart-kpi strong { display:block; font-size:1.35rem; font-variant-numeric:tabular-nums; }
        .epc-sf-cart-kpi span { color:#64748b; font-size:.78rem; }
        .epc-sf-cart-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-sf-cart-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-sf-cart-table th, .epc-sf-cart-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-sf-cart-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-sf-cart-table a { color:#b91c1c; font-weight:700; text-decoration:none; }
        .epc-sf-cart-badge { display:inline-flex; padding:.15rem .45rem; border-radius:.3rem; font-size:.72rem; font-weight:700; background:#fee2e2; color:#991b1b; }
        .epc-sf-cart-badge--ok { background:#dcfce7; color:#166534; }
        .epc-sf-cart-note { margin-top:1rem; padding:.75rem .9rem; background:#fff8e8; border:1px solid #f1d49a; border-radius:.45rem; color:#7a4e00; font-size:.86rem; }
        .epc-sf-cart-gate { padding:1.25rem; background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; }
        @@media (max-width:900px){ .epc-sf-cart-kpis{grid-template-columns:1fr;} }
    </style>

    <section class="epc-sf-cart-hero">
        <img src="@LegacyPresentationAssets.EpartsCartMarkUrl" alt="eparts" style="height:28px;filter:brightness(1.1)" />
        <h1>Cart</h1>
        <p>Lines in your cart ready for checkout.</p>
        <div class="epc-sf-cart-cta">
            <a href="https://epartscart.com/shop/cart">Open module</a>
            <a class="ghost" href="https://epartscart.com/shop/checkout/how_get">Checkout</a>
            <a class="ghost" href="/storefront/search-app">Search parts</a>
            <a class="ghost" href="/storefront/login">Customer login</a>
        </div>
    </section>

    @if (!_isCustomer)
    {
        <div class="epc-sf-cart-gate">
            <p style="margin:0 0 .75rem;color:#334155">Sign in with your store account to load your cart lines.</p>
            <a href="/storefront/login" style="display:inline-flex;padding:.55rem .9rem;border-radius:.4rem;background:#dc2626;color:#fff;font-weight:700;text-decoration:none">Sign in</a>
            <a href="https://epartscart.com/shop/checkout/login_offer" style="display:inline-flex;margin-left:.45rem;padding:.55rem .9rem;border-radius:.4rem;border:1px solid #d1d5db;color:#111;font-weight:700;text-decoration:none">Login offer</a>
        </div>
    }
    else
    {
        <div class="epc-sf-cart-kpis" aria-label="Cart KPIs">
            <div class="epc-sf-cart-kpi"><strong>@_summary.Count</strong><span>Lines in cart</span></div>
            <div class="epc-sf-cart-kpi"><strong>@_summary.Sum.ToString("N2", CultureInfo.InvariantCulture)</strong><span>Cart sum</span></div>
</div>

        <div class="epc-sf-cart-table-wrap">
            <table class="epc-sf-cart-table">
                <thead>
                    <tr>
                        <th>Brand</th>
                        <th>Article</th>
                        <th>Name</th>
                        <th>Qty</th>
                        <th>Price</th>
                        <th>Line</th>
                        <th>ETA</th>
                        <th>Checked</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_lines.Count == 0)
                    {
                        <tr><td colspan="9">Your cart is empty.</td></tr>
                    }
                    else
                    {
                        @foreach (var line in _lines)
                        {
                            var lineTotal = line.Price * line.CountNeed;
                            <tr>
                                <td><strong>@(string.IsNullOrWhiteSpace(line.Manufacturer) ? "—" : line.Manufacturer)</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(line.Article) ? "—" : line.Article)</td>
                                <td>@(string.IsNullOrWhiteSpace(line.Name) ? "—" : line.Name)</td>
                                <td>@line.CountNeed.ToString("0.###", CultureInfo.InvariantCulture)</td>
                                <td>@line.Price.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@lineTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@(string.IsNullOrWhiteSpace(line.TimeToExe) ? "—" : line.TimeToExe)</td>
                                <td>
                                    @if (line.CheckedForOrder)
                                    {
                                        <span class="epc-sf-cart-badge epc-sf-cart-badge--ok">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="epc-sf-cart-badge">No</span>
                                    }
                                </td>
                                <td><a href="https://epartscart.com/shop/cart">Open</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

</PhpStorefrontDesktopChrome>

@code {
    private bool _isCustomer;
    private StorefrontCartSummary _summary = new(0, 0m, "n/a", "");
    private IReadOnlyList<StorefrontCartLineDigest> _lines = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Customer || session.UserId <= 0)
        {
            _isCustomer = false;
            return;
        }

        _isCustomer = true;
        var result = await Dashboards.ListStorefrontCartAsync(session.UserId, 100, ctx.RequestAborted);
        _summary = result.Summary;
        _lines = result.Lines;
        _source = result.Source;
        _message = result.Message;
    }
}
