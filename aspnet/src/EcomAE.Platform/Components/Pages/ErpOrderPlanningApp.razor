@page "/erp/order-planning-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Routing
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Components.Shared.Desktop
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>@_title · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="@_title" BreadcrumbArea="Planning" BreadcrumbTab="@_title">
    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />
    <PhpErpModulePageHeader Title="@_title" Subtitle="@_subtitle" PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Order planning KPIs">
        <div class="kpi"><div class="lbl">Recommendations</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Pending</div><div class="val">@_pending.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Pending value</div><div class="val">@_pendingValue.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Params</div><div class="val">@_params.Count.ToString(CultureInfo.InvariantCulture)</div></div>
        @if (_isMasterPlanning)
        {
            <div class="kpi"><div class="lbl">Planned orders</div><div class="val">@_master.Count.ToString(CultureInfo.InvariantCulture)</div></div>
        }
    </div>

    @if (_isMasterPlanning)
    {
        <div class="epc-erp-empty" style="display:block;margin:0 0 12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
            Persisted MRP planned orders are shown below. Regeneration accepts submitted demand/on-hand inputs; PHP remains authoritative for schema creation and the Classic fallback.
        </div>
        <form method="post" action="@EcomAeRoutes.ErpAjaxMfgrMrpRun" style="margin:0 0 12px;padding:10px;border:1px solid #dbe4ea;background:#fff">
            <input type="hidden" name="confirmWrites" value="true" />
            <div class="row">
                <div class="col-md-2"><label>Company id</label><input class="form-control input-sm" name="companyId" type="number" min="1" required /></div>
                <div class="col-md-2"><label>Due date (Unix)</label><input class="form-control input-sm" name="dueDate" type="number" value="0" /></div>
                <div class="col-md-4"><label>Demand JSON</label><input class="form-control input-sm" name="demand" placeholder='{"1001":10}' required /></div>
                <div class="col-md-4"><label>On-hand JSON</label><input class="form-control input-sm" name="onHand" placeholder='{"1001":2}' /></div>
            </div>
            <p class="text-muted" style="margin:.5rem 0">JSON keys are item IDs. This guarded action replaces prior company MRP rows and writes planned production/purchase rows in PHP-compatible level order.</p>
            <button type="submit" class="btn btn-sm btn-primary">Regenerate MRP</button>
        </form>
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead><tr><th>Order</th><th>Item id</th><th>Type</th><th class="text-right">Qty</th><th>Level</th><th>Due</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @if (_master.Count == 0)
                    {
                        <tr><td colspan="8">No persisted MRP planned orders yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in _master)
                        {
                            <tr>
                                <td><strong>#@row.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                                <td>@row.ItemId.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@row.OrderType</td>
                                <td class="text-right">@row.Qty.ToString("N3", CultureInfo.InvariantCulture)</td>
                                <td>@row.Level.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@FormatTime(row.DueDate)</td>
                                <td><span class="label label-default">@row.Status</span></td>
                                <td>
                                    <span class="text-muted">@row.Source</span>
                                    @if (string.Equals(row.Status, "planned", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form method="post" action="@EcomAeRoutes.ErpMasterPlanningFirm" style="display:inline;margin-left:.35rem">
                                            <input type="hidden" name="confirmWrites" value="true" />
                                            <input type="hidden" name="id" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                            <button type="submit" class="btn btn-xs btn-default">Firm</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_opened is not null)
    {
        <ErpDocumentWorkspace
            DocumentKind="Order planning recommendation"
            Title="@OpenedCaption"
            DocumentNumber="@_opened.Id.ToString(CultureInfo.InvariantCulture)"
            PartyLabel="Supplier"
            Party="@_opened.Supplier"
            ReferenceLabel="Warehouse"
            Reference="@_opened.WarehouseId.ToString(CultureInfo.InvariantCulture)"
            Status="@_opened.Status"
            ApprovalState="@(_opened.OrderedPoId > 0 ? "PO linked" : "Recommendation pending")"
            CompanyContext="Tenant / company"
            Currency="—"
            Fields="@PlanningWorkspaceFields"
            Lines="@PlanningWorkspaceLines"
            Tabs="@PlanningWorkspaceTabs" />
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Item</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Sku) ? "—" : sib.Sku)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.ItemName) ? $"#{sib.Id.ToString(CultureInfo.InvariantCulture)}" : sib.ItemName)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "opl_rec_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
    }

    @if (_isAdmin)
    {        <ErpPhpCreateWell Title="Set recommendation status">
<form method="post" action="/erp/order-planning/set-status" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Item <input class="form-control input-sm" name="item_id" placeholder="Item id" style="width:80px;" /></label>
                <label>Warehouse <input class="form-control input-sm" name="warehouse_id" placeholder="WH id" style="width:80px;" /></label>
                <label>ROQ <input class="form-control input-sm" name="roq" placeholder="0" style="width:80px;" /></label>
                <label>Value <input class="form-control input-sm" name="value" placeholder="0" style="width:80px;" /></label>
                <label>Supplier <input class="form-control input-sm" name="supplier" placeholder="Supplier" style="width:140px;" /></label>
                <label>Status
                    <select class="form-control input-sm" name="status">
                        <option value="pending">pending</option>
                        <option value="confirmed">confirmed</option>
                        <option value="rejected">rejected</option>
                    </select>
                </label>
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
            </form>
</ErpPhpCreateWell>
        <ErpPhpCreateWell Title="Planning parameters">
<form method="post" action="@EcomAeRoutes.ErpOrderPlanningParamsSave" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Item <input class="form-control input-sm" name="item_id" placeholder="Item id" style="width:80px;" required /></label>
                <label>Warehouse <input class="form-control input-sm" name="warehouse_id" placeholder="WH id" style="width:80px;" required /></label>
                <label>Lead time <input class="form-control input-sm" name="lead_time_days" value="30" style="width:70px;" /></label>
                <label>Service % <input class="form-control input-sm" name="target_service_level" value="90" style="width:70px;" /></label>
                <label>Review days <input class="form-control input-sm" name="review_period_days" value="30" style="width:70px;" /></label>
                <label>Min qty <input class="form-control input-sm" name="min_order_qty" placeholder="0" style="width:80px;" /></label>
                <label>Multiple <input class="form-control input-sm" name="order_multiple" placeholder="0" style="width:80px;" /></label>
                <label>Buffer <input class="form-control input-sm" name="manual_buffer" placeholder="0" style="width:80px;" /></label>
                <label>Supplier <input class="form-control input-sm" name="supplier" placeholder="Supplier" style="width:140px;" /></label>
                <label>Stocked
                    <select class="form-control input-sm" name="stocked">
                        <option value="0">no</option>
                        <option value="1">yes</option>
                    </select>
                </label>
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
            </form>
</ErpPhpCreateWell>
    }

    <h2 style="font-size:16px;">Recommendations</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>SKU</th><th>Item</th><th>WH</th><th class="text-right">ROQ</th><th class="text-right">Value</th><th>Supplier</th><th>Status</th><th>PO</th><th></th></tr></thead>
            <tbody>
                @if (_recs.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No recommendations yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _recs)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@(string.IsNullOrWhiteSpace(row.Sku) ? "—" : row.Sku)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.ItemName) ? $"#{row.ItemId.ToString(CultureInfo.InvariantCulture)}" : row.ItemName)</strong></td>
                            <td>@row.WarehouseId.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.Roq.ToString("N3", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.OrderValue.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Supplier) ? "—" : row.Supplier)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td>@(row.OrderedPoId > 0 ? row.OrderedPoId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "opl_rec_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Live: <code>opl_set_status</code>. Confirm, draft POs, and autoplan stay Classic.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private string _phpTab = "/ERP/?epc_erp_shell=1&area=planning&tab=order_planning";
    private string _listHref = "/erp/order-planning-app";
    private string _title = "Order planning";
    private string _subtitle = "Open a row for item id and last updated time. Writes stay dry-run until confirmed.";
    private bool _isMasterPlanning;
    private bool _isAdmin;
    private IReadOnlyList<ErpOrderRecommendationDigest> _recs = [];
    private IReadOnlyList<ErpPlanningParamDigest> _params = [];
    private int _count, _pending;
    private decimal _pendingValue;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpOrderRecommendationDetail? _opened;
    private IReadOnlyList<ErpOrderRecommendationDigest> _openedSiblings = [];
    private IReadOnlyList<ErpMasterPlannedOrderDigest> _master = [];
    private IReadOnlyList<string> PlanningWorkspaceTabs => ["General", "Demand", "Supplier", "Procurement"];

    private IReadOnlyList<ErpDocumentWorkspaceField> PlanningWorkspaceFields => _opened is null
        ? []
        : [
            new("SKU", _opened.Sku, "General"),
            new("Item", _opened.ItemName, "General"),
            new("Item id", _opened.ItemId.ToString(CultureInfo.InvariantCulture), "General"),
            new("Warehouse", _opened.WarehouseId.ToString(CultureInfo.InvariantCulture), "Demand"),
            new("Recommended order qty", _opened.Roq.ToString("N3", CultureInfo.InvariantCulture), "Demand"),
            new("Order value", _opened.OrderValue.ToString("N2", CultureInfo.InvariantCulture), "Demand"),
            new("Supplier", _opened.Supplier, "Supplier"),
            new("Status", _opened.Status, "Procurement"),
            new("Ordered PO", _opened.OrderedPoId > 0 ? _opened.OrderedPoId.ToString(CultureInfo.InvariantCulture) : "—", "Procurement"),
            new("Updated", FormatTime(_opened.TimeUpdated), "Audit")
        ];

    private IReadOnlyList<ErpDocumentWorkspaceLine> PlanningWorkspaceLines => _opened is null
        ? []
        : [
            new("1", string.IsNullOrWhiteSpace(_opened.ItemName) ? _opened.Sku : _opened.ItemName,
                _opened.Roq, "recommended", _opened.WarehouseId.ToString(CultureInfo.InvariantCulture),
                "planning", 0, 0, 0, _opened.OrderValue, 0,
                string.IsNullOrWhiteSpace(_opened.Supplier) ? "Supplier not assigned" : _opened.Supplier)
        ];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.Sku)
            ? _opened.Sku
            : ("Recommendation #" + _opened.Id.ToString(CultureInfo.InvariantCulture)));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + (_listHref.Contains('?', StringComparison.Ordinal) ? "&" : "?") + "opl_rec_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var tab = (ctx.Request.Query["tab"].ToString() ?? "").Trim().ToLowerInvariant();
        if (tab == "master_planning")
        {
            _isMasterPlanning = true;
            _title = "Master planning";
            _subtitle = "Persisted MRP planned orders from the PHP-owned manufacturing planning tables.";
            _phpTab = "/ERP/?epc_erp_shell=1&area=planning&tab=master_planning";
            _listHref = "/erp/order-planning-app?tab=master_planning";
        }

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "opl_rec_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpOrderPlanningDigestAsync(200, ctx.RequestAborted);
        _recs = result.Recommendations;
        _params = result.Params;
        _count = result.Count;
        _pending = result.PendingCount;
        _pendingValue = result.PendingValue;
        _source = result.Source;
        _message = result.Message;

        if (_isMasterPlanning)
        {
            var master = await Dashboards.BuildErpMasterPlanningDigestAsync(200, ctx.RequestAborted);
            _master = master.PlannedOrders;
            _message = string.IsNullOrWhiteSpace(master.Message) ? _message : master.Message;
        }

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpOrderPlanningRecommendationDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Recommendation;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _recs.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _recs = new[] { openedList }.Concat(_recs.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
