@page "/erp/suppliers-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav
@inject IErpDimensionLinkReadService DimensionLinks
@inject IErpApSetupReadService ApSetup
@inject IErpOrganizationMasterReadService OrganizationMasters

<PageTitle>Suppliers · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Suppliers" BreadcrumbArea="Procure to Pay" BreadcrumbTab="Suppliers">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/suppliers-app" IsAdmin="_isAdmin" />


    <PhpErpModulePageHeader Title="@_title" Subtitle="@_subtitle" PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="/erp/suppliers-app" />

    <p class="text-muted" style="margin:8px 0 12px;">
        <a href="@AppHref()">Suppliers</a>
        · <a href="@AppHref("ap_setup")">AP setup</a>
        · <a href="@AppHref("supplier_portal")">Supplier portal</a>
    </p>
    <ErpPhpFlash Ok="@_flashOk" Err="@_flashErr" />

    @if (_view == "supplier_portal")
    {
        <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Supplier portal KPIs">
            <div class="kpi"><div class="lbl">Suppliers</div><div class="val">@_portal.SupplierCount.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Total spend</div><div class="val">@_portal.TotalSpend.ToString("N2", CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Open payable</div><div class="val">@_portal.OpenPayable.ToString("N2", CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Avg score</div><div class="val">@_portal.AvgScore.ToString("0.0", CultureInfo.InvariantCulture)</div></div>
        </div>
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead>
                    <tr>
                        <th>Supplier</th>
                        <th>Contact</th>
                        <th>Rating</th>
                        <th class="text-right">Score</th>
                        <th class="text-right">POs</th>
                        <th class="text-right">Received</th>
                        <th class="text-right">Spend</th>
                        <th class="text-right">On-time</th>
                        <th class="text-right">Avg lead</th>
                        <th class="text-right">RFQ resp.</th>
                        <th class="text-right">RFQ win</th>
                        <th class="text-right">RFQs</th>
                        <th class="text-right">Payable</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_cards.Count == 0)
                    {
                        <tr><td colspan="13">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No supplier scorecards yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                    }
                    else
                    {
                        @foreach (var c in _cards)
                        {
                            <tr>
                                <td>
                                    <a href="@SupplierPortalHref(c.Id)">
                                        <strong>@(string.IsNullOrWhiteSpace(c.Name) ? $"#{c.Id}" : c.Name)</strong>
                                    </a>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(c.Email))
                                    {
                                        <div>@c.Email</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(c.Phone))
                                    {
                                        <div class="text-muted">@c.Phone</div>
                                    }
                                    @if (string.IsNullOrWhiteSpace(c.Email) && string.IsNullOrWhiteSpace(c.Phone))
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><span class="label label-default">@c.Rating</span></td>
                                <td class="text-right">@c.Score.ToString("0.0", CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@c.PoCount.ToString(CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@c.Received.ToString(CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@c.Spend.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@(c.OntimePct.HasValue ? c.OntimePct.Value.ToString("0.0", CultureInfo.InvariantCulture) + "%" : "—")</td>
                                <td class="text-right">@c.AvgLeadDays.ToString("0.0", CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@(c.ResponsePct is { } rp ? rp.ToString("0.0", CultureInfo.InvariantCulture) + "%" : "—")</td>
                                <td class="text-right">@(c.WinPct is { } w ? w.ToString("0.0", CultureInfo.InvariantCulture) + "%" : "—")</td>
                                <td class="text-right">@c.RfqCount.ToString(CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@c.Balance.ToString("N2", CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                        <tr style="font-weight:600;background:#f2f6fa">
                            <td>Total</td>
                            <td colspan="3"></td>
                            <td class="text-right">@_cards.Sum(c => c.PoCount).ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@_cards.Sum(c => c.Received).ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@_cards.Sum(c => c.Spend).ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td colspan="4"></td>
                            <td class="text-right">@_cards.Sum(c => c.RfqCount).ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@_cards.Sum(c => c.Balance).ToString("N2", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_portalDetail is not null)
        {
            <div class="epc-erp-table-wrap" style="margin-top:12px">
                <p style="margin:0 0 .5rem">
                    <strong>@(_portalDetail.Card?.Name ?? $"Supplier #{_portalSupplierId}")</strong>
                    @if (_portalDetail.Card is { } contactCard && (!string.IsNullOrWhiteSpace(contactCard.Email) || !string.IsNullOrWhiteSpace(contactCard.Phone)))
                    {
                        <span class="text-muted"> · @contactCard.Email@(string.IsNullOrWhiteSpace(contactCard.Email) || string.IsNullOrWhiteSpace(contactCard.Phone) ? "" : " · ")@contactCard.Phone</span>
                    }
                    <a class="btn btn-xs btn-default" href="/erp/suppliers-app?tab=supplier_portal">Close</a>
                </p>
                @if (_portalDetail.Card is { } portalCard)
                {
                    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Supplier performance detail">
                        <div class="kpi"><div class="lbl">Performance score</div><div class="val">@portalCard.Score.ToString("0.0", CultureInfo.InvariantCulture) / 100</div></div>
                        <div class="kpi"><div class="lbl">On-time delivery</div><div class="val">@(portalCard.OntimePct.HasValue ? portalCard.OntimePct.Value.ToString("0.0", CultureInfo.InvariantCulture) + "%" : "—")</div></div>
                        <div class="kpi"><div class="lbl">Purchase orders</div><div class="val">@portalCard.PoCount.ToString(CultureInfo.InvariantCulture)</div></div>
                        <div class="kpi"><div class="lbl">Open payable</div><div class="val">@portalCard.Balance.ToString("N2", CultureInfo.InvariantCulture)</div></div>
                    </div>
                    <table class="table table-condensed table-bordered table-epc epc-erp-table" style="margin:.75rem 0 1rem">
                        <thead><tr><th colspan="2">Score breakdown</th></tr></thead>
                        <tbody>
                            <tr><th>On-time delivery</th><td class="text-right">@(portalCard.OntimePct.HasValue ? portalCard.OntimePct.Value.ToString("0.0", CultureInfo.InvariantCulture) + "%" : "—")</td></tr>
                            <tr><th>Avg delivery lead time</th><td class="text-right">@portalCard.AvgLeadDays.ToString("0.0", CultureInfo.InvariantCulture) days</td></tr>
                            <tr><th>RFQ response rate</th><td class="text-right">@(portalCard.ResponsePct is { } rp ? rp.ToString("0.0", CultureInfo.InvariantCulture) + "%" : "—")</td></tr>
                            <tr><th>RFQ win rate</th><td class="text-right">@(portalCard.WinPct is { } wp ? wp.ToString("0.0", CultureInfo.InvariantCulture) + "%" : "—")</td></tr>
                            <tr><th>RFQs received</th><td class="text-right">@portalCard.RfqCount.ToString(CultureInfo.InvariantCulture)</td></tr>
                        </tbody>
                    </table>
                }
                <p class="text-muted">Recent purchase orders, RFQs, and payable bills. Received count: @((_portalDetail.Card?.Received ?? 0).ToString(CultureInfo.InvariantCulture)).</p>
                <div class="row">
                    <div class="col-sm-4">
                        <strong>Purchase orders</strong>
                        <table class="table table-condensed table-bordered table-epc epc-erp-table">
                            <thead><tr><th>PO</th><th>Title</th><th class="text-right">Total</th><th>Status</th><th>Approved</th><th>Received</th><th class="text-right">Lead (d)</th></tr></thead>
                            <tbody>
                            @if (_portalDetail.PurchaseOrders.Count == 0)
                            {
                                <tr><td colspan="7" class="text-muted">No purchase orders.</td></tr>
                            }
                            @foreach (var row in _portalDetail.PurchaseOrders)
                            {
                                <tr>
                                    <td>@row.PurchaseNo</td>
                                    <td>@row.Title</td>
                                    <td class="text-right">@row.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@row.Status</td>
                                    <td>@FormatDate(row.ApprovedAt)</td>
                                    <td>@FormatDate(row.ReceivedAt)</td>
                                    <td class="text-right">@FormatLeadDays(row.ApprovedAt, row.ReceivedAt)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="col-sm-4">
                        <strong>RFQs</strong>
                        <table class="table table-condensed table-bordered table-epc epc-erp-table">
                            <thead><tr><th>RFQ</th><th>Title</th><th class="text-right">Est.</th><th>Status</th><th>Due</th></tr></thead>
                            <tbody>
                            @if (_portalDetail.Rfqs.Count == 0)
                            {
                                <tr><td colspan="5" class="text-muted">No RFQs.</td></tr>
                            }
                            @foreach (var row in _portalDetail.Rfqs)
                            {
                                <tr>
                                    <td>@row.RfqNo</td>
                                    <td>@row.Title</td>
                                    <td class="text-right">@row.AmountEstimate.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@row.Status</td>
                                    <td>@FormatDate(row.DueDate)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="col-sm-4">
                        <strong>Payable bills</strong>
                        <table class="table table-condensed table-bordered table-epc epc-erp-table">
                            <thead><tr><th>Invoice</th><th class="text-right">Total</th><th>Status</th><th>Date</th></tr></thead>
                            <tbody>
                            @if (_portalDetail.Bills.Count == 0)
                            {
                                <tr><td colspan="4" class="text-muted">No payable bills.</td></tr>
                            }
                            @foreach (var row in _portalDetail.Bills)
                            {
                                <tr>
                                    <td>@row.InvoiceNumber</td>
                                    <td class="text-right">@row.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@row.Status</td>
                                    <td>@FormatDate(row.PurchaseDate)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else if (_view == "ap_setup" && _pmView is "methods" or "terms" or "groups" or "journals")
    {
        <ErpPhpViewTabs QueryName="pm_view" Active="@_pmView" BaseHref="@AppHref("ap_setup")" Tabs="@_apTabs" />
        @if (_pmView == "journals")
        {
            <div class="epc-erp-section">
                <h4 style="margin-top:0"><i class="fa fa-book"></i> Vendor journals</h4>
                <p class="text-muted">Post and review vendor bills and payments from the live ledgers.</p>
                <div class="btn-group" style="flex-wrap:wrap;">
                    <a class="btn btn-default btn-sm" href="@Prefixed("/erp/purchases-app")"><i class="fa fa-file-text-o"></i> Vendor bill journal</a>
                    <a class="btn btn-default btn-sm" href="@Prefixed("/erp/payables-app")"><i class="fa fa-money"></i> Vendor payment journal</a>
                    <a class="btn btn-default btn-sm" href="@Prefixed("/erp/aging-app?aging_view=ap")"><i class="fa fa-hourglass-half"></i> Payables aging</a>
                </div>
            </div>
        }
        else if (_isAdmin)
        {
            @if (_pmView == "methods")
            {
                <ErpPhpCreateWell Title="New method of payment">
                    <form method="post" action="@PmSaveAction" class="form-inline" style="display:flex;flex-wrap:wrap;gap:.6rem;align-items:end">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@AppHref("ap_setup", "methods")" />
                        <input type="hidden" name="pm_table" value="epc_erp_pm_pay_methods" />
                        <label>Code <input class="form-control input-sm" name="code" required maxlength="40" placeholder="BANK" /></label>
                        <label>Name <input class="form-control input-sm" name="name" required maxlength="190" /></label>
                        <label>Type
                            <select class="form-control input-sm" name="method_type">
                                <option value="cash">Cash</option>
                                <option value="bank">Bank transfer</option>
                                <option value="cheque">Cheque</option>
                                <option value="card">Card</option>
                                <option value="online">Online</option>
                            </select>
                        </label>
                        <label>GL account <input class="form-control input-sm" name="account_code" maxlength="40" placeholder="1020" /></label>
                        <label>Note <input class="form-control input-sm" name="note" maxlength="255" /></label>
                        <button type="submit" class="btn btn-primary btn-sm">Save method</button>
                    </form>
                </ErpPhpCreateWell>
            }
            else if (_pmView == "terms")
            {
                <ErpPhpCreateWell Title="New terms of payment">
                    <form method="post" action="@PmSaveAction" class="form-inline" style="display:flex;flex-wrap:wrap;gap:.6rem;align-items:end">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@AppHref("ap_setup", "terms")" />
                        <input type="hidden" name="pm_table" value="epc_erp_pm_pay_terms" />
                        <label>Code <input class="form-control input-sm" name="code" required maxlength="40" placeholder="NET30" /></label>
                        <label>Name <input class="form-control input-sm" name="name" required maxlength="190" placeholder="Net 30 days" /></label>
                        <label>Net days <input class="form-control input-sm" type="number" name="net_days" min="0" value="30" /></label>
                        <label>Note <input class="form-control input-sm" name="note" maxlength="255" /></label>
                        <button type="submit" class="btn btn-primary btn-sm">Save terms</button>
                    </form>
                </ErpPhpCreateWell>
            }
            else
            {
                <ErpPhpCreateWell Title="New vendor group">
                    <form method="post" action="@PmSaveAction" class="form-inline" style="display:flex;flex-wrap:wrap;gap:.6rem;align-items:end">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@AppHref("ap_setup", "groups")" />
                        <input type="hidden" name="pm_table" value="epc_erp_pm_vendor_groups" />
                        <label>Code <input class="form-control input-sm" name="code" required maxlength="40" placeholder="LOCAL" /></label>
                        <label>Name <input class="form-control input-sm" name="name" required maxlength="190" /></label>
                        <label>Default terms
                            <select class="form-control input-sm" name="terms_id">
                                <option value="0">— none —</option>
                                @foreach (var term in _ap.Terms.Where(r => r.Active))
                                {
                                    <option value="@term.Id">@term.Code · @term.Name</option>
                                }
                            </select>
                        </label>
                        <label>Note <input class="form-control input-sm" name="note" maxlength="255" /></label>
                        <button type="submit" class="btn btn-primary btn-sm">Save vendor group</button>
                    </form>
                </ErpPhpCreateWell>
            }

            <div class="epc-erp-table-wrap">
                <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>@(_pmView == "methods" ? "Type / GL" : _pmView == "terms" ? "Net days" : "Default terms")</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_apRows.Count == 0)
                        {
                            <tr><td colspan="4" class="text-muted">No records yet — create the first one above.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _apRows)
                            {
                                <tr>
                                    <td><strong>@(string.IsNullOrWhiteSpace(row.Code) ? "—" : row.Code)</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(row.Name) ? "—" : row.Name)</td>
                                    <td>@(string.IsNullOrWhiteSpace(row.Extra) || row.Extra == "0" ? "—" : row.Extra)</td>
                                    <td>@(row.Active ? "Active" : "Inactive")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">Sign in with ERP capability to set up payment methods, terms, and vendor groups.</div>
        }
    }
    else
    {
    @if (_view == "ap_setup")
    {
        <ErpPhpViewTabs QueryName="pm_view" Active="vendors" BaseHref="@AppHref("ap_setup")" Tabs="@_apTabs" />
    }
    @if (_isAdmin)
    {
        <ErpPhpCreateWell Title="Add vendor">
            <form method="post" action="@CreateAction" class="form-horizontal" style="max-width:60rem">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@VendorReturnHref" />
                <div class="row">
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Vendor name *</label><div class="col-sm-8"><input class="form-control input-sm" name="name" required maxlength="190" placeholder="Vendor name" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Vendor account</label><div class="col-sm-8"><input class="form-control input-sm" name="vendor_account" maxlength="64" placeholder="e.g. V-0001" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Vendor group</label><div class="col-sm-8">
                        <input class="form-control input-sm" name="vendor_group" maxlength="64" placeholder="e.g. Local / Import / Service" list="erp-vendor-groups" />
                        <datalist id="erp-vendor-groups">
                            @foreach (var group in _ap.Groups.Where(r => r.Active))
                            {
                                <option value="@group.Code">@group.Name</option>
                            }
                        </datalist>
                    </div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Legal entity</label><div class="col-sm-8">
                        <select class="form-control input-sm" name="legal_entity_id">
                            <option value="0">— none —</option>
                            @foreach (var entity in _org.LegalEntities.Where(r => r.Active))
                            {
                                <option value="@entity.Id">@entity.Code · @entity.Name</option>
                            }
                        </select>
                    </div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Business unit</label><div class="col-sm-8">
                        <select class="form-control input-sm" name="business_unit_id">
                            <option value="0">— none —</option>
                            @foreach (var unit in _org.BusinessUnits.Where(r => r.Active))
                            {
                                <option value="@unit.Id">@unit.Code · @unit.Name</option>
                            }
                        </select>
                    </div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Currency</label><div class="col-sm-8"><input class="form-control input-sm" name="currency_code" value="AED" maxlength="8" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Country</label><div class="col-sm-8"><input class="form-control input-sm" name="country_code" value="AE" maxlength="8" placeholder="Country (AE)" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">TRN / Tax reg.</label><div class="col-sm-8"><input class="form-control input-sm" name="trn" maxlength="40" placeholder="TRN (UAE VAT)" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Registration no.</label><div class="col-sm-8"><input class="form-control input-sm" name="registration_number" maxlength="64" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Payment terms</label><div class="col-sm-8">
                        <input class="form-control input-sm" name="payment_terms" maxlength="64" placeholder="e.g. Net 30" list="erp-pay-terms" />
                        <datalist id="erp-pay-terms">
                            @foreach (var term in _ap.Terms.Where(r => r.Active))
                            {
                                <option value="@term.Code">@term.Name</option>
                            }
                        </datalist>
                    </div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Payment method</label><div class="col-sm-8">
                        <input class="form-control input-sm" name="payment_method" maxlength="64" placeholder="e.g. Bank transfer" list="erp-pay-methods" />
                        <datalist id="erp-pay-methods">
                            @foreach (var method in _ap.Methods.Where(r => r.Active))
                            {
                                <option value="@method.Code">@method.Name</option>
                            }
                        </datalist>
                    </div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Delivery terms</label><div class="col-sm-8"><input class="form-control input-sm" name="delivery_terms" maxlength="64" placeholder="Incoterms e.g. CIF / FOB" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Delivery mode</label><div class="col-sm-8"><input class="form-control input-sm" name="delivery_mode" maxlength="64" placeholder="e.g. Sea / Air / Road" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Credit limit</label><div class="col-sm-8"><input class="form-control input-sm" type="number" step="0.01" name="credit_limit" placeholder="0.00" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">On hold</label><div class="col-sm-8">
                        <select class="form-control input-sm" name="on_hold">
                            <option value="no">No</option>
                            <option value="invoice">Invoice</option>
                            <option value="payment">Payment</option>
                            <option value="all">All</option>
                        </select>
                    </div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Bank name</label><div class="col-sm-8"><input class="form-control input-sm" name="bank_name" maxlength="120" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Bank account no.</label><div class="col-sm-8"><input class="form-control input-sm" name="bank_account_number" maxlength="64" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">IBAN</label><div class="col-sm-8"><input class="form-control input-sm" name="iban" maxlength="64" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">SWIFT / BIC</label><div class="col-sm-8"><input class="form-control input-sm" name="swift_bic" maxlength="32" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Contact person</label><div class="col-sm-8"><input class="form-control input-sm" name="contact_person" maxlength="120" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">E-mail</label><div class="col-sm-8"><input class="form-control input-sm" type="email" name="contact_email" maxlength="120" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Phone</label><div class="col-sm-8"><input class="form-control input-sm" name="contact_phone" maxlength="64" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Website</label><div class="col-sm-8"><input class="form-control input-sm" name="website" maxlength="190" placeholder="https://" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Address</label><div class="col-sm-8"><input class="form-control input-sm" name="address" maxlength="190" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">City</label><div class="col-sm-8"><input class="form-control input-sm" name="city" maxlength="80" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">State / region</label><div class="col-sm-8"><input class="form-control input-sm" name="state_region" maxlength="80" /></div></div>
                    <div class="col-sm-6 form-group"><label class="col-sm-4 control-label">Postal code</label><div class="col-sm-8"><input class="form-control input-sm" name="postal_code" maxlength="20" /></div></div>
                    <div class="col-sm-12 form-group"><label class="col-sm-2 control-label">Notes</label><div class="col-sm-10"><input class="form-control input-sm" name="notes" maxlength="255" /></div></div>
                </div>
                <label class="checkbox-inline"><input type="checkbox" name="vat_registered" value="1" checked="checked" /> UAE VAT registered (5% input)</label>
                <label class="checkbox-inline"><input type="checkbox" name="tax_exempt" value="1" /> Tax exempt</label>
                <div style="margin-top:8px;">
                    <button type="submit" class="btn btn-sm btn-primary">Save vendor</button>
                </div>
            </form>
        </ErpPhpCreateWell>
        <form method="post" action="@SyncAction" class="form-inline" style="margin:0 0 12px">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@VendorReturnHref" />
            <button type="submit" class="btn btn-default btn-sm">Create vendors from warehouses</button>
            <span class="text-muted">Adds one supplier per warehouse that does not already have an active vendor.</span>
        </form>
    }
    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Supplier KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_suppliers.Count</div></div>
        <div class="kpi"><div class="lbl">With non-zero balance</div><div class="val">@_openBalance</div></div>
        <div class="kpi"><div class="lbl">Sum of balances</div><div class="val">@_totalBalance.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedDetail is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="/erp/suppliers-app">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Supplier id</dt><dd>@_openedDetail.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.Name) ? "—" : _openedDetail.Name)</dd>
                <dt>Storage</dt><dd>@(_openedDetail.StorageId > 0 ? _openedDetail.StorageId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Currency</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.CurrencyCode) ? "—" : _openedDetail.CurrencyCode)</dd>
                <dt>Created</dt><dd>@FormatTime(_openedDetail.TimeCreated)</dd>
            </dl>
            <ErpDimensionLinksPanel Links="_openedDimensionLinks" />
            <p class="text-muted" style="margin:.85rem 0 0">Use Add vendor above to create or set up a supplier. Opened rows show the payable identity used on bills.</p>
            @if (!string.IsNullOrWhiteSpace(_openedDetail.TrnExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">TRN excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedDetail.TrnExcerpt</pre>
                @if (_openedDetail.TrnLen > _openedDetail.TrnExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_openedDetail.TrnExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedDetail.TrnLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No TRN excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-currency siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Supplier</th><th class="text-right">Balance</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Name) ? "—" : sib.Name)</td>
                                <td class="text-right">@sib.Balance.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href("/erp/suppliers-app", "supplier_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-currency siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Supplier</th>
                    <th>Storage ID</th>
                    <th>Balance</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_suppliers.Count == 0)
                {
                    <tr><td colspan="4">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var s in _suppliers)
                    {
                        <tr id="erp-row-@s.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(s.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(s.Name) ? $"#{s.Id}" : s.Name)</strong></td>
                            <td>@(s.StorageId > 0 ? s.StorageId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><span class="label label-default">@s.Balance.ToString("N2", CultureInfo.InvariantCulture)</span></td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href("/erp/suppliers-app", "supplier_id", s.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
            </table>
        </div>
    }

</PhpErpDesktopChrome>

@code {
    private string _phpTab = "/ERP/?epc_erp_shell=1&area=purchasing&tab=vendors";
    private string _title = "Suppliers";
    private string _subtitle = "Supplier master and balances.";
    private string _view = "suppliers";
    private string _pmView = "vendors";
    private string _flashOk = "";
    private string _flashErr = "";
    private bool _isAdmin;
    private readonly IReadOnlyList<(string Key, string Label)> _apTabs =
    [
        ("vendors", "Vendors"),
        ("methods", "Method of payment"),
        ("terms", "Terms of payment"),
        ("groups", "Vendor group"),
        ("journals", "Journals"),
    ];
    private ErpApSetupSnapshot _ap = new([], [], [], "n/a", "");
    private IReadOnlyList<ErpApSetupRow> _apRows = [];
    private ErpOrganizationMasterSnapshot _org = new([], [], [], [], [], [], "n/a", "");
    private IReadOnlyList<ErpSupplierDigest> _suppliers = [];
    private ErpSupplierPortalSummary _portal = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<ErpSupplierPortalCardDigest> _cards = [];
    private ErpSupplierPortalDetailResult? _portalDetail;
    private long _portalSupplierId;
    private int _openBalance;
    private decimal _totalBalance;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpSupplierDigest? _openedSupplier;
    private ErpSupplierDetail? _openedDetail;
    private IReadOnlyList<ErpDimensionLink> _openedDimensionLinks = [];
    private IReadOnlyList<ErpSupplierDigest> _openedSiblings = [];

    private bool OpenedFound => _openedDetail is not null || _openedSupplier is not null;

    private string OpenedReturnHref => _openedId > 0
        ? "/erp/suppliers-app?supplier_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : "/erp/suppliers-app";

    private string OpenedCaption => _openedDetail is not null
        ? (string.IsNullOrWhiteSpace(_openedDetail.Name) ? ("Supplier #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.Name)
            + (string.IsNullOrWhiteSpace(_openedDetail.CurrencyCode) ? "" : (" · " + _openedDetail.CurrencyCode))
        : _openedSupplier is null
            ? ""
            : (string.IsNullOrWhiteSpace(_openedSupplier.Name) ? $"Supplier #{_openedSupplier.Id}" : _openedSupplier.Name);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "supplier_id");
        var tab = (ctx.Request.Query["tab"].ToString() ?? "").Trim().ToLowerInvariant();
        _view = tab == "supplier_portal" ? "supplier_portal" : tab == "ap_setup" ? "ap_setup" : "suppliers";
        _phpTab = _view switch
        {
            "supplier_portal" => "/ERP/?epc_erp_shell=1&area=purchasing&tab=supplier_portal",
            "ap_setup" => "/ERP/?epc_erp_shell=1&area=ap&tab=ap_setup",
            _ => "/ERP/?epc_erp_shell=1&area=purchasing&tab=vendors"
        };
        _title = _view switch
        {
            "supplier_portal" => "Supplier portal",
            "ap_setup" => "AP setup",
            _ => "Suppliers"
        };
        _subtitle = _view switch
        {
            "supplier_portal" => "Delivery, responsiveness, spend and payables scorecards.",
            "ap_setup" => "Add vendors and configure payment methods, terms, and vendor groups used on payable posting.",
            _ => "Add a vendor, then open a row for the TRN excerpt and currency used on bills."
        };
        _flashOk = (ctx.Request.Query["ok"].ToString() ?? string.Empty).Trim();
        _flashErr = (ctx.Request.Query["err"].ToString() ?? string.Empty).Trim();
        _pmView = NormalizePmView(ctx.Request.Query["pm_view"].ToString());

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        _ap = await ApSetup.LoadAsync(200, ctx.RequestAborted);
        _org = await OrganizationMasters.LoadAsync(200, ctx.RequestAborted);
        _apRows = _pmView switch
        {
            "terms" => _ap.Terms,
            "groups" => _ap.Groups,
            _ => _ap.Methods,
        };

        if (_view == "supplier_portal")
        {
            var portal = await Dashboards.BuildErpSupplierPortalDigestAsync(_limit, ctx.RequestAborted);
            _portal = portal.Summary;
            _cards = portal.Cards;
            _source = portal.Source;
            _message = portal.Message;
            _portalSupplierId = ErpRecordOpen.ReadId(ctx.Request, "supplier_id");
            if (_portalSupplierId > 0)
            {
                _portalDetail = await Dashboards.BuildErpSupplierPortalDetailAsync(_portalSupplierId, ctx.RequestAborted);
            }
            return;
        }

        if (_view == "ap_setup" && _pmView is "methods" or "terms" or "groups" or "journals")
        {
            return;
        }

        var result = await Dashboards.ListErpSuppliersAsync(_limit, ctx.RequestAborted);
        _suppliers = result.Suppliers;
        _openedSupplier = _openedId > 0 ? _suppliers.FirstOrDefault(s => s.Id == _openedId) : null;
        if (_openedSupplier is not null)
        {
            _suppliers = new[] { _openedSupplier }.Concat(_suppliers.Where(s => s.Id != _openedId)).ToList();
        }
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpSupplierDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Supplier;
            _openedDimensionLinks = await DimensionLinks.LoadAsync("vendor", _openedId, ctx.RequestAborted);
            _openedSiblings = detail.Siblings;
            if (_openedDetail is null && !string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
        _openBalance = _suppliers.Count(s => s.Balance != 0m);
        _totalBalance = _suppliers.Sum(s => s.Balance);
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }

    private static string FormatDate(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    private static string FormatLeadDays(long approvedAt, long receivedAt)
    {
        if (approvedAt <= 0 || receivedAt <= 0 || receivedAt < approvedAt) return "—";
        return ((decimal)(receivedAt - approvedAt) / 86400m).ToString("0.0", CultureInfo.InvariantCulture);
    }

    private string CreateAction => Prefixed("/erp/suppliers/create");
    private string SyncAction => Prefixed("/erp/suppliers/sync");
    private string PmSaveAction => Prefixed("/erp/pm/save");
    private string VendorReturnHref => _view == "ap_setup" ? AppHref("ap_setup", "vendors") : AppHref();

    private string Prefixed(string href)
        => ClientErpPath.PrefixIfBound(Http.HttpContext, href);

    private string AppHref(string? tab = null, string? pmView = null)
    {
        var path = "/erp/suppliers-app";
        if (!string.IsNullOrWhiteSpace(tab))
        {
            path += "?tab=" + Uri.EscapeDataString(tab);
            if (!string.IsNullOrWhiteSpace(pmView))
            {
                path += "&pm_view=" + Uri.EscapeDataString(pmView);
            }
        }

        return Prefixed(path);
    }

    private static string SupplierPortalHref(long supplierId)
        => "/erp/suppliers-app?tab=supplier_portal&supplier_id=" + supplierId.ToString(CultureInfo.InvariantCulture);

    private static string NormalizePmView(string? raw)
    {
        var view = (raw ?? string.Empty).Trim().ToLowerInvariant();
        return view switch
        {
            "methods" or "method" => "methods",
            "terms" or "term" => "terms",
            "groups" or "group" or "vendor_groups" => "groups",
            "journals" or "journal" => "journals",
            _ => "vendors",
        };
    }
}
