@page "/erp/workflow-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Workflow · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Workflow" BreadcrumbArea="Overview" BreadcrumbTab="Workflow">

    <PhpErpModulePageHeader Title="Department workflow board" Subtitle="Set task status here. Task create stays on the classic twin." />
    <PhpErpD365ActionPane RefreshHref="@Nav.Uri" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/workflow/status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/workflow-app" />
            <label>Task id <input type="number" name="taskId" min="1" required style="width:6rem" /></label>
            <label>Status
                <select name="status">
                    <option value="pending">pending</option>
                    <option value="in_progress">in_progress</option>
                    <option value="done">done</option>
                    <option value="cancelled">cancelled</option>
                </select>
            </label>
            <button type="submit">Set status</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Workflow KPIs">
        <div class="kpi"><div class="lbl">Tasks</div><div class="val">@_summary.TaskCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open</div><div class="val">@_summary.OpenCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Done</div><div class="val">@_summary.DoneCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Overdue</div><div class="val">@_summary.OverdueCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Cancelled</div><div class="val">@_summary.CancelledCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Dept</th>
                    <th>Step</th>
                    <th>Task</th>
                    <th>Order</th>
                    <th>Assignee</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Due</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_tasks.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No workflow tasks yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _tasks)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(row.DepartmentCode) ? "—" : row.DepartmentCode)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.WorkflowStep) ? "—" : row.WorkflowStep)</td>
                            <td>
                                <strong>@row.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(row.Description))
                                {
                                    <br /><small class="text-muted">@row.Description</small>
                                }
                            </td>
                            <td>@(row.OrderId > 0 ? $"#{row.OrderId.ToString(CultureInfo.InvariantCulture)}" : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.AssigneeName) ? "—" : row.AssigneeName)</td>
                            <td><span class="label label-default">@row.Priority</span></td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td>@FormatDate(row.DueAt)</td>
                            <td><a href="/erp/workflow-app">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Process-flow cases stay on <a href="/erp/process-flow-tasks-app">process flow</a>. Task create stays PHP.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private ErpWorkflowTasksSummary _summary = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<ErpWorkflowTaskDigest> _tasks = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.BuildErpWorkflowTasksDigestAsync(100, ctx.RequestAborted);
        _summary = result.Summary;
        _tasks = result.Tasks;
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatDate(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
