@page "/erp/workflow-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
<PageTitle>Workflow · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Workflow" BreadcrumbArea="Overview" BreadcrumbTab="Workflow">

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }

    <div class="epc-erp-section">
        <h4><i class="fa fa-random"></i> Department workflow board</h4>
        <p class="text-muted">Cross-department order flow: <strong>Sales</strong> → <strong>Purchase</strong> → <strong>Logistics</strong> → <strong>Finance</strong> → <strong>Accounts</strong>. Marketing &amp; HR support parallel tracks.</p>

        <form method="get" action="/erp/workflow-app" class="form-inline" style="margin-bottom:12px;">
            <label>Department</label>
            <select name="dept" class="form-control input-sm" onchange="this.form.submit()">
                <option value="">All departments</option>
                @foreach (var deptRow in ErpStaffDepartmentCatalog.All)
                {
                    <option value="@deptRow.Code" selected="@string.Equals(_dept, deptRow.Code, StringComparison.OrdinalIgnoreCase)">@deptRow.Name</option>
                }
            </select>
        </form>

        @if (_isAdmin)
        {
            <form method="post" action="/erp/workflow/create" class="form-inline epc-erp-form-inline" style="margin-bottom:12px;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@_returnUrl" />
                <select name="department_code" class="form-control input-sm">
                    @foreach (var deptRow in ErpStaffDepartmentCatalog.All)
                    {
                        <option value="@deptRow.Code" selected="@string.Equals(_dept, deptRow.Code, StringComparison.OrdinalIgnoreCase)">@deptRow.Name</option>
                    }
                </select>
                <input type="text" name="title" class="form-control input-sm" placeholder="Task title" required maxlength="255" />
                <input type="text" name="workflow_step" class="form-control input-sm" placeholder="Step" maxlength="64" />
                <input type="number" name="order_id" class="form-control input-sm" placeholder="Order ID" value="0" min="0" />
                <select name="priority" class="form-control input-sm">
                    <option value="normal">Normal</option>
                    <option value="high">High</option>
                    <option value="low">Low</option>
                </select>
                <button type="submit" class="btn btn-sm btn-primary">Add task</button>
            </form>
        }

        <table class="table table-bordered table-condensed">
            <thead>
                <tr>
                    <th>Dept</th>
                    <th>Step</th>
                    <th>Task</th>
                    <th>Order</th>
                    <th>Assignee</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Due</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_tasks.Count == 0)
                {
                    <tr><td colspan="9" class="text-muted">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No workflow tasks — run staff setup with sample data." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _tasks)
                    {
                        var statusClass = row.Status == "done" ? "success" : (row.Status == "in_progress" ? "info" : "default");
                        <tr>
                            <td>@ErpStaffDepartmentCatalog.NameFor(row.DepartmentCode)</td>
                            <td><small>@(string.IsNullOrWhiteSpace(row.WorkflowStep) ? "—" : row.WorkflowStep)</small></td>
                            <td>
                                <strong>@row.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(row.Description))
                                {
                                    <br /><small class="text-muted">@row.Description</small>
                                }
                            </td>
                            <td>@(row.OrderId > 0 ? $"#{row.OrderId.ToString(CultureInfo.InvariantCulture)}" : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.AssigneeName) ? "—" : row.AssigneeName)</td>
                            <td>@row.Priority</td>
                            <td><span class="label label-@statusClass">@row.Status</span></td>
                            <td>@FormatDate(row.DueAt)</td>
                            <td>
                                @if (_isAdmin && row.Status != "done" && row.Status != "cancelled")
                                {
                                    <form method="post" action="/erp/workflow/status" style="display:inline">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="@_returnUrl" />
                                        <input type="hidden" name="task_id" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                        <input type="hidden" name="status" value="done" />
                                        <button type="submit" class="btn btn-xs btn-success epc-wf-done">Done</button>
                                    </form>
                                    <form method="post" action="/erp/workflow/status" style="display:inline">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="@_returnUrl" />
                                        <input type="hidden" name="task_id" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                        <input type="hidden" name="status" value="in_progress" />
                                        <button type="submit" class="btn btn-xs btn-default epc-wf-progress">Start</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private IReadOnlyList<ErpWorkflowTaskDigest> _tasks = [];
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private string _dept = "";
    private string _returnUrl = "/erp/workflow-app";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _dept = (ctx.Request.Query["dept"].ToString() ?? "").Trim();
        _returnUrl = string.IsNullOrWhiteSpace(_dept)
            ? "/erp/workflow-app"
            : "/erp/workflow-app?dept=" + Uri.EscapeDataString(_dept);
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.BuildErpWorkflowTasksDigestAsync(80, ctx.RequestAborted);
        _message = result.Message;
        _tasks = string.IsNullOrWhiteSpace(_dept)
            ? result.Tasks
            : result.Tasks.Where(t => string.Equals(t.DepartmentCode, _dept, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private static string FormatDate(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
