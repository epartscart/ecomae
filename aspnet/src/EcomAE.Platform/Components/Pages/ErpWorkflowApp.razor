@page "/erp/workflow-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Components.Shared.Desktop
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
<PageTitle>Workflow · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<style>
    .epc-wf-guide { margin:0 0 12px; padding:12px 14px; border:1px solid #dbe4ea; background:#fff; }
    .epc-wf-guide h3 { margin:0 0 4px; font-size:15px; color:#0f172a; }
    .epc-wf-guide__lead { margin:0 0 10px; color:#475569; }
    .epc-wf-guide__steps { display:flex; flex-wrap:wrap; gap:8px; list-style:none; margin:0; padding:0; }
    .epc-wf-guide__steps li { display:flex; gap:8px; align-items:flex-start; flex:1 1 180px; padding:8px 10px; border:1px solid #dbe4ea; background:#f8fafc; }
    .epc-wf-guide__n { flex:0 0 auto; width:22px; height:22px; border-radius:50%; background:#1d4f91; color:#fff; font-size:12px; font-weight:700; line-height:22px; text-align:center; }
    .epc-wf-guide__steps strong { display:block; color:#0f172a; }
    .epc-wf-guide__steps p { margin:2px 0 0; font-size:12px; color:#475569; }
    .epc-wf-flow { display:flex; flex-wrap:wrap; align-items:center; gap:6px; margin:0 0 12px; }
    .epc-wf-flow a { display:inline-flex; align-items:center; gap:6px; padding:6px 10px; border:1px solid #dbe4ea; border-radius:999px; background:#fff; color:#0f172a; text-decoration:none; font-weight:700; }
    .epc-wf-flow a.is-on { background:#1d4f91; border-color:#1d4f91; color:#fff; }
    .epc-wf-flow .sep { color:#94a3b8; }
    .epc-wf-toolbar { display:flex; flex-wrap:wrap; gap:8px; align-items:end; margin:0 0 12px; padding:10px; border:1px solid #dbe4ea; background:#f8fafc; }
    .epc-wf-toolbar label { display:block; margin:0 0 2px; font-size:11px; color:#475569; font-weight:700; }
    .epc-wf-actions { white-space:nowrap; width:1%; }
    .epc-wf-actions__row { display:flex; flex-wrap:nowrap; align-items:center; gap:4px; }
    .epc-wf-actions__row form[data-epc-inline="1"] { display:inline-flex !important; width:auto !important; margin:0 !important; padding:0 !important; border:0 !important; background:transparent !important; box-shadow:none !important; }
</style>
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Workflow" BreadcrumbArea="Overview" BreadcrumbTab="Workflow">

    <PhpErpModulePageHeader Title="Department workflow board" Subtitle="Cross-department order flow: Sales → Purchase → Logistics → Finance → Accounts. Marketing and HR support parallel tracks." />
    <PhpErpD365ActionPane RefreshHref="@WithCompany("?")" />

    @if (_opened is not null)
    {
        <ErpDocumentWorkspace
            DocumentKind="Workflow task"
            Title="@(_opened.Title.Length == 0 ? $"Task #{_opened.Id.ToString(CultureInfo.InvariantCulture)}" : _opened.Title)"
            DocumentNumber="@_opened.Id.ToString(CultureInfo.InvariantCulture)"
            PartyLabel="Assignee"
            Party="@(_opened.AssigneeName.Length == 0 ? "Unassigned" : _opened.AssigneeName)"
            ReferenceLabel="Order"
            Reference="@(_opened.OrderId > 0 ? $"#{_opened.OrderId.ToString(CultureInfo.InvariantCulture)}" : "—")"
            Status="@(_opened.Status.Length == 0 ? "pending" : _opened.Status)"
            ApprovalState="@(_opened.Status is "done" or "cancelled" ? "Closed" : "Action required")"
            CompanyContext="Tenant / company"
            Currency="—"
            Fields="@WorkflowWorkspaceFields"
            Lines="@WorkflowWorkspaceLines"
            Tabs="@WorkflowWorkspaceTabs" />
    }

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }

    <div class="hpanel epc-erp-section">
        <div class="panel-heading hbuilt"><i class="fa fa-random"></i> Department workflow board</div>
        <div class="panel-body">
        <section class="epc-wf-guide" aria-label="How to use the workflow board">
            <h3>How to use this board</h3>
            <p class="epc-wf-guide__lead">Cross-department order flow: <strong>Sales</strong> → <strong>Purchase</strong> → <strong>Logistics</strong> → <strong>Finance</strong> → <strong>Accounts</strong>. Marketing and HR run beside that chain. Open, Done, and Start sit on one row for the task you are looking at.</p>
            <ol class="epc-wf-guide__steps">
                <li><span class="epc-wf-guide__n">1</span><div><strong>Choose the department</strong><p>Use the chain or the department list. All departments stays the full board.</p></div></li>
                <li><span class="epc-wf-guide__n">2</span><div><strong>Add the task</strong><p>Give it a title, the step name, the order number, and a priority.</p></div></li>
                <li><span class="epc-wf-guide__n">3</span><div><strong>Open, Start, Done</strong><p>Open reads the task. Start marks it in progress. Done closes it.</p></div></li>
            </ol>
        </section>

        <nav class="epc-wf-flow" aria-label="Department chain">
            <a class="@FlowClass("")" href="@DeptHref("")">All</a>
            <span class="sep">·</span>
            @foreach (var code in Chain)
            {
                <a class="@FlowClass(code)" href="@DeptHref(code)">@ErpStaffDepartmentCatalog.NameFor(code)</a>
                @if (code != "accounts")
                {
                    <span class="sep">→</span>
                }
            }
            <span class="sep">·</span>
            <a class="@FlowClass("marketing")" href="@DeptHref("marketing")">Marketing</a>
            <a class="@FlowClass("hr")" href="@DeptHref("hr")">HR</a>
        </nav>

        <form method="get" action="/erp/workflow-app" class="epc-wf-toolbar" data-epc-inline="1">
            @if (_companyId > 0)
            {
                <input type="hidden" name="company" value="@_companyId.ToString(CultureInfo.InvariantCulture)" />
            }
            <div>
                <label>Department</label>
                <select name="dept" class="form-control input-sm" onchange="this.form.submit()">
                    <option value="">All departments</option>
                    @foreach (var deptRow in ErpStaffDepartmentCatalog.All)
                    {
                        <option value="@deptRow.Code" selected="@string.Equals(_dept, deptRow.Code, StringComparison.OrdinalIgnoreCase)">@deptRow.Name</option>
                    }
                </select>
            </div>
        </form>

        @if (_isAdmin)
        {
            <form method="post" action="/erp/workflow/create" class="epc-wf-toolbar epc-erp-form-inline" data-epc-inline="1">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@_returnUrl" />
                <div>
                    <label>Department</label>
                    <select name="department_code" class="form-control input-sm">
                        @foreach (var deptRow in ErpStaffDepartmentCatalog.All)
                        {
                            <option value="@deptRow.Code" selected="@string.Equals(_dept, deptRow.Code, StringComparison.OrdinalIgnoreCase)">@deptRow.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label>Task</label>
                    <input type="text" name="title" class="form-control input-sm" placeholder="Task title" required maxlength="255" />
                </div>
                <div>
                    <label>Step</label>
                    <input type="text" name="workflow_step" class="form-control input-sm" placeholder="Step" maxlength="64" />
                </div>
                <div>
                    <label>Order</label>
                    <input type="number" name="order_id" class="form-control input-sm" placeholder="Order ID" value="0" min="0" />
                </div>
                <div>
                    <label>Priority</label>
                    <select name="priority" class="form-control input-sm">
                        <option value="normal">Normal</option>
                        <option value="high">High</option>
                        <option value="low">Low</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-sm btn-primary">Add task</button>
            </form>
        }

        <table class="table table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Dept</th>
                    <th>Step</th>
                    <th>Task</th>
                    <th>Order</th>
                    <th>Assignee</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Due</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (_tasks.Count == 0)
                {
                    <tr><td colspan="9" class="text-muted">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No workflow tasks — run staff setup with sample data." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _tasks)
                    {
                        var statusClass = row.Status == "done" ? "success" : (row.Status == "in_progress" ? "info" : "default");
                        <tr>
                            <td>@ErpStaffDepartmentCatalog.NameFor(row.DepartmentCode)</td>
                            <td><small>@(string.IsNullOrWhiteSpace(row.WorkflowStep) ? "—" : row.WorkflowStep)</small></td>
                            <td>
                                <strong>@row.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(row.Description))
                                {
                                    <br /><small class="text-muted">@row.Description</small>
                                }
                            </td>
                            <td>@(row.OrderId > 0 ? $"#{row.OrderId.ToString(CultureInfo.InvariantCulture)}" : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.AssigneeName) ? "—" : row.AssigneeName)</td>
                            <td>@row.Priority</td>
                            <td><span class="label label-@statusClass">@StatusLabel(row.Status)</span></td>
                            <td>@FormatDate(row.DueAt)</td>
                            <td class="epc-wf-actions">
                                <div class="epc-wf-actions__row">
                                    <a class="btn btn-xs btn-default" href="@TaskHref(row.Id)">Open</a>
                                    @if (_isAdmin && row.Status != "done" && row.Status != "cancelled")
                                    {
                                        <form method="post" action="/erp/workflow/status" data-epc-inline="1">
                                            <input type="hidden" name="confirmWrites" value="true" />
                                            <input type="hidden" name="returnUrl" value="@_returnUrl" />
                                            <input type="hidden" name="task_id" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                            <input type="hidden" name="status" value="done" />
                                            <button type="submit" class="btn btn-xs btn-success epc-wf-done">Done</button>
                                        </form>
                                        <form method="post" action="/erp/workflow/status" data-epc-inline="1">
                                            <input type="hidden" name="confirmWrites" value="true" />
                                            <input type="hidden" name="returnUrl" value="@_returnUrl" />
                                            <input type="hidden" name="task_id" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                            <input type="hidden" name="status" value="in_progress" />
                                            <button type="submit" class="btn btn-xs btn-default epc-wf-progress">Start</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        </div>
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private IReadOnlyList<ErpWorkflowTaskDigest> _tasks = [];
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private static readonly string[] Chain = ["sales", "purchase", "logistics", "finance", "accounts"];
    private string _dept = "";
    private long _companyId;
    private string _returnUrl = "/erp/workflow-app";
    private long _openedId;
    private ErpWorkflowTaskDigest? _opened;

    private IReadOnlyList<string> WorkflowWorkspaceTabs =>
        ["General", "Assignment", "Process", "Audit"];

    private IReadOnlyList<ErpDocumentWorkspaceField> WorkflowWorkspaceFields => _opened is null
        ? []
        : [
            new("Department", ErpStaffDepartmentCatalog.NameFor(_opened.DepartmentCode), "General"),
            new("Workflow step", string.IsNullOrWhiteSpace(_opened.WorkflowStep) ? "—" : _opened.WorkflowStep, "Process"),
            new("Description", string.IsNullOrWhiteSpace(_opened.Description) ? "—" : _opened.Description, "General"),
            new("Priority", string.IsNullOrWhiteSpace(_opened.Priority) ? "—" : _opened.Priority, "Process"),
            new("Assignee", string.IsNullOrWhiteSpace(_opened.AssigneeName) ? "Unassigned" : _opened.AssigneeName, "Assignment"),
            new("Due", FormatDate(_opened.DueAt), "Assignment"),
            new("Completed", FormatDate(_opened.CompletedAt), "Audit"),
            new("Created", FormatDate(_opened.TimeCreated), "Audit")
        ];

    private IReadOnlyList<ErpDocumentWorkspaceLine> WorkflowWorkspaceLines => _opened is null
        ? []
        : [
            new(
                "1",
                string.IsNullOrWhiteSpace(_opened.WorkflowStep) ? "Workflow task" : _opened.WorkflowStep,
                1,
                "task",
                _opened.DepartmentCode,
                "—",
                0,
                0,
                0,
                0,
                0,
                _opened.OrderId > 0 ? $"Order #{_opened.OrderId.ToString(CultureInfo.InvariantCulture)}" : "Internal workflow")
        ];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _dept = (ctx.Request.Query["dept"].ToString() ?? "").Trim();
        _companyId = ErpHostContext.ActiveCompanyIdFromQuery(ctx.Request) ?? 0;
        _openedId = long.TryParse(ctx.Request.Query["task_id"].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var taskId)
            ? taskId
            : 0;
        _returnUrl = BoardHref(_dept);
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.BuildErpWorkflowTasksDigestAsync(80, ctx.RequestAborted);
        _message = result.Message;
        _tasks = string.IsNullOrWhiteSpace(_dept)
            ? result.Tasks
            : result.Tasks.Where(t => string.Equals(t.DepartmentCode, _dept, StringComparison.OrdinalIgnoreCase)).ToList();
        _opened = _openedId > 0 ? _tasks.FirstOrDefault(t => t.Id == _openedId) : null;
        if (_opened is not null)
        {
            _tasks = new[] { _opened }.Concat(_tasks.Where(t => t.Id != _openedId)).ToList();
        }
    }

    private string TaskHref(long taskId)
        => BoardHref(_dept) + (BoardHref(_dept).Contains('?', StringComparison.Ordinal) ? "&" : "?")
           + "task_id=" + taskId.ToString(CultureInfo.InvariantCulture);

    private string DeptHref(string code) => BoardHref(code);

    private string FlowClass(string code)
        => string.Equals(_dept, code, StringComparison.OrdinalIgnoreCase) ? "is-on" : "";

    private string BoardHref(string dept)
    {
        var path = "/erp/workflow-app";
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(dept))
        {
            query.Add("dept=" + Uri.EscapeDataString(dept));
        }

        if (_companyId > 0)
        {
            query.Add("company=" + _companyId.ToString(CultureInfo.InvariantCulture));
        }

        return query.Count == 0 ? path : path + "?" + string.Join("&", query);
    }

    private string WithCompany(string href)
    {
        if (_companyId <= 0 || href.Contains("company=", StringComparison.OrdinalIgnoreCase))
        {
            return href;
        }

        var company = "company=" + _companyId.ToString(CultureInfo.InvariantCulture);
        if (href == "?")
        {
            return "?" + company;
        }

        return href + (href.Contains('?', StringComparison.Ordinal) ? "&" : "?") + company;
    }

    private static string StatusLabel(string status)
        => status switch
        {
            "in_progress" => "In progress",
            "done" => "Done",
            "pending" => "Pending",
            "cancelled" => "Cancelled",
            _ => string.IsNullOrWhiteSpace(status) ? "Pending" : status,
        };

    private static string FormatDate(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
