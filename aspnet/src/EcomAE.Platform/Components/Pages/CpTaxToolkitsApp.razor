@page "/cp/tax-toolkits-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Tax Toolkits · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
@if (_allowed)
{
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Tax Toolkits
                <a class="btn btn-xs btn-default pull-right" href="/cp/pos-overview-app" style="margin-right:.4rem">POS overview</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/tax-toolkits-app")</p>
                <p>Open a kit to see rules, country codes, installs, and refresh history. Install stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/tax-toolkits-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedToolkit is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Tax toolkit KPIs">
        <div class="kpi"><div class="lbl">Toolkits</div><div class="val">@_summary.ToolkitCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Installed</div><div class="val">@_summary.InstallCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Tenant country</div><div class="val">@(string.IsNullOrWhiteSpace(_summary.TenantCountry) ? "—" : _summary.TenantCountry)</div></div>
        <div class="kpi"><div class="lbl">Active kit</div><div class="val">@(string.IsNullOrWhiteSpace(_summary.TenantKitCode) ? "—" : _summary.TenantKitCode)</div></div>
    </div>

    @if (_openedToolkit is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedToolkit.KitCode) ? _openedToolkit.KitCode : ("Kit #" + _openedToolkit.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(_openedToolkit.Active ? "active" : "inactive")</span>
                </div>
                <div class="panel-body">
                    <p><strong>@(!string.IsNullOrWhiteSpace(_openedToolkit.Name) ? _openedToolkit.Name : "—")</strong>
                        · @(!string.IsNullOrWhiteSpace(_openedToolkit.Jurisdiction) ? _openedToolkit.Jurisdiction : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedToolkit.TaxType) ? _openedToolkit.TaxType : "—")
                        · @(_openedToolkit.IsSystem ? "system" : "custom")</p>
                    @if (!string.IsNullOrWhiteSpace(_openedToolkit.CountryCodesJson))
                    {
                        <p>Countries: @_openedToolkit.CountryCodesJson</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedToolkit.RulesJson))
                    {
                        <pre style="max-height:16rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedToolkit.RulesJson</pre>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Installs</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Kit</th>
                                    <th>Default</th>
                                    <th>By</th>
                                    <th>When</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedInstalls.Count == 0)
                                {
                                    <tr><td colspan="5">No installs yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in _openedInstalls)
                                    {
                                        <tr>
                                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(row.KitCode) ? row.KitCode : "—")</td>
                                            <td>@(row.IsDefault ? "yes" : "no")</td>
                                            <td>@row.InstalledBy.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@row.TimeInstalled.ToString(CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Refresh history</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Source</th>
                                    <th>Changelog</th>
                                    <th>Hash</th>
                                    <th>When</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedUpdates.Count == 0)
                                {
                                    <tr><td colspan="4">No updates yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in _openedUpdates)
                                    {
                                        <tr>
                                            <td>@(!string.IsNullOrWhiteSpace(row.Source) ? row.Source : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(row.Changelog) ? row.Changelog : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(row.RulesHash) ? row.RulesHash : "—")</td>
                                            <td>@row.TimeUpdated.ToString(CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_summary.ToolkitCount.ToString(CultureInfo.InvariantCulture) Toolkits (@_summary.InstallCount.ToString(CultureInfo.InvariantCulture) installed) · @(string.IsNullOrWhiteSpace(_summary.TenantCountry) ? "—" : _summary.TenantCountry) Tenant country · @(string.IsNullOrWhiteSpace(_summary.TenantKitCode) ? "—" : _summary.TenantKitCode) Active kit code.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Kit code</th>
                    <th>Name</th>
                    <th>Jurisdiction</th>
                    <th>Tax type</th>
                    <th>System</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_toolkits.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var t in _toolkits)
                    {
                        <tr id="erp-row-@t.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(t.Id, _openedId)">
                            <td><strong>@t.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(t.KitCode) ? "—" : t.KitCode)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.Name) ? "—" : t.Name)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.Jurisdiction) ? "—" : t.Jurisdiction)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.TaxType) ? "—" : t.TaxType)</td>
                            <td>@(t.IsSystem ? "yes" : "no")</td>
                            <td>@(t.Active ? "yes" : "no")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "toolkit_id", t.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>Tax toolkits are available on the platform Super CP host only.</p>
        <p><a href="/cp">Open Control Panel</a></p>
    </div>
}

@code {
    private const string _phpTab = "/CP/control/portal/epc_tax_toolkit_manage";
    private const string _listHref = "/cp/tax-toolkits-app";
    private bool _allowed;
    private bool _isAdmin;
    private CpTaxToolkitsSummary _summary = new(0, 0, "", "", "n/a", "");
    private IReadOnlyList<CpTaxToolkitDigest> _toolkits = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private CpTaxToolkitDetail? _openedToolkit;
    private IReadOnlyList<CpTaxToolkitInstallDigest> _openedInstalls = [];
    private IReadOnlyList<CpTaxToolkitUpdateDigest> _openedUpdates = [];

    private string OpenedCaption => _openedToolkit is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedToolkit.KitCode) ? ("Kit #" + _openedToolkit.Id.ToString(CultureInfo.InvariantCulture)) : _openedToolkit.KitCode)
            + " · " + (string.IsNullOrWhiteSpace(_openedToolkit.TaxType) ? "open" : _openedToolkit.TaxType);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "toolkit_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpTaxToolkitsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _toolkits = result.Toolkits;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpTaxToolkitDetailAsync(_openedId, ctx.RequestAborted);
            _openedToolkit = detail.Toolkit;
            _openedInstalls = detail.Installs;
            _openedUpdates = detail.Updates;
            if (_openedToolkit is not null)
            {
                var openedList = _toolkits.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _toolkits = new[] { openedList }.Concat(_toolkits.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
