@page "/cp/tax-toolkits-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Tax Toolkits · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-tax-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-tax-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-tax-hero p { margin:0; color:#bfdbfe; max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-tax-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-tax-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#1e3a8a; background:#93c5fd;
        }
        .epc-tax-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-tax-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-tax-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-tax-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-tax-kpi span { color:#64748b; font-size:.78rem; }
        .epc-tax-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-tax-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-tax-table th, .epc-tax-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-tax-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-tax-note { margin-top:1rem; padding:.75rem .9rem; background:#eff6ff; border:1px solid #93c5fd; border-radius:.45rem; color:#1e40af; font-size:.86rem; }
        @@media (max-width:900px){ .epc-tax-kpis{grid-template-columns:1fr;} }
    
</style>
</HeadContent>


@if (_allowed)
{
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-tax-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Tax Toolkits</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-tax-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/cp/pos-overview-app">POS overview</a>
        </div>
    </section>

    <div class="epc-tax-kpis" aria-label="Tax toolkit stats">
        <div class="epc-tax-kpi"><strong>@_summary.ToolkitCount.ToString(CultureInfo.InvariantCulture)</strong><span>Toolkits (@_summary.InstallCount.ToString(CultureInfo.InvariantCulture) installed)</span></div>
        <div class="epc-tax-kpi"><strong>@(string.IsNullOrWhiteSpace(_summary.TenantCountry) ? "—" : _summary.TenantCountry)</strong><span>Tenant country</span></div>
        <div class="epc-tax-kpi"><strong>@(string.IsNullOrWhiteSpace(_summary.TenantKitCode) ? "—" : _summary.TenantKitCode)</strong><span>Active kit code</span></div>
    </div>

    <div class="epc-tax-table-wrap">
        <table class="epc-tax-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Kit code</th>
                    <th>Name</th>
                    <th>Jurisdiction</th>
                    <th>Tax type</th>
                    <th>System</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_toolkits.Count == 0)
                {
                    <tr><td colspan="8">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var t in _toolkits)
                    {
                        <tr>
                            <td><strong>@t.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(t.KitCode) ? "—" : t.KitCode)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.Name) ? "—" : t.Name)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.Jurisdiction) ? "—" : t.Jurisdiction)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.TaxType) ? "—" : t.TaxType)</td>
                            <td>@(t.IsSystem ? "yes" : "no")</td>
                            <td>@(t.Active ? "yes" : "no")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>Tax toolkits are available on the platform Super CP host only.</p>
        <p><a href="/cp">Open Control Panel</a></p>
    </div>
}

@code {
    private const string _phpTab = "/CP/control/portal/epc_tax_toolkit_manage";
    private bool _allowed;
    private bool _isAdmin;
    private CpTaxToolkitsSummary _summary = new(0, 0, "", "", "n/a", "");
    private IReadOnlyList<CpTaxToolkitDigest> _toolkits = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpTaxToolkitsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _toolkits = result.Toolkits;
        _source = result.Source;
        _message = result.Message;
    }
}
