@page "/erp/on-premises-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>On-Premises · ERP · ECOM AE</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="On-Premises" BreadcrumbArea="Platform" BreadcrumbTab="On-Premises">

    
    <PhpErpModulePageHeader Title="On-Premises Deployment" Subtitle="Live shop digest. Writes stay on ERP ajax." PhpTabHref="@_phpTab" />


    <div class="epc-op-grid" aria-label="On-premises tracks">
        <div class="epc-op-card">
            <h3>Installer pack</h3>
            <p><code>deploy/on-premises/*</code> — setup wizard, Docker compose, backup, and health-check for self-hosted installs.</p>
        </div>
        <div class="epc-op-card">
            <h3>License + health APIs</h3>
            <p><code>api/v1/licenses/activate</code> + <code>api/v1/on-premises/health</code>. Dry-runs: <code>/erp/on-premises/health-dry-run</code> + <code>/erp/on-premises/license-activate-dry-run</code> (writes=0).</p>
        </div>
        <div class="epc-op-card">
            <h3>≠ ERP-only SaaS</h3>
            <p>Hosted multi-tenant ERP-only is separate from self-hosted on-premises. Both product tracks stay available under the platform mandate.</p>
        </div>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Platform mandate locks remain in force until release-owner approval. Use the dual-sample compare board before any exact-route promotion.
    </div>
    <p class="epc-op-mandate">
        On-Premises overview — compare against the archive tab before promoting installer pack routes.
    </p>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private readonly string _phpTab = "/ERP/?epc_erp_shell=1&tab=on_premises";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }
    }
}
