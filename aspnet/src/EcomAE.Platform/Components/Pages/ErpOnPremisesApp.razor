@page "/erp/on-premises-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>On-Premises · ERP · ECOM AE</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="On-Premises" BreadcrumbArea="Platform" BreadcrumbTab="On-Premises">

    <PhpErpModulePageHeader Title="On-Premises Deployment"
                            Subtitle="Open a license for the notes excerpt and issued times. Fingerprint, IP, and modules stay omitted. License keys stay masked. Activate stays Classic."
                            PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="/erp/on-premises-app" />

    @if (_openedDetail is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="/erp/on-premises-app">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>License id</dt><dd>@_openedDetail.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Customer</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.CustomerName) ? "—" : _openedDetail.CustomerName)</dd>
                <dt>Tier</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.Tier) ? "—" : _openedDetail.Tier)</dd>
                <dt>Users max</dt><dd>@_openedDetail.UsersMax.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.Status) ? "—" : _openedDetail.Status)</dd>
                <dt>Hostname</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.Hostname) ? "—" : _openedDetail.Hostname)</dd>
                <dt>Issued</dt><dd>@FormatTime(_openedDetail.IssuedAt)</dd>
                <dt>Activated</dt><dd>@FormatTime(_openedDetail.ActivatedAt)</dd>
                <dt>Last seen</dt><dd>@FormatTime(_openedDetail.LastSeenAt)</dd>
                <dt>Expires</dt><dd>@FormatTime(_openedDetail.ExpiresAt)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Fingerprint, IP, and modules stay omitted. License keys stay masked. Activate stays Classic.</p>
            @if (!string.IsNullOrWhiteSpace(_openedDetail.NotesExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">Notes excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedDetail.NotesExcerpt</pre>
                @if (_openedDetail.NotesLen > _openedDetail.NotesExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_openedDetail.NotesExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedDetail.NotesLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No notes excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Customer</th><th>Tier</th><th>Expires</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.CustomerName) ? "—" : sib.CustomerName)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Tier) ? "—" : sib.Tier)</td>
                                <td>@FormatTime(sib.ExpiresAt)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href("/erp/on-premises-app", "license_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="On-premises KPIs">
        <div class="kpi"><div class="lbl">Licenses shown</div><div class="val">@_licenses.Count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_activeCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Digest source</div><div class="val">@_source</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Tier</th>
                    <th>Users max</th>
                    <th>Status</th>
                    <th>Hostname</th>
                    <th>License</th>
                    <th>Expires</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_licenses.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No on-premises licenses yet." : _message) : "Sign in with ERP capability for live licenses.")</td></tr>
                }
                else
                {
                    @foreach (var row in _licenses)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(row.CustomerName) ? $"#{row.Id}" : row.CustomerName)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Tier) ? "—" : row.Tier)</td>
                            <td>@row.UsersMax.ToString(CultureInfo.InvariantCulture)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Hostname) ? "—" : row.Hostname)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.LicenseKeyPreview) ? "—" : row.LicenseKeyPreview)</td>
                            <td>@FormatTime(row.ExpiresAt)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href("/erp/on-premises-app", "license_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Fingerprint and IP stay omitted; license keys stay masked. Notes load on Open. Activate and health stay on the dry-run routes
        (<code>/erp/on-premises/license-activate-dry-run</code>, <code>/erp/on-premises/health-dry-run</code>).
        Installer pack: <code>deploy/on-premises/*</code>.
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&tab=on_premises";
    private bool _isAdmin;
    private IReadOnlyList<OnPremisesLicenseDigest> _licenses = [];
    private int _activeCount;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private OnPremisesLicenseDigest? _openedLicense;
    private OnPremisesLicenseDetail? _openedDetail;
    private IReadOnlyList<OnPremisesLicenseSiblingDigest> _openedSiblings = [];

    private bool OpenedFound => _openedDetail is not null || _openedLicense is not null;

    private string OpenedReturnHref => _openedId > 0
        ? "/erp/on-premises-app?license_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : "/erp/on-premises-app";

    private string OpenedCaption => _openedDetail is not null
        ? (string.IsNullOrWhiteSpace(_openedDetail.CustomerName) ? ("License #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.CustomerName)
            + (string.IsNullOrWhiteSpace(_openedDetail.Status) ? "" : (" · " + _openedDetail.Status))
        : _openedLicense is null
            ? ""
            : (string.IsNullOrWhiteSpace(_openedLicense.CustomerName) ? $"License #{_openedLicense.Id}" : _openedLicense.CustomerName);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            return;
        }

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "license_id");
        var result = await Dashboards.ListOnPremisesLicensesAsync(100, ctx.RequestAborted);
        _licenses = result.Licenses;
        _openedLicense = _openedId > 0 ? _licenses.FirstOrDefault(l => l.Id == _openedId) : null;
        if (_openedLicense is not null)
        {
            _licenses = new[] { _openedLicense }.Concat(_licenses.Where(l => l.Id != _openedId)).ToList();
        }
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildOnPremisesLicenseDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.License;
            _openedSiblings = detail.Siblings;
            if (_openedDetail is null && !string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
        _activeCount = _licenses.Count(l => string.Equals(l.Status, "active", StringComparison.OrdinalIgnoreCase));
        _source = result.Source;
        if (string.IsNullOrWhiteSpace(_message))
        {
            _message = result.Message;
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).UtcDateTime.ToString("dd MMM yyyy", CultureInfo.InvariantCulture);
    }
}
