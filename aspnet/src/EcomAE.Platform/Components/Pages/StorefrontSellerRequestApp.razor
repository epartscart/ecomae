@page "/storefront/seller-request-app"
@page "/en/zapros-prodavczu"
@page "/zapros-prodavczu"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>Request to seller · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" />

<StorefrontTenantChrome>
    <PhpStorefrontPageHeader Title="Request to seller"
                            Subtitle="Describe the VIN or frame and the parts you need. The store replies on My requests.">
        <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.CustomerRequests">My requests</a>
        <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.GarageLogin">Garage</a>
        <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.LaximoVin">VIN / Frame</a>
    </PhpStorefrontPageHeader>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
    }
    <div class="section-form">
        <form class="request-seller" method="post" id="requestSeller" action="@PhpSellerRequest.SellerWriteHref">
            <input type="hidden" name="confirmWrites" value="true" />
            <div class="all-input">
                <div class="main-input">
                    <h2>Vehicle and contact</h2>
                    @foreach (var field in PhpSellerRequest.Fields)
                    {
                        <div class="input-shell">
                            <label for="@field.Name">@field.Label@(field.Required ? " *" : "")</label>
                            @if (field.Required)
                            {
                                <input id="@field.Name" class="form-control" type="text" name="@field.Name" placeholder="@field.Placeholder" required />
                            }
                            else
                            {
                                <input id="@field.Name" class="form-control" type="text" name="@field.Name" placeholder="@field.Placeholder" />
                            }
                        </div>
                    }
                    <div class="input-shell">
                        <label for="client_parts">Parts needed *</label>
                        <textarea id="client_parts" class="form-control" name="client_parts" rows="4" required placeholder="Articles, names, quantities"></textarea>
                    </div>
                    <div class="input-shell">
                        <label style="display:flex;gap:.5rem;align-items:flex-start;font-weight:500;margin:0 0 1rem">
                            <input type="checkbox" name="users_agreement" value="yes" required style="margin-top:.2rem" />
                            <span>I accept the <a href="/polzovatelskoe-soglashenie" target="_blank">user agreement</a>.</span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="send-input">
                <div class="button-shell">
                    <button type="submit" class="btnForm btn btn-ar btn-primary">Send request</button>
                </div>
            </div>
        </form>
    </div>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx?.Request.Host.Host);
        _flashOk = ctx?.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx?.Request.Query["err"].ToString() ?? "";
    }
}
