@page "/storefront/seller-request-app"
@page "/en/zapros-prodavczu"
@page "/zapros-prodavczu"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>Request to seller · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" />

<StorefrontTenantChrome>
    <section style="padding:2rem 0 3rem">
        <div class="container" style="max-width:48rem">
            <p style="margin:0 0 .35rem;color:#64748b;font-size:.85rem">
                <a href="@StorefrontSurfaceLinks.CustomerRequests">My requests</a>
                · Request to seller
                ·
                <a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(StorefrontPhpCanonical.SellerRequest)" target="_blank" rel="noopener">Classic twin</a>
            </p>
            <h1 style="margin:.1rem 0 .4rem">Send a request to seller</h1>
            <p style="color:#475569">Describe the VIN or frame and the parts you need. The store replies on My requests. Photos and manager email stay on the Classic twin.</p>
            @if (!string.IsNullOrWhiteSpace(_flashOk))
            {
                <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
            }
            @if (!string.IsNullOrWhiteSpace(_flashErr))
            {
                <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
            }
            <form method="post" action="@PhpSellerRequest.SellerWriteHref" style="background:#fff;border:1px solid #e2e8f0;border-radius:.55rem;padding:1.1rem 1.2rem">
                <input type="hidden" name="confirmWrites" value="true" />
                @foreach (var field in PhpSellerRequest.Fields)
                {
                    <label for="@field.Name">@field.Label@(field.Required ? " *" : "")</label>
                    @if (field.Required)
                    {
                        <input id="@field.Name" type="text" name="@field.Name" placeholder="@field.Placeholder" required
                               style="width:100%;margin:.25rem 0 .75rem;padding:.5rem" />
                    }
                    else
                    {
                        <input id="@field.Name" type="text" name="@field.Name" placeholder="@field.Placeholder"
                               style="width:100%;margin:.25rem 0 .75rem;padding:.5rem" />
                    }
                }
                <label for="client_parts">Parts needed *</label>
                <textarea id="client_parts" name="client_parts" rows="4" required placeholder="Articles, names, quantities"
                          style="width:100%;margin:.25rem 0 1rem;padding:.5rem"></textarea>
                <button type="submit" style="padding:.65rem 1.1rem;border:0;border-radius:.45rem;background:#dc2626;color:#fff;font-weight:800;cursor:pointer">Send request</button>
            </form>
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx?.Request.Host.Host);
        _flashOk = ctx?.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx?.Request.Query["err"].ToString() ?? "";
    }
}
