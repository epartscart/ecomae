@page "/erp/mailbox-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Mail
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Components.Shared.Desktop
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject IMailboxInboxService Inbox
@inject IPlatformMailService Mail

<PageTitle>Mailbox · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Mailbox" BreadcrumbArea="Workspace" BreadcrumbTab="Mailbox">
    <PhpErpModulePageHeader Title="Mailbox" Subtitle="This tenant’s login and ops mail only — isolated by site_key. Super CP / BOS provisions domains; ERP never reads another tenant." PhpTabHref="" />

    @if (!_isAdmin)
    {
        <div class="alert alert-info" role="status">Sign in with an ERP / CP admin session to read this tenant’s mailbox.</div>
    }

    <p>
        <a href="/cp/mailbox-app">Open in Control Panel</a>
        · <a href="/cp/tenant-email-app">Outgoing SMTP</a>
        @if (_isSuper)
        {
            <text> · <a href="/cp/super-mail-app">Platform mail setup</a></text>
        }
    </p>

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Mailbox KPIs">
        <div class="kpi"><div class="lbl">site_key</div><div class="val">@_siteKey</div></div>
        <div class="kpi"><div class="lbl">Mailboxes</div><div class="val">@_boxes.Count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Opened</div><div class="val">@(string.IsNullOrWhiteSpace(_opened) ? "—" : _opened)</div></div>
    </div>

    @if (_boxes.Count == 0)
    {
        <div class="alert alert-warning" role="status">No mailbox is assigned to this tenant yet. Super CP adds the domain and creates the mailbox for this site_key.</div>
    }
    else
    {
        <div class="epc-erp-table-wrap">
            <table class="table">
                <thead><tr><th>Mailbox</th><th>SMTP</th><th></th></tr></thead>
                <tbody>
                @foreach (var box in _boxes)
                {
                    var smtp = Mail.SmtpFor(box.Address);
                    <tr>
                        <td>@box.Address</td>
                        <td>@smtp.Host:@smtp.Port @smtp.Encryption</td>
                        <td><a href="/erp/mailbox-app?address=@Uri.EscapeDataString(box.Address)">Open inbox</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }

    @if (!string.IsNullOrWhiteSpace(_opened))
    {
        <div class="epc-erp-table-wrap" style="margin-top:12px">
            <strong>Inbox · @_opened</strong>
            <table class="table">
                <thead><tr><th>When</th><th>From</th><th>Subject</th><th>Excerpt</th></tr></thead>
                <tbody>
                @if (_messages.Count == 0)
                {
                    <tr><td colspan="4">No messages yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _messages)
                    {
                        <tr>
                            <td>@row.ReceivedUtc.ToString("u", CultureInfo.InvariantCulture)</td>
                            <td>@row.From</td>
                            <td>@row.Subject</td>
                            <td>@row.Excerpt</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    }
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private bool _isSuper;
    private string _siteKey = "tenant";
    private string _opened = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private IReadOnlyList<PlatformMailbox> _boxes = [];
    private IReadOnlyList<MailboxMessage> _messages = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        _isSuper = SuperCpHostGate.IsAllowed(ctx);
        _siteKey = PlatformMailNormalize.SiteKey(ctx.Request.Query["site_key"].ToString(), _isSuper, ctx.Request.Host.Host);
        _boxes = Inbox.ListForCaller(_siteKey, _isSuper);
        if (!_isAdmin)
        {
            return;
        }

        _opened = ctx.Request.Query["address"].ToString();
        if (string.IsNullOrWhiteSpace(_opened) && _boxes.Count == 1)
        {
            _opened = _boxes[0].Address;
        }

        if (string.IsNullOrWhiteSpace(_opened))
        {
            return;
        }

        var read = await Inbox.ReadAsync(_siteKey, _isSuper, _opened, 40, ctx.RequestAborted);
        _messages = read.Messages;
        if (read.Ok)
        {
            _flashOk = read.Message;
        }
        else
        {
            _flashErr = read.Message;
        }
    }
}
