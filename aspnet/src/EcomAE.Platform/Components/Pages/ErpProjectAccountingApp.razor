                <p class="text-muted" style="margin:.85rem 0 .35rem">detail excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedRec.DetailExcerpt</pre>
                @if (_openedRec.DetailLen > _openedRec.DetailExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_openedRec.DetailExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedRec.DetailLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No detail excerpt yet.</p>
            }
            @if (_openedRecSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-project siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Method</th><th>% complete</th><th>WIP</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedRecSiblings)
                        {
                            <tr>
                                <td>@sib.Method</td>
                                <td>@sib.PctComplete.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@sib.Wip.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "prja_rec_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-project siblings yet.</p>
            }
        </div>
    }

    @if (_workArea == "ledger")
    {
    <h2 style="font-size:16px;">Budgets</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Project</th><th>Category</th><th class="text-right">Cost</th><th class="text-right">Revenue</th><th></th></tr></thead>
            <tbody>
                @if (_budgets.Count == 0)
                {
                    <tr><td colspan="5">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No project budgets yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _budgets)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedBudgetId)">
                            <td>@(row.ProjectId > 0 ? row.ProjectId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><strong>@row.Category</strong></td>
                            <td class="text-right">@row.CostBudget.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.RevenueBudget.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "prja_budget_id", row.Id)">Open</a></td>
                        </tr>
                    }
                    <tr style="font-weight:600;background:#f2f6fa">
                        <td colspan="2">Total</td>
                        <td class="text-right">@_budgets.Sum(r => r.CostBudget).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td class="text-right">@_budgets.Sum(r => r.RevenueBudget).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h2 style="font-size:16px;">Transactions</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Project</th><th>Type</th><th>Category</th><th>Description</th><th class="text-right">Amount</th><th></th></tr></thead>
            <tbody>
                @if (_txns.Count == 0) { <tr><td colspan="6">No project transactions yet.</td></tr> }
                else
                {
                    @foreach (var row in _txns)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedTxnId)">
                            <td>@(row.ProjectId > 0 ? row.ProjectId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@row.TxnType</td>
                            <td>@row.Category</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Description) ? "—" : row.Description)</td>
                            <td class="text-right">@row.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "prja_txn_id", row.Id)">Open</a></td>
                        </tr>
                    }
                    <tr style="font-weight:600;background:#f2f6fa">
                        <td colspan="4">Total</td>
                        <td class="text-right">@_txns.Sum(r => r.Amount).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h2 style="font-size:16px;">Recognition</h2>
    @if (_isAdmin)
    {
        <section class="epc-erp-form-panel">
            <div class="epc-erp-form-panel__head"><strong>Run recognition</strong></div>
            <form method="post" action="/erp/ajax/prja-recognize">
                <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
                <ErpMasterPicker Kind="project" FieldName="project_id" Label="Project" Required="true" Min="1" />
                <label>Method
                    <select name="method">
                        <option value="poc">percentage of completion</option>
                        <option value="completed">completed contract</option>
                        <option value="straight_line">straight line</option>
                    </select>
                </label>
                <label>Fraction <input type="number" name="fraction" min="0" max="1" step="0.0001" value="0" /></label>
                <label>As of <input type="date" name="as_of" /></label>
                <label>Company id <input type="number" name="company_id" min="0" value="0" /></label>
                <div class="form-actions">
                    <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
                    <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Run recognition</button>
                </div>
            </form>
        </section>
    }
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Project</th><th>Method</th><th class="text-right">% complete</th><th class="text-right">Revenue</th><th class="text-right">Cost</th><th class="text-right">WIP</th><th></th></tr></thead>
            <tbody>
                @if (_recs.Count == 0) { <tr><td colspan="7">No recognition runs yet.</td></tr> }
                else
                {
                    @foreach (var row in _recs)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedRecId)">
                            <td>@(row.ProjectId > 0 ? row.ProjectId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@row.Method</td>
                            <td class="text-right">@row.PctComplete.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.RecognizedRevenue.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.RecognizedCost.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.Wip.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "prja_rec_id", row.Id)">Open</a></td>
                        </tr>
                    }
                    <tr style="font-weight:600;background:#f2f6fa">
                        <td colspan="3">Total</td>
                        <td class="text-right">@_recs.Sum(r => r.RecognizedRevenue).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td class="text-right">@_recs.Sum(r => r.RecognizedCost).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td class="text-right">@_recs.Sum(r => r.Wip).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    }

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
        Budget, transaction, and recognition writes are live when confirmed.
    </div>
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=projects&tab=project_accounting";
    private const string _listHref = "/erp/project-accounting-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpPrjaBudgetDigest> _budgets = [];
    private IReadOnlyList<ErpPrjaTxnDigest> _txns = [];
    private IReadOnlyList<ErpPrjaRecognitionDigest> _recs = [];
    private int _count, _txnCount, _recCount;
    private string _source = "n/a";
    private string _message = "";
    private long _openedBudgetId;
    private long _openedTxnId;
    private long _openedRecId;
    private int _activeCompanyId;
    private string _workArea = "ledger";
    private EcomAE.Platform.Erp.ErpFitOutExecutiveDashboardResult? _exec;
    private EcomAE.Platform.Erp.ErpFitOutDeliveryDashboardResult? _delivery;
    private EcomAE.Platform.Erp.ErpFitOutOperationsReportResult? _ops;
    private EcomAE.Platform.Erp.ErpFitOutFinanceOperationsReportResult? _fin;
    private EcomAE.Platform.Erp.ErpFitOutApprovalQueueResult? _appr;

    private sealed record PrjaReportView(
        string Title,
        string Subtitle,
        IReadOnlyList<(string Label, string Value)> Lines,
        IReadOnlyList<string[]> Rows,
        string[]? Head,
        string Message);

    private PrjaReportView? _report;
    private string _reportKey = string.Empty;

    private MarkupString ReportHidden(string key)
    {
        var html = "<input type=\"hidden\" name=\"ws\" value=\"reports\" />"
            + "<input type=\"hidden\" name=\"report\" value=\"" + key + "\" />";
        if (_activeCompanyId > 0)
        {
            html += "<input type=\"hidden\" name=\"company\" value=\""
                + _activeCompanyId.ToString(CultureInfo.InvariantCulture) + "\" />";
        }
        return new MarkupString(html);
    }

    private string ProjectLabel(long projectId) => projectId > 0 ? "Project P-" + projectId : "All projects";

    private async Task<PrjaReportView> BuildReportAsync(string key, long projectId, long estimateId, CancellationToken ct)
    {
        var lines = new List<(string, string)>();
        var rows = new List<string[]>();
        string[]? head = null;
        string title, subtitle = ProjectLabel(projectId), message = string.Empty;
        switch (key)
        {
            case "estimate-revisions":
            {
                title = "Estimate revision comparison";
                var r = await FitOutEstimates.ReadAsync(projectId, ct);
                message = r.Message;
                head = new[] { "Code", "Title", "Rev", "Markup %", "Status", "BOQ lines", "Total cost", "Selling" };
                rows.AddRange(r.Revisions.Select(v => new[] { v.Code, v.Title, v.Revision.ToString(), Pct(v.MarkupPercent), v.Status, v.BoqLineCount.ToString(), Money(v.TotalCost), Money(v.SellingAmount) }));
                foreach (var d in r.Deltas)
                {
                    lines.Add(("Rev " + d.FromRevision + " → " + d.ToRevision, "cost " + Money(d.CostDelta) + " · selling " + Money(d.SellingDelta) + " · lines " + d.BoqLineDelta));
                }
                break;
            }
            case "estimate-boq":
            {
                title = "Estimate / BOQ";
                var r = await FitOutBoq.ReadAsync(estimateId, ct);
                message = r.Message;
                subtitle = r.Estimate is null ? "Estimate " + estimateId : r.Estimate.Code + " · " + r.Estimate.Title + " · rev " + r.Estimate.Revision;
                lines.Add(("Total cost", Money(r.TotalCost)));
                lines.Add(("Selling amount", Money(r.SellingAmount)));
                head = new[] { "Section", "Description", "Cost type", "Qty", "Unit", "Total cost", "Selling" };
                rows.AddRange(r.Lines.Select(l => new[] { l.Section, l.Description, l.CostType, l.Quantity.ToString("0.##"), l.Unit, Money(l.TotalCost), Money(l.SellingAmount) }));
                break;
            }
            case "approval-evidence":
            {
                title = "Approval evidence";
                var r = await FitOutApprovalEvidence.ReadAsync(projectId, ct);
                message = r.Message;
                lines.Add(("Pending amount", Money(r.PendingAmount)));
                head = new[] { "Type", "Reference", "Title", "Amount", "Status / decision" };
                rows.AddRange(r.Pending.Select(p => new[] { p.RecordType, p.Reference, p.Title, Money(p.Amount), p.Status }));
                rows.AddRange(r.Decisions.Select(d => new[] { d.RecordType, d.Reference, "admin " + d.AdminId, "", d.Decision + " · " + d.DecidedAtUtc.ToString("yyyy-MM-dd") }));
                break;
            }
            case "project-pnl":
            {
                title = "Project P&L / forecast";
                var r = await FitOutProjectPnl.ReadAsync(projectId > 0 ? projectId : null, ct);
                message = r.Message;
                head = new[] { "Project", "Revenue budget", "Cost budget", "Actual revenue", "Actual cost", "Budget margin", "Actual margin", "Forecast revenue", "Forecast cost", "Forecast profit" };
                rows.AddRange(r.Rows.Select(p => new[] { "P-" + p.ProjectId, Money(p.RevenueBudget), Money(p.CostBudget), Money(p.ActualRevenue), Money(p.ActualCost), Money(p.BudgetMargin), Money(p.ActualMargin), Money(p.ForecastRevenue), Money(p.ForecastCost), Money(p.ForecastProfit) }));
                break;
            }
            case "invoice-bridge":
            {
                title = "VAT / invoice links";
                var r = await FitOutInvoiceBridge.ReadAsync(projectId, ct);
                message = r.Message;
                head = new[] { "Invoice", "Stage", "Reference", "Ex-VAT", "VAT", "Incl-VAT", "Currency", "Status" };
                rows.AddRange(r.Rows.Select(x => new[] { x.InvoiceNumber, x.Stage, x.Reference, Money(x.SubtotalExVat), Money(x.TotalVat), Money(x.TotalInclVat), x.CurrencyCode, x.InvoiceStatus }));
                break;
            }
            case "invoice-reconciliation":
            {
                title = "Billing reconciliation";
                var r = await FitOutInvoiceRecon.ReadAsync(projectId, ct);
                message = r.Message;
                lines.Add(("Certified amount", Money(r.CertifiedAmount)));
                lines.Add(("Client certified", Money(r.ClientCertifiedAmount)));
                lines.Add(("Subcontract certified", Money(r.SubcontractCertifiedAmount)));
                lines.Add(("Invoiced ex-VAT", Money(r.InvoicedExVat)));
                lines.Add(("Invoiced VAT", Money(r.InvoicedVat)));
                lines.Add(("Invoiced incl-VAT", Money(r.InvoicedInclVat)));
                lines.Add(("Unbilled certified", Money(r.UnbilledCertifiedAmount)));
                break;
            }
            case "commercial-reconciliation":
            {
                title = "Contract balance";
                var r = await FitOutCommercial.ReadAsync(projectId, ct);
                message = r.Message;
                lines.Add(("Contract value", Money(r.ContractValue)));
                lines.Add(("Approved variations", Money(r.ApprovedVariationAmount)));
                lines.Add(("Budget cost", Money(r.BudgetCost)));
                lines.Add(("Certified / client certified", Money(r.CertifiedAmount) + " / " + Money(r.ClientCertifiedAmount)));
                lines.Add(("Subcontract certified", Money(r.SubcontractCertifiedAmount)));
                lines.Add(("Vendor bills / payments", Money(r.VendorBills) + " / " + Money(r.PaymentVouchers)));
                lines.Add(("Client billed", Money(r.ClientBilled)));
                lines.Add(("Retention held / released", Money(r.RetentionHeld) + " / " + Money(r.RetentionReleased)));
                lines.Add(("Unbilled client", Money(r.UnbilledClientAmount)));
                lines.Add(("Unpaid vendor", Money(r.UnpaidVendorAmount)));
                lines.Add(("Forecast margin", Money(r.ForecastMargin)));
                break;
            }
            case "contract-closure":
            {
                title = "Contract closure";
                var r = await FitOutContractClosure.ReadAsync(projectId, ct);
                message = r.Message;
                lines.Add(("Ready to close", r.CanClose ? "Yes" : "No"));
                lines.Add(("Pending approvals", r.PendingApprovalCount + " · " + Money(r.PendingApprovalAmount)));
                lines.Add(("Completion certificates", r.ApprovedCompletionCertificateCount.ToString()));
                lines.Add(("Final settlements", r.ApprovedFinalSettlementCount.ToString()));
                lines.Add(("Unbilled client", Money(r.UnbilledClientAmount)));
                lines.Add(("Unpaid vendor / subcontract", Money(r.UnpaidVendorAmount) + " / " + Money(r.UnpaidSubcontractCertifiedAmount)));
                lines.Add(("Subcontract overrun", Money(r.SubcontractOverrunAmount)));
                lines.Add(("Retention held", Money(r.RetentionHeld)));
                foreach (var b in r.Blockers) lines.Add(("Blocker", b));
                break;
            }
            case "retention-ageing":
            {
                title = "Retention ageing";
                var r = await FitOutRetention.ReadAsync(projectId, ct);
                message = r.Message;
                lines.Add(("Retention held", Money(r.RetentionHeld)));
                lines.Add(("Held since", r.BaseDate?.ToString("yyyy-MM-dd") ?? "—"));
                lines.Add(("Warranty ends", r.WarrantyEndDate?.ToString("yyyy-MM-dd") ?? "—"));
                lines.Add(("Days held", r.DaysHeld.ToString()));
                lines.Add(("Ageing bucket", r.AgeingBucket));
                lines.Add(("Release eligible", (r.ReleaseEligible ? "Yes" : "No") + " — " + r.EligibilityReason));
                break;
            }
            case "proforma-receipts":
            {
                title = "Proforma / receipts";
                var r = await FitOutProforma.ReadAsync(projectId, ct);
                message = r.Message;
                lines.Add(("Total invoiced", Money(r.TotalInvoiced)));
                lines.Add(("Total receipts", Money(r.TotalReceipts)));
                lines.Add(("Outstanding", Money(r.TotalOutstanding)));
                head = new[] { "Stage", "Invoices", "Ex-VAT", "VAT", "Incl-VAT", "Receipts", "Outstanding" };
                rows.AddRange(r.Rows.Select(x => new[] { x.Stage, x.InvoiceCount.ToString(), Money(x.InvoicedExVat), Money(x.InvoicedVat), Money(x.InvoicedInclVat), Money(x.Receipts), Money(x.Outstanding) }));
                break;
            }
            case "approval-audit":
            {
                title = "Approval audit";
                var r = await FitOutAudit.ReadAsync(projectId, ct);
                if (r.Count == 0) message = "No approval decisions recorded for this project.";
                head = new[] { "Type", "Reference", "Decision", "By", "When (UTC)" };
                rows.AddRange(r.Select(x => new[] { x.RecordType, x.Reference, x.Decision, "admin " + x.AdminId, x.DecidedAtUtc.ToString("yyyy-MM-dd HH:mm") }));
                break;
            }
            case "subcontract-reconciliation":
            {
                title = "Subcontract reconciliation";
                var r = await FitOutSubcontract.ReadAsync(projectId, ct);
                message = r.Message;
                lines.Add(("Ordered", Money(r.OrderedAmount)));
                lines.Add(("Measured", Money(r.MeasuredAmount)));
                lines.Add(("Certified", Money(r.CertifiedAmount)));
                lines.Add(("Payment certified", Money(r.PaymentCertifiedAmount)));
                lines.Add(("Approved payments", Money(r.ApprovedPayments)));
                lines.Add(("Uncertified", Money(r.UncertifiedAmount)));
                lines.Add(("Unpaid certified", Money(r.UnpaidCertifiedAmount)));
                break;
            }
            case "approval-queue":
            {
                title = "Pending approvals";
                var r = await FitOutApprovals.ReadAsync(projectId > 0 ? projectId : null, ct);
                message = r.Message;
                lines.Add(("Pending items", r.Rows.Count.ToString()));
                lines.Add(("Pending value", Money(r.TotalAmount)));
                head = new[] { "Project", "Type", "Reference", "Title", "Amount", "Status" };
                rows.AddRange(r.Rows.Select(x => new[] { "P-" + x.ProjectId, x.RecordType, x.Reference, x.Title, Money(x.Amount), x.Status }));
                break;
            }
            case "acceptance-evidence":
            {
                title = "Acceptance evidence";
                var r = await FitOutAcceptance.ReadAsync(projectId, ct);
                message = r.Message;
                lines.Add(("Machine checks", r.MachineChecksPassed ? "Passed" : "Incomplete"));
                head = new[] { "Check", "Status", "Evidence" };
                rows.AddRange(r.Checks.Select(c => new[] { c.Key, c.Status, c.Evidence }));
                break;
            }
            case "recovery-summary":
            {
                title = "Recovery summary";
                var r = await FitOutRecovery.ReadAsync(projectId, ct);
                message = r.Message;
                lines.Add(("Advance % / retention %", Pct(r.AdvancePercent) + " / " + Pct(r.RetentionPercent)));
                lines.Add(("Certified / client certified", Money(r.CertifiedAmount) + " / " + Money(r.ClientCertifiedAmount)));
                lines.Add(("Subcontract certified", Money(r.SubcontractCertifiedAmount)));
                lines.Add(("Advance recovered / outstanding", Money(r.AdvanceRecovered) + " / " + Money(r.AdvanceOutstanding)));
                lines.Add(("Retention recovered / outstanding", Money(r.RetentionRecovered) + " / " + Money(r.RetentionOutstanding)));
                break;
            }
            default:
                title = "Report";
                message = "Unknown report '" + key + "'.";
                break;
        }
        if (lines.Count == 0 && rows.Count == 0 && string.IsNullOrWhiteSpace(message))
        {
            message = "No data for this selection — load the demo sample data or pick another project.";
        }
        return new PrjaReportView(title, subtitle, lines, rows, head, message);
    }

    private static string Money(decimal value)
        => value.ToString("#,##0.00", CultureInfo.InvariantCulture);

    private static string Pct(decimal value)
        => value.ToString("0.##", CultureInfo.InvariantCulture) + "%";

    private static string VisualMessage(string source, string message, string empty)
        => source == "database-error" ? "Report error: " + message : empty;
    private ErpPrjaBudgetDetail? _openedBudget;
    private ErpPrjaTxnDetail? _openedTxn;
    private ErpPrjaRecognitionDetail? _openedRec;
    private IReadOnlyList<ErpPrjaBudgetDigest> _openedBudgetSiblings = [];
    private IReadOnlyList<ErpPrjaTxnDigest> _openedTxnSiblings = [];
    private IReadOnlyList<ErpPrjaRecognitionDigest> _openedRecSiblings = [];

    private long _openedId => _openedRecId > 0 ? _openedRecId : (_openedTxnId > 0 ? _openedTxnId : _openedBudgetId);

    private bool OpenedFound => _openedBudget is not null || _openedTxn is not null || _openedRec is not null;

    private string OpenedBudgetReturnHref => _openedBudgetId > 0
        ? _listHref + "?prja_budget_id=" + _openedBudgetId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedTxnReturnHref => _openedTxnId > 0
        ? _listHref + "?prja_txn_id=" + _openedTxnId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedRecReturnHref => _openedRecId > 0
        ? _listHref + "?prja_rec_id=" + _openedRecId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedBudgetCaption => _openedBudget is null
        ? ""
        : ("Budget #" + _openedBudget.Id.ToString(CultureInfo.InvariantCulture)
            + (string.IsNullOrWhiteSpace(_openedBudget.Category) ? "" : (" · " + _openedBudget.Category)));

    private string OpenedTxnCaption => _openedTxn is null
        ? ""
        : ("Txn #" + _openedTxn.Id.ToString(CultureInfo.InvariantCulture)
            + (string.IsNullOrWhiteSpace(_openedTxn.TxnType) ? "" : (" · " + _openedTxn.TxnType)));

    private string OpenedRecCaption => _openedRec is null
        ? ""
        : ("Recognition #" + _openedRec.Id.ToString(CultureInfo.InvariantCulture)
            + (string.IsNullOrWhiteSpace(_openedRec.Method) ? "" : (" · " + _openedRec.Method)));

    private string OpenedCaption => _openedRec is not null
        ? OpenedRecCaption
        : (_openedTxn is not null ? OpenedTxnCaption : OpenedBudgetCaption);

    private string _companyScopeLabel => _activeCompanyId switch
    {
        3 => "FITOUT · Fit-out Company · Company 3",
        > 0 => $"Company {_activeCompanyId}",
        _ => "Current legal entity"
    };

    private string WorkHref(string area)
    {
        var href = _listHref + "?ws=" + area;
        if (_activeCompanyId > 0)
        {
            href += "&company=" + _activeCompanyId.ToString(CultureInfo.InvariantCulture);
        }

        return href;
    }

    private string WorkAreaClass(string area)
        => string.Equals(_workArea, area, StringComparison.Ordinal) ? "active" : "";

    private static string NormalizeWorkArea(string? raw)
    {
        var value = (raw ?? "").Trim().ToLowerInvariant();
        return value switch
        {
            "commercial" or "site" or "approvals" or "reports" => value,
            _ => "ledger"
        };
    }

    private string FitOutHref(string href)
    {
        if (_activeCompanyId <= 0)
        {
            return href;
        }

        var separator = href.Contains('?', StringComparison.Ordinal) ? "&" : "?";
        return href + separator + "company=" + _activeCompanyId.ToString(CultureInfo.InvariantCulture);
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _activeCompanyId = ErpHostContext.ActiveCompanyIdFromQuery(ctx.Request) ?? 0;
        _workArea = NormalizeWorkArea(ctx.Request.Query["ws"].ToString());
        _openedBudgetId = ErpRecordOpen.ReadId(ctx.Request, "prja_budget_id");
        _openedTxnId = ErpRecordOpen.ReadId(ctx.Request, "prja_txn_id");
        _openedRecId = ErpRecordOpen.ReadId(ctx.Request, "prja_rec_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpProjectAccountingDigestAsync(200, ctx.RequestAborted);
        _budgets = result.Budgets;
        _txns = result.Txns;
        _recs = result.Recognitions;
        _count = result.Count;
        _txnCount = result.TxnCount;
        _recCount = result.RecognitionCount;
        _source = result.Source;
        _message = result.Message;

        if (_workArea == "reports")
        {
            var ct = ctx.RequestAborted;
            _exec = await FitOutExecutive.ReadAsync(null, ct);
            _delivery = await FitOutDelivery.ReadAsync(null, ct);
            _ops = await FitOutOperations.ReadAsync(null, ct);
            _fin = await FitOutFinance.ReadAsync(null, ct);
            _appr = await FitOutApprovals.ReadAsync(null, ct);

            _reportKey = ctx.Request.Query["report"].ToString();
            if (!string.IsNullOrWhiteSpace(_reportKey))
            {
                long.TryParse(ctx.Request.Query["projectId"], NumberStyles.Integer, CultureInfo.InvariantCulture, out var projectId);
                long.TryParse(ctx.Request.Query["estimateId"], NumberStyles.Integer, CultureInfo.InvariantCulture, out var estimateId);
                _report = await BuildReportAsync(_reportKey, projectId, estimateId, ct);
            }
        }

        if (_openedBudgetId > 0)
        {
            var detail = await Dashboards.BuildErpPrjaBudgetDetailAsync(_openedBudgetId, ctx.RequestAborted);
            _openedBudget = detail.Budget;
            _openedBudgetSiblings = detail.Siblings;
            if (_openedBudget is not null)
            {
                var openedList = _budgets.FirstOrDefault(b => b.Id == _openedBudgetId);
                if (openedList is not null)
                {
                    _budgets = new[] { openedList }.Concat(_budgets.Where(b => b.Id != _openedBudgetId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }

        if (_openedTxnId > 0)
        {
            var detail = await Dashboards.BuildErpPrjaTxnDetailAsync(_openedTxnId, ctx.RequestAborted);
            _openedTxn = detail.Txn;
            _openedTxnSiblings = detail.Siblings;
            if (_openedTxn is not null)
            {
                var openedList = _txns.FirstOrDefault(t => t.Id == _openedTxnId);
                if (openedList is not null)
                {
                    _txns = new[] { openedList }.Concat(_txns.Where(t => t.Id != _openedTxnId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message) && _openedBudget is null)
            {
                _message = detail.Message;
            }
        }

        if (_openedRecId > 0)
        {
            var detail = await Dashboards.BuildErpPrjaRecognitionDetailAsync(_openedRecId, ctx.RequestAborted);
            _openedRec = detail.Recognition;
            _openedRecSiblings = detail.Siblings;
            if (_openedRec is not null)
            {
                var openedList = _recs.FirstOrDefault(r => r.Id == _openedRecId);
                if (openedList is not null)
                {
                    _recs = new[] { openedList }.Concat(_recs.Where(r => r.Id != _openedRecId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message) && _openedBudget is null && _openedTxn is null)
            {
                _message = detail.Message;
            }
        }
    }

    private string _returnUrl => "/erp/project-accounting-app";

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
