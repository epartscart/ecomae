        ? ""
        : ("Budget #" + _openedBudget.Id.ToString(CultureInfo.InvariantCulture)
            + (string.IsNullOrWhiteSpace(_openedBudget.Category) ? "" : (" · " + _openedBudget.Category)));

    private string OpenedTxnCaption => _openedTxn is null
        ? ""
        : ("Txn #" + _openedTxn.Id.ToString(CultureInfo.InvariantCulture)
            + (string.IsNullOrWhiteSpace(_openedTxn.TxnType) ? "" : (" · " + _openedTxn.TxnType)));

    private string OpenedRecCaption => _openedRec is null
        ? ""
        : ("Recognition #" + _openedRec.Id.ToString(CultureInfo.InvariantCulture)
            + (string.IsNullOrWhiteSpace(_openedRec.Method) ? "" : (" · " + _openedRec.Method)));

    private string OpenedCaption => _openedRec is not null
        ? OpenedRecCaption
        : (_openedTxn is not null ? OpenedTxnCaption : OpenedBudgetCaption);

    private string _companyScopeLabel => _activeCompanyId switch
    {
        3 => "FITOUT · Fit-out Company · Company 3",
        > 0 => $"Company {_activeCompanyId}",
        _ => "Current legal entity"
    };

    private string WorkHref(string area)
    {
        var href = _listHref + "?ws=" + area;
        if (_activeCompanyId > 0)
        {
            href += "&company=" + _activeCompanyId.ToString(CultureInfo.InvariantCulture);
        }

        return href;
    }

    private string WorkAreaClass(string area)
        => string.Equals(_workArea, area, StringComparison.Ordinal) ? "active" : "";

    private static string NormalizeWorkArea(string? raw)
    {
        var value = (raw ?? "").Trim().ToLowerInvariant();
        return value switch
        {
            "commercial" or "site" or "approvals" or "reports" => value,
            _ => "ledger"
        };
    }

    private string FitOutHref(string href)
    {
        if (_activeCompanyId <= 0)
        {
            return href;
        }

        var separator = href.Contains('?', StringComparison.Ordinal) ? "&" : "?";
        return href + separator + "company=" + _activeCompanyId.ToString(CultureInfo.InvariantCulture);
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _activeCompanyId = ErpHostContext.ActiveCompanyIdFromQuery(ctx.Request) ?? 0;
        _workArea = NormalizeWorkArea(ctx.Request.Query["ws"].ToString());
        _openedBudgetId = ErpRecordOpen.ReadId(ctx.Request, "prja_budget_id");
        _openedTxnId = ErpRecordOpen.ReadId(ctx.Request, "prja_txn_id");
        _openedRecId = ErpRecordOpen.ReadId(ctx.Request, "prja_rec_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpProjectAccountingDigestAsync(200, ctx.RequestAborted);
        _budgets = result.Budgets;
        _txns = result.Txns;
        _recs = result.Recognitions;
        _count = result.Count;
        _txnCount = result.TxnCount;
        _recCount = result.RecognitionCount;
        _source = result.Source;
        _message = result.Message;

        if (_openedBudgetId > 0)
        {
            var detail = await Dashboards.BuildErpPrjaBudgetDetailAsync(_openedBudgetId, ctx.RequestAborted);
            _openedBudget = detail.Budget;
            _openedBudgetSiblings = detail.Siblings;
            if (_openedBudget is not null)
            {
                var openedList = _budgets.FirstOrDefault(b => b.Id == _openedBudgetId);
                if (openedList is not null)
                {
                    _budgets = new[] { openedList }.Concat(_budgets.Where(b => b.Id != _openedBudgetId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }

        if (_openedTxnId > 0)
        {
            var detail = await Dashboards.BuildErpPrjaTxnDetailAsync(_openedTxnId, ctx.RequestAborted);
            _openedTxn = detail.Txn;
            _openedTxnSiblings = detail.Siblings;
            if (_openedTxn is not null)
            {
                var openedList = _txns.FirstOrDefault(t => t.Id == _openedTxnId);
                if (openedList is not null)
                {
                    _txns = new[] { openedList }.Concat(_txns.Where(t => t.Id != _openedTxnId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message) && _openedBudget is null)
            {
                _message = detail.Message;
            }
        }

        if (_openedRecId > 0)
        {
            var detail = await Dashboards.BuildErpPrjaRecognitionDetailAsync(_openedRecId, ctx.RequestAborted);
            _openedRec = detail.Recognition;
            _openedRecSiblings = detail.Siblings;
            if (_openedRec is not null)
            {
                var openedList = _recs.FirstOrDefault(r => r.Id == _openedRecId);
                if (openedList is not null)
                {
                    _recs = new[] { openedList }.Concat(_recs.Where(r => r.Id != _openedRecId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message) && _openedBudget is null && _openedTxn is null)
            {
                _message = detail.Message;
            }
        }
    }

    private string _returnUrl => "/erp/project-accounting-app";

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
