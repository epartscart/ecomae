@page "/erp/project-accounting-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IErpPrjaBudgetSaveDryRun BudgetSave
@inject IHttpContextAccessor Http
@inject NavigationManager Nav
@inject EcomAE.Platform.Erp.IErpFitOutDeliveryDashboardReadService FitOutDelivery
@inject EcomAE.Platform.Erp.IErpFitOutExecutiveDashboardReadService FitOutExecutive
@inject EcomAE.Platform.Erp.IErpFitOutOperationsReportReadService FitOutOperations
@inject EcomAE.Platform.Erp.IErpFitOutFinanceOperationsReportReadService FitOutFinance
@inject EcomAE.Platform.Erp.IErpFitOutApprovalQueueReadService FitOutApprovals
@inject EcomAE.Platform.Erp.IErpFitOutEstimateRevisionReadService FitOutEstimates
@inject EcomAE.Platform.Erp.IErpFitOutBoqReadService FitOutBoq
@inject EcomAE.Platform.Erp.IErpFitOutApprovalEvidenceReadService FitOutApprovalEvidence
@inject EcomAE.Platform.Erp.IErpFitOutInvoiceBridgeReadService FitOutInvoiceBridge
@inject EcomAE.Platform.Erp.IErpFitOutInvoiceReconciliationReadService FitOutInvoiceRecon
@inject EcomAE.Platform.Erp.IErpFitOutCommercialReconciliationReadService FitOutCommercial
@inject EcomAE.Platform.Erp.IErpFitOutContractClosureReadService FitOutContractClosure
@inject EcomAE.Platform.Erp.IErpFitOutRetentionAgeingReadService FitOutRetention
@inject EcomAE.Platform.Erp.IErpFitOutProformaReceiptReadService FitOutProforma
@inject EcomAE.Platform.Erp.IErpFitOutApprovalAuditReadService FitOutAudit
@inject EcomAE.Platform.Erp.IErpFitOutSubcontractReconciliationReadService FitOutSubcontract
@inject EcomAE.Platform.Erp.IErpFitOutAcceptanceEvidenceReadService FitOutAcceptance
@inject EcomAE.Platform.Erp.IErpFitOutRecoverySummaryReadService FitOutRecovery
@inject EcomAE.Platform.Erp.IErpFitOutProjectPnlReadService FitOutProjectPnl

<PageTitle>Project accounting · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Project accounting" BreadcrumbArea="Projects" BreadcrumbTab="Project accounting">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/project-accounting-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Project accounting" Subtitle="Post budgets, project transactions, and recognition runs with validation before write." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-prja-workspace" data-epc-prja="workspace">
    <section class="epc-prja-mast">
        <div>
            <h2>Fit-out delivery dashboard</h2>
            <p>Review tenant-isolated counts, amounts, statuses, and completion summaries by project. Report links retain the selected legal entity.</p>
        </div>
        <span class="epc-prja-scope"><i class="fa fa-building"></i> @_companyScopeLabel</span>
    </section>

    <nav class="epc-org-tabs" aria-label="Fit-out work areas">
        <a class="@WorkAreaClass("ledger")" href="@WorkHref("ledger")">Ledger</a>
        <a class="@WorkAreaClass("commercial")" href="@WorkHref("commercial")">Commercial</a>
        <a class="@WorkAreaClass("site")" href="@WorkHref("site")">Site</a>
        <a class="@WorkAreaClass("approvals")" href="@WorkHref("approvals")">Approvals</a>
        <a class="@WorkAreaClass("reports")" href="@WorkHref("reports")">Reports</a>
    </nav>

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Project accounting KPIs">
        <div class="kpi"><div class="lbl">Budgets</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Transactions</div><div class="val">@_txnCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Recognition</div><div class="val">@_recCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_workArea == "reports")
    {
    <section class="epc-prja-visual" aria-label="Fit-out visual reports">
        <article class="epc-prja-vcard" id="prja-exec">
            <h3>Executive overview</h3>
            @if (_exec is null)
            {
                <p class="epc-prja-vempty">@(_isAdmin ? "Loading…" : "Sign in with ERP capability for live rows.")</p>
            }
            else if (_exec.Rows.Count == 0)
            {
                <p class="epc-prja-vempty">@VisualMessage(_exec.Source, _exec.Message, "No fit-out projects yet — load the demo sample data to see the board view.")</p>
            }
            else
            {
                var totals = new
                {
                    Boq = _exec.Rows.Sum(r => r.BoqValue),
                    Committed = _exec.Rows.Sum(r => r.CommittedAmount),
                    Delivered = _exec.Rows.Sum(r => r.DeliveryAmount),
                    Certified = _exec.Rows.Sum(r => r.ClientCertifiedAmount),
                    Pending = _exec.Rows.Sum(r => r.PendingApprovalAmount),
                };
                <div class="epc-erp-kpi epc-erp-stat-row">
                    <div class="kpi"><div class="lbl">BOQ value</div><div class="val">@Money(totals.Boq)</div></div>
                    <div class="kpi"><div class="lbl">Committed</div><div class="val">@Money(totals.Committed)</div></div>
                    <div class="kpi"><div class="lbl">Delivered</div><div class="val">@Money(totals.Delivered)</div></div>
                    <div class="kpi"><div class="lbl">Certified</div><div class="val">@Money(totals.Certified)</div></div>
                    <div class="kpi"><div class="lbl">Pending approval</div><div class="val">@Money(totals.Pending)</div></div>
                </div>
                <div class="epc-prja-bars" role="img" aria-label="Project value versus certified by project">
                    @foreach (var row in _exec.Rows.Take(8))
                    {
                        var pct = row.BoqValue > 0 ? Math.Min(100m, row.ClientCertifiedAmount / row.BoqValue * 100m) : 0m;
                        var cpct = row.BoqValue > 0 ? Math.Min(100m, row.CommittedAmount / row.BoqValue * 100m) : 0m;
                        <div class="epc-prja-bar-row">
                            <span class="epc-prja-bar-lbl" title="Project @row.ProjectId">P-@row.ProjectId</span>
                            <span class="epc-prja-bar-track">
                                <span class="epc-prja-bar committed" style="width:@Pct(cpct)"></span>
                                <span class="epc-prja-bar certified" style="width:@Pct(pct)"></span>
                            </span>
                            <span class="epc-prja-bar-val">@Money(row.ClientCertifiedAmount) / @Money(row.BoqValue)</span>
                        </div>
                    }
                </div>
                <p class="epc-prja-legend"><span class="sw committed"></span>Committed <span class="sw certified"></span>Client certified</p>
            }
        </article>

        <article class="epc-prja-vcard" id="prja-delivery">
            <h3>Delivery status</h3>
            @if (_delivery is null)
            {
                <p class="epc-prja-vempty">@(_isAdmin ? "Loading…" : "Sign in with ERP capability for live rows.")</p>
            }
            else if (_delivery.Rows.Count == 0)
            {
                <p class="epc-prja-vempty">@VisualMessage(_delivery.Source, _delivery.Message, "No delivery records yet.")</p>
            }
            else
            {
                foreach (var grp in _delivery.Rows.GroupBy(r => r.RecordType).Take(6))
                {
                    var count = grp.Sum(r => r.Count);
                    var amount = grp.Sum(r => r.Amount);
                    var completion = count > 0 ? grp.Sum(r => r.AverageCompletionPercent * r.Count) / count : 0m;
                    <div class="epc-prja-bar-row">
                        <span class="epc-prja-bar-lbl">@grp.Key</span>
                        <span class="epc-prja-bar-track"><span class="epc-prja-bar certified" style="width:@Pct(completion)"></span></span>
                        <span class="epc-prja-bar-val">@count rec · @Money(amount) · @completion.ToString("0")%</span>
                    </div>
                }
            }
        </article>

        <article class="epc-prja-vcard" id="prja-ops">
            <h3>Operations</h3>
            @if (_ops is null)
            {
                <p class="epc-prja-vempty">@(_isAdmin ? "Loading…" : "Sign in with ERP capability for live rows.")</p>
            }
            else if (_ops.Rows.Count == 0)
            {
                <p class="epc-prja-vempty">@VisualMessage(_ops.Source, _ops.Message, "No operations activity yet.")</p>
            }
            else
            {
                var maxAmt = _ops.Rows.Max(r => r.Amount) is var m && m > 0 ? m : 1m;
                foreach (var row in _ops.Rows.Take(8))
                {
                    var pct = maxAmt > 0 ? Math.Min(100m, row.Amount / maxAmt * 100m) : 0m;
                    <div class="epc-prja-bar-row">
                        <span class="epc-prja-bar-lbl">@row.Category · @row.Metric</span>
                        <span class="epc-prja-bar-track"><span class="epc-prja-bar committed" style="width:@Pct(pct)"></span></span>
                        <span class="epc-prja-bar-val">@row.Count · @Money(row.Amount)</span>
                    </div>
                }
            }
        </article>

        <article class="epc-prja-vcard" id="prja-finance">
            <h3>Finance / operations</h3>
            @if (_fin is null)
            {
                <p class="epc-prja-vempty">@(_isAdmin ? "Loading…" : "Sign in with ERP capability for live rows.")</p>
            }
            else if (_fin.Rows.Count == 0)
            {
                <p class="epc-prja-vempty">@VisualMessage(_fin.Source, _fin.Message, "No finance activity yet.")</p>
            }
            else
            {
                var maxAmt = _fin.Rows.Max(r => Math.Abs(r.Amount)) is var m && m > 0 ? m : 1m;
                foreach (var row in _fin.Rows.Take(8))
                {
                    var pct = maxAmt > 0 ? Math.Min(100m, Math.Abs(row.Amount) / maxAmt * 100m) : 0m;
                    <div class="epc-prja-bar-row">
                        <span class="epc-prja-bar-lbl">@row.Category · @row.Metric</span>
                        <span class="epc-prja-bar-track"><span class="epc-prja-bar finance" style="width:@Pct(pct)"></span></span>
                        <span class="epc-prja-bar-val">@row.Count · @Money(row.Amount)</span>
                    </div>
                }
            }
        </article>

        <article class="epc-prja-vcard" id="prja-approvals">
            <h3>Approval queue</h3>
            @if (_appr is null)
            {
                <p class="epc-prja-vempty">@(_isAdmin ? "Loading…" : "Sign in with ERP capability for live rows.")</p>
            }
            else if (_appr.Rows.Count == 0)
            {
                <p class="epc-prja-vempty">@VisualMessage(_appr.Source, _appr.Message, "Approval queue is clear.")</p>
            }
            else
            {
                <div class="epc-erp-kpi epc-erp-stat-row">
                    <div class="kpi"><div class="lbl">Pending items</div><div class="val">@_appr.Rows.Count</div></div>
                    <div class="kpi"><div class="lbl">Pending value</div><div class="val">@Money(_appr.TotalAmount)</div></div>
                </div>
                foreach (var row in _appr.Rows.Take(6))
                {
                    <div class="epc-prja-appr-row"><strong>@row.RecordType</strong> @row.Reference — @row.Title <span>@Money(row.Amount) · @row.Status</span></div>
                }
            }
        </article>
    </section>

    <h3 class="epc-prja-dtl">Reports</h3>
    @if (_report is not null)
    {
    <section class="epc-prja-visual" aria-label="Selected report">
        <article class="epc-prja-vcard" id="prja-report" style="grid-column:1/-1">
            <h3>@_report.Title</h3>
            <p>@_report.Subtitle</p>
            @if (!string.IsNullOrWhiteSpace(_report.Message))
            {
                <p class="epc-prja-vempty">@_report.Message</p>
            }
            else
            {
                @if (_report.Lines.Count > 0)
                {
                    <div class="epc-prja-voucher">
                        @foreach (var line in _report.Lines)
                        {
                            <div class="epc-prja-vline"><span>@line.Label</span><strong>@line.Value</strong></div>
                        }
                    </div>
                }
                @if (_report.Rows.Count > 0)
                {
                    <table class="epc-prja-vtable">
                        @if (_report.Head is not null)
                        {
                            <thead><tr>@foreach (var h in _report.Head){<th>@h</th>}</tr></thead>
                        }
                        <tbody>
                            @foreach (var row in _report.Rows)
                            {
                                <tr>@foreach (var cell in row){<td>@cell</td>}</tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </article>
    </section>
    }
    <section class="epc-prja-reports" aria-label="Fit-out reports">
        <article class="epc-prja-report">
            <h3>Excel import</h3>
            <p>Customers, suppliers, BOQ, rate analysis, quotations, variations, subcontracts, timesheets, site progress, invoices, retention, cheques, and documents. Selling rates use margin. A variation counts only after approval. A cheque stays out of the bank until it clears.</p>
            <a class="btn btn-default" href="@FitOutHref("/erp/fitout/workbook?kind=template")">Download template</a>
            <a class="btn btn-default" href="@FitOutHref("/erp/fitout/workbook?kind=package")">Download package</a>
        </article>
        <article class="epc-prja-report">
            <h3>Delivery dashboard</h3>
            <p>Project counts, amounts, and completion by legal entity.</p>
            <a class="btn btn-default" href="@WorkHref("reports")#prja-delivery">View delivery dashboard</a>
        </article>
        <article class="epc-prja-report">
            <h3>Executive dashboard</h3>
            <p>Board-level fit-out status for the selected company.</p>
            <a class="btn btn-default" href="@WorkHref("reports")#prja-exec">View executive dashboard</a>
        </article>
        <article class="epc-prja-report">
            <h3>Operations report</h3>
            <p>Site, procurement, and delivery operations roll-up.</p>
            <a class="btn btn-default" href="@WorkHref("reports")#prja-ops">View operations report</a>
        </article>
        <article class="epc-prja-report">
            <h3>Estimate revisions</h3>
            <p>Compare BOQ revisions for one project.</p>
            <form method="get" action="/erp/project-accounting-app" data-epc-inline="1">
                @ReportHidden("estimate-revisions")
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">View revision comparison</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Estimate / BOQ</h3>
            <p>Open a saved estimate and its BOQ lines.</p>
            <form method="get" action="/erp/project-accounting-app" data-epc-inline="1">
                @ReportHidden("estimate-boq")
                <label>Estimate id <input type="number" name="estimateId" min="1" placeholder="Estimate id" required /></label>
                <button type="submit" class="btn btn-default">View estimate / BOQ</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Approval evidence</h3>
            <p>Queue plus audit trail for one project.</p>
            <form method="get" action="/erp/project-accounting-app" data-epc-inline="1">
                @ReportHidden("approval-evidence")
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">View approval evidence</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Finance / operations</h3>
            <p>Combined finance and site operations digest.</p>
            <a class="btn btn-default" href="@WorkHref("reports")#prja-finance">View finance/operations report</a>
        </article>
        <article class="epc-prja-report">
            <h3>Project P&amp;L / forecast</h3>
            <p>Budget, actual, and forecast margin.</p>
            <form method="get" action="/erp/project-accounting-app" data-epc-inline="1">
                @ReportHidden("project-pnl")
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" />
                <button type="submit" class="btn btn-default">View project P&amp;L / forecast</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>VAT / invoice links</h3>
            <p>Invoice bridge rows for the selected project.</p>
            <form method="get" action="/erp/project-accounting-app" data-epc-inline="1">
                @ReportHidden("invoice-bridge")
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">View VAT / invoice links</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Billing reconciliation</h3>
            <p>Approved billing versus invoices.</p>
            <form method="get" action="/erp/project-accounting-app" data-epc-inline="1">
                @ReportHidden("invoice-reconciliation")
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">View billing reconciliation</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Contract balance</h3>
            <p>Certification split and remaining contract value.</p>
            <form method="get" action="/erp/project-accounting-app" data-epc-inline="1">
                @ReportHidden("commercial-reconciliation")
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">View contract balance</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Contract closure</h3>
            <p>Close-out checklist and remaining holds.</p>
            <form method="get" action="/erp/project-accounting-app" data-epc-inline="1">
                @ReportHidden("contract-closure")
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">View contract closure</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Retention ageing</h3>
            <p>Held and released retention by age.</p>
            <form method="get" action="/erp/project-accounting-app" data-epc-inline="1">
                @ReportHidden("retention-ageing")
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">View retention ageing</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Proforma / receipts</h3>
            <p>Proforma invoices and cash receipts.</p>
            <form method="get" action="/erp/project-accounting-app" data-epc-inline="1">
                @ReportHidden("proforma-receipts")
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">View proforma and receipts</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Approval audit</h3>
            <p>Who approved what, and when.</p>
            <form method="get" action="/erp/project-accounting-app" data-epc-inline="1">
                @ReportHidden("approval-audit")
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">View approval audit</button>
            </form>
        </article>
        <article class="epc-prja-report" id="prja-subcontract">
            <h3>Subcontract reconciliation</h3>
            <p>Subcontractor orders, claims, and certificates.</p>
            <form method="get" action="/erp/project-accounting-app" data-epc-inline="1">
                @ReportHidden("subcontract-reconciliation")
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">View subcontract reconciliation</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Pending approvals</h3>
            <p>Approval queue for a project or the company.</p>
            <form method="get" action="/erp/project-accounting-app" data-epc-inline="1">
                @ReportHidden("approval-queue")
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" />
                <button type="submit" class="btn btn-default">View pending approvals</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Acceptance evidence</h3>
            <p>Handover and acceptance checklist.</p>
            <form method="get" action="/erp/project-accounting-app" data-epc-inline="1">
                @ReportHidden("acceptance-evidence")
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">View acceptance evidence</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Recovery summary</h3>
            <p>Retention and advance recovery position.</p>
            <form method="get" action="/erp/project-accounting-app" data-epc-inline="1">
                @ReportHidden("recovery-summary")
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">View recovery summary</button>
            </form>
        </article>
    </section>
    }

    @if (_isAdmin && _workArea == "ledger")
    {
        <div class="epc-prja-grid">
        <section class="epc-erp-form-panel">
            <div class="epc-erp-form-panel__head"><strong>Post transaction</strong></div>
            <form method="post" action="/erp/project-accounting/txns/add">
                <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
                <ErpMasterPicker Kind="project" FieldName="project_id" Label="Project" Required="true" />
                <label>Type
                    <select name="txn_type">
                        <option value="cost">cost</option>
                        <option value="revenue">revenue</option>
                        <option value="billing">billing</option>
                    </select>
                </label>
                <label>Category <input type="text" name="category" maxlength="60" placeholder="general" /></label>
                <label>Description <input type="text" name="description" maxlength="200" /></label>
                <label>Amount <input type="text" name="amount" placeholder="0.00" /></label>
                <label>Transaction date <input type="date" name="txn_date" /></label>
                <label>Company id <input type="number" name="company_id" min="0" value="0" /></label>
                <div class="form-actions">
                    <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
                    <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Post</button>
                </div>
            </form>
        </section>
        <section class="epc-erp-form-panel">
            <div class="epc-erp-form-panel__head"><strong>Budget line</strong></div>
            <form method="post" action="/erp/project-accounting/budgets/save">
                <input type="hidden" name="returnUrl" value="@_returnUrl" />
                <input type="hidden" name="id" value="0" />
                <ErpMasterPicker Kind="project" FieldName="project_id" Label="Project" />
                <label>Category <input type="text" name="category" maxlength="60" placeholder="general" /></label>
                <label>Cost <input type="text" name="cost_budget" placeholder="0.00" /></label>
                <label>Revenue <input type="text" name="revenue_budget" placeholder="0.00" /></label>
                <label>Company id <input type="number" name="company_id" min="0" value="0" /></label>
                <div class="form-actions">
                    <button type="submit" name="confirmWrites" value="false" class="btn btn-sm btn-default">Validate</button>
                    <button type="submit" name="confirmWrites" value="true" class="btn btn-sm btn-primary">Save budget line</button>
                </div>
            </form>
        </section>
        </div>
    }

    @if (_isAdmin && _workArea == "commercial")
    {
        <div class="epc-prja-grid">
        <section class="epc-erp-form-panel">
            <div class="epc-erp-form-panel__head"><strong>Fit-out lead / customer handoff</strong></div>
            <form method="post" action="/erp/fitout/lead-handoff/save">
                <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
