@page "/erp/project-accounting-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IErpPrjaBudgetSaveDryRun BudgetSave
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Project accounting · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Project accounting" BreadcrumbArea="Projects" BreadcrumbTab="Project accounting">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/project-accounting-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Project accounting" Subtitle="Post budgets, project transactions, and PHP-compatible recognition runs with validation before write." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <section style="margin:12px 0;padding:10px;border:1px solid #c5d4de;background:#fff">
        <strong>Fit-out delivery dashboard</strong>
        <p style="margin:.35rem 0;color:#52616b">
            Review tenant-isolated counts, amounts, statuses, and completion summaries by project.
        </p>
        <a class="btn btn-default" href="/erp/fitout/delivery-dashboard">Open delivery dashboard JSON</a>
        <form method="get" action="/erp/fitout/recovery-summary" style="display:inline-flex;gap:.4rem;align-items:center;margin-left:.5rem">
            <label>Project id <input type="number" name="projectId" min="1" required style="width:6rem" /></label>
            <button type="submit" class="btn btn-default">Open recovery summary JSON</button>
        </form>
    </section>

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Project accounting KPIs">
        <div class="kpi"><div class="lbl">Budgets</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Transactions</div><div class="val">@_txnCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Recognition</div><div class="val">@_recCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {        <form method="post" action="/erp/project-accounting/txns/add" style="margin:12px 0;padding:10px;border:1px solid #c5d4de;background:#fff;display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
            <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
            <strong style="width:100%">Post transaction</strong>
            <label>Project id <input type="number" name="project_id" min="0" required style="width:7rem" /></label>
            <label>Type
                <select name="txn_type">
                    <option value="cost">cost</option>
                    <option value="revenue">revenue</option>
                    <option value="billing">billing</option>
                </select>
            </label>
            <label>Category <input type="text" name="category" maxlength="60" placeholder="general" style="width:10rem" /></label>
            <label>Description <input type="text" name="description" maxlength="200" /></label>
            <label>Amount <input type="text" name="amount" placeholder="0.00" style="width:7rem" /></label>
            <label>Transaction date <input type="date" name="txn_date" /></label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
            <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Post</button>
        </form>
        <form method="post" action="/erp/fitout/lead-handoff/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:12px 0;padding:10px;border:1px solid #c5d4de;background:#fff;">
            <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
            <strong style="width:100%">Fit-out lead / customer handoff</strong>
            <label>Project id <input type="number" name="project_id" min="1" required style="width:7rem" /></label>
            <label>Lead id <input type="number" name="lead_id" min="0" style="width:6rem" /></label>
            <label>Customer id <input type="number" name="customer_id" min="0" style="width:7rem" /></label>
            <label>Estimate id <input type="number" name="estimate_id" min="0" style="width:7rem" /></label>
            <label>Status
                <select name="status">
                    <option value="proposed">proposed</option>
                    <option value="qualified">qualified</option>
                    <option value="converted">converted</option>
                    <option value="rejected">rejected</option>
                </select>
            </label>
            <label>Notes <input type="text" name="notes" maxlength="1000" style="width:18rem" /></label>
            <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
            <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Save handoff</button>
        </form>
        <form method="post" action="/erp/project-accounting/budgets/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:12px 0;">
            <input type="hidden" name="returnUrl" value="@_returnUrl" />
            <input type="hidden" name="id" value="0" />
            <label>Project id <input type="number" name="project_id" min="0" value="0" style="width:6rem" /></label>
            <label>Category <input type="text" name="category" maxlength="60" placeholder="general" style="width:10rem" /></label>
            <label>Cost <input type="text" name="cost_budget" placeholder="0.00" style="width:7rem" /></label>
            <label>Revenue <input type="text" name="revenue_budget" placeholder="0.00" style="width:7rem" /></label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit" name="confirmWrites" value="false" class="btn btn-sm btn-default">Validate</button>
            <button type="submit" name="confirmWrites" value="true" class="btn btn-sm btn-primary">Save budget line</button>
        </form>
        <form method="post" action="/erp/fitout/estimates/save" style="margin:12px 0;padding:10px;border:1px solid #c5d4de;background:#fff;display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
            <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
            <strong style="width:100%">Fit-out estimate / BOQ revision</strong>
            <label>Project id <input type="number" name="project_id" min="1" required style="width:7rem" /></label>
            <label>Code <input type="text" name="code" maxlength="60" required placeholder="QT-2026-00001" style="width:10rem" /></label>
            <label>Title <input type="text" name="title" maxlength="200" required style="width:14rem" /></label>
            <label>Revision <input type="number" name="revision" min="1" value="1" style="width:5rem" /></label>
            <label>Markup % <input type="number" name="markup_percent" min="0" step="0.01" style="width:6rem" /></label>
            <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
            <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Save estimate</button>
        </form>
        <form method="post" action="/erp/fitout/boq-lines/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:12px 0;">
            <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
            <strong style="width:100%">Fit-out BOQ line</strong>
            <label>Estimate id <input type="number" name="estimate_id" min="1" required style="width:7rem" /></label>
            <label>Section <input type="text" name="section" maxlength="120" placeholder="Joinery" style="width:9rem" /></label>
            <label>Description <input type="text" name="description" maxlength="500" required style="width:15rem" /></label>
            <label>Cost type
                <select name="cost_type">
                    <option value="material">material</option>
                    <option value="labour">labour</option>
                    <option value="subcontract">subcontract</option>
                    <option value="equipment">equipment</option>
                    <option value="overhead">overhead</option>
                </select>
            </label>
            <label>Qty <input type="number" name="quantity" min="0" step="0.001" style="width:5rem" /></label>
            <label>Unit <input type="text" name="unit" maxlength="24" required placeholder="m2" style="width:4rem" /></label>
            <label>Rate <input type="number" name="unit_rate" min="0" step="0.01" style="width:6rem" /></label>
            <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
            <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Save BOQ line</button>
        </form>
        <form method="post" action="/erp/fitout/cost-codes/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:12px 0;">
            <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
            <strong style="width:100%">Fit-out hierarchical cost code</strong>
            <label>Project id <input type="number" name="project_id" min="1" required style="width:7rem" /></label>
            <label>Parent id <input type="number" name="parent_id" min="0" value="0" style="width:6rem" /></label>
            <label>Code <input type="text" name="code" maxlength="60" required placeholder="01.10" style="width:7rem" /></label>
            <label>Name <input type="text" name="name" maxlength="200" required style="width:12rem" /></label>
            <label>Cost type
                <select name="cost_type">
                    <option value="material">material</option>
                    <option value="labour">labour</option>
                    <option value="subcontract">subcontract</option>
                    <option value="equipment">equipment</option>
                    <option value="overhead">overhead</option>
                </select>
            </label>
            <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Save cost code</button>
        </form>
        <form method="post" action="/erp/fitout/quotations/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:12px 0;">
            <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
            <strong style="width:100%">Fit-out quotation issue / revision</strong>
            <label>Estimate id <input type="number" name="estimate_id" min="1" required style="width:7rem" /></label>
            <label>Quotation code <input type="text" name="code" maxlength="60" required placeholder="Q-2026-001" style="width:9rem" /></label>
            <label>Title <input type="text" name="title" maxlength="200" required style="width:14rem" /></label>
            <label>Revision <input type="number" name="revision" min="1" value="1" style="width:5rem" /></label>
            <label>Expires <input type="date" name="expires_on" style="width:9rem" /></label>
            <label>Status
                <select name="status">
                    <option value="draft">draft</option>
                    <option value="issued">issued</option>
                    <option value="accepted">accepted</option>
                    <option value="rejected">rejected</option>
                    <option value="expired">expired</option>
                </select>
            </label>
            <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Save quotation</button>
        </form>
        <form method="post" action="/erp/fitout/procurement-links/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:12px 0;">
            <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
            <strong style="width:100%">Fit-out procurement PR / PO / GRN linkage</strong>
            <label>Project id <input type="number" name="project_id" min="1" required style="width:7rem" /></label>
            <label>Cost code id <input type="number" name="cost_code_id" min="0" value="0" style="width:7rem" /></label>
            <label>Requisition id <input type="number" name="requisition_id" min="0" value="0" style="width:7rem" /></label>
            <label>Purchase order id <input type="number" name="purchase_order_id" min="0" value="0" style="width:7rem" /></label>
            <label>GRN id <input type="number" name="goods_receipt_id" min="0" value="0" style="width:6rem" /></label>
            <label>Description <input type="text" name="description" maxlength="240" required style="width:15rem" placeholder="Joinery material package" /></label>
            <label>Qty <input type="number" name="quantity" min="0" step="0.001" style="width:5rem" /></label>
            <label>Committed <input type="number" name="committed_amount" min="0" step="0.01" style="width:7rem" /></label>
            <label>Status
                <select name="status">
                    <option value="requested">requested</option>
                    <option value="ordered">ordered</option>
                    <option value="partially_received">partially received</option>
                    <option value="received">received</option>
                    <option value="cancelled">cancelled</option>
                </select>
            </label>
            <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
            <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Save procurement link</button>
        </form>
        <form method="post" action="/erp/fitout/three-way-matches/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:12px 0;">
            <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
            <strong style="width:100%">Fit-out three-way match / tolerance</strong>
            <label>Project id <input type="number" name="project_id" min="1" required style="width:7rem" /></label>
            <label>Link id <input type="number" name="procurement_link_id" min="0" value="0" style="width:6rem" /></label>
            <label>PO id <input type="number" name="purchase_order_id" min="0" value="0" style="width:6rem" /></label>
            <label>GRN id <input type="number" name="goods_receipt_id" min="0" value="0" style="width:6rem" /></label>
            <label>Invoice ref <input type="text" name="invoice_reference" maxlength="120" required style="width:12rem" placeholder="INV-2026-001" /></label>
            <label>Ordered <input type="number" name="ordered_amount" min="0" step="0.01" style="width:7rem" /></label>
            <label>Received <input type="number" name="received_amount" min="0" step="0.01" style="width:7rem" /></label>
            <label>Invoiced <input type="number" name="invoiced_amount" min="0" step="0.01" style="width:7rem" /></label>
            <label>Tolerance % <input type="number" name="tolerance_percent" min="0" max="100" step="0.001" value="0" style="width:6rem" /></label>
            <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
            <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Save match</button>
        </form>
        <form method="post" action="/erp/fitout/material-movements/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:12px 0;">
            <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
            <strong style="width:100%">Fit-out material issue / return</strong>
            <label>Project id <input type="number" name="project_id" min="1" required style="width:7rem" /></label>
            <label>Cost code id <input type="number" name="cost_code_id" min="0" value="0" style="width:7rem" /></label>
            <label>Item code <input type="text" name="item_code" maxlength="80" required style="width:9rem" placeholder="MAT-JOINERY" /></label>
            <label>Description <input type="text" name="description" maxlength="240" required style="width:15rem" placeholder="Issue to site" /></label>
            <label>Qty <input type="number" name="quantity" min="0.001" step="0.001" required style="width:5rem" /></label>
            <label>Unit cost <input type="number" name="unit_cost" min="0" step="0.01" style="width:7rem" /></label>
            <label>Movement
                <select name="movement">
                    <option value="issue">issue</option>
                    <option value="return">return</option>
                </select>
            </label>
            <label>Reference <input type="text" name="reference" maxlength="120" style="width:10rem" placeholder="MR-2026-001" /></label>
            <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
            <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Save movement</button>
        </form>
        <form method="post" action="/erp/fitout/delivery-records/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:12px 0;">
            <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
            <strong style="width:100%">Fit-out subcontract / site / variation / claim record</strong>
            <label>Project id <input type="number" name="project_id" min="1" required style="width:7rem" /></label>
            <label>Cost code id <input type="number" name="cost_code_id" min="0" value="0" style="width:7rem" /></label>
            <label>Parent id <input type="number" name="parent_id" min="0" value="0" style="width:6rem" /></label>
            <label>Subcontractor id <input type="number" name="subcontractor_id" min="0" value="0" style="width:8rem" /></label>
            <label>Type
                <select name="record_type">
                    <option value="subcontract_order">subcontract order</option>
                    <option value="subcontract_measurement">subcontract measurement</option>
                    <option value="subcontract_certification">subcontract certification</option>
                    <option value="site_daily_report">site daily report</option>
                    <option value="site_photo">site photo</option>
                    <option value="variation">variation</option>
                    <option value="progress_claim">progress claim</option>
                    <option value="rfi">RFI</option>
                    <option value="drawing_revision">drawing revision</option>
                    <option value="qa_inspection">QA/QC inspection</option>
                    <option value="snag">snag</option>
                    <option value="equipment_usage">equipment usage</option>
                    <option value="timesheet">timesheet</option>
                    <option value="weighted_progress">weighted BOQ progress</option>
                    <option value="retention_recovery">retention recovery</option>
                    <option value="advance_recovery">advance recovery</option>
                    <option value="approval_request">approval request</option>
                </select>
            </label>
            <label>Reference <input type="text" name="reference" maxlength="80" required style="width:9rem" placeholder="SDR-2026-001" /></label>
            <label>Title <input type="text" name="title" maxlength="180" required style="width:13rem" placeholder="Daily progress report" /></label>
            <label>Description <input type="text" name="description" maxlength="1000" style="width:15rem" /></label>
            <label>Qty <input type="number" name="quantity" min="0" step="0.001" style="width:5rem" /></label>
            <label>Amount <input type="number" name="amount" min="0" step="0.01" style="width:7rem" /></label>
            <label>Complete % <input type="number" name="completion_percent" min="0" max="100" step="0.001" style="width:6rem" /></label>
            <label>Date <input type="date" name="event_date" style="width:9rem" /></label>
            <label>Status <input type="text" name="status" maxlength="24" placeholder="draft" style="width:7rem" /></label>
            <label>Photo URL <input type="url" name="photo_url" maxlength="500" style="width:14rem" /></label>
            <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
            <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Save delivery record</button>
        </form>
    }

    @if (_openedBudget is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedBudgetCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedBudgetReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Id</dt><dd>@_openedBudget.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Project</dt><dd>@(_openedBudget.ProjectId > 0 ? _openedBudget.ProjectId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Category</dt><dd>@(string.IsNullOrWhiteSpace(_openedBudget.Category) ? "—" : _openedBudget.Category)</dd>
                <dt>Cost</dt><dd>@_openedBudget.CostBudget.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Revenue</dt><dd>@_openedBudget.RevenueBudget.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Company</dt><dd>@(_openedBudget.CompanyId > 0 ? _openedBudget.CompanyId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Created</dt><dd>@FormatTime(_openedBudget.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Budget, transaction, and recognition writes use the tenant-safe ERP endpoints.</p>
            @if (_openedBudgetSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-project siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Category</th><th>Cost</th><th>Revenue</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedBudgetSiblings)
                        {
                            <tr>
                                <td>@sib.Category</td>
                                <td>@sib.CostBudget.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@sib.RevenueBudget.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "prja_budget_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-project siblings yet.</p>
            }
        </div>
    }

    @if (_openedTxn is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedTxnCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedTxnReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Id</dt><dd>@_openedTxn.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Project</dt><dd>@(_openedTxn.ProjectId > 0 ? _openedTxn.ProjectId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Type</dt><dd>@(string.IsNullOrWhiteSpace(_openedTxn.TxnType) ? "—" : _openedTxn.TxnType)</dd>
                <dt>Category</dt><dd>@(string.IsNullOrWhiteSpace(_openedTxn.Category) ? "—" : _openedTxn.Category)</dd>
                <dt>Description</dt><dd>@(string.IsNullOrWhiteSpace(_openedTxn.Description) ? "—" : _openedTxn.Description)</dd>
                <dt>Amount</dt><dd>@_openedTxn.Amount.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Txn date</dt><dd>@FormatTime(_openedTxn.TxnDate)</dd>
                <dt>Company</dt><dd>@(_openedTxn.CompanyId > 0 ? _openedTxn.CompanyId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Created</dt><dd>@FormatTime(_openedTxn.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Budget, transaction, and recognition writes use the tenant-safe ERP endpoints.</p>
            @if (_openedTxnSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-project siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Type</th><th>Description</th><th>Amount</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedTxnSiblings)
                        {
                            <tr>
                                <td>@sib.TxnType</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Description) ? "—" : sib.Description)</td>
                                <td>@sib.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "prja_txn_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-project siblings yet.</p>
            }
        </div>
    }

    @if (_openedRec is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedRecCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedRecReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Id</dt><dd>@_openedRec.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Project</dt><dd>@(_openedRec.ProjectId > 0 ? _openedRec.ProjectId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Method</dt><dd>@(string.IsNullOrWhiteSpace(_openedRec.Method) ? "—" : _openedRec.Method)</dd>
                <dt>% complete</dt><dd>@_openedRec.PctComplete.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Revenue</dt><dd>@_openedRec.RecognizedRevenue.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Cost</dt><dd>@_openedRec.RecognizedCost.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>WIP</dt><dd>@_openedRec.Wip.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>As of</dt><dd>@FormatTime(_openedRec.AsOf)</dd>
                <dt>Company</dt><dd>@(_openedRec.CompanyId > 0 ? _openedRec.CompanyId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Created</dt><dd>@FormatTime(_openedRec.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Recognition runs are persisted with budget, actual, and WIP detail.</p>
            <p class="text-muted">Recognition stays Classic-compatible until the project parity gate is closed.</p>
            @if (!string.IsNullOrWhiteSpace(_openedRec.DetailExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">detail excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedRec.DetailExcerpt</pre>
                @if (_openedRec.DetailLen > _openedRec.DetailExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_openedRec.DetailExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedRec.DetailLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No detail excerpt yet.</p>
            }
            @if (_openedRecSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-project siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Method</th><th>% complete</th><th>WIP</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedRecSiblings)
                        {
                            <tr>
                                <td>@sib.Method</td>
                                <td>@sib.PctComplete.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@sib.Wip.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "prja_rec_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-project siblings yet.</p>
            }
        </div>
    }

    <h2 style="font-size:16px;">Budgets</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Project</th><th>Category</th><th class="text-right">Cost</th><th class="text-right">Revenue</th><th></th></tr></thead>
            <tbody>
                @if (_budgets.Count == 0)
                {
                    <tr><td colspan="5">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No project budgets yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _budgets)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedBudgetId)">
                            <td>@(row.ProjectId > 0 ? row.ProjectId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><strong>@row.Category</strong></td>
                            <td class="text-right">@row.CostBudget.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.RevenueBudget.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "prja_budget_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="font-size:16px;">Transactions</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Project</th><th>Type</th><th>Category</th><th>Description</th><th class="text-right">Amount</th><th></th></tr></thead>
            <tbody>
                @if (_txns.Count == 0) { <tr><td colspan="6">No project transactions yet.</td></tr> }
                else
                {
                    @foreach (var row in _txns)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedTxnId)">
                            <td>@(row.ProjectId > 0 ? row.ProjectId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@row.TxnType</td>
                            <td>@row.Category</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Description) ? "—" : row.Description)</td>
                            <td class="text-right">@row.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "prja_txn_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="font-size:16px;">Recognition</h2>
    @if (_isAdmin)
    {
        <form method="post" action="/erp/ajax/prja-recognize" style="margin:12px 0;padding:10px;border:1px solid #c5d4de;background:#fff;display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
            <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
            <strong style="width:100%">Run recognition</strong>
            <label>Project id <input type="number" name="project_id" min="1" required style="width:7rem" /></label>
            <label>Method
                <select name="method">
                    <option value="poc">percentage of completion</option>
                    <option value="completed">completed contract</option>
                    <option value="straight_line">straight line</option>
                </select>
            </label>
            <label>Fraction <input type="number" name="fraction" min="0" max="1" step="0.0001" value="0" style="width:7rem" /></label>
            <label>As of <input type="date" name="as_of" /></label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
            <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Run recognition</button>
        </form>
    }
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Project</th><th>Method</th><th class="text-right">% complete</th><th class="text-right">Revenue</th><th class="text-right">Cost</th><th class="text-right">WIP</th><th></th></tr></thead>
            <tbody>
                @if (_recs.Count == 0) { <tr><td colspan="7">No recognition runs yet.</td></tr> }
                else
                {
                    @foreach (var row in _recs)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedRecId)">
                            <td>@(row.ProjectId > 0 ? row.ProjectId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@row.Method</td>
                            <td class="text-right">@row.PctComplete.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.RecognizedRevenue.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.RecognizedCost.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.Wip.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "prja_rec_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
        Budget, transaction, and recognition writes are live when confirmed.
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=projects&tab=project_accounting";
    private const string _listHref = "/erp/project-accounting-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpPrjaBudgetDigest> _budgets = [];
    private IReadOnlyList<ErpPrjaTxnDigest> _txns = [];
    private IReadOnlyList<ErpPrjaRecognitionDigest> _recs = [];
    private int _count, _txnCount, _recCount;
    private string _source = "n/a";
    private string _message = "";
    private long _openedBudgetId;
    private long _openedTxnId;
    private long _openedRecId;
    private ErpPrjaBudgetDetail? _openedBudget;
    private ErpPrjaTxnDetail? _openedTxn;
    private ErpPrjaRecognitionDetail? _openedRec;
    private IReadOnlyList<ErpPrjaBudgetDigest> _openedBudgetSiblings = [];
    private IReadOnlyList<ErpPrjaTxnDigest> _openedTxnSiblings = [];
    private IReadOnlyList<ErpPrjaRecognitionDigest> _openedRecSiblings = [];

    private long _openedId => _openedRecId > 0 ? _openedRecId : (_openedTxnId > 0 ? _openedTxnId : _openedBudgetId);

    private bool OpenedFound => _openedBudget is not null || _openedTxn is not null || _openedRec is not null;

    private string OpenedBudgetReturnHref => _openedBudgetId > 0
        ? _listHref + "?prja_budget_id=" + _openedBudgetId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedTxnReturnHref => _openedTxnId > 0
        ? _listHref + "?prja_txn_id=" + _openedTxnId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedRecReturnHref => _openedRecId > 0
        ? _listHref + "?prja_rec_id=" + _openedRecId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedBudgetCaption => _openedBudget is null
        ? ""
        : ("Budget #" + _openedBudget.Id.ToString(CultureInfo.InvariantCulture)
            + (string.IsNullOrWhiteSpace(_openedBudget.Category) ? "" : (" · " + _openedBudget.Category)));

    private string OpenedTxnCaption => _openedTxn is null
        ? ""
        : ("Txn #" + _openedTxn.Id.ToString(CultureInfo.InvariantCulture)
            + (string.IsNullOrWhiteSpace(_openedTxn.TxnType) ? "" : (" · " + _openedTxn.TxnType)));

    private string OpenedRecCaption => _openedRec is null
        ? ""
        : ("Recognition #" + _openedRec.Id.ToString(CultureInfo.InvariantCulture)
            + (string.IsNullOrWhiteSpace(_openedRec.Method) ? "" : (" · " + _openedRec.Method)));

    private string OpenedCaption => _openedRec is not null
        ? OpenedRecCaption
        : (_openedTxn is not null ? OpenedTxnCaption : OpenedBudgetCaption);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _openedBudgetId = ErpRecordOpen.ReadId(ctx.Request, "prja_budget_id");
        _openedTxnId = ErpRecordOpen.ReadId(ctx.Request, "prja_txn_id");
        _openedRecId = ErpRecordOpen.ReadId(ctx.Request, "prja_rec_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpProjectAccountingDigestAsync(200, ctx.RequestAborted);
        _budgets = result.Budgets;
        _txns = result.Txns;
        _recs = result.Recognitions;
        _count = result.Count;
        _txnCount = result.TxnCount;
        _recCount = result.RecognitionCount;
        _source = result.Source;
        _message = result.Message;

        if (_openedBudgetId > 0)
        {
            var detail = await Dashboards.BuildErpPrjaBudgetDetailAsync(_openedBudgetId, ctx.RequestAborted);
            _openedBudget = detail.Budget;
            _openedBudgetSiblings = detail.Siblings;
            if (_openedBudget is not null)
            {
                var openedList = _budgets.FirstOrDefault(b => b.Id == _openedBudgetId);
                if (openedList is not null)
                {
                    _budgets = new[] { openedList }.Concat(_budgets.Where(b => b.Id != _openedBudgetId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }

        if (_openedTxnId > 0)
        {
            var detail = await Dashboards.BuildErpPrjaTxnDetailAsync(_openedTxnId, ctx.RequestAborted);
            _openedTxn = detail.Txn;
            _openedTxnSiblings = detail.Siblings;
            if (_openedTxn is not null)
            {
                var openedList = _txns.FirstOrDefault(t => t.Id == _openedTxnId);
                if (openedList is not null)
                {
                    _txns = new[] { openedList }.Concat(_txns.Where(t => t.Id != _openedTxnId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message) && _openedBudget is null)
            {
                _message = detail.Message;
            }
        }

        if (_openedRecId > 0)
        {
            var detail = await Dashboards.BuildErpPrjaRecognitionDetailAsync(_openedRecId, ctx.RequestAborted);
            _openedRec = detail.Recognition;
            _openedRecSiblings = detail.Siblings;
            if (_openedRec is not null)
            {
                var openedList = _recs.FirstOrDefault(r => r.Id == _openedRecId);
                if (openedList is not null)
                {
                    _recs = new[] { openedList }.Concat(_recs.Where(r => r.Id != _openedRecId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message) && _openedBudget is null && _openedTxn is null)
            {
                _message = detail.Message;
            }
        }
    }

    private string _returnUrl => "/erp/project-accounting-app";

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
