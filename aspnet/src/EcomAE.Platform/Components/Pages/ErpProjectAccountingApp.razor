@page "/erp/project-accounting-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IErpPrjaBudgetSaveDryRun BudgetSave
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Project accounting · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Project accounting" BreadcrumbArea="Projects" BreadcrumbTab="Project accounting">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/project-accounting-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Project accounting" Subtitle="Post budgets, project transactions, and PHP-compatible recognition runs with validation before write." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-prja-workspace" data-epc-prja="workspace">
    <section class="epc-prja-mast">
        <div>
            <h2>Fit-out delivery dashboard</h2>
            <p>Review tenant-isolated counts, amounts, statuses, and completion summaries by project. Report links retain the selected legal entity.</p>
        </div>
        <span class="epc-prja-scope"><i class="fa fa-building"></i> @_companyScopeLabel</span>
    </section>

    <nav class="epc-org-tabs" aria-label="Fit-out work areas">
        <a class="@WorkAreaClass("ledger")" href="@WorkHref("ledger")">Ledger</a>
        <a class="@WorkAreaClass("commercial")" href="@WorkHref("commercial")">Commercial</a>
        <a class="@WorkAreaClass("site")" href="@WorkHref("site")">Site</a>
        <a class="@WorkAreaClass("approvals")" href="@WorkHref("approvals")">Approvals</a>
        <a class="@WorkAreaClass("reports")" href="@WorkHref("reports")">Reports</a>
    </nav>

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Project accounting KPIs">
        <div class="kpi"><div class="lbl">Budgets</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Transactions</div><div class="val">@_txnCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Recognition</div><div class="val">@_recCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_workArea == "reports")
    {
    <section class="epc-prja-reports" aria-label="Fit-out reports">
        <article class="epc-prja-report">
            <h3>Delivery dashboard</h3>
            <p>Project counts, amounts, and completion by legal entity.</p>
            <a class="btn btn-default" href="@FitOutHref("/erp/fitout/delivery-dashboard")">Open delivery dashboard JSON</a>
        </article>
        <article class="epc-prja-report">
            <h3>Executive dashboard</h3>
            <p>Board-level fit-out status for the selected company.</p>
            <a class="btn btn-default" href="@FitOutHref("/erp/fitout/executive-dashboard")">Open executive dashboard JSON</a>
        </article>
        <article class="epc-prja-report">
            <h3>Operations report</h3>
            <p>Site, procurement, and delivery operations roll-up.</p>
            <a class="btn btn-default" href="@FitOutHref("/erp/fitout/operations-report")">Open operations report JSON</a>
        </article>
        <article class="epc-prja-report">
            <h3>Estimate revisions</h3>
            <p>Compare BOQ revisions for one project.</p>
            <form method="get" action="@FitOutHref("/erp/fitout/estimates/revision-comparison")" data-epc-inline="1">
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">Compare estimate revisions JSON</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Estimate / BOQ</h3>
            <p>Open a saved estimate and its BOQ lines.</p>
            <form method="get" action="@FitOutHref("/erp/fitout/estimates/boq")" data-epc-inline="1">
                <label>Estimate id <input type="number" name="estimateId" min="1" placeholder="Estimate id" required /></label>
                <button type="submit" class="btn btn-default">Open estimate / BOQ JSON</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Approval evidence</h3>
            <p>Queue plus audit trail for one project.</p>
            <form method="get" action="@FitOutHref("/erp/fitout/approval-evidence")" data-epc-inline="1">
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">Open approval evidence JSON</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Finance / operations</h3>
            <p>Combined finance and site operations digest.</p>
            <a class="btn btn-default" href="@FitOutHref("/erp/fitout/finance-operations-report")">Open finance/operations report JSON</a>
        </article>
        <article class="epc-prja-report">
            <h3>Project P&amp;L / forecast</h3>
            <p>Budget, actual, and forecast margin.</p>
            <form method="get" action="@FitOutHref("/erp/fitout/project-pnl")" data-epc-inline="1">
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" />
                <button type="submit" class="btn btn-default">Open project P&amp;L / forecast JSON</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>VAT / invoice links</h3>
            <p>Invoice bridge rows for the selected project.</p>
            <form method="get" action="/erp/fitout/invoice-bridge" data-epc-inline="1">
                @if (_activeCompanyId > 0)
                {
                    <input type="hidden" name="company" value="@_activeCompanyId.ToString(CultureInfo.InvariantCulture)" />
                }
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">Open VAT / invoice links JSON</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Billing reconciliation</h3>
            <p>Approved billing versus invoices.</p>
            <form method="get" action="/erp/fitout/invoice-reconciliation" data-epc-inline="1">
                @if (_activeCompanyId > 0)
                {
                    <input type="hidden" name="company" value="@_activeCompanyId.ToString(CultureInfo.InvariantCulture)" />
                }
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">Open approved billing reconciliation JSON</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Contract balance</h3>
            <p>Certification split and remaining contract value.</p>
            <form method="get" action="/erp/fitout/commercial-reconciliation" data-epc-inline="1">
                @if (_activeCompanyId > 0)
                {
                    <input type="hidden" name="company" value="@_activeCompanyId.ToString(CultureInfo.InvariantCulture)" />
                }
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">Open contract balance and certification split JSON</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Contract closure</h3>
            <p>Close-out checklist and remaining holds.</p>
            <form method="get" action="@FitOutHref("/erp/fitout/contract-closure")" data-epc-inline="1">
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">Open contract closure JSON</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Retention ageing</h3>
            <p>Held and released retention by age.</p>
            <form method="get" action="@FitOutHref("/erp/fitout/retention-ageing")" data-epc-inline="1">
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">Open retention ageing JSON</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Proforma / receipts</h3>
            <p>Proforma invoices and cash receipts.</p>
            <form method="get" action="@FitOutHref("/erp/fitout/proforma-receipts")" data-epc-inline="1">
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">Open proforma and receipt history JSON</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Approval audit</h3>
            <p>Who approved what, and when.</p>
            <form method="get" action="@FitOutHref("/erp/fitout/approval-audit")" data-epc-inline="1">
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">Open approval audit JSON</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Subcontract reconciliation</h3>
            <p>Subcontractor orders, claims, and certificates.</p>
            <form method="get" action="@FitOutHref("/erp/fitout/subcontract-reconciliation")" data-epc-inline="1">
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">Open subcontract reconciliation JSON</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Pending approvals</h3>
            <p>Open the approval queue for a project or the company.</p>
            <form method="get" action="@FitOutHref("/erp/fitout/approval-queue")" data-epc-inline="1">
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" />
                <button type="submit" class="btn btn-default">Open pending approval queue JSON</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Acceptance evidence</h3>
            <p>Handover and acceptance attachments.</p>
            <form method="get" action="/erp/fitout/acceptance-evidence" data-epc-inline="1">
                @if (_activeCompanyId > 0)
                {
                    <input type="hidden" name="company" value="@_activeCompanyId.ToString(CultureInfo.InvariantCulture)" />
                }
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">Open acceptance evidence JSON</button>
            </form>
        </article>
        <article class="epc-prja-report">
            <h3>Recovery summary</h3>
            <p>Retention and advance recovery position.</p>
            <form method="get" action="@FitOutHref("/erp/fitout/recovery-summary")" data-epc-inline="1">
                <ErpMasterPicker Kind="project" FieldName="projectId" Label="Project" Required="true" Min="1" />
                <button type="submit" class="btn btn-default">Open recovery summary JSON</button>
            </form>
        </article>
    </section>
    }

    @if (_isAdmin && _workArea == "ledger")
    {
        <div class="epc-prja-grid">
        <section class="epc-erp-form-panel">
            <div class="epc-erp-form-panel__head"><strong>Post transaction</strong></div>
            <form method="post" action="/erp/project-accounting/txns/add">
                <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
                <ErpMasterPicker Kind="project" FieldName="project_id" Label="Project" Required="true" />
                <label>Type
                    <select name="txn_type">
                        <option value="cost">cost</option>
                        <option value="revenue">revenue</option>
                        <option value="billing">billing</option>
                    </select>
                </label>
                <label>Category <input type="text" name="category" maxlength="60" placeholder="general" /></label>
                <label>Description <input type="text" name="description" maxlength="200" /></label>
                <label>Amount <input type="text" name="amount" placeholder="0.00" /></label>
                <label>Transaction date <input type="date" name="txn_date" /></label>
                <label>Company id <input type="number" name="company_id" min="0" value="0" /></label>
                <div class="form-actions">
                    <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
                    <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Post</button>
                </div>
            </form>
        </section>
        <section class="epc-erp-form-panel">
            <div class="epc-erp-form-panel__head"><strong>Budget line</strong></div>
            <form method="post" action="/erp/project-accounting/budgets/save">
                <input type="hidden" name="returnUrl" value="@_returnUrl" />
                <input type="hidden" name="id" value="0" />
                <ErpMasterPicker Kind="project" FieldName="project_id" Label="Project" />
                <label>Category <input type="text" name="category" maxlength="60" placeholder="general" /></label>
                <label>Cost <input type="text" name="cost_budget" placeholder="0.00" /></label>
                <label>Revenue <input type="text" name="revenue_budget" placeholder="0.00" /></label>
                <label>Company id <input type="number" name="company_id" min="0" value="0" /></label>
                <div class="form-actions">
                    <button type="submit" name="confirmWrites" value="false" class="btn btn-sm btn-default">Validate</button>
                    <button type="submit" name="confirmWrites" value="true" class="btn btn-sm btn-primary">Save budget line</button>
                </div>
            </form>
        </section>
        </div>
    }

    @if (_isAdmin && _workArea == "commercial")
    {
        <div class="epc-prja-grid">
        <section class="epc-erp-form-panel">
            <div class="epc-erp-form-panel__head"><strong>Fit-out lead / customer handoff</strong></div>
            <form method="post" action="/erp/fitout/lead-handoff/save">
                <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
                <ErpMasterPicker Kind="project" FieldName="project_id" Label="Project" Required="true" Min="1" />
                <label>Lead id <input type="number" name="lead_id" min="0" /></label>
                <ErpMasterPicker Kind="customer" FieldName="customer_id" Label="Customer" />
                <label>Estimate id <input type="number" name="estimate_id" min="0" /></label>
                <label>Status
                    <select name="status">
                        <option value="proposed">proposed</option>
                        <option value="qualified">qualified</option>
                        <option value="converted">converted</option>
                        <option value="rejected">rejected</option>
                    </select>
                </label>
                <label>Notes <input type="text" name="notes" maxlength="1000" /></label>
                <div class="form-actions">
                    <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
                    <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Save handoff</button>
                </div>
            </form>
        </section>
        <section class="epc-erp-form-panel">
            <div class="epc-erp-form-panel__head"><strong>Fit-out estimate / BOQ revision</strong></div>
            <form method="post" action="/erp/fitout/estimates/save">
                <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
                <ErpMasterPicker Kind="project" FieldName="project_id" Label="Project" Required="true" Min="1" />
                <label>Code <input type="text" name="code" maxlength="60" required placeholder="QT-2026-00001" /></label>
                <label>Title <input type="text" name="title" maxlength="200" required /></label>
                <label>Revision <input type="number" name="revision" min="1" value="1" /></label>
                <label>Markup % <input type="number" name="markup_percent" min="0" step="0.01" /></label>
                <div class="form-actions">
                    <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
                    <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Save estimate</button>
                </div>
            </form>
        </section>
        <section class="epc-erp-form-panel">
            <div class="epc-erp-form-panel__head"><strong>Fit-out BOQ line</strong></div>
            <form method="post" action="/erp/fitout/boq-lines/save">
                <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
                <label>Estimate id <input type="number" name="estimate_id" min="1" required /></label>
                <label>Section <input type="text" name="section" maxlength="120" placeholder="Joinery" /></label>
                <label>Description <input type="text" name="description" maxlength="500" required /></label>
                <label>Cost type
                    <select name="cost_type">
                        <option value="material">material</option>
                        <option value="labour">labour</option>
                        <option value="subcontract">subcontract</option>
                        <option value="equipment">equipment</option>
                        <option value="overhead">overhead</option>
                    </select>
                </label>
                <label>Qty <input type="number" name="quantity" min="0" step="0.001" /></label>
                <label>Unit <input type="text" name="unit" maxlength="24" required placeholder="m2" /></label>
                <label>Rate <input type="number" name="unit_rate" min="0" step="0.01" /></label>
                <label>Material <input type="number" name="material_rate" min="0" step="0.01" /></label>
                <label>Labour <input type="number" name="labour_rate" min="0" step="0.01" /></label>
                <label>Subcontract <input type="number" name="subcontract_rate" min="0" step="0.01" /></label>
                <label>Equipment <input type="number" name="equipment_rate" min="0" step="0.01" /></label>
                <label>Overhead <input type="number" name="overhead_rate" min="0" step="0.01" /></label>
                <div class="form-actions">
                    <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
                    <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Save BOQ line</button>
                </div>
            </form>
        </section>
        <section class="epc-erp-form-panel">
            <div class="epc-erp-form-panel__head"><strong>Fit-out hierarchical cost code</strong></div>
            <form method="post" action="/erp/fitout/cost-codes/save">
                <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
                <ErpMasterPicker Kind="project" FieldName="project_id" Label="Project" Required="true" Min="1" />
                <label>Parent id <input type="number" name="parent_id" min="0" value="0" /></label>
                <label>Code <input type="text" name="code" maxlength="60" required placeholder="01.10" /></label>
                <label>Name <input type="text" name="name" maxlength="200" required /></label>
                <label>Cost type
                    <select name="cost_type">
                        <option value="material">material</option>
                        <option value="labour">labour</option>
                        <option value="subcontract">subcontract</option>
                        <option value="equipment">equipment</option>
                        <option value="overhead">overhead</option>
                    </select>
                </label>
                <div class="form-actions">
                    <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Save cost code</button>
                </div>
            </form>
        </section>
        <section class="epc-erp-form-panel">
            <div class="epc-erp-form-panel__head"><strong>Fit-out quotation issue / revision</strong></div>
            <form method="post" action="/erp/fitout/quotations/save">
                <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
                <label>Estimate id <input type="number" name="estimate_id" min="1" required /></label>
                <label>Quotation code <input type="text" name="code" maxlength="60" required placeholder="Q-2026-001" /></label>
                <label>Title <input type="text" name="title" maxlength="200" required /></label>
                <label>Revision <input type="number" name="revision" min="1" value="1" /></label>
                <label>Expires <input type="date" name="expires_on" /></label>
                <label>Status
                    <select name="status">
                        <option value="draft">draft</option>
                        <option value="issued">issued</option>
                        <option value="accepted">accepted</option>
                        <option value="rejected">rejected</option>
                        <option value="expired">expired</option>
                    </select>
                </label>
                <div class="form-actions">
                    <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Save quotation</button>
                </div>
            </form>
        </section>
        <section class="epc-erp-form-panel">
            <div class="epc-erp-form-panel__head"><strong>Fit-out VAT / invoice bridge</strong></div>
            <form method="post" action="/erp/fitout/invoice-bridge/save">
                <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
                <ErpMasterPicker Kind="project" FieldName="project_id" Label="Project" Required="true" Min="1" />
                <label>Invoice id <input type="number" name="invoice_id" min="1" required /></label>
                <label>Billing stage
                    <select name="stage">
                        <option value="advance">advance</option>
                        <option value="progress_claim">progress claim</option>
                        <option value="retention">retention</option>
                        <option value="final">final</option>
                    </select>
                </label>
                <label>Reference <input type="text" name="reference" maxlength="120" placeholder="INV-2026-001" /></label>
                <div class="form-actions">
                    <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
                    <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Link invoice</button>
                </div>
            </form>
        </section>
        </div>
    }

    @if (_isAdmin && _workArea == "site")
    {
        <div class="epc-prja-grid">
        <section class="epc-erp-form-panel">
            <div class="epc-erp-form-panel__head"><strong>Fit-out procurement PR / PO / GRN linkage</strong></div>
            <form method="post" action="/erp/fitout/procurement-links/save">
            <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
            <ErpMasterPicker Kind="project" FieldName="project_id" Label="Project" Required="true" Min="1" />
            <label>Cost code id <input type="number" name="cost_code_id" min="0" value="0" style="width:7rem" /></label>
            <label>Requisition id <input type="number" name="requisition_id" min="0" value="0" style="width:7rem" /></label>
            <label>Purchase order id <input type="number" name="purchase_order_id" min="0" value="0" style="width:7rem" /></label>
            <label>GRN id <input type="number" name="goods_receipt_id" min="0" value="0" style="width:6rem" /></label>
            <label>Description <input type="text" name="description" maxlength="240" required style="width:15rem" placeholder="Joinery material package" /></label>
            <label>Qty <input type="number" name="quantity" min="0" step="0.001" style="width:5rem" /></label>
            <label>Committed <input type="number" name="committed_amount" min="0" step="0.01" style="width:7rem" /></label>
            <label>Status
                <select name="status">
                    <option value="requested">requested</option>
                    <option value="ordered">ordered</option>
                    <option value="partially_received">partially received</option>
                    <option value="received">received</option>
                    <option value="cancelled">cancelled</option>
                </select>
            </label>
                <div class="form-actions">
                    <button type="submit" name="confirmWrites" value="false" class="btn btn-default">Validate</button>
                    <button type="submit" name="confirmWrites" value="true" class="btn btn-primary">Save procurement link</button>
                </div>
            </form>
        </section>
        <section class="epc-erp-form-panel">
            <div class="epc-erp-form-panel__head"><strong>Fit-out three-way match / tolerance</strong></div>
            <form method="post" action="/erp/fitout/three-way-matches/save">
                <input type="hidden" name="returnUrl" value="/erp/project-accounting-app" />
                <ErpMasterPicker Kind="project" FieldName="project_id" Label="Project" Required="true" Min="1" />
                <label>Link id <input type="number" name="procurement_link_id" min="0" value="0" /></label>
                <label>PO id <input type="number" name="purchase_order_id" min="0" value="0" /></label>
                <label>GRN id <input type="number" name="goods_receipt_id" min="0" value="0" /></label>
                <label>Invoice ref <input type="text" name="invoice_reference" maxlength="120" required placeholder="INV-2026-001" /></label>
                <label>Ordered <input type="number" name="ordered_amount" min="0" step="0.01" /></label>
                <label>Received <input type="number" name="received_amount" min="0" step="0.01" /></label>
                <label>Invoiced <input type="number" name="invoiced_amount" min="0" step="0.01" /></label>
                <label>Tolerance % <input type="number" name="tolerance_percent" min="0" max="100" step="0.001" value="0" /></label>
                <div class="form-actions">
