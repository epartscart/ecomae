@page "/cp/einvoice-documents-app"
@page "/erp/einvoice-documents-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>E-invoice documents · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                E-invoice documents
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/einvoice-documents-app")</p>
                <p>Open a document to see seller/buyer JSON, tax breakdown, validation, lines, and events. Save seller, buyer, and ASP e-invoice settings here. Fetch FTA legislation to ingest PINT-AE / Peppol instruments.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/einvoice-documents-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedDocument is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="E-invoice KPIs">
        <div class="kpi"><div class="lbl">Documents</div><div class="val">@_summary.DocumentCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open</div><div class="val">@_summary.OpenCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Submitted</div><div class="val">@_summary.SubmittedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Total incl VAT</div><div class="val">@_summary.TotalInclVat.ToString("0.00", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <form id="seller" method="post" action="/erp/ajax/einvoice-save-seller" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:1rem 0;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Seller name <input type="text" name="sellerName" required /></label>
            <label>TRN <input type="text" name="sellerTrn" required maxlength="15" /></label>
            <label>Country <input type="text" name="sellerCountryCode" value="AE" style="width:4rem" /></label>
            <label>City <input type="text" name="sellerCity" value="Dubai" /></label>
            <label>VAT registered <input type="checkbox" name="companyVatRegistered" value="1" checked /></label>
            <button type="submit">Save seller</button>
        </form>
        <form method="post" action="/erp/ajax/einvoice-save-buyer" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Customer user id <input type="number" name="userId" min="1" required style="width:6rem" /></label>
            <label>Buyer name <input type="text" name="buyerName" required /></label>
            <label>TRN <input type="text" name="trn" /></label>
            <button type="submit">Save buyer</button>
        </form>
        <form method="post" action="/erp/ajax/einvoice-save-asp" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>ASP name <input type="text" name="aspName" required /></label>
            <label>Mode <input type="text" name="aspApiMode" value="manual" style="width:7rem" /></label>
            <button type="submit">Save ASP</button>
        </form>
        <form method="post" action="/erp/uae-tax/fta-fetch" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label><input type="checkbox" name="force" value="1" /> Force refetch</label>
            <button type="submit">Fetch FTA e-invoicing legislation</button>
        </form>
        <div class="epc-ei-note">Seller / buyer / ASP profile save writes here. Create, submit, credit-note, and ASP poll stay Classic. FTA fetch writes PINT-AE / Peppol instruments into the UAE tax legislation library.</div>
    }

    @if (_openedDocument is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedDocument.InvoiceNumber) ? _openedDocument.InvoiceNumber : ("E-invoice #" + _openedDocument.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedDocument.Status) ? _openedDocument.Status : "—")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedDocument.DocCategory) ? _openedDocument.DocCategory : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedDocument.CurrencyCode) ? _openedDocument.CurrencyCode : "—")
                        · Order @_openedDocument.OrderId.ToString(CultureInfo.InvariantCulture)
                        · Buyer user @_openedDocument.UserId.ToString(CultureInfo.InvariantCulture)</p>
                    <p>Ex VAT @_openedDocument.SubtotalExVat.ToString("0.00", CultureInfo.InvariantCulture)
                        · VAT @_openedDocument.TotalVat.ToString("0.00", CultureInfo.InvariantCulture)
                        · Incl VAT @_openedDocument.TotalInclVat.ToString("0.00", CultureInfo.InvariantCulture)
                        · Due @_openedDocument.AmountDue.ToString("0.00", CultureInfo.InvariantCulture)</p>
                    <p>Terms @(!string.IsNullOrWhiteSpace(_openedDocument.PaymentTerms) ? _openedDocument.PaymentTerms : "—")
                        · Bank @(!string.IsNullOrWhiteSpace(_openedDocument.BankAccount) ? _openedDocument.BankAccount : "—")
                        · ASP @(!string.IsNullOrWhiteSpace(_openedDocument.AspName) ? _openedDocument.AspName : "—")
                        · FTA @(!string.IsNullOrWhiteSpace(_openedDocument.FtaReportStatus) ? _openedDocument.FtaReportStatus : "—")</p>
                    <p>Valid @( _openedDocument.ValidationOk ? "yes" : "no" )
                        · XML @_openedDocument.XmlBytes.ToString(CultureInfo.InvariantCulture) bytes</p>
                    @if (!string.IsNullOrWhiteSpace(_openedDocument.ValidationErrorsJson))
                    {
                        <p>Validation @_openedDocument.ValidationErrorsJson</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedDocument.TaxBreakdownJson))
                    {
                        <p>Tax breakdown @_openedDocument.TaxBreakdownJson</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedDocument.SellerJson))
                    {
                        <p>Seller @_openedDocument.SellerJson</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedDocument.BuyerJson))
                    {
                        <p>Buyer @_openedDocument.BuyerJson</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedDocument.XmlPreview))
                    {
                        <p>XML preview @_openedDocument.XmlPreview</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Lines</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Line</th>
                                    <th>Item</th>
                                    <th>Qty</th>
                                    <th>Unit</th>
                                    <th>Net</th>
                                    <th>VAT</th>
                                    <th>Gross</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedLines.Count == 0)
                                {
                                    <tr><td colspan="7">No lines yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in _openedLines)
                                    {
                                        <tr>
                                            <td>@row.LineNo.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(row.ItemName) ? row.ItemName : "—")</td>
                                            <td>@row.Quantity.ToString("0.0000", CultureInfo.InvariantCulture)</td>
                                            <td>@row.UnitPrice.ToString("0.0000", CultureInfo.InvariantCulture)</td>
                                            <td>@row.LineNet.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                            <td>@row.TaxAmount.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                            <td>@row.GrossAmount.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Events</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Message</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedEvents.Count == 0)
                                {
                                    <tr><td colspan="4">No events yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in _openedEvents)
                                    {
                                        <tr>
                                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(row.EventType) ? row.EventType : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(row.Message) ? row.Message : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_summary.DocumentCount.ToString(CultureInfo.InvariantCulture) Documents · @_summary.OpenCount.ToString(CultureInfo.InvariantCulture) Open · @_summary.SubmittedCount.ToString(CultureInfo.InvariantCulture) Submitted · @_summary.TotalInclVat.ToString("0.00", CultureInfo.InvariantCulture) Total incl VAT.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Invoice</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>CCY</th>
                    <th>Total</th>
                    <th>Valid</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.InvoiceNumber) ? row.InvoiceNumber : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.DocCategory) ? row.DocCategory : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CurrencyCode) ? row.CurrencyCode : "—")</td>
                            <td>@row.TotalInclVat.ToString("0.00", CultureInfo.InvariantCulture)</td>
                            <td>@(row.ValidationOk ? "yes" : "no")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "ei_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=tax&tab=einvoice";
    private string _listHref = "/cp/einvoice-documents-app";
    private bool _isAdmin;
    private CpEinvoiceDocumentsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpEinvoiceDocumentDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private string _flashOk = "";
    private string _flashErr = "";
    private string _returnHref = "/cp/einvoice-documents-app";
    private CpEinvoiceDocumentDetail? _openedDocument;
    private IReadOnlyList<CpEinvoiceLineDigest> _openedLines = [];
    private IReadOnlyList<CpEinvoiceEventDigest> _openedEvents = [];

    private string OpenedCaption => _openedDocument is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedDocument.InvoiceNumber)
            ? ("E-invoice #" + _openedDocument.Id.ToString(CultureInfo.InvariantCulture))
            : _openedDocument.InvoiceNumber)
            + (string.IsNullOrWhiteSpace(_openedDocument.Status) ? "" : (" · " + _openedDocument.Status));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var path = ctx.Request.Path.Value;
        _listHref = string.Equals(path, "/erp/einvoice-documents-app", StringComparison.OrdinalIgnoreCase)
            ? "/erp/einvoice-documents-app"
            : "/cp/einvoice-documents-app";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "ei_id");
        _returnHref = _openedId > 0
            ? ErpRecordOpen.Href(_listHref, "ei_id", _openedId).Split('#')[0]
            : _listHref;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpEinvoiceDocumentsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Documents;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpEinvoiceDocumentDetailAsync(_openedId, ctx.RequestAborted);
            _openedDocument = detail.Document;
            _openedLines = detail.Lines;
            _openedEvents = detail.Events;
            if (_openedDocument is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
