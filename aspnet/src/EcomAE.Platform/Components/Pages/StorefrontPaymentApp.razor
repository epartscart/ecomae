@page "/storefront/payment-app"
@page "/en/shop/pay"
@page "/shop/pay"
@page "/en/shop/pay/success"
@page "/shop/pay/success"
@page "/en/shop/pay/error"
@page "/shop/pay/error"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Pay · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" />

<StorefrontTenantChrome>
    <section style="padding:2rem 0 3rem">
        <div class="container" style="max-width:40rem">
            <p style="margin:0 0 .35rem;color:#64748b;font-size:.85rem">
                <a href="@StorefrontSurfaceLinks.Orders">My orders</a>
                · Pay
            </p>
            <h1 style="margin:.1rem 0 .4rem">Pay an order or top-up</h1>
            <p style="color:#475569">Create a pending operation, then confirm on the payment gateway.</p>
            @if (!string.IsNullOrWhiteSpace(_flashOk))
            {
                <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
            }
            @if (!string.IsNullOrWhiteSpace(_flashErr))
            {
                <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
            }
            @if (!_isCustomer)
            {
                <div class="panel panel-primary">
                    <div class="panel-body">
                        <p style="margin:0 0 .75rem">@(string.IsNullOrWhiteSpace(OrderId) ? "Sign in to continue payment, or track a guest order first." : ("Order #" + OrderId + " — sign in to create a payment operation. This page does not invent a live card capture."))</p>
                        <a class="btn btn-ar btn-primary" href="@StorefrontSurfaceLinks.Login">Sign in</a>
                        <a class="btn btn-ar btn-default" href="@GuestOrderHref">Guest order</a>
                    </div>
                </div>
            }
            else
            {
                <div class="panel panel-primary">
                    <div class="panel-heading">Pay an order or top-up</div>
                    <div class="panel-body">
                        <form method="post" action="/storefront/payment/create-operation">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <label for="money_value">Amount</label>
                            <input id="money_value" class="form-control" type="number" step="0.01" min="0.01" name="amount" required />
                            <label for="order_id">Order id (blank = balance top-up)</label>
                            <input id="order_id" class="form-control" type="number" min="0" name="order_id" value="@OrderId" />
                            <div class="epc-pay-method-picker" style="margin:12px 0 16px">
                                <label for="epc_pay_handler">Pay with</label>
                                <select id="epc_pay_handler" name="pay_handler" class="form-control">
                                    @foreach (var gate in PhpCustomerWrites.PayGateways)
                                    {
                                        <option value="@gate.Code">@gate.Label</option>
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn btn-ar btn-primary">Create operation &amp; pay</button>
                        </form>
                    </div>
                </div>
                <div class="panel panel-default">
                    <div class="panel-body">
                        <form method="get" action="@PhpCustomerWrites.PaymentDemoHref">
                            <label for="operation">Existing operation number</label>
                            <input id="operation" class="form-control" type="text" name="operation" required value="@Operation" />
                            <label for="gateway">Gateway</label>
                            <select id="gateway" name="pay_system" class="form-control">
                                @foreach (var gate in PhpCustomerWrites.PayGateways)
                                {
                                    <option value="@gate.Code">@gate.Label</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-ar btn-primary" style="margin-top:.75rem">Continue to pay</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private bool _isCustomer;
    private string _flashOk = "";
    private string _flashErr = "";

    [SupplyParameterFromQuery(Name = "operation")]
    public string? Operation { get; set; }

    [SupplyParameterFromQuery(Name = "order_id")]
    public string? OrderId { get; set; }

    private string GuestOrderHref => string.IsNullOrWhiteSpace(OrderId)
        ? StorefrontAspNetCanonical.GuestOrder
        : StorefrontAspNetCanonical.GuestOrder + "?order_id=" + Uri.EscapeDataString(OrderId);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);
        var session = await Sessions.ValidateCustomerAsync(ctx, ctx.RequestAborted);
        _isCustomer = session.Kind == LegacySessionKind.Customer && session.UserId > 0;
    }
}
