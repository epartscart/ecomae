@page "/cp/tenant-config-app"
@page "/erp/tenant-config-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Tenant config · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-w17-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-w17-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-w17-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-w17-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-w17-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f172a; background:#fff;
        }
        .epc-w17-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-w17-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-w17-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-w17-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-w17-kpi span { color:#64748b; font-size:.78rem; }
        .epc-w17-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-w17-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-w17-table th, .epc-w17-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-w17-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-w17-note { margin-top:1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:.45rem; color:#334155; font-size:.86rem; }
        @@media (max-width:900px){ .epc-w17-kpis{grid-template-columns:1fr 1fr;} }
    
</style>
</HeadContent>


<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-w17-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Tenant config</h1>
        <p>@CpPhpModuleCopy.PurposeFor(Nav.Uri)</p>
        <div class="epc-w17-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
        </div>
    </section>
    <PhpParityModuleBody AppPath="/cp/tenant-config-app" IsAdmin="_isAdmin" />


    <div class="epc-w17-kpis" aria-label="Tenant config stats">
        <div class="epc-w17-kpi"><strong>@_summary.ConfigCount.ToString(CultureInfo.InvariantCulture)</strong><span>Configs</span></div>
        <div class="epc-w17-kpi"><strong>@_summary.GroupCount.ToString(CultureInfo.InvariantCulture)</strong><span>Groups</span></div>
        <div class="epc-w17-kpi"><strong>@_summary.EditableCount.ToString(CultureInfo.InvariantCulture)</strong><span>Editable</span></div>
        <div class="epc-w17-kpi"><strong>@_summary.HistoryCount.ToString(CultureInfo.InvariantCulture)</strong><span>History</span></div>
    </div>

    <div class="epc-w17-table-wrap">
    <table class="epc-w17-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Site</th>
                    <th>Group</th>
                    <th>Key</th>
                    <th>Type</th>
                    <th>Label</th>
                    <th>Editable</th>
                    <th>Updated</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="9">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.SiteKey) ? row.SiteKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ConfigGroup) ? row.ConfigGroup : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ConfigKey) ? row.ConfigKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ValueType) ? row.ValueType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Label) ? row.Label : "—")</td>
                            <td>@row.Editable.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.UpdatedAt) ? row.UpdatedAt : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>

</PhpCpDesktopChrome>

<ErpPhpCreateWell Title="ERP settings">
<form method="post" action="/erp/tenant-config/save" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                <input type="hidden" name="returnUrl" value="/erp/tenant-config-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Company <input class="form-control input-sm" name="company_name" style="width:160px;" /></label>
                <label>TRN <input class="form-control input-sm" name="company_trn" style="width:120px;" /></label>
                <label>Currency <input class="form-control input-sm" name="default_currency" style="width:80px;" /></label>
                <label>VAT % <input class="form-control input-sm" name="vat_rate" style="width:70px;" /></label>
                <label>FY start <input class="form-control input-sm" name="fiscal_year_start" style="width:80px;" /></label>
                <label>PO prefix <input class="form-control input-sm" name="po_prefix" style="width:70px;" /></label>
                <label>SO prefix <input class="form-control input-sm" name="so_prefix" style="width:70px;" /></label>
                <label>INV prefix <input class="form-control input-sm" name="inv_prefix" style="width:70px;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save settings</button>
            </form>
</ErpPhpCreateWell>

<form method="post" action="/erp/security/users/assign-role" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/tenant-config-app?tab=security_roles" />
            <strong style="width:100%;font-size:.85rem">Assign role</strong>
            <label>User id <input type="number" name="user_id" min="0" required style="width:6rem" /></label>
            <label>Role id <input type="number" name="role_id" min="0" required style="width:6rem" /></label>
            <label>Assign
                <select name="assign">
                    <option value="1" selected>assign</option>
                    <option value="0">unassign</option>
                </select>
            </label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </form>

<form method="post" action="/erp/security/roles/attach-duty" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/tenant-config-app?tab=security_roles" />
            <strong style="width:100%;font-size:.85rem">Attach duty</strong>
            <label>Role id <input type="number" name="role_id" min="0" required style="width:6rem" /></label>
            <label>Duty id <input type="number" name="duty_id" min="0" required style="width:6rem" /></label>
            <label>Attach
                <select name="attach">
                    <option value="1" selected>attach</option>
                    <option value="0">detach</option>
                </select>
            </label>
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </form>

<form method="post" action="/erp/security/duties/attach-priv" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/tenant-config-app?tab=security_roles" />
            <strong style="width:100%;font-size:.85rem">Attach privilege</strong>
            <label>Duty id <input type="number" name="duty_id" min="0" required style="width:6rem" /></label>
            <label>Privilege id <input type="number" name="privilege_id" min="0" required style="width:6rem" /></label>
            <label>Attach
                <select name="attach">
                    <option value="1" selected>attach</option>
                    <option value="0">detach</option>
                </select>
            </label>
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </form>

<form method="post" action="/erp/security/roles/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/tenant-config-app?tab=security_roles" />
            <strong style="width:100%;font-size:.85rem">Save role</strong>
            <label>Code <input name="code" required maxlength="60" style="width:10rem" /></label>
            <label>Name <input name="name" maxlength="160" style="width:12rem" /></label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </form>

<form method="post" action="/erp/security/duties/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/tenant-config-app?tab=security_roles" />
            <strong style="width:100%;font-size:.85rem">Save duty</strong>
            <label>Code <input name="code" required maxlength="60" style="width:10rem" /></label>
            <label>Name <input name="name" maxlength="160" style="width:12rem" /></label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </form>

<form method="post" action="/erp/security/privileges/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/tenant-config-app?tab=security_roles" />
            <strong style="width:100%;font-size:.85rem">Save privilege</strong>
            <label>Code <input name="code" required maxlength="60" style="width:10rem" /></label>
            <label>Name <input name="name" maxlength="160" style="width:12rem" /></label>
            <label>Access
                <select name="access_level">
                    <option value="read" selected>read</option>
                    <option value="update">update</option>
                    <option value="create">create</option>
                    <option value="delete">delete</option>
                    <option value="full">full</option>
                </select>
            </label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </form>

<form method="post" action="/erp/platform/jobs/run" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/tenant-config-app" />
            <strong style="width:100%;font-size:.85rem">Run batch job</strong>
            <label>Job id <input type="number" name="job_id" min="0" required style="width:6rem" /></label>
            <label>Status
                <select name="status">
                    <option value="ended" selected>ended</option>
                    <option value="waiting">waiting</option>
                    <option value="executing">executing</option>
                    <option value="error">error</option>
                    <option value="canceled">canceled</option>
                </select>
            </label>
            <button type="submit" class="btn btn-sm btn-warning">Run</button>
        </form>

<form method="post" action="/erp/platform/features/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnUrl" />
            <label>Code <input type="text" name="code" required maxlength="60" style="width:8rem" /></label>
            <label>Name <input type="text" name="name" maxlength="160" style="width:12rem" /></label>
            <label>Enabled
                <select name="enabled">
                    <option value="1">enabled</option>
                    <option value="0" selected>disabled</option>
                </select>
            </label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save feature</button>
        </form>

<form method="post" action="/erp/platform/jobs/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnUrl" />
            <label>Code <input type="text" name="code" required maxlength="60" style="width:8rem" /></label>
            <label>Name <input type="text" name="name" maxlength="160" style="width:12rem" /></label>
            <label>Recurrence min <input type="number" name="recurrence_min" min="0" value="0" style="width:6rem" /></label>
            <label>Active
                <select name="active">
                    <option value="1" selected>active</option>
                    <option value="0">inactive</option>
                </select>
            </label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save batch job</button>
        </form>

<form method="post" action="/erp/org/calendars/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnUrl" />
            <label>Code <input type="text" name="code" required maxlength="40" style="width:8rem" /></label>
            <label>Name <input type="text" name="name" maxlength="160" style="width:12rem" /></label>
            <label>Working days <input type="text" name="working_days" maxlength="20" value="1,2,3,4,5" style="width:8rem" /></label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save calendar</button>
        </form>

<form method="post" action="/erp/org/holidays/add" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnUrl" />
            <label>Calendar id <input type="number" name="calendar_id" min="1" required style="width:6rem" /></label>
            <label>Date <input type="text" name="holiday_date" required maxlength="10" placeholder="2026-12-02" style="width:8rem" /></label>
            <label>Name <input type="text" name="name" maxlength="160" style="width:12rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Add holiday</button>
        </form>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=setup&tab=tenant_config";
    private bool _isAdmin;
    private CpTenantConfigSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpTenantConfigEntryDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpTenantConfigDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Entries;
        _source = result.Source;
        _message = result.Message;
    }
    private string _returnUrl => "/cp/tenant-config-app";
}
