@page "/cp/nl-reporting-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>NL Reporting · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                NL Reporting
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/nl-reporting-app")</p>
                <p>Open a definition for a short query excerpt and run history. Save metadata or deactivate a definition here. Query template, recipients, and generate stay on the Classic twin. This page does not invent a send.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/nl-reporting-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div>
    }

    @if (_isAdmin)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">New definition</div>
                <div class="panel-body">
                    <form method="post" action="/cp/nl-reporting/write" class="well">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@_listHref" />
                        <input type="hidden" name="action" value="save" />
                        <input type="hidden" name="id" value="0" />
                        <div class="form-group">
                            <label>Site key</label>
                            <input type="text" class="form-control" name="site_key" />
                        </div>
                        <div class="form-group">
                            <label>Name</label>
                            <input type="text" class="form-control" name="name" maxlength="128" />
                        </div>
                        <div class="form-group">
                            <label>Description</label>
                            <textarea class="form-control" name="description" rows="2"></textarea>
                        </div>
                        <div class="form-group">
                            <label>Type</label>
                            <input type="text" class="form-control" name="report_type" maxlength="32" value="custom" />
                        </div>
                        <div class="form-group">
                            <label>Schedule</label>
                            <select class="form-control" name="schedule">
                                @foreach (var schedule in CpNlReportingWriteService.Schedules)
                                {
                                    <option value="@schedule">@schedule</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Format</label>
                            <select class="form-control" name="format">
                                @foreach (var format in CpNlReportingWriteService.Formats)
                                {
                                    <option value="@format">@format</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-default">Save definition</button>
                    </form>
                    <p class="help-block" style="margin:.75rem 0 0">Query template stay Classic.</p>
                </div>
            </div>
        </div>
    }

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedDef is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="NL reporting KPIs">
        <div class="kpi"><div class="lbl">Definitions</div><div class="val">@_definitions.Count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_definitions.Count(d => d.Active).ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Opened runs</div><div class="val">@_openedRuns.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedDef is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedDef.Name) ? _openedDef.Name : ("Report #" + _openedDef.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(_openedDef.Active ? "active" : "off")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedDef.SiteKey) ? _openedDef.SiteKey : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedDef.ReportType) ? _openedDef.ReportType : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedDef.Schedule) ? _openedDef.Schedule : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedDef.Format) ? _openedDef.Format : "—")</p>
                    @if (!string.IsNullOrWhiteSpace(_openedDef.Description))
                    {
                        <p>@_openedDef.Description</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedDef.QueryExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedDef.QueryExcerpt</pre>
                        @if (_openedDef.QueryLen > _openedDef.QueryExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_openedDef.QueryExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedDef.QueryLen.ToString(CultureInfo.InvariantCulture) chars). Full query and recipients stay on the Classic twin.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No query excerpt yet.</p>
                    }
                    @if (_isAdmin)
                    {
                        <form method="post" action="/cp/nl-reporting/write" class="well" style="margin:.85rem 0 0">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
                            <input type="hidden" name="action" value="save" />
                            <input type="hidden" name="id" value="@_openedDef.Id.ToString(CultureInfo.InvariantCulture)" />
                            <div class="form-group">
                                <label>Site key</label>
                                <input type="text" class="form-control" name="site_key" value="@_openedDef.SiteKey" />
                            </div>
                            <div class="form-group">
                                <label>Name</label>
                                <input type="text" class="form-control" name="name" maxlength="128" value="@_openedDef.Name" />
                            </div>
                            <div class="form-group">
                                <label>Description</label>
                                <textarea class="form-control" name="description" rows="2">@_openedDef.Description</textarea>
                            </div>
                            <div class="form-group">
                                <label>Type</label>
                                <input type="text" class="form-control" name="report_type" maxlength="32" value="@_openedDef.ReportType" />
                            </div>
                            <div class="form-group">
                                <label>Schedule</label>
                                <select class="form-control" name="schedule">
                                    @foreach (var schedule in CpNlReportingWriteService.Schedules)
                                    {
                                        @if (OpenedSchedule == schedule)
                                        {
                                            <option value="@schedule" selected>@schedule</option>
                                        }
                                        else
                                        {
                                            <option value="@schedule">@schedule</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Format</label>
                                <select class="form-control" name="format">
                                    @foreach (var format in CpNlReportingWriteService.Formats)
                                    {
                                        @if (OpenedFormat == format)
                                        {
                                            <option value="@format" selected>@format</option>
                                        }
                                        else
                                        {
                                            <option value="@format">@format</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="checkbox">
                                <label>
                                    @if (_openedDef.Active)
                                    {
                                        <input type="checkbox" name="active" value="1" checked />
                                    }
                                    else
                                    {
                                        <input type="checkbox" name="active" value="1" />
                                    }
                                    Active
                                </label>
                            </div>
                            <button type="submit" class="btn btn-default">Save definition</button>
                        </form>
                        <form method="post" action="/cp/nl-reporting/write" class="well" style="margin:.85rem 0 0">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@_listHref" />
                            <input type="hidden" name="action" value="delete" />
                            <input type="hidden" name="id" value="@_openedDef.Id.ToString(CultureInfo.InvariantCulture)" />
                            <button type="submit" class="btn btn-default">Deactivate</button>
                        </form>
                        <p class="help-block" style="margin:.75rem 0 0">Query template, recipients, and generate stay Classic.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Runs</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Status</th>
                                    <th>Rows</th>
                                    <th>Ms</th>
                                    <th>Error</th>
                                    <th>Started</th>
                                    <th>Completed</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedRuns.Count == 0)
                                {
                                    <tr><td colspan="7">No runs yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var run in _openedRuns)
                                    {
                                        <tr>
                                            <td>@run.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(run.Status) ? run.Status : "—")</td>
                                            <td>@run.RowCount.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@run.ExecutionMs.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(run.ErrorMessage) ? run.ErrorMessage : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(run.CreatedAt) ? run.CreatedAt : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(run.CompletedAt) ? run.CompletedAt : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Site</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Schedule</th>
                    <th>Format</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_definitions.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var d in _definitions)
                    {
                        <tr id="erp-row-@d.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(d.Id, _openedId)">
                            <td><strong>@d.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(d.SiteKey) ? "—" : d.SiteKey)</td>
                            <td>@(string.IsNullOrWhiteSpace(d.Name) ? "—" : d.Name)</td>
                            <td>@(string.IsNullOrWhiteSpace(d.ReportType) ? "—" : d.ReportType)</td>
                            <td>@(string.IsNullOrWhiteSpace(d.Schedule) ? "—" : d.Schedule)</td>
                            <td>@(string.IsNullOrWhiteSpace(d.Format) ? "—" : d.Format)</td>
                            <td>@(d.Active ? "yes" : "no")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "report_id", d.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_nl_reporting";
    private const string _listHref = "/cp/nl-reporting-app";
    private bool _isAdmin;
    private IReadOnlyList<CpNlReportDefinitionDigest> _definitions = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private CpNlReportDefinitionDetail? _openedDef;
    private IReadOnlyList<CpNlReportRunDigest> _openedRuns = [];
    private string _flashOk = "";
    private string _flashErr = "";

    private string OpenedSchedule => CpNlReportingWriteService.NormalizeSchedule(_openedDef?.Schedule);

    private string OpenedFormat => CpNlReportingWriteService.NormalizeFormat(_openedDef?.Format);

    private string OpenedReturnHref => _openedId > 0
        ? ErpRecordOpen.Href(_listHref, "report_id", _openedId)
        : _listHref;

    private string OpenedCaption => _openedDef is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedDef.Name)
            ? ("Report #" + _openedDef.Id.ToString(CultureInfo.InvariantCulture))
            : _openedDef.Name)
            + (_openedDef.Active ? " · active" : " · off");

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "report_id");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListCpNlReportDefinitionsAsync(200, ctx.RequestAborted);
        _definitions = result.Definitions;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpNlReportDefinitionDetailAsync(_openedId, ctx.RequestAborted);
            _openedDef = detail.Definition;
            _openedRuns = detail.Runs;
            if (_openedDef is not null)
            {
                var openedList = _definitions.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _definitions = new[] { openedList }.Concat(_definitions.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
