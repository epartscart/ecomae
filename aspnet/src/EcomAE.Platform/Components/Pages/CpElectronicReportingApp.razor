@page "/cp/electronic-reporting-app"
@page "/erp/electronic-reporting-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Electronic reporting · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Electronic reporting
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/electronic-reporting-app")</p>
                <p>Add a reporting field or save a format here.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/electronic-reporting-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_summary.FormatCount.ToString(CultureInfo.InvariantCulture) Formats · @_summary.FieldCount.ToString(CultureInfo.InvariantCulture) Fields · @_summary.RunCount.ToString(CultureInfo.InvariantCulture) Runs · @_summary.OutputTypeCount.ToString(CultureInfo.InvariantCulture) Output types.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Company</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Output</th>
                    <th>Root</th>
                    <th>Active</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="8">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CompanyId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Code) ? row.Code : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.OutputType) ? row.OutputType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.RootElement) ? row.RootElement : "—")</td>
                            <td>@row.Active.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

<form method="post" action="/erp/electronic-reporting/fields/add" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnUrl" />
            <label>Format id <input type="number" name="format_id" min="1" required style="width:6rem" /></label>
            <label>Label <input type="text" name="label" required maxlength="80" style="width:10rem" /></label>
            <label>Source key <input type="text" name="source_key" required maxlength="80" style="width:10rem" /></label>
            <label>Ordinal <input type="number" name="ordinal" min="0" value="0" style="width:5rem" /></label>
            <button type="submit">Add field</button>
        </form>

<form method="post" action="/erp/electronic-reporting/formats/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnUrl" />
            <input type="hidden" name="id" value="0" />
            <label>Code <input type="text" name="code" required maxlength="40" style="width:8rem" /></label>
            <label>Name <input type="text" name="name" required maxlength="160" style="width:14rem" /></label>
            <label>Output
                <select name="output_type">
                    <option value="csv" selected>csv</option>
                    <option value="xml">xml</option>
                    <option value="json">json</option>
                </select>
            </label>
            <label>Root <input type="text" name="root_element" maxlength="60" value="rows" style="width:7rem" /></label>
            <label>Row <input type="text" name="row_element" maxlength="60" value="row" style="width:7rem" /></label>
            <label>Active
                <select name="active">
                    <option value="1" selected>active</option>
                    <option value="0">inactive</option>
                </select>
            </label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit">Save format</button>
        </form>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=tax&tab=elec_reporting";
    private bool _isAdmin;
    private CpElectronicReportingSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpElectronicReportingFormatDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpElectronicReportingDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Formats;
        _source = result.Source;
        _message = result.Message;
    }
    private string _returnUrl => "/cp/electronic-reporting-app";
}
