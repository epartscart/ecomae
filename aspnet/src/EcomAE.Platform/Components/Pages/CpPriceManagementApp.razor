                    </select>
                    <br>
                    <label>Action</label>
                    <select class="form-control" name="visible"><option value="0">Hide selected brands</option><option value="1">Show selected brands</option></select>
                    <br>
                    <button class="btn btn-default" type="submit">Apply to selected brands</button>
                </div>
                <div class="col-md-8">
                    <label>Brands (Ctrl+click to select multiple)</label>
                    <input class="form-control" id="epc_brand_visibility_filter" placeholder="Filter brands…" onkeyup="epcFilterBrandVisibilityList();" style="margin-bottom:8px;" />
                    <select class="form-control" id="epc_brand_visibility_select" name="brands[]" multiple="multiple" size="12">
                        @foreach (var b in _page.Brands) { <option value="@b">@b</option> }
                    </select>
                </div>
            </div>
        </form>
    </div>
</details>

<p class="text-muted epc-pm-nav-top" style="margin-top:20px;">
    <a href="/cp/guideline-app"><i class="fa fa-book"></i> Full CP guideline</a>
    <a href="/cp/prices-upload-app"><i class="fa fa-upload"></i> Price upload guide</a>
    <a href="/cp/prices-edit-app"><i class="fa fa-list"></i> Prices edit</a>
</p>

</div><!-- .epc-pm -->

<script>
function epcFilterBrandVisibilityList() {
    var filter = document.getElementById('epc_brand_visibility_filter').value.toUpperCase();
    var select = document.getElementById('epc_brand_visibility_select');
    for (var i = 0; i < select.options.length; i++) {
        var option = select.options[i];
        option.style.display = option.text.toUpperCase().indexOf(filter) !== -1 ? '' : 'none';
    }
}
(function () {
    var tabs = document.querySelectorAll('.epc-pm-wh-tabs [data-wh-tab]');
    var panes = document.querySelectorAll('.epc-pm-wh-pane[data-wh-pane]');
    tabs.forEach(function (btn) {
        btn.addEventListener('click', function () {
            var key = btn.getAttribute('data-wh-tab');
            tabs.forEach(function (b) { b.classList.toggle('is-active', b === btn); });
            panes.forEach(function (p) { p.hidden = p.getAttribute('data-wh-pane') !== key; });
        });
    });
})();
</script>
}
</PhpCpDesktopChrome>

@code {
    private const string PageHref = EcomAeRoutes.ControlPanelPriceManagementApp;
    private const string ActionHref = EcomAeRoutes.CpPriceManagementAction;

    private bool _isAdmin;
    private CpPriceManagementPage _page = CpPriceManagementPage.Empty(null);
    private string _flashOk = "";
    private string _flashErr = "";
    private int _previewGroupId;
    private int _previewStorageId;
    private string _previewBrand = "MAZDA";
    private string _previewArticle = "";
    private string _previewBase = "100";

    private static string F2(decimal v) => CpPriceManagementService.F2(v);

    private RenderFragment Hidden(string action) => __builder =>
    {
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="@PageHref" />
        <input type="hidden" name="action" value="@action" />
    };

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var q = ctx.Request.Query;
        _flashOk = q["ok"].ToString() ?? "";
        _flashErr = q["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        CpPmPreviewRequest? preview = null;
        if (q["preview"].ToString() == "1")
        {
            _previewGroupId = Int(q["group_id"].ToString());
            _previewStorageId = Int(q["storage_id"].ToString());
            _previewBrand = q.ContainsKey("brand") ? q["brand"].ToString() : "TOYOTA";
            _previewArticle = q["article"].ToString();
            _previewBase = q.ContainsKey("base_price") ? q["base_price"].ToString() : "100";
            decimal.TryParse(_previewBase.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var basePrice);
            if (basePrice <= 0m && !q.ContainsKey("base_price")) basePrice = 100m;
            preview = new CpPmPreviewRequest(_previewGroupId, _previewBrand, _previewArticle, basePrice, _previewStorageId);
        }

        _page = await Pricing.LoadAsync(preview, ctx.RequestAborted);
    }

    private static int Int(string raw) => int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var n) ? n : 0;
}
