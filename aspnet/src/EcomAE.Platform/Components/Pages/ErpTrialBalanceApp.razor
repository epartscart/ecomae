@page "/erp/trial-balance-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Components.Shared.Desktop
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Presentation
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject IErpTrialBalanceReadService TrialBalance

<PageTitle>Trial balance · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Trial balance" BreadcrumbArea="Record to Report" BreadcrumbTab="Trial balance">
<ErpPrintDesignerLink Kind="posted_report" />
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="@ErpTrialBalanceParameters.AppPath" IsAdmin="_isAdmin" />
    <PhpErpModulePageHeader Title="Trial balance" Subtitle="Account and dimension balances for a date range, posting layer, and opening/closing options." PhpTabHref="@_phpTab" />

    <ErpManualProcessStrip Keys="gl" />

    <div class="epc-erp-d365" data-epc-aspnet-d365="1">
        <div class="epc-d365-ribbon" role="toolbar" aria-label="Action pane">
            <div class="epc-d365-aptabs" role="tablist">
                <button type="button" class="epc-d365-aptab is-active" data-aptab="home" role="tab" aria-selected="true">Home</button>
            </div>
            <div class="epc-d365-ap-row is-active" data-aptab="home">
                <div class="epc-d365-actionpane" role="toolbar">
                    <div class="epc-d365-ap-group">
                        <div class="epc-d365-ap-buttons">
                            <a class="epc-d365-ap-btn is-primary" href="@(_parameters.AccountCode is { Length: > 0 } ? _parameters.AppHref() : "/erp/gl-journals-app")"><i class="fa fa-sitemap" aria-hidden="true"></i><span>Accounting source explorer</span></a>
                            <a class="epc-d365-ap-btn" href="/erp/gl-journals-app"><i class="fa fa-list" aria-hidden="true"></i><span>All transactions</span></a>
                            <a class="epc-d365-ap-btn" href="/erp/period-close-app"><i class="fa fa-calendar" aria-hidden="true"></i><span>Fiscal year transactions</span></a>
                            <a class="epc-d365-ap-btn" href="/erp/multi-currency-gl-app"><i class="fa fa-money" aria-hidden="true"></i><span>By currency</span></a>
                            <a class="epc-d365-ap-btn" href="/erp/intercompany-app"><i class="fa fa-exchange" aria-hidden="true"></i><span>Intercompany setup</span></a>
                            <a class="epc-d365-ap-btn @(_parameters.Consolidated ? "is-primary" : "")" href="@ConsolidatedHref()"><i class="fa fa-object-group" aria-hidden="true"></i><span>Consolidation</span></a>
                            <a class="epc-d365-ap-btn" href="/erp/period-close-app"><i class="fa fa-clock-o" aria-hidden="true"></i><span>Period</span></a>
                            <a class="epc-d365-ap-btn" href="/erp/cash-accounts-app?tab=cash_forecast"><i class="fa fa-line-chart" aria-hidden="true"></i><span>Cash flow forecasts</span></a>
                        </div>
                        <div class="epc-d365-ap-label">Inquiry</div>
                    </div>
                    <div class="epc-d365-ap-group">
                        <div class="epc-d365-ap-buttons">
                            <a class="epc-d365-ap-btn" href="#tb-parameters"><i class="fa fa-columns" aria-hidden="true"></i><span>Columns to display</span></a>
                            <a class="epc-d365-ap-btn" href="#tb-snapshots"><i class="fa fa-camera" aria-hidden="true"></i><span>Trial balance snapshots</span></a>
                            <a class="epc-d365-ap-btn" href="@_parameters.FileHref("print")" target="_blank" rel="noopener"><i class="fa fa-print" aria-hidden="true"></i><span>Print</span></a>
                            <a class="epc-d365-ap-btn" href="@_parameters.FileHref("pdf")"><i class="fa fa-file-pdf-o" aria-hidden="true"></i><span>PDF</span></a>
                            <a class="epc-d365-ap-btn" href="@_parameters.FileHref("xlsx")"><i class="fa fa-file-excel-o" aria-hidden="true"></i><span>Excel</span></a>
                            <a class="epc-d365-ap-btn" href="@_parameters.ExportHref()"><i class="fa fa-file-excel-o" aria-hidden="true"></i><span>Open in Excel</span></a>
                        </div>
                        <div class="epc-d365-ap-label">Share</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        #tb-parameters button.btn{background:#1f4e79 !important;color:#fff !important;border:0}
    </style>
    <form method="get" action="@ErpTrialBalanceParameters.AppPath">
    <div class="epc-d365-lp">
        <div class="epc-d365-lp-side">
            <div class="epc-d365-lp-heading">Parameters</div>
            <div class="epc-d365-lpsect">
                <p class="epc-d365-lp-cap">Date range</p>
                <div class="epc-d365-lp-fields">
                    <label>From date <input type="date" name="from" value="@_parameters.FromDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" required /></label>
                    <label>To date <input type="date" name="to" value="@_parameters.ToDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" required /></label>
                    <label>Date interval
                        <select name="interval">
                            <option value="" selected="@string.IsNullOrWhiteSpace(_parameters.Interval)">Custom</option>
                            <option value="this_month" selected="@(_parameters.Interval == "this_month")">This month</option>
                            <option value="this_quarter" selected="@(_parameters.Interval == "this_quarter")">This quarter</option>
                            <option value="this_year" selected="@(_parameters.Interval == "this_year")">This year</option>
                            <option value="last_year" selected="@(_parameters.Interval == "last_year")">Last year</option>
                        </select>
                    </label>
                </div>
            </div>
            <div class="epc-d365-lpsect">
                <p class="epc-d365-lp-cap">Data to include</p>
                <div class="epc-d365-lp-fields">
                    <label>Financial dimension set
                        <select name="dimension_set">
                            <option value="main_account" selected="@(_parameters.DimensionSet == ErpTrialBalanceDimensionSet.MainAccount)">Main account</option>
                            <option value="company" selected="@(_parameters.DimensionSet == ErpTrialBalanceDimensionSet.MainAccountCompany)">Main account + company</option>
                            <option value="business_unit" selected="@(_parameters.DimensionSet == ErpTrialBalanceDimensionSet.MainAccountBusinessUnit)">Main account + business unit</option>
                        </select>
                    </label>
                    <label>Business unit
                        <input type="number" name="bu" min="0" step="1" value="@(_parameters.BusinessUnitId > 0 ? _parameters.BusinessUnitId.ToString(CultureInfo.InvariantCulture) : "")" placeholder="All units" />
                    </label>
                    @if (_parameters.CompanyId > 0)
                    {
                        <input type="hidden" name="company" value="@_parameters.CompanyId.ToString(CultureInfo.InvariantCulture)" />
                    }
                    <label>Posting layer
                        <select name="layer">
                            <option value="current" selected="@(_parameters.PostingLayer == ErpTrialBalancePostingLayer.Current)">Current</option>
                            <option value="operations" selected="@(_parameters.PostingLayer == ErpTrialBalancePostingLayer.Operations)">Operations</option>
                            <option value="tax" selected="@(_parameters.PostingLayer == ErpTrialBalancePostingLayer.Tax)">Tax</option>
                        </select>
                    </label>
                    <label>Opening balances
                        <select name="opening">
                            <option value="column" selected="@(_parameters.OpeningDisplay == ErpTrialBalanceOpeningDisplay.Column)">Opening balance column</option>
                            <option value="include_in_period" selected="@(_parameters.OpeningDisplay == ErpTrialBalanceOpeningDisplay.IncludeInPeriod)">Include in period activity</option>
                            <option value="exclude" selected="@(_parameters.OpeningDisplay == ErpTrialBalanceOpeningDisplay.Exclude)">Do not show opening</option>
                        </select>
                    </label>
                    <label class="epc-d365-lp-check"><input type="hidden" name="include_closing" value="0" /><input type="checkbox" name="include_closing" value="1" checked="@_parameters.IncludeClosingTransactions" /> Include closing transactions</label>
                    <label class="epc-d365-lp-check"><input type="hidden" name="include_closing_adj" value="0" /><input type="checkbox" name="include_closing_adj" value="1" checked="@_parameters.IncludeClosingAdjustments" /> Include closing adjustments</label>
                    <label class="epc-d365-lp-check"><input type="hidden" name="separate_dims" value="0" /><input type="checkbox" name="separate_dims" value="1" checked="@_parameters.SeparateDimensionColumns" /> Separate dimension columns</label>
                </div>
            </div>
            <div class="epc-d365-lpsect">
                <div class="form-actions" style="margin:0"><button type="submit" class="btn btn-primary">Calculate balances</button></div>
            </div>
        </div>
        <div class="epc-d365-lp-main">
            <div class="epc-d365-filterbar">
                <i class="fa fa-filter" aria-hidden="true"></i>
                <input type="search" name="q" value="@(_parameters.Filter ?? "")" placeholder="Filter — main account or name" />
            </div>
            <ErpD365ModuleArea Kind="tb" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Income and profit">
        <div class="kpi"><div class="lbl">Income</div><div class="val">@_result.Income.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Expenses</div><div class="val">@_result.Expenses.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Gross profit</div><div class="val">@_result.GrossProfit.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Net profit</div><div class="val">@_result.NetProfit.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>
    <p class="text-muted">Income, expenses, and gross profit use @_parameters.FromDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) to @_parameters.ToDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture). The year-end close stays on retained earnings.</p>
    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Trial balance totals">
        <div class="kpi"><div class="lbl">Accounts</div><div class="val">@_result.Lines.Count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Opening</div><div class="val">@_result.OpeningTotal.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Debit</div><div class="val">@_result.DebitTotal.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Credit</div><div class="val">@_result.CreditTotal.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Amount</div><div class="val">@AmountTotal.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Closing</div><div class="val">@_result.ClosingTotal.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_parameters.AccountCode))
    {
        <section class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>Voucher transactions · @_parameters.AccountCode</strong>
                <a class="btn btn-xs btn-default" href="@_parameters.AppHref("")">Close drill</a>
            </p>
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead>
                    <tr>
                        <th>Voucher</th>
                        <th>Date</th>
                        <th>Source</th>
                        <th>Reference</th>
                        <th>Debit</th>
                        <th>Credit</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_result.Vouchers.Count == 0)
                    {
                        <tr><td colspan="7">@(_isAdmin ? "No voucher transactions in this range." : "Sign in with ERP capability for live rows.")</td></tr>
                    }
                    else
                    {
                        @foreach (var voucher in _result.Vouchers)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(voucher.JournalNo) ? $"#{voucher.JournalId}" : voucher.JournalNo)</td>
                                <td>@FormatTime(voucher.JournalDate)</td>
                                <td>@voucher.SourceType</td>
                                <td>@(string.IsNullOrWhiteSpace(voucher.Reference) ? "—" : voucher.Reference)</td>
                                <td>@voucher.Debit.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@voucher.Credit.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href("/erp/gl-journals-app", "journal_id", voucher.JournalId)">Open voucher</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </section>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Main account</th>
                    <th>Name</th>
                    <th>Type</th>
                    @if (ShowDimension)
                    {
                        <th>@DimensionHeading</th>
                    }
                    <th>Opening balance</th>
                    <th>Debit</th>
                    <th>Credit</th>
                    <th>Amount</th>
                    <th>Closing balance</th>
                    <th>Posting layer</th>
                </tr>
            </thead>
            <tbody>
                @if (_result.Lines.Count == 0)
                {
                    <tr><td colspan="@Colspan">@(_isAdmin ? (string.IsNullOrWhiteSpace(_result.Message) ? "No accounts yet." : _result.Message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var line in _result.Lines)
                    {
                        <tr>
                            <td><a href="@_parameters.AppHref(line.Code)"><strong>@line.Code</strong></a></td>
                            <td>@line.Name</td>
                            <td>@line.AccountType</td>
                            @if (ShowDimension)
                            {
                                <td>@(string.IsNullOrWhiteSpace(line.Company) ? "—" : line.Company)</td>
                            }
                            <td><a href="@_parameters.AppHref(line.Code)">@line.Opening.ToString("N2", CultureInfo.InvariantCulture)</a></td>
                            <td><a href="@_parameters.AppHref(line.Code)">@line.Debit.ToString("N2", CultureInfo.InvariantCulture)</a></td>
                            <td><a href="@_parameters.AppHref(line.Code)">@line.Credit.ToString("N2", CultureInfo.InvariantCulture)</a></td>
                            <td><a href="@_parameters.AppHref(line.Code)">@line.Amount.ToString("N2", CultureInfo.InvariantCulture)</a></td>
                            <td><a href="@_parameters.AppHref(line.Code)">@line.Closing.ToString("N2", CultureInfo.InvariantCulture)</a></td>
                            <td>@ErpTrialBalanceParameters.LayerLabel(_parameters.PostingLayer)</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="@(ShowDimension ? 4 : 3)"><strong>Total</strong></td>
                        <td><strong>@_result.OpeningTotal.ToString("N2", CultureInfo.InvariantCulture)</strong></td>
                        <td><strong>@_result.DebitTotal.ToString("N2", CultureInfo.InvariantCulture)</strong></td>
                        <td><strong>@_result.CreditTotal.ToString("N2", CultureInfo.InvariantCulture)</strong></td>
                        <td><strong>@AmountTotal.ToString("N2", CultureInfo.InvariantCulture)</strong></td>
                        <td><strong>@_result.ClosingTotal.ToString("N2", CultureInfo.InvariantCulture)</strong></td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
        </div>
    </div>
    </form>

    @if (_isAdmin)
    {
        <section id="tb-snapshots" class="epc-d365-entry" style="margin:1rem 0">
            <div class="epc-d365-entry-head">
                <span>Trial balance snapshots</span>
                <span class="text-muted" style="font-weight:400">Stores the current parameter set and balances with an external tracking id.</span>
            </div>
            <div class="epc-d365-entry-body">
            <form method="post" action="@ErpTrialBalanceParameters.SnapshotPath">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@_parameters.AppHref()" />
                <input type="hidden" name="from" value="@_parameters.FromDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
                <input type="hidden" name="to" value="@_parameters.ToDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
                <input type="hidden" name="layer" value="@ErpTrialBalanceParameters.LayerKey(_parameters.PostingLayer)" />
                <input type="hidden" name="opening" value="@ErpTrialBalanceParameters.OpeningKey(_parameters.OpeningDisplay)" />
                <input type="hidden" name="include_closing" value="@(_parameters.IncludeClosingTransactions ? "1" : "0")" />
                <input type="hidden" name="include_closing_adj" value="@(_parameters.IncludeClosingAdjustments ? "1" : "0")" />
                <input type="hidden" name="dimension_set" value="@ErpTrialBalanceParameters.DimensionKey(_parameters.DimensionSet)" />
                <input type="hidden" name="separate_dims" value="@(_parameters.SeparateDimensionColumns ? "1" : "0")" />
                <label>External tracking id <input type="text" name="tracking_id" maxlength="64" placeholder="TB-ASAG-FY" /></label>
                <div class="form-actions"><button type="submit" class="btn btn-default">Add trial balance snapshot</button></div>
            </form>
            <div class="epc-erp-table-wrap" style="margin-top:12px">
                <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Tracking id</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Layer</th>
                            <th>Dimension set</th>
                            <th>Rows</th>
                            <th>Closing</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_result.Snapshots.Count == 0)
                        {
                            <tr><td colspan="7">No snapshots yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var snap in _result.Snapshots)
                            {
                                <tr>
                                    <td>@snap.TrackingId</td>
                                    <td>@snap.FromDate</td>
                                    <td>@snap.ToDate</td>
                                    <td>@snap.PostingLayer</td>
                                    <td>@snap.DimensionSet</td>
                                    <td>@snap.RowCount.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@snap.ClosingTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            </div>
        </section>
    }

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        @_parameters.FromDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
        to @_parameters.ToDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
        @if (!string.IsNullOrWhiteSpace(_parameters.Interval)) { <span> · @ErpTrialBalanceParameters.IntervalLabel(_parameters.Interval)</span> }
        · @ErpTrialBalanceParameters.LayerLabel(_parameters.PostingLayer)
        · @ErpTrialBalanceParameters.OpeningLabel(_parameters.OpeningDisplay)
        · @ErpTrialBalanceParameters.DimensionLabel(_parameters.DimensionSet)
        · Debit total @_result.DebitTotal.ToString("N2", CultureInfo.InvariantCulture)
        · Credit total @_result.CreditTotal.ToString("N2", CultureInfo.InvariantCulture)
        · @(InBalance ? "In balance" : "Out of balance")
        · Balance @_result.ClosingTotal.ToString("N2", CultureInfo.InvariantCulture)
        · Click a balance to open voucher transactions.
        @if (!string.IsNullOrWhiteSpace(_result.Message)) { <span> @_result.Message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private string _phpTab = "/ERP/?epc_erp_shell=1&area=finance&tab=enterprise_reports";
    private ErpTrialBalanceParameters _parameters = ErpTrialBalanceParameters.FromQuery(null, null, null, null, null, null, null, null, null, null);
    private ErpTrialBalanceResult _result = new(ErpTrialBalanceParameters.FromQuery(null, null, null, null, null, null, null, null, null, null), [], [], [], 0, 0, 0, 0, "migration", "");

    private bool ShowDimension => _parameters.SeparateDimensionColumns || _parameters.DimensionSet != ErpTrialBalanceDimensionSet.MainAccount;
    private string DimensionHeading => _parameters.DimensionSet == ErpTrialBalanceDimensionSet.MainAccountBusinessUnit ? "Business unit" : "Company";
    private int Colspan => ShowDimension ? 10 : 9;
    private decimal AmountTotal => _result.DebitTotal - _result.CreditTotal;
    private bool InBalance => Math.Abs(_result.DebitTotal - _result.CreditTotal) < 0.005m && Math.Abs(_result.ClosingTotal) < 0.005m;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        var q = ctx.Request.Query;
        _parameters = ErpTrialBalanceParameters.FromQuery(
            q["from"], q["to"], q["layer"], q["opening"],
            q["include_closing"], q["include_closing_adj"],
            q["dimension_set"], q["separate_dims"], q["account"], q["limit"],
            q["interval"], string.IsNullOrWhiteSpace(q["q"]) ? q["filter"] : q["q"],
            q["bu"], q["company"]);

        var session = await Sessions.ValidateAsync(ctx);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        _result = await TrialBalance.ReadAsync(_parameters, ctx.RequestAborted);
    }

    private string ConsolidatedHref()
        => (_parameters with { Consolidated = !_parameters.Consolidated }).AppHref(_parameters.AccountCode);

    private static string FormatTime(long unix)
    {
        if (unix <= 0)
        {
            return "—";
        }

        return DateTimeOffset.FromUnixTimeSeconds(unix).UtcDateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
