@page "/storefront/auto-workshop-app"
@page "/en/storefront/auto-workshop-app"
@page "/en/auto-workshop"
@page "/auto-workshop"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject IHttpContextAccessor Http
@inject IStorefrontWorkshopWriteService Workshop

<PageTitle>Repair workshop · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" />

<StorefrontTenantChrome>
    <section class="epc-awo" style="padding:0 0 2.5rem">
        <div style="padding:2.2rem 1rem;color:#f8fafc;background:linear-gradient(120deg,#0b1220 0%,#164e63 42%,#0e7490 100%)">
            <div class="container" style="max-width:46rem">
                <p style="margin:0 0 .35rem;letter-spacing:.08em;text-transform:uppercase;font-size:.75rem;opacity:.85">@_brand · Auto workshop</p>
                <h1 style="margin:.1rem 0 .5rem;font-size:1.85rem">Repair workshop</h1>
                <p style="margin:0 0 1rem;opacity:.94">Book service, track your job, and keep parts and labour on one garage job card.</p>
                <p>
                    <a class="btn btn-default" href="#book" style="margin-right:.4rem">Book service</a>
                    <a class="btn btn-default" href="#track">Track job</a>
                </p>
            </div>
        </div>
        <div class="container" style="max-width:68rem;padding-top:1.5rem">
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.85rem;margin:0 0 1.25rem">
                <div><strong>1. Check-in</strong><p style="color:#64748b;margin:.25rem 0 0">Plate, VIN, odometer, and what needs fixing.</p></div>
                <div><strong>2. Estimate</strong><p style="color:#64748b;margin:.25rem 0 0">Labour hours and parts on one job card.</p></div>
                <div><strong>3. Repair &amp; QC</strong><p style="color:#64748b;margin:.25rem 0 0">Bay and technician assigned before handover.</p></div>
                <div><strong>4. Ready</strong><p style="color:#64748b;margin:.25rem 0 0">Collect the vehicle; the invoice stays with the job.</p></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_flashOk))
            {
                <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
            }
            @if (!string.IsNullOrWhiteSpace(_flashErr))
            {
                <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
            }
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem">
                <div class="panel panel-primary">
                    <div class="panel-heading">Book a service</div>
                    <div class="panel-body">
                        <form id="book" method="post" action="@PhpWorkshopPortal.BookWriteHref">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <label for="customer_name">Your name *</label>
                            <input id="customer_name" class="form-control" name="customer_name" required />
                            <label for="customer_phone">Phone *</label>
                            <input id="customer_phone" class="form-control" name="customer_phone" required placeholder="+971…" />
                            <label for="customer_email">E-mail</label>
                            <input id="customer_email" class="form-control" name="customer_email" type="email" />
                            <label for="plate">Plate *</label>
                            <input id="plate" class="form-control" name="plate" required placeholder="D-12345" />
                            <label>Make / model / year</label>
                            <input class="form-control" name="make" placeholder="Make" />
                            <input class="form-control" name="model" placeholder="Model" />
                            <input class="form-control" name="year" placeholder="Year" />
                            <label for="vin">VIN</label>
                            <input id="vin" class="form-control" name="vin" />
                            <label for="complaint">What needs doing? *</label>
                            <textarea id="complaint" class="form-control" name="complaint" rows="3" required></textarea>
                            <button type="submit" class="btn btn-ar btn-primary" style="margin-top:10px;">Submit booking</button>
                        </form>
                    </div>
                </div>
                <div class="panel panel-primary">
                    <div class="panel-heading">Track your job</div>
                    <div class="panel-body">
                        <form id="track" method="get" action="@PhpWorkshopPortal.TrackWriteHref">
                            <label for="ref">Job number or plate *</label>
                            <input id="ref" class="form-control" name="ref" required placeholder="WS-… or D-12345" value="@Ref" />
                            <label for="phone">Phone (optional)</label>
                            <input id="phone" class="form-control" name="phone" placeholder="+971…" value="@Phone" />
                            <button type="submit" class="btn btn-ar btn-primary" style="margin-top:10px;">Check status</button>
                            <p style="margin:1rem 0 0;color:#64748b;font-size:.85rem">
                                Need parts while you wait?
                                <a href="@StorefrontSurfaceLinks.PartSearch">Parts search</a> ·
                                <a href="@StorefrontSurfaceLinks.LaximoVin">OEM catalog</a>
                            </p>
                        </form>
                        @if (_lookedUp)
                        {
                            @if (_track is not null)
                            {
                                <article style="margin-top:1rem;background:#fff;border:1px solid #e2e8f0;border-radius:.55rem;padding:1rem">
                                    <p style="margin:0 0 .35rem;font-weight:700">@_track.JobNo</p>
                                    <p style="margin:0 0 .35rem;color:#334155">@_track.Status · @_track.Plate</p>
                                    <p style="margin:0;color:#334155">@_track.CustomerName · @_track.Make @_track.Model</p>
                                </article>
                            }
                            else
                            {
                                <p style="margin-top:1rem;color:#b45309">@(_trackMessage.Length > 0 ? _trackMessage : "No job found for that reference.")</p>
                            }
                        }
                    </div>
                </div>
            </div>
            <p style="margin:1rem 0 0;color:#64748b;font-size:.85rem">This page does not invent a send. Keep the job number from booking to track status.</p>
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private string _flashOk = "";
    private string _flashErr = "";
    private bool _lookedUp;
    private string _trackMessage = "";
    private StorefrontWorkshopTrackDigest? _track;

    [SupplyParameterFromQuery(Name = "ref")]
    public string? Ref { get; set; }

    [SupplyParameterFromQuery(Name = "phone")]
    public string? Phone { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _flashOk = ctx?.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx?.Request.Query["err"].ToString() ?? "";
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx?.Request.Host.Host);
        if (string.IsNullOrWhiteSpace(Ref))
        {
            return;
        }

        _lookedUp = true;
        var result = await Workshop.TrackAsync(Ref, Phone, ctx?.RequestAborted ?? default);
        _track = result.Job;
        _trackMessage = result.Message ?? string.Empty;
    }
}
