@page "/erp/operations-editor-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Presentation
@inject IErpAccountingCodesService Codes
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Operations editor · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Operations editor" BreadcrumbArea="Finance" BreadcrumbTab="Operations editor">

    <PhpErpModulePageHeader Title="Accounting operations" Subtitle="Income/expense operations from shop_accounting_codes. Create or rename an operation, or delete an unused non-system row — PHP operations_editor / operation_create_edit twin." />
    <PhpErpD365ActionPane RefreshHref="@Nav.Uri" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }

    @if (_isAdmin)
    {
        <form method="post" action="/erp/operations/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_listHref" />
            <input type="hidden" name="id" value="0" />
            <label>Type
                <select name="income">
                    <option value="0" selected>expense</option>
                    <option value="1">income</option>
                </select>
            </label>
            <label>Name <input type="text" name="name" required maxlength="255" style="width:16rem" /></label>
            <label>Manual
                <select name="manual_available">
                    <option value="1" selected>manual available</option>
                    <option value="0">system only</option>
                </select>
            </label>
            <button type="submit">Add operation</button>
        </form>
    }

    <div class="hpanel">
        <div class="panel-heading hbuilt">Accounting operations</div>
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th class="text-right">#</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Manual</th>
                    <th>System</th>
                    <th>Key</th>
                    <th class="text-right">Used</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No operations yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td class="text-right">@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td><strong>@row.Name</strong></td>
                            <td>@(row.Income == 1 ? "income" : "expense")</td>
                            <td>@(row.ManualAvailable == 1 ? "manual" : "system only")</td>
                            <td>@(row.System == 1 ? "system" : "custom")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Key) ? "—" : row.Key)</td>
                            <td class="text-right">@row.Used.ToString(CultureInfo.InvariantCulture)</td>
                            <td>
                                @if (row.System != 1 && row.Used == 0 && _isAdmin)
                                {
                                    <form method="post" action="/erp/operations/delete" style="display:inline;margin:0">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="@_listHref" />
                                        <input type="hidden" name="id" value="@row.Id" />
                                        <button type="submit" class="btn btn-xs btn-default">Delete</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    <tr style="font-weight:600;background:#f2f6fa">
                        <td>Total</td>
                        <td></td>
                        <td>@_rows.Count(r => r.Income == 1) income</td>
                        <td>@_rows.Count(r => r.ManualAvailable == 1) manual</td>
                        <td>@_rows.Count(r => r.System == 1) system</td>
                        <td></td>
                        <td class="text-right">@_rows.Sum(r => r.Used).ToString(CultureInfo.InvariantCulture)</td>
                        <td>@_rows.Count rows</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private IReadOnlyList<ErpAccountingCodeRow> _rows = [];
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private const string _listHref = "/erp/operations-editor-app";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        _rows = await Codes.ListAsync(ctx.RequestAborted);
        _message = _rows.Count == 0 ? "No operations configured." : "";
    }
}
