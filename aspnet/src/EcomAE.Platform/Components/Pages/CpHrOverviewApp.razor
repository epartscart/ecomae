@page "/cp/hr-overview-app"
@page "/erp/hr-overview-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>HR Overview · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                HR — employee records &amp; salaries
                <a class="btn btn-xs btn-default pull-right" href="/erp/payroll-app">Payroll</a>
                <a class="btn btn-xs btn-default pull-right" href="/erp/staff-app" style="margin-right:.4rem">Staff directory</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" style="margin-right:.4rem">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/hr-overview-app")</p>
                <p>Add an employee, record attendance, generate HR payroll, save days worked, submit a leave request or expense claim, and set leave or expense status here.</p>
            </div>
        </div>
    </div>

    <ErpPhpViewTabs QueryName="hv" Active="@_view" BaseHref="/cp/hr-overview-app" Tabs="@_views" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/hr/employees/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/hr-overview-app" />
            <label>Id <input type="number" name="id" min="0" style="width:5rem" placeholder="new" /></label>
            <label>Code <input type="text" name="code" required placeholder="EMP-001" /></label>
            <label>Name <input type="text" name="name" required /></label>
            <label>Department <input type="text" name="department" /></label>
            <label>Basic <input type="number" name="basic_salary" step="0.01" style="width:7rem" /></label>
            <label>Allowances <input type="number" name="allowances" step="0.01" style="width:7rem" /></label>
            <label>Leave days <input type="number" name="annual_leave_days" step="0.5" value="30" style="width:6rem" /></label>
            <label>Join <input type="date" name="join_date_str" /></label>
            <label>First name <input type="text" name="first_name" /></label>
            <label>Last name <input type="text" name="last_name" /></label>
            <label>Job title <input type="text" name="job_title" /></label>
            <button type="submit">Save employee</button>
        </form>
        <form method="post" action="/erp/hr/payroll/generate" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/hr-overview-app" />
            <label>Period <input type="month" name="period" /></label>
            <label>Employee id <input type="number" name="employee_id" min="0" style="width:6rem" placeholder="optional" /></label>
            <label>Deduction <input type="text" name="label" placeholder="Loan" /></label>
            <label>Amount <input type="number" name="amount" step="0.01" style="width:7rem" /></label>
            <button type="submit">Generate HR payroll</button>
        </form>
        <form method="post" action="/erp/hr/attendance/log" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/hr-overview-app" />
            <label>Employee id <input type="number" name="employee_id" min="1" required style="width:6rem" /></label>
            <label>Work date <input type="date" name="work_date_str" /></label>
            <label>Hours <input type="number" name="hours" step="0.25" min="0" style="width:6rem" /></label>
            <label>Status
                <select name="status">
                    <option value="present">present</option>
                    <option value="absent">absent</option>
                    <option value="leave">leave</option>
                </select>
            </label>
            <button type="submit">Record attendance</button>
        </form>
        <form method="post" action="/erp/ajax/hr-update-days" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/cp/hr-overview-app")" />
            <label>Staff profile id <input type="number" name="staffProfileId" min="1" required style="width:6rem" /></label>
            <label>Days worked <input type="text" name="daysWorked" required /></label>
            <button type="submit">Save days</button>
        </form>
        <form method="post" action="/erp/ajax/hr-leave-request" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/hr-overview-app" />
            <label>Employee id <input type="number" name="employee_id" min="1" required style="width:6rem" /></label>
            <label>Type
                <select name="type">
                    <option value="annual">annual</option>
                    <option value="sick">sick</option>
                    <option value="unpaid">unpaid</option>
                </select>
            </label>
            <label>Days <input type="number" name="days" step="0.01" min="0" style="width:6rem" /></label>
            <label>From <input type="date" name="date_from_str" /></label>
            <label>To <input type="date" name="date_to_str" /></label>
            <button type="submit">Submit leave request</button>
        </form>
        <form method="post" action="/erp/ajax/hr-leave-status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/cp/hr-overview-app")" />
            <label>Leave id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <label>Status
                <select name="status">
                    <option value="pending">pending</option>
                    <option value="approved">approved</option>
                    <option value="rejected">rejected</option>
                </select>
            </label>
            <button type="submit">Set leave status</button>
        </form>
        <form method="post" action="/erp/ajax/hr-expense-save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/hr-overview-app" />
            <label>Employee id <input type="number" name="employee_id" min="1" required style="width:6rem" /></label>
            <label>Title <input type="text" name="title" placeholder="Expense claim" /></label>
            <label>Line <input type="text" name="label" placeholder="Description" /></label>
            <label>Amount <input type="number" name="amount" step="0.01" style="width:7rem" /></label>
            <button type="submit">Submit claim</button>
        </form>
        <form method="post" action="/erp/ajax/hr-expense-status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/cp/hr-overview-app")" />
            <label>Expense id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <label>Status
                <select name="status">
                    <option value="draft">draft</option>
                    <option value="approved">approved</option>
                    <option value="rejected">rejected</option>
                    <option value="paid">paid</option>
                </select>
            </label>
            <button type="submit">Set expense status</button>
        </form>
    }

    <p class="help-block">@_summary.ActiveEmployees.ToString(CultureInfo.InvariantCulture) active employees · @_summary.PendingLeave.ToString(CultureInfo.InvariantCulture) pending leave · @_summary.PayrollRuns.ToString(CultureInfo.InvariantCulture) payroll runs · @_hr.Count.ToString(CultureInfo.InvariantCulture) HR salary records.</p>

    @if (_view == "statutory")
    {
        <h4>Labour law &amp; compliance <small class="text-muted">— built-in country pack</small></h4>
        <p class="text-muted">Reload the statutory pack (same as Classic <code>law_fetch</code>) and open the official labour authority to verify figures. Employee gratuity / leave below still uses the UAE Federal Decree-Law 33/2021 engine.</p>
        <form method="get" action="@_listHref" class="form-inline" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="hv" value="statutory" />
            <input type="hidden" name="law_fetch" value="1" />
            <label>Country
                <select class="form-control input-sm" name="law_country">
                    @foreach (var pack in ErpHrLabourLawPack.All)
                    {
                        <option value="@pack.Code" selected="@(pack.Code == _lawCountry)">@pack.Name (@pack.Code)</option>
                    }
                </select>
            </label>
            <button type="submit" class="btn btn-primary btn-sm">Fetch labour-law pack</button>
            <a class="btn btn-default btn-sm" href="@_law.AuthorityUrl" target="_blank" rel="noopener">Official source</a>
        </form>
        @if (_lawFetched)
        {
            <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">Reloaded @_law.Name labour-law pack. Verify against the official source.</div>
        }
        <div class="table-responsive" style="margin:0 0 1.2rem">
            <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                <tbody>
                    <tr><th>Authority</th><td>@_law.Authority</td></tr>
                    <tr><th>Region</th><td>@_law.Region</td></tr>
                    <tr><th>Weekly hours</th><td>@_law.WeeklyHours.ToString(CultureInfo.InvariantCulture)</td></tr>
                    <tr><th>Workweek</th><td>@_law.Workweek</td></tr>
                    <tr><th>Overtime</th><td>@_law.Overtime</td></tr>
                    <tr><th>Probation</th><td>@_law.ProbationMaxMonths.ToString(CultureInfo.InvariantCulture) months</td></tr>
                    <tr><th>Notice</th><td>@_law.NoticeDays.ToString(CultureInfo.InvariantCulture) days</td></tr>
                    <tr><th>Annual leave</th><td>@_law.AnnualLeaveDays.ToString(CultureInfo.InvariantCulture) days</td></tr>
                    <tr><th>Sick leave</th><td>@_law.SickLeave</td></tr>
                    <tr><th>Maternity / paternity</th><td>@_law.Maternity · @_law.Paternity</td></tr>
                    <tr><th>End-of-service</th><td>@_law.Eos</td></tr>
                    <tr><th>Wage protection</th><td>@_law.WageProtection</td></tr>
                </tbody>
            </table>
        </div>

        <h4>End-of-service &amp; statutory leave <small class="text-muted">— country-aware (United Arab Emirates · AE)</small></h4>
        <p class="text-muted">Gratuity / end-of-service and annual-leave entitlement follow <strong>United Arab Emirates</strong> labour law. Amounts in <strong>AED</strong>.</p>
        <div class="table-responsive">
            <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Joined</th>
                        <th>Service</th>
                        <th>Gratuity (accrued)</th>
                        <th>Annual leave</th>
                        <th>Leave accrued</th>
                        <th>Leave salary (accrued)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_statRows.Count == 0)
                    {
                        <tr><td colspan="7">No HR records.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in _statRows)
                        {
                            <tr>
                                <td>@row.Name</td>
                                <td>@row.Joined</td>
                                <td>@row.Service</td>
                                <td>@((MarkupString)row.GratuityHtml)</td>
                                <td>@row.AnnualLeave</td>
                                <td>@row.LeaveAccrued</td>
                                <td>@row.LeaveSalary</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted"><small><i class="fa fa-info-circle"></i> UAE Federal Decree-Law 33/2021 arts. 51–52: 21 days basic/yr first 5 yrs, 30 days/yr beyond; capped at 2 years’ basic wage; accrued after 1 year continuous service.</small></p>
    }
    else
    {
        <h4>HR — employee records &amp; salaries</h4>
        <p class="text-muted"><strong>Basic + allowances</strong> = fixed monthly salary for a @ErpHrStatutory.StandardDays.ToString(CultureInfo.InvariantCulture)-day month. Set <strong>days worked</strong> before generating payroll (pro-rata: salary ÷ @ErpHrStatutory.StandardDays.ToString(CultureInfo.InvariantCulture) × days). Salaries feed the <a href="/erp/payroll-app">Payroll</a> tab.</p>
        <div class="table-responsive">
            <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Job title</th>
                        <th>Fixed basic</th>
                        <th>Allowances</th>
                        <th>Monthly (30d)</th>
                        <th>Days worked</th>
                        <th>Est. pay</th>
                        <th>Bank</th>
                        <th>Leave</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_salaryRows.Count == 0)
                    {
                        <tr><td colspan="10">@(_isAdmin ? (string.IsNullOrWhiteSpace(_hrMessage) ? "No HR records — run staff setup with sample=1" : _hrMessage) : "Sign in for live data.")</td></tr>
                    }
                    else
                    {
                        @foreach (var row in _salaryRows)
                        {
                            <tr>
                                <td>@row.Name</td>
                                <td>@row.Department</td>
                                <td>@row.JobTitle</td>
                                <td>@row.Basic</td>
                                <td>@row.Allowances</td>
                                <td><strong>@row.Monthly</strong></td>
                                <td>@row.DaysWorked</td>
                                <td><strong>@row.EstPay</strong></td>
                                <td><small>@row.Bank</small></td>
                                <td>@row.Leave</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    <p class="help-block">Source: @_source / @_hrSource. CP employee KPIs stay on <code>epc_hr_*</code>; salary/statutory rows bind <code>epc_erp_hr_records</code>.</p>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=people&tab=hr&epc_erp_shell=1";
    private static readonly IReadOnlyList<(string Key, string Label)> _views =
        [("salaries", "Salaries"), ("statutory", "Labour law & leave")];
    private string _listHref = "/cp/hr-overview-app";
    private string _lawCountry = "AE";
    private bool _lawFetched;
    private ErpHrLabourLawPack.Profile _law = ErpHrLabourLawPack.ByCode("AE");
    private bool _isAdmin;
    private string _view = "salaries";
    private CpHrOverviewSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<ErpHrRecordDigest> _hr = [];
    private IReadOnlyList<SalaryRow> _salaryRows = [];
    private IReadOnlyList<StatRow> _statRows = [];
    private string _source = "n/a";
    private string _flashOk = "";
    private string _flashErr = "";
    private string _hrSource = "n/a";
    private string _hrMessage = "";

    private sealed record SalaryRow(string Name, string Department, string JobTitle, string Basic, string Allowances, string Monthly, string DaysWorked, string EstPay, string Bank, string Leave);
    private sealed record StatRow(string Name, string Joined, string Service, string GratuityHtml, string AnnualLeave, string LeaveAccrued, string LeaveSalary);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var path = ctx.Request.Path.Value;
        _listHref = string.Equals(path, "/erp/hr-overview-app", StringComparison.OrdinalIgnoreCase)
            ? "/erp/hr-overview-app"
            : "/cp/hr-overview-app";
        var hv = ctx.Request.Query["hv"].ToString();
        var tab = ctx.Request.Query["tab"].ToString();
        if (hv is "statutory" or "salaries")
        {
            _view = hv;
        }
        else if (tab is "hr_law" or "statutory")
        {
            _view = "statutory";
        }
        else
        {
            _view = "salaries";
        }

        _lawCountry = (ctx.Request.Query["law_country"].ToString() ?? "").Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(_lawCountry)) _lawCountry = "AE";
        _law = ErpHrLabourLawPack.Resolve(_lawCountry);
        _lawCountry = _law.Code;
        _lawFetched = !string.IsNullOrWhiteSpace(ctx.Request.Query["law_fetch"].ToString());

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && (session.Capabilities.Contains("cp") || session.Capabilities.Contains("erp"));
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpHrOverviewDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _source = result.Source;

        var hr = await Dashboards.ListErpHrRecordsAsync(200, ctx.RequestAborted);
        _hr = hr.Records;
        _hrSource = hr.Source;
        _hrMessage = hr.Message;
        BuildRows();
    }

    private void BuildRows()
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var salaries = new List<SalaryRow>();
        var stats = new List<StatRow>();
        foreach (var h in _hr)
        {
            var name = string.IsNullOrWhiteSpace(h.DisplayName) ? "—" : h.DisplayName;
            var monthly = h.BasicSalary + h.Allowances;
            var days = h.DaysWorked > 0 ? h.DaysWorked : ErpHrStatutory.StandardDays;
            var est = ErpHrStatutory.EstPay(h.BasicSalary, h.Allowances, days);
            var bank = string.IsNullOrWhiteSpace(h.BankName) ? "—" : h.BankName;
            if (!string.IsNullOrWhiteSpace(h.BankAccountPreview)) bank += " · …" + h.BankAccountPreview;
            salaries.Add(new(
                name,
                ErpStaffDepartmentCatalog.NameFor(h.DepartmentCode),
                string.IsNullOrWhiteSpace(h.JobTitle) ? "—" : h.JobTitle,
                h.BasicSalary.ToString("N2", CultureInfo.InvariantCulture) + " AED",
                h.Allowances.ToString("N2", CultureInfo.InvariantCulture) + " AED",
                monthly.ToString("N2", CultureInfo.InvariantCulture) + " AED",
                days.ToString("0.0", CultureInfo.InvariantCulture),
                est.ToString("N2", CultureInfo.InvariantCulture) + " AED",
                bank,
                h.LeaveBalanceDays.ToString("0.0", CultureInfo.InvariantCulture) + " d"));

            var years = ErpHrStatutory.ServiceYears(h.HireDate, now);
            var grat = ErpHrStatutory.GratuityAe(h.BasicSalary, years);
            var leave = ErpHrStatutory.LeaveAe(years * 12.0);
            var leaveSal = ErpHrStatutory.LeaveSalary(h.BasicSalary, leave.AccruedDays);
            var joined = h.HireDate > 0
                ? DateTimeOffset.FromUnixTimeSeconds(h.HireDate).UtcDateTime.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)
                : "—";
            var gratHtml = grat.Eligible
                ? $"<strong>{grat.Amount.ToString("N2", CultureInfo.InvariantCulture)}</strong> AED <small class=\"text-muted\">({grat.Days.ToString("0", CultureInfo.InvariantCulture)} days)</small>"
                : "<span class=\"text-muted\">Not yet eligible</span>";
            stats.Add(new(
                name,
                joined,
                years.ToString("0.0", CultureInfo.InvariantCulture) + " yr",
                gratHtml,
                leave.AnnualDays.ToString("0", CultureInfo.InvariantCulture) + " d/yr",
                leave.AccruedDays.ToString("0.0", CultureInfo.InvariantCulture) + " d",
                leaveSal.ToString("N2", CultureInfo.InvariantCulture) + " AED"));
        }

        _salaryRows = salaries;
        _statRows = stats;
    }
}
