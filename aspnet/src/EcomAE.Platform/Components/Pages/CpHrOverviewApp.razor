@page "/cp/hr-overview-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>HR Overview · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-hr-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-hr-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-hr-hero p { margin:0; color:#ccfbf1; max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-hr-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-hr-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f766e; background:#e0f2fe;
        }
        .epc-hr-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-hr-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-hr-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-hr-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-hr-kpi span { color:#64748b; font-size:.78rem; }
        .epc-hr-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-hr-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-hr-table th, .epc-hr-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-hr-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-hr-note { margin-top:1rem; padding:.75rem .9rem; background:#f0fdfa; border:1px solid #99f6e4; border-radius:.45rem; color:#115e59; font-size:.86rem; }
        @@media (max-width:900px){ .epc-hr-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-hr-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>HR Overview</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-hr-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/cp/projects-overview-app">Projects overview</a>
        </div>
    </section>

    <div class="epc-hr-kpis" aria-label="HR stats">
        <div class="epc-hr-kpi"><strong>@_summary.ActiveEmployees.ToString(CultureInfo.InvariantCulture)</strong><span>Active employees</span></div>
        <div class="epc-hr-kpi"><strong>@_summary.PendingLeave.ToString(CultureInfo.InvariantCulture)</strong><span>Pending leave</span></div>
        <div class="epc-hr-kpi"><strong>@_summary.PayrollRuns.ToString(CultureInfo.InvariantCulture)</strong><span>Payroll runs</span></div>
        <div class="epc-hr-kpi"><strong>@_summary.AttendanceRows.ToString(CultureInfo.InvariantCulture)</strong><span>Attendance rows</span></div>
    </div>

    <div class="epc-hr-table-wrap">
        <table class="epc-hr-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Status</th>
                    <th>Join date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_employees.Count == 0)
                {
                    <tr><td colspan="7">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var e in _employees)
                    {
                        <tr>
                            <td><strong>@e.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(e.Code) ? "—" : e.Code)</td>
                            <td>@(string.IsNullOrWhiteSpace(e.Name) ? "—" : e.Name)</td>
                            <td>@(string.IsNullOrWhiteSpace(e.Department) ? "—" : e.Department)</td>
                            <td>@(string.IsNullOrWhiteSpace(e.Status) ? "—" : e.Status)</td>
                            <td>@(e.JoinDate > 0 ? e.JoinDate.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=people&tab=hr&epc_erp_shell=1";
    private bool _isAdmin;
    private CpHrOverviewSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpHrEmployeeDigest> _employees = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpHrOverviewDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _employees = result.Employees;
        _source = result.Source;
        _message = result.Message;
    }
}
