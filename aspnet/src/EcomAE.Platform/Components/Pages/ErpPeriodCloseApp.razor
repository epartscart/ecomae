@page "/erp/period-close-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Period Close · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Period Close" BreadcrumbArea="Finance" BreadcrumbTab="Year end">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/period-close-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Period Close" Subtitle="Open a row for close/lock actors and the 280-character note excerpt. Checklist JSON omitted. Reopen and status writes stay here." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/ajax/fy-reopen" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
            <label>Year id <input type="number" name="year_id" min="1" required style="width:6rem" /></label>
            <button type="submit">Reopen year</button>
        </form>
        <form method="post" action="/erp/ajax/fy-period-status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
            <label>Year id <input type="number" name="year_id" min="1" required style="width:6rem" /></label>
            <label>Period no <input type="number" name="period_no" min="1" required style="width:5rem" /></label>
            <label>Status
                <select name="status">
                    <option value="open">open</option>
                    <option value="closed">closed</option>
                    <option value="locked">locked</option>
                </select>
            </label>
            <button type="submit">Set period status</button>
        </form>
        <form method="post" action="/erp/periods/soft-close" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
            <label>Year-month <input type="month" name="year_month" required /></label>
            <label>Note <input name="note" maxlength="512" /></label>
            <button type="submit">Soft-close month</button>
        </form>
        <form method="post" action="/erp/fiscal/set-lock" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
            <label>Lock on/before <input type="date" name="lock_date" /></label>
            <label>Note <input name="note" maxlength="255" /></label>
            <button type="submit">Set fiscal lock</button>
        </form>
        <form method="post" action="/erp/fiscal/set-lock" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
            <input type="hidden" name="lock_date" value="" />
            <button type="submit">Clear fiscal lock</button>
        </form>
        <form method="post" action="/erp/fiscal-years/create" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
            <label>Label <input type="text" name="label" required /></label>
            <label>Start <input type="date" name="start_date" required /></label>
            <label>End <input type="date" name="end_date" required /></label>
            <label><input type="checkbox" name="monthly" value="1" checked /> Monthly periods</label>
            <button type="submit">Create fiscal year</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Period Close KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_periods.Count</div></div>
        <div class="kpi"><div class="lbl">Digest source</div><div class="val">@_source</div></div>
        <div class="kpi"><div class="lbl">Session</div><div class="val">@(_isAdmin ? "live" : "guest")</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Period</dt><dd>@(string.IsNullOrWhiteSpace(_opened.YearMonth) ? "—" : _opened.YearMonth)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Status) ? "—" : _opened.Status)</dd>
                <dt>Soft closed</dt><dd>@(_opened.SoftClosed ? "yes" : "no")</dd>
                <dt>Locked</dt><dd>@(_opened.Locked ? "yes" : "no")</dd>
                <dt>Closed by</dt><dd>@(_opened.ClosedBy > 0 ? _opened.ClosedBy.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Closed at</dt><dd>@FormatTime(_opened.ClosedAt)</dd>
                <dt>Locked by</dt><dd>@(_opened.LockedBy > 0 ? _opened.LockedBy.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Locked at</dt><dd>@FormatTime(_opened.LockedAt)</dd>
                <dt>Updated</dt><dd>@FormatTime(_opened.TimeUpdated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Checklist JSON omitted. Reopen and status writes stay here.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.NoteExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">note excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.NoteExcerpt</pre>
                @if (_opened.NoteLen > _opened.NoteExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.NoteExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NoteLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No note excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Period</th>
                            <th>Status</th>
                            <th>Locked</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.YearMonth) ? "—" : sib.YearMonth)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                <td>@(sib.Locked ? "yes" : "no")</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "period_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Period</th>
                    <th>Status</th>
                    <th>Soft closed</th>
                    <th>Locked</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_periods.Count == 0)
                {
                    <tr><td colspan="6">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _periods)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@(string.IsNullOrWhiteSpace(row.YearMonth) ? "—" : row.YearMonth)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td>@(row.SoftClosed ? "yes" : "no")</td>
                            <td>@(row.Locked ? "yes" : "no")</td>
                            <td>@FormatTime(row.TimeUpdated)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "period_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">@_message</div>
    }

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=finance&tab=year_end";
    private const string _listHref = "/erp/period-close-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpFiscalPeriodDigest> _periods = [];
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private ErpFiscalPeriodDetail? _opened;
    private IReadOnlyList<ErpFiscalPeriodDigest> _openedSiblings = [];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.YearMonth)
            ? _opened.YearMonth
            : ("Period #" + _opened.Id.ToString(CultureInfo.InvariantCulture)));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?period_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "period_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpFiscalPeriodsAsync(_limit, ctx.RequestAborted);
        _periods = result.Periods;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpFiscalPeriodDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Period;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _periods.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _periods = new[] { openedList }.Concat(_periods.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
