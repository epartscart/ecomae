@page "/cp/abandoned-carts-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ICpAbandonedCartsEditorService Carts
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Carts · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<style>
    .epc-carts-actions .panel_a { display:inline-block; text-align:center; text-decoration:none; color:#333; margin-right:14px; vertical-align:top; }
    .epc-carts-actions .panel_a_img { width:48px; height:48px; margin:0 auto 4px; border-radius:8px; background:#f1f3f6; display:flex; align-items:center; justify-content:center; font-size:22px; color:#3498db; }
    .epc-carts-actions .panel_a_caption { font-size:12px; }
    .epc-carts-filter .form-group { margin-bottom:10px; }
    .epc-carts-filter .control-label { text-align:right; padding-top:7px; }
    .epc-carts-filter .epc-active { background:#b9fcab; }
    .epc-carts-list td, .epc-carts-list th { vertical-align:middle !important; white-space:nowrap; }
    .epc-carts-list th a { color:#333; }
    .epc-carts-list th a.epc-sorted { font-weight:bold; text-decoration:underline; }
    .epc-carts-list tr.epc-details-row { display:none; }
    .epc-carts-list tr.epc-details-row.epc-open { display:table-row; }
    .epc-carts-list tr.epc-details-row td { background:#fafafa; }
    .epc-carts-list .epc-toggle { cursor:pointer; color:#3498db; }
    .epc-carts-list tr.epc-row-open td { background:#fff8dc; }
    .epc-carts-list .pagination { margin:8px 0 0; }
</style>

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    @if (!_isAdmin)
    {
        <div class="hpanel"><div class="panel-body">
            <div class="alert alert-warning" role="status">Sign in to the Control Panel to manage customer carts. <a href="/cp/login?returnUrl=/cp/abandoned-carts-app">Login</a></div>
        </div></div>
    }
    else
    {
        var f = _filter;
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Carts
                    <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
                </div>
                <div class="panel-body epc-carts-actions">
                    <a class="panel_a" href="javascript:void(0);" onclick="epcCartsDeleteChecked();"><div class="panel_a_img"><i class="fa fa-trash"></i></div><div class="panel_a_caption">Delete</div></a>
                    <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div> }

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Filter</div>
                <form method="get" action="@_listHref" id="epc-carts-filter" class="form-horizontal epc-carts-filter">
                    <input type="hidden" name="sort" value="@f.Sort" />
                    <input type="hidden" name="dir" value="@(f.Desc ? "desc" : "asc")" />
                    <div class="panel-body filter_panel">
                        <div class="row">
                            <div class="col-lg-4">
                                <div class="form-group">
                                    <label class="col-lg-6 control-label">Date from</label>
                                    <div class="col-lg-6">
                                        <input type="datetime-local" id="time_from_show" class="form-control @(f.TimeFrom > 0 ? "epc-active" : "")" value="@LocalInput(f.TimeFrom)" onchange="epcCartsSyncTime(this,'time_from');" />
                                        <input type="hidden" name="time_from" id="time_from" value="@(f.TimeFrom > 0 ? f.TimeFrom.ToString(CultureInfo.InvariantCulture) : "")" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="form-group">
                                    <label class="col-lg-6 control-label">Date to</label>
                                    <div class="col-lg-6">
                                        <input type="datetime-local" id="time_to_show" class="form-control @(f.TimeTo > 0 ? "epc-active" : "")" value="@LocalInput(f.TimeTo)" onchange="epcCartsSyncTime(this,'time_to');" />
                                        <input type="hidden" name="time_to" id="time_to" value="@(f.TimeTo > 0 ? f.TimeTo.ToString(CultureInfo.InvariantCulture) : "")" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="form-group">
                                    <label class="col-lg-6 control-label">Customer</label>
                                    <div class="col-lg-6">
                                        <input type="text" name="customer" id="customer" class="form-control @(f.Customer.Length > 0 ? "epc-active" : "")" value="@f.Customer" placeholder="ID, e-mail, name or phone" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="form-group">
                                    <label class="col-lg-6 control-label">Warehouse</label>
                                    <div class="col-lg-6">
                                        <select name="storage_id" id="storage_id" class="form-control @(f.StorageId > 0 ? "epc-active" : "")">
                                            <option value="0">All</option>
                                            @foreach (var s in _list.Storages)
                                            {
                                                <option value="@s.Id.ToString(CultureInfo.InvariantCulture)" selected="@(s.Id == f.StorageId)">@s.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-footer">
                        <div class="row">
                            <div class="col-lg-12 float-e-margins">
                                <button class="btn btn-success" type="submit"><i class="fa fa-filter"></i> Apply filter</button>
                                <a class="btn btn-default" href="@_listHref"><i class="fa fa-times"></i> Reset</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Cart lines
                    <span class="pull-right">@_list.Total.ToString(CultureInfo.InvariantCulture) record(s)</span>
                </div>
                <div class="panel-body">
                    <form method="post" action="/cp/abandoned-carts/write" id="epc-carts-form" onsubmit="return epcCartsConfirmDelete();">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="returnUrl" value="@_selfHref" />
                        <div class="table-responsive">
                            <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-carts-list">
                                <thead>
                                    <tr>
                                        <th><input type="checkbox" id="check_uncheck_all" onchange="epcCartsCheckAll(this);" /></th>
                                        <th></th>
                                        <th>@SortLink("id", "ID")</th>
                                        <th>@SortLink("manufacturer", "Manufacturer")</th>
                                        <th>@SortLink("article", "Article")</th>
                                        <th>@SortLink("product_name", "Name")</th>
                                        <th class="text-right">@SortLink("price", "Price")</th>
                                        <th class="text-right">@SortLink("count_need", "Qty")</th>
                                        <th class="text-right">@SortLink("price_sum", "Sum")</th>
                                        <th class="text-right">@SortLink("price_purchase_sum", "Purchase sum")</th>
                                        <th class="text-right">@SortLink("profit", "Profit")</th>
                                        <th>@SortLink("time", "Added")</th>
                                        <th>@SortLink("user_id", "Customer")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_list.Rows.Count == 0)
                                    {
                                        <tr><td colspan="13">@(f.Any ? "No cart lines match the filter." : "No cart lines.")</td></tr>
                                    }
                                    @foreach (var r in _list.Rows)
                                    {
                                        var rid = r.Id.ToString(CultureInfo.InvariantCulture);
                                        <tr id="erp-row-@rid" class="@ErpRecordOpen.RowClass(r.Id, _openedId)">
                                            <td><input type="checkbox" name="records_to_del[]" value="@rid" id="checked_@rid" class="epc-cart-check" /></td>
                                            <td><span class="epc-toggle" onclick="epcCartsToggle('@rid');" title="Reserved stock details"><i class="fa fa-plus-square-o"></i></span></td>
                                            <td><a href="@ErpRecordOpen.Href(_selfHref, "cart_id", r.Id)" title="Permalink to this cart line">@rid</a></td>
                                            <td>@(r.Manufacturer.Length > 0 ? r.Manufacturer : "—")</td>
                                            <td>@(r.Article.Length > 0 ? r.Article : "—")</td>
                                            <td style="white-space:normal">@(r.ProductName.Length > 0 ? r.ProductName : "—")</td>
                                            <td class="text-right">@r.Price.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                            <td class="text-right">@r.CountNeed.ToString("0.##", CultureInfo.InvariantCulture)</td>
                                            <td class="text-right">@r.PriceSum.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                            <td class="text-right">@r.PricePurchaseSum.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                            <td class="text-right @(r.Profit < 0 ? "text-danger" : "")">@r.Profit.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                            <td>@FormatTime(r.Time)</td>
                                            <td>
                                                @if (r.UserId > 0)
                                                {
                                                    <a href="/cp/users-app?user_id=@r.UserId.ToString(CultureInfo.InvariantCulture)" title="Customer #@r.UserId.ToString(CultureInfo.InvariantCulture)">@(r.CustomerLabel.Length > 0 ? r.CustomerLabel : ("#" + r.UserId.ToString(CultureInfo.InvariantCulture)))</a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">guest</span>
                                                }
                                            </td>
                                        </tr>
                                        <tr class="epc-details-row @(r.Id == _openedId ? "epc-open" : "")" id="epc-details-@rid">
                                            <td></td>
                                            <td colspan="12">
                                                <table class="table table-condensed" style="margin:0;width:auto;min-width:50%">
                                                    <thead>
                                                        <tr><th>Warehouse</th><th>Stock record</th><th class="text-right">Purchase price</th><th class="text-right">Reserved</th><th class="text-right">Purchase sum</th></tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var d in r.Details)
                                                        {
                                                            <tr>
                                                                <td>@d.StorageName</td>
                                                                <td>@d.StorageRecordId</td>
                                                                <td class="text-right">@d.PricePurchase.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                                                <td class="text-right">@d.CountReserved.ToString("0.##", CultureInfo.InvariantCulture)</td>
                                                                <td class="text-right">@d.PricePurchaseSum.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                                            </tr>
                                                        }
                                                        <tr>
                                                            <td colspan="2"></td>
                                                            <td class="text-right"><strong>Total</strong></td>
                                                            <td class="text-right"><strong>@r.CountNeed.ToString("0.##", CultureInfo.InvariantCulture)</strong></td>
                                                            <td class="text-right"><strong>@r.PricePurchaseSum.ToString("0.00", CultureInfo.InvariantCulture)</strong></td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </form>
                    @if (_list.PageCount > 1)
                    {
                        <ul class="pagination">
                            @for (var p = 1; p <= _list.PageCount; p++)
                            {
                                <li class="@(p == _list.Page ? "active" : "")"><a href="@PageHref(p)">@p.ToString(CultureInfo.InvariantCulture)</a></li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <script>
            function epcCartsSyncTime(el, target) {
                var v = el.value ? Math.floor(new Date(el.value).getTime() / 1000) : '';
                document.getElementById(target).value = v;
                el.classList.toggle('epc-active', !!v);
            }
            function epcCartsCheckAll(master) {
                document.querySelectorAll('.epc-cart-check').forEach(function (c) { c.checked = master.checked; });
            }
            function epcCartsToggle(id) {
                var row = document.getElementById('epc-details-' + id);
                if (row) { row.classList.toggle('epc-open'); }
            }
            function epcCartsChecked() {
                return Array.prototype.filter.call(document.querySelectorAll('.epc-cart-check'), function (c) { return c.checked; });
            }
            function epcCartsConfirmDelete() {
                var n = epcCartsChecked().length;
                if (n === 0) { alert('Select at least one cart line.'); return false; }
                return confirm('Delete ' + n + ' selected cart line(s)? Reserved stock will be released.');
            }
            function epcCartsDeleteChecked() {
                var form = document.getElementById('epc-carts-form');
                if (epcCartsConfirmDelete()) { form.submit(); }
            }
        </script>
    }
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/orders/carts";
    private const string _listHref = "/cp/abandoned-carts-app";
    private const int _pageSize = 50;
    private bool _isAdmin;
    private CpCartsFilter _filter = new(0, 0, "", 0, "id", true, 1);
    private CpCartsList _list = new([], 0, 1, _pageSize, []);
    private string _selfHref = _listHref;
    private long _openedId;
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "cart_id");
        _filter = CpAbandonedCartsEditorService.ReadFilter(ctx.Request);
        _selfHref = PageHref(_filter.Page);

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        _list = await Carts.ListAsync(_filter, _pageSize, ctx.RequestAborted);
    }

    private string BaseQuery(string sort, bool desc)
    {
        var f = _filter;
        var parts = new List<string>();
        if (f.TimeFrom > 0) parts.Add("time_from=" + f.TimeFrom.ToString(CultureInfo.InvariantCulture));
        if (f.TimeTo > 0) parts.Add("time_to=" + f.TimeTo.ToString(CultureInfo.InvariantCulture));
        if (f.Customer.Length > 0) parts.Add("customer=" + Uri.EscapeDataString(f.Customer));
        if (f.StorageId > 0) parts.Add("storage_id=" + f.StorageId.ToString(CultureInfo.InvariantCulture));
        parts.Add("sort=" + sort);
        parts.Add("dir=" + (desc ? "desc" : "asc"));
        return string.Join("&", parts);
    }

    private string PageHref(int page)
        => _listHref + "?" + BaseQuery(_filter.Sort, _filter.Desc) + "&page=" + page.ToString(CultureInfo.InvariantCulture);

    private MarkupString SortLink(string field, string caption)
    {
        var active = string.Equals(_filter.Sort, field, StringComparison.Ordinal);
        var desc = active ? !_filter.Desc : field is "id" or "time";
        var href = _listHref + "?" + BaseQuery(field, desc) + "&page=1";
        var arrow = active ? (_filter.Desc ? " &darr;" : " &uarr;") : "";
        return new MarkupString("<a href=\"" + href + "\" class=\"" + (active ? "epc-sorted" : "") + "\" id=\"" + field + "_sorter\">" + caption + arrow + "</a>");
    }

    private static string LocalInput(long unix)
        => unix <= 0 ? "" : DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd'T'HH:mm", CultureInfo.InvariantCulture);

    private static string FormatTime(long unix)
        => unix <= 0 ? "—" : DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("dd.MM.yyyy H:mm", CultureInfo.InvariantCulture);
}
