@page "/cp/abandoned-carts-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Abandoned carts · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Abandoned carts
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/abandoned-carts-app")</p>
                <p>Open a line to see lead time, stock, and the other lines in the same cart. Deletes stay on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/abandoned-carts-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedLine is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Abandoned cart KPIs">
        <div class="kpi"><div class="lbl">Cart lines</div><div class="val">@_summary.LineCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Guest lines</div><div class="val">@_summary.GuestLineCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">User lines</div><div class="val">@_summary.UserLineCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Guest sessions</div><div class="val">@_summary.GuestSessionCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Users with carts</div><div class="val">@_summary.UserCartCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Cart sum</div><div class="val">@_summary.CartSum.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedLine is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedLine.Article) ? _openedLine.Article : ("Line #" + _openedLine.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(_openedLine.SessionId > 0 ? "guest" : "user")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedLine.Manufacturer) ? _openedLine.Manufacturer : "—")
                        · <strong>@(!string.IsNullOrWhiteSpace(_openedLine.Name) ? _openedLine.Name : "—")</strong></p>
                    <p>Price: <strong>@_openedLine.Price.ToString("N2", CultureInfo.InvariantCulture)</strong>
                        × @_openedLine.CountNeed.ToString(CultureInfo.InvariantCulture)
                        = <strong>@_openedLine.PriceSum.ToString("N2", CultureInfo.InvariantCulture)</strong></p>
                    <p>Lead time: @(!string.IsNullOrWhiteSpace(_openedLine.TimeToExe) ? _openedLine.TimeToExe : "—")
                        · Guaranteed: @(!string.IsNullOrWhiteSpace(_openedLine.TimeToExeGuaranteed) ? _openedLine.TimeToExeGuaranteed : "—")</p>
                    <p>Min order: @_openedLine.MinOrder.ToString("0.####", CultureInfo.InvariantCulture)
                        · Stock: @_openedLine.Exist.ToString("0.####", CultureInfo.InvariantCulture)</p>
                    <p>User @_openedLine.UserId.ToString(CultureInfo.InvariantCulture)
                        · Session @_openedLine.SessionId.ToString(CultureInfo.InvariantCulture)
                        · @FormatTime(_openedLine.TimeUnix)</p>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Cart lines</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Manufacturer</th>
                                    <th>Article</th>
                                    <th>Name</th>
                                    <th class="text-right">Price</th>
                                    <th class="text-right">Qty</th>
                                    <th class="text-right">Sum</th>
                                    <th>Lead</th>
                                    <th>Stock</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="9">No sibling lines yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var line in _openedSiblings)
                                    {
                                        <tr class="@ErpRecordOpen.RowClass(line.Id, _openedId)">
                                            <td>@line.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(line.Manufacturer) ? line.Manufacturer : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(line.Article) ? line.Article : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(line.Name) ? line.Name : "—")</td>
                                            <td class="text-right">@line.Price.ToString("N2", CultureInfo.InvariantCulture)</td>
                                            <td class="text-right">@line.CountNeed.ToString(CultureInfo.InvariantCulture)</td>
                                            <td class="text-right"><strong>@line.PriceSum.ToString("N2", CultureInfo.InvariantCulture)</strong></td>
                                            <td>@(!string.IsNullOrWhiteSpace(line.TimeToExe) ? line.TimeToExe : "—")</td>
                                            <td>@line.Exist.ToString("0.####", CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_summary.LineCount.ToString(CultureInfo.InvariantCulture) Cart lines · @_summary.GuestLineCount.ToString(CultureInfo.InvariantCulture) Guest / session lines · @_summary.UserLineCount.ToString(CultureInfo.InvariantCulture) User lines · @_summary.GuestSessionCount.ToString(CultureInfo.InvariantCulture) Guest sessions · @_summary.UserCartCount.ToString(CultureInfo.InvariantCulture) Users with carts · @_summary.CartSum.ToString("N2", CultureInfo.InvariantCulture) Cart sum.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Manufacturer</th>
                    <th>Article</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th>Sum</th>
                    <th>Checked</th>
                    <th>Product type</th>
                    <th>When</th>
                    <th>User</th>
                    <th>Session</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="13">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Manufacturer) ? row.Manufacturer : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Article) ? row.Article : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                            <td>@row.Price.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@row.CountNeed.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.PriceSum.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@row.CheckedForOrder.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.ProductType.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@FormatTime(row.TimeUnix)</td>
                            <td>@row.UserId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.SessionId.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "cart_id", row.Id)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/orders/carts";
    private const string _listHref = "/cp/abandoned-carts-app";
    private bool _isAdmin;
    private CpAbandonedCartsSummary _summary = new(0, 0, 0, 0, 0, 0m, "n/a", "");
    private IReadOnlyList<CpAbandonedCartsRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private CpAbandonedCartsLineDetail? _openedLine;
    private IReadOnlyList<CpAbandonedCartsLineDetail> _openedSiblings = [];

    private string OpenedCaption => _openedLine is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedLine.Article) ? ("Cart line #" + _openedLine.Id.ToString(CultureInfo.InvariantCulture)) : _openedLine.Article)
            + " · " + (_openedLine.SessionId > 0 ? "guest" : "user");

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "cart_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpAbandonedCartsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Carts;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpAbandonedCartsDetailAsync(_openedId, ctx.RequestAborted);
            _openedLine = detail.Line;
            _openedSiblings = detail.Siblings;
            if (_openedLine is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0)
        {
            return "—";
        }

        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
