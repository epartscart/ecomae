@page "/erp/login"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject NavigationManager Nav
@inject IHttpContextAccessor Http

<PageTitle>@_brand.Label — ERP Finance</PageTitle>
@* BOS login shell; tenant hosts show animated/catalog logo; atmosphere theme per tenant. *@
<PhpSurfaceHead Surface="erp" IncludeLoginCss="true" />
<PhpChromeBodyClass Surface="erp" LoginChrome="true" />

<style>
    html:has(.bos-login),
    body:has(.bos-login),
    body.bos-body--login {
        background: linear-gradient(135deg, #020617 0%, #0c1222 30%, #091428 60%, #050d1a 100%) !important;
        color: #e2e8f0 !important;
        min-height: 100vh;
        overflow-x: hidden;
    }
    .epc-login-bos.bos-login {
        width: 100%;
        min-height: 100vh;
        display: flex;
        position: relative;
        background: transparent;
        color: #e2e8f0;
    }
    .bos-login__error.is-visible {
        display: flex;
        align-items: center;
        gap: .4rem;
    }
</style>

@* Markers: epc-erp-portal-bg, epc-erp-bos-hero, #erpPortalParticles *@
<div class="epc-login-bos bos-login @_brand.RootModifierClass epc-erp-portal-wrap">
    <div class="epc-erp-portal-bg" hidden aria-hidden="true"><div class="epc-erp-portal-bg__grid"></div></div>
    <div class="epc-erp-bos-hero" hidden aria-hidden="true"><h1 class="epc-erp-bos-hero__title">ERP Finance</h1></div>

    <PhpBosLoginAtmosphere ParticlesId="erpPortalParticles"
                           Theme="@(_isTenant ? _brand.AtmosphereTheme : "teal-moon")"
                           ParticleColors="@_brand.ParticleColors" />

    <div class="bos-login__hero">
        <div class="bos-login__hero-content">
            <div class="bos-login__brand-mark">
                @if (_brand.LogoKind != LoginHostBrand.Kind.Platform)
                {
                    <PhpLoginHostBrand Brand="@_brand" />
                    <h1 class="bos-login__brand-title">@_brand.Label</h1>
                    <p class="bos-login__brand-tagline">ERP Finance · @_brand.Tagline</p>
                }
                else
                {
                    <div class="bos-login__brand-icon">
                        <div class="bos-login__brand-icon-inner">
                            <i class="fa fa-university"></i>
                        </div>
                        <div class="bos-login__brand-ring"></div>
                        <div class="bos-login__brand-ring bos-login__brand-ring--2"></div>
                    </div>
                    <h1 class="bos-login__brand-title">ERP</h1>
                    <p class="bos-login__brand-tagline">Enterprise Resource Planning</p>
                }
            </div>

            <div class="bos-login__capabilities">
                <div class="bos-login__cap-item bos-login__cap-item--1">
                    <div class="bos-login__cap-icon bos-login__cap-icon--erp"><i class="fa fa-university"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>Enterprise ERP</strong>
                        <span>Finance, HR, Inventory, Production</span>
                    </div>
                </div>
                <div class="bos-login__cap-item bos-login__cap-item--2">
                    <div class="bos-login__cap-icon bos-login__cap-icon--ecom"><i class="fa fa-shopping-cart"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>Sales &amp; purchase</strong>
                        <span>Orders, invoices, quotations</span>
                    </div>
                </div>
                <div class="bos-login__cap-item bos-login__cap-item--3">
                    <div class="bos-login__cap-icon bos-login__cap-icon--compliance"><i class="fa fa-globe"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>Worldwide Compliance</strong>
                        <span>Auto-localized per country</span>
                    </div>
                </div>
                <div class="bos-login__cap-item bos-login__cap-item--4">
                    <div class="bos-login__cap-icon bos-login__cap-icon--ai"><i class="fa fa-building"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>Multi-company</strong>
                        <span>Industry packs per legal entity</span>
                    </div>
                </div>
            </div>

            <div class="bos-login__stats-bar">
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="225">0</span>
                    <span class="bos-login__stat-label">Tenants</span>
                </div>
                <div class="bos-login__stat-divider"></div>
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="11">0</span>
                    <span class="bos-login__stat-label">Industries</span>
                </div>
                <div class="bos-login__stat-divider"></div>
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="@PhpModuleCatalog.ErpAreaCount">0</span>
                    <span class="bos-login__stat-label">ERP Areas</span>
                </div>
                <div class="bos-login__stat-divider"></div>
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="@PhpModuleCatalog.ErpTabCount">0</span>
                    <span class="bos-login__stat-label">Tabs</span>
                </div>
            </div>
        </div>
    </div>

    <div class="bos-login__panel" id="sign-in">
        <div class="bos-login__panel-inner">
            <div class="bos-login__form-wrap bos-login__form-wrap--active">
                <div class="bos-login__form-header">
                    <h2>ERP Access</h2>
                    <p>Access @_brand.Label enterprise resource planning</p>
                </div>
                <form class="bos-login__form" id="erpLoginForm" method="post" action="@EcomAeRoutes.ErpLogin">
                    <input type="hidden" name="surface" value="erp" />
                    <input type="hidden" name="redirect" value="/erp" />
                    <input type="hidden" name="contact_type" value="email" />
                    <div class="bos-login__field">
                        <label for="erpEmail"><i class="fa fa-envelope-o"></i> Business Email</label>
                        <input type="email" id="erpEmail" name="contact" required autocomplete="username" placeholder="finance@yourcompany.com" />
                        <div class="bos-login__field-line"></div>
                    </div>
                    <div class="bos-login__field">
                        <label for="erpPassword"><i class="fa fa-lock"></i> Password</label>
                        <input type="password" id="erpPassword" name="password" required autocomplete="current-password" placeholder="Enter your password" />
                        <div class="bos-login__field-line"></div>
                    </div>
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="bos-login__error is-visible" id="erpLoginError">
                            <i class="fa fa-exclamation-circle"></i> @_error
                        </div>
                    }
                    else
                    {
                        <div class="bos-login__error" id="erpLoginError"></div>
                    }
                    <button type="submit" class="bos-login__btn bos-login__btn--erp">
                        <span class="bos-login__btn-text"><i class="fa fa-university"></i> Access ERP System</span>
                        <span class="bos-login__btn-loading"><i class="fa fa-circle-o-notch fa-spin"></i> Connecting...</span>
                    </button>
                </form>
                <div class="bos-login__erp-features">
                    <div class="bos-login__erp-feat"><i class="fa fa-check-circle"></i> General Ledger &amp; Financial Reporting</div>
                    <div class="bos-login__erp-feat"><i class="fa fa-check-circle"></i> Accounts Payable &amp; Receivable</div>
                    <div class="bos-login__erp-feat"><i class="fa fa-check-circle"></i> HR, Payroll &amp; Workforce Management</div>
                    <div class="bos-login__erp-feat"><i class="fa fa-check-circle"></i> Inventory, Production &amp; Warehouse</div>
                    <div class="bos-login__erp-feat"><i class="fa fa-check-circle"></i> Tax Compliance &amp; E-Invoicing</div>
                </div>
                <div class="bos-login__secure-badge">
                    <i class="fa fa-shield"></i> Database isolated &middot; Country-compliant &middot; Enterprise grade
                </div>
            </div>

            <div class="bos-login__footer">
                <div class="bos-login__footer-brand">
                    <span class="bos-login__footer-logo">ECOM<span>AE</span></span>
                    <span class="bos-login__footer-sep">&middot;</span>
                    <span>@_brand.Label ERP</span>
                    <span class="bos-login__footer-sep">&middot;</span>
                    <a href="/cp/login">CP</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? _error;
    private LoginHostBrand.Brand _brand = LoginHostBrand.Resolve(null, "erp");
    private bool _isTenant;

    protected override void OnInitialized()
    {
        _error = LoginErrorHelper.FromUri(Nav.Uri);
        var host = Http.HttpContext?.Request.Host.Host;
        _brand = LoginHostBrand.Resolve(host, "erp");
        _isTenant = _brand.LogoKind != LoginHostBrand.Kind.Platform;
    }
}
