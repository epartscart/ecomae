@page "/erp/login"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@inject NavigationManager Nav

<PageTitle>ERP Finance — ECOM AE</PageTitle>
<PhpSurfaceHead Surface="erp" IncludeLoginCss="true" />
<PhpChromeBodyClass Surface="erp" LoginChrome="true" />
<link rel="stylesheet" href="/content/general_pages/epc_enterprise_login_3d.css?v=20260806a" />

@*
  Premium enterprise 3D login for ERP Finance.
  Keeps presentation markers: .ech-hub, epc-erp-portal-bg, epc-erp-bos-hero, #erpPortalParticles
*@

<div class="eel-root eel-root--erp epc-login-erp epc-erp-portal-wrap">
    @* Probe markers (visually collapsed by enterprise CSS) *@
    <div class="epc-erp-portal-bg" aria-hidden="true"><div class="epc-erp-portal-bg__grid"></div></div>
    <div class="epc-erp-bos-hero" aria-hidden="true"><h1 class="epc-erp-bos-hero__title">ERP Finance</h1></div>

    <EnterpriseLogin3dScene ParticlesId="erpPortalParticles"
                            ParticlesExtraClass="epc-erp-portal-bg__particles"
                            ParticleCount="48"
                            ParticleColors="@(new[] { "rgba(13,148,136,.55)", "rgba(56,189,248,.45)", "rgba(255,255,255,.28)" })" />

    <div class="eel-stage">
        <aside class="eel-brand">
            <div class="eel-brand__mark">
                <img class="eel-brand__logo" src="@LegacyPresentationAssets.BrandMarkUrl" alt="" width="48" height="48" />
                <div class="eel-brand__wordmark">ECOM <span>AE</span></div>
            </div>
            <span class="eel-brand__badge">ERP · Finance</span>
            <h1 class="eel-brand__title">ERP Finance</h1>
            <p class="eel-brand__sub">Department sign-in for finance, sales, logistics, and operations — separate from the public storefront.</p>
            <div class="eel-brand__visual">
                <PhpEcomaeHubLogo Variant="login" AriaLabel="ECOM AE ERP hub" OrbitDuration="32s" />
            </div>
            <div class="eel-brand__caps" aria-hidden="true">
                <div class="eel-brand__cap">
                    <i class="fa fa-calculator" aria-hidden="true"></i>
                    <div>
                        <strong>Financial accounting</strong>
                        <span>GL, AP, AR, bank &amp; fixed assets</span>
                    </div>
                </div>
                <div class="eel-brand__cap">
                    <i class="fa fa-cubes" aria-hidden="true"></i>
                    <div>
                        <strong>Inventory &amp; logistics</strong>
                        <span>WMS, stock, shipping &amp; purchase</span>
                    </div>
                </div>
            </div>
        </aside>

        <section class="eel-panel" id="sign-in" aria-label="ERP Finance sign-in">
            <div class="eel-panel__card">
                <div class="eel-panel__head">
                    <p class="eel-panel__eyebrow">Secure access</p>
                    <h2 class="eel-panel__title">Sign in to ERP</h2>
                    <p class="eel-panel__lead">Role-based tabs for finance teams — same live data as the control panel ERP shell.</p>
                </div>

                <div class="hpanel">
                    <div class="panel-body">
                        <LegacyAdminLoginForm Surface="LegacyLoginSurface.Erp"
                                              SurfaceLabel="ERP"
                                              PhpLoginHref="/php-reference/erp"
                                              ErrorMessage="@_error"
                                              SubmitLabel="Enter ERP Finance"
                                              Accent="blue" />
                        <ul class="eel-features epc-erp-login-features">
                            <li><i class="fa fa-check" aria-hidden="true"></i><span>Role-based tabs per department</span></li>
                            <li><i class="fa fa-check" aria-hidden="true"></i><span>GL, VAT, inventory &amp; payables</span></li>
                            <li><i class="fa fa-check" aria-hidden="true"></i><span>@PhpModuleCatalog.ErpAreaCount areas · @PhpModuleCatalog.ErpTabCount tabs</span></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="eel-footer">
                Administrators:
                <a href="/cp/login">Control panel</a>
                · <a href="/">E-commerce</a>
                · <a href="/bos/login">BOS</a>
            </div>
        </section>
    </div>
</div>

@code {
    private string? _error;
    protected override void OnInitialized() => _error = LoginErrorHelper.FromUri(Nav.Uri);
}
