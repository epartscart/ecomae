@page "/erp/login"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@inject NavigationManager Nav

<PageTitle>ERP Finance — ECOM AE</PageTitle>
<PhpSurfaceHead Surface="erp" IncludeLoginCss="true" />

<style>
    .epc-asp-login-erp {
        --accent:#2563eb; min-height:100vh; margin:0; color:#f8fafc;
        font-family: @(LegacyPhpFontAssets.StackFor("erp"));

        background: radial-gradient(900px 500px at 20% 0%, rgba(37,99,235,.28), transparent 55%),
                    radial-gradient(700px 400px at 80% 20%, rgba(56,189,248,.18), transparent 50%),
                    linear-gradient(180deg,#050b16,#0a1628 55%,#07101c);
    }
    .epc-asp-login-erp .wrap { width:min(980px, calc(100% - 2rem)); margin:0 auto; padding:1.5rem 0 3rem; }
    .epc-asp-login-erp .top { display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-bottom:1.5rem; }
    .epc-asp-login-erp .brand { display:flex; align-items:center; gap:.65rem; font-weight:800; }
    .epc-asp-login-erp .brand img { height:36px; background:#fff; border-radius:6px; padding:2px; }
    .epc-asp-login-erp .hero { text-align:center; margin:1rem 0 1.4rem; }
    .epc-asp-login-erp .hero-icon {
        width:64px; height:64px; margin:0 auto .75rem; border-radius:1rem;
        background:linear-gradient(135deg,#0c4a6e 0%,#1d4ed8 45%,#2563eb 100%); display:flex; align-items:center; justify-content:center;
        font-size:1.6rem; box-shadow:0 10px 30px rgba(37,99,235,.35);
    }
    .epc-asp-login-erp h1 { margin:.2rem 0 .35rem; font-size:clamp(1.8rem,4vw,2.4rem); }
    .epc-asp-login-erp .sub { color:#94a3b8; margin:0 0 1.1rem; }
    .epc-asp-login-erp .modules { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin:0 0 1.1rem; }
    .epc-asp-login-erp .mod { background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1); border-radius:.7rem; padding:.85rem .75rem; text-align:left; }
    .epc-asp-login-erp .mod strong { display:block; font-size:.9rem; margin-bottom:.2rem; }
    .epc-asp-login-erp .mod span { color:#94a3b8; font-size:.75rem; line-height:1.35; }
    .epc-asp-login-erp .stats { display:flex; flex-wrap:wrap; justify-content:center; gap:1.25rem; margin:0 0 1.25rem; font-weight:800; letter-spacing:.02em; }
    .epc-asp-login-erp .stats span { color:#e2e8f0; font-size:.85rem; }
    .epc-asp-login-erp .panel {
        display:grid; grid-template-columns:1.1fr .9fr; gap:1rem;
        background:rgba(15,23,42,.72); border:1px solid rgba(148,163,184,.2); border-radius:1rem; padding:1.2rem;
    }
    .epc-asp-login-erp .panel h2 { margin:.2rem 0 .45rem; font-size:1.2rem; }
    .epc-asp-login-erp .panel p { color:#94a3b8; font-size:.9rem; line-height:1.45; }
    .epc-asp-login-erp .checks { list-style:none; padding:0; margin:.8rem 0 0; display:grid; gap:.35rem; color:#cbd5e1; font-size:.85rem; }
    .epc-asp-login-erp .checks li::before { content:"✓ "; color:#38bdf8; font-weight:700; }
    .epc-asp-login-erp .login-card { background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.1); border-radius:.8rem; padding:1rem 1.05rem; }
    .epc-asp-login-erp .epc-login-field { margin:0 0 .7rem; }
    .epc-asp-login-erp .epc-login-field label { display:block; font-size:.8rem; font-weight:600; margin-bottom:.25rem; color:#cbd5e1; }
    .epc-asp-login-erp .epc-login-field input, .epc-asp-login-erp .epc-login-field select {
        width:100%; padding:.6rem .7rem; border:0; border-radius:.45rem; background:#fff; color:#111;
    }
    .epc-asp-login-erp .epc-login-row { color:#94a3b8; font-size:.85rem; }
    .epc-asp-login-erp .epc-login-submit { width:100%; margin-top:.35rem; padding:.75rem 1rem; border:0; border-radius:.45rem; background:var(--accent); color:#fff; font-weight:700; cursor:pointer; }
    .epc-asp-login-erp .epc-login-error { background:#450a0a; color:#fecaca; border:1px solid #7f1d1d; border-radius:.4rem; padding:.55rem .7rem; margin-bottom:.75rem; }
    .epc-asp-login-erp .epc-login-bridge-note { color:#94a3b8; font-size:.78rem; line-height:1.4; margin:.85rem 0 .35rem; }
    .epc-asp-login-erp .epc-login-php { color:#93c5fd; font-weight:700; }
    @@media (max-width:900px){ .epc-asp-login-erp .modules,.epc-asp-login-erp .panel{grid-template-columns:1fr 1fr;} }
    @@media (max-width:640px){ .epc-asp-login-erp .modules,.epc-asp-login-erp .panel{grid-template-columns:1fr;} }
</style>

<div class="epc-asp-login-erp">
    <div class="wrap">
        <div class="top">
            <div class="brand">
                <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" />
                <div>
                    <div>ECOM AE</div>
                    <div style="font-size:.75rem;color:#94a3b8;font-weight:500">Finance &amp; operations · ecomae.com</div>
                </div>
            </div>
            <div style="display:flex;gap:1rem;font-size:.9rem">
                <a href="/ERP/" style="color:#93c5fd">ERP</a>
                <a href="/CP/" style="color:#93c5fd">Guide</a>
            </div>
        </div>

        <section class="hero">
            <div style="display:flex;justify-content:center;margin-bottom:.5rem">
                <PhpEcomaeHubLogo Variant="login" ShortTagline="true" AriaLabel="ECOM AE ERP hub" OrbitDuration="32s" />
            </div>
            <h1>ERP Finance</h1>
            <p class="sub">Unified Blockchain BOS Enterprise System</p>
        </section>

        <div class="modules">
            @foreach (var cat in PhpModuleCatalog.ErpCategories)
            {
                <a class="mod" href="@cat.Href" style="color:inherit;text-decoration:none">
                    <strong><i class="fa @cat.Icon"></i> @cat.Label</strong>
                    <span>Open ERP · @cat.Id</span>
                </a>
            }
        </div>
        <div class="stats">
            <span>@PhpModuleCatalog.ErpAreaCount AREAS</span>
            <span>@PhpModuleCatalog.ErpTabCount TABS</span>
            <span>@PhpModuleCatalog.ErpCategoryCount CATEGORIES</span>
            <span>LIVE WORKSPACE</span>
        </div>
        <div class="modules" style="margin-top:.75rem;grid-template-columns:repeat(auto-fill,minmax(160px,1fr))">
            @foreach (var area in PhpModuleCatalog.ErpAreas.Take(16))
            {
                <a class="mod" href="@area.Href" style="color:inherit;text-decoration:none">
                    <strong><i class="fa @area.Icon"></i> @area.Label</strong>
                    <span>Area @area.Id</span>
                </a>
            }
        </div>

        <div class="panel">
            <section>
                <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
                <div style="color:#94a3b8;font-size:.8rem;margin:.35rem 0">ECOM AE / Unified ERP &amp; Commerce Cloud</div>
                <h2><i class="fa fa-line-chart"></i> ERP Finance</h2>
                <p>Department sign-in for finance, sales, logistics, purchase, HR, and operations. No storefront account required — this area is separate from the public website.</p>
                <ul class="checks">
                    <li>Role-based tabs per department</li>
                    <li>GL, VAT, inventory &amp; payables</li>
                </ul>
            </section>
            <section class="login-card">
                <h2 style="margin-top:0">Sign in</h2>
                <LegacyAdminLoginForm Surface="LegacyLoginSurface.Erp" SurfaceLabel="ERP" PhpLoginHref="/ERP/" ErrorMessage="@_error" SubmitLabel="Log in" Accent="blue" />
            </section>
        </div>
    </div>
</div>

@code {
    private string? _error;
    protected override void OnInitialized() => _error = LoginErrorHelper.FromUri(Nav.Uri);
}
