@page "/storefront/industry-search-app"
@page "/en/storefront/industry-search-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>@_title</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" IncludePublicSeo="true" />
<PhpChromeBodyClass Surface="storefront" />

<StorefrontTenantChrome>
    <section class="epc-ind-search" style="padding:1.5rem 0 2.5rem">
        <div class="container">
            <p style="margin:0 0 .4rem;color:#64748b;font-size:.85rem"><a href="/">Home</a> · Search</p>
            <h1 style="margin:.1rem 0 .4rem;font-size:1.55rem">@_title</h1>
            <form method="get" action="/en/shop/search" style="display:flex;gap:.55rem;flex-wrap:wrap;margin:1rem 0 1.25rem">
                <input type="search"
                       name="search_string"
                       value="@_query"
                       placeholder="Search products"
                       style="flex:1;min-width:14rem;padding:.6rem .75rem;border:1px solid #d1d5db;border-radius:.45rem" />
                <button type="submit" class="btn btn-primary">Search</button>
            </form>
            @if (string.IsNullOrWhiteSpace(_query))
            {
                <p style="color:#64748b">Type a product name or SKU.</p>
            }
            else if (_results.Count == 0)
            {
                <p style="color:#64748b">No products matched “@_query” on this store.</p>
            }
            else
            {
                <p style="color:#64748b">@_results.Count result@(_results.Count == 1 ? "" : "s")</p>
                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:1rem;margin-top:1rem">
                    @foreach (var product in _results)
                    {
                        <article style="border:1px solid #e2e8f0;border-radius:.55rem;background:#fff;overflow:hidden">
                            <a href="@PhpIndustryStorefrontCatalog.ProductHref(product.Alias)" style="text-decoration:none;color:inherit;display:block">
                                <img src="@product.Image" alt="@product.Name" width="480" height="360" style="width:100%;height:180px;object-fit:cover;background:#f8fafc" />
                                <div style="padding:.7rem .8rem 1rem">
                                    <strong style="display:block;font-size:.92rem;line-height:1.35">@product.Name</strong>
                                    <span style="display:block;margin-top:.35rem;color:#0f766e;font-weight:700">@PhpIndustryStorefrontCatalog.FormatAed(product.Price)</span>
                                    <span style="display:block;margin-top:.2rem;color:#94a3b8;font-size:.75rem">@product.Alias</span>
                                </div>
                            </a>
                        </article>
                    }
                </div>
            }
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _title = "Search";
    private string _query = "";
    private IReadOnlyList<PhpIndustryStorefrontCatalog.Product> _results = [];

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        var host = ctx?.Request.Host.Host ?? string.Empty;
        var industry = StorefrontIndustryHostResolver.ResolveIndustryCode(host);
        _title = StorefrontIndustryHostResolver.ResolveBrandLabel(host) + " search";
        _query = (ctx?.Request.Query["search_string"].ToString()
                  ?? ctx?.Request.Query["q"].ToString()
                  ?? string.Empty).Trim();
        _results = string.IsNullOrWhiteSpace(_query)
            ? []
            : PhpIndustryStorefrontCatalog.Search(industry, _query);
    }
}
