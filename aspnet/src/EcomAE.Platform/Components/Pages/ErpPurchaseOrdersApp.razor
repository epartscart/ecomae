@page "/erp/purchase-orders-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Components.Shared.Desktop
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@using EcomAE.Platform.Erp
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav
@inject IErpDimensionLinkReadService DimensionLinks

<PageTitle>Purchase Orders · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="@(_barcodePurchase ? "Barcode / Purchase Margin" : "Purchase Orders")" BreadcrumbArea="Procure to Pay" BreadcrumbTab="@(_barcodePurchase ? "Barcode purchase" : "Purchase Orders")">
    @if (!_barcodePurchase)
    {
        <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/purchase-orders-app" IsAdmin="_isAdmin" />
    }

    <PhpErpModulePageHeader Title="@(_barcodePurchase ? "Barcode / Purchase Margin" : "Purchase Orders")" Subtitle="@(_barcodePurchase ? "In jewellery, the barcode is the purchase — cost, margin, and salesman at barcode level." : "LPO → PO → PI. Approve the PO, then invoice it. Official print preview opens after the document is posted.")" PhpTabHref="@_phpTab" />
    <ErpManualProcessStrip Keys="purchase" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="/erp/purchase-orders-app" />
    @if (_follow.HasValues)
    {
        <div class="alert alert-info" role="status" style="margin:0 0 12px;padding:.7rem .9rem">Process follow: @_follow.Banner. Matching fields are filled on the form.</div>
    }
    <ErpPhpFlash Ok="@_ok" Err="@_err" />
    @if (!_barcodePurchase)
    {
        <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    }


    @if (_isAdmin && _barcodePurchase)
    {
        <ErpPhpCreateWell Title="Create barcode purchase">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryBarcodePurchaseCreateForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/erp/purchase-orders-app?tab=barcode_purchase" />
                <label>Barcode <input class="form-control input-sm" name="barcode" placeholder="Auto" /></label>
                <label>Description <input class="form-control input-sm" name="item_description" required placeholder="22K bangle" /></label>
                <ErpMasterPicker Kind="supplier" FieldName="supplier_name" InputId="barcode-purchase-vendor" Label="Supplier" ValueMode="name" />
                <label>Karat <input class="form-control input-sm" name="karat" value="22K" /></label>
                <label>Net wt <input class="form-control input-sm" name="net_weight" type="number" step="0.001" value="0" /></label>
                <label>Gold rate <input class="form-control input-sm" name="gold_rate_at_purchase" type="number" step="0.0001" value="0" /></label>
                <label>Making <input class="form-control input-sm" name="making_charges" type="number" step="0.01" value="0" /></label>
                <label>Margin % <input class="form-control input-sm" name="margin_pct" type="number" step="0.01" value="15" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Create barcode purchase</button>
            </form>
        </ErpPhpCreateWell>
        <ErpPhpCreateWell Title="Sell barcode purchase">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryBarcodePurchaseSellForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/erp/purchase-orders-app?tab=barcode_purchase" />
                <label>Purchase id <input class="form-control input-sm" name="id" type="number" min="1" required /></label>
                <ErpMasterPicker Kind="customer" FieldName="customer_id" InputId="barcode-sell-customer" Label="Customer" />
                <label>Invoice id <input class="form-control input-sm" name="invoice_id" type="number" min="0" value="0" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Sell barcode purchase</button>
            </form>
        </ErpPhpCreateWell>
    }

    @if (!_barcodePurchase)
    {
    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Purchase order KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_orders.Count</div></div>
        <div class="kpi"><div class="lbl">Non-closed in page</div><div class="val">@_open</div></div>
        <div class="kpi"><div class="lbl">Page total amount</div><div class="val">@_totalAmount.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open PO value</div><div class="val">@_backlogValue.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open 30d+</div><div class="val">@_backlogAged30</div></div>
        <div class="kpi"><div class="lbl">Open 30d+ value</div><div class="val">@_backlogAged30Value.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedDetail is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="/erp/purchase-orders-app">Close</a>
                <a class="btn btn-xs btn-default" href="/erp/purchase-order-print?id=@_openedDetail.Id" target="_blank" rel="noopener">Print PO</a>
                @if (_openedDetail.OrderId > 0)
                {
                    <a class="btn btn-xs btn-default" href="/erp/lpo-print?id=@_openedDetail.OrderId.ToString(CultureInfo.InvariantCulture)" target="_blank" rel="noopener">Print LPO</a>
                }
                @if (_openedDetail.PurchaseId > 0)
                {
                    <a class="btn btn-xs btn-default" href="/erp/purchase-print?id=@_openedDetail.PurchaseId.ToString(CultureInfo.InvariantCulture)" target="_blank" rel="noopener">Print PI</a>
                }
            </p>
            <ErpDocumentWorkspace
                DocumentKind="Purchase order"
                Title="@_openedDetail.Title"
                DocumentNumber="@_openedDetail.PoNo"
                PartyLabel="Supplier"
                Party="@_openedDetail.SupplierId.ToString(CultureInfo.InvariantCulture)"
                ReferenceLabel="Purchase invoice"
                Reference="@(_openedDetail.PurchaseId > 0 ? _openedDetail.PurchaseId.ToString(CultureInfo.InvariantCulture) : "Not invoiced")"
                Status="@_openedDetail.Status"
                ApprovalState="@(_openedDetail.ApprovedAt > 0 ? "Approved" : "Approval pending")"
                Currency="AED"
                Subtotal="@_openedDetail.AmountExVat"
                Tax="@_openedDetail.VatAmount"
                Total="@_openedDetail.TotalAmount"
                BalanceDue="@_openedDetail.TotalAmount"
                Fields="@PurchaseOrderWorkspaceFields"
                Lines="@PurchaseOrderWorkspaceLines"
                RelatedDocuments="@PurchaseOrderRelatedDocuments"
                HeaderActions="@PurchaseOrderHeaderActions" />
            <ErpDimensionLinksPanel Links="_openedDimensionLinks" />
            <p class="text-muted" style="margin:.85rem 0 0">The workspace is backed by the persisted purchase-order read model. Barcode purchase schema-ensure is not available on this page; purchase-order lifecycle actions use the guarded ERP routes shown in the action pane and list.</p>
            @if (!string.IsNullOrWhiteSpace(_openedDetail.NotesExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">notes excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedDetail.NotesExcerpt</pre>
                @if (_openedDetail.NotesLen > _openedDetail.NotesExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_openedDetail.NotesExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedDetail.NotesLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No notes excerpt yet.</p>
            }
            <ErpDocumentReadbacks Lines="_openedLines" Attachments="_openedAttachments" AuditTrail="_openedAuditTrail" />
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>PO #</th><th>Supplier</th><th class="text-right">Total</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.PoNo) ? "—" : sib.PoNo)</td>
                                <td>@sib.SupplierId.ToString(CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@sib.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href("/erp/purchase-orders-app", "po_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    @if (_isAdmin)
    {
        <div class="panel panel-default" id="erp-module-new">
            <div class="panel-heading"><strong>New purchase order</strong> <span class="text-muted">PO number, VAT and totals follow the tenant jurisdiction kit.</span></div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-sm-3"><ErpMasterPicker Kind="supplier" FieldName="supplier_id" InputId="po-supplier" Label="Supplier" Required="true" /></div>
                    <div class="col-sm-4"><label for="po-title">Title</label><input id="po-title" class="form-control" type="text" maxlength="255" value="@_follow.Name" /></div>
                    <div class="col-sm-2"><label for="po-amount">Amount (ex VAT)</label><input id="po-amount" class="form-control" type="number" min="0" step="0.01" readonly aria-describedby="po-amount-help" /><span id="po-amount-help" class="help-block small">Sum of lines</span></div>
                    <div class="col-sm-3"><label for="po-notes">Notes</label><input id="po-notes" class="form-control" type="text" value="@_follow.Note" /></div>
                    <div class="col-sm-1"><label for="po-save">&nbsp;</label><button id="po-save" type="button" class="btn btn-primary btn-block">Save</button></div>
                </div>

                <datalist id="erp-item-list">
                    @foreach (var item in _items)
                    {
                        <option value="@item.Sku" label="@item.Name"></option>
                    }
                </datalist>

                <div class="epc-erp-table-wrap" style="margin-top:10px">
                    <table class="table table-bordered table-condensed table-epc" id="po-lines">
                        <thead>
                            <tr>
                                <th style="width:22%">Item / SKU</th>
                                <th>Description</th>
                                <th style="width:12%">Qty</th>
                                <th style="width:15%">Unit cost (ex VAT)</th>
                                <th style="width:15%">Line total</th>
                                <th style="width:6%">&nbsp;</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-right"><strong>Total (ex VAT)</strong></td>
                                <td id="po-lines-total">0.00</td>
                                <td>&nbsp;</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <button id="po-line-add" type="button" class="btn btn-default btn-xs">Add line</button>
                <select id="po-item-picker" class="form-control input-sm" style="display:inline-block;width:auto;margin-left:8px" aria-label="Link inventory item to the last line">
                    <option value="">-- Link Inventory Item --</option>
                    @foreach (var item in _items)
                    {
                        var cost = item.PurchasePrice.ToString("0.00", CultureInfo.InvariantCulture);
                        <option value="@item.Id.ToString(CultureInfo.InvariantCulture)"
                                data-sku="@item.Sku"
                                data-name="@item.Name"
                                data-price="@cost">@item.Sku — @item.Name</option>
                    }
                </select>
                <input id="po-id" type="hidden" value="0" />
                <p id="po-feedback" class="text-muted" role="status" aria-live="polite"></p>
            </div>
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>PO #</th>
                    <th>When</th>
                    <th>Supplier</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_orders.Count == 0)
                {
                    <tr><td colspan="7" class="text-muted">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No purchase orders." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var o in _orders)
                    {
                        <tr id="erp-row-@o.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(o.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(o.PoNo) ? $"#{o.Id}" : o.PoNo)</strong></td>
                            <td>@FormatTime(o.TimeCreated)</td>
                            <td>@o.SupplierId</td>
                            <td>@(string.IsNullOrWhiteSpace(o.Title) ? "—" : o.Title)</td>
                            <td><span class="label label-@ErpPhpStatusLabel.Class(o.Status)">@o.Status</span></td>
                            <td>@o.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>
                                <a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href("/erp/purchase-orders-app", "po_id", o.Id)">Open</a>
                                <a class="btn btn-xs btn-default" href="/erp/purchase-order-print?id=@o.Id.ToString(CultureInfo.InvariantCulture)" target="_blank" rel="noopener">@(ErpPurchaseDocumentPrint.IsOfficialPo(o.Status) ? "Print" : "Preview")</a>
                                @if (_isAdmin)
                                {
                                    <span class="epc-po-actions" data-po-id="@o.Id.ToString(CultureInfo.InvariantCulture)">
                                        <button type="button" class="btn btn-link btn-xs epc-po-status" data-status="approved">Approve</button>
                                        <button type="button" class="btn btn-link btn-xs epc-po-status" data-status="cancelled">Cancel</button>
                                        <button type="button" class="btn btn-link btn-xs epc-po-invoice">Invoice</button>
                                        <button type="button" class="btn btn-link btn-xs epc-po-delete">Delete</button>
                                    </span>
                                }
                            </td>
                        </tr>
                        @if (o.Lines.Count > 0)
                        {
                            <tr class="epc-erp-doc-lines">
                                <td colspan="7">
                                    <table class="table table-condensed table-bordered epc-po-lines" data-po-id="@o.Id.ToString(CultureInfo.InvariantCulture)" style="margin-bottom:0">
                                        <thead>
                                            <tr>
                                                <th style="width:18%">Item / SKU</th>
                                                <th>Description</th>
                                                <th style="width:10%" class="text-right">Qty</th>
                                                <th style="width:10%" class="text-right">Received</th>
                                                <th style="width:12%" class="text-right">Unit cost</th>
                                                <th style="width:12%" class="text-right">Line total</th>
                                                @if (_isAdmin)
                                                {
                                                    <th style="width:12%">Receive qty</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var line in o.Lines)
                                            {
                                                <tr>
                                                    <td>@(string.IsNullOrWhiteSpace(line.ItemCode) ? "—" : line.ItemCode)</td>
                                                    <td>@line.Description</td>
                                                    <td class="text-right">@line.Qty.ToString("N3", CultureInfo.InvariantCulture)</td>
                                                    <td class="text-right">@line.QtyReceived.ToString("N3", CultureInfo.InvariantCulture)</td>
                                                    <td class="text-right">@line.UnitPriceExVat.ToString("N4", CultureInfo.InvariantCulture)</td>
                                                    <td class="text-right">@line.LineExVat.ToString("N2", CultureInfo.InvariantCulture)</td>
                                                    @if (_isAdmin)
                                                    {
                                                        <td><input type="number" step="0.001" min="0" class="form-control input-sm epc-po-receive-qty" data-line-id="@line.LineId.ToString(CultureInfo.InvariantCulture)" placeholder="0" /></td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="5" class="text-right"><strong>Lines total (ex VAT)</strong></td>
                                                <td class="text-right">@o.Lines.Sum(l => l.LineExVat).ToString("N2", CultureInfo.InvariantCulture)</td>
                                                @if (_isAdmin)
                                                {
                                                    <td><button type="button" class="btn btn-default btn-xs epc-po-receive">Receive</button></td>
                                                }
                                            </tr>
                                        </tfoot>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                    <tr style="font-weight:600;background:#f2f6fa">
                        <td>Total</td>
                        <td colspan="4"></td>
                        <td>@_orders.Sum(o => o.TotalAmount).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td class="text-muted">@_orders.Count orders</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }

    @if (_barcodePurchase)
    {
        <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
            Barcode purchase create and sell are live when confirmed. Schema-ensure is not available on this page.
        </div>
    }

</PhpErpDesktopChrome>

@if (_isAdmin && !_barcodePurchase)
{
    <script src="/erp/erp-purchase-orders.js" defer></script>
}

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=purchasing&tab=purchase_orders";
    private bool _isAdmin;
    private ErpD365FollowPrefill _follow = new("", 0, "", "", "", "", "", 0, 0, "");
    private IReadOnlyList<ErpDimensionLink> _openedDimensionLinks = [];
    private bool _barcodePurchase;
    private string _ok = "";
    private string _err = "";
    private IReadOnlyList<ErpPurchaseOrderDigest> _orders = [];
    private IReadOnlyList<ErpInventoryItemPickerDigest> _items = [];
    private int _open;
    private decimal _totalAmount;
    private int _backlogAged30;
    private decimal _backlogValue;
    private decimal _backlogAged30Value;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpPurchaseOrderDigest? _openedOrder;
    private ErpPurchaseOrderDetail? _openedDetail;
    private IReadOnlyList<ErpPurchaseOrderDigest> _openedSiblings = [];
    private IReadOnlyList<ErpAuditTrailRow> _openedAuditTrail = [];
    private IReadOnlyList<ErpDocumentAttachmentRow> _openedAttachments = [];
    private IReadOnlyList<ErpDocumentLineDigest> _openedLines = [];

    private bool OpenedFound => _openedDetail is not null || _openedOrder is not null;
    private IReadOnlyList<ErpDocumentWorkspaceField> PurchaseOrderWorkspaceFields =>
        _openedDetail is null
            ? []
            :
            [
                new("Supplier account", _openedDetail.SupplierId.ToString(CultureInfo.InvariantCulture)),
                new("Buyer", _openedDetail.AdminId > 0 ? _openedDetail.AdminId.ToString(CultureInfo.InvariantCulture) : "Unassigned"),
                new("Requested delivery", "Not captured"),
                new("Confirmed delivery", _openedDetail.ReceivedAt > 0 ? FormatTime(_openedDetail.ReceivedAt) : "Not received", "Delivery"),
                new("Warehouse", "Tenant default", "Delivery"),
                new("Procurement category", "Inventory / services", "Operational"),
                new("Payment terms", "Supplier profile", "Financial"),
                new("Three-way match", _openedDetail.PurchaseId > 0 ? "Invoice linked" : "Awaiting invoice", "Financial"),
                new("Financial dimensions", "Company / site / project", "Dimensions"),
                new("Receipt status", _openedDetail.ReceivedAt > 0 ? "Received" : "Open", "Operational")
            ];
    private IReadOnlyList<ErpRelatedDocumentNode> PurchaseOrderRelatedDocuments =>
        _openedDetail is null
            ? []
            : ErpRelatedDocumentMapFactory.ForPurchase(
                string.IsNullOrWhiteSpace(_openedDetail.PoNo) ? _openedDetail.Id.ToString(CultureInfo.InvariantCulture) : _openedDetail.PoNo,
                FormatTime(_openedDetail.TimeCreated),
                "AED " + _openedDetail.TotalAmount.ToString("N2", CultureInfo.InvariantCulture),
                ErpRecordOpen.Href("/erp/purchase-orders-app", "po_id", _openedDetail.Id),
                _openedDetail.ReceivedAt > 0
                    ?
                    [
                        ErpRelatedDocumentMapFactory.Node(
                            "goods_receipt",
                            "Goods Receipt PO",
                            "GR " + _openedDetail.Id.ToString(CultureInfo.InvariantCulture),
                            FormatTime(_openedDetail.ReceivedAt),
                            "AED " + _openedDetail.TotalAmount.ToString("N2", CultureInfo.InvariantCulture),
                            ErpRecordOpen.Href("/erp/purchase-orders-app", "po_id", _openedDetail.Id),
                            false,
                            true)
                    ]
                    : null,
                _openedDetail.PurchaseId > 0 ? _openedDetail.PurchaseId.ToString(CultureInfo.InvariantCulture) : "",
                _openedDetail.PurchaseId > 0 ? FormatTime(_openedDetail.TimeUpdated) : "",
                _openedDetail.PurchaseId > 0 ? "AED " + _openedDetail.TotalAmount.ToString("N2", CultureInfo.InvariantCulture) : "",
                _openedDetail.PurchaseId > 0 ? ErpRecordOpen.Href("/erp/invoices-app", "inv_id", _openedDetail.PurchaseId) : "/erp/invoices-app");

    private IReadOnlyList<ErpDocumentWorkspaceLine> PurchaseOrderWorkspaceLines =>
        _orders.FirstOrDefault(item => item.Id == _openedDetail?.Id)?.Lines
            .Select(line => new ErpDocumentWorkspaceLine(
                line.ItemCode,
                line.Description,
                line.Qty,
                "ea",
                "Default",
                "Default",
                line.UnitPriceExVat,
                0,
                0,
                line.LineExVat,
                line.QtyReceived,
                line.DocumentId > 0 ? "PO " + line.DocumentId.ToString(CultureInfo.InvariantCulture) : "—"))
            .ToArray() ?? [];
    private RenderFragment? PurchaseOrderHeaderActions => _isAdmin && _openedDetail is not null && _openedDetail.PurchaseId > 0
        ? @<div>
            <strong>Purchase invoice lifecycle</strong>
            <form method="post" action="/erp/purchases/void">
                <input type="hidden" name="purchaseId" value="@_openedDetail.PurchaseId" />
                <label>Reason <input type="text" name="reason" maxlength="255" placeholder="Void reason" /></label>
                <button type="submit" name="confirmWrites" value="false" class="btn btn-default btn-xs">Validate void</button>
                <button type="submit" name="confirmWrites" value="true" class="btn btn-warning btn-xs">Void purchase invoice</button>
            </form>
        </div>
        : null;

    private string OpenedReturnHref => _openedId > 0
        ? "/erp/purchase-orders-app?po_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : "/erp/purchase-orders-app";

    private string OpenedCaption => _openedDetail is not null
        ? (string.IsNullOrWhiteSpace(_openedDetail.PoNo) ? ("Purchase order #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.PoNo)
            + (string.IsNullOrWhiteSpace(_openedDetail.Title) ? "" : (" · " + _openedDetail.Title))
        : _openedOrder is null
            ? ""
            : (string.IsNullOrWhiteSpace(_openedOrder.PoNo) ? $"Purchase order #{_openedOrder.Id}" : _openedOrder.PoNo) + " · " + _openedOrder.Status;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _follow = ErpD365FollowPrefill.Read(ctx.Request);
        _barcodePurchase = string.Equals(ctx.Request.Query["tab"].ToString(), "barcode_purchase", StringComparison.OrdinalIgnoreCase);
        _ok = ctx.Request.Query["ok"].ToString();
        _err = ctx.Request.Query["err"].ToString();
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "po_id", "order_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListErpPurchaseOrdersAsync(_limit, ctx.RequestAborted);
        _orders = result.Orders;
        _openedOrder = _openedId > 0 ? _orders.FirstOrDefault(o => o.Id == _openedId) : null;
        if (_openedOrder is not null)
        {
            _orders = new[] { _openedOrder }.Concat(_orders.Where(o => o.Id != _openedId)).ToList();
        }
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpPurchaseOrderDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Order;
            _openedDimensionLinks = await DimensionLinks.LoadAsync("purchase_order", _openedId, ctx.RequestAborted);
            _openedSiblings = detail.Siblings;
            _openedAuditTrail = detail.AuditTrail;
            _openedAttachments = detail.Attachments;
            _openedLines = detail.Lines;
            if (_openedDetail is null && !string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
        _items = (await Dashboards.ListErpInventoryItemsForPickerAsync(ErpFirstPaint.PickerLimit, ctx.RequestAborted)).Items;
        _open = _orders.Count(o => !string.Equals(o.Status, "closed", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(o.Status, "cancelled", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(o.Status, "canceled", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(o.Status, "received", StringComparison.OrdinalIgnoreCase));
        _totalAmount = _orders.Sum(o => o.TotalAmount);
        var nowUnixPo = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var openOrders = _orders.Where(o => !string.Equals(o.Status, "closed", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(o.Status, "cancelled", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(o.Status, "canceled", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(o.Status, "received", StringComparison.OrdinalIgnoreCase)).ToList();
        _backlogValue = openOrders.Sum(o => o.TotalAmount);
        var aged = openOrders.Where(o => nowUnixPo - o.TimeCreated > 30L * 86400).ToList();
        _backlogAged30 = aged.Count;
        _backlogAged30Value = aged.Sum(o => o.TotalAmount);
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
