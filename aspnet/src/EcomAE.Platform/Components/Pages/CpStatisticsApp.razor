@page "/cp/statistics-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Statistics · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Statistics
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/statistics-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/statistics-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_orderCount.ToString(CultureInfo.InvariantCulture) Orders · @_queryCount.ToString(CultureInfo.InvariantCulture) Queries · @_uniqueArticles.ToString(CultureInfo.InvariantCulture) Unique articles · @_activeDays.ToString(CultureInfo.InvariantCulture) Active days.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Article</th>
                    <th>Brand</th>
                    <th>Hits</th>
                    <th>Last seen</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="5">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@(!string.IsNullOrWhiteSpace(row.Article) ? row.Article : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Brand) ? row.Brand : "—")</td>
                            <td>@row.Hits.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.LastSeen.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="epc-nw-note">Read-only commerce statistics. Live supplier poll and write analytics remain PHP.</div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/statistics/statistics";
    private bool _isAdmin;
    private int _orderCount = 0;
    private int _queryCount = 0;
    private int _uniqueArticles = 0;
    private int _activeDays = 0;
    private IReadOnlyList<CpStatisticsRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpStatisticsDigestAsync(200, ctx.RequestAborted);
        _orderCount = result.Summary.OrderCount;
        _queryCount = result.Summary.QueryCount;
        _uniqueArticles = result.Summary.UniqueArticles;
        _activeDays = result.Summary.ActiveDays;
        _rows = result.Rows;
        _source = result.Source;
        _message = result.Message;
    }
}
