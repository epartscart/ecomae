@page "/ip/login"
@* Lowercase only — /IP/login AmbiguousMatchException under case-insensitive routing. *@
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject NavigationManager Nav

<PageTitle>Intelligence Platform OS — Sign in</PageTitle>
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<style>@((MarkupString)_css)</style>
<HeadContent>
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<meta name="ecomae-chrome-surface" content="ip-os-login" />
<style>@((MarkupString)_css)</style>
</HeadContent>

<div class="ipos-login">
  <div class="ipos-login__stage" aria-hidden="true">
    <div class="ipos-login__orb a"></div>
    <div class="ipos-login__orb b"></div>
    <div class="ipos-login__grid"></div>
    <svg class="ipos-login__ring" viewBox="0 0 400 400">
      <circle cx="200" cy="200" r="150" fill="none" stroke="rgba(56,189,248,.25)" stroke-width="1.5" stroke-dasharray="8 10"/>
      <circle cx="200" cy="200" r="110" fill="none" stroke="rgba(125,211,252,.35)" stroke-width="1" stroke-dasharray="4 8"/>
    </svg>
  </div>

  <section class="ipos-login__hero">
    <p class="ipos-login__kicker">ecomae · Super-CP</p>
    <h1>Intelligence Platform <em>OS</em></h1>
    <p class="ipos-login__lede">
      Boot into the operator desktop — app management, multi-client fleet control,
      and the LifeOS™ ambient operating system.
    </p>
    <ul class="ipos-login__features">
      <li><strong>App management</strong><span>BOS modules + ambient OS suite</span></li>
      <li><strong>Client management</strong><span>Tenants, features, users, API clients</span></li>
      <li><strong>LifeOS™</strong><span>Universal ambient AI operating system</span></li>
      <li><strong>Unified session</strong><span>Same Super-CP operator credentials</span></li>
    </ul>
  </section>

  <section class="ipos-login__panel">
    <div class="ipos-login__card">
      <header>
        <span class="ipos-login__mark">IP</span>
        <div>
          <h2>Operator sign in</h2>
          <p>Enter the Intelligence Platform OS desktop</p>
        </div>
      </header>
      <PhpOAuthLoginButtons Context="cp" ReturnUrl="/ip/app" Tone="dark"
                            Heading="Continue with Google — credentials stay private" />
      <LoginAntiAutofill />
      <form method="post" action="@EcomAeRoutes.IpLogin" id="ipLoginForm"
            autocomplete="off" data-lpignore="true" data-1p-ignore="true" data-form-type="other">
        <input type="hidden" name="surface" value="ip" />
        <input type="hidden" name="redirect" value="/ip/app" />
        <input type="hidden" name="contact_type" value="email" />
        <div aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;">
          <input type="text" name="epc_autofill_decoy_user" tabindex="-1" autocomplete="username" value="" />
          <input type="password" name="epc_autofill_decoy_pass" tabindex="-1" autocomplete="current-password" value="" />
        </div>
        <label>
          <span>Email</span>
          <input type="email" name="contact" required autocomplete="off"
                 autocapitalize="none" spellcheck="false"
                 data-lpignore="true" data-1p-ignore="true" data-bwignore="true"
                 data-epc-anti-autofill="1" readonly="readonly"
                 placeholder="operator@ecomae.com" />
        </label>
        <label>
          <span>Password</span>
          <input type="password" name="password" required autocomplete="new-password"
                 data-lpignore="true" data-1p-ignore="true" data-bwignore="true"
                 data-epc-anti-autofill="1" readonly="readonly"
                 placeholder="Secure password" />
        </label>
        @if (!string.IsNullOrEmpty(_error))
        {
          <div class="ipos-login__error" role="alert">@_error</div>
        }
        <button type="submit">Enter Intelligence Platform OS</button>
      </form>
      <footer>
        <a href="/lifeos">LifeOS preview</a>
        <a href="https://lifeos.ecomae.com/">lifeos.ecomae.com</a>
        <a href="/cp/lifeos-guide-app">System guide</a>
      </footer>
    </div>
  </section>
</div>

@code {
    private string? _error;

    protected override void OnInitialized()
    {
        _error = LoginErrorHelper.FromUri(Nav.Uri);
    }

    private const string _css = """
        html, body { margin: 0; padding: 0; background: #020617; }
        .ipos-login {
          --ipos-display: "Fraunces", Georgia, serif; --ipos-sans: "Sora", "Segoe UI", sans-serif;
          position: relative; min-height: 100vh; display: grid; grid-template-columns: 1.15fr .95fr;
          color: #e2e8f0; font-family: var(--ipos-sans); overflow: hidden;
        }
        .ipos-login__stage { position: absolute; inset: 0; pointer-events: none; z-index: 0;
          background: radial-gradient(90% 70% at 15% 20%, rgba(14,165,233,.28), transparent 55%),
                      radial-gradient(70% 60% at 85% 80%, rgba(37,99,235,.22), transparent 50%),
                      #020617; }
        .ipos-login__orb { position: absolute; border-radius: 50%; filter: blur(42px); opacity: .55;
          animation: ipos-boot-float 12s ease-in-out infinite; }
        .ipos-login__orb.a { width: 20rem; height: 20rem; left: 8%; top: 18%; background: rgba(56,189,248,.35); }
        .ipos-login__orb.b { width: 16rem; height: 16rem; right: 12%; bottom: 12%; background: rgba(37,99,235,.4); animation-delay: -4s; }
        .ipos-login__grid { position: absolute; inset: 0; opacity: .1;
          background-image: linear-gradient(rgba(255,255,255,.14) 1px, transparent 1px),
                            linear-gradient(90deg, rgba(255,255,255,.14) 1px, transparent 1px);
          background-size: 42px 42px; }
        .ipos-login__ring { position: absolute; width: 22rem; height: 22rem; left: 12%; top: 28%;
          animation: ipos-boot-spin 48s linear infinite; opacity: .7; }
        @@keyframes ipos-boot-float { 0%,100%{ transform: translateY(0);} 50%{ transform: translateY(-16px);} }
        @@keyframes ipos-boot-spin { to { transform: rotate(360deg);} }
        @@keyframes ipos-boot-rise { from{ opacity:0; transform: translateY(16px);} to{ opacity:1; transform: none;} }

        .ipos-login__hero, .ipos-login__panel { position: relative; z-index: 1; padding: clamp(1.5rem,4vw,3rem); }
        .ipos-login__hero { display: flex; flex-direction: column; justify-content: center; animation: ipos-boot-rise .7s ease both; }
        .ipos-login__kicker { margin: 0; font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; color: #7dd3fc; font-weight: 700; }
        .ipos-login__hero h1 {
          margin: .45rem 0 .6rem; font-family: var(--ipos-display); font-weight: 500;
          font-size: clamp(2rem, 4.5vw, 3.1rem); line-height: 1.1;
        }
        .ipos-login__hero h1 em { font-style: italic; color: #7dd3fc; }
        .ipos-login__lede { margin: 0 0 1.4rem; max-width: 34rem; color: #cbd5e1; line-height: 1.5; font-size: 1rem; }
        .ipos-login__features { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; max-width: 28rem; }
        .ipos-login__features li {
          display: grid; gap: .1rem; padding: .75rem .9rem; border-radius: .65rem;
          border: 1px solid rgba(56,189,248,.22); background: rgba(8,15,30,.55);
        }
        .ipos-login__features strong { font-size: .9rem; color: #fff; }
        .ipos-login__features span { font-size: .78rem; color: #94a3b8; }

        .ipos-login__panel { display: flex; align-items: center; justify-content: center; animation: ipos-boot-rise .8s ease .08s both; }
        .ipos-login__card {
          width: min(100%, 26rem); padding: 1.4rem 1.45rem 1.2rem; border-radius: 1rem;
          border: 1px solid rgba(56,189,248,.3);
          background: rgba(8,15,30,.88); box-shadow: 0 28px 70px rgba(0,0,0,.4); backdrop-filter: blur(16px);
        }
        .ipos-login__card header { display: flex; gap: .85rem; align-items: center; margin-bottom: 1.15rem; }
        .ipos-login__mark {
          width: 2.8rem; height: 2.8rem; display: grid; place-items: center; border-radius: .65rem;
          font-weight: 800; color: #020617; background: linear-gradient(135deg, #7dd3fc, #2563eb);
        }
        .ipos-login__card h2 { margin: 0; font-size: 1.15rem; }
        .ipos-login__card header p { margin: .15rem 0 0; color: #94a3b8; font-size: .8rem; }
        .ipos-login__card form { display: grid; gap: .85rem; }
        .ipos-login__card label { display: grid; gap: .35rem; font-size: .78rem; font-weight: 700; color: #cbd5e1; }
        .ipos-login__card input {
          width: 100%; box-sizing: border-box; padding: .75rem .85rem; border-radius: .5rem;
          border: 1px solid rgba(148,163,184,.35); background: rgba(2,6,23,.75); color: #fff; font: inherit;
        }
        .ipos-login__card input:focus { outline: 2px solid rgba(56,189,248,.55); border-color: #38bdf8; }
        .ipos-login__error {
          padding: .65rem .75rem; border-radius: .45rem; background: rgba(239,68,68,.12);
          border: 1px solid rgba(248,113,113,.35); color: #fecaca; font-size: .84rem;
        }
        .ipos-login__card button {
          appearance: none; border: 0; cursor: pointer; margin-top: .2rem;
          padding: .85rem 1rem; border-radius: .55rem; font-weight: 800; font-size: .9rem;
          color: #020617; background: linear-gradient(135deg, #7dd3fc, #38bdf8);
        }
        .ipos-login__card footer {
          display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1rem; padding-top: .9rem;
          border-top: 1px solid rgba(148,163,184,.18);
        }
        .ipos-login__card footer a { color: #7dd3fc; font-size: .78rem; font-weight: 700; text-decoration: none; }
        @@media (max-width: 900px) {
          .ipos-login { grid-template-columns: 1fr; }
          .ipos-login__ring { display: none; }
        }
        """;
}
