@page "/erp/staff-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Staff · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Staff" BreadcrumbArea="People" BreadcrumbTab="Staff">

    <PhpErpModulePageHeader Title="Staff &amp; departments" Subtitle="Each department has its own ERP tabs and workflow queue. Dashboard centres (CEO, CFO, Sales, …) are controlled by staff profile — sales cannot see profit." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Staff KPIs">
        <div class="kpi"><div class="lbl">Active staff</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Shown</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Departments</div><div class="val">@ErpStaffDepartmentCatalog.All.Count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open workflow tasks</div><div class="val">0</div></div>
    </div>

    <h5>Department map</h5>
    <div class="epc-erp-table-wrap">
        <table class="table table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Department</th><th>ERP tabs</th><th>Open tasks</th><th>Standard workflow</th></tr></thead>
            <tbody>
                @foreach (var d in ErpStaffDepartmentCatalog.All)
                {
                    <tr>
                        <td><i class="fa @d.Icon" style="color:@d.Color" aria-hidden="true"></i> <strong>@d.Name</strong></td>
                        <td><small>@d.TabsLabel</small></td>
                        <td>0</td>
                        <td><small>@string.Join(" → ", d.Workflows)</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h5>Staff directory &amp; dashboard centres</h5>
    <p class="text-muted" style="margin-top:0;">Dashboard centre is resolved from: explicit override → job title (CEO/CFO) → department default. Example: Sales Executive never sees profit.</p>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Job title</th>
                    <th>Dashboard centre</th>
                    <th>Login e-mail</th>
                    <th>Phone</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (_staff.Count == 0)
                {
                    <tr><td colspan="7" class="text-muted">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No staff — run staff setup on the shop database." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _staff)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.DisplayName) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.DisplayName)</strong></td>
                            <td>@ErpStaffDepartmentCatalog.NameFor(row.DepartmentCode)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.JobTitle) ? "—" : row.JobTitle)</td>
                            <td>Auto (dept/title)</td>
                            <td><code>@(string.IsNullOrWhiteSpace(row.Email) ? "—" : row.Email)</code></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Phone) ? "—" : row.Phone)</td>
                            <td><span class="label label-default">@(row.Active ? "active" : "inactive")</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Department map is PHP <code>epc_erp_departments_config</code> (static). Payroll stays on <a href="/erp/payroll-app">payroll</a>. HR salaries stay on <a href="/cp/hr-overview-app">HR</a>.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=hr&tab=staff";
    private bool _isAdmin;
    private IReadOnlyList<ErpStaffProfileDigest> _staff = [];
    private int _count;
    private int _active;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpStaffAsync(200, ctx.RequestAborted);
        _staff = result.Staff;
        _count = result.Count;
        _active = result.ActiveCount;
        _source = result.Source;
        _message = result.Message;
    }
}
