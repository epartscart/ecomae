@page "/erp/staff-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Staff · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Staff" BreadcrumbArea="People" BreadcrumbTab="Staff">

    <PhpErpModulePageHeader Title="Staff directory" Subtitle="Department profiles from the shop staff register. Profile writes stay on ERP ajax." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Staff KPIs">
        <div class="kpi"><div class="lbl">Shown</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Departments</div><div class="val">@_departments.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Title</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>User</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_staff.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No staff profiles yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _staff)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.DisplayName) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.DisplayName)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.DepartmentCode) ? "—" : row.DepartmentCode)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.JobTitle) ? "—" : row.JobTitle)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Email) ? "—" : row.Email)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Phone) ? "—" : row.Phone)</td>
                            <td>@(row.UserId > 0 ? row.UserId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><span class="label label-default">@(row.Active ? "active" : "inactive")</span></td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Payroll runs stay on <a href="/erp/payroll-app">payroll</a>.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=hr&tab=staff";
    private bool _isAdmin;
    private IReadOnlyList<ErpStaffProfileDigest> _staff = [];
    private int _count;
    private int _active;
    private int _departments;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpStaffAsync(200, ctx.RequestAborted);
        _staff = result.Staff;
        _count = result.Count;
        _active = result.ActiveCount;
        _departments = result.DepartmentCount;
        _source = result.Source;
        _message = result.Message;
    }
}
