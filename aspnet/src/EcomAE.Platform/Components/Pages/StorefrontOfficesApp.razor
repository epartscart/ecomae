@page "/storefront/offices-app"
@page "/en/ofisy"
@page "/ofisy"
@page "/en/shop/offices"
@page "/shop/offices"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject IHttpContextAccessor Http

<PageTitle>Pickup points · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" IncludePublicSeo="true" />
<PhpChromeBodyClass Surface="storefront" />

<StorefrontTenantChrome>
    <section style="padding:2rem 0 3rem">
        <div class="container" style="max-width:46rem">
            <p style="margin:0 0 .35rem;color:#64748b;font-size:.85rem"><a href="/">Home</a> · Pickup points</p>
            <h1 style="margin:.1rem 0 .4rem">@_heading</h1>
            <p style="color:#475569">@_lead</p>
            @foreach (var office in _offices)
            {
                <article style="margin:1rem 0;padding:1rem 1.1rem;background:#fff;border:1px solid #e2e8f0;border-radius:.55rem">
                    <h2 style="margin:0 0 .35rem;font-size:1.1rem">@office.Name</h2>
                    <p style="margin:0 0 .25rem;color:#334155">@office.City · @office.Address</p>
                    <p style="margin:0;color:#64748b;font-size:.9rem">@office.Hours · @office.Phone</p>
                </article>
            }
            <p style="margin-top:1.25rem">
                <a href="@StorefrontAspNetCanonical.IndustryCms?slug=kontakty">Contact</a>
                ·
                <a href="@StorefrontAspNetCanonical.CheckoutHowGet">Checkout delivery</a>
            </p>
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private string _heading = "Pickup points";
    private string _lead = "Collect your order from a warehouse counter.";
    private IReadOnlyList<PhpStorefrontOffices.Office> _offices = [];

    protected override async Task OnInitializedAsync()
    {
        var host = Http.HttpContext?.Request.Host.Host;
        var industry = StorefrontIndustryHostResolver.ResolveIndustryCode(host);
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(host);
        _offices = PhpStorefrontOffices.ForIndustry(industry);
        (_heading, _lead) = industry switch
        {
            "electronics" => ("Store & warehouse", "Collect electronics from the counter or warehouse."),
            "fashion" => ("Stores", "Collect fashion and beauty orders from a Style N Look store."),
            "jewellery" => ("Boutiques", "Collect jewellery from a boutique. Signature may be required."),
            "tax_advisory" or "consultancy" => ("Offices", "Meet an advisor at a Taxofinca desk."),
            _ => ("Pickup points", "Collect spare-parts orders from a warehouse counter."),
        };

        var digest = await Dashboards.BuildCpOfficesDigestAsync(40, Http.HttpContext?.RequestAborted ?? default);
        if (digest.Offices.Count == 0)
        {
            return;
        }

        _offices = digest.Offices
            .Select(o => new PhpStorefrontOffices.Office(
                string.IsNullOrWhiteSpace(o.Caption) ? ("Office #" + o.Id.ToString(System.Globalization.CultureInfo.InvariantCulture)) : o.Caption,
                o.City,
                o.Address,
                "See store",
                o.Phone))
            .ToList();
    }
}
