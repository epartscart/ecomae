@page "/cp/super-cp-operator-guide-app"
@page "/cp/control/portal/epc_super_cp_operator_guide"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Operator workspace guide · Super CP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
    .epc-scp-guide-callout { background:#fff; border:1px solid #e2e8f0; border-left:4px solid #0f766e; border-radius:12px; padding:14px 16px; margin:0 0 14px; }
    .epc-scp-guide-callout--tenant { border-left-color:#f59e0b; }
    .epc-scp-guide-callout h4 { margin:0 0 8px; font-size:1rem; }
    .epc-scp-guide-callout h4 i { margin-right:8px; color:#0f766e; }
    .epc-scp-guide-callout p, .epc-scp-guide-callout li { font-size:13px; color:#475569; line-height:1.55; }
    .epc-scp-guide-callout ul { margin:6px 0 0; padding-left:20px; }
    .epc-scp-guide-callout__equiv { margin-top:8px; }
    .epc-scp-section-title { margin:18px 0 10px; font-size:1.05rem; }
    .epc-scp-section-title i { margin-right:8px; color:#0f766e; }
    .epc-scp-guide-modules { display:grid; grid-template-columns:repeat(auto-fill,minmax(360px,1fr)); gap:14px; }
    .epc-scp-guide-module { background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:14px 16px; }
    .epc-scp-guide-module__head { display:flex; align-items:flex-start; gap:12px; }
    .epc-scp-guide-module__head h4 { margin:0 0 4px; font-size:.98rem; }
    .epc-scp-guide-module__head p { margin:0; font-size:12.5px; color:#475569; line-height:1.5; }
    .epc-scp-guide-module__icon { width:38px; height:38px; flex:0 0 38px; display:inline-flex; align-items:center; justify-content:center; border-radius:10px; background:#ecfdf5; color:#0f766e; }
    .epc-scp-guide-module__steps { margin:0; padding-left:20px; font-size:12.5px; color:#334155; line-height:1.55; }
    .epc-scp-guide-flow { display:flex; flex-wrap:wrap; gap:8px; }
    .epc-scp-guide-flow__step { display:flex; align-items:center; gap:8px; background:#fff; border:1px solid #e2e8f0; border-radius:999px; padding:7px 14px; font-size:12.5px; color:#334155; }
    .epc-scp-guide-flow__step span { width:22px; height:22px; flex:0 0 22px; display:inline-flex; align-items:center; justify-content:center; border-radius:50%; background:#0f766e; color:#fff; font-size:11px; font-weight:700; }
</style>
</HeadContent>

<PhpCpDesktopChrome IsAdmin="_isAdmin">
@if (!_allowed)
{
    <div class="col-lg-12"><div class="alert alert-warning" role="status">This module is available on ECOM AE Super CP only.</div></div>
}
else if (!_isAdmin)
{
    <div class="col-lg-12"><div class="alert alert-warning" role="status">Please <a href="/cp/">log in to Super CP</a>.</div></div>
}
else
{
    <div class="col-lg-12 epc-scp-panel epc-scp-operator-guide">
        <div class="epc-scp-panel__hero">
            <div>
                <span class="epc-scp-dashboard__badge">Super CP</span>
                <h2 class="epc-scp-dashboard__title">Operator workspace guide</h2>
                <p class="epc-scp-dashboard__sub">Platform operator tools on www.ecomae.com — not for end-customers or tenant shop staff.</p>
            </div>
            <div class="epc-scp-dashboard__hero-actions">
                <a class="btn btn-sm btn-primary" href="@Href(SuperCpOperatorGuideCatalog.CustomerBoardUrl)"><i class="fa fa-users"></i> Customer board</a>
                <a class="btn btn-sm btn-default" href="@Href(SuperCpOperatorGuideCatalog.TenantHubUrl)"><i class="fa fa-cloud"></i> Tenant hub</a>
            </div>
        </div>

        <div class="epc-scp-guide-callout epc-scp-guide-callout--role">
            <h4><i class="fa fa-shield"></i> Who is an &ldquo;Operator&rdquo;?</h4>
            <p>
                <strong>Super CP Operator</strong> means an ECOM AE staff account on the platform host
                (<code>www.ecomae.com/cp</code>) with a session in the <strong>platform registry database</strong> (ecomae),
                not a client company admin on <code>client-domain/cp</code>.
            </p>
            <ul>
                <li>Use Operator tools to run <em>all tenants</em> from one console.</li>
                <li>Do not share Super CP credentials with clients — use Tenant control center for per-tenant operator passwords.</li>
                <li>Platform ERP and Tenant hub cover finance/registry; Operator covers cross-tenant CRM, pricing, CMS, and comms.</li>
            </ul>
        </div>

        <div class="epc-scp-guide-callout epc-scp-guide-callout--tenant">
            <h4><i class="fa fa-store"></i> Tenant CP — no Operator sidebar group</h4>
            <p>
                The <strong>Operator</strong> menu group is registered only on <strong>Super CP</strong>
                (<code>epc_cp_super_cp_operator_menu_apply</code>). Client tenant control panels do not show it.
            </p>
            <p class="epc-scp-guide-callout__equiv">
                <strong>Tenant equivalent:</strong> day-to-day shop work lives under <em>Shop</em> (orders, catalogue, prices, clients).
                Store admins manage their own customers in <strong>Shop → Clients &amp; CRM</strong> and storefront content in theme/settings —
                not via Super CP Operator modules.
            </p>
        </div>

        <h3 class="epc-scp-section-title"><i class="fa fa-th-large"></i> Modules</h3>
        <div class="epc-scp-guide-modules">
            @foreach (var mod in SuperCpOperatorGuideCatalog.Modules)
            {
                <div class="epc-scp-guide-module">
                    <div class="epc-scp-guide-module__head">
                        <span class="epc-scp-guide-module__icon"><i class="fa @mod.Icon"></i></span>
                        <div>
                            <h4>@mod.Title</h4>
                            <p>@mod.Summary</p>
                        </div>
                        <a class="btn btn-sm btn-primary" href="@Href(mod.Url)">Open</a>
                    </div>
                    <p class="text-muted small" style="margin:8px 0 6px"><strong>Who should use it:</strong> @mod.Who</p>
                    <ol class="epc-scp-guide-module__steps">
                        @foreach (var step in mod.Workflow)
                        {
                            <li>@step</li>
                        }
                    </ol>
                </div>
            }
        </div>

        <h3 class="epc-scp-section-title"><i class="fa fa-random"></i> Typical operator day</h3>
        <div class="epc-scp-guide-flow">
            @for (var i = 0; i < SuperCpOperatorGuideCatalog.OperatorDay.Count; i++)
            {
                <div class="epc-scp-guide-flow__step">
                    <span>@((i + 1).ToString(CultureInfo.InvariantCulture))</span> @SuperCpOperatorGuideCatalog.OperatorDay[i]
                </div>
            }
        </div>

        <div class="alert alert-info" style="margin-top:18px">
            <strong>Menu location:</strong> Sidebar group <em>Operator</em> (below Tenant hub on Super CP).
            Re-run <code>epc-super-cp-abcp-setup.php?apply=1</code> after deploy if a module link returns 404.
        </div>
    </div>
}
</PhpCpDesktopChrome>

@code {
    private bool _isAdmin;
    private bool _allowed;

    private static string Href(string value) => PhpSurfaceLinkMap.AspNetPrimaryHref(value);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
    }
}
