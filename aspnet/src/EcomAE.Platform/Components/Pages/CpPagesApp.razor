@page "/cp/pages-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Pages · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
@foreach (var href in LegacyPresentationAssets.CpUsersConsoleStylesheets)
{
    <link rel="stylesheet" href="@href" />
}

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <PhpParityModuleBody AppPath="/cp/pages-app" IsAdmin="_isAdmin" />


    <PhpCpModulePageHeader Title="Content Pages"
                           Subtitle="Publish and main-page flags write here. Body/HTML editor stays on the classic twin.">
        <a class="ghost" href="/cp/menus-app">Menus</a>
        <a class="ghost" href="/cp/modules-app">Modules</a>
        <a class="ghost" href="/cp/page-builder-app">Page builder</a>
    </PhpCpModulePageHeader>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/content/published" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/pages-app" />
            <label>Page id <input type="number" name="contentId" min="1" required style="width:6rem" /></label>
            <label>Published
                <select name="publishedFlag">
                    <option value="1">Yes</option>
                    <option value="0">No</option>
                </select>
            </label>
            <button type="submit">Set published</button>
        </form>
        <form method="post" action="/cp/content/main" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/pages-app" />
            <input type="hidden" name="isFrontend" value="1" />
            <label>Page id <input type="number" name="contentId" min="1" required style="width:6rem" /></label>
            <button type="submit">Set as main page</button>
        </form>
    }

    @if (!_isAdmin)
    {
        <div class="alert alert-info" role="status">Sign in with a Control Panel admin session to load live pages.</div>
    }
    else if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-warning" role="status">@_message <span class="text-muted small">(@_source)</span></div>
    }

    <div class="epc-scp-kpi" aria-label="Pages KPIs">
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Shown (limit @_limit)</div>
            <div class="epc-scp-kpi__val">@_pages.Count</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Published in page</div>
            <div class="epc-scp-kpi__val">@_published</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Frontend pages</div>
            <div class="epc-scp-kpi__val">@_frontend</div>
        </div>
    </div>

    <div class="epc-scp-users-workspace @(_selectedId > 0 ? "is-detail-active" : null)">
        <div class="epc-scp-users-workspace__list">
            <div class="epc-scp-table-card">
                <div class="epc-scp-table-card__head">
                    <div>
                        <h3>Content pages</h3>
                        <p class="epc-users-hint">Open a row for field preview — TinyMCE body edits stay on PHP</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="epc-scp-data-table table table-epc-pro table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Caption</th>
                                <th>Alias</th>
                                <th>URL</th>
                                <th>Level</th>
                                <th>Order</th>
                                <th>Published</th>
                                <th>Frontend</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_pages.Count == 0)
                            {
                                <tr><td colspan="9">No records yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var p in _pages)
                                {
                                    <tr class="@(_selectedId == p.Id ? "active" : null)">
                                        <td><strong>@p.Id</strong></td>
                                        <td>@(string.IsNullOrWhiteSpace(p.Caption) ? "—" : p.Caption)</td>
                                        <td>@(string.IsNullOrWhiteSpace(p.Alias) ? "—" : p.Alias)</td>
                                        <td>@(string.IsNullOrWhiteSpace(p.Url) ? "—" : p.Url)</td>
                                        <td>@p.Level</td>
                                        <td>@p.SortOrder</td>
                                        <td>
                                            @if (p.Published)
                                            {
                                                <span class="epc-scp-badge epc-scp-badge--ok">yes</span>
                                            }
                                            else
                                            {
                                                <span class="epc-scp-badge epc-scp-badge--off">no</span>
                                            }
                                        </td>
                                        <td><span class="epc-scp-badge">@(p.IsFrontend ? "yes" : "no")</span></td>
                                        <td class="epc-scp-actions-cell">
                                            <a href="/cp/pages-app?content_id=@p.Id.ToString(CultureInfo.InvariantCulture)">Open</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (_selected is not null)
        {
            <div class="epc-scp-users-workspace__detail">
                <div class="epc-scp-table-card">
                    <div class="epc-scp-table-card__head">
                        <div>
                            <h3>@_selected.Caption</h3>
                            <p class="epc-users-hint">Page field preview (body omitted from digest)</p>
                        </div>
                        <a class="btn btn-default btn-xs" href="/cp/pages-app">Close</a>
                    </div>
                    <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                        <dt>ID</dt><dd>@_selected.Id.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Alias</dt><dd><code>@(_selected.Alias is { Length: > 0 } ? _selected.Alias : "—")</code></dd>
                        <dt>URL</dt><dd>@(_selected.Url is { Length: > 0 } ? _selected.Url : "—")</dd>
                        <dt>Level / order</dt><dd>@_selected.Level / @_selected.SortOrder</dd>
                        <dt>Published</dt><dd>@(_selected.Published ? "yes" : "no")</dd>
                        <dt>Frontend</dt><dd>@(_selected.IsFrontend ? "yes" : "no")</dd>
                    </dl>
                    <p style="margin:.85rem 0 0;font-size:.86rem;">
                        Body HTML is intentionally omitted from digests.
                    </p>
                </div>
            </div>
        }
    </div>
</PhpCpDesktopChrome>

@code {
    private bool _isAdmin;
    private int _selectedId;
    private IReadOnlyList<CpPageDigest> _pages = [];
    private CpPageDigest? _selected;
    private int _published;
    private int _frontend;
    private int _limit = 200;
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("content_id", out var idRaw)
            && int.TryParse(idRaw.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var id))
        {
            _selectedId = id;
        }

        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.ListCpPagesAsync(_limit, ctx.RequestAborted);
        _pages = result.Pages;
        _published = _pages.Count(p => p.Published);
        _frontend = _pages.Count(p => p.IsFrontend);
        _source = result.Source;
        _message = result.Message;
        if (_selectedId > 0)
        {
            _selected = _pages.FirstOrDefault(p => p.Id == _selectedId);
        }
    }
}
