@page "/cp/pages-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Pages · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
@foreach (var href in LegacyPresentationAssets.CpUsersConsoleStylesheets)
{
    <link rel="stylesheet" href="@href" />
}

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/pages-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_selectedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />


    <PhpCpModulePageHeader Title="Content Pages"
                           Subtitle="Publish, main-page, body, page create/edit, and tree save write here. TinyMCE image upload stays on the Classic twin.">
        <a class="ghost" href="/cp/menus-app">Menus</a>
        <a class="ghost" href="/cp/modules-app">Modules</a>
        <a class="ghost" href="/cp/page-builder-app">Page builder</a>
    </PhpCpModulePageHeader>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/content/published" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(_selectedId > 0 ? _listHref + "?content_id=" + _selectedId.ToString(CultureInfo.InvariantCulture) : _listHref)" />
            <label>Page id <input type="number" name="contentId" min="1" required style="width:6rem" value="@(_selectedId > 0 ? _selectedId.ToString(CultureInfo.InvariantCulture) : "")" /></label>
            <label>Published
                <select name="publishedFlag">
                    <option value="1">Yes</option>
                    <option value="0">No</option>
                </select>
            </label>
            <button type="submit">Set published</button>
        </form>
        <form method="post" action="/cp/content/main" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(_selectedId > 0 ? _listHref + "?content_id=" + _selectedId.ToString(CultureInfo.InvariantCulture) : _listHref)" />
            <input type="hidden" name="isFrontend" value="1" />
            <label>Page id <input type="number" name="contentId" min="1" required style="width:6rem" value="@(_selectedId > 0 ? _selectedId.ToString(CultureInfo.InvariantCulture) : "")" /></label>
            <button type="submit">Set as main page</button>
        </form>
        <form method="post" action="/cp/content/body" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(_selectedId > 0 ? _listHref + "?content_id=" + _selectedId.ToString(CultureInfo.InvariantCulture) : _listHref)" />
            <input type="hidden" name="langCode" value="en" />
            <div style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <label>Page id <input type="number" name="contentId" min="1" required style="width:6rem" value="@(_selectedId > 0 ? _selectedId.ToString(CultureInfo.InvariantCulture) : "")" /></label>
                <label>Type
                    <select name="contentType">
                        <option value="text">text</option>
                        <option value="php">php</option>
                    </select>
                </label>
                <label>Lang string id <input type="text" name="contentLangStrId" placeholder="0 = allocate" style="width:12rem" /></label>
            </div>
            <label>Body
                <textarea name="content" rows="8" style="width:100%;font-family:monospace" placeholder="HTML for type=text, or a .php path for type=php"></textarea>
            </label>
            <button type="submit">Save body</button>
        </form>
        <form method="post" action="/cp/content/save" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(_selectedId > 0 ? _listHref + "?content_id=" + _selectedId.ToString(CultureInfo.InvariantCulture) : _listHref)" />
            <input type="hidden" name="langCode" value="en" />
            <div style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <label>Page id <input type="number" name="contentId" min="0" value="0" style="width:6rem" title="0 = create" /></label>
                <label>Alias <input type="text" name="alias" required maxlength="190" /></label>
                <label>Caption <input type="text" name="value" /></label>
                <label>Parent id <input type="number" name="parent" min="0" value="0" style="width:6rem" /></label>
                <label>Type
                    <select name="contentType">
                        <option value="text">text</option>
                        <option value="php">php</option>
                    </select>
                </label>
                <label>Published
                    <select name="publishedFlag">
                        <option value="1">Yes</option>
                        <option value="0">No</option>
                    </select>
                </label>
                <label>Frontend
                    <select name="isFrontend">
                        <option value="1">Yes</option>
                        <option value="0">No</option>
                    </select>
                </label>
            </div>
            <label>Body
                <textarea name="content" rows="4" style="width:100%;font-family:monospace" placeholder="HTML for type=text, or a .php path for type=php"></textarea>
            </label>
            <div style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <label>Title tag <input type="text" name="titleTag" /></label>
                <label>Description <input type="text" name="description" /></label>
                <label>Keywords <input type="text" name="keywordsTag" /></label>
                <label>Groups <input type="text" name="groupsAccess" placeholder="[]" /></label>
            </div>
            <button type="submit">Save page</button>
        </form>
        <form method="post" action="/cp/content/tree" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(_selectedId > 0 ? _listHref + "?content_id=" + _selectedId.ToString(CultureInfo.InvariantCulture) : _listHref)" />
            <input type="hidden" name="langCode" value="en" />
            <input type="hidden" name="isFrontend" value="1" />
            <label>Tree JSON
                <textarea name="treeJson" rows="6" style="width:100%;font-family:monospace" placeholder="Webix content tree. Include every non-system page you want to keep."></textarea>
            </label>
            <button type="submit">Save tree</button>
        </form>
    }

    @if (!_isAdmin)
    {
        <div class="alert alert-info" role="status">Sign in with a Control Panel admin session to load live pages.</div>
    }
    else if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-warning" role="status">@_message <span class="text-muted small">(@_source)</span></div>
    }

    <div class="epc-scp-kpi" aria-label="Pages KPIs">
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Shown (limit @_limit)</div>
            <div class="epc-scp-kpi__val">@_pages.Count</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Published in page</div>
            <div class="epc-scp-kpi__val">@_published</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Frontend pages</div>
            <div class="epc-scp-kpi__val">@_frontend</div>
        </div>
    </div>

    <div class="epc-scp-users-workspace @(_selectedId > 0 ? "is-detail-active" : null)">
        <div class="epc-scp-users-workspace__list">
            <div class="epc-scp-table-card">
                <div class="epc-scp-table-card__head">
                    <div>
                        <h3>Content pages</h3>
                        <p class="epc-users-hint">Open a row for field preview. Save body writes here; TinyMCE image upload stays Classic.</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="epc-scp-data-table table table-epc-pro table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Caption</th>
                                <th>Alias</th>
                                <th>URL</th>
                                <th>Level</th>
                                <th>Order</th>
                                <th>Published</th>
                                <th>Frontend</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_pages.Count == 0)
                            {
                                <tr><td colspan="9">No records yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var p in _pages)
                                {
                                    <tr id="erp-row-@p.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(p.Id, _selectedId)">
                                        <td><strong>@p.Id</strong></td>
                                        <td>@(string.IsNullOrWhiteSpace(p.Caption) ? "—" : p.Caption)</td>
                                        <td>@(string.IsNullOrWhiteSpace(p.Alias) ? "—" : p.Alias)</td>
                                        <td>@(string.IsNullOrWhiteSpace(p.Url) ? "—" : p.Url)</td>
                                        <td>@p.Level</td>
                                        <td>@p.SortOrder</td>
                                        <td>
                                            @if (p.Published)
                                            {
                                                <span class="epc-scp-badge epc-scp-badge--ok">yes</span>
                                            }
                                            else
                                            {
                                                <span class="epc-scp-badge epc-scp-badge--off">no</span>
                                            }
                                        </td>
                                        <td><span class="epc-scp-badge">@(p.IsFrontend ? "yes" : "no")</span></td>
                                        <td class="epc-scp-actions-cell">
                                            <a href="@ErpRecordOpen.Href(_listHref, "content_id", p.Id)">Open</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (_selected is not null || _opened is not null)
        {
            <div class="epc-scp-users-workspace__detail">
                <div class="epc-scp-table-card">
                    <div class="epc-scp-table-card__head">
                        <div>
                            <h3>@OpenedCaption</h3>
                            <p class="epc-users-hint">Page field preview. Full body HTML stays on the Classic twin.</p>
                        </div>
                        <a class="btn btn-default btn-xs" href="@_listHref">Close</a>
                    </div>
                    <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                        <dt>ID</dt><dd>@(_opened?.Id ?? _selected?.Id ?? 0).ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Alias</dt><dd><code>@(!string.IsNullOrWhiteSpace(_opened?.Alias) ? _opened!.Alias : (!string.IsNullOrWhiteSpace(_selected?.Alias) ? _selected!.Alias : "—"))</code></dd>
                        <dt>URL</dt><dd>@(!string.IsNullOrWhiteSpace(_opened?.Url) ? _opened!.Url : (!string.IsNullOrWhiteSpace(_selected?.Url) ? _selected!.Url : "—"))</dd>
                        <dt>Level / order</dt><dd>@(_opened?.Level ?? _selected?.Level ?? 0) / @(_opened?.SortOrder ?? _selected?.SortOrder ?? 0)</dd>
                        <dt>Published</dt><dd>@((_opened?.Published ?? _selected?.Published ?? false) ? "yes" : "no")</dd>
                        <dt>Frontend</dt><dd>@((_opened?.IsFrontend ?? _selected?.IsFrontend ?? false) ? "yes" : "no")</dd>
                        <dt>Type</dt><dd>@(!string.IsNullOrWhiteSpace(_opened?.ContentType) ? _opened!.ContentType : "—")</dd>
                    </dl>
                    @if (_opened is not null && !string.IsNullOrWhiteSpace(_opened.BodyExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:.85rem 0 0">@_opened.BodyExcerpt</pre>
                        @if (_opened.BodyLen > _opened.BodyExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_opened.BodyExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.BodyLen.ToString(CultureInfo.InvariantCulture) chars). Full body HTML stays on the Classic twin.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted" style="margin:.85rem 0 0">No body excerpt yet.</p>
                    }
                    @if (_openedSiblings.Count > 0)
                    {
                        <p class="epc-users-hint" style="margin:1rem 0 .4rem">Same-parent siblings</p>
                        <table class="table table-condensed table-striped table-epc">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Caption</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sib in _openedSiblings)
                                {
                                    <tr>
                                        <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@(string.IsNullOrWhiteSpace(sib.Caption) ? "—" : sib.Caption)</td>
                                        <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "content_id", sib.Id)">Open</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (_opened is not null)
                    {
                        <p class="text-muted">No same-parent siblings yet.</p>
                    }
                </div>
            </div>
        }
    </div>
</PhpCpDesktopChrome>

@code {
    private bool _isAdmin;
    private long _selectedId;
    private IReadOnlyList<CpPageDigest> _pages = [];
    private CpPageDigest? _selected;
    private CpPageDetail? _opened;
    private IReadOnlyList<CpPageDigest> _openedSiblings = [];
    private int _published;
    private int _frontend;
    private int _limit = 200;
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private string _listHref = "/cp/pages-app";

    private string OpenedCaption =>
        !string.IsNullOrWhiteSpace(_opened?.Caption)
            ? _opened.Caption
            : (!string.IsNullOrWhiteSpace(_selected?.Caption)
                ? _selected.Caption
                : (_selectedId > 0 ? ("Page #" + _selectedId.ToString(CultureInfo.InvariantCulture)) : ""));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _selectedId = ErpRecordOpen.ReadId(ctx.Request, "content_id");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);

        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.ListCpPagesAsync(_limit, ctx.RequestAborted);
        _pages = result.Pages;
        _published = _pages.Count(p => p.Published);
        _frontend = _pages.Count(p => p.IsFrontend);
        _source = result.Source;
        _message = result.Message;
        if (_selectedId > 0)
        {
            _selected = _pages.FirstOrDefault(p => p.Id == _selectedId);
            var detail = await Dashboards.BuildCpPagesDetailAsync(_selectedId, ctx.RequestAborted);
            _opened = detail.Page;
            _openedSiblings = detail.Siblings;
            if (_selected is not null)
            {
                _pages = new[] { _selected }.Concat(_pages.Where(p => p.Id != _selectedId)).ToList();
            }
        }
    }
}
