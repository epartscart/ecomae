@page "/cp/pages-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@inject ICpContentEditorService Content
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Content pages · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<style>
    .epc-content-actions .panel_a { display:inline-block; text-align:center; text-decoration:none; color:#333; margin-right:14px; vertical-align:top; cursor:pointer; }
    .epc-content-actions .panel_a_img { width:48px; height:48px; margin:0 auto 4px; border-radius:8px; background:#f1f3f6; display:flex; align-items:center; justify-content:center; font-size:22px; color:#3498db; }
    .epc-content-actions .panel_a_caption { font-size:12px; }
    .epc-content-actions .panel_a.epc-mode-on .panel_a_img { background:#dbeeff; }
    .table-epc td a { color:inherit; display:block; }
    .table-epc tr.epc-main td { background-color:#62cb31 !important; color:#fff; }
    .table-epc tr.epc-unpublished td a { font-weight:bold; color:#ccc; }
    .table-epc tr.epc-main td a { font-weight:bold; color:#fff; }
    .epc-sorter.epc-asc:after { content:" \25B2"; font-size:9px; }
    .epc-sorter.epc-desc:after { content:" \25BC"; font-size:9px; }
    .epc-content-editor .form-group { margin-bottom:8px; overflow:hidden; }
    .epc-content-editor .form-group label.control-label { text-align:right; }
    #content_tree { min-height:360px; border:1px solid #e4e5e7; background:#fff; padding:6px; }
    #content_tree ul { list-style:none; margin:0; padding-left:18px; }
    #content_tree > ul { padding-left:4px; }
    #content_tree li > .epc-tree-row { display:flex; align-items:center; gap:6px; padding:3px 6px; cursor:pointer; border-radius:3px; }
    #content_tree li > .epc-tree-row:hover { background:#f5f7fa; }
    #content_tree li.epc-sel > .epc-tree-row { background:#dbeeff; }
    #content_tree li.epc-closed > ul { display:none; }
    #content_tree .epc-tree-tog { width:14px; color:#888; font-size:11px; text-align:center; }
    #content_tree .epc-tree-val { flex:1; }
    #content_tree .epc-tree-val input { width:100%; border:1px solid #3498db; padding:1px 4px; font:inherit; }
    #content_tree .epc-tree-meta { color:#999; font-size:11px; }
    #content_tree .epc-tree-sys { color:#999; }
</style>

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    @if (!_isAdmin)
    {
        <div class="col-lg-12"><div class="hpanel"><div class="panel-body">
            <div class="alert alert-warning" role="status">Sign in to the Control Panel to manage content pages. <a href="/cp/login?returnUrl=/cp/pages-app">Login</a></div>
        </div></div></div>
    }
    else if (_tree is not null)
    {
        @* ---- content_tree.php twin ---- *@
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Content tree (@(_isFrontend ? "site" : "Control Panel"))
                    <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTreeTab)">Classic twin</a>
                </div>
                <div class="panel-body epc-content-actions">
                    <a class="panel_a" href="javascript:void(0);" onclick="tree_add();"><div class="panel_a_img"><i class="fa fa-plus"></i></div><div class="panel_a_caption">Add page</div></a>
                    <a class="panel_a" href="javascript:void(0);" onclick="tree_add_child();"><div class="panel_a_img"><i class="fa fa-level-down"></i></div><div class="panel_a_caption">Add child</div></a>
                    <a class="panel_a" href="javascript:void(0);" onclick="tree_remove();"><div class="panel_a_img"><i class="fa fa-trash-o"></i></div><div class="panel_a_caption">Remove</div></a>
                    <a class="panel_a" href="javascript:void(0);" onclick="tree_move(-1);"><div class="panel_a_img"><i class="fa fa-arrow-up"></i></div><div class="panel_a_caption">Up</div></a>
                    <a class="panel_a" href="javascript:void(0);" onclick="tree_move(1);"><div class="panel_a_img"><i class="fa fa-arrow-down"></i></div><div class="panel_a_caption">Down</div></a>
                    <a class="panel_a" href="javascript:void(0);" onclick="tree_save();"><div class="panel_a_img"><i class="fa fa-save"></i></div><div class="panel_a_caption">Save tree</div></a>
                    <a class="panel_a" href="@ModeHref(_isFrontend)"><div class="panel_a_img"><i class="fa fa-list"></i></div><div class="panel_a_caption">Content manager</div></a>
                    <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div> }
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Pages (@_tree.Count.ToString(CultureInfo.InvariantCulture)) — double-click a caption to rename; system pages (<i class="fa fa-cog"></i>) cannot be removed</div>
                <div class="panel-body">
                    <div id="content_tree"></div>
                </div>
            </div>
        </div>
        <form name="tree_form" id="tree_form" method="post" action="/cp/content/tree" style="display:none">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@TreeHref(_isFrontend)" />
            <input type="hidden" name="tree" id="tree" value="" />
            <input type="hidden" name="is_frontend" value="@(_isFrontend ? "1" : "0")" />
        </form>
        <script>
            var epcTree = @((MarkupString)_tree.TreeJson);
            var epcSel = null;
            function tree_render() {
                var root = document.getElementById('content_tree');
                root.innerHTML = '';
                root.appendChild(tree_ul(epcTree));
            }
            function tree_ul(nodes) {
                var ul = document.createElement('ul');
                nodes.forEach(function (n) {
                    var li = document.createElement('li');
                    li.epcNode = n;
                    if (!n.open) li.className = 'epc-closed';
                    if (epcSel === n) li.className += ' epc-sel';
                    var row = document.createElement('div');
                    row.className = 'epc-tree-row';
                    var tog = document.createElement('span');
                    tog.className = 'epc-tree-tog';
                    tog.textContent = (n.data && n.data.length) ? (n.open ? '\u25BE' : '\u25B8') : '';
                    tog.onclick = function (e) { e.stopPropagation(); n.open = !n.open; tree_render(); };
                    var val = document.createElement('span');
                    val.className = 'epc-tree-val';
                    val.textContent = n.value || '(untitled)';
                    val.ondblclick = function (e) { e.stopPropagation(); tree_rename(n, val); };
                    var meta = document.createElement('span');
                    meta.className = 'epc-tree-meta';
                    meta.textContent = (n.id > 0 ? '#' + n.id + ' ' : 'new ') + (n.url || '');
                    row.appendChild(tog); row.appendChild(val); row.appendChild(meta);
                    if (n.system_flag == 1) { var s = document.createElement('i'); s.className = 'fa fa-cog epc-tree-sys'; row.appendChild(s); }
                    row.onclick = function () { epcSel = n; tree_render(); };
                    li.appendChild(row);
                    if (n.data && n.data.length) li.appendChild(tree_ul(n.data));
                    ul.appendChild(li);
                });
                return ul;
            }
            function tree_rename(n, span) {
                var inp = document.createElement('input');
                inp.type = 'text'; inp.value = n.value || '';
                span.textContent = ''; span.appendChild(inp); inp.focus();
                function done() {
                    n.value = inp.value.trim();
                    if (!n.alias || n.id <= 0) n.alias = tree_alias(n.value);
                    tree_render();
                }
                inp.onblur = done;
                inp.onkeydown = function (e) { if (e.key === 'Enter') { done(); } if (e.key === 'Escape') { tree_render(); } };
            }
            function tree_alias(v) {
                return (v || '').toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
            }
            function tree_find(nodes, target) {
                for (var i = 0; i < nodes.length; i++) {
                    if (nodes[i] === target) return { list: nodes, index: i };
                    var r = tree_find(nodes[i].data || [], target);
                    if (r) return r;
                }
                return null;
            }
            function tree_new(level, parent) {
                var v = prompt('Page caption (H1):', '');
                if (v === null || v.trim() === '') return null;
                return { id: 0, "$count": 0, url: '', "$level": level, alias: tree_alias(v), value: v.trim(), value_lang_str_id: '0', "$parent": parent,
                    description: '', description_lang_str_id: '0', main_flag: 0, title_tag: v.trim(), title_tag_lang_str_id: '0', description_tag: '', description_tag_lang_str_id: '0',
                    keywords_tag: '', keywords_tag_lang_str_id: '0', robots_tag: '', published_flag: 1, open: true, css_js: '', system_flag: 0, order: 0, content_type: 'text', groups_access: [], data: [] };
            }
            function tree_add() {
                var pos = epcSel ? tree_find(epcTree, epcSel) : null;
                var list = pos ? pos.list : epcTree;
                var level = epcSel ? epcSel['$level'] : 1;
                var parent = epcSel ? epcSel['$parent'] : 0;
                var n = tree_new(level, parent);
                if (!n) return;
                list.splice(pos ? pos.index + 1 : list.length, 0, n);
                epcSel = n; tree_render();
            }
            function tree_add_child() {
                if (!epcSel) { alert('Select a parent page first.'); return; }
                var n = tree_new(epcSel['$level'] + 1, epcSel.id);
                if (!n) return;
                epcSel.data = epcSel.data || [];
                epcSel.data.push(n);
                epcSel.open = true; epcSel = n; tree_render();
            }
            function tree_remove() {
                if (!epcSel) { alert('Select a page first.'); return; }
                if (epcSel.system_flag == 1) { alert('System pages cannot be removed.'); return; }
                if (epcSel.main_flag == 1) { alert('The main page cannot be removed.'); return; }
                if (!confirm('Remove "' + (epcSel.value || '') + '" and all its child pages from the tree?')) return;
                var pos = tree_find(epcTree, epcSel);
                if (pos) pos.list.splice(pos.index, 1);
                epcSel = null; tree_render();
            }
            function tree_move(dir) {
                if (!epcSel) return;
                var pos = tree_find(epcTree, epcSel);
                if (!pos) return;
                var j = pos.index + dir;
                if (j < 0 || j >= pos.list.length) return;
                pos.list.splice(pos.index, 1);
                pos.list.splice(j, 0, epcSel);
                tree_render();
            }
            function tree_walk(nodes, level, parent) {
                nodes.forEach(function (n, i) {
                    n['$level'] = level; n['$parent'] = parent; n.order = i; n['$count'] = (n.data || []).length;
                    tree_walk(n.data || [], level + 1, n.id);
                });
            }
            function tree_save() {
                tree_walk(epcTree, 1, 0);
                if (!confirm('Save the content tree? Pages removed from the tree are deleted.')) return;
                document.getElementById('tree').value = JSON.stringify(epcTree);
                document.getElementById('tree_form').submit();
            }
            tree_render();
        </script>
    }
    else if (_editor is not null)
    {
        @* ---- content_create_edit.php twin ---- *@
        var e = _editor;
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(e.Id > 0 ? "Edit content page #" + e.Id.ToString(CultureInfo.InvariantCulture) : "Create content page")
                    <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpEditTab + (e.Id > 0 ? "?content_id=" + e.Id.ToString(CultureInfo.InvariantCulture) : ""))">Classic twin</a>
                </div>
                <div class="panel-body epc-content-actions">
                    <a class="panel_a" href="javascript:void(0);" onclick="save_action();"><div class="panel_a_img"><i class="fa fa-save"></i></div><div class="panel_a_caption">Save</div></a>
                    @if (e.Id > 0)
                    {
                        <a class="panel_a" href="javascript:void(0);" onclick="save_content();"><div class="panel_a_img"><i class="fa fa-file-text-o"></i></div><div class="panel_a_caption">Save content only</div></a>
                        <a class="panel_a" href="@EditorHref(0)"><div class="panel_a_img"><i class="fa fa-plus"></i></div><div class="panel_a_caption">Create new</div></a>
                        @if (!string.IsNullOrWhiteSpace(e.Url) && e.IsFrontend)
                        {
                            <a class="panel_a" href="/@e.Url.TrimStart('/')" target="_blank"><div class="panel_a_img"><i class="fa fa-external-link"></i></div><div class="panel_a_caption">Open on site</div></a>
                        }
                    }
                    <a class="panel_a" href="@ModeHref(e.IsFrontend)"><div class="panel_a_img"><i class="fa fa-list"></i></div><div class="panel_a_caption">Content manager</div></a>
                    <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div> }
        @if (e.System) { <div class="col-lg-12"><div class="alert alert-info" role="status"><i class="fa fa-cog"></i> System page: alias, parent and publish state are locked; metadata and body can be edited.</div></div> }

        <form id="save_form" method="post" action="/cp/content/save" class="form-horizontal epc-content-editor">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(e.Id > 0 ? EditorHref(e.Id) : ModeHref(e.IsFrontend))" />
            <input type="hidden" name="action" value="save_action" />
            <input type="hidden" name="content_id" value="@e.Id.ToString(CultureInfo.InvariantCulture)" />
            <input type="hidden" name="is_frontend" value="@(e.IsFrontend ? "1" : "0")" />
            <input type="hidden" name="value_lang_str_id" value="@e.ValueLangStrId" />
            <input type="hidden" name="title_tag_lang_str_id" value="@e.TitleLangStrId" />
            <input type="hidden" name="description_tag_lang_str_id" value="@e.DescriptionTagLangStrId" />
            <input type="hidden" name="keywords_tag_lang_str_id" value="@e.KeywordsLangStrId" />
            <input type="hidden" name="author_tag_lang_str_id" value="@e.AuthorLangStrId" />
            <input type="hidden" name="description_lang_str_id" value="@e.DescriptionLangStrId" />
            <input type="hidden" name="content_lang_str_id" value="@e.ContentLangStrId" />
            <input type="hidden" name="groups_access" id="groups_access" value="" />
            <input type="hidden" name="main_flag" id="main_flag" value="@(e.Main ? "1" : "0")" />
            <input type="hidden" name="published_flag" id="published_flag" value="@(e.Published ? "1" : "0")" />
            <input type="hidden" name="parent" id="parent_input" value="@e.Parent.ToString(CultureInfo.InvariantCulture)" />

            <div class="col-lg-6">
                <div class="hpanel">
                    <div class="panel-heading hbuilt">Page metadata</div>
                    <div class="panel-body">
                        <div class="form-group">
                            <label class="col-lg-6 control-label">H1 *</label>
                            <div class="col-lg-6"><input type="text" name="value" id="value_input" value="@e.Value" onkeyup="on_h1_changed();" class="form-control" /></div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-6 control-label">Auto-transliterate alias</label>
                            <div class="col-lg-6"><input type="checkbox" id="alias_autotranslit" class="form-control" checked="@(e.Id <= 0)" /></div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-6 control-label">Alias *</label>
                            <div class="col-lg-6"><input type="text" name="alias" id="alias_input" value="@e.Alias" class="form-control" readonly="@e.System" /></div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-6 control-label">Title tag</label>
                            <div class="col-lg-6"><input type="text" name="title_tag" id="title_tag_input" value="@e.TitleTag" class="form-control" /></div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-6 control-label">Description tag</label>
                            <div class="col-lg-6"><textarea name="description_tag" id="description_tag_input" class="form-control">@e.DescriptionTag</textarea></div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-6 control-label">Keywords tag</label>
                            <div class="col-lg-6"><textarea name="keywords_tag" id="keywords_tag_input" class="form-control">@e.KeywordsTag</textarea></div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-6 control-label">Robots tag</label>
                            <div class="col-lg-6"><input type="text" name="robots_tag" id="robots_tag_input" value="@e.RobotsTag" class="form-control" /></div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-6 control-label">Author tag</label>
                            <div class="col-lg-6"><input type="text" name="author_tag" id="author_tag_input" value="@e.AuthorTag" class="form-control" /></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hpanel">
                    <div class="panel-heading hbuilt">Page parameters</div>
                    <div class="panel-body">
                        <div class="form-group">
                            <label class="col-lg-6 control-label">Address (URL)</label>
                            <div class="col-lg-6"><p class="form-control-static">@(string.IsNullOrWhiteSpace(e.Url) ? "—" : "/" + e.Url.TrimStart('/'))</p></div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-6 control-label">Description</label>
                            <div class="col-lg-6"><textarea name="description" id="description_input" class="form-control">@e.Description</textarea></div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-6 control-label">CSS / JS</label>
                            <div class="col-lg-6"><textarea name="css_js" id="css_js_input" class="form-control">@e.CssJs</textarea></div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-6 control-label">Content type</label>
                            <div class="col-lg-6">
                                <select name="content_type" id="content_type_select" onchange="content_type_changed();" class="form-control">
                                    <option value="text" selected="@(e.ContentType != "php")">TEXT</option>
                                    <option value="php" selected="@(e.ContentType == "php")">PHP</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-6 control-label">Main page</label>
                            <div class="col-lg-6"><input type="checkbox" id="main_flag_input" class="form-control" onchange="flag_changed();" checked="@e.Main" /></div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-6 control-label">Published</label>
                            <div class="col-lg-6"><input type="checkbox" id="published_flag_input" class="form-control" onchange="flag_changed();" checked="@e.Published" disabled="@(e.System || e.Main)" /></div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-6 control-label">Access groups (none = everyone)</label>
                            <div class="col-lg-6">
                                <select multiple="multiple" id="groups_selector" class="form-control" size="6" onchange="groups_changed();">
                                    @foreach (var g in e.Groups)
                                    {
                                        <option value="@g.Id.ToString(CultureInfo.InvariantCulture)" selected="@e.GroupsAccess.Contains(g.Id)">@(new string('\u00A0', Math.Max(0, g.Level - 1) * 3))@g.Caption</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-6 control-label">Parent page</label>
                            <div class="col-lg-6">
                                <select id="parent_select" class="form-control" onchange="document.getElementById('parent_input').value=this.value;" disabled="@e.System">
                                    <option value="0" selected="@(e.Parent == 0)">0 — Root</option>
                                    @foreach (var p in e.Parents.Where(p => p.Id != e.Id))
                                    {
                                        <option value="@p.Id.ToString(CultureInfo.InvariantCulture)" selected="@(e.Parent == p.Id)">@(new string('\u00A0', Math.Max(0, p.Level - 1) * 3))@p.Id.ToString(CultureInfo.InvariantCulture) — @p.Caption</option>
                                    }
                                </select>
                                <span class="bold" id="parent_indicator" style="display:none">@e.ParentCaption</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-12">
                <div class="hpanel">
                    <div class="panel-heading hbuilt">Page content</div>
                    <div class="panel-body">
                        <div id="content_value_area">
                            <div class="form-group" id="content_text_group">
                                <label class="col-lg-12" style="text-align:left">HTML body (TinyMCE image upload stays on the Classic twin)</label>
                                <div class="col-lg-12"><textarea name="content" id="content_input" class="form-control" style="min-height:400px;font-family:monospace">@e.Content</textarea></div>
                            </div>
                            <div class="form-group" id="content_php_group" style="display:none">
                                <label class="col-lg-6 control-label">PHP script path (relative to the site root)</label>
                                <div class="col-lg-6"><input type="text" id="content_php_input" value="@(e.ContentType == "php" ? e.Content : "")" class="form-control" /></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
        <form id="body_form" method="post" action="/cp/content/body" style="display:none">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@EditorHref(e.Id)" />
            <input type="hidden" name="action" value="save_content" />
            <input type="hidden" name="content_id" value="@e.Id.ToString(CultureInfo.InvariantCulture)" />
            <input type="hidden" name="content_lang_str_id" value="@e.ContentLangStrId" />
            <input type="hidden" name="content_type" id="body_content_type" value="" />
            <input type="hidden" name="content" id="body_content" value="" />
        </form>
        <script>
            function translit(s) {
                var map = {'а':'a','б':'b','в':'v','г':'g','д':'d','е':'e','ё':'e','ж':'zh','з':'z','и':'i','й':'y','к':'k','л':'l','м':'m','н':'n','о':'o','п':'p','р':'r','с':'s','т':'t','у':'u','ф':'f','х':'h','ц':'c','ч':'ch','ш':'sh','щ':'sch','ъ':'','ы':'y','ь':'','э':'e','ю':'yu','я':'ya'};
                var out = '';
                s = (s || '').toLowerCase();
                for (var i = 0; i < s.length; i++) { out += (map[s[i]] !== undefined) ? map[s[i]] : s[i]; }
                return out.replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
            }
            function on_h1_changed() {
                if (document.getElementById('alias_autotranslit').checked && !document.getElementById('alias_input').readOnly) {
                    document.getElementById('alias_input').value = translit(document.getElementById('value_input').value);
                }
            }
            function content_type_changed() {
                var php = document.getElementById('content_type_select').value === 'php';
                document.getElementById('content_text_group').style.display = php ? 'none' : '';
                document.getElementById('content_php_group').style.display = php ? '' : 'none';
            }
            function flag_changed() {
                document.getElementById('main_flag').value = document.getElementById('main_flag_input').checked ? '1' : '0';
                var pub = document.getElementById('published_flag_input');
                if (document.getElementById('main_flag_input').checked) { pub.checked = true; }
                document.getElementById('published_flag').value = pub.checked ? '1' : '0';
            }
            function groups_changed() {
                var ids = [];
                document.querySelectorAll('#groups_selector option:checked').forEach(function (o) { ids.push(parseInt(o.value, 10)); });
                document.getElementById('groups_access').value = JSON.stringify(ids);
            }
            function save_action() {
                var v = document.getElementById('value_input').value.trim();
                if (v === '') { alert('H1 is required.'); return; }
                if (document.getElementById('alias_input').value.trim() === '') { alert('Alias is required.'); return; }
                if (document.getElementById('content_type_select').value === 'php') {
                    document.getElementById('content_input').value = document.getElementById('content_php_input').value;
                }
                flag_changed(); groups_changed();
                document.getElementById('save_form').submit();
            }
            function save_content() {
                var php = document.getElementById('content_type_select').value === 'php';
                document.getElementById('body_content_type').value = php ? 'php' : 'text';
                document.getElementById('body_content').value = php ? document.getElementById('content_php_input').value : document.getElementById('content_input').value;
                document.getElementById('body_form').submit();
            }
            content_type_changed(); groups_changed();
        </script>
    }
    else
    {
        @* ---- content_manager.php twin ---- *@
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Content manager
                    <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
                </div>
                <div class="panel-body epc-content-actions">
                    <a class="panel_a" href="@EditorHref(0)"><div class="panel_a_img"><i class="fa fa-plus"></i></div><div class="panel_a_caption">Create page</div></a>
                    <a class="panel_a" href="javascript:void(0);" onclick="set_main_flag();"><div class="panel_a_img"><i class="fa fa-home"></i></div><div class="panel_a_caption">Set as main page</div></a>
                    <a class="panel_a @(_isFrontend ? "" : "epc-mode-on")" href="@ModeHref(false)"><div class="panel_a_img"><i class="fa fa-cogs"></i></div><div class="panel_a_caption">Control Panel pages</div></a>
                    <a class="panel_a @(_isFrontend ? "epc-mode-on" : "")" href="@ModeHref(true)"><div class="panel_a_img"><i class="fa fa-globe"></i></div><div class="panel_a_caption">Site pages</div></a>
                    <a class="panel_a" href="javascript:void(0);" onclick="set_published_flag_action(1);"><div class="panel_a_img"><i class="fa fa-eye"></i></div><div class="panel_a_caption">Publish</div></a>
                    <a class="panel_a" href="javascript:void(0);" onclick="set_published_flag_action(0);"><div class="panel_a_img"><i class="fa fa-eye-slash"></i></div><div class="panel_a_caption">Unpublish</div></a>
                    <a class="panel_a" href="javascript:void(0);" onclick="delete_action();"><div class="panel_a_img"><i class="fa fa-trash-o"></i></div><div class="panel_a_caption">Delete</div></a>
                    <a class="panel_a" href="@TreeHref(_isFrontend)"><div class="panel_a_img"><i class="fa fa-sitemap"></i></div><div class="panel_a_caption">Content tree</div></a>
                    <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div> }
        @if (_notFound) { <div class="col-lg-12"><div class="alert alert-danger" role="status">Content page #@_selectedId.ToString(CultureInfo.InvariantCulture) was not found.</div></div> }

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(_isFrontend ? "Site pages" : "Control Panel pages") (@_list.Total.ToString(CultureInfo.InvariantCulture))
                    <span class="pull-right">
                        @if (_list.Hierarchy)
                        {
                            <a class="btn btn-xs btn-success" href="@ListHref(_isFrontend, false, 1)">Direct list (sort &amp; filter)</a>
                        }
                        else
                        {
                            <a class="btn btn-xs btn-success" href="@ListHref(_isFrontend, true, 1)">Hierarchy</a>
                        }
                    </span>
                </div>
                <div class="panel-body">
                    @if (!_list.Hierarchy)
                    {
                        <form method="get" action="/cp/pages-app" class="form-inline" style="margin-bottom:10px" id="filter_form">
                            <input type="hidden" name="is_frontend" value="@(_isFrontend ? "1" : "0")" />
                            <input type="hidden" name="mode" value="direct_list" />
                            <input type="hidden" name="sort" value="@_list.SortField" />
                            <input type="hidden" name="dir" value="@(_list.SortAsc ? "asc" : "desc")" />
                            <div class="form-group" style="margin-right:8px"><label style="margin-right:4px">ID</label><input type="text" name="f_id" id="id_filter_input" value="@_list.Filter.Id" class="form-control input-sm" style="width:90px" /></div>
                            <div class="form-group" style="margin-right:8px"><label style="margin-right:4px">Page text</label><input type="text" name="f_content" id="content_content_filter_input" value="@_list.Filter.Content" class="form-control input-sm" /></div>
                            <div class="form-group" style="margin-right:8px"><label style="margin-right:4px">Metadata</label><input type="text" name="f_meta" id="meta_data_filter_input" value="@_list.Filter.Meta" class="form-control input-sm" /></div>
                            <button class="btn btn-sm btn-success" type="submit"><i class="fa fa-filter"></i> Filter</button>
                            @if (!_list.Filter.IsEmpty) { <a class="btn btn-sm btn-default" href="@ListHref(_isFrontend, false, 1)">Reset</a> }
                        </form>
                    }
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover table-epc">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th><input type="checkbox" id="check_uncheck_all" name="check_uncheck_all" onchange="on_check_uncheck_all();" /></th>
                                    @if (_list.Hierarchy)
                                    {
                                        <th>ID</th><th>H1</th><th>Title</th><th>Description</th><th>Type</th><th>Parent</th><th>Level</th><th class="text-center">System</th><th>Created</th><th>Edited</th>
                                    }
                                    else
                                    {
                                        <th>@SortLink("id", "ID")</th>
                                        <th>@SortLink("value", "H1")</th>
                                        <th>@SortLink("title_tag", "Title")</th>
                                        <th>@SortLink("description_tag", "Description")</th>
                                        <th>@SortLink("content_type", "Type")</th>
                                        <th>@SortLink("parent", "Parent")</th>
                                        <th>@SortLink("level", "Level")</th>
                                        <th class="text-center">System</th>
                                        <th>@SortLink("time_created", "Created")</th>
                                        <th>@SortLink("time_edited", "Edited")</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (_list.Rows.Count == 0)
                                {
                                    <tr><td colspan="12">No content pages found.</td></tr>
                                }
                                @{ var pp = (_list.Page - 1) * _list.PageSize; }
                                @foreach (var r in _list.Rows)
                                {
                                    pp++;
                                    var id = r.Id.ToString(CultureInfo.InvariantCulture);
                                    var href = ErpRecordOpen.Href(_listHref, "content_id", r.Id) + "&is_frontend=" + (_isFrontend ? "1" : "0");
                                    var cls = (r.Main ? "epc-main " : "") + (!r.Published ? "epc-unpublished " : "") + ErpRecordOpen.RowClass(r.Id, _selectedId);
                                    <tr id="erp-row-@id" class="@cls" title="@(r.Main ? "Main page" : (!r.Published ? "Not published" : ""))">
                                        <td>@pp.ToString(CultureInfo.InvariantCulture)</td>
                                        <td><input type="checkbox" class="epc-content-check" onchange="on_one_check_changed();" id="checked_@id" name="checked_@id" value="@id" /></td>
                                        <td><a href="@href">@id</a></td>
                                        <td class="value_td"><a href="@href">@(new string('\u00A0', Math.Max(0, r.Level - 1) * 4))@(string.IsNullOrWhiteSpace(r.Value) ? "—" : r.Value)</a></td>
                                        <td><a href="@href">@r.TitleTag</a></td>
                                        <td><a href="@href">@r.DescriptionTag</a></td>
                                        <td><a href="@href">@r.ContentType.ToUpperInvariant()</a></td>
                                        <td><a href="@href">@r.Parent.ToString(CultureInfo.InvariantCulture)</a></td>
                                        <td><a href="@href">@r.Level.ToString(CultureInfo.InvariantCulture)</a></td>
                                        <td class="text-center">@if (r.System) { <i class="fa fa-cog"></i> }</td>
                                        <td><a href="@href">@Stamp(r.TimeCreated)</a></td>
                                        <td><a href="@href">@Stamp(r.TimeEdited)</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_list.PageCount > 1)
                    {
                        <div class="row"><div class="col-lg-12 text-center"><div class="dataTables_paginate paging_simple_numbers"><ul class="pagination">
                            <li class="paginate_button @(_list.Page == 1 ? "disabled" : "")"><a href="@(_list.Page == 1 ? "javascript:void(0);" : PageHref(1))">First</a></li>
                            <li class="paginate_button @(_list.Page == 1 ? "disabled" : "")"><a href="@(_list.Page == 1 ? "javascript:void(0);" : PageHref(_list.Page - 1))"><i class="fa fa-chevron-left"></i></a></li>
                            @for (var i = Math.Max(1, _list.Page - 5); i <= Math.Min(_list.PageCount, _list.Page + 5); i++)
                            {
                                <li class="paginate_button @(i == _list.Page ? "active" : "")">
                                    @if (i == _list.Page) { <a href="javascript:void(0);">@i.ToString(CultureInfo.InvariantCulture)</a> }
                                    else { <a href="@PageHref(i)">@i.ToString(CultureInfo.InvariantCulture)</a> }
                                </li>
                            }
                            <li class="paginate_button @(_list.Page == _list.PageCount ? "disabled" : "")"><a href="@(_list.Page == _list.PageCount ? "javascript:void(0);" : PageHref(_list.Page + 1))"><i class="fa fa-chevron-right"></i></a></li>
                            <li class="paginate_button @(_list.Page == _list.PageCount ? "disabled" : "")"><a href="@(_list.Page == _list.PageCount ? "javascript:void(0);" : PageHref(_list.PageCount))">Last</a></li>
                        </ul></div></div></div>
                    }
                </div>
            </div>
        </div>

        <form name="main_form" id="main_form" method="post" action="/cp/content/main" style="display:none">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@ListHref(_isFrontend, _list.Hierarchy, _list.Page)" />
            <input type="hidden" name="content_id" id="main_content_id" value="" />
            <input type="hidden" name="is_frontend" value="@(_isFrontend ? "1" : "0")" />
        </form>
        <form name="published_form" id="published_form" method="post" action="/cp/content/published" style="display:none">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@ListHref(_isFrontend, _list.Hierarchy, _list.Page)" />
            <input type="hidden" name="content_array" id="published_content_array" value="" />
            <input type="hidden" name="published_value" id="published_value" value="1" />
        </form>
        <form name="delete_form" id="delete_form" method="post" action="/cp/content/delete" style="display:none">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@ListHref(_isFrontend, _list.Hierarchy, _list.Page)" />
            <input type="hidden" name="content_array" id="delete_content_array" value="" />
        </form>
        <script>
            function on_check_uncheck_all() {
                var state = document.getElementById('check_uncheck_all').checked;
                document.querySelectorAll('.epc-content-check').forEach(function (c) { c.checked = state; });
            }
            function on_one_check_changed() {
                var all = true;
                document.querySelectorAll('.epc-content-check').forEach(function (c) { if (!c.checked) all = false; });
                document.getElementById('check_uncheck_all').checked = all;
            }
            function checked_ids() {
                var ids = [];
                document.querySelectorAll('.epc-content-check:checked').forEach(function (c) { ids.push(parseInt(c.value, 10)); });
                return ids;
            }
            function set_main_flag() {
                var ids = checked_ids();
                if (ids.length !== 1) { alert('Select exactly one page to make it the main page.'); return; }
                document.getElementById('main_content_id').value = ids[0];
                document.getElementById('main_form').submit();
            }
            function set_published_flag_action(v) {
                var ids = checked_ids();
                if (ids.length === 0) { alert('Select at least one page.'); return; }
                document.getElementById('published_content_array').value = JSON.stringify(ids);
                document.getElementById('published_value').value = v;
                document.getElementById('published_form').submit();
            }
            function delete_action() {
                var ids = checked_ids();
                if (ids.length === 0) { alert('Select at least one page to delete.'); return; }
                if (!confirm('Delete the selected pages (' + ids.length + ')? Child pages are kept.')) return;
                document.getElementById('delete_content_array').value = JSON.stringify(ids);
                document.getElementById('delete_form').submit();
            }
        </script>
    }
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/content/content_manager";
    private const string _phpEditTab = "/CP/content/content_manager/content";
    private const string _phpTreeTab = "/CP/content/content_tree";
    private const string _listHref = "/cp/pages-app";
    private const int _pageSize = 25;
    private bool _isAdmin;
    private bool _isFrontend = true;
    private long _selectedId;
    private bool _notFound;
    private string _flashOk = "";
    private string _flashErr = "";
    private CpContentList _list = new([], 0, 0, 1, _pageSize, true, true, "id", true, new());
    private CpContentEditor? _editor;
    private CpContentTree? _tree;

    private string ModeHref(bool frontend) => _listHref + "?is_frontend=" + (frontend ? "1" : "0");
    private string TreeHref(bool frontend) => ModeHref(frontend) + "&tree=1";
    private string EditorHref(long id) => ModeHref(_isFrontend) + (id > 0 ? "&content_id=" + id.ToString(CultureInfo.InvariantCulture) : "&new=1");

    private string ListHref(bool frontend, bool hierarchy, int page, string? sort = null, bool? asc = null)
    {
        var h = ModeHref(frontend) + "&mode=" + (hierarchy ? "hierarchy" : "direct_list") + "&s_page=" + page.ToString(CultureInfo.InvariantCulture);
        if (!hierarchy)
        {
            h += "&sort=" + Uri.EscapeDataString(sort ?? _list.SortField) + "&dir=" + ((asc ?? _list.SortAsc) ? "asc" : "desc");
            if (_list.Filter.Id.Length > 0) h += "&f_id=" + Uri.EscapeDataString(_list.Filter.Id);
            if (_list.Filter.Content.Length > 0) h += "&f_content=" + Uri.EscapeDataString(_list.Filter.Content);
            if (_list.Filter.Meta.Length > 0) h += "&f_meta=" + Uri.EscapeDataString(_list.Filter.Meta);
        }

        return h;
    }

    private string PageHref(int page) => ListHref(_isFrontend, _list.Hierarchy, page);

    private MarkupString SortLink(string field, string caption)
    {
        var active = string.Equals(_list.SortField, field, StringComparison.Ordinal);
        var nextAsc = !active || !_list.SortAsc;
        var cls = "epc-sorter" + (active ? (_list.SortAsc ? " epc-asc" : " epc-desc") : "");
        var href = ListHref(_isFrontend, false, 1, field, nextAsc);
        return new MarkupString("<a class=\"" + cls + "\" id=\"" + field + "_sorter\" href=\"" + System.Net.WebUtility.HtmlEncode(href) + "\">" + System.Net.WebUtility.HtmlEncode(caption) + "</a>");
    }

    private static string Stamp(long unix) => unix <= 0 ? "—" : DateTimeOffset.FromUnixTimeSeconds(unix).ToString("dd.MM.yyyy HH:mm", CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var q = ctx.Request.Query;
        _flashOk = q["ok"].ToString() ?? "";
        _flashErr = q["err"].ToString() ?? "";
        _isFrontend = q["is_frontend"].ToString() != "0";
        _selectedId = ErpRecordOpen.ReadId(ctx.Request, "content_id");
        var isNew = q["new"].ToString() == "1";
        var tree = q["tree"].ToString() == "1";
        var hierarchy = q["mode"].ToString() != "direct_list";
        var page = int.TryParse(q["s_page"], NumberStyles.Integer, CultureInfo.InvariantCulture, out var p) && p > 0 ? p : 1;
        var sort = q["sort"].ToString();
        var asc = q["dir"].ToString() != "desc";
        var filter = new CpContentFilter((q["f_id"].ToString() ?? "").Trim(), (q["f_content"].ToString() ?? "").Trim(), (q["f_meta"].ToString() ?? "").Trim());

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        if (tree)
        {
            _tree = await Content.TreeAsync(_isFrontend, ctx.RequestAborted);
            return;
        }

        if (_selectedId > 0 || isNew)
        {
            _editor = await Content.OpenAsync(_selectedId, _isFrontend, ctx.RequestAborted);
            if (_editor is not null)
            {
                _isFrontend = _editor.IsFrontend;
                return;
            }

            _notFound = _selectedId > 0;
        }

        _list = await Content.ListAsync(_isFrontend, hierarchy, page, _pageSize, string.IsNullOrWhiteSpace(sort) ? "id" : sort, asc, filter, ctx.RequestAborted);
    }
}
