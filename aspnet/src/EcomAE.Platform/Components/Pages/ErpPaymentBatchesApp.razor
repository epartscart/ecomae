@page "/erp/payment-batches-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Payment Batches · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Payment Batches" BreadcrumbArea="Treasury" BreadcrumbTab="Payment batches">

    
    <PhpErpModulePageHeader Title="Payment Batches" Subtitle="Read digest with PHP-reference interactive module." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />


    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Payment Batches KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_batches.Count</div></div>
        <div class="kpi"><div class="lbl">Digest source</div><div class="val">@_source</div></div>
        <div class="kpi"><div class="lbl">Session</div><div class="val">@(_isAdmin ? "live" : "guest")</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Batch #</th>
                    <th>Type</th>
                    <th>Account</th>
                    <th>Total</th>
                    <th>Lines</th>
                    <th>Status</th>
                    <th>Execute</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_batches.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "Nothing to show yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _batches)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.BatchNo) ? $"#{row.Id}" : row.BatchNo)</strong></td>
                            <td><span class="label label-default">@row.BatchType</span></td>
                            <td>@(string.IsNullOrWhiteSpace(row.AccountName) ? "—" : row.AccountName)</td>
                            <td>@row.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(row.LineCount > 0 ? row.LineCount.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td>@FormatTime(row.ExecutionDate)</td>
                            <td><a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">@_message</div>
    }

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=banking&tab=payment_batches";
    private bool _isAdmin;
    private IReadOnlyList<ErpPaymentBatchDigest> _batches = [];
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpPaymentBatchesAsync(_limit, ctx.RequestAborted);
        _batches = result.Batches;
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
