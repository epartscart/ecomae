@page "/erp/payment-batches-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Payment Batches · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<HeadContent>
<style>
        .epc-paym-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#1d4ed8 45%,#2563eb 100%);
        }
        .epc-paym-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-paym-hero p { margin:0; color:#bfdbfe; max-width:42rem; font-size:.92rem; line-height:1.45; }
        .epc-paym-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-paym-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#fff; background:#2563eb;
        }
        .epc-paym-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); }
        .epc-paym-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-paym-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-paym-kpi strong { display:block; font-size:1.45rem; font-variant-numeric:tabular-nums; }
        .epc-paym-kpi span { color:#64748b; font-size:.78rem; }
        .epc-paym-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-paym-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-paym-table th, .epc-paym-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-paym-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-paym-table a { color:#1d4ed8; font-weight:700; text-decoration:none; }
        .epc-paym-badge { display:inline-flex; padding:.15rem .45rem; border-radius:.3rem; font-size:.72rem; font-weight:700; background:#dbeafe; color:#1e3a8a; }
        .epc-paym-note { margin-top:1rem; padding:.75rem .9rem; background:#eff6ff; border:1px solid #bfdbfe; border-radius:.45rem; color:#1e3a8a; font-size:.86rem; }
        @@media (max-width:900px){ .epc-paym-kpis{grid-template-columns:1fr;} }
</style>
</HeadContent>

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Payment Batches" BreadcrumbArea="Treasury" BreadcrumbTab="Payment batches">

    <section class="epc-paym-hero">
        <h1>Payment Batches</h1>
        <p>AP payment batches for bank execution (PHP epc_erp_payment_batches).</p>
        <div class="epc-paym-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/erp/cash-accounts-app">Cash & bank</a>
            <a class="ghost" href="/erp/purchases-app">Purchases</a>
            <a class="ghost" href="/erp/app">ERP dashboard</a>
        </div>
    </section>

    <div class="epc-paym-kpis" aria-label="Payment Batches KPIs">
        <div class="epc-paym-kpi"><strong>@_batches.Count</strong><span>Shown (limit @_limit)</span></div>
        <div class="epc-paym-kpi"><strong>@_source</strong><span>Digest source</span></div>
        <div class="epc-paym-kpi"><strong>@(_isAdmin ? "live" : "guest")</strong><span>Session</span></div>
    </div>

    <div class="epc-paym-table-wrap">
        <table class="epc-paym-table">
            <thead>
                <tr>
                    <th>Batch #</th>
                    <th>Type</th>
                    <th>Account</th>
                    <th>Total</th>
                    <th>Lines</th>
                    <th>Status</th>
                    <th>Execute</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_batches.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "Nothing to show yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _batches)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.BatchNo) ? $"#{row.Id}" : row.BatchNo)</strong></td>
                            <td><span class="epc-paym-badge">@row.BatchType</span></td>
                            <td>@(string.IsNullOrWhiteSpace(row.AccountName) ? "—" : row.AccountName)</td>
                            <td>@row.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(row.LineCount > 0 ? row.LineCount.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><span class="epc-paym-badge">@row.Status</span></td>
                            <td>@FormatTime(row.ExecutionDate)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="epc-paym-note">@_message</div>
    }

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=banking&tab=payment_batches";
    private bool _isAdmin;
    private IReadOnlyList<ErpPaymentBatchDigest> _batches = [];
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpPaymentBatchesAsync(_limit, ctx.RequestAborted);
        _batches = result.Batches;
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
