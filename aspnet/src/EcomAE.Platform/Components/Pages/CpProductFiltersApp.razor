@page "/cp/product-filters-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ICpProductFilterEditorService Filters
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Product filters · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<style>
    .epc-pf-actions .panel_a { display:inline-block; text-align:center; text-decoration:none; color:#333; margin-right:14px; vertical-align:top; }
    .epc-pf-actions .panel_a_img { width:48px; height:48px; margin:0 auto 4px; border-radius:8px; background:#f1f3f6; display:flex; align-items:center; justify-content:center; font-size:22px; color:#3498db; }
    .epc-pf-actions .panel_a_caption { font-size:12px; }
    .epc-pf-list td, .epc-pf-list th { vertical-align:middle !important; }
    .epc-pf-list tr.epc-row-open td { background:#fff8dc; }
    .epc-pf-list .pagination { margin:8px 0 0; }
    .epc-pf-list .epc-edit-line { display:none; }
    .epc-pf-list tr.epc-editing .epc-edit-line { display:table-row; }
    .epc-pf-list tr.epc-editing .epc-show-line { display:none; }
    .epc-pf-list input.form-control { height:28px; padding:2px 6px; }
    .epc-pf-tree { height:400px; overflow:auto; border:1px solid #e4e5e7; padding:6px; }
    .epc-pf-tree label { display:block; font-weight:normal; margin:2px 0; cursor:pointer; }
</style>

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    @if (!_isAdmin)
    {
        <div class="hpanel"><div class="panel-body">
            <div class="alert alert-warning" role="status">Sign in to the Control Panel to manage product filters. <a href="/cp/login?returnUrl=/cp/product-filters-app">Login</a></div>
        </div></div>
    }
    else if (_openedId > 0 && _setting is null)
    {
        <div class="hpanel"><div class="panel-body">
            <div class="alert alert-danger" role="status">Product filter #@_openedId.ToString(CultureInfo.InvariantCulture) was not found. <a href="@_listHref">Back to filters</a></div>
        </div></div>
    }
    else if (_setting is not null)
    {
        @* ---- setting.php twin: storages scope + price/time bands ---- *@
        var s = _setting;
        var returnHere = _listHref + "?filter_id=" + s.Id.ToString(CultureInfo.InvariantCulture);
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Filter settings
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab + "/setting?id=" + s.Id.ToString(CultureInfo.InvariantCulture))">Classic twin</a>
            </div>
            <div class="panel-body epc-pf-actions">
                <a class="panel_a" href="@_listHref"><div class="panel_a_img"><i class="fas fa-chevron-left"></i></div><div class="panel_a_caption">Back</div></a>
                <a class="panel_a" href="javascript:void(0);" onclick="epcPfSave();"><div class="panel_a_img"><i class="fa fa-save"></i></div><div class="panel_a_caption">Save</div></a>
                <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="alert alert-success" role="status">@_flashOk</div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="alert alert-danger" role="status">@_flashErr</div> }
        <div class="row" style="margin:0">
            <div class="col-lg-12">
                <div class="hpanel">
                    <div class="panel-heading hbuilt">Filter</div>
                    <div class="panel-body">
                        <div class="col-lg-12"><h4>
                            @s.Caption
                            @if (s.Name.Length > 0) { <text> <small>name:</small> @s.Name</text> }
                        </h4></div>
                    </div>
                </div>
            </div>
        </div>
        <form id="pf_setting_form" method="post" action="/cp/product-filters/write">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@returnHere" />
            <input type="hidden" name="action" value="save_storages" />
            <input type="hidden" name="filter_id" value="@s.Id.ToString(CultureInfo.InvariantCulture)" />
            <input type="hidden" name="list_storages" id="list_storages" value="" />
            <div class="row" style="margin:0">
                <div class="col-lg-6" id="general_options_div">
                    <div class="hpanel">
                        <div class="panel-heading hbuilt">Warehouses included in the filter</div>
                        <div class="panel-body">
                            <input type="checkbox" id="check_uncheck_all" onchange="epcPfCheckAll(this.checked);" checked="@s.Storages.All(x => x.Checked)" /> <label style="cursor:pointer;" for="check_uncheck_all">Check / uncheck all</label>
                            <div class="epc-pf-tree" id="container_A_storages">
                                @if (s.Storages.Count == 0)
                                {
                                    <div class="text-muted">No warehouses yet. Create them on <a href="/cp/storages-app">Warehouses</a>.</div>
                                }
                                @foreach (var st in s.Storages)
                                {
                                    <label><input type="checkbox" class="epc-pf-storage" value="@st.Id.ToString(CultureInfo.InvariantCulture)" checked="@st.Checked" /> @st.Name <span class="text-muted">(@st.Id.ToString(CultureInfo.InvariantCulture))</span></label>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="hpanel">
                        <div class="panel-heading hbuilt">Price range</div>
                        <div class="panel-body">
                            <label for="min_price">Minimum price</label><br>
                            <input class="form-control" type="number" step="0.01" min="0" id="min_price" name="min_price" value="@(s.MinPrice > 0 ? s.MinPrice.ToString(CultureInfo.InvariantCulture) : "")" />
                            <label for="max_price">Maximum price</label><br>
                            <input class="form-control" type="number" step="0.01" min="0" id="max_price" name="max_price" value="@(s.MaxPrice > 0 ? s.MaxPrice.ToString(CultureInfo.InvariantCulture) : "")" />
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="hpanel">
                        <div class="panel-heading hbuilt">Delivery time range</div>
                        <div class="panel-body">
                            <label for="min_time">Minimum delivery time (days)</label><br>
                            <input class="form-control" type="number" min="0" id="min_time" name="min_time" value="@(s.MinTime > 0 ? s.MinTime.ToString(CultureInfo.InvariantCulture) : "")" />
                            <label for="max_time">Maximum delivery time (days)</label><br>
                            <input class="form-control" type="number" min="0" id="max_time" name="max_time" value="@(s.MaxTime > 0 ? s.MaxTime.ToString(CultureInfo.InvariantCulture) : "")" />
                        </div>
                    </div>
                </div>
            </div>
        </form>
        <script>
            function epcPfCheckAll(on) {
                document.querySelectorAll('.epc-pf-storage').forEach(function (c) { c.checked = on; });
            }
            function epcPfSave() {
                var ids = [];
                document.querySelectorAll('.epc-pf-storage:checked').forEach(function (c) { ids.push(parseInt(c.value, 10)); });
                document.getElementById('list_storages').value = JSON.stringify(ids);
                document.getElementById('pf_setting_form').submit();
            }
        </script>
    }
    else
    {
        @* ---- filter_shop.php twin ---- *@
        var l = _list;
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Product filters
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body epc-pf-actions">
                <a class="panel_a" href="javascript:void(0);" onclick="epcPfActiveAll(1);"><div class="panel_a_img"><i class="fa fa-check-square-o"></i></div><div class="panel_a_caption">Enable all</div></a>
                <a class="panel_a" href="javascript:void(0);" onclick="epcPfActiveAll(0);"><div class="panel_a_img"><i class="fa fa-square-o"></i></div><div class="panel_a_caption">Disable all</div></a>
                <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="alert alert-success" role="status">@_flashOk</div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="alert alert-danger" role="status">@_flashErr</div> }

        <div class="row" style="margin:0">
            <div class="col-lg-12">
                <div class="hpanel">
                    <div class="panel-heading hbuilt">
                        Add a filter
                        <button class="btn btn-xs btn-info btn-circle" type="button" onclick="alert('A filter hides matching offers from the storefront search. Leave manufacturer empty to match any brand; leave article empty to match the whole brand.');"><i class="fa fa-info"></i></button>
                    </div>
                    <form method="post" action="/cp/product-filters/write" id="pf_add_form">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@_listHref" />
                        <input type="hidden" name="action" value="add" />
                        <div class="panel-body">
                            <div class="col-md-4"><label>Manufacturer:</label><input class="form-control" type="text" id="new_manufacturer" name="manufacturer" placeholder="Not set" /></div>
                            <div class="col-md-4"><label>Article:</label><input class="form-control" type="text" id="new_article" name="article" placeholder="Not set" /></div>
                            <div class="col-md-4"><label>Name:</label><input class="form-control" type="text" id="new_name" name="name" placeholder="Not set" /></div>
                        </div>
                        <div class="panel-footer text-right">
                            <button id="btn_add" type="submit" class="btn btn-ar btn-success"><i class="fa fa-plus"></i> Add</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel epc-pf-list">
                <div class="panel-heading hbuilt" style="position:relative;">
                    Filter list <span class="text-muted">(@l.Total.ToString(CultureInfo.InvariantCulture))</span>
                </div>
                <div id="div_table" class="table-responsive">
                    <table class="table table-condensed table-striped table-bordered table-epc">
                        <thead>
                            <tr>
                                <th style="width:60px">Active</th>
                                <th style="width:60px">ID</th>
                                <th>Manufacturer</th>
                                <th>Article</th>
                                <th>Name</th>
                                <th>Warehouses</th>
                                <th>Price</th>
                                <th>Time</th>
                                <th style="width:150px"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (l.Rows.Count == 0)
                        {
                            <tr><td colspan="9">No filters yet.</td></tr>
                        }
                        @foreach (var row in l.Rows)
                        {
                            var rid = row.Id.ToString(CultureInfo.InvariantCulture);
                            <tr id="line_@rid" class="epc-show-line @ErpRecordOpen.RowClass(row.Id, _openedId)">
                                <td class="text-center">
                                    <form method="post" action="/cp/product-filters/write" id="active_form_@rid">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="@PageHref(l.Page)" />
                                        <input type="hidden" name="action" value="active" />
                                        <input type="hidden" name="filter_id" value="@rid" />
                                        <input type="hidden" name="flag" id="active_flag_@rid" value="@(row.Active ? "1" : "0")" />
                                        <input type="checkbox" id="active_@rid" checked="@row.Active" onchange="epcPfActive('@rid', this.checked);" />
                                    </form>
                                </td>
                                <td>@rid</td>
                                <td>@(row.Manufacturer.Length > 0 ? row.Manufacturer : "—")</td>
                                <td>@(row.Article.Length > 0 ? row.Article : "—")</td>
                                <td>@(row.Name.Length > 0 ? row.Name : "—")</td>
                                <td>@(row.StorageCount > 0 ? row.StorageCount.ToString(CultureInfo.InvariantCulture) : "all")</td>
                                <td>@Range(row.MinPrice, row.MaxPrice)</td>
                                <td>@Range(row.MinTime, row.MaxTime)</td>
                                <td class="text-right">
                                    <a class="btn btn-xs btn-default" title="Settings" href="@ErpRecordOpen.Href(_listHref, "filter_id", row.Id)"><i class="fa fa-cog"></i></a>
                                    <a class="btn btn-xs btn-default" title="Edit" href="javascript:void(0);" onclick="epcPfEdit('@rid');"><i class="fa fa-pencil"></i></a>
                                    <a class="btn btn-xs btn-danger" title="Delete" href="javascript:void(0);" onclick="epcPfDel('@rid');"><i class="fa fa-trash"></i></a>
                                </td>
                            </tr>
                            <tr id="edit_line_@rid" class="epc-edit-line">
                                <td></td>
                                <td>@rid</td>
                                <td><input class="form-control" type="text" form="save_form_@rid" name="manufacturer" id="manufacturer_edit_@rid" value="@row.Manufacturer" /></td>
                                <td><input class="form-control" type="text" form="save_form_@rid" name="article" id="article_edit_@rid" value="@row.Article" /></td>
                                <td><input class="form-control" type="text" form="save_form_@rid" name="name" id="name_edit_@rid" value="@row.Name" /></td>
                                <td colspan="3"></td>
                                <td class="text-right">
                                    <form method="post" action="/cp/product-filters/write" id="save_form_@rid" style="display:inline">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="@PageHref(l.Page)" />
                                        <input type="hidden" name="action" value="save" />
                                        <input type="hidden" name="filter_id" value="@rid" />
                                        <button class="btn btn-xs btn-success" type="submit" title="Save"><i class="fa fa-save"></i></button>
                                    </form>
                                    <a class="btn btn-xs btn-default" title="Cancel" href="javascript:void(0);" onclick="epcPfEditCancel('@rid');"><i class="fa fa-times"></i></a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    @if (l.PageCount > 1)
                    {
                        <ul class="pagination pagination-sm" style="margin-left:8px">
                            @for (var p = 1; p <= l.PageCount; p++)
                            {
                                <li class="@(p == l.Page ? "active" : "")"><a href="@PageHref(p)">@p.ToString(CultureInfo.InvariantCulture)</a></li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <form method="post" action="/cp/product-filters/write" id="pf_del_form">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_listHref" />
            <input type="hidden" name="action" value="del" />
            <input type="hidden" name="filter_id" id="pf_del_id" value="" />
        </form>
        <form method="post" action="/cp/product-filters/write" id="pf_all_form">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_listHref" />
            <input type="hidden" name="action" value="active_all" />
            <input type="hidden" name="flag" id="pf_all_flag" value="1" />
        </form>
        <script>
            function epcPfEdit(id) {
                document.getElementById('line_' + id).classList.add('epc-editing');
                document.getElementById('edit_line_' + id).style.display = 'table-row';
                document.getElementById('line_' + id).style.display = 'none';
            }
            function epcPfEditCancel(id) {
                document.getElementById('edit_line_' + id).style.display = 'none';
                document.getElementById('line_' + id).style.display = '';
            }
            function epcPfDel(id) {
                if (!confirm('Delete this filter?')) { return; }
                document.getElementById('pf_del_id').value = id;
                document.getElementById('pf_del_form').submit();
            }
            function epcPfActive(id, on) {
                document.getElementById('active_flag_' + id).value = on ? '1' : '0';
                document.getElementById('active_form_' + id).submit();
            }
            function epcPfActiveAll(flag) {
                var q = flag === 1 ? 'Enable all filters?' : 'Disable all filters?';
                if (!confirm(q)) { return false; }
                document.getElementById('pf_all_flag').value = String(flag);
                document.getElementById('pf_all_form').submit();
            }
        </script>
    }
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/filter";
    private const int PageSize = 50;
    private bool _isAdmin;
    private string _flashOk = "";
    private string _flashErr = "";
    private string _listHref = "/cp/product-filters-app";
    private long _openedId;
    private CpProductFilterList _list = new([], 0, 1, PageSize);
    private CpProductFilterSetting? _setting;

    private string PageHref(int page) => page <= 1 ? _listHref : _listHref + "?page=" + page.ToString(CultureInfo.InvariantCulture);

    private static string Range(decimal lo, decimal hi)
        => lo <= 0 && hi <= 0 ? "—" : (lo > 0 ? lo.ToString("0.##", CultureInfo.InvariantCulture) : "0") + " – " + (hi > 0 ? hi.ToString("0.##", CultureInfo.InvariantCulture) : "∞");

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "filter_id", "id");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        if (_openedId > 0)
        {
            _setting = await Filters.OpenAsync(_openedId, ctx.RequestAborted);
            return;
        }

        var page = int.TryParse(ctx.Request.Query["page"], NumberStyles.Integer, CultureInfo.InvariantCulture, out var p) ? p : 1;
        _list = await Filters.ListAsync(page, PageSize, ctx.RequestAborted);
    }
}
