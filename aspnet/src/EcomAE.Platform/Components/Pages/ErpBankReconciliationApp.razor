@page "/erp/bank-reconciliation-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Bank reconciliation · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Bank reconciliation" BreadcrumbArea="Cash & Treasury" BreadcrumbTab="Bank recon">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/bank-reconciliation-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="@_title" Subtitle="@_subtitle" PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <p class="text-muted" style="margin:8px 0 12px;">
        <a href="/erp/bank-reconciliation-app">Bank recon</a>
        · <a href="/erp/bank-reconciliation-app?tab=bank_instruments">Bank instruments</a>
    </p>

    @if (_view == "bank_instruments")
    {
        <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Bank instrument stats">
            <div class="kpi"><div class="lbl">Instruments</div><div class="val">@_instruments.Count.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Issued</div><div class="val">@_instrumentSummary.Issued.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Utilized</div><div class="val">@_instrumentSummary.Utilized.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Closed</div><div class="val">@_instrumentSummary.Closed.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Outstanding</div><div class="val">@_instrumentSummary.Exposure.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        </div>
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead>
                    <tr>
                        <th>Ref</th>
                        <th>Type</th>
                        <th>Beneficiary</th>
                        <th>Bank</th>
                        <th class="text-right">Amount</th>
                        <th>Expiry</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_instruments.Count == 0)
                    {
                        <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No bank instruments yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                    }
                    else
                    {
                        @foreach (var row in _instruments)
                        {
                            <tr>
                                <td><strong>@(string.IsNullOrWhiteSpace(row.Ref) ? $"#{row.Id}" : row.Ref)</strong></td>
                                <td>@row.Type</td>
                                <td>@(string.IsNullOrWhiteSpace(row.Beneficiary) ? "—" : row.Beneficiary)</td>
                                <td>@(string.IsNullOrWhiteSpace(row.Bank) ? "—" : row.Bank)</td>
                                <td class="text-right">@row.Amount.ToString("N2", CultureInfo.InvariantCulture) @(string.IsNullOrWhiteSpace(row.Currency) ? "" : row.Currency)</td>
                                <td>@(string.IsNullOrWhiteSpace(row.ExpiryDate) ? "—" : row.ExpiryDate)</td>
                                <td><span class="label label-default">@row.Status</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Bank reconciliation stats">
        <div class="kpi"><div class="lbl">Lines</div><div class="val">@_summary.LineCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Unmatched</div><div class="val">@_summary.UnmatchedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Matched</div><div class="val">@_summary.MatchedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Credits</div><div class="val">@_summary.CreditTotal.ToString("0.00", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Debits</div><div class="val">@_summary.DebitTotal.ToString("0.00", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Account</dt><dd>@(_opened.AccountId > 0 ? _opened.AccountId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Line date</dt><dd>@FormatTime(_opened.LineDate)</dd>
                <dt>Description</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Description) ? "—" : _opened.Description)</dd>
                <dt>Reference</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Reference) ? "—" : _opened.Reference)</dd>
                <dt>Amount</dt><dd>@_opened.Amount.ToString("0.00", CultureInfo.InvariantCulture)</dd>
                <dt>Direction</dt><dd>@(_opened.Direction == 1 ? "in" : "out")</dd>
                <dt>Matched</dt><dd>@(_opened.MatchedEntryId > 0 ? _opened.MatchedEntryId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Batch</dt><dd>@(string.IsNullOrWhiteSpace(_opened.ImportBatch) ? "—" : _opened.ImportBatch)</dd>
                <dt>Created</dt><dd>@FormatTime(_opened.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Match and instrument writes stay here.</p>
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-account siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Account</th>
                            <th>Description</th>
                            <th>Amount</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(sib.AccountId > 0 ? sib.AccountId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Description) ? "—" : sib.Description)</td>
                                <td>@sib.Amount.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "recon_line_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-account siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Account</th>
                    <th>Description</th>
                    <th>Reference</th>
                    <th>Amount</th>
                    <th>Dir</th>
                    <th>Matched</th>
                    <th>Batch</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_lines.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _lines)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.AccountId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Description) ? row.Description : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Reference) ? row.Reference : "—")</td>
                            <td>@row.Amount.ToString("0.00", CultureInfo.InvariantCulture)</td>
                            <td>@(row.Direction == 1 ? "in" : "out")</td>
                            <td>@(row.MatchedEntryId > 0 ? row.MatchedEntryId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ImportBatch) ? row.ImportBatch : "—")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "recon_line_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
            </table>
        </div>
    }

</PhpErpDesktopChrome>

<ErpPhpCreateWell Title="Match statement line">
<form method="post" action="/erp/bank-reconciliation/match" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Line
                    <select class="form-control input-sm" name="line_id">
                        <option value="0">(select)</option>
                        @foreach (var line in _lines)
                        {
                            <option value="@line.Id.ToString(CultureInfo.InvariantCulture)">#@line.Id.ToString(CultureInfo.InvariantCulture) @(string.IsNullOrWhiteSpace(line.Description) ? "" : line.Description)</option>
                        }
                    </select>
                </label>
                <label>Cash entry <input class="form-control input-sm" name="entry_id" type="number" min="1" style="width:8rem;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Match</button>
            </form>
</ErpPhpCreateWell>

<ErpPhpCreateWell Title="Advance status">
<form method="post" action="/erp/bank-instruments/status" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                    <input type="hidden" name="returnUrl" value="/erp/bank-reconciliation-app?tab=bank_instruments" />
                    <input type="hidden" name="confirmWrites" value="true" />
                    <label>Instrument id <input class="form-control input-sm" type="number" name="id" min="1" required style="width:80px;" /></label>
                    <label>Status
                        <select class="form-control input-sm" name="status">
                            <option value="issued">issued</option>
                            <option value="amended">amended</option>
                            <option value="utilized">utilized</option>
                            <option value="expired">expired</option>
                            <option value="closed">closed</option>
                            <option value="cancelled">cancelled</option>
                        </select>
                    </label>
                    <label>Detail <input class="form-control input-sm" name="detail" placeholder="Event detail (optional)" style="width:180px;" /></label>
                    <label>Amount <input class="form-control input-sm" type="number" step="0.01" name="amount" value="0" style="width:90px;" /></label>
                    <button type="submit" class="btn btn-primary btn-sm">Move status</button>
                </form>
</ErpPhpCreateWell>

<ErpPhpCreateWell Title="New instrument">
<form method="post" action="/erp/bank-instruments/save" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                    <input type="hidden" name="returnUrl" value="/erp/bank-reconciliation-app?tab=bank_instruments" />
                    <input type="hidden" name="confirmWrites" value="true" />
                    <label>Type
                        <select class="form-control input-sm" name="type">
                            <option value="lc">Letter of credit</option>
                            <option value="bg">Bank guarantee</option>
                            <option value="sblc">Standby LC</option>
                        </select>
                    </label>
                    <label>Reference <input class="form-control input-sm" name="ref" placeholder="auto if blank" style="width:140px;" /></label>
                    <label>Beneficiary <input class="form-control input-sm" name="beneficiary" style="width:160px;" /></label>
                    <label>Bank <input class="form-control input-sm" name="bank" style="width:140px;" /></label>
                    <label>Amount <input class="form-control input-sm" type="number" step="0.01" name="amount" required style="width:90px;" /></label>
                    <label>Currency <input class="form-control input-sm" name="currency" placeholder="AED" style="width:70px;" /></label>
                    <label>Expiry <input class="form-control input-sm" type="date" name="expiry_date" /></label>
                    <button type="submit" class="btn btn-success btn-sm">Create instrument</button>
                </form>
</ErpPhpCreateWell>

@code {
    private const string _listHref = "/erp/bank-reconciliation-app";
    private string _phpTab = "/ERP/?epc_erp_shell=1&area=banking&tab=bank_recon";
    private string _title = "Bank reconciliation";
    private string _subtitle = "Open a row for statement date and created time. Match and instrument writes stay here.";
    private string _view = "bank_recon";
    private bool _isAdmin;
    private ErpBankReconciliationSummary _summary = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<ErpBankStatementLineDigest> _lines = [];
    private ErpBankInstrumentsSummary _instrumentSummary = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<ErpBankInstrumentDigest> _instruments = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpBankReconciliationLineDetail? _opened;
    private IReadOnlyList<ErpBankStatementLineDigest> _openedSiblings = [];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.Description)
            ? _opened.Description
            : (!string.IsNullOrWhiteSpace(_opened.Reference)
                ? _opened.Reference
                : ("Line #" + _opened.Id.ToString(CultureInfo.InvariantCulture))));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?recon_line_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "recon_line_id");
        var tab = (ctx.Request.Query["tab"].ToString() ?? "").Trim().ToLowerInvariant();
        // Open a statement line even when the instruments tab is in the query.
        _view = _openedId > 0 || tab != "bank_instruments" ? "bank_recon" : "bank_instruments";
        _phpTab = _view == "bank_instruments"
            ? "/ERP/?epc_erp_shell=1&area=banking&tab=bank_instruments"
            : "/ERP/?epc_erp_shell=1&area=banking&tab=bank_recon";
        _title = _view == "bank_instruments" ? "Bank instruments" : "Bank reconciliation";
        _subtitle = _view == "bank_instruments"
            ? "Letters of credit, guarantees and SBLC with outstanding exposure."
            : "Open a row for statement date and created time. Match and instrument writes stay here.";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        if (_view == "bank_instruments")
        {
            var instruments = await Dashboards.BuildErpBankInstrumentsDigestAsync(200, ctx.RequestAborted);
            _instrumentSummary = instruments.Summary;
            _instruments = instruments.Instruments;
            _source = instruments.Source;
            _message = instruments.Message;
            return;
        }

        var result = await Dashboards.BuildErpBankReconciliationDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _lines = result.Lines;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpBankReconciliationLineDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Line;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _lines.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _lines = new[] { openedList }.Concat(_lines.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
