@page "/cp/prices-edit-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Prices edit · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
    .epc-cpmod-hero {
        margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
        background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
    }
    .epc-cpmod-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
    .epc-cpmod-hero p { margin:0; color:rgba(255,255,255,.9); max-width:46rem; font-size:.92rem; line-height:1.45; }
    .epc-cpmod-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
    .epc-cpmod-cta a {
        display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
        text-decoration:none; color:#0f172a; background:#fff;
    }
    .epc-cpmod-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
    .epc-cpmod-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.75rem; }
    .epc-cpmod-card { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:1rem; }
    .epc-cpmod-card h3 { margin:0 0 .4rem; font-size:1rem; }
    .epc-cpmod-card p, .epc-cpmod-card li { margin:0; color:#475569; font-size:.86rem; line-height:1.45; }
    .epc-cpmod-card ul { margin:.35rem 0 0; padding-left:1.1rem; }
    .epc-cpmod-note { margin-top:1rem; padding:.75rem .9rem; background:#eff6ff; border:1px solid #93c5fd; border-radius:.45rem; color:#1e3a8a; font-size:.86rem; }
    @@media (max-width:900px){ .epc-cpmod-grid{grid-template-columns:1fr;} }
</style>
</HeadContent>

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-cpmod-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Prices edit</h1>
        <p>Add, save, and delete a single price row here when confirmWrites is set. Table list and search-delete stay on the PHP twin.</p>
        <div class="epc-cpmod-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/cp/prices-upload-app">Prices upload</a>
            <a class="ghost" href="/cp/prices-send-app">Prices send</a>
            <a class="ghost" href="/cp/price-lists-app">Price lists</a>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <div style="display:grid;gap:.65rem;margin:0 0 1rem">
            <form method="post" action="/cp/prices-edit/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/prices-edit-app" />
                <input type="hidden" name="action" value="add" />
                <label>Price list id <input type="number" name="priceId" min="0" required /></label>
                <label>Article <input type="text" name="article" required maxlength="64" /></label>
                <label>Manufacturer <input type="text" name="manufacturer" required maxlength="255" /></label>
                <label>Name <input type="text" name="name" maxlength="255" /></label>
                <label>Exist <input type="number" name="exist" min="0" value="0" /></label>
                <label>Price <input type="text" name="price" required /></label>
                <label>Days <input type="number" name="timeToExe" min="0" value="0" /></label>
                <label>Storage <input type="text" name="storage" maxlength="255" /></label>
                <label>Min order <input type="number" name="minOrder" min="0" value="1" /></label>
                <button type="submit">Add row</button>
            </form>
            <form method="post" action="/cp/prices-edit/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/prices-edit-app" />
                <input type="hidden" name="action" value="save" />
                <label>Row id <input type="number" name="id" min="1" required /></label>
                <label>Price list id <input type="number" name="priceId" min="1" required /></label>
                <label>Article <input type="text" name="article" required maxlength="64" /></label>
                <label>Manufacturer <input type="text" name="manufacturer" required maxlength="255" /></label>
                <label>Name <input type="text" name="name" maxlength="255" /></label>
                <label>Exist <input type="number" name="exist" min="0" value="0" /></label>
                <label>Price <input type="text" name="price" required /></label>
                <label>Days <input type="number" name="timeToExe" min="0" value="0" /></label>
                <label>Storage <input type="text" name="storage" maxlength="255" /></label>
                <label>Min order <input type="number" name="minOrder" min="0" value="1" /></label>
                <button type="submit">Save row</button>
            </form>
            <form method="post" action="/cp/prices-edit/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/prices-edit-app" />
                <input type="hidden" name="action" value="del" />
                <label>Row id <input type="number" name="id" min="1" required /></label>
                <button type="submit">Delete row</button>
            </form>
        </div>
    }

    <div class="epc-cpmod-note">
        Add, save, and delete write when confirmWrites is set. Search-delete and the price table stay on the PHP twin.
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/prices_edit";
    private bool _isAdmin;
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
    }
}
