@page "/cp/prices-edit-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Prices edit · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Prices edit
                <a class="btn btn-xs btn-default pull-right" href="/cp/price-lists-app">Price lists</a>
                <a class="btn btn-xs btn-default pull-right" href="/cp/prices-send-app" style="margin-right:.4rem">Prices send</a>
                <a class="btn btn-xs btn-default pull-right" href="/cp/prices-upload-app" style="margin-right:.4rem">Prices upload</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" style="margin-right:.4rem">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Add, save, delete, and search-delete price rows here when confirmWrites is set. The Classic table list stays on the Classic twin.</p>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <div style="display:grid;gap:.65rem;margin:0 0 1rem">
            <form method="post" action="/cp/prices-edit/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/prices-edit-app" />
                <input type="hidden" name="action" value="add" />
                <label>Price list id <input type="number" name="priceId" min="0" required /></label>
                <label>Article <input type="text" name="article" required maxlength="64" /></label>
                <label>Manufacturer <input type="text" name="manufacturer" required maxlength="255" /></label>
                <label>Name <input type="text" name="name" maxlength="255" /></label>
                <label>Exist <input type="number" name="exist" min="0" value="0" /></label>
                <label>Price <input type="text" name="price" required /></label>
                <label>Days <input type="number" name="timeToExe" min="0" value="0" /></label>
                <label>Storage <input type="text" name="storage" maxlength="255" /></label>
                <label>Min order <input type="number" name="minOrder" min="0" value="1" /></label>
                <button type="submit">Add row</button>
            </form>
            <form method="post" action="/cp/prices-edit/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/prices-edit-app" />
                <input type="hidden" name="action" value="save" />
                <label>Row id <input type="number" name="id" min="1" required /></label>
                <label>Price list id <input type="number" name="priceId" min="1" required /></label>
                <label>Article <input type="text" name="article" required maxlength="64" /></label>
                <label>Manufacturer <input type="text" name="manufacturer" required maxlength="255" /></label>
                <label>Name <input type="text" name="name" maxlength="255" /></label>
                <label>Exist <input type="number" name="exist" min="0" value="0" /></label>
                <label>Price <input type="text" name="price" required /></label>
                <label>Days <input type="number" name="timeToExe" min="0" value="0" /></label>
                <label>Storage <input type="text" name="storage" maxlength="255" /></label>
                <label>Min order <input type="number" name="minOrder" min="0" value="1" /></label>
                <button type="submit">Save row</button>
            </form>
            <form method="post" action="/cp/prices-edit/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/prices-edit-app" />
                <input type="hidden" name="action" value="del" />
                <label>Row id <input type="number" name="id" min="1" required /></label>
                <button type="submit">Delete row</button>
            </form>
            <form method="post" action="/cp/prices-edit/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/prices-edit-app" />
                <input type="hidden" name="action" value="del_search" />
                <label>Price list id <input type="number" name="priceId" min="0" /></label>
                <label>Article <input type="text" name="article" maxlength="64" /></label>
                <label>Manufacturer <input type="text" name="manufacturer" maxlength="255" /></label>
                <label>Search <input type="text" name="search_text" maxlength="255" /></label>
                <label><input type="checkbox" name="no_article" value="1" /> Empty article</label>
                <label><input type="checkbox" name="no_manufacturer" value="1" /> Empty manufacturer</label>
                <button type="submit">Search-delete</button>
            </form>
        </div>
    }

    <p class="help-block">Add, save, delete, and search-delete write when confirmWrites is set. The Classic table list stays on the Classic twin.</p>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/prices_edit";
    private bool _isAdmin;
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
    }
}
