@page "/cp/metabase-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Metabase · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Metabase
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/metabase-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/metabase-app" IsAdmin="_isAdmin" />


    <p class="help-block">@(_summary.Active ? "active" : "off") Config (@(string.IsNullOrWhiteSpace(_summary.SiteKey) ? "—" : _summary.SiteKey)) · @(string.IsNullOrWhiteSpace(_summary.MetabaseUrl) ? "—" : _summary.MetabaseUrl) Metabase URL · @_dashboards.Count.ToString(CultureInfo.InvariantCulture) Dashboards shown.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Site</th>
                    <th>Dashboard</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_dashboards.Count == 0)
                {
                    <tr><td colspan="7">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var d in _dashboards)
                    {
                        <tr>
                            <td><strong>@d.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(d.SiteKey) ? "—" : d.SiteKey)</td>
                            <td>@d.DashboardId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(d.DashboardName) ? "—" : d.DashboardName)</td>
                            <td>@(string.IsNullOrWhiteSpace(d.Category) ? "—" : d.Category)</td>
                            <td>@(d.Active ? "yes" : "no")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/general_pages/epc_metabase_embed";
    private bool _isAdmin;
    private CpMetabaseConfigSummary _summary = new("", "", false, 0, "n/a", "");
    private IReadOnlyList<CpMetabaseDashboardDigest> _dashboards = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpMetabaseDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _dashboards = result.Dashboards;
        _source = result.Source;
        _message = result.Message;
    }
}
