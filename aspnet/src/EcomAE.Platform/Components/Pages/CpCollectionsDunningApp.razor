@page "/cp/collections-dunning-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Middleware
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Collections dunning · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-w15-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-w15-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-w15-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-w15-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-w15-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f172a; background:#fff;
        }
        .epc-w15-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-w15-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-w15-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-w15-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-w15-kpi span { color:#64748b; font-size:.78rem; }
        .epc-w15-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-w15-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-w15-table th, .epc-w15-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-w15-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-w15-note { margin-top:1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:.45rem; color:#334155; font-size:.86rem; }
        @@media (max-width:900px){ .epc-w15-kpis{grid-template-columns:1fr 1fr;} }
    
</style>
</HeadContent>


<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-w15-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Collections dunning</h1>
        <p>Queue status, payment, profile, add-invoice, and step process write here. Schema-ensure stays on the Classic twin. Case status is a separate ERP form below.</p>
        <div class="epc-w15-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
        </div>
    </section>
    <PhpParityModuleBody AppPath="/cp/collections-dunning-app" IsAdmin="_isAdmin" />


    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/collections-dunning/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/collections-dunning-app" />
            <input type="hidden" name="action" value="update_status" />
            <label>Queue id <input type="number" name="queueId" min="1" required style="width:6rem" /></label>
            <label>Queue status
                <select name="status">
                    <option value="open">open</option>
                    <option value="in_progress">in_progress</option>
                    <option value="promised">promised</option>
                    <option value="partial">partial</option>
                    <option value="paid">paid</option>
                    <option value="written_off">written_off</option>
                    <option value="disputed">disputed</option>
                </select>
            </label>
            <label>Notes <input type="text" name="notes" maxlength="400" /></label>
            <button type="submit">Set queue status</button>
        </form>
        <form method="post" action="/cp/collections-dunning/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/collections-dunning-app" />
            <input type="hidden" name="action" value="record_payment" />
            <label>Queue id <input type="number" name="queueId" min="1" required style="width:6rem" /></label>
            <label>Amount <input type="number" name="amount" min="0.01" step="0.01" required style="width:7rem" /></label>
            <button type="submit">Record payment</button>
        </form>
        <form method="post" action="/cp/collections-dunning/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/collections-dunning-app" />
            <input type="hidden" name="action" value="create_profile" />
            <input type="hidden" name="siteKey" value="@_siteKey" />
            <label>Profile name <input type="text" name="name" maxlength="128" required /></label>
            <button type="submit">Create profile</button>
        </form>
        <form method="post" action="/cp/collections-dunning/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/collections-dunning-app" />
            <input type="hidden" name="action" value="add_invoice" />
            <input type="hidden" name="siteKey" value="@_siteKey" />
            <label>Customer id <input type="number" name="customerId" min="0" style="width:6rem" /></label>
            <label>Customer <input type="text" name="customerName" maxlength="128" /></label>
            <label>Invoice <input type="text" name="invoiceRef" maxlength="64" required /></label>
            <label>Amount <input type="number" name="invoiceAmount" min="0" step="0.01" required style="width:7rem" /></label>
            <label>Due <input type="date" name="dueDate" /></label>
            <label>Profile id <input type="number" name="profileId" min="0" style="width:6rem" /></label>
            <button type="submit">Add invoice</button>
        </form>
        <form method="post" action="/cp/collections-dunning/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/collections-dunning-app" />
            <input type="hidden" name="action" value="process" />
            <input type="hidden" name="siteKey" value="@_siteKey" />
            <button type="submit">Process dunning steps</button>
        </form>
        <form method="post" action="/erp/collections/cases/status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/collections-dunning-app" />
            <label>Case id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <label>Status
                <select name="status">
                    <option value="new">new</option>
                    <option value="in_progress">in_progress</option>
                    <option value="promise_to_pay">promise_to_pay</option>
                    <option value="escalated">escalated</option>
                    <option value="resolved">resolved</option>
                </select>
            </label>
            <button type="submit">Set case status</button>
        </form>
    }

    <div class="epc-w15-kpis" aria-label="Collections dunning stats">
        <div class="epc-w15-kpi"><strong>@_summary.QueueCount.ToString(CultureInfo.InvariantCulture)</strong><span>Queue</span></div>
        <div class="epc-w15-kpi"><strong>@_summary.OpenCount.ToString(CultureInfo.InvariantCulture)</strong><span>Open</span></div>
        <div class="epc-w15-kpi"><strong>@_summary.ProfileCount.ToString(CultureInfo.InvariantCulture)</strong><span>Profiles</span></div>
        <div class="epc-w15-kpi"><strong>@_summary.LogCount.ToString(CultureInfo.InvariantCulture)</strong><span>Log</span></div>
    </div>

    <div class="epc-w15-table-wrap">
    <table class="epc-w15-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Site</th>
                    <th>Customer</th>
                    <th>Invoice</th>
                    <th>Due</th>
                    <th>Amount due</th>
                    <th>Overdue</th>
                    <th>Status</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="9">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.SiteKey) ? row.SiteKey : "—")</td>
                            <td>@row.CustomerId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.InvoiceRef) ? row.InvoiceRef : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.DueDate) ? row.DueDate : "—")</td>
                            <td>@row.AmountDue.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@row.DaysOverdue.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>
                                @if (_isAdmin)
                                {
                                    <form method="post" action="/cp/collections-dunning/write" style="display:inline-flex;flex-wrap:wrap;gap:.25rem;align-items:end;margin:0 0 .25rem">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="/cp/collections-dunning-app" />
                                        <input type="hidden" name="action" value="update_status" />
                                        <input type="hidden" name="queueId" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                        <select name="status">
                                            <option value="open">open</option>
                                            <option value="in_progress">in_progress</option>
                                            <option value="promised">promised</option>
                                            <option value="partial">partial</option>
                                            <option value="paid">paid</option>
                                            <option value="written_off">written_off</option>
                                            <option value="disputed">disputed</option>
                                        </select>
                                        <button type="submit">Status</button>
                                    </form>
                                    <form method="post" action="/cp/collections-dunning/write" style="display:inline-flex;flex-wrap:wrap;gap:.25rem;align-items:end;margin:0">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="/cp/collections-dunning-app" />
                                        <input type="hidden" name="action" value="record_payment" />
                                        <input type="hidden" name="queueId" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                        <input type="number" name="amount" min="0.01" step="0.01" required style="width:5.5rem" title="Payment" />
                                        <button type="submit">Pay</button>
                                    </form>
                                }
                                else
                                {
                                    <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a>
                                }
                            </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/epc_collections_dunning";
    private bool _isAdmin;
    private CpCollectionsDunningSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpCollectionsDunningQueueDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private string _siteKey = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        if (ctx.Items[TenantResolutionMiddleware.HttpContextItemKey] is TenantContext tenant
            && !string.IsNullOrWhiteSpace(tenant.SiteKey))
        {
            _siteKey = tenant.SiteKey;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpCollectionsDunningDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Queue;
        _source = result.Source;
        _message = result.Message;
    }
}
