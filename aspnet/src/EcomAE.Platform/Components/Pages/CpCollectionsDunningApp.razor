@page "/cp/collections-dunning-app"
@page "/erp/collections-dunning-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Middleware
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Collections dunning · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Collections dunning
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Queue status, payment, profile, add-invoice, and step process write here. Schema-ensure stays on the Classic twin. Case status is a separate ERP form below. Open a row to see notes and the action log.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/collections-dunning-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedDetail is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Collections dunning KPIs">
        <div class="kpi"><div class="lbl">Queue</div><div class="val">@_summary.QueueCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open</div><div class="val">@_summary.OpenCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Profiles</div><div class="val">@_summary.ProfileCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Log</div><div class="val">@_summary.LogCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <form method="post" action="/erp/collections/cases/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_listHref" />
            <label>Customer id <input type="number" name="customer_id" min="0" style="width:6rem" /></label>
            <label>Status
                <select name="status">
                    <option value="new">new</option>
                    <option value="in_progress">in_progress</option>
                    <option value="promise_to_pay">promise_to_pay</option>
                    <option value="escalated">escalated</option>
                    <option value="resolved">resolved</option>
                </select>
            </label>
            <label>Balance <input type="number" name="balance" step="0.01" min="0" style="width:7rem" /></label>
            <label>Assigned to <input type="text" name="assigned_to" maxlength="120" /></label>
            <button type="submit">Save case</button>
        </form>
        <form method="post" action="/cp/collections-dunning/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <input type="hidden" name="action" value="update_status" />
            <label>Queue id <input type="number" name="queueId" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
            <label>Queue status
                <select name="status">
                    <option value="open">open</option>
                    <option value="in_progress">in_progress</option>
                    <option value="promised">promised</option>
                    <option value="partial">partial</option>
                    <option value="paid">paid</option>
                    <option value="written_off">written_off</option>
                    <option value="disputed">disputed</option>
                </select>
            </label>
            <label>Notes <input type="text" name="notes" maxlength="400" /></label>
            <button type="submit">Set queue status</button>
        </form>
        <form method="post" action="/cp/collections-dunning/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <input type="hidden" name="action" value="record_payment" />
            <label>Queue id <input type="number" name="queueId" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
            <label>Amount <input type="number" name="amount" min="0.01" step="0.01" required style="width:7rem" /></label>
            <button type="submit">Record payment</button>
        </form>
        <form method="post" action="/cp/collections-dunning/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_listHref" />
            <input type="hidden" name="action" value="create_profile" />
            <input type="hidden" name="siteKey" value="@_siteKey" />
            <label>Profile name <input type="text" name="name" maxlength="128" required /></label>
            <button type="submit">Create profile</button>
        </form>
        <form id="erp-module-new" method="post" action="/cp/collections-dunning/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_listHref" />
            <input type="hidden" name="action" value="add_invoice" />
            <input type="hidden" name="siteKey" value="@_siteKey" />
            <label>Customer id <input type="number" name="customerId" min="0" style="width:6rem" /></label>
            <label>Customer <input type="text" name="customerName" maxlength="128" /></label>
            <label>Invoice <input type="text" name="invoiceRef" maxlength="64" required /></label>
            <label>Amount <input type="number" name="invoiceAmount" min="0" step="0.01" required style="width:7rem" /></label>
            <label>Due <input type="date" name="dueDate" /></label>
            <label>Profile id <input type="number" name="profileId" min="0" style="width:6rem" /></label>
            <button type="submit">Add invoice</button>
        </form>
        <form method="post" action="/cp/collections-dunning/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <input type="hidden" name="action" value="process" />
            <input type="hidden" name="siteKey" value="@_siteKey" />
            <button type="submit">Process dunning steps</button>
        </form>
        <form method="post" action="/erp/collections/cases/status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Case id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <label>Status
                <select name="status">
                    <option value="new">new</option>
                    <option value="in_progress">in_progress</option>
                    <option value="promise_to_pay">promise_to_pay</option>
                    <option value="escalated">escalated</option>
                    <option value="resolved">resolved</option>
                </select>
            </label>
            <button type="submit">Set case status</button>
        </form>
        <form method="post" action="/erp/collections/cases/promise" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Case id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <label>Amount <input type="number" name="amount" step="0.01" style="width:7rem" /></label>
            <label>Promise date <input type="date" name="promise_date" /></label>
            <button type="submit">Record promise</button>
        </form>
        <form method="post" action="/erp/collections/activity/log" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Case id <input type="number" name="case_id" min="1" required style="width:6rem" /></label>
            <label>Type
                <select name="type">
                    <option value="call">call</option>
                    <option value="email">email</option>
                    <option value="letter">letter</option>
                    <option value="note">note</option>
                </select>
            </label>
            <label>Outcome <input type="text" name="outcome" maxlength="200" /></label>
            <label>Amount <input type="number" name="amount" step="0.01" style="width:7rem" /></label>
            <button type="submit">Log activity</button>
        </form>
        <form method="post" action="/erp/collections/hold/set" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Customer id <input type="number" name="customer_id" min="1" required style="width:6rem" /></label>
            <label>Action
                <select name="place">
                    <option value="1">place</option>
                    <option value="0">release</option>
                </select>
            </label>
            <label>Reason <input type="text" name="reason" maxlength="255" /></label>
            <button type="submit">Set credit hold</button>
        </form>
        <form method="post" action="/erp/collections/dunning/run" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Customers <textarea name="customers" rows="3" cols="42" placeholder="customerId|d1_30|d31_60|d61_90|d90_plus"></textarea></label>
            <button type="submit">Run dunning</button>
        </form>
    }

    @if (_openedDetail is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedDetail.InvoiceRef) ? _openedDetail.InvoiceRef : ("#" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedDetail.Status) ? _openedDetail.Status : "—")</span>
                </div>
                <div class="panel-body">
                    <p>Customer: <strong>@(!string.IsNullOrWhiteSpace(_openedDetail.CustomerName) ? _openedDetail.CustomerName : "—")</strong>
                        (#@_openedDetail.CustomerId.ToString(CultureInfo.InvariantCulture))</p>
                    <p>Amount due: <strong>@_openedDetail.AmountDue.ToString("N2", CultureInfo.InvariantCulture)</strong>
                        of @_openedDetail.InvoiceAmount.ToString("N2", CultureInfo.InvariantCulture)
                        · @_openedDetail.DaysOverdue.ToString(CultureInfo.InvariantCulture) days overdue
                        · step @_openedDetail.DunningStep.ToString(CultureInfo.InvariantCulture)</p>
                    <p>Due @(!string.IsNullOrWhiteSpace(_openedDetail.DueDate) ? _openedDetail.DueDate : "—")
                        @if (!string.IsNullOrWhiteSpace(_openedDetail.NextActionDate))
                        {
                            <span> · next @_openedDetail.NextActionDate</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_openedDetail.ProfileName))
                        {
                            <span> · @_openedDetail.ProfileName</span>
                        }
                    </p>
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.Notes))
                    {
                        <p class="text-muted">@_openedDetail.Notes</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Action log</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>When</th>
                                    <th>Action</th>
                                    <th>Details</th>
                                    <th>By</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedLog.Count == 0)
                                {
                                    <tr><td colspan="4">No log yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var entry in _openedLog)
                                    {
                                        <tr>
                                            <td>@(!string.IsNullOrWhiteSpace(entry.PerformedAt) ? entry.PerformedAt : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(entry.ActionType) ? entry.ActionType : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(entry.Details) ? entry.Details : "—")</td>
                                            <td>@(entry.PerformedBy > 0 ? entry.PerformedBy.ToString(CultureInfo.InvariantCulture) : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_summary.QueueCount.ToString(CultureInfo.InvariantCulture) queue · @_summary.OpenCount.ToString(CultureInfo.InvariantCulture) open · @_summary.ProfileCount.ToString(CultureInfo.InvariantCulture) profiles · @_summary.LogCount.ToString(CultureInfo.InvariantCulture) log.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Site</th>
                                <th>Customer</th>
                                <th>Invoice</th>
                                <th>Due</th>
                                <th>Amount due</th>
                                <th>Overdue</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_rows.Count == 0)
                            {
                                <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
                            }
                            else
                            {
                                @foreach (var row in _rows)
                                {
                                    <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                        <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.SiteKey) ? row.SiteKey : "—")</td>
                                        <td>@row.CustomerId.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.InvoiceRef) ? row.InvoiceRef : "—")</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.DueDate) ? row.DueDate : "—")</td>
                                        <td>@row.AmountDue.ToString("N2", CultureInfo.InvariantCulture)</td>
                                        <td>@row.DaysOverdue.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                                        <td>
                                            <a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "queue_id", row.Id)">Open</a>
                                            @if (_isAdmin)
                                            {
                                                <form method="post" action="/cp/collections-dunning/write" style="display:inline-flex;flex-wrap:wrap;gap:.25rem;align-items:end;margin:.25rem 0 0">
                                                    <input type="hidden" name="confirmWrites" value="true" />
                                                    <input type="hidden" name="returnUrl" value="@_returnHref" />
                                                    <input type="hidden" name="action" value="update_status" />
                                                    <input type="hidden" name="queueId" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                                    <select name="status">
                                                        <option value="open">open</option>
                                                        <option value="in_progress">in_progress</option>
                                                        <option value="promised">promised</option>
                                                        <option value="partial">partial</option>
                                                        <option value="paid">paid</option>
                                                        <option value="written_off">written_off</option>
                                                        <option value="disputed">disputed</option>
                                                    </select>
                                                    <button type="submit">Status</button>
                                                </form>
                                                <form method="post" action="/cp/collections-dunning/write" style="display:inline-flex;flex-wrap:wrap;gap:.25rem;align-items:end;margin:.25rem 0 0">
                                                    <input type="hidden" name="confirmWrites" value="true" />
                                                    <input type="hidden" name="returnUrl" value="@_returnHref" />
                                                    <input type="hidden" name="action" value="record_payment" />
                                                    <input type="hidden" name="queueId" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                                    <input type="number" name="amount" min="0.01" step="0.01" required style="width:5.5rem" title="Payment" />
                                                    <button type="submit">Pay</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/epc_collections_dunning";
    private bool _isAdmin;
    private CpCollectionsDunningSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpCollectionsDunningQueueDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private string _siteKey = "";
    private long _openedId;
    private CpCollectionsDunningQueueDetail? _openedDetail;
    private IReadOnlyList<CpCollectionsDunningLogDigest> _openedLog = [];
    private string _listHref = "/cp/collections-dunning-app";
    private string _returnHref = "/cp/collections-dunning-app";

    private string OpenedCaption => _openedDetail is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedDetail.InvoiceRef) ? ("Queue #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.InvoiceRef)
            + " · " + (string.IsNullOrWhiteSpace(_openedDetail.Status) ? "open" : _openedDetail.Status);

    private string OpenedIdValue => _openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var path = ctx.Request.Path.Value;
        _listHref = string.Equals(path, "/erp/collections-dunning-app", StringComparison.OrdinalIgnoreCase)
            ? "/erp/collections-dunning-app"
            : "/cp/collections-dunning-app";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "queue_id");
        _returnHref = _openedId > 0
            ? ErpRecordOpen.Href(_listHref, "queue_id", _openedId).Split('#')[0]
            : _listHref;
        if (ctx.Items[TenantResolutionMiddleware.HttpContextItemKey] is TenantContext tenant
            && !string.IsNullOrWhiteSpace(tenant.SiteKey))
        {
            _siteKey = tenant.SiteKey;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpCollectionsDunningDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Queue;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpCollectionsDunningDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Queue;
            _openedLog = detail.Log;
            if (_openedDetail is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
