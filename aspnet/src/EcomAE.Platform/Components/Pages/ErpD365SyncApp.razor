@page "/erp/d365-sync"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@using System.Web
@using System.Text.Json
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@using EcomAE.Platform.Cp
@inject ICpCsrfGuard Csrf
@inject IErpWriteConnectionFactory Connections
@inject IErpD365ConnectorService D365
@inject IErpD365MappingService D365Map

<PageTitle>D365 sync · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<style>
    .tg-card { background:#fff; border:1px solid #dde6ee; border-radius:10px; padding:16px 18px; margin:0 0 16px; box-shadow:0 1px 2px rgba(16,42,66,.05); }
    .tg-card h3 { margin:0 0 8px; font-size:15px; color:#12324f; }
    .tg-card p, .tg-card li { font-size:12.5px; color:#40566c; line-height:1.55; }
    .tg-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:14px; }
    .tg-form label { display:block; font-size:11px; color:#4a627a; margin:8px 0 2px; }
    .tg-form input, .tg-form select { width:100%; box-sizing:border-box; border:1px solid #c3d3de; border-radius:6px; padding:6px 8px; font-size:12.5px; }
    .tg-form button { margin-top:10px; background:#12324f; color:#fff; border:0; border-radius:6px; padding:7px 14px; font-size:12.5px; cursor:pointer; }
    .tg-flash { border-radius:8px; padding:10px 14px; margin:0 0 16px; font-size:13px; }
    .tg-flash-ok { background:#e8f6ee; border:1px solid #9fd8b6; color:#0f6b3f; }
    .tg-flash-err { background:#fdeaea; border:1px solid #f0b4b4; color:#9c1c1c; }
    .tg-table { width:100%; border-collapse:collapse; font-size:12px; }
    .tg-table th, .tg-table td { border-bottom:1px solid #e4ecf2; padding:6px 8px; text-align:left; }
    .tg-table th { color:#12324f; background:#f4f8fb; }
    .tg-pill { display:inline-block; border-radius:999px; padding:2px 10px; font-size:11px; font-weight:600; }
    .tg-pill-ok { background:#e8f6ee; color:#0f6b3f; }
    .tg-pill-warn { background:#fff3d6; color:#8a5a00; }
    .tg-pill-err { background:#fdeaea; color:#9c1c1c; }
    .tg-payload { font-family:ui-monospace,Consolas,monospace; font-size:11px; color:#33465a; white-space:pre-wrap; word-break:break-all; max-width:520px; }
    details.tg-obj summary { cursor:pointer; color:#1c5d96; font-size:12px; }
    table.tg-fields { border-collapse:collapse; margin:6px 0; font-size:11.5px; max-width:560px; }
    .tg-field-name { color:#12324f; font-weight:600; padding:2px 10px 2px 0; vertical-align:top; white-space:nowrap; }
    .tg-field-value { color:#40566c; padding:2px 0; vertical-align:top; word-break:break-word; }
</style>

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="D365 sync" BreadcrumbArea="Organization" BreadcrumbTab="D365 sync">
    <PhpErpModulePageHeader
        Title="D365 sync"
        Subtitle="Live Finance &amp; Operations connection — Entra client-credentials token, OData data-entity pulls into staging, one-way D365 → EcomAE."
        PhpTabHref="/erp/d365-sync" />

    @if (_flashOk.Length > 0)
    {
        <div class="tg-flash tg-flash-ok">@_flashOk</div>
    }
    @if (_flashErr.Length > 0)
    {
        <div class="tg-flash tg-flash-err">@_flashErr</div>
    }

    <div class="tg-grid">
        <div class="tg-card">
            <h3>Connection</h3>
            @if (_status is null)
            {
                <p><span class="tg-pill tg-pill-warn">unconfigured</span></p>
                <p>Set <code>D365:EnvironmentUrl</code> plus either an Entra app registration (<code>TenantId</code> / <code>ClientId</code> / <code>ClientSecret</code>) or a service-account login (<code>Username</code> / <code>Password</code>) — or the <code>ECOMAE_D365_*</code> environment variables — on the platform host, then restart the service.</p>
            }
            else
            {
                <p>
                    <span class="tg-pill @(_status.Configured ? "tg-pill-ok" : "tg-pill-warn")">@(_status.Configured ? "configured" : "missing secrets")</span>
                    <span class="tg-pill @(_status.SyncEnabled ? "tg-pill-ok" : "tg-pill-err")">@(_status.SyncEnabled ? "sync on" : "sync off")</span>
                </p>
                <p>Environment: <strong>@(_status.EnvironmentUrl ?? "—")</strong></p>
                <p>Last run: @(_status.LastRunStatus ?? "none yet")@(_status.LastRunAt is { } at ? $" · {at.UtcDateTime:yyyy-MM-dd HH:mm} UTC" : "")</p>
                <p>Staged objects: <strong>@_status.StagedObjectCount</strong></p>
                @if (!_status.SyncEnabled)
                {
                    <p>Pulls and applies are disabled — the connection stays configured.</p>
                }
            }
            @if (_isAdmin)
            {
                <details class="tg-form" style="margin-bottom:10px">
                    <summary style="cursor:pointer;font-weight:600">Credentials @( (_status?.Configured ?? false) ? "— saved" : "— required before connecting")</summary>
                    <form method="post" action="@Post("/erp/d365/save-connection")">
                        @HiddenFields()
                        <label>Environment URL</label>
                        <input name="environment_url" type="url" placeholder="https://sham.operations.uae.dynamics.com" value="@(_status?.EnvironmentUrl)" />
                        <label>Username (service-account login)</label>
                        <input name="username" type="text" autocomplete="off" placeholder="user@tenant.com" />
                        <label>Password</label>
                        <input name="password" type="password" autocomplete="new-password" />
                        <label>Tenant id (optional — Entra app registration)</label>
                        <input name="tenant_id" type="text" autocomplete="off" />
                        <label>Client id (optional)</label>
                        <input name="client_id" type="text" autocomplete="off" />
                        <label>Client secret (optional)</label>
                        <input name="client_secret" type="password" autocomplete="new-password" />
                        <button type="submit">Save credentials</button>
                        <p style="font-size:12px;color:#557">Saved to the tenant parameter store — blank fields keep any host-env value; secrets are never echoed back.</p>
                    </form>
                </details>
                <form method="post" action="@Post("/erp/d365/connect-test")" class="tg-form">
                    @HiddenFields()
                    <button type="submit">Test connection</button>
                </form>
                <form method="post" action="@Post("/erp/d365/sync-toggle")" class="tg-form">
                    @HiddenFields()
                    <input type="hidden" name="enabled" value="@((_status?.SyncEnabled ?? false) ? "0" : "1")" />
                    <button type="submit">@((_status?.SyncEnabled ?? false) ? "Switch sync off" : "Switch sync on")</button>
                </form>
            }
        </div>

        <div class="tg-card tg-form">
            <h3>Browse staged objects</h3>
            <p>Filter the staged-object grid below to one entity.</p>
            <form method="get" action="@Post("/erp/d365-sync")">
                <label>Entity</label>
                <select name="entity">
                    <option value="">— all entities —</option>
                    @foreach (var kv in ErpD365ConnectorService.KnownEntities)
                    {
                        <option value="@kv.Key" selected="@(kv.Key == _entityFilter)">@kv.Value — @kv.Key</option>
                    }
                </select>
                <button type="submit">Filter</button>
            </form>
        </div>

        <div class="tg-card tg-form">
            <h3>Apply staged → modules</h3>
            <p>Moves the staged rows for one entity into its operational master — customers to the customer master, products to inventory items, orders to the document tables. Applies in batches of 400 — repeat until the message says nothing remains.</p>
            <form method="post" action="@Post("/erp/d365/apply-staged")">
                @HiddenFields()
                <label>Data entity</label>
                <select name="entity">
                    @foreach (var kv in D365Map.MappedEntities)
                    {
                        <option value="@kv.Key">@kv.Key → @kv.Value</option>
                    }
                </select>
                <button type="submit">Apply staged rows</button>
            </form>
        </div>

        <div class="tg-card tg-form">
            <h3>Pull a data entity</h3>
            <p>Reads the F&amp;O OData data entity into <code>epc_d365_sync_objects</code> staging — upserts by external key, never half-writes a master. Large entities stream in passes (max rows 0 = all); repeat the pull until the run log shows <em>ok</em>.</p>
            <form method="post" action="@Post("/erp/d365/connect-pull")">
                @HiddenFields()
                <label>Data entity</label>
                <select name="entity">
                    @foreach (var kv in ErpD365ConnectorService.KnownEntities)
                    {
                        <option value="@kv.Key">@kv.Value — @kv.Key</option>
                    }
                </select>
                <label>Max rows (0 = all, resumes each pass)</label>
                <input name="top" value="0" />
                <button type="submit">Pull into staging</button>
            </form>
        </div>
    </div>

    <div class="tg-card">
        <h3>Recent runs</h3>
        @if (_runs.Count == 0)
        {
            <p>No sync runs yet.</p>
        }
        else
        {
            <table class="tg-table">
                <thead><tr><th>Run</th><th>Entity</th><th>Status</th><th>Fetched</th><th>Staged</th><th>Started</th><th>Error</th></tr></thead>
                <tbody>
                @foreach (var r in _runs)
                {
                    <tr>
                        <td>#@r.Id</td>
                        <td>@r.Entity</td>
                        <td><span class="tg-pill @(r.Status == "ok" ? "tg-pill-ok" : r.Status == "running" || r.Status == "partial" ? "tg-pill-warn" : "tg-pill-err")">@r.Status</span></td>
                        <td>@r.Fetched</td>
                        <td>@r.Staged</td>
                        <td>@(r.StartedAt > 0 ? DateTimeOffset.FromUnixTimeSeconds(r.StartedAt).UtcDateTime.ToString("yyyy-MM-dd HH:mm") : "—")</td>
                        <td style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@r.Error</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

    <div class="tg-card">
        <h3>Staged objects@(string.IsNullOrWhiteSpace(_entityFilter) ? "" : " — " + _entityFilter)</h3>
        <p>The pulled rows land here (latest first). The raw F&amp;O payload is shown per row — expand to inspect the exact fields SHAM sends.</p>
        @if (_objects.Count == 0)
        {
            <p>No staged objects yet — pull an entity above.</p>
        }
        else
        {
            <table class="tg-table">
                <thead><tr><th>Entity</th><th>External key</th><th>Synced</th><th>Payload</th></tr></thead>
                <tbody>
                @foreach (var o in _objects)
                {
                    <tr>
                        <td>@o.Entity</td>
                        <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@o.ExternalKey</td>
                        <td>@(o.SyncedAt > 0 ? DateTimeOffset.FromUnixTimeSeconds(o.SyncedAt).UtcDateTime.ToString("yyyy-MM-dd HH:mm") : "—")</td>
                        <td>
                            <details class="tg-obj">
                                <summary>@FieldSummary(o.Payload)</summary>
                                <table class="tg-fields">
                                    @foreach (var f in ParseFields(o.Payload))
                                    {
                                        <tr><td class="tg-field-name">@f.Key</td><td class="tg-field-value">@f.Value</td></tr>
                                    }
                                </table>
                                <details class="tg-obj">
                                    <summary>Raw payload</summary>
                                    <div class="tg-payload">@o.Payload</div>
                                </details>
                            </details>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

    <div class="tg-card">
        <h3>Trial balance — EcomAE vs D365 F&amp;O</h3>
        <p>Live compare per account + dimension. Pull <code>TrialBalanceFiscalYearSnapshots</code> (the F&amp;O TB source) to refresh the D365 side; every row must show <em>match</em> for the books to reconcile.</p>
        @if (_tb.Rows.Count == 0)
        {
            <p>Nothing to compare yet — pull <code>TrialBalanceFiscalYearSnapshots</code> and the journal feeds (headers + lines), apply them, then reload.</p>
        }
        else
        {
            var matched = _tb.Rows.Count(r => r.Matches);
            <p>
                <span class="tg-pill @(matched == _tb.Rows.Count ? "tg-pill-ok" : "tg-pill-warn")">@matched / @_tb.Rows.Count accounts match</span>
                <span class="tg-pill @(_tb.TotalsMatch ? "tg-pill-ok" : "tg-pill-err")">@(_tb.TotalsMatch ? "debit + credit totals match" : "totals differ")</span>
            </p>
            <table class="tg-table">
                <thead><tr><th>Account</th><th>Name</th><th>Dimension</th><th style="text-align:right">EcomAE</th><th style="text-align:right">D365</th><th style="text-align:right">Diff</th><th></th></tr></thead>
                <tbody>
                @foreach (var r in _tb.Rows)
                {
                    <tr>
                        <td>@r.AccountCode</td>
                        <td>@r.AccountName</td>
                        <td>@r.Dimension</td>
                        <td style="text-align:right">@r.EcomAeBalance.ToString("N2")</td>
                        <td style="text-align:right">@r.D365Balance.ToString("N2")</td>
                        <td style="text-align:right">@r.Difference.ToString("N2")</td>
                        <td><span class="tg-pill @(r.Matches ? "tg-pill-ok" : "tg-pill-err")">@(r.Matches ? "match" : "diff")</span></td>
                    </tr>
                }
                <tr style="font-weight:600;border-top:2px solid #888">
                    <td colspan="3">Total debit</td>
                    <td style="text-align:right">@_tb.EcomAeDebit.ToString("N2")</td>
                    <td style="text-align:right">@_tb.D365Debit.ToString("N2")</td>
                    <td style="text-align:right">@((_tb.EcomAeDebit - _tb.D365Debit).ToString("N2"))</td>
                    <td rowspan="2"><span class="tg-pill @(_tb.TotalsMatch ? "tg-pill-ok" : "tg-pill-err")">@(_tb.TotalsMatch ? "match" : "diff")</span></td>
                </tr>
                <tr style="font-weight:600">
                    <td colspan="3">Total credit</td>
                    <td style="text-align:right">@_tb.EcomAeCredit.ToString("N2")</td>
                    <td style="text-align:right">@_tb.D365Credit.ToString("N2")</td>
                    <td style="text-align:right">@((_tb.EcomAeCredit - _tb.D365Credit).ToString("N2"))</td>
                </tr>
                </tbody>
            </table>
        }
    </div>

    <div class="tg-card">
        <h3>Inventory on-hand — EcomAE vs D365 F&amp;O</h3>
        <p>Per warehouse: our stock qty + value vs D365 <code>WarehousesOnHandV2</code> (pull + apply it). Value on the D365 side reconciles through the inventory GL accounts in the TB above.</p>
        @if (_inv.Count == 0)
        {
            <p>No on-hand data yet — pull and apply <code>WarehousesOnHandV2</code>.</p>
        }
        else
        {
            var invMatch = _inv.Count(r => r.QtyMatches);
            <p><span class="tg-pill @(invMatch == _inv.Count ? "tg-pill-ok" : "tg-pill-warn")">@invMatch / @_inv.Count warehouses match on qty</span></p>
            <table class="tg-table">
                <thead><tr><th>Warehouse</th><th style="text-align:right">EcomAE qty</th><th style="text-align:right">EcomAE value</th><th style="text-align:right">D365 qty</th><th style="text-align:right">D365 available</th><th></th></tr></thead>
                <tbody>
                @foreach (var r in _inv)
                {
                    <tr>
                        <td>@r.Warehouse</td>
                        <td style="text-align:right">@r.EcomAeQty.ToString("N3")</td>
                        <td style="text-align:right">@r.EcomAeValue.ToString("N2")</td>
                        <td style="text-align:right">@r.D365Qty.ToString("N3")</td>
                        <td style="text-align:right">@r.D365Avail.ToString("N3")</td>
                        <td><span class="tg-pill @(r.QtyMatches ? "tg-pill-ok" : "tg-pill-err")">@(r.QtyMatches ? "match" : "diff")</span></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private string _csrf = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private ErpD365ConnectionStatus? _status;
    private IReadOnlyList<ErpD365SyncRun> _runs = Array.Empty<ErpD365SyncRun>();
    private IReadOnlyList<ErpD365StagedObject> _objects = Array.Empty<ErpD365StagedObject>();
    private ErpD365TbCompare _tb = new(Array.Empty<ErpD365TbCompareRow>(), 0m, 0m, 0m, 0m);
    private IReadOnlyList<ErpD365InvCompareRow> _inv = Array.Empty<ErpD365InvCompareRow>();
    private string _entityFilter = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted).ConfigureAwait(false);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        _csrf = await Csrf.KeyForAsync(ctx, session, ctx.RequestAborted).ConfigureAwait(false);
        _flashOk = ctx.Request.Query["ok"].ToString();
        _flashErr = ctx.Request.Query["err"].ToString();
        _entityFilter = ctx.Request.Query["entity"].ToString();

        try
        {
            if (Connections.IsConfigured)
            {
                await using var conn = await Connections.OpenAsync(ctx.RequestAborted).ConfigureAwait(false);
                _status = await D365.GetStatusAsync(conn, ctx.RequestAborted).ConfigureAwait(false);
                _runs = await D365.RecentRunsAsync(conn, 25, ctx.RequestAborted).ConfigureAwait(false);
                _objects = await D365.StagedObjectsAsync(conn,
                    string.IsNullOrWhiteSpace(_entityFilter) ? null : _entityFilter,
                    50, ctx.RequestAborted).ConfigureAwait(false);
                _tb = await D365Map.TrialBalanceCompareAsync(conn, ctx.RequestAborted).ConfigureAwait(false);
                _inv = await D365Map.InventoryCompareAsync(conn, ctx.RequestAborted).ConfigureAwait(false);
            }
        }
        catch
        {
            // Status load is best-effort; the forms still post.
        }
    }

    private string Post(string path) => ClientErpPath.PrefixIfBound(Http.HttpContext!, path);

    private static string ShortPayload(string payload)
    {
        var text = payload.Length > 140 ? payload[..140] + "…" : payload;
        return text.Replace('\n', ' ').Replace('\r', ' ');
    }

    private static string FieldSummary(string payload)
    {
        var fields = ParseFields(payload);
        return fields.Count == 0 ? ShortPayload(payload) : $"{fields.Count} fields — expand to view all";
    }

    private static List<KeyValuePair<string, string>> ParseFields(string payload)
    {
        var list = new List<KeyValuePair<string, string>>();
        try
        {
            using var doc = JsonDocument.Parse(payload);
            if (doc.RootElement.ValueKind != JsonValueKind.Object) return list;
            foreach (var property in doc.RootElement.EnumerateObject())
            {
                var text = property.Value.ValueKind == JsonValueKind.String
                    ? property.Value.GetString() ?? ""
                    : property.Value.GetRawText();
                list.Add(new KeyValuePair<string, string>(property.Name, text));
            }
        }
        catch (JsonException)
        {
        }
        return list;
    }

    private MarkupString HiddenFields()
    {
        var returnUrl = HttpUtility.HtmlAttributeEncode(
            (Http.HttpContext?.Request.Path.Value ?? "/erp/d365-sync") + Http.HttpContext?.Request.QueryString.Value);
        return (MarkupString)(
            $"<input type=\"hidden\" name=\"confirmWrites\" value=\"true\" />"
            + $"<input type=\"hidden\" name=\"returnUrl\" value=\"{returnUrl}\" />"
            + $"<input type=\"hidden\" name=\"csrf_guard_key\" value=\"{HttpUtility.HtmlAttributeEncode(_csrf)}\" />");
    }
}
