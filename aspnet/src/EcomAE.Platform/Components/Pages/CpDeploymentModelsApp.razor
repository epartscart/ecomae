@page "/cp/deployment-models-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ICpTenantControlCenterService ControlCenter
@inject IHybridSyncService HybridSync
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Cloud · on-premises · hybrid · Control Panel</PageTitle>
<PhpChromeStyles Surface="cp" />

@if (_allowed)
{
    <PhpCpDesktopChrome IsAdmin="_isAdmin">
    <PhpParityModuleBody AppPath="/cp/deployment-models-app" IsAdmin="_isAdmin" />

        <PhpCpModulePageHeader Title="ERP deployment models"
                               Subtitle="On cloud, on premises, and hybrid — the three ways a company runs ECOM AE ERP. Super CP only."
                               PhpTabHref="@_phpTab"
                               ExtraPanelClass="epc-scp-panel--deploy">
            <a class="ghost" href="/cp/tenants-app">Tenants</a>
            <a class="ghost" href="/cp/client-erp">Client ERP</a>
            <a class="ghost" href="/erp/on-premises-app">On-premises licenses</a>
            <a class="ghost" href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a>
        </PhpCpModulePageHeader>

        <p class="help-block">
            New on-premises installs use the platform pack only: download it and double-click <code>setup.cmd</code> on Windows or run <code>install.sh</code> on Linux.
            The leftover installer is not for new work. Cloud leftover files stay on disk as fallback until <code>ReadyToRemovePhp</code>.
            Hybrid sync is outbound HTTPS: masters from the cloud, transactions from the site, conflicts queued — never silently overwritten.
            This page does not invent a send.
        </p>

        <div class="epc-scp-kpi" aria-label="Deployment KPIs">
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">Cloud tenants</div>
                <div class="epc-scp-kpi__val">@_cloud</div>
            </div>
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">On-prem licenses</div>
                <div class="epc-scp-kpi__val">@_onPremLicenses</div>
            </div>
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">Hybrid</div>
                <div class="epc-scp-kpi__val">@_hybrid</div>
            </div>
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">Models</div>
                <div class="epc-scp-kpi__val">3</div>
            </div>
        </div>

        <div class="epc-scp-table-card" style="margin-bottom:1rem;padding:1.1rem 1.15rem">
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));gap:1rem">
                @foreach (var model in CpDeploymentModelsCatalog.Models)
                {
                    <div>
                        <h3 style="margin:0 0 .35rem;font-size:1.05rem">
                            @model.Title
                            <span class="label @model.StatusClass">@model.Status</span>
                        </h3>
                        <p class="help-block" style="margin:0 0 .55rem">@model.Summary</p>
                        <p style="margin:0 0 .4rem"><a href="@model.WhereToOpen">Open @model.WhereToOpen</a></p>
                        <p class="help-block" style="margin:0 0 .2rem"><strong>Built</strong></p>
                        <ul style="margin:0 0 .55rem;padding-left:1.2rem">
                            @foreach (var live in model.Lives)
                            {
                                <li>@live</li>
                            }
                        </ul>
                        <p class="help-block" style="margin:0 0 .2rem"><strong>Still missing</strong></p>
                        <ul style="margin:0;padding-left:1.2rem">
                            @foreach (var gap in model.Missing)
                            {
                                <li>@gap</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>

        <div class="epc-scp-table-card" style="margin-bottom:1rem;padding:1.1rem 1.15rem">
            <h3 style="margin:0 0 .7rem;font-size:1.05rem">Setup packs — Windows setup.exe or Linux ecomae-setup</h3>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(18rem,1fr));gap:1.1rem">
                @foreach (var kind in new[] { "on-premises-aspnet", "hybrid", "on-premises" })
                {
                    var files = CpDeploymentSetupPackCatalog.ForKind(kind);
                    var title = kind switch
                    {
                        "on-premises-aspnet" => "On premises (platform pack — use this)",
                        "hybrid" => "Hybrid (platform ERP + sync agent)",
                        _ => "On premises leftover (do not use for new installs)",
                    };
                    <div>
                        <p style="margin:0 0 .45rem">
                            <strong>@title</strong>
                        </p>
                        <p style="margin:0 0 .55rem">
                            <a class="ghost" href="/cp/deployment-models/setup-pack?kind=@kind">Download @kind zip</a>
                            @if (kind != "on-premises")
                            {
                                <a class="ghost" href="/cp/deployment-models/setup-file?kind=@kind&amp;file=setup.exe">Windows setup.exe</a>
                                <a class="ghost" href="/cp/deployment-models/setup-file?kind=@kind&amp;file=ecomae-setup">Linux ecomae-setup</a>
                            }
                        </p>
                        <ul style="margin:0;padding-left:1.2rem">
                            @foreach (var file in files)
                            {
                                <li>
                                    <a href="/cp/deployment-models/setup-file?kind=@kind&amp;file=@Uri.EscapeDataString(file.RelativePath)">@file.RelativePath</a>
                                    <span class="help-block" style="display:inline"> — @file.Title</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
            <p class="help-block" style="margin:.85rem 0 0">
                Windows: unzip the pack and double-click <code>setup.exe</code> (or <code>setup.cmd</code>).
                Linux: <code>chmod +x ecomae-setup &amp;&amp; sudo ./ecomae-setup --host erp.company.com --db-password PASS</code>.
                Hybrid: register the site, then run the same <code>setup.exe</code> / <code>ecomae-setup</code> from the hybrid zip
                with <code>--site-key</code> <code>--cloud-url https://www.ecomae.com</code> <code>--enrollment</code> <code>--installation</code>.
                The installer will not invent a password or a send.
                Do not add leftover runtime files to new packs.
            </p>
        </div>

        <div class="epc-scp-table-card" style="margin-bottom:1rem">
            <table class="epc-scp-data-table table table-epc-pro">
                <thead>
                    <tr>
                        <th>Capability</th>
                        <th>On cloud</th>
                        <th>On premises</th>
                        <th>Hybrid</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in CpDeploymentModelsCatalog.Matrix)
                    {
                        <tr>
                            <td>@row.Capability</td>
                            <td>@row.Cloud</td>
                            <td>@row.OnPremises</td>
                            <td>@row.Hybrid</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="epc-scp-table-card" style="margin-bottom:1rem;padding:1.1rem 1.15rem">
            <h3 style="margin:0 0 .5rem;font-size:1.05rem"><i class="fa fa-flask" aria-hidden="true"></i> Sandbox / UAT tier (D365 F&amp;O model)</h3>
            <p class="text-muted" style="margin:0;line-height:1.55">
                Every ERP-only tenant has two environments on one codebase, exactly like D365 F&amp;O production + sandbox:
            </p>
            <ul class="text-muted" style="margin:.4rem 0 .2rem;line-height:1.6">
                <li><strong>Production</strong> — <code>{key}-operations-{ccc}.ecomae.com</code> bound to the live tenant database.</li>
                <li><strong>Sandbox / UAT</strong> — <code>{key}-sandbox-{ccc}.ecomae.com</code> bound to <code>{db}_sandbox</code>, a separate copy. Same build, host-scoped sessions, amber UAT banner inside the ERP.</li>
                <li><strong>Refresh</strong> is prod → sandbox only (D365 "copy production to sandbox"): <code>bash scripts/cloudpanel_sandbox_db_refresh.sh &lt;live_db&gt; &lt;db_user&gt;</code> — staged swap, live stays readable, interrupted refresh never leaves a half-copied sandbox. Never copy sandbox data up to production.</li>
                <li><strong>Provision a new tenant's tier:</strong> <code>bash scripts/cloudpanel_ops_host_provision.sh &lt;key&gt; &lt;ccc&gt; --sandbox</code>, then run the refresh once to seed UAT.</li>
                <li><strong>Security:</strong> the sandbox host proxies only ERP routes (CP/BOS/storefront 404), cookies are host-scoped (a UAT session can never reach live data), and writes resolve <code>{db}_sandbox</code> end-to-end — ePartsCart shared-docpart fallbacks are disabled on sandbox hosts.</li>
            </ul>
        </div>

        <div class="epc-scp-table-card">
            <table class="epc-scp-data-table table table-epc-pro">
                <thead>
                    <tr>
                        <th>Site key</th>
                        <th>Company</th>
                        <th>Type</th>
                        <th>Model</th>
                        <th>ERP login</th>
                        <th>UAT</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_tenants.Count == 0)
                    {
                        <tr><td colspan="5">No registry tenants yet. Create ERP-only companies on Tenants.</td></tr>
                    }
                    else
                    {
                        @foreach (var t in _tenants)
                        {
                            var model = CpDeploymentModelsCatalog.Classify(t.TenantType, t.Hostname, StoredKind(t.SiteKey));
                            <tr>
                                <td><code>@t.SiteKey</code></td>
                                <td>@(string.IsNullOrWhiteSpace(t.TradeName) ? "—" : t.TradeName)</td>
                                <td>@t.TypeLabel</td>
                                <td><span class="label @(model == "cloud" ? "label-success" : model == "hybrid" ? "label-info" : "label-warning")">@model</span></td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(t.ErpOperationsUrl))
                                    {
                                        <a href="@t.ErpOperationsUrl">@t.ErpOperationsUrl</a>
                                        @if (!string.IsNullOrWhiteSpace(t.ErpLoginUrl))
                                        {
                                            <br /><small><a href="@t.ErpLoginUrl" class="text-muted">@t.ErpLoginUrl</a></small>
                                        }
                                    }
                                    else if (!string.IsNullOrWhiteSpace(t.ErpLoginUrl))
                                    {
                                        <a href="@t.ErpLoginUrl">@t.ErpLoginUrl</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(t.ErpSandboxUrl))
                                    {
                                        <a href="@t.ErpSandboxUrl" class="text-warning" title="Sandbox / UAT host — bound to the _sandbox database">@t.ErpSandboxUrl</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="epc-scp-table-card" style="margin-top:1rem">
            <table class="epc-scp-data-table table table-epc-pro">
                <thead>
                    <tr>
                        <th>Hybrid site</th>
                        <th>Installation</th>
                        <th>Cursor</th>
                        <th>Queued conflicts</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_installations.Count == 0)
                    {
                        <tr><td colspan="4">No hybrid installations enrolled yet. Register from Super CP, then run the hybrid pack on the server.</td></tr>
                    }
                    else
                    {
                        @foreach (var inst in _installations)
                        {
                            var cursor = _cursors.FirstOrDefault(c => c.SiteKey == inst.SiteKey && c.InstallationId == inst.InstallationId);
                            var conflicts = _conflicts.Count(c => c.SiteKey == inst.SiteKey);
                            <tr>
                                <td><code>@inst.SiteKey</code> · @inst.DeploymentKind</td>
                                <td><code>@inst.InstallationId</code> · @inst.Status</td>
                                <td>@(cursor is null ? "—" : cursor.Direction + " @" + cursor.LastVersion)</td>
                                <td>@conflicts</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>Deployment models are available on the platform Super CP host only.</p>
        <p><a href="/cp">Open Control Panel</a></p>
    </div>
}

@code {
    private const string _phpTab = "/CP/control/portal/epc_deployment_models";
    private bool _allowed;
    private bool _isAdmin;
    private IReadOnlyList<CpTenantControlRow> _tenants = [];
    private IReadOnlyList<HybridSyncInstallationRow> _installations = [];
    private IReadOnlyList<HybridSyncCursorRow> _cursors = [];
    private IReadOnlyList<HybridSyncConflictRow> _conflicts = [];
    private IReadOnlyDictionary<string, string> _kindBySite = new Dictionary<string, string>(StringComparer.Ordinal);
    private int _cloud;
    private int _hybrid;
    private int _onPremLicenses;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await ControlCenter.LoadAsync(ctx.RequestAborted);
        _tenants = result.Tenants;
        try
        {
            var sync = await HybridSync.StatusAsync(null, ctx.RequestAborted);
            _installations = sync.Installations;
            _cursors = sync.Cursors;
            _conflicts = sync.Conflicts;
            _kindBySite = sync.KindBySiteKey;
        }
        catch
        {
            _installations = [];
        }

        foreach (var tenant in _tenants)
        {
            var model = CpDeploymentModelsCatalog.Classify(tenant.TenantType, tenant.Hostname, StoredKind(tenant.SiteKey));
            if (model == "hybrid")
            {
                _hybrid++;
            }
            else if (model == "on-premises")
            {
            }
            else
            {
                _cloud++;
            }
        }

        _hybrid = Math.Max(_hybrid, _installations.Count(i => i.DeploymentKind == "hybrid"));

        try
        {
            var licenses = await Dashboards.ListOnPremisesLicensesAsync(100, ctx.RequestAborted);
            _onPremLicenses = licenses.Licenses.Count;
        }
        catch
        {
            _onPremLicenses = 0;
        }
    }

    private string? StoredKind(string siteKey)
        => _kindBySite.TryGetValue(siteKey, out var kind) ? kind : null;
}
