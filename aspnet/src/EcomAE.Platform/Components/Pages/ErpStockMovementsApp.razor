@page "/erp/stock-movements-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Components.Shared.Desktop
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Stock movements · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Stock movements" BreadcrumbArea="Inventory & Fulfilment" BreadcrumbTab="Movements">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/stock-movements-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Stock movement ledger" Subtitle="Open a row for the 280-character note excerpt, batch, and total cost. Writes stay on the Classic twin." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row">
        <div class="kpi"><div class="lbl">Movements</div><div class="val">@_summary.MovementCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">In lines</div><div class="val">@_summary.InCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Out lines</div><div class="val">@_summary.OutCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Qty in</div><div class="val">@_summary.TotalInQty.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Qty out</div><div class="val">@_summary.TotalOutQty.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <ErpDocumentWorkspace
                DocumentKind="Stock movement"
                Title="@OpenedCaption"
                DocumentNumber="@_opened.Id.ToString(CultureInfo.InvariantCulture)"
                PartyLabel="Warehouse"
                Party="@(string.IsNullOrWhiteSpace(_opened.WarehouseName) ? _opened.WarehouseId.ToString(CultureInfo.InvariantCulture) : _opened.WarehouseName)"
                ReferenceLabel="Reference"
                Reference="@_opened.Reference"
                Status="@_opened.MovementType"
                ApprovalState="@MovementDirection"
                CompanyContext="Tenant / company"
                Currency="—"
                Fields="@MovementWorkspaceFields"
                Lines="@MovementWorkspaceLines"
                Tabs="@MovementWorkspaceTabs" />
            <p class="text-muted" style="margin:.85rem 0 0">Writes stay on the Classic twin.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.NoteExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">note excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.NoteExcerpt</pre>
                @if (_opened.NoteLen > _opened.NoteExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.NoteExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NoteLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No note excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-warehouse siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>SKU</th>
                            <th>Qty</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.MovementType) ? "—" : sib.MovementType)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Sku) ? "—" : sib.Sku)</td>
                                <td>@sib.Qty.ToString("N3", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "movement_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-warehouse siblings yet.</p>
            }
        </div>
    }

    @if (_byWarehouse.Count > 0 || _byItem.Count > 0)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div>
            <p style="margin:0 0 .4rem"><strong>Movements by warehouse</strong> <span class="text-muted">(top 10)</span></p>
            <table class="table table-bordered table-condensed table-epc epc-erp-table">
                <thead><tr><th>Warehouse</th><th class="text-right">Lines</th><th class="text-right">Qty in</th><th class="text-right">Qty out</th><th class="text-right">Cost</th></tr></thead>
                <tbody>
                    @foreach (var w in _byWarehouse)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(w.WarehouseName) ? ("#" + w.WarehouseId.ToString(CultureInfo.InvariantCulture)) : w.WarehouseName)</td>
                            <td class="text-right">@w.Lines</td>
                            <td class="text-right">@w.QtyIn.ToString("N3", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@w.QtyOut.ToString("N3", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@w.Cost.ToString("N2", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                    <tr style="font-weight:600;background:#f2f6fa">
                        <td>Total</td>
                        <td class="text-right">@_byWarehouse.Sum(w => w.Lines)</td>
                        <td class="text-right">@_byWarehouse.Sum(w => w.QtyIn).ToString("N3", CultureInfo.InvariantCulture)</td>
                        <td class="text-right">@_byWarehouse.Sum(w => w.QtyOut).ToString("N3", CultureInfo.InvariantCulture)</td>
                        <td class="text-right">@_byWarehouse.Sum(w => w.Cost).ToString("N2", CultureInfo.InvariantCulture)</td>
                    </tr>
                </tbody>
            </table>
            </div>
            <div>
            <p style="margin:0 0 .4rem"><strong>Movements by item</strong> <span class="text-muted">(top 10)</span></p>
            <table class="table table-bordered table-condensed table-epc epc-erp-table">
                <thead><tr><th>Item</th><th class="text-right">Lines</th><th class="text-right">Net qty</th><th class="text-right">Cost</th></tr></thead>
                <tbody>
                    @foreach (var r in _byItem)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(r.Label) ? "—" : r.Label)</td>
                            <td class="text-right">@r.Lines</td>
                            <td class="text-right">@r.NetQty.ToString("N3", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@r.Cost.ToString("N2", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                    <tr style="font-weight:600;background:#f2f6fa">
                        <td>Total</td>
                        <td class="text-right">@_byItem.Sum(r => r.Lines)</td>
                        <td class="text-right">@_byItem.Sum(r => r.NetQty).ToString("N3", CultureInfo.InvariantCulture)</td>
                        <td class="text-right">@_byItem.Sum(r => r.Cost).ToString("N2", CultureInfo.InvariantCulture)</td>
                    </tr>
                </tbody>
            </table>
            </div>
            </div>
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th><th>Date</th><th>Type</th><th>Warehouse</th><th>SKU</th><th>Item</th>
                    <th>Qty</th><th>Signed</th><th>Unit cost</th><th>Balance</th><th>Ref</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_movements.Count == 0)
                {
                    <tr><td colspan="12">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var m in _movements)
                    {
                        <tr id="erp-row-@m.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(m.Id, _openedId)">
                            <td>@m.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@m.MovementDate.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@m.MovementType</td>
                            <td>@m.WarehouseName</td>
                            <td>@m.Sku</td>
                            <td>@m.ItemName</td>
                            <td>@m.Qty.ToString("N3", CultureInfo.InvariantCulture)</td>
                            <td>@m.SignedQty.ToString("N3", CultureInfo.InvariantCulture)</td>
                            <td>@m.UnitCost.ToString("N4", CultureInfo.InvariantCulture)</td>
                            <td>@m.RunningBalance.ToString("N3", CultureInfo.InvariantCulture)</td>
                            <td>@m.Reference</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "movement_id", m.Id)">Open</a></td>
                        </tr>
                    }
                    <tr style="font-weight:600;background:#f2f6fa">
                        <td colspan="6">Total</td>
                        <td>@_movements.Sum(m => m.Qty).ToString("N3", CultureInfo.InvariantCulture)</td>
                        <td>@_movements.Sum(m => m.SignedQty).ToString("N3", CultureInfo.InvariantCulture)</td>
                        <td colspan="4" class="text-muted">@_movements.Count movements</td>
                    </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">Source: @_summary.Source. Ledger view for record_movement and transfers. Writes stay on the Classic twin.</div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=inventory_mgmt&tab=ledger";
    private const string _listHref = "/erp/stock-movements-app";
    private bool _isAdmin;
    private string _message = "";
    private ErpInventoryMovementsSummary _summary = new(0, 0, 0, 0, 0, "migration", string.Empty);
    private IReadOnlyList<ErpInventoryMovementDigest> _movements = [];
    private long _openedId;
    private ErpInventoryMovementDetail? _opened;
    private IReadOnlyList<ErpInventoryMovementDigest> _openedSiblings = [];
    private IReadOnlyList<MoveWarehouseRow> _byWarehouse = [];
    private IReadOnlyList<MoveItemRow> _byItem = [];
    private IReadOnlyList<string> MovementWorkspaceTabs => ["General", "Quantity", "Costing", "Traceability"];

    private sealed record MoveWarehouseRow(long WarehouseId, string WarehouseName, int Lines, decimal QtyIn, decimal QtyOut, decimal Cost);
    private sealed record MoveItemRow(long ItemId, string Label, int Lines, decimal NetQty, decimal Cost);

    private IReadOnlyList<ErpDocumentWorkspaceField> MovementWorkspaceFields => _opened is null
        ? []
        : [
            new("Movement date", FormatTime(_opened.MovementDate), "General"),
            new("Movement type", _opened.MovementType, "General"),
            new("Warehouse", string.IsNullOrWhiteSpace(_opened.WarehouseName) ? _opened.WarehouseId.ToString(CultureInfo.InvariantCulture) : _opened.WarehouseName, "General"),
            new("SKU", _opened.Sku, "General"),
            new("Item", _opened.ItemName, "General"),
            new("Quantity", _opened.Qty.ToString("N3", CultureInfo.InvariantCulture), "Quantity"),
            new("Signed quantity", SignedQuantity.ToString("N3", CultureInfo.InvariantCulture), "Quantity"),
            new("Unit cost", _opened.UnitCost.ToString("N4", CultureInfo.InvariantCulture), "Costing"),
            new("Total cost", _opened.TotalCost.ToString("N2", CultureInfo.InvariantCulture), "Costing"),
            new("Batch", _opened.BatchNo, "Traceability"),
            new("Expiry", _opened.ExpiryDate, "Traceability"),
            new("Transfer warehouse", _opened.TransferWarehouseId > 0 ? _opened.TransferWarehouseId.ToString(CultureInfo.InvariantCulture) : "—", "Traceability"),
            new("Reference", _opened.Reference, "Traceability")
        ];

    private IReadOnlyList<ErpDocumentWorkspaceLine> MovementWorkspaceLines => _opened is null
        ? []
        : [
            new(_opened.Sku, string.IsNullOrWhiteSpace(_opened.ItemName) ? _opened.Sku : _opened.ItemName,
                _opened.Qty, "units", _opened.WarehouseName, "—", _opened.UnitCost, 0, 0,
                _opened.TotalCost, SignedQuantity, _opened.Reference)
        ];

    private decimal SignedQuantity => _opened is null
        ? 0
        : _opened.MovementType.Contains("out", StringComparison.OrdinalIgnoreCase)
            ? -_opened.Qty
            : _opened.Qty;

    private string MovementDirection => SignedQuantity >= 0 ? "Inbound / positive" : "Outbound / negative";

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.Sku)
            ? _opened.Sku + " #" + _opened.Id.ToString(CultureInfo.InvariantCulture)
            : (!string.IsNullOrWhiteSpace(_opened.Reference)
                ? _opened.Reference
                : ("Movement #" + _opened.Id.ToString(CultureInfo.InvariantCulture))));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?movement_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "movement_id");
        var session = await Sessions.ValidateAsync(ctx);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }
        var result = await Dashboards.BuildErpInventoryMovementsDigestAsync(100);
        _summary = result.Summary;
        _movements = result.Movements;
        _message = result.Message;

        _byWarehouse = _movements
            .GroupBy(m => (m.WarehouseId, m.WarehouseName))
            .Select(g => new MoveWarehouseRow(
                g.Key.WarehouseId,
                g.Key.WarehouseName,
                g.Count(),
                g.Where(m => m.SignedQty >= 0).Sum(m => m.Qty),
                g.Where(m => m.SignedQty < 0).Sum(m => m.Qty),
                g.Sum(m => m.TotalCost)))
            .OrderByDescending(w => w.Cost)
            .Take(10)
            .ToList();
        _byItem = _movements
            .GroupBy(m => (m.ItemId, string.IsNullOrWhiteSpace(m.Sku) ? m.ItemName : m.Sku))
            .Select(g => new MoveItemRow(
                g.Key.ItemId,
                g.Key.Item2 ?? "",
                g.Count(),
                g.Sum(m => m.SignedQty),
                g.Sum(m => m.TotalCost)))
            .OrderByDescending(r => r.Cost)
            .Take(10)
            .ToList();

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpInventoryMovementDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Movement;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _movements.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _movements = new[] { openedList }.Concat(_movements.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
