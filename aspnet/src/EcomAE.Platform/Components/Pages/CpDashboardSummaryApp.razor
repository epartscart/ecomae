@page "/cp/dashboard-summary-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Dashboard Summary · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Dashboard Summary
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/dashboard-summary-app")</p>
            </div>
        </div>
    </div>

    <p class="help-block">@_users.ToString(CultureInfo.InvariantCulture) Admin users · @_sessions.ToString(CultureInfo.InvariantCulture) Admin sessions · @_tenants.ToString(CultureInfo.InvariantCulture) Portal tenants · @_active.ToString(CultureInfo.InvariantCulture) Active portal tenants.</p>

    @if (!_isAdmin)
    {
        <div class="epc-ds-note" role="status">Sign in with a Control Panel admin session to load live KPIs.</div>
    }
    else if (!string.IsNullOrWhiteSpace(_message) || (_source != "database" && _source != "n/a"))
    {
        <div class="epc-ds-note" role="status">Source: <code>@_source</code>@if (!string.IsNullOrWhiteSpace(_message)) { <text> — @_message</text> }</div>
    }

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/";
    private bool _isAdmin;
    private int _users;
    private int _sessions;
    private int _tenants;
    private int _active;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildControlPanelAsync(ctx.RequestAborted);
        _users = result.Users;
        _sessions = result.AdminSessions;
        _tenants = result.PortalTenants;
        _active = result.ActivePortalTenants;
        _source = result.Source;
        _message = result.Message;
    }
}
