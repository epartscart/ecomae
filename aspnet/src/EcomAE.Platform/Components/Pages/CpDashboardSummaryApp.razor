@page "/cp/dashboard-summary-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Dashboard Summary · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <style>
            .epc-cp-summary__hero{display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;gap:16px;margin:0 0 14px;padding:18px 20px;border-radius:14px;background:linear-gradient(135deg,#0f172a 0%,#1e3a5f 48%,#0369a1 100%);color:#fff;box-shadow:0 10px 28px rgba(15,23,42,.18);}
            .epc-cp-summary__hero h2{margin:0 0 6px;font-size:22px;font-weight:800;color:#fff;}
            .epc-cp-summary__hero p{max-width:620px;margin:0;color:rgba(255,255,255,.88);font-size:13px;line-height:1.5;}
            .epc-cp-summary__actions{display:flex;flex-wrap:wrap;gap:7px;align-items:center;}
            .epc-cp-summary__actions a{display:inline-flex;align-items:center;padding:7px 11px;border:1px solid rgba(255,255,255,.32);border-radius:8px;color:#fff;background:rgba(255,255,255,.12);font-size:12px;font-weight:700;text-decoration:none;}
            .epc-cp-summary__actions a:hover{background:rgba(255,255,255,.22);color:#fff;}
            .epc-cp-summary__kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:0 0 14px;}
            .epc-cp-summary__kpi{display:block;padding:15px 16px;border:1px solid #e2e8f0;border-top:3px solid #0ea5e9;border-radius:12px;background:#fff;box-shadow:0 1px 3px rgba(15,23,42,.06);text-decoration:none;}
            .epc-cp-summary__kpi:nth-child(2){border-top-color:#6366f1}.epc-cp-summary__kpi:nth-child(3){border-top-color:#f59e0b}.epc-cp-summary__kpi:nth-child(4){border-top-color:#10b981}
            .epc-cp-summary__kpi strong{display:block;color:#0369a1;font-size:28px;line-height:1.1;font-variant-numeric:tabular-nums;}
            .epc-cp-summary__kpi span{display:block;margin-top:5px;color:#64748b;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;}
            .epc-cp-summary__workspace{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(260px,.65fr);gap:14px;}
            .epc-cp-summary__panel{padding:15px 16px;border:1px solid #e2e8f0;border-radius:12px;background:#fff;box-shadow:0 1px 3px rgba(15,23,42,.05);}
            .epc-cp-summary__panel h3{margin:0 0 12px;color:#0f172a;font-size:14px;font-weight:800;}
            .epc-cp-summary__bars{display:grid;gap:9px;}
            .epc-cp-summary__bar{display:grid;grid-template-columns:110px minmax(0,1fr) 42px;gap:8px;align-items:center;color:#475569;font-size:11px;font-weight:700;}
            .epc-cp-summary__track{height:9px;overflow:hidden;border-radius:99px;background:#e2e8f0;}
            .epc-cp-summary__fill{height:100%;min-width:5px;border-radius:99px;background:linear-gradient(90deg,#2563eb,#0f766e);}
            .epc-cp-summary__links{display:grid;gap:8px;margin:0;padding:0;list-style:none;}
            .epc-cp-summary__links a{display:flex;justify-content:space-between;gap:10px;padding:9px 10px;border:1px solid #e2e8f0;border-radius:8px;color:#0f172a;font-size:12px;font-weight:700;text-decoration:none;}
            .epc-cp-summary__links a:hover{border-color:#38bdf8;background:#f0f9ff;}
            @@media (max-width:850px){.epc-cp-summary__kpis{grid-template-columns:repeat(2,minmax(0,1fr));}.epc-cp-summary__workspace{grid-template-columns:1fr;}}
            @@media (max-width:520px){.epc-cp-summary__kpis{grid-template-columns:1fr;}.epc-cp-summary__bar{grid-template-columns:92px minmax(0,1fr) 34px;}}
        </style>
        <div class="epc-cp-summary__hero">
            <div>
                <div class="epc-scp-dashboard__badge">Super CP</div>
                <h2>Platform command centre</h2>
                <p>One operator view for tenant fleet health, administrator access, and the control-plane surfaces that keep every storefront and ERP workspace ready.</p>
            </div>
            <div class="epc-cp-summary__actions">
                <a href="/cp/control">Open CP</a>
                <a href="/bos/fleet-health-app">Fleet health</a>
                <a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
        </div>
        <div class="epc-cp-summary__kpis" aria-label="Platform KPIs">
            <a class="epc-cp-summary__kpi" href="/cp/control/portal/epc_super_cp_customer_board"><strong>@_users.ToString(CultureInfo.InvariantCulture)</strong><span>Admin users</span></a>
            <a class="epc-cp-summary__kpi" href="/cp/admin-sessions-app"><strong>@_sessions.ToString(CultureInfo.InvariantCulture)</strong><span>Admin sessions</span></a>
            <a class="epc-cp-summary__kpi" href="/cp/tenants-app"><strong>@_tenants.ToString(CultureInfo.InvariantCulture)</strong><span>Portal tenants</span></a>
            <a class="epc-cp-summary__kpi" href="/bos/tenants-app"><strong>@_active.ToString(CultureInfo.InvariantCulture)</strong><span>Active tenants</span></a>
        </div>
        <div class="epc-cp-summary__workspace">
            <section class="epc-cp-summary__panel" aria-label="Platform activity">
                <h3>Platform activity</h3>
                <div class="epc-cp-summary__bars">
                    <div class="epc-cp-summary__bar"><span>Admin users</span><div class="epc-cp-summary__track"><div class="epc-cp-summary__fill" style="width:@MetricWidth(_users, _users, 24)"></div></div><b>@_users</b></div>
                    <div class="epc-cp-summary__bar"><span>Sessions</span><div class="epc-cp-summary__track"><div class="epc-cp-summary__fill" style="width:@MetricWidth(_sessions, _users, 24)"></div></div><b>@_sessions</b></div>
                    <div class="epc-cp-summary__bar"><span>Tenants</span><div class="epc-cp-summary__track"><div class="epc-cp-summary__fill" style="width:@MetricWidth(_tenants, _tenants, 24)"></div></div><b>@_tenants</b></div>
                    <div class="epc-cp-summary__bar"><span>Active</span><div class="epc-cp-summary__track"><div class="epc-cp-summary__fill" style="width:@MetricWidth(_active, _tenants, 24)"></div></div><b>@_active</b></div>
                </div>
            </section>
            <section class="epc-cp-summary__panel" aria-label="Operator destinations">
                <h3>Operator destinations</h3>
                <ul class="epc-cp-summary__links">
                    <li><a href="/cp/control/portal/epc_super_cp_operator_guide">Operator guide <span>→</span></a></li>
                    <li><a href="/cp/control/portal/epc_integrations_hub">Integrations hub <span>→</span></a></li>
                    <li><a href="/cp/audit-trail-app">Audit trail <span>→</span></a></li>
                </ul>
            </section>
        </div>
    </div>

    @if (!_isAdmin)
    {
        <div class="epc-ds-note" role="status">Sign in with a Control Panel admin session to load live KPIs.</div>
    }
    else if (!string.IsNullOrWhiteSpace(_message) || (_source != "database" && _source != "n/a"))
    {
        <div class="epc-ds-note" role="status">Source: <code>@_source</code>@if (!string.IsNullOrWhiteSpace(_message)) { <text> — @_message</text> }</div>
    }

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/";
    private bool _isAdmin;
    private int _users;
    private int _sessions;
    private int _tenants;
    private int _active;
    private string _source = "n/a";
    private string _message = "";

    private static string MetricWidth(int value, int maximum, int minimumScale)
    {
        var scale = Math.Max(Math.Max(maximum, value), minimumScale);
        return Math.Clamp(value / (decimal)scale * 100m, 4m, 100m).ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildControlPanelAsync(ctx.RequestAborted);
        _users = result.Users;
        _sessions = result.AdminSessions;
        _tenants = result.PortalTenants;
        _active = result.ActivePortalTenants;
        _source = result.Source;
        _message = result.Message;
    }
}
