@page "/erp/order-pipeline-app"
@page "/cp/shop/finance/epc_order_erp_pipeline"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Order→ERP pipeline · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Order→ERP pipeline" BreadcrumbArea="Finance" BreadcrumbTab="Order pipeline">

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Order→ERP pipeline log" Subtitle="Open a row for the 280-char details excerpt. Pipeline execution stays PHP." PhpTabHref="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" />
    <PhpErpD365ActionPane PhpTabHref="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Order pipeline KPIs">
        <div class="kpi"><div class="lbl">Steps</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Success</div><div class="val">@_success.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Failed</div><div class="val">@_failed.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Pending</div><div class="val">@_pending.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Avg ms</div><div class="val">@_avgMs.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Site</dt><dd>@(string.IsNullOrWhiteSpace(_opened.SiteKey) ? "—" : _opened.SiteKey)</dd>
                <dt>Order</dt><dd>@(_opened.OrderId > 0 ? _opened.OrderId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Step</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Step) ? "—" : _opened.Step)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Status) ? "—" : _opened.Status)</dd>
                <dt>Duration</dt><dd>@_opened.DurationMs.ToString(CultureInfo.InvariantCulture) ms</dd>
                <dt>Error</dt><dd>@(string.IsNullOrWhiteSpace(_opened.ErrorMessage) ? "—" : _opened.ErrorMessage)</dd>
                <dt>When</dt><dd>@(string.IsNullOrWhiteSpace(_opened.CreatedAt) ? "—" : _opened.CreatedAt)</dd>
                <dt>Details</dt><dd>@(string.IsNullOrWhiteSpace(_opened.DetailsExcerpt) ? "—" : _opened.DetailsExcerpt)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Full details JSON omitted. Pipeline execution stays PHP.</p>
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-order siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Step</th>
                            <th>Status</th>
                            <th>When</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Step) ? "—" : sib.Step)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.CreatedAt) ? "—" : sib.CreatedAt)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "pipeline_log_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-order siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Step</th>
                    <th>Status</th>
                    <th class="text-right">Duration</th>
                    <th>Error</th>
                    <th>When</th>
                    <th>Site</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_logs.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No pipeline steps logged yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _logs)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td><strong>#@row.OrderId.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Step) ? "—" : row.Step)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td class="text-right">@row.DurationMs.ToString(CultureInfo.InvariantCulture) ms</td>
                            <td>@(string.IsNullOrWhiteSpace(row.ErrorMessage) ? "—" : row.ErrorMessage)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.CreatedAt) ? "—" : row.CreatedAt)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.SiteKey) ? "—" : row.SiteKey)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "pipeline_log_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Pipeline execution stays PHP. Digest: <code>/erp/order-pipeline</code>.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/epc_order_erp_pipeline";
    private string _listHref = "/erp/order-pipeline-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpOrderPipelineLogDigest> _logs = [];
    private int _count;
    private int _success;
    private int _failed;
    private int _pending;
    private int _avgMs;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpOrderPipelineLogDetail? _opened;
    private IReadOnlyList<ErpOrderPipelineLogDigest> _openedSiblings = [];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.Step)
            ? (_opened.Step + " #" + _opened.Id.ToString(CultureInfo.InvariantCulture))
            : ("Pipeline #" + _opened.Id.ToString(CultureInfo.InvariantCulture)));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?pipeline_log_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var path = ctx.Request.Path.Value ?? "";
        _listHref = path.Contains("/cp/shop/finance/epc_order_erp_pipeline", StringComparison.OrdinalIgnoreCase)
            ? "/cp/shop/finance/epc_order_erp_pipeline"
            : "/erp/order-pipeline-app";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "pipeline_log_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpOrderPipelineLogAsync(200, ctx.RequestAborted);
        _logs = result.Logs;
        _count = result.Count;
        _success = result.SuccessCount;
        _failed = result.FailedCount;
        _pending = result.PendingCount;
        _avgMs = result.AvgDurationMs;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpOrderPipelineLogDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Log;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _logs.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _logs = new[] { openedList }.Concat(_logs.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }
}
