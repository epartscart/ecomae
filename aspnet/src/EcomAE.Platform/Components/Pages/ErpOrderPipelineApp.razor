@page "/erp/order-pipeline-app"
@page "/cp/shop/finance/epc_order_erp_pipeline"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Order→ERP pipeline · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Order→ERP pipeline" BreadcrumbArea="Finance" BreadcrumbTab="Order pipeline">

    <PhpErpModulePageHeader Title="Order→ERP pipeline log" Subtitle="Read-only epc_order_erp_log. Validate, invoice, GL, inventory, and notify steps stay on PHP." />
    <PhpErpD365ActionPane RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Order pipeline KPIs">
        <div class="kpi"><div class="lbl">Steps</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Success</div><div class="val">@_success.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Failed</div><div class="val">@_failed.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Pending</div><div class="val">@_pending.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Avg ms</div><div class="val">@_avgMs.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Step</th>
                    <th>Status</th>
                    <th class="text-right">Duration</th>
                    <th>Error</th>
                    <th>When</th>
                    <th>Site</th>
                </tr>
            </thead>
            <tbody>
                @if (_logs.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No pipeline steps logged yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _logs)
                    {
                        <tr>
                            <td><strong>#@row.OrderId.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Step) ? "—" : row.Step)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td class="text-right">@row.DurationMs.ToString(CultureInfo.InvariantCulture) ms</td>
                            <td>@(string.IsNullOrWhiteSpace(row.ErrorMessage) ? "—" : row.ErrorMessage)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.CreatedAt) ? "—" : row.CreatedAt)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.SiteKey) ? "—" : row.SiteKey)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Pipeline execution stays PHP. Digest: <code>/erp/order-pipeline</code>.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private IReadOnlyList<ErpOrderPipelineLogDigest> _logs = [];
    private int _count;
    private int _success;
    private int _failed;
    private int _pending;
    private int _avgMs;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpOrderPipelineLogAsync(200, ctx.RequestAborted);
        _logs = result.Logs;
        _count = result.Count;
        _success = result.SuccessCount;
        _failed = result.FailedCount;
        _pending = result.PendingCount;
        _avgMs = result.AvgDurationMs;
        _source = result.Source;
        _message = result.Message;
    }
}
