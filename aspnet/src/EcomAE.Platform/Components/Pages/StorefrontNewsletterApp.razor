@page "/storefront/newsletter-app"
@page "/en/newsletter"
@page "/newsletter"
@page "/en/subscribe"
@page "/subscribe"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>Newsletter · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" />

<StorefrontTenantChrome>
    <section class="epc-wc-newsletter" id="epc_wc_newsletter_auto_parts">
        <div class="container" style="max-width:36rem;text-align:center">
            <p style="margin:0 0 .35rem;color:#64748b;font-size:.85rem"><a href="/">Home</a></p>
            <h2 style="font-size:24px;font-weight:700;margin:0 0 8px;color:#1e293b">Stay updated</h2>
            <p style="color:#64748b;margin:0 0 20px;font-size:15px">Subscribe for the latest updates and exclusive offers from @_brand.</p>
            @if (!string.IsNullOrWhiteSpace(_flashOk))
            {
                <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
            }
            @if (!string.IsNullOrWhiteSpace(_flashErr))
            {
                <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
            }
            <form method="post" action="@PhpVendorPortal.NewsletterWriteHref" class="epc-wc-newsletter__form" style="max-width:480px;margin:0 auto;display:flex;gap:8px;flex-wrap:wrap;text-align:left">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/storefront/newsletter-app" />
                <input type="email" name="email" required autocomplete="email" placeholder="Enter your email" class="form-control" style="flex:1;min-width:12rem" />
                <button type="submit" class="btn btn-ar btn-primary">Subscribe</button>
            </form>
            <p class="epc-wc-newsletter__note" style="color:#94a3b8;font-size:12px;margin:12px 0 0">No spam. Unsubscribe anytime.</p>
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx?.Request.Host.Host);
        _flashOk = ctx?.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx?.Request.Query["err"].ToString() ?? "";
    }
}
