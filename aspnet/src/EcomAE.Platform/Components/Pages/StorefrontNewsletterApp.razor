@page "/storefront/newsletter-app"
@page "/en/newsletter"
@page "/newsletter"
@page "/en/subscribe"
@page "/subscribe"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>Newsletter · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" />

<StorefrontTenantChrome>
    <section style="padding:2rem 0 3rem">
        <div class="container" style="max-width:36rem">
            <p style="margin:0 0 .35rem;color:#64748b;font-size:.85rem"><a href="/">Home</a></p>
            <h1 style="margin:.1rem 0 .4rem">Newsletter</h1>
            <p style="color:#475569">Get order and catalogue updates from @_brand.</p>
            <form method="post" action="@PhpVendorPortal.NewsletterWriteHref" style="background:#fff;border:1px solid #e2e8f0;border-radius:.55rem;padding:1.1rem 1.2rem">
                <label>Email</label>
                <input type="email" name="email" required autocomplete="email" style="width:100%;margin:.25rem 0 1rem;padding:.5rem" />
                <button type="submit" style="width:100%;padding:.7rem 1rem;border:0;border-radius:.45rem;background:#dc2626;color:#fff;font-weight:800;cursor:pointer">Subscribe</button>
            </form>
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";

    protected override void OnInitialized()
    {
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(Http.HttpContext?.Request.Host.Host);
    }
}
