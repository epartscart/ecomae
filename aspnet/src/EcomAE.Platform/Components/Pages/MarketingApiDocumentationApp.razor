@page "/marketing/api-documentation"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>ECOM AE — Tenant ERP API docs</PageTitle>
<PhpChromeStyles Surface="marketing" />

<PhpEcomaeMarketingChrome ActiveKey="api_documentation">
    <PhpHybridWorkspaceFrame PhpHref="@_phpHref" ClearHref="/marketing/api-documentation" />

    @if (string.IsNullOrWhiteSpace(_phpHref))
    {
        <PhpEcomaeApiDocumentationOverview />
    }
</PhpEcomaeMarketingChrome>

@code {
    private string? _phpHref;

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        if (ctx?.Request.Query.TryGetValue("php", out var php) == true && !string.IsNullOrWhiteSpace(php))
        {
            _phpHref = php.ToString();
        }
    }
}
