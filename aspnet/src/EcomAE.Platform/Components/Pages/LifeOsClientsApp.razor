@page "/lifeos/clients-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.LifeOs.Part8
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ILifeOsClientExperience Ux

<PageTitle>LifeOS™ · Part 8 Client Experience</PageTitle>
<PhpSurfaceHead Surface="lifeos" />
<PhpChromeBodyClass Surface="lifeos" />

<HeadContent>
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<style>
:root {
  --lo-ink:#0a1f1c; --lo-sea:#0f766e; --lo-sun:#f59e0b; --lo-paper:#f4faf8;
  --lo-display:"Instrument Serif", Georgia, serif; --lo-sans:"Manrope","Segoe UI",sans-serif;
}
body.lifeos-body { margin:0; background:var(--lo-paper); color:var(--lo-ink); font-family:var(--lo-sans); }
.lo-top {
  display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap;
  padding:1rem clamp(1rem,3vw,2rem);
  background:linear-gradient(90deg,#062a26,#0f766e 55%,#134e4a); color:#ecfdf5;
}
.lo-top .brand { font-family:var(--lo-display); font-size:1.55rem; }
.lo-top .brand em { font-style:italic; color:#99f6e4; }
.lo-top nav { display:flex; flex-wrap:wrap; gap:.75rem; font-size:.8rem; font-weight:700; }
.lo-top a { color:#ccfbf1; text-decoration:none; }
.lo-main { padding:1.35rem clamp(1rem,3vw,2.2rem) 2.5rem; max-width:80rem; margin:0 auto; }
.lo-main h1 { font-family:var(--lo-display); font-weight:400; font-size:clamp(1.65rem,3.5vw,2.3rem); margin:.1rem 0 .4rem; }
.lo-main > p { max-width:52rem; color:#334155; line-height:1.5; }
.lo-chips { display:flex; flex-wrap:wrap; gap:.4rem; margin:.5rem 0 1rem; }
.lo-chips span {
  font-size:.72rem; font-weight:700; padding:.3rem .55rem; border-radius:.28rem;
  background:#ecfdf5; color:var(--lo-sea); border:1px solid #a7f3d0;
}
.lo-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:.6rem; }
.lo-grid article { padding:.85rem; border:1px solid #cce5de; border-radius:.4rem; background:#fff; }
.lo-grid strong { display:block; margin-bottom:.2rem; font-size:.9rem; color:#062a26; }
.lo-grid span { font-size:.78rem; color:#475569; line-height:1.35; }
.lo-h2 { font-family:var(--lo-display); font-weight:400; font-size:1.4rem; margin:1.2rem 0 .4rem; }
.lo-table { width:100%; border-collapse:collapse; font-size:.8rem; margin:.4rem 0 1rem; }
.lo-table th, .lo-table td { text-align:left; padding:.4rem .35rem; border-bottom:1px solid #e2efe9; vertical-align:top; }
.lo-note { margin-top:1.3rem; padding:1rem; border-left:3px solid var(--lo-sun); background:#fffbeb; color:#78350f; font-size:.86rem; }
</style>
</HeadContent>

<div class="lifeos-ambient">
  <header class="lo-top">
    <div class="brand">Life<em>OS</em>™</div>
    <nav>
      <a href="@EcomAeRoutes.LifeOs">Home</a>
      <a href="@EcomAeRoutes.LifeOsSecurityApp">Part 7</a>
      <a href="@EcomAeRoutes.LifeOsClientsApp">Part 8</a>
      <a href="@EcomAeRoutes.LifeOsSpecApp">Spec</a>
      <a href="@EcomAeRoutes.LifeOsClients">JSON</a>
    </nav>
  </header>
  <main class="lo-main">
    <h1>Part 8 — Client Experience</h1>
    <p>
      Cross-platform UX scaffold: Life Design System, intent navigation, AI workspace, semantic search,
      modality clients (web→vehicle), continuity, accessibility, offline, personalization, and focus (Ch.102–125).
    </p>

    <div class="lo-chips">
      @foreach (var p in Ux.ExperiencePrinciples)
      {
        <span>@p.Title</span>
      }
    </div>

    <h2 class="lo-h2">Client ecosystem (@Ux.ClientPlatforms.Count)</h2>
    <div class="lo-grid">
      @foreach (var family in Ux.ClientPlatforms.Select(c => c.Family).Distinct())
      {
        var items = Ux.ClientPlatforms.Where(c => c.Family == family).ToList();
        <article>
          <strong>@family</strong>
          <span>@string.Join(" · ", items.Select(i => i.Title))</span>
        </article>
      }
    </div>

    <h2 class="lo-h2">Life Design System components</h2>
    <div class="lo-chips">
      @foreach (var c in Ux.DesignComponents)
      {
        <span>@c.Title</span>
      }
    </div>

    <h2 class="lo-h2">AI Workspace</h2>
    <div class="lo-chips">
      @foreach (var m in Ux.AiWorkspaceModules)
      {
        <span>@m.Title</span>
      }
    </div>

    <h2 class="lo-h2">Dashboards</h2>
    <table class="lo-table">
      <thead><tr><th>Dashboard</th><th>Panels</th></tr></thead>
      <tbody>
      @foreach (var d in Ux.DashboardKinds)
      {
        <tr>
          <td><strong>@d.Title</strong></td>
          <td>@string.Join(", ", d.Panels)</td>
        </tr>
      }
      </tbody>
    </table>

    <h2 class="lo-h2">Focus modes</h2>
    <div class="lo-chips">
      @foreach (var f in Ux.FocusModes)
      {
        <span>@f.Title</span>
      }
    </div>

    <h2 class="lo-h2">Accessibility</h2>
    <div class="lo-chips">
      @foreach (var a in Ux.AccessibilitySupports)
      {
        <span>@a.Title</span>
      }
    </div>

    <div class="lo-note">
      Digests: <code>/lifeos/clients</code>, <code>/design-system</code>, <code>/workspace-ux</code>,
      <code>/modality-clients</code>, <code>/continuity</code>, <code>/personalization</code>, <code>/ux-metrics</code>.
      Web console is live-scaffold; native mobile/desktop/glasses/vehicle clients not claimed.
    </div>
  </main>
</div>
