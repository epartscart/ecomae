@page "/storefront/wishlist-app"
@page "/en/shop/zakladki"
@page "/shop/zakladki"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject IHttpContextAccessor Http

<PageTitle>Bookmarks · @_brand</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        
        .epc-sf-wl-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-sf-wl-cta a {
            display:inline-flex; padding:.5rem .85rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#fff; background:#dc2626;
        }
        .epc-sf-wl-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); }
        .epc-sf-wl-grid {
            display:grid; grid-template-columns:repeat(auto-fill,minmax(14rem,1fr)); gap:.75rem;
        }
        .epc-sf-wl-card {
            background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem;
        }
        .epc-sf-wl-card h3 { margin:0 0 .35rem; font-size:.95rem; }
        .epc-sf-wl-card p { margin:0 0 .55rem; color:#64748b; font-size:.82rem; }
        .epc-sf-wl-card a { color:#b91c1c; font-weight:700; text-decoration:none; font-size:.82rem; }
        .epc-sf-wl-empty { padding:1.25rem; background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; color:#475569; }
        .epc-sf-wl-note { margin-top:1rem; padding:.75rem .9rem; background:#fff8e8; border:1px solid #f1d49a; border-radius:.45rem; color:#7a4e00; font-size:.86rem; }
    
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontTenantChrome>

    <PhpStorefrontPageHeader Title="Bookmarks"
                            Subtitle="Saved catalogue products from the classic wishlist cookie.">
        <a class="btn btn-sm btn-primary" href="@StorefrontSurfaceLinks.OwnCatalog">Own catalog</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Compare">Compare</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Cart">Cart</a>
    </PhpStorefrontPageHeader>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
    }

    @if (_ids.Count == 0)
    {
        <div class="epc-sf-wl-empty">
            No bookmarks yet. Add products from the classic catalogue, then return here.
        </div>
    }
    else if (_products.Count == 0)
    {
        <div class="epc-sf-wl-empty">
            Found @_ids.Count bookmark id(s) in cookie, but no matching catalogue products loaded (<code>@_source</code>).
            <a href="@StorefrontSurfaceLinks.OwnCatalog">Own catalog</a>
        </div>
    }
    else
    {
        <div class="epc-sf-wl-grid" aria-label="Bookmarked products">
            @foreach (var p in _products)
            {
                <article class="epc-sf-wl-card">
                    <h3>@(string.IsNullOrWhiteSpace(p.Caption) ? ("Product #" + p.Id) : p.Caption)</h3>
                    <p>
                        @(string.IsNullOrWhiteSpace(p.Manufacturer) ? "" : p.Manufacturer + " · ")
                        @(string.IsNullOrWhiteSpace(p.Article) ? ("#" + p.Id) : p.Article)
                    </p>
                    <a href="@StorefrontSurfaceLinks.ForProduct(p.Id)">View</a>
                    ·
                    <form method="get" action="@StorefrontSurfaceLinks.Cart" style="display:inline">
                        <input type="hidden" name="product_id" value="@p.Id.ToString(CultureInfo.InvariantCulture)" />
                        <input type="hidden" name="count_need" value="1" />
                        <button type="submit" class="btn btn-sm btn-primary" style="padding:.15rem .5rem;font-size:.78rem">Add to cart</button>
                    </form>
                    ·
                    <form method="post" action="@PhpCustomerWrites.WishlistRemoveHref" style="display:inline">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="/storefront/wishlist-app" />
                        <input type="hidden" name="product_id" value="@p.Id.ToString(CultureInfo.InvariantCulture)" />
                        <button type="submit" class="btn btn-sm btn-default" style="padding:.15rem .5rem;font-size:.78rem">Remove</button>
                    </form>
                </article>
            }
        </div>
    }

    <p class="epc-sf-wl-note">
        Bookmarks are the products you saved from the catalogue. Add or remove them on this page or a product card.
    </p>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private List<int> _ids = [];
    private IReadOnlyList<StorefrontProductDigest> _products = [];
    private string _source = "n/a";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);

        _ids = StorefrontIntListCookie.Read(ctx.Request, StorefrontIntListCookie.BookmarksName, StorefrontIntListCookie.BookmarksMax);

        if (_ids.Count == 0)
        {
            return;
        }

        var result = await Dashboards.ListStorefrontProductsByIdsAsync(_ids, ctx.RequestAborted);
        _products = result.Rows;
        _source = result.Source;
    }
}
