@page "/cp/crm-board-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>CRM Board · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-crm-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-crm-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-crm-hero p { margin:0; color:#c7d2fe; max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-crm-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-crm-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#312e81; background:#a5b4fc;
        }
        .epc-crm-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-crm-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-crm-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-crm-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-crm-kpi span { color:#64748b; font-size:.78rem; }
        .epc-crm-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-crm-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-crm-table th, .epc-crm-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-crm-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-crm-note { margin-top:1rem; padding:.75rem .9rem; background:#eef2ff; border:1px solid #a5b4fc; border-radius:.45rem; color:#3730a3; font-size:.86rem; }
        @@media (max-width:900px){ .epc-crm-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-crm-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>CRM Board</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-crm-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/cp/marketing-broadcast-app">Marketing broadcast</a>
        </div>
    </section>

    <div class="epc-crm-kpis" aria-label="CRM stats">
        <div class="epc-crm-kpi"><strong>@_summary.Leads.ToString(CultureInfo.InvariantCulture)</strong><span>Leads</span></div>
        <div class="epc-crm-kpi"><strong>@_summary.Opportunities.ToString(CultureInfo.InvariantCulture)</strong><span>Opportunities</span></div>
        <div class="epc-crm-kpi"><strong>@_summary.Activities.ToString(CultureInfo.InvariantCulture)</strong><span>Activities</span></div>
        <div class="epc-crm-kpi"><strong>@_summary.TicketsOpen.ToString(CultureInfo.InvariantCulture)</strong><span>Open tickets</span></div>
    </div>

    <div class="epc-crm-table-wrap">
        <table class="epc-crm-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Source</th>
                    <th>Owner</th>
                    <th>Amount</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_leads.Count == 0)
                {
                    <tr><td colspan="8">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var l in _leads)
                    {
                        <tr>
                            <td><strong>@l.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(l.Title) ? "—" : l.Title)</td>
                            <td>@(string.IsNullOrWhiteSpace(l.Status) ? "—" : l.Status)</td>
                            <td>@(string.IsNullOrWhiteSpace(l.Source) ? "—" : l.Source)</td>
                            <td>@l.OwnerId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@l.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(l.UpdatedAt > 0 ? l.UpdatedAt.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/crm/crm_main";
    private bool _isAdmin;
    private CpCrmBoardSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpCrmLeadDigest> _leads = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpCrmBoardDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _leads = result.Leads;
        _source = result.Source;
        _message = result.Message;
    }
}
