@page "/cp/crm-board-app"
@page "/erp/crm-board-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>CRM Board · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                CRM board
                <a class="btn btn-xs btn-default pull-right" href="/cp/marketing-broadcast-app">Marketing broadcast</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" style="margin-right:.4rem">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Open a lead for the 280-character notes excerpt. Convert a lead to an opportunity here. Email and phone stay omitted. Quote email stays Classic. This page does not invent a send.</p>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div>
    }
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="@_listHref" IsAdmin="_isAdmin" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (_opened is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @OpenedCaption
                    <a class="btn btn-xs btn-default pull-right" href="@_listHref">Close</a>
                </div>
                <div class="panel-body">
                    <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                        <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Company</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Title) ? "—" : _opened.Title)</dd>
                        <dt>Contact</dt><dd>@(string.IsNullOrWhiteSpace(_opened.ContactName) ? "—" : _opened.ContactName)</dd>
                        <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Status) ? "—" : _opened.Status)</dd>
                        <dt>Source</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Source) ? "—" : _opened.Source)</dd>
                        <dt>Owner</dt><dd>@_opened.OwnerId.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Amount</dt><dd>@_opened.Amount.ToString("N2", CultureInfo.InvariantCulture)</dd>
                    </dl>
                    <p class="help-block" style="margin:.85rem 0 0">Email/phone omitted.</p>
                    @if (!string.IsNullOrWhiteSpace(_opened.NotesExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:.85rem 0 0">@_opened.NotesExcerpt</pre>
                        @if (_opened.NotesLen > _opened.NotesExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_opened.NotesExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NotesLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted" style="margin:.85rem 0 0">No notes excerpt yet.</p>
                    }
                    @if (_isAdmin)
                    {
                        <form method="post" action="/cp/crm/leads/convert" style="margin:1rem 0 0">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@ErpRecordOpen.Href(_listHref, "lead_id", _opened.Id)" />
                            <input type="hidden" name="action" value="convert_lead" />
                            <input type="hidden" name="lead_id" value="@_opened.Id.ToString(CultureInfo.InvariantCulture)" />
                            <button type="submit" class="btn btn-primary btn-sm">Convert to opportunity</button>
                        </form>
                    }
                    @if (_openedSiblings.Count > 0)
                    {
                        <p class="help-block" style="margin:1rem 0 .4rem">Same-status siblings</p>
                        <div class="table-responsive">
                            <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-epc">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Title</th>
                                        <th>Status</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(string.IsNullOrWhiteSpace(sib.Title) ? "—" : sib.Title)</td>
                                            <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                            <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "lead_id", sib.Id)">Open</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No same-status siblings yet.</p>
                    }
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Leads</div>
            <div class="panel-body">
                <p class="help-block">Open uses <code>?lead_id=</code>. @_summary.Leads.ToString(CultureInfo.InvariantCulture) leads · @_summary.Opportunities.ToString(CultureInfo.InvariantCulture) opportunities · @_summary.Activities.ToString(CultureInfo.InvariantCulture) activities · @_summary.TicketsOpen.ToString(CultureInfo.InvariantCulture) open tickets.</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-epc">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Status</th>
                                <th>Source</th>
                                <th>Owner</th>
                                <th>Amount</th>
                                <th>Updated</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_leads.Count == 0)
                        {
                            <tr><td colspan="8">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var l in _leads)
                            {
                                <tr id="erp-row-@l.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(l.Id, _openedId)">
                                    <td>@l.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(string.IsNullOrWhiteSpace(l.Title) ? "—" : l.Title)</td>
                                    <td>@(string.IsNullOrWhiteSpace(l.Status) ? "—" : l.Status)</td>
                                    <td>@(string.IsNullOrWhiteSpace(l.Source) ? "—" : l.Source)</td>
                                    <td>@l.OwnerId.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@l.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@(l.UpdatedAt > 0 ? l.UpdatedAt.ToString(CultureInfo.InvariantCulture) : "—")</td>
                                    <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "lead_id", l.Id)">Open</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/crm/crm_main";
    private bool _isAdmin;
    private CpCrmBoardSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpCrmLeadDigest> _leads = [];
    private string _source = "n/a";
    private string _message = "";
    private string _listHref = "/cp/crm-board-app";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private CpCrmLeadDetail? _opened;
    private IReadOnlyList<CpCrmLeadDigest> _openedSiblings = [];

    private string OpenedCaption =>
        !string.IsNullOrWhiteSpace(_opened?.Title)
            ? _opened.Title
            : (_openedId > 0 ? ("Lead #" + _openedId.ToString(CultureInfo.InvariantCulture)) : "");

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var path = ctx.Request.Path.Value ?? "/cp/crm-board-app";
        _listHref = path.StartsWith("/erp/", StringComparison.OrdinalIgnoreCase)
            ? "/erp/crm-board-app"
            : "/cp/crm-board-app";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "lead_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpCrmBoardDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _leads = result.Leads;
        _source = result.Source;
        _message = result.Message;
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpCrmLeadDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Lead;
            _openedSiblings = detail.Siblings;
        }
    }
}
