@page "/cp/crm-board-app"
@page "/erp/crm-board-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using System.Text.Json
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ICpCrmDeskService Desk
@inject ICpCsrfGuard Csrf
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Enterprise CRM · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
    <link rel="stylesheet" href="/platform-assets/epc_erp_ui.css?v=20260922crm" />
    <link rel="stylesheet" href="/platform-assets/epc_crm_ui.css?v=20260922crm" />
    <link rel="stylesheet" href="/platform-assets/epc_erp_professional.css?v=20260922crm" />
    <link rel="stylesheet" href="/platform-assets/epc_crm_enterprise.css?v=20260922crm" />
    <style>
        .epc-crm-shell .epc-crm-form-inline input, .epc-crm-shell .epc-crm-form-inline select { margin: 2px 4px 2px 0; }
        .epc-crm-pipeline-drop { min-height: 40px; }
        .epc-crm-pipeline-drop.epc-crm-drop-over { background: rgba(29,78,216,0.08); outline: 2px dashed #1d4ed8; border-radius: 4px; }
        .epc-crm-card[draggable="true"] { cursor: grab; }
        .epc-crm-card.epc-crm-dragging { opacity: 0.4; }
        .epc-crm-timeline-modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 2000; }
        .epc-crm-timeline-backdrop { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0); transition: background .2s ease; }
        .epc-crm-timeline-modal.is-open .epc-crm-timeline-backdrop { background: rgba(0,0,0,0.45); }
        .epc-crm-timeline-panel { position: absolute; top: 0; right: 0; bottom: 0; width: 480px; max-width: 92vw; background: #fff; box-shadow: -2px 0 12px rgba(0,0,0,0.2); display: flex; flex-direction: column; transform: translateX(100%); transition: transform .22s cubic-bezier(.2,.7,.3,1); }
        .epc-crm-timeline-modal.is-open .epc-crm-timeline-panel { transform: translateX(0); }
        .epc-crm-timeline-hd { padding: 12px 16px; border-bottom: 1px solid #e5e5e5; }
        .epc-crm-timeline-bd { padding: 14px 16px; overflow-y: auto; flex: 1; }
        .epc-crm-timeline-bd h5 { margin: 16px 0 8px; }
        .epc-crm-timeline-bd h5:first-child { margin-top: 0; }
        .epc-crm-tl-item { border-left: 2px solid #e5e5e5; padding: 4px 0 8px 12px; margin-bottom: 4px; }
        .epc-crm-tl-item .tl-meta { font-size: 11px; color: #888; }
        .epc-crm-convert-form { display: inline; margin: 0; }
    </style>
</HeadContent>

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    @if (!_isAdmin)
    {
        <div class="col-lg-12"><div class="alert alert-danger"><strong>Access denied.</strong> You need ERP or administrator access to open CRM.</div></div>
    }
    else
    {
    <div class="col-lg-12 epc-crm-shell epc-crm-enterprise">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Enterprise CRM — Sales, support &amp; delivery
                <span class="pull-right">
                    <a class="btn btn-default btn-xs" href="/erp/finance-app"><i class="fa fa-university"></i> ERP Finance</a>
                    <a class="btn btn-default btn-xs" href="/cp/orders-app"><i class="fa fa-shopping-cart"></i> Orders</a>
                    <a class="btn btn-default btn-xs" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
                </span>
            </div>
            <div class="panel-body">

                <div class="epc-crm-hero">
                    <div>
                        <h2>Enterprise CRM</h2>
                        <p>Lead scoring, weighted pipeline forecast, accounts &amp; customer 360, quotes, support, projects, contracts, and expenses — one sales command centre inside ERP.</p>
                    </div>
                    <div class="epc-crm-hero-actions">
                        <a class="btn btn-sm btn-primary" href="@TabUrl("leads")"><i class="fa fa-user-plus"></i> New lead</a>
                        <a class="btn btn-sm btn-default" href="@TabUrl("intelligence")"><i class="fa fa-line-chart"></i> Intelligence</a>
                        <a class="btn btn-sm btn-default" href="@TabUrl("pipeline")"><i class="fa fa-columns"></i> Pipeline</a>
                        <a class="btn btn-sm btn-default" href="/cp/orders-app"><i class="fa fa-shopping-cart"></i> Orders</a>
                    </div>
                </div>

                <div class="epc-crm-nav epc-erp-subnav epc-cp-tabs--pill">
                    @foreach (var t in CpCrmDeskService.Tabs)
                    {
                        <a class="btn btn-sm @(_tab == t.Key ? "btn-primary" : "btn-default")" href="@TabUrl(t.Key)"><i class="fa @TabIcon(t.Key)"></i> @t.Value</a>
                    }
                </div>

                <div id="epc_crm_msg" class="alert epc-crm-msg @FlashClass" style="@FlashStyle" role="status">@FlashText</div>

                @if (!_desk.DbAvailable)
                {
                    <div class="alert alert-warning"><strong>CRM data unavailable.</strong> @(_desk.LoadError.Length > 0 ? _desk.LoadError : "The tenant database is not reachable.")</div>
                }

                <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedLead is not null)" Caption="@OpenedCaption" ListHref="@TabUrl("leads")" />

                @switch (_tab)
                {
                    case "dashboard":
                    {
                        var d = _desk.Dashboard;
                        var adv = _desk.Intelligence;
                        <div class="epc-crm-kpi">
                            <div class="kpi"><div class="lbl">Leads</div><div class="val">@d.LeadsTotal</div><div class="hint">@d.LeadsNew new</div></div>
                            <div class="kpi"><div class="lbl">Hot / Warm / Cold</div><div class="val blue">@adv.LeadBands.Hot / @adv.LeadBands.Warm / @adv.LeadBands.Cold</div><div class="hint">Lead score bands</div></div>
                            <div class="kpi"><div class="lbl">Open opportunities</div><div class="val">@d.OpportunitiesOpen</div></div>
                            <div class="kpi"><div class="lbl">Weighted forecast</div><div class="val blue">@Money(adv.Forecast.WeightedValue) @_cur</div></div>
                            <div class="kpi"><div class="lbl">Won MTD</div><div class="val green">@Money(d.WonMtd) @_cur</div></div>
                            <div class="kpi"><div class="lbl">Win rate</div><div class="val">@Pct(adv.Forecast.WinRate)%</div></div>
                            <div class="kpi"><div class="lbl">Activities due</div><div class="val amber">@d.ActivitiesDue</div><div class="hint">Next 7 days</div></div>
                            <div class="kpi"><div class="lbl">Open quotes</div><div class="val">@d.QuotesOpen</div></div>
                            <div class="kpi"><div class="lbl">Open tickets</div><div class="val blue">@d.TicketsOpen</div></div>
                            <div class="kpi"><div class="lbl">Active projects</div><div class="val">@d.ProjectsActive</div></div>
                        </div>

                        <div class="epc-crm-grid-2">
                            <div class="epc-crm-panel">
                                <div class="epc-crm-panel-hd">
                                    <h4><i class="fa fa-fire"></i> Priority leads</h4>
                                    <a class="btn btn-xs btn-default" href="@TabUrl("intelligence")">Full intelligence</a>
                                </div>
                                <div class="epc-crm-panel-bd" style="padding:0;">
                                    <table class="table table-condensed" style="margin:0;">
                                        <thead><tr><th>Company</th><th>Score</th><th>Band</th><th>Expected</th></tr></thead>
                                        <tbody>
                                        @foreach (var l in adv.TopLeads.Take(6))
                                        {
                                            <tr>
                                                <td><strong>@l.Company</strong></td>
                                                <td><span class="epc-crm-score">@l.Score.Score</span></td>
                                                <td><span class="epc-crm-band epc-crm-band-@l.Score.Band">@l.Score.Band</span></td>
                                                <td>@Money(l.ExpectedValue)</td>
                                            </tr>
                                        }
                                        @if (adv.TopLeads.Count == 0)
                                        {
                                            <tr><td colspan="4" class="text-muted">No scored leads yet.</td></tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="epc-crm-panel">
                                <div class="epc-crm-panel-hd">
                                    <h4><i class="fa fa-bolt"></i> Next-best actions</h4>
                                    <a class="btn btn-xs btn-default" href="@TabUrl("activities")">Activities</a>
                                </div>
                                <div class="epc-crm-panel-bd">
                                    @if (adv.NextActions.Count == 0)
                                    {
                                        <p class="text-muted" style="margin:0;">No overdue or upcoming follow-ups. Log activities to drive the queue.</p>
                                    }
                                    else
                                    {
                                        <ul class="epc-crm-action-list">
                                            @foreach (var a in adv.NextActions.Take(6))
                                            {
                                                <li>
                                                    <div><strong>@a.ActivityType</strong> · @a.RelatedType #@a.RelatedId</div>
                                                    <div style="text-align:right;">
                                                        @if (a.IsOverdue(_now)) { <span class="overdue">OVERDUE</span> } else { <span class="due">Due</span> }
                                                        <div style="font-size:12px;font-weight:700;">@(a.DueDate > 0 ? ShortDate(a.DueDate) : "—")</div>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="epc-crm-panel" style="margin-bottom:16px;">
                            <div class="epc-crm-panel-hd">
                                <h4><i class="fa fa-columns"></i> Pipeline snapshot</h4>
                                <a class="btn btn-xs btn-primary" href="@TabUrl("pipeline")">Open board</a>
                            </div>
                            <div class="epc-crm-panel-bd">
                                <div class="epc-crm-pipeline">
                                    @foreach (var st in CpCrmDeskService.OpportunityStages)
                                    {
                                        var cards = _desk.Pipeline.TryGetValue(st.Key, out var cs) ? cs : [];
                                        <div class="epc-crm-pipeline-col epc-crm-stage-@st.Key">
                                            <h5>@st.Value <span class="badge">@cards.Count</span></h5>
                                            @foreach (var c in cards.Take(4))
                                            {
                                                <div class="epc-crm-card">
                                                    <div>@c.Title</div>
                                                    <div class="amt">@Money(c.Amount) @_cur</div>
                                                    <div class="meta">@c.Probability% · @(c.CloseDate > 0 ? ShortDate(c.CloseDate) : "—")</div>
                                                </div>
                                            }
                                            @if (cards.Count > 4)
                                            {
                                                <p class="text-muted" style="font-size:11px;margin:0;">+@(cards.Count - 4) more — see Pipeline tab</p>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        break;
                    }

                    case "intelligence":
                    {
                        var adv = _desk.Intelligence;
                        var f = adv.Forecast;
                        var fn = adv.Funnel;
                        var maxFunnel = Math.Max(1, fn.Leads);
                        <div class="epc-crm-section">
                            <h4><i class="fa fa-line-chart"></i> Sales intelligence</h4>
                            <p class="text-muted" style="margin-top:-4px;">Lead scoring, weighted forecast, conversion funnel, and next-best actions.</p>

                            <div class="epc-crm-kpi">
                                <div class="kpi"><div class="lbl">Hot leads</div><div class="val" style="color:#b91c1c;">@adv.LeadBands.Hot</div><div class="hint">Score ≥ 70</div></div>
                                <div class="kpi"><div class="lbl">Warm leads</div><div class="val amber">@adv.LeadBands.Warm</div><div class="hint">Score 40–69</div></div>
                                <div class="kpi"><div class="lbl">Cold leads</div><div class="val blue">@adv.LeadBands.Cold</div><div class="hint">Score &lt; 40</div></div>
                                <div class="kpi"><div class="lbl">Open pipeline</div><div class="val blue">@Money(f.OpenValue)</div><div class="hint">@f.OpenCount deals</div></div>
                                <div class="kpi"><div class="lbl">Weighted forecast</div><div class="val green">@Money(f.WeightedValue)</div><div class="hint">Probability-adjusted</div></div>
                                <div class="kpi"><div class="lbl">Win rate</div><div class="val">@Pct(f.WinRate)%</div><div class="hint">Closed won / closed</div></div>
                            </div>

                            <div class="epc-crm-grid-2">
                                <div class="epc-crm-panel">
                                    <div class="epc-crm-panel-hd"><h4>Conversion funnel</h4></div>
                                    <div class="epc-crm-panel-bd">
                                        <div class="epc-crm-funnel">
                                            @foreach (var fr in new[] { ("Leads", fn.Leads), ("Qualified", fn.Qualified), ("Opportunities", fn.Opportunities), ("Proposal+", fn.Proposals), ("Won", fn.Won) })
                                            {
                                                var pct = (int)Math.Round(fr.Item2 * 100.0 / maxFunnel);
                                                <div class="epc-crm-funnel-row">
                                                    <div class="lbl">@fr.Item1</div>
                                                    <div class="epc-crm-funnel-bar"><span style="width:@pct%"></span></div>
                                                    <div class="cnt">@fr.Item2</div>
                                                </div>
                                            }
                                        </div>
                                        <p class="text-muted" style="margin:12px 0 0;font-size:12px;">
                                            Lead → Opp: <strong>@Pct(fn.LeadToOppPct)%</strong>
                                            · Opp → Won: <strong>@Pct(fn.OppToWonPct)%</strong>
                                        </p>
                                    </div>
                                </div>
                                <div class="epc-crm-panel">
                                    <div class="epc-crm-panel-hd"><h4>Next-best actions</h4>
                                        <a class="btn btn-xs btn-default" href="@TabUrl("activities")">All activities</a>
                                    </div>
                                    <div class="epc-crm-panel-bd">
                                        @if (adv.NextActions.Count == 0)
                                        {
                                            <p class="text-muted" style="margin:0;">No open follow-ups with due dates. Add activities on leads and opportunities.</p>
                                        }
                                        else
                                        {
                                            <ul class="epc-crm-action-list">
                                                @foreach (var a in adv.NextActions)
                                                {
                                                    <li>
                                                        <div>
                                                            <strong>@a.ActivityType</strong> · @a.RelatedType #@a.RelatedId
                                                            <div class="text-muted" style="font-size:12px;">@Trunc(a.Notes, 80)</div>
                                                        </div>
                                                        <div style="text-align:right;">
                                                            @if (a.IsOverdue(_now)) { <span class="overdue">OVERDUE</span><br /> } else { <span class="due">Due</span><br /> }
                                                            <span style="font-size:12px;font-weight:700;">@(a.DueDate > 0 ? LongDate(a.DueDate) : "—")</span>
                                                        </div>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="epc-crm-grid-2">
                                <div class="epc-crm-panel">
                                    <div class="epc-crm-panel-hd"><h4>Top scored leads</h4>
                                        <a class="btn btn-xs btn-default" href="@TabUrl("leads")">Manage leads</a>
                                    </div>
                                    <div class="epc-crm-panel-bd" style="padding:0;">
                                        <table class="table table-condensed" style="margin:0;">
                                            <thead><tr><th>Company</th><th>Score</th><th>Band</th><th>Expected</th><th></th></tr></thead>
                                            <tbody>
                                            @foreach (var l in adv.TopLeads.Take(12))
                                            {
                                                <tr>
                                                    <td>
                                                        <strong>@l.Company</strong>
                                                        <div class="text-muted" style="font-size:11px;">@(l.ContactName.Length > 0 ? l.ContactName : l.Email)</div>
                                                    </td>
                                                    <td><span class="epc-crm-score">@l.Score.Score</span></td>
                                                    <td><span class="epc-crm-band epc-crm-band-@l.Score.Band">@l.Score.Band</span></td>
                                                    <td>@Money(l.ExpectedValue)</td>
                                                    <td>
                                                        @if (l.Status != "converted")
                                                        {
                                                            <button type="button" class="btn btn-xs btn-success epc-crm-convert" data-id="@l.Id">Convert</button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                            @if (adv.TopLeads.Count == 0)
                                            {
                                                <tr><td colspan="5" class="text-muted">No leads yet.</td></tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="epc-crm-panel">
                                    <div class="epc-crm-panel-hd"><h4>Lead sources</h4></div>
                                    <div class="epc-crm-panel-bd" style="padding:0;">
                                        <table class="table table-condensed" style="margin:0;">
                                            <thead><tr><th>Source</th><th>Leads</th><th>Qualified</th><th>Expected</th></tr></thead>
                                            <tbody>
                                            @foreach (var s in adv.Sources)
                                            {
                                                <tr>
                                                    <td><strong>@s.Source</strong></td>
                                                    <td>@s.Count</td>
                                                    <td>@s.QualifiedCount</td>
                                                    <td>@Money(s.ExpectedValue)</td>
                                                </tr>
                                            }
                                            @if (adv.Sources.Count == 0)
                                            {
                                                <tr><td colspan="4" class="text-muted">No source data yet.</td></tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        break;
                    }

                    case "pipeline":
                    {
                        <p class="text-muted">Drag cards between columns, or use the stage dropdown on each card.</p>
                        <div class="epc-crm-pipeline" id="epc_crm_pipeline">
                            @foreach (var st in CpCrmDeskService.OpportunityStages)
                            {
                                var cards = _desk.Pipeline.TryGetValue(st.Key, out var cs) ? cs : [];
                                <div class="epc-crm-pipeline-col epc-crm-stage-@st.Key" data-stage="@st.Key">
                                    <h5>@st.Value <span class="badge">@cards.Count</span></h5>
                                    <div class="epc-crm-pipeline-drop" data-stage="@st.Key">
                                        @foreach (var c in cards)
                                        {
                                            <div class="epc-crm-card" data-id="@c.Id" draggable="true">
                                                <div><strong>#@c.Id</strong> @c.Title</div>
                                                <div class="amt">@Money(c.Amount) @_cur · @c.Probability%</div>
                                                <div class="meta">@c.LeadCompany</div>
                                                <select class="form-control input-sm epc-crm-stage-select" style="margin-top:6px;" aria-label="Stage">
                                                    @foreach (var s in CpCrmDeskService.OpportunityStages)
                                                    {
                                                        <option value="@s.Key" selected="@(c.Stage == s.Key)">@s.Value</option>
                                                    }
                                                </select>
                                                <div style="margin-top:4px;">
                                                    <button type="button" class="btn btn-xs btn-default epc-crm-timeline" data-entity-type="opportunity" data-entity-id="@c.Id" data-label="@c.Title"><i class="fa fa-clock-o"></i></button>
                                                    @if (c.Stage == "won")
                                                    {
                                                        <button type="button" class="btn btn-xs btn-success epc-crm-won-hint" data-id="@c.Id">Order hint</button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        break;
                    }

                    case "leads":
                    {
                        <div class="epc-crm-section">
                            <h4><i class="fa fa-user-plus"></i> Lead management</h4>
                            <p class="text-muted" style="margin-top:-4px;">Score, qualify, convert, and edit leads. Hot leads surface first in Intelligence.</p>
                            <div class="epc-crm-form-card">
                                <form id="epc_crm_lead_form" class="form-inline epc-crm-form-inline" method="post" action="/cp/crm/action">
                                    <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="@TabUrl("leads")" />
                                    <input type="hidden" name="action" value="save_lead" />
                                    <input type="hidden" name="id" id="epc_crm_lead_id" value="@(_openedLead?.Id ?? 0)" />
                                    <input type="text" name="company" id="epc_crm_lead_company" class="form-control input-sm" placeholder="Company" required value="@(_openedLead?.Company ?? "")" />
                                    <input type="text" name="contact_name" id="epc_crm_lead_contact" class="form-control input-sm" placeholder="Contact" value="@(_openedLead?.ContactName ?? "")" />
                                    <input type="email" name="email" id="epc_crm_lead_email" class="form-control input-sm" placeholder="Email" value="@(_openedLead?.Email ?? "")" />
                                    <input type="text" name="phone" id="epc_crm_lead_phone" class="form-control input-sm" placeholder="Phone" value="@(_openedLead?.Phone ?? "")" />
                                    <input type="text" name="source" id="epc_crm_lead_source" class="form-control input-sm" placeholder="Source" value="@(_openedLead?.Source ?? "web")" />
                                    <select name="status" id="epc_crm_lead_status" class="form-control input-sm">
                                        @foreach (var s in CpCrmDeskService.LeadStatuses)
                                        {
                                            <option value="@s.Key" selected="@(_openedLead is not null && _openedLead.Status == s.Key)">@s.Value</option>
                                        }
                                    </select>
                                    <input type="number" step="0.01" name="expected_value" id="epc_crm_lead_value" class="form-control input-sm" placeholder="Expected @_cur" value="@(_openedLead is null ? "" : _openedLead.ExpectedValue.ToString(CultureInfo.InvariantCulture))" />
                                    <input type="text" name="notes" id="epc_crm_lead_notes" class="form-control input-sm" placeholder="Notes" style="max-width:220px;" value="@(_openedLead?.Notes ?? "")" />
                                    <button type="submit" class="btn btn-sm btn-primary" id="epc_crm_lead_submit">@(_openedLead is null ? "Add lead" : "Save lead #" + _openedLead.Id)</button>
                                    <button type="button" class="btn btn-sm btn-default" id="epc_crm_lead_reset" style="@(_openedLead is null ? "display:none;" : "")">Cancel edit</button>
                                </form>
                            </div>
                            <div style="margin-bottom:10px;">
                                <span class="text-muted" style="margin-right:8px;">Filter:</span>
                                <a class="btn btn-xs @(_leadStatus.Length == 0 ? "btn-primary" : "btn-default")" href="@TabUrl("leads")">All</a>
                                @foreach (var s in CpCrmDeskService.LeadStatuses)
                                {
                                    <a class="btn btn-xs @(_leadStatus == s.Key ? "btn-primary" : "btn-default")" href="@(TabUrl("leads") + "&lead_status=" + Uri.EscapeDataString(s.Key))">@s.Value</a>
                                }
                            </div>
                            <table class="table table-striped table-bordered table-condensed table-epc">
                                <thead><tr><th>Company</th><th>Contact</th><th>Score</th><th>Status</th><th>Source</th><th>Expected</th><th>Created</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var l in _desk.Leads)
                                {
                                    <tr id="erp-row-@l.Id" class="@ErpRecordOpen.RowClass(l.Id, _openedId)">
                                        <td>
                                            <strong>@l.Company</strong>
                                            @if (l.Email.Length > 0) { <div class="text-muted" style="font-size:11px;">@l.Email</div> }
                                        </td>
                                        <td>@l.ContactName @if (l.Phone.Length > 0) { <div class="text-muted" style="font-size:11px;">@l.Phone</div> }</td>
                                        <td>
                                            <span class="epc-crm-score" title="@string.Join(" · ", l.Score.Reasons)">@l.Score.Score</span>
                                            <span class="epc-crm-band epc-crm-band-@l.Score.Band">@l.Score.Band</span>
                                        </td>
                                        <td><span class="label label-info">@l.Status</span></td>
                                        <td>@l.Source</td>
                                        <td>@Money(l.ExpectedValue)</td>
                                        <td>@CpCrmDeskService.Date(l.TimeCreated)</td>
                                        <td style="white-space:nowrap;">
                                            <a class="btn btn-xs btn-default epc-crm-edit-lead" data-id="@l.Id" href="@ErpRecordOpen.Href(TabUrl("leads"), "lead_id", l.Id)" title="Edit"><i class="fa fa-pencil"></i></a>
                                            <button type="button" class="btn btn-xs btn-default epc-crm-timeline" data-entity-type="lead" data-entity-id="@l.Id" data-label="@l.Company"><i class="fa fa-clock-o"></i></button>
                                            @if (l.Status != "converted")
                                            {
                                                <form class="epc-crm-convert-form" method="post" action="/cp/crm/leads/convert">
                                                    <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                                                    <input type="hidden" name="confirmWrites" value="true" />
                                                    <input type="hidden" name="returnUrl" value="@TabUrl("opportunities")" />
                                                    <input type="hidden" name="action" value="convert_lead" />
                                                    <input type="hidden" name="lead_id" value="@l.Id" />
                                                    <button type="submit" class="btn btn-xs btn-success">→ Opp</button>
                                                </form>
                                            }
                                            <form class="epc-crm-delete-form" method="post" action="/cp/crm/action" style="display:inline">
                                                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                                                <input type="hidden" name="confirmWrites" value="true" />
                                                <input type="hidden" name="returnUrl" value="@TabUrl("leads")" />
                                                <input type="hidden" name="action" value="delete_lead" />
                                                <input type="hidden" name="id" value="@l.Id" />
                                                <button type="submit" class="btn btn-xs btn-danger epc-crm-delete-lead" data-id="@l.Id"><i class="fa fa-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                @if (_desk.Leads.Count == 0)
                                {
                                    <tr><td colspan="8" class="text-muted">No leads yet — add the first lead above.</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        break;
                    }

                    case "opportunities":
                    {
                        <div class="epc-crm-section">
                            <h4><i class="fa fa-briefcase"></i> Opportunities</h4>
                            <p class="text-muted" style="margin-top:-4px;">Deal desk with stage control, linked customers, and order handoff on win.</p>
                            <div class="epc-crm-form-card">
                                <form id="epc_crm_opp_form" class="form-inline epc-crm-form-inline" method="post" action="/cp/crm/action">
                                    <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="@TabUrl("opportunities")" />
                                    <input type="hidden" name="action" value="save_opportunity" />
                                    <input type="text" name="title" class="form-control input-sm" placeholder="Title" required />
                                    <input type="number" name="lead_id" class="form-control input-sm" placeholder="Lead ID" value="0" />
                                    <input type="number" name="linked_user_id" class="form-control input-sm" placeholder="Customer user ID" value="0" />
                                    <select name="stage" class="form-control input-sm">
                                        @foreach (var s in CpCrmDeskService.OpportunityStages) { <option value="@s.Key">@s.Value</option> }
                                    </select>
                                    <input type="number" step="0.01" name="amount" class="form-control input-sm" placeholder="Amount @_cur" />
                                    <input type="number" name="probability" class="form-control input-sm" placeholder="%" value="20" min="0" max="100" />
                                    <input type="date" name="close_date" class="form-control input-sm" value="@CpCrmDeskService.Date(_now + 86400 * 30)" />
                                    <button type="submit" class="btn btn-sm btn-primary">Add opportunity</button>
                                </form>
                            </div>
                            <table class="table table-striped table-bordered table-condensed table-epc">
                                <thead><tr><th>Title</th><th>Stage</th><th>Amount</th><th>%</th><th>Close</th><th>Account</th><th>Customer</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var o in _desk.Opportunities)
                                {
                                    <tr id="erp-row-@o.Id" class="@ErpRecordOpen.RowClass(o.Id, _openedOppId)">
                                        <td><strong>@o.Title</strong></td>
                                        <td><span class="label label-primary">@o.Stage</span></td>
                                        <td>@Money(o.Amount)</td>
                                        <td>@o.Probability%</td>
                                        <td>@(o.CloseDate > 0 ? CpCrmDeskService.Date(o.CloseDate) : "—")</td>
                                        <td>@(o.LeadCompany.Length > 0 ? o.LeadCompany : "#" + o.LeadId)</td>
                                        <td>@(o.LinkedUserId > 0 ? "#" + o.LinkedUserId : "—")</td>
                                        <td style="white-space:nowrap;">
                                            <button type="button" class="btn btn-xs btn-default epc-crm-edit-opp" data-id="@o.Id" title="Link customer"><i class="fa fa-link"></i></button>
                                            <button type="button" class="btn btn-xs btn-default epc-crm-timeline" data-entity-type="opportunity" data-entity-id="@o.Id" data-label="@o.Title"><i class="fa fa-clock-o"></i></button>
                                            @if (o.Stage == "won") { <button type="button" class="btn btn-xs btn-success epc-crm-won-hint" data-id="@o.Id">Order hint</button> }
                                        </td>
                                    </tr>
                                }
                                @if (_desk.Opportunities.Count == 0)
                                {
                                    <tr><td colspan="8" class="text-muted">No opportunities yet — convert a lead or add one above.</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        break;
                    }

                    case "accounts":
                    {
                        <div class="epc-crm-section">
                            <h4><i class="fa fa-building"></i> Accounts &amp; Customer 360</h4>
                            <p class="text-muted" style="margin-top:-4px;">
                                Account rollup from leads and opportunities.
                                Master address book:
                                <a href="/erp/contacts-app">ERP Contacts</a>.
                            </p>
                            <div class="epc-crm-form-card">
                                <form id="epc_crm_360_form" class="form-inline epc-crm-form-inline">
                                    <label style="font-weight:700;margin-right:8px;">Customer 360</label>
                                    <input type="number" name="user_id" id="epc_crm_360_user" class="form-control input-sm" placeholder="Shop user ID" min="1" required />
                                    <button type="submit" class="btn btn-sm btn-primary"><i class="fa fa-search"></i> Load 360</button>
                                </form>
                                <div id="epc_crm_360_result" style="margin-top:12px;display:none;"></div>
                            </div>
                            <table class="table table-striped table-bordered table-condensed epc-erp-table-compact table-epc">
                                <thead><tr><th>Account</th><th>Contact</th><th>Leads</th><th>Opps</th><th>Open pipeline</th><th>Won</th><th>Expected</th><th>Linked user</th><th>Last touch</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var acc in _desk.Accounts)
                                {
                                    <tr>
                                        <td><strong>@acc.Name</strong></td>
                                        <td>@(acc.Email.Length > 0 ? acc.Email : "—") @if (acc.Phone.Length > 0) { <div class="text-muted" style="font-size:11px;">@acc.Phone</div> }</td>
                                        <td>@acc.Leads</td>
                                        <td>@acc.Opportunities</td>
                                        <td class="text-primary"><strong>@Money(acc.OpenPipeline)</strong></td>
                                        <td class="text-success">@Money(acc.WonValue)</td>
                                        <td>@Money(acc.ExpectedValue)</td>
                                        <td>
                                            @if (acc.LinkedUserId > 0)
                                            {
                                                <button type="button" class="btn btn-xs btn-default epc-crm-load-360" data-user-id="@acc.LinkedUserId">#@acc.LinkedUserId 360</button>
                                            }
                                            else { <text>—</text> }
                                        </td>
                                        <td>@(acc.LastTouch > 0 ? CpCrmDeskService.Date(acc.LastTouch) : "—")</td>
                                        <td>@if (acc.LeadIds.Count > 0) { <a class="btn btn-xs btn-default" href="@TabUrl("leads")">Leads</a> }</td>
                                    </tr>
                                }
                                @if (_desk.Accounts.Count == 0)
                                {
                                    <tr><td colspan="10" class="text-muted">No accounts yet — add leads to build the account book.</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        break;
                    }

                    case "quotes":
                    {
                        <div class="epc-crm-section">
                            <h4><i class="fa fa-file-text-o"></i> Quotes &amp; proposals</h4>
                            <p class="text-muted" style="margin-top:-4px;">Create proposals, preview, email, tax-check totals, and accept into shop orders.</p>
                            <div class="epc-crm-form-card">
                                <form id="epc_crm_quote_form" class="form-inline epc-crm-form-inline" method="post" action="/cp/crm/action">
                                    <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="@TabUrl("quotes")" />
                                    <input type="hidden" name="action" value="save_quote" />
                                    <input type="number" name="opportunity_id" class="form-control input-sm" placeholder="Opp ID" value="0" />
                                    <select name="status" class="form-control input-sm">@foreach (var s in CpCrmDeskService.QuoteStatuses) { <option value="@s.Key">@s.Value</option> }</select>
                                    <input type="text" name="line_description" class="form-control input-sm" placeholder="Line description" required />
                                    <input type="number" step="0.01" name="line_qty" class="form-control input-sm" placeholder="Qty" value="1" />
                                    <input type="number" step="0.01" name="line_unit_price" class="form-control input-sm" placeholder="Unit @_cur" required />
                                    <button type="submit" class="btn btn-sm btn-primary">Create quote</button>
                                </form>
                            </div>
                            <table class="table table-striped table-bordered table-condensed epc-erp-table-compact table-epc">
                                <thead><tr><th>#</th><th>Number</th><th>Opp</th><th>Status</th><th>Total</th><th>Order</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var q in _desk.Quotes)
                                {
                                    <tr id="erp-row-@q.Id">
                                        <td>@q.Id</td>
                                        <td>@q.QuoteNumber</td>
                                        <td>@(q.OppTitle.Length > 0 ? q.OppTitle : "#" + q.OpportunityId)</td>
                                        <td><span class="label label-info">@q.Status</span></td>
                                        <td>@Money(q.Subtotal) @q.CurrencyCode</td>
                                        <td>@if (q.ShopOrderId > 0) { <a href="/cp/orders-app?order_id=@q.ShopOrderId">#@q.ShopOrderId</a> } else { <text>—</text> }</td>
                                        <td style="white-space:nowrap;">
                                            <button type="button" class="btn btn-xs btn-default epc-crm-quote-preview" data-id="@q.Id">Preview</button>
                                            <button type="button" class="btn btn-xs btn-default epc-crm-quote-tax" data-id="@q.Id">Tax</button>
                                            <button type="button" class="btn btn-xs btn-info epc-crm-quote-email" data-id="@q.Id">Email</button>
                                            @if (q.Status != "accepted") { <button type="button" class="btn btn-xs btn-success epc-crm-accept-quote" data-id="@q.Id">Accept → order</button> }
                                        </td>
                                    </tr>
                                }
                                @if (_desk.Quotes.Count == 0)
                                {
                                    <tr><td colspan="7" class="text-muted">No quotes yet — create the first proposal above.</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        break;
                    }

                    case "activities":
                    {
                        <div class="epc-crm-section">
                            <h4><i class="fa fa-calendar"></i> Activities</h4>
                            <form id="epc_crm_act_form" class="form-inline epc-crm-form-inline" style="margin-bottom:12px;" method="post" action="/cp/crm/action">
                                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="@TabUrl("activities")" />
                                <input type="hidden" name="action" value="save_activity" />
                                <select name="activity_type" class="form-control input-sm">@foreach (var s in CpCrmDeskService.ActivityTypes) { <option value="@s.Key">@s.Value</option> }</select>
                                <select name="related_type" class="form-control input-sm">
                                    <option value="lead">Lead</option>
                                    <option value="opportunity">Opportunity</option>
                                    <option value="user">User</option>
                                </select>
                                <input type="number" name="related_id" class="form-control input-sm" placeholder="Related ID" required />
                                <input type="date" name="due_date" class="form-control input-sm" value="@CpCrmDeskService.Date(_now)" />
                                <input type="text" name="notes" class="form-control input-sm" placeholder="Notes" />
                                <button type="submit" class="btn btn-sm btn-primary">Add activity</button>
                            </form>
                            <table class="table table-striped table-bordered table-condensed table-epc">
                                <thead><tr><th>Type</th><th>Related</th><th>Due</th><th>Done</th><th>Notes</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var a in _desk.Activities)
                                {
                                    <tr id="erp-row-@a.Id">
                                        <td>@a.ActivityType</td>
                                        <td>@a.RelatedType #@a.RelatedId</td>
                                        <td>@(a.DueDate > 0 ? CpCrmDeskService.Date(a.DueDate) : "—")</td>
                                        <td>@if (a.Done) { <span class="label label-success">Yes</span> } else { <span class="label label-warning">Open</span> }</td>
                                        <td>@Trunc(a.Notes, 80)</td>
                                        <td><button type="button" class="btn btn-xs btn-default epc-crm-toggle-act" data-id="@a.Id" data-done="@(a.Done ? "0" : "1")">@(a.Done ? "Reopen" : "Done")</button></td>
                                    </tr>
                                }
                                @if (_desk.Activities.Count == 0)
                                {
                                    <tr><td colspan="6" class="text-muted">No activities logged yet.</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        break;
                    }

                    case "tickets":
                    {
                        <div class="epc-crm-section">
                            <h4><i class="fa fa-life-ring"></i> Support desk</h4>
                            <p class="text-muted" style="margin-top:-4px;">Open tickets, reply in-thread, and move status through open → pending → resolved → closed.</p>
                            <div class="epc-crm-form-card">
                                <form id="epc_crm_ticket_form" class="form-inline epc-crm-form-inline" method="post" action="/cp/crm/action">
                                    <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="@TabUrl("tickets")" />
                                    <input type="hidden" name="action" value="save_ticket" />
                                    <input type="text" name="subject" class="form-control input-sm" placeholder="Subject" required />
                                    <input type="number" name="customer_user_id" class="form-control input-sm" placeholder="User ID" />
                                    <input type="number" name="order_id" class="form-control input-sm" placeholder="Order ID" />
                                    <select name="priority" class="form-control input-sm">@foreach (var s in CpCrmDeskService.TicketPriorities) { <option value="@s.Key" selected="@(s.Key == "normal")">@s.Value</option> }</select>
                                    <input type="text" name="message" class="form-control input-sm" placeholder="First message" />
                                    <button type="submit" class="btn btn-sm btn-primary">Open ticket</button>
                                </form>
                            </div>
                            <table class="table table-striped table-bordered table-condensed epc-erp-table-compact table-epc">
                                <thead><tr><th>Subject</th><th>Customer</th><th>Order</th><th>Status</th><th>Priority</th><th>Updated</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var t in _desk.Tickets)
                                {
                                    <tr id="erp-row-@t.Id" class="@ErpRecordOpen.RowClass(t.Id, _openedTicketId)">
                                        <td><strong>@t.Subject</strong></td>
                                        <td>@(t.CustomerUserId > 0 ? "#" + t.CustomerUserId + " " + t.CustomerEmail : "—")</td>
                                        <td>@(t.OrderId > 0 ? "#" + t.OrderId : "—")</td>
                                        <td><span class="label label-warning">@t.Status</span></td>
                                        <td>@t.Priority</td>
                                        <td>@CpCrmDeskService.Date(t.TimeUpdated)</td>
                                        <td><button type="button" class="btn btn-xs btn-primary epc-crm-open-ticket" data-id="@t.Id"><i class="fa fa-comments"></i> Thread</button></td>
                                    </tr>
                                }
                                @if (_desk.Tickets.Count == 0)
                                {
                                    <tr><td colspan="7" class="text-muted">No tickets yet.</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        break;
                    }

                    case "projects":
                    {
                        <div class="epc-crm-section">
                            <h4><i class="fa fa-tasks"></i> Delivery projects</h4>
                            <p class="text-muted" style="margin-top:-4px;">Gantt-lite timeline plus task board — open a project to add tasks and auto-recalc progress.</p>
                            <div class="epc-crm-form-card">
                                <form id="epc_crm_project_form" class="form-inline epc-crm-form-inline" method="post" action="/cp/crm/action">
                                    <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="@TabUrl("projects")" />
                                    <input type="hidden" name="action" value="save_project" />
                                    <input type="text" name="name" class="form-control input-sm" placeholder="Project name" required />
                                    <input type="number" name="opportunity_id" class="form-control input-sm" placeholder="Opp ID" value="0" />
                                    <input type="date" name="start_date" class="form-control input-sm" value="@CpCrmDeskService.Date(_now)" />
                                    <input type="date" name="end_date" class="form-control input-sm" value="@CpCrmDeskService.Date(_now + 86400 * 60)" />
                                    <select name="status" class="form-control input-sm">@foreach (var s in CpCrmDeskService.ProjectStatuses) { <option value="@s.Key">@s.Value</option> }</select>
                                    <button type="submit" class="btn btn-sm btn-primary">Add project</button>
                                </form>
                            </div>
                            <table class="table table-striped table-bordered table-condensed epc-erp-table-compact table-epc">
                                <thead><tr><th>Project</th><th>Status</th><th>Progress</th><th>Timeline</th><th>Linked</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var p in _desk.Projects)
                                {
                                    var prog = Math.Clamp(p.ProgressPct, 0, 100);
                                    <tr id="erp-row-@p.Id" class="@ErpRecordOpen.RowClass(p.Id, _openedProjectId)">
                                        <td><strong>@p.Name</strong></td>
                                        <td><span class="label label-primary">@p.Status</span></td>
                                        <td style="min-width:140px;">
                                            <div class="progress" style="margin:0;height:18px;">
                                                <div class="progress-bar progress-bar-success" style="width:@prog%">@prog%</div>
                                            </div>
                                        </td>
                                        <td>
                                            <div style="background:#e2e8f0;height:8px;border-radius:4px;position:relative;max-width:200px;">
                                                <div style="background:#1d4ed8;height:8px;border-radius:4px;width:@prog%;"></div>
                                                @if (p.StartDate > 0 && p.EndDate > 0) { <span style="font-size:10px;color:#64748b;">@ShortDate(p.StartDate) → @ShortDate(p.EndDate)</span> }
                                            </div>
                                        </td>
                                        <td>@(p.OppTitle.Length > 0 ? p.OppTitle : "Order #" + p.OrderId)</td>
                                        <td><button type="button" class="btn btn-xs btn-primary epc-crm-open-project" data-id="@p.Id"><i class="fa fa-list"></i> Tasks</button></td>
                                    </tr>
                                }
                                @if (_desk.Projects.Count == 0)
                                {
                                    <tr><td colspan="6" class="text-muted">No projects yet.</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        break;
                    }

                    case "contracts":
                    {
                        <div class="epc-crm-section">
                            <h4><i class="fa fa-refresh"></i> Contracts &amp; recurring billing</h4>
                            <form id="epc_crm_contract_form" class="form-inline epc-crm-form-inline" style="margin-bottom:12px;" method="post" action="/cp/crm/action">
                                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="@TabUrl("contracts")" />
                                <input type="hidden" name="action" value="save_contract" />
                                <input type="text" name="title" class="form-control input-sm" placeholder="Title" required />
                                <input type="number" name="customer_user_id" class="form-control input-sm" placeholder="User ID" />
                                <input type="number" step="0.01" name="amount" class="form-control input-sm" placeholder="Amount @_cur" required />
                                <select name="billing_interval" class="form-control input-sm">
                                    <option value="monthly">Monthly</option><option value="quarterly">Quarterly</option><option value="yearly">Yearly</option><option value="once">Once</option>
                                </select>
                                <input type="date" name="next_billing_date" class="form-control input-sm" value="@CpCrmDeskService.Date(_now + 86400 * 30)" />
                                <select name="status" class="form-control input-sm"><option value="active">Active</option><option value="draft">Draft</option></select>
                                <button type="submit" class="btn btn-sm btn-primary">Add contract</button>
                            </form>
                            <h5>Upcoming billing (90 days)</h5>
                            <table class="table table-striped table-bordered table-condensed epc-erp-table-compact table-epc">
                                <thead><tr><th>Title</th><th>Amount</th><th>Interval</th><th>Next bill</th><th>Status</th></tr></thead>
                                <tbody>
                                @foreach (var c in _desk.ContractsDue)
                                {
                                    <tr>
                                        <td>@c.Title</td>
                                        <td>@Money(c.Amount) @c.CurrencyCode</td>
                                        <td>@c.BillingInterval</td>
                                        <td>@(c.NextBillingDate > 0 ? CpCrmDeskService.Date(c.NextBillingDate) : "—")</td>
                                        <td>@c.Status</td>
                                    </tr>
                                }
                                @if (_desk.ContractsDue.Count == 0)
                                {
                                    <tr><td colspan="5" class="text-muted">Nothing due in the next 90 days.</td></tr>
                                }
                                </tbody>
                            </table>
                            <h5>All contracts</h5>
                            <table class="table table-striped table-bordered table-condensed epc-erp-table-compact table-epc">
                                <thead><tr><th>Title</th><th>Customer</th><th>Amount</th><th>Next</th><th>Status</th></tr></thead>
                                <tbody>
                                @foreach (var c in _desk.Contracts)
                                {
                                    <tr id="erp-row-@c.Id">
                                        <td>@c.Title</td>
                                        <td>@(c.CustomerUserId > 0 ? "#" + c.CustomerUserId : "—")</td>
                                        <td>@Money(c.Amount)</td>
                                        <td>@(c.NextBillingDate > 0 ? CpCrmDeskService.Date(c.NextBillingDate) : "—")</td>
                                        <td>@c.Status</td>
                                    </tr>
                                }
                                @if (_desk.Contracts.Count == 0)
                                {
                                    <tr><td colspan="5" class="text-muted">No contracts yet.</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        break;
                    }

                    case "expenses":
                    {
                        <div class="epc-crm-section">
                            <h4><i class="fa fa-money"></i> Expense reports</h4>
                            <form id="epc_crm_expense_form" class="form-inline epc-crm-form-inline" style="margin-bottom:12px;" method="post" action="/cp/crm/action">
                                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="@TabUrl("expenses")" />
                                <input type="hidden" name="action" value="save_expense" />
                                <input type="number" step="0.01" name="amount" class="form-control input-sm" placeholder="Amount @_cur" required />
                                <input type="text" name="category" class="form-control input-sm" placeholder="Category" value="travel" />
                                <input type="text" name="receipt_note" class="form-control input-sm" placeholder="Receipt note" />
                                <select name="status" class="form-control input-sm"><option value="submitted">Submit</option><option value="draft">Draft</option></select>
                                <button type="submit" class="btn btn-sm btn-primary">Add expense</button>
                            </form>
                            <table class="table table-striped table-bordered table-condensed epc-erp-table-compact table-epc">
                                <thead><tr><th>Employee</th><th>Amount</th><th>Category</th><th>Status</th><th>Receipt</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var e in _desk.Expenses)
                                {
                                    <tr id="erp-row-@e.Id">
                                        <td>#@e.EmployeeUserId</td>
                                        <td>@Money(e.Amount) @e.CurrencyCode</td>
                                        <td>@e.Category</td>
                                        <td><span class="label label-default">@e.Status</span></td>
                                        <td>@Trunc(e.ReceiptNote, 60)</td>
                                        <td>@if (e.Status == "submitted") { <button type="button" class="btn btn-xs btn-success epc-crm-approve-expense" data-id="@e.Id">Approve → cash</button> } else if (e.CashEntryId > 0) { <span class="text-muted" style="font-size:11px;">cash #@e.CashEntryId</span> }</td>
                                    </tr>
                                }
                                @if (_desk.Expenses.Count == 0)
                                {
                                    <tr><td colspan="6" class="text-muted">No expenses yet.</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        break;
                    }
                }

                <div id="epc_crm_drawer" class="epc-crm-drawer">
                    <div class="epc-crm-drawer-backdrop"></div>
                    <div class="epc-crm-drawer-panel">
                        <div class="epc-crm-drawer-hd">
                            <strong id="epc_crm_drawer_title">Details</strong>
                            <button type="button" class="btn btn-xs btn-default epc-crm-drawer-close">&times; Close</button>
                        </div>
                        <div class="epc-crm-drawer-bd" id="epc_crm_drawer_body"><p class="text-muted">Loading…</p></div>
                    </div>
                </div>

                <div id="epc_crm_timeline_modal" class="epc-crm-timeline-modal" style="display:none;">
                    <div class="epc-crm-timeline-backdrop"></div>
                    <div class="epc-crm-timeline-panel">
                        <div class="epc-crm-timeline-hd">
                            <strong id="epc_crm_timeline_title">Timeline</strong>
                            <button type="button" class="btn btn-xs btn-default epc-crm-timeline-close pull-right">&times; Close</button>
                        </div>
                        <div class="epc-crm-timeline-bd" id="epc_crm_timeline_body"><p class="text-muted">Loading…</p></div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script>
window.EPC_CRM = @((MarkupString)JsonSerializer.Serialize(new
{
    ajaxUrl = EcomAeRoutes.CpCrmAction,
    csrf = _csrf,
    actionPrefix = "",
    currency = _cur,
    openLeadId = 0,
    openTicketId = _openedTicketId,
    openProjectId = _openedProjectId,
}, JsonOptions));
    </script>
    <script src="/platform-assets/epc_crm_board.js?v=20260922crm" defer></script>
    }
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/crm/crm_main";
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    private bool _isAdmin;
    private string _tab = "dashboard";
    private string _leadStatus = "";
    private string _listHref = "/cp/crm-board-app";
    private string _flashOk = "";
    private string _flashErr = "";
    private string _csrf = "";
    private string _cur = "AED";
    private long _now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
    private long _openedId;
    private long _openedOppId;
    private long _openedTicketId;
    private long _openedProjectId;
    private CpCrmLeadRow? _openedLead;
    private CpCrmDesk _desk = CpCrmDesk.Unavailable("", "AED");

    private string OpenedCaption => _openedLead is not null
        ? _openedLead.Company
        : (_openedId > 0 ? "Lead #" + _openedId.ToString(CultureInfo.InvariantCulture) : "");

    private string FlashText => _flashOk.Length > 0 ? _flashOk : _flashErr;
    private string FlashClass => _flashOk.Length > 0 ? "alert-success" : (_flashErr.Length > 0 ? "alert-danger" : "");
    private string FlashStyle => FlashText.Length > 0 ? "display:block" : "display:none";

    private string TabUrl(string tab) => _listHref + "?tab=" + Uri.EscapeDataString(tab);

    private static string TabIcon(string key) => key switch
    {
        "dashboard" => "fa-dashboard",
        "intelligence" => "fa-line-chart",
        "pipeline" => "fa-columns",
        "leads" => "fa-user-plus",
        "opportunities" => "fa-briefcase",
        "accounts" => "fa-building",
        "quotes" => "fa-file-text-o",
        "activities" => "fa-calendar",
        "tickets" => "fa-life-ring",
        "projects" => "fa-tasks",
        "contracts" => "fa-refresh",
        "expenses" => "fa-money",
        _ => "fa-circle-o",
    };

    private static string Money(decimal n) => CpCrmDeskService.Money(n);
    private static string Pct(decimal n) => n.ToString("0.#", CultureInfo.InvariantCulture);
    private static string ShortDate(long unix) => DateTimeOffset.FromUnixTimeSeconds(unix).UtcDateTime.ToString("dd MMM", CultureInfo.InvariantCulture);
    private static string LongDate(long unix) => DateTimeOffset.FromUnixTimeSeconds(unix).UtcDateTime.ToString("dd MMM yyyy", CultureInfo.InvariantCulture);
    private static string Trunc(string s, int n) => s.Length <= n ? s : s.Substring(0, n);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var path = ctx.Request.Path.Value ?? "/cp/crm-board-app";
        _listHref = path.StartsWith("/erp/", StringComparison.OrdinalIgnoreCase) ? "/erp/crm-board-app" : "/cp/crm-board-app";

        var q = ctx.Request.Query;
        var tab = q["tab"].ToString();
        if (tab.Length == 0) tab = q["crm_tab"].ToString();
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "lead_id");
        _openedOppId = ErpRecordOpen.ReadId(ctx.Request, "opp_id");
        _openedTicketId = ErpRecordOpen.ReadId(ctx.Request, "ticket_id");
        _openedProjectId = ErpRecordOpen.ReadId(ctx.Request, "project_id");
        if (tab.Length == 0)
        {
            tab = _openedId > 0 ? "leads" : _openedOppId > 0 ? "opportunities" : _openedTicketId > 0 ? "tickets" : _openedProjectId > 0 ? "projects" : "dashboard";
        }
        _tab = CpCrmDeskService.IsTab(tab) ? tab : "dashboard";
        _leadStatus = q["lead_status"].ToString();
        _flashOk = q["ok"].ToString();
        _flashErr = q["err"].ToString();

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        _csrf = await Csrf.KeyForAsync(ctx, session, ctx.RequestAborted);
        _desk = await Desk.LoadAsync(_tab, _leadStatus, ctx.RequestAborted);
        _cur = string.IsNullOrWhiteSpace(_desk.CurrencyCode) ? "AED" : _desk.CurrencyCode;
        if (_openedId > 0 && _tab == "leads")
        {
            _openedLead = await Desk.GetLeadAsync(_openedId, ctx.RequestAborted);
        }
    }
}
