@page "/cp/crm-board-app"
@page "/erp/crm-board-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>CRM Board · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                CRM board
                <a class="btn btn-xs btn-default pull-right" href="/cp/marketing-broadcast-app">Marketing broadcast</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" style="margin-right:.4rem">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Leads from tenant CRM tables. Edit and pipeline actions stay on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/crm-board-app" IsAdmin="_isAdmin" />

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Leads</div>
            <div class="panel-body">
                <p class="help-block">@_summary.Leads.ToString(CultureInfo.InvariantCulture) leads · @_summary.Opportunities.ToString(CultureInfo.InvariantCulture) opportunities · @_summary.Activities.ToString(CultureInfo.InvariantCulture) activities · @_summary.TicketsOpen.ToString(CultureInfo.InvariantCulture) open tickets.</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Status</th>
                                <th>Source</th>
                                <th>Owner</th>
                                <th>Amount</th>
                                <th>Updated</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_leads.Count == 0)
                        {
                            <tr><td colspan="7">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var l in _leads)
                            {
                                <tr>
                                    <td>@l.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(string.IsNullOrWhiteSpace(l.Title) ? "—" : l.Title)</td>
                                    <td>@(string.IsNullOrWhiteSpace(l.Status) ? "—" : l.Status)</td>
                                    <td>@(string.IsNullOrWhiteSpace(l.Source) ? "—" : l.Source)</td>
                                    <td>@l.OwnerId.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@l.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@(l.UpdatedAt > 0 ? l.UpdatedAt.ToString(CultureInfo.InvariantCulture) : "—")</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/crm/crm_main";
    private bool _isAdmin;
    private CpCrmBoardSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpCrmLeadDigest> _leads = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpCrmBoardDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _leads = result.Leads;
        _source = result.Source;
        _message = result.Message;
    }
}
