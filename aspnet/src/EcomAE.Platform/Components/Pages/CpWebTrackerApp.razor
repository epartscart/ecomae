@page "/cp/web-tracker-app"
@page "/cp/shop/statistics/web_tracker"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Website tracker · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
@foreach (var href in LegacyPresentationAssets.CpWebTrackerStylesheets)
{
    <link rel="stylesheet" href="@href" />
}

<PhpCpDesktopChrome IsAdmin="_isAdmin">

<div class="epc-web-tracker epc-wt" data-epc-web-tracker="1" data-epc-wt-ssr="1">
    <div class="wt-hero">
        <div class="wt-hero__badge">@(_isSuper ? "Super CP · all tenants" : "Tenant traffic")</div>
        <h1>Website tracker</h1>
        <p>Pageviews, clicks, search, geography, devices, and full session timelines for guests and registered users.</p>
        <div class="wt-hero__meta">
            <span><i class="fa fa-broadcast-tower"></i> Beacon <code>/epc-web-tracker-collect.php</code></span>
            <span><i class="fa fa-filter"></i> Apply filters reloads this page</span>
        </div>
    </div>

    @if (!_isAdmin)
    {
        <div class="wt-status alert alert-info" role="status">Sign in with a Control Panel admin session to load live tracker data.</div>
    }
    else
    {
        <form class="wt-filters" method="get" action="/cp/web-tracker-app" id="wt_filter_form">
            @if (_isSuper)
            {
                <div>
                    <label for="wt_site">Site / tenant</label>
                    <select id="wt_site" name="site_key" class="form-control">
                        @foreach (var sk in _siteOptions)
                        {
                            if (sk == _filters.SiteKey)
                            {
                                <option value="@sk" selected>@(sk == "_all" ? "All sites (Super)" : sk)</option>
                            }
                            else
                            {
                                <option value="@sk">@(sk == "_all" ? "All sites (Super)" : sk)</option>
                            }
                        }
                    </select>
                </div>
            }
            else
            {
                <input type="hidden" id="wt_site" name="site_key" value="@_filters.SiteKey" />
                <div>
                    <label>Site</label>
                    <div class="form-control wt-site-locked">@_filters.SiteKey</div>
                </div>
            }
            <div>
                <label for="wt_from">From</label>
                <input type="date" id="wt_from" name="from" class="form-control" value="@_filters.FromDate" />
            </div>
            <div>
                <label for="wt_to">To</label>
                <input type="date" id="wt_to" name="to" class="form-control" value="@_filters.ToDate" />
            </div>
            <div>
                <label for="wt_device">Device</label>
                <select id="wt_device" name="device" class="form-control">
                    @if (string.IsNullOrEmpty(_filters.Device))
                    {
                        <option value="" selected>All devices</option>
                    }
                    else
                    {
                        <option value="">All devices</option>
                    }
                    @foreach (var d in DeviceChoices())
                    {
                        if (d.Value == _filters.Device)
                        {
                            <option value="@d.Value" selected>@d.Label</option>
                        }
                        else
                        {
                            <option value="@d.Value">@d.Label</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label for="wt_country">Country</label>
                <select id="wt_country" name="country" class="form-control">
                    <option value="">All countries</option>
                    @foreach (var c in _dash.Facets.Countries)
                    {
                        if (c.Value == _filters.Country)
                        {
                            <option value="@c.Value" selected>@FacetLabel(c)</option>
                        }
                        else
                        {
                            <option value="@c.Value">@FacetLabel(c)</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label for="wt_ip">IP address</label>
                <input type="text" id="wt_ip" name="ip" class="form-control" value="@_filters.Ip" placeholder="e.g. 86.96." autocomplete="off" />
            </div>
            <div>
                <label for="wt_user_id">User ID</label>
                <input type="text" id="wt_user_id" name="user_id" class="form-control" value="@_filters.UserId" placeholder="e.g. 5" inputmode="numeric" autocomplete="off" />
            </div>
            <div>
                <label for="wt_user_type">Who</label>
                <select id="wt_user_type" name="user_type" class="form-control">
                    @if (string.IsNullOrEmpty(_filters.UserType))
                    {
                        <option value="" selected>All visitors</option>
                    }
                    else
                    {
                        <option value="">All visitors</option>
                    }
                    @if (_filters.UserType == "guest")
                    {
                        <option value="guest" selected>Guests only</option>
                    }
                    else
                    {
                        <option value="guest">Guests only</option>
                    }
                    @if (_filters.UserType == "registered")
                    {
                        <option value="registered" selected>Registered only</option>
                    }
                    else
                    {
                        <option value="registered">Registered only</option>
                    }
                </select>
            </div>
            <div>
                <label for="wt_browser">Browser</label>
                <select id="wt_browser" name="browser" class="form-control">
                    <option value="">All browsers</option>
                    @foreach (var b in _dash.Facets.Browsers)
                    {
                        if (b.Value == _filters.Browser)
                        {
                            <option value="@b.Value" selected>@FacetLabel(b)</option>
                        }
                        else
                        {
                            <option value="@b.Value">@FacetLabel(b)</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label for="wt_path">Page path contains</label>
                <input type="text" id="wt_path" name="path" class="form-control" value="@_filters.Path" placeholder="/en/parts/" autocomplete="off" />
            </div>
            <div class="wt-filter-actions">
                <button type="submit" class="btn btn-primary" id="wt_reload"><i class="fa fa-refresh"></i> Apply filters</button>
                <a class="btn btn-default" id="wt_clear_filters" href="/cp/web-tracker-app">Clear filters</a>
                <a class="btn btn-default" id="wt_csv" href="@CsvHref()"><i class="fa fa-download"></i> Download full report (CSV)</a>
            </div>
        </form>

        <div class="wt-status @StatusClass()" id="wt_status" data-epc-wt-status="@_dash.Source">@StatusText()</div>

        <div class="wt-kpis" id="wt_kpis" aria-label="Website tracker KPIs">
            @Kpi("Sessions", _dash.Summary.Sessions)
            @Kpi("Visitors", _dash.Summary.Visitors)
            @Kpi("Pageviews", _dash.Summary.Pageviews)
            @Kpi("Clicks", _dash.Summary.Clicks)
            @Kpi("Searches", _dash.Summary.Searches)
            @Kpi("Guests", _dash.Summary.GuestSessions)
            @Kpi("Registered", _dash.Summary.RegisteredSessions)
            @Kpi("Avg time", Dur(_dash.Summary.AvgDurationMs))
            @Kpi("Avg pages", _dash.Summary.AvgPages.ToString("0.##", CultureInfo.InvariantCulture))
            @Kpi("Bounce %", _dash.Summary.BounceRate.ToString("0.##", CultureInfo.InvariantCulture))
        </div>

        <div class="wt-grid">
            <div class="wt-panel">
                <h4>Traffic by day</h4>
                <div class="wt-body" id="wt_daily">
                    @if (_dash.Daily.Count == 0)
                    {
                        <p class="wt-muted">No data for this range/filters.</p>
                    }
                    else
                    {
                        var maxPv = Math.Max(1, _dash.Daily.Max(d => d.Pageviews));
                        <div class="wt-bars" title="Pageviews by day">
                            @foreach (var d in _dash.Daily)
                            {
                                var h = Math.Max(4, (int)Math.Round(80.0 * d.Pageviews / maxPv));
                                <i style="height:@(h.ToString(CultureInfo.InvariantCulture))px" title="@d.Date: @d.Pageviews views / @d.Sessions sessions"></i>
                            }
                        </div>
                        <table class="wt-table">
                            <thead><tr><th>Date</th><th>Sessions</th><th>Pageviews</th></tr></thead>
                            <tbody>
                            @foreach (var d in _dash.Daily)
                            {
                                <tr>
                                    <td>@d.Date</td>
                                    <td>@d.Sessions.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@d.Pageviews.ToString(CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
            <div class="wt-panel">
                <h4>@(_isSuper ? "By tenant / hostname" : "Devices & browsers")</h4>
                <div class="wt-body" id="wt_side_a">
                    @if (_isSuper && (_dash.SiteKey == "_all" || _dash.ByTenant.Count > 0))
                    {
                        <table class="wt-table">
                            <thead><tr><th>Site</th><th>Host</th><th>Sessions</th><th>Views</th><th>Visitors</th></tr></thead>
                            <tbody>
                            @if (_dash.ByTenant.Count == 0)
                            {
                                <tr><td colspan="5" class="wt-muted">No tenant traffic yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var t in _dash.ByTenant)
                                {
                                    <tr>
                                        <td><a class="wt-link" href="@FilterHref(siteKey: t.SiteKey)">@EmptyDash(t.SiteKey)</a></td>
                                        <td>@EmptyDash(t.Hostname)</td>
                                        <td>@t.Sessions.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@t.Pageviews.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@t.Visitors.ToString(CultureInfo.InvariantCulture)</td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        @DeviceTable()
                    }
                </div>
            </div>
        </div>

        <div class="wt-grid">
            <div class="wt-panel">
                <h4>Top pages (experience)</h4>
                <div class="wt-body" id="wt_pages">
                    <table class="wt-table">
                        <thead><tr><th>Path</th><th>Views</th><th>Sessions</th><th>Avg time</th><th>Scroll %</th></tr></thead>
                        <tbody>
                        @if (_dash.TopPages.Count == 0)
                        {
                            <tr><td colspan="5" class="wt-muted">—</td></tr>
                        }
                        else
                        {
                            @foreach (var p in _dash.TopPages)
                            {
                                <tr>
                                    <td>
                                        <a class="wt-link wt-page-link" href="@PageHref(p.Path)" target="_blank" rel="noopener">@EmptyDash(p.Path, "/")</a>
                                        <a class="wt-device-click" href="@FilterHref(path: p.Path)">filter</a>
                                    </td>
                                    <td>@p.Views.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@p.Sessions.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@Dur(p.AvgTimeMs)</td>
                                    <td>@p.AvgScroll.ToString(CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="wt-panel">
                <h4>Geography</h4>
                <div class="wt-body" id="wt_geo">
                    @if (_dash.Geo.Count > 0)
                    {
                        var maxG = Math.Max(1, _dash.Geo.Take(8).Max(g => g.Sessions));
                        <div class="wt-hbar" aria-label="Top countries">
                            @foreach (var g in _dash.Geo.Take(8))
                            {
                                var pct = Math.Max(4, (int)Math.Round(100.0 * g.Sessions / maxG));
                                <div class="wt-hbar__row">
                                    <a class="wt-geo-click" href="@FilterHref(country: g.CountryCode)">@EmptyDash(g.CountryCode, "??")</a>
                                    <div class="wt-hbar__track"><div class="wt-hbar__fill" style="width:@(pct.ToString(CultureInfo.InvariantCulture))%"></div></div>
                                    <span>@g.Sessions.ToString(CultureInfo.InvariantCulture)</span>
                                </div>
                            }
                        </div>
                    }
                    <table class="wt-table">
                        <thead><tr><th>Country</th><th>City</th><th>Sessions</th></tr></thead>
                        <tbody>
                        @if (_dash.Geo.Count == 0)
                        {
                            <tr><td colspan="3" class="wt-muted">—</td></tr>
                        }
                        else
                        {
                            @foreach (var g in _dash.Geo)
                            {
                                var label = string.IsNullOrWhiteSpace(g.CountryName) ? g.CountryCode : g.CountryName;
                                if (!string.IsNullOrWhiteSpace(g.CountryCode)) label += " (" + g.CountryCode + ")";
                                <tr>
                                    <td><a class="wt-geo-click" href="@FilterHref(country: g.CountryCode)">@EmptyDash(label, "Unknown")</a></td>
                                    <td>@EmptyDash(g.City)</td>
                                    <td>@g.Sessions.ToString(CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="wt-grid">
            <div class="wt-panel">
                <h4>Search terms</h4>
                <div class="wt-body" id="wt_search">
                    <table class="wt-table">
                        <thead><tr><th>Query</th><th>Context</th><th>Hits</th><th>Sessions</th></tr></thead>
                        <tbody>
                        @if (_dash.Searches.Count == 0)
                        {
                            <tr><td colspan="4" class="wt-muted">No searches captured yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var s in _dash.Searches)
                            {
                                <tr>
                                    <td><strong>@EmptyDash(s.SearchQuery)</strong></td>
                                    <td>@EmptyDash(s.SearchContext)</td>
                                    <td>@s.Hits.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@s.Sessions.ToString(CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="wt-panel">
                <h4>Top clicks</h4>
                <div class="wt-body" id="wt_clicks">
                    <table class="wt-table">
                        <thead><tr><th>Path</th><th>Element</th><th>Text / href</th><th>Hits</th></tr></thead>
                        <tbody>
                        @if (_dash.TopClicks.Count == 0)
                        {
                            <tr><td colspan="4" class="wt-muted">—</td></tr>
                        }
                        else
                        {
                            @foreach (var c in _dash.TopClicks)
                            {
                                var el = c.ElementTag + (string.IsNullOrWhiteSpace(c.ElementId) ? "" : "#" + c.ElementId);
                                var tx = string.IsNullOrWhiteSpace(c.ElementText) ? c.ElementHref : c.ElementText;
                                <tr>
                                    <td><a class="wt-link wt-page-link" href="@PageHref(c.Path)" target="_blank" rel="noopener">@EmptyDash(c.Path, "/")</a></td>
                                    <td>@EmptyDash(el)</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(c.ElementHref))
                                        {
                                            <a class="wt-link wt-page-link" href="@c.ElementHref" target="_blank" rel="noopener">@EmptyDash(tx)</a>
                                        }
                                        else
                                        {
                                            @EmptyDash(tx)
                                        }
                                    </td>
                                    <td>@c.Hits.ToString(CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="wt-grid">
            <div class="wt-panel">
                <h4>Referrers &amp; UTM</h4>
                <div class="wt-body" id="wt_refs">
                    <table class="wt-table">
                        <thead><tr><th>Referrer</th><th>UTM source</th><th>Medium</th><th>Campaign</th><th>Sessions</th></tr></thead>
                        <tbody>
                        @if (_dash.Referrers.Count == 0)
                        {
                            <tr><td colspan="5" class="wt-muted">—</td></tr>
                        }
                        else
                        {
                            @foreach (var r in _dash.Referrers)
                            {
                                <tr>
                                    <td>@EmptyDash(r.Host)</td>
                                    <td>@EmptyDash(r.UtmSource)</td>
                                    <td>@EmptyDash(r.UtmMedium)</td>
                                    <td>@EmptyDash(r.UtmCampaign)</td>
                                    <td>@r.Sessions.ToString(CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="wt-panel">
                <h4>@(_isSuper ? "Devices & browsers" : "Filter tips")</h4>
                <div class="wt-body" id="wt_side_b">
                    @if (_isSuper)
                    {
                        @DeviceTable()
                    }
                    else
                    {
                        <p class="wt-muted">Use filters above (device, country, IP, user, path). Click a country, IP, device, or user in the tables to filter. Charts update after Apply filters.</p>
                    }
                </div>
            </div>
        </div>

        <div class="wt-panel" style="margin-bottom:20px;">
            <h4>Recent sessions — IP shown · click page links to open that page · click Timeline for the full visit</h4>
            <div class="wt-body" id="wt_sessions" style="max-height:520px;">
                <table class="wt-table">
                    <thead>
                        <tr>
                            <th>When</th><th>Who</th><th>IP</th><th>Geo</th><th>Device</th>
                            <th>Land → Exit</th><th>Pages</th><th>Clicks</th><th>Time</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (_dash.RecentSessions.Count == 0)
                    {
                        <tr><td colspan="10" class="wt-muted">No sessions for these filters.</td></tr>
                    }
                    else
                    {
                        @foreach (var s in _dash.RecentSessions)
                        {
                            var geo = string.Join(", ", new[] { s.City, s.CountryCode }.Where(x => !string.IsNullOrWhiteSpace(x)));
                            <tr class="wt-row-click">
                                <td>@FmtTs(s.LastSeenAt)</td>
                                <td>
                                    @if (s.IsRegistered)
                                    {
                                        <a class="wt-pill reg wt-user-click" href="@FilterHref(userId: s.UserId.ToString(CultureInfo.InvariantCulture))">User #@s.UserId.ToString(CultureInfo.InvariantCulture)</a>
                                    }
                                    else
                                    {
                                        <a class="wt-pill guest wt-user-click" href="@FilterHref(userType: "guest")">Guest</a>
                                    }
                                    @if (_isSuper)
                                    {
                                        <span class="wt-pill">@s.SiteKey</span>
                                    }
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(s.Ip))
                                    {
                                        <text>—</text>
                                    }
                                    else
                                    {
                                        <a class="wt-ip wt-ip-click" href="@FilterHref(ip: s.Ip)">@s.Ip</a>
                                    }
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(s.CountryCode))
                                    {
                                        @EmptyDash(geo)
                                    }
                                    else
                                    {
                                        <a class="wt-geo-click" href="@FilterHref(country: s.CountryCode)">@EmptyDash(geo)</a>
                                    }
                                </td>
                                <td>
                                    <a class="wt-device-click" href="@FilterHref(device: s.DeviceType)">@EmptyDash((s.DeviceType + " / " + s.Browser).Trim(' ', '/'))</a>
                                </td>
                                <td class="wt-paths">
                                    <a class="wt-link wt-page-link" href="@PageHref(s.LandingPath, s.Hostname)" target="_blank" rel="noopener">@EmptyDash(s.LandingPath, "/")</a>
                                    @if (!string.IsNullOrWhiteSpace(s.ExitPath) && !string.Equals(s.ExitPath, s.LandingPath, StringComparison.Ordinal))
                                    {
                                        <text> → </text>
                                        <a class="wt-link wt-page-link" href="@PageHref(s.ExitPath, s.Hostname)" target="_blank" rel="noopener">@s.ExitPath</a>
                                    }
                                </td>
                                <td>@s.PageviewCount.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@s.EventCount.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@Dur(s.DurationMs)</td>
                                <td><a class="wt-link wt-open" href="@FilterHref(sessionId: s.Id)">Timeline</a></td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>

        @if (_session is not null)
        {
            var s = _session.Session!;
            <div class="wt-panel" id="wt_session_timeline" style="margin-bottom:20px;">
                <h4>Session timeline <a class="wt-link" href="@FilterHref(sessionId: 0)" style="float:right;font-weight:500;">Close</a></h4>
                <div class="wt-body">
                    <p>
                        <strong>@s.SiteKey</strong> · @EmptyDash(s.Hostname)
                        · <span class="wt-ip">IP @EmptyDash(s.Ip)</span>
                        · @(s.IsRegistered ? "Registered user #" + s.UserId.ToString(CultureInfo.InvariantCulture) : "Guest")
                        · @EmptyDash(s.City) @EmptyDash(s.Region) @EmptyDash(string.IsNullOrWhiteSpace(s.CountryName) ? s.CountryCode : s.CountryName)
                        · @EmptyDash(s.DeviceType) / @EmptyDash(s.Browser) / @EmptyDash(s.Os)
                    </p>
                    <p class="wt-muted">
                        Landed @FmtTs(s.FirstSeenAt) · Last @FmtTs(s.LastSeenAt)
                        · Duration @Dur(s.DurationMs)
                        · Referrer @EmptyDash(s.ReferrerHost, "(direct)")
                        @if (!string.IsNullOrWhiteSpace(s.UtmSource))
                        {
                            <text> · UTM @s.UtmSource</text>
                        }
                    </p>
                    <h5>Page experience</h5>
                    <ul class="wt-timeline">
                        @if (_session.Pageviews.Count == 0)
                        {
                            <li class="wt-muted">No pageviews.</li>
                        }
                        else
                        {
                            @foreach (var p in _session.Pageviews)
                            {
                                var href = PageHref(p.Path + (string.IsNullOrWhiteSpace(p.Query) ? "" : "?" + p.Query), s.Hostname);
                                <li>
                                    <strong>@FmtTs(p.Ts)</strong>
                                    <a class="wt-link wt-page-link" href="@href" target="_blank" rel="noopener">@EmptyDash(p.Path, "/")</a>
                                    <span class="wt-muted">· @EmptyDash(p.Title) · on-page @Dur(p.TimeOnPageMs) · scroll @p.ScrollMaxPct.ToString(CultureInfo.InvariantCulture)% · load @p.LoadTimeMs.ToString(CultureInfo.InvariantCulture)ms</span>
                                </li>
                            }
                        }
                    </ul>
                    <h5>Clicks &amp; events</h5>
                    <ul class="wt-timeline">
                        @if (_session.Events.Count == 0)
                        {
                            <li class="wt-muted">No click/search events.</li>
                        }
                        else
                        {
                            @foreach (var e in _session.Events)
                            {
                                <li>
                                    <strong>@FmtTs(e.Ts)</strong> <span class="wt-pill">@EmptyDash(e.EventType)</span>
                                    @if (e.EventType == "search")
                                    {
                                        <text> search “@e.SearchQuery” <span class="wt-muted">(@EmptyDash(e.SearchContext))</span></text>
                                    }
                                    else if (e.EventType is "click" or "outbound")
                                    {
                                        <text> @e.ElementTag@(string.IsNullOrWhiteSpace(e.ElementId) ? "" : "#" + e.ElementId) “@e.ElementText” </text>
                                        @if (!string.IsNullOrWhiteSpace(e.ElementHref))
                                        {
                                            <a class="wt-link wt-page-link" href="@e.ElementHref" target="_blank" rel="noopener">→ @e.ElementHref</a>
                                        }
                                        <span class="wt-muted">@e.X.ToString(CultureInfo.InvariantCulture),@e.Y.ToString(CultureInfo.InvariantCulture) on <a class="wt-link" href="@PageHref(e.Path, s.Hostname)" target="_blank" rel="noopener">@EmptyDash(e.Path, "/")</a></span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(e.Path))
                                    {
                                        <a class="wt-link" href="@PageHref(e.Path, s.Hostname)" target="_blank" rel="noopener">@e.Path</a>
                                    }
                                </li>
                            }
                        }
                    </ul>
                </div>
