@page "/cp/order-statuses-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@inject ICpOrderStatusWriteService Writes
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Order statuses · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
    .epc-statuses-page { --es-ink:#0f172a; --es-muted:#64748b; --es-line:#e2e8f0; --es-soft:#f8fafc; margin-bottom:24px; }
    .epc-statuses-page__hero { display:flex; flex-wrap:wrap; align-items:flex-start; justify-content:space-between; gap:14px; margin:0 0 16px; padding:18px 20px; border-radius:14px; background:linear-gradient(135deg,#0f172a 0%,#1e293b 50%,#334155 100%); color:#f8fafc; }
    .epc-statuses-page__hero h2 { margin:0 0 6px; font-size:1.3rem; font-weight:700; }
    .epc-statuses-page__hero p { margin:0; max-width:42rem; font-size:13px; line-height:1.45; opacity:.92; }
    .epc-statuses-page__hero-actions { display:flex; flex-wrap:wrap; gap:8px; }
    .epc-statuses-hint { margin:0 0 16px; padding:12px 14px; border:1px solid #e2e8f0; border-radius:10px; background:#f8fafc; color:#334155; font-size:13px; }
    .epc-statuses-card { background:#fff; border:1px solid #e2e8f0; border-radius:14px; box-shadow:0 1px 3px rgba(15,23,42,.05); margin-bottom:14px; overflow:hidden; }
    .epc-statuses-card__head { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:12px 16px; background:#f8fafc; border-bottom:1px solid #e2e8f0; }
    .epc-statuses-card__head h3 { margin:0; font-size:15px; font-weight:700; color:#0f172a; }
    .epc-statuses-card__head span { font-size:12px; color:#64748b; }
    .epc-statuses-card__body { padding:14px 16px 16px; }
</style>
</HeadContent>

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12 epc-statuses-page">
        <div class="epc-statuses-page__hero">
            <div>
                <h2>Order statuses</h2>
                <p>Configure order and line-item statuses used across the orders desk. Save writes here. Tree editor chrome stays on the Classic twin.</p>
            </div>
            <div class="epc-statuses-page__hero-actions">
                <a class="btn btn-default btn-sm" href="/cp/orders">Orders</a>
                <a class="btn btn-default btn-sm" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
        </div>

        <div class="epc-statuses-hint">
            <strong>Tips:</strong> Statuses not listed in the JSON are deleted. Empty lists are refused. Notification send stays Classic; flags are stored.
        </div>

        <PhpParityModuleBody AppPath="/cp/order-statuses-app" IsAdmin="_isAdmin" />

        @if (!string.IsNullOrWhiteSpace(_flashOk))
        {
            <div class="alert alert-success" role="status">@_flashOk</div>
        }
        @if (!string.IsNullOrWhiteSpace(_flashErr))
        {
            <div class="alert alert-danger" role="status">@_flashErr</div>
        }

        @if (_isAdmin)
        {
            <div class="epc-statuses-card">
                <div class="epc-statuses-card__head">
                    <h3>Save statuses</h3>
                    <span>JSON write</span>
                </div>
                <div class="epc-statuses-card__body">
                    <form method="post" action="/cp/order-statuses/write" style="display:flex;flex-direction:column;gap:.45rem;margin:0;max-width:52rem">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="/cp/order-statuses-app" />
                        <label>Order statuses JSON
                            <textarea name="ordersJson" required rows="6" style="width:100%;font-family:ui-monospace,monospace;font-size:.82rem" placeholder='[{"id":1,"value":"New","color":"#3498db","for_created":1,"created_earlier":1}]'></textarea>
                        </label>
                        <label>Item statuses JSON
                            <textarea name="itemsJson" required rows="6" style="width:100%;font-family:ui-monospace,monospace;font-size:.82rem" placeholder='[{"id":1,"value":"Reserved","color":"#2ecc71","for_created":1,"count_flag":1,"created_earlier":1}]'></textarea>
                        </label>
                        <button type="submit" class="btn btn-primary btn-sm">Save statuses</button>
                    </form>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-6">
                <div class="epc-statuses-card">
                    <div class="epc-statuses-card__head">
                        <h3>Order statuses</h3>
                        <span>Order-level · @_orders.Count.ToString(CultureInfo.InvariantCulture) · finish @_orderFinish.ToString(CultureInfo.InvariantCulture)</span>
                    </div>
                    <div class="epc-statuses-card__body">
                        <div class="table-responsive">
                            <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                                <thead>
                                    <tr>
                                        <th>Id</th>
                                        <th>Order</th>
                                        <th>Name</th>
                                        <th>Color</th>
                                        <th>Created</th>
                                        <th>Paid</th>
                                        <th>Finish</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @if (_orders.Count == 0)
                                {
                                    <tr><td colspan="7">No order statuses yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in _orders)
                                    {
                                        <tr>
                                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@row.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(row.Caption) ? row.Caption : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(row.Color) ? row.Color : "—")</td>
                                            <td>@row.ForCreated.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@row.ForPaid.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@row.ForFinish.ToString(CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="epc-statuses-card">
                    <div class="epc-statuses-card__head">
                        <h3>Item statuses</h3>
                        <span>Line-item · @_items.Count.ToString(CultureInfo.InvariantCulture) · finish @_itemFinish.ToString(CultureInfo.InvariantCulture)</span>
                    </div>
                    <div class="epc-statuses-card__body">
                        <div class="table-responsive">
                            <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                                <thead>
                                    <tr>
                                        <th>Id</th>
                                        <th>Order</th>
                                        <th>Name</th>
                                        <th>Color</th>
                                        <th>Created</th>
                                        <th>Finish</th>
                                        <th>Count</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @if (_items.Count == 0)
                                {
                                    <tr><td colspan="7">No item statuses yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in _items)
                                    {
                                        <tr>
                                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@row.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(row.Caption) ? row.Caption : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(row.Color) ? row.Color : "—")</td>
                                            <td>@row.ForCreated.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@row.ForFinish.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@row.CountFlag.ToString(CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/orders/statuses";
    private bool _isAdmin;
    private IReadOnlyList<CpOrderStatusRow> _orders = [];
    private IReadOnlyList<CpItemStatusRow> _items = [];
    private int _orderFinish;
    private int _itemFinish;
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        var result = await Writes.ReadAsync(ctx.RequestAborted);
        _orders = result.Orders;
        _items = result.Items;
        _orderFinish = _orders.Count(r => r.ForFinish == 1);
        _itemFinish = _items.Count(r => r.ForFinish == 1);
    }
}
