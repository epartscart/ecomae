@page "/cp/order-statuses-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@inject ICpOrderStatusWriteService Writes
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Order statuses · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
    .epc-statuses-page { margin-bottom:24px; }
    .epc-statuses-card { margin-bottom:14px; }
    .epc-st-grid td, .epc-st-grid th { vertical-align:middle !important; white-space:nowrap; }
    .epc-st-grid input[type=text] { min-width:9rem; }
    .epc-st-grid input[type=color] { width:2.6rem; padding:0 2px; height:28px; }
    .epc-st-grid .epc-st-flag { text-align:center; }
    .epc-st-grid .epc-st-handle { color:#94a3b8; cursor:grab; }
    .epc-st-actions { display:flex; gap:.5rem; flex-wrap:wrap; align-items:center; margin-top:.6rem; }
</style>
</HeadContent>

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12 epc-statuses-page">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Order statuses
                <a class="btn btn-xs btn-default pull-right" href="/cp/orders-app">Orders</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" style="margin-right:.4rem">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/order-statuses-app")</p>
                <p class="text-muted" style="margin:0">
                    Edit captions, colours, flags and notification channels for order and item statuses, drag rows to reorder, then save both grids together.
                    Rows removed from a grid are deleted on save; each grid must keep at least one status.
                </p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_flashOk))
        {
            <div class="alert alert-success" role="status">@_flashOk</div>
        }
        @if (!string.IsNullOrWhiteSpace(_flashErr))
        {
            <div class="alert alert-danger" role="status">@_flashErr</div>
        }
        @if (!_isAdmin)
        {
            <div class="alert alert-warning" role="status">Sign in with an admin CP session to manage order statuses. <a href="/cp/login?returnUrl=/cp/order-statuses-app">Sign in</a></div>
        }

        <form method="post" action="/cp/order-statuses/write" id="epc_status_form">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/order-statuses-app" />
            <input type="hidden" name="langCode" value="en" />

            <div class="hpanel epc-statuses-card">
                <div class="panel-heading hbuilt">
                    Order statuses
                    <span class="text-muted" style="margin-left:.5rem">@_orders.Count.ToString(CultureInfo.InvariantCulture) statuses · @_orderFinish.ToString(CultureInfo.InvariantCulture) finish</span>
                </div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table class="table table-condensed table-striped table-epc epc-st-grid" id="epc_os_grid">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Id</th>
                                    <th>Caption</th>
                                    <th>Colour</th>
                                    <th class="epc-st-flag" title="Set on order creation">Created</th>
                                    <th class="epc-st-flag" title="Set when paid">Paid</th>
                                    <th class="epc-st-flag" title="Final status">Finish</th>
                                    <th class="epc-st-flag" title="Cancelled / inverse">Inverse</th>
                                    <th class="epc-st-flag">Mgr email</th>
                                    <th class="epc-st-flag">Mgr SMS</th>
                                    <th class="epc-st-flag">Cust email</th>
                                    <th class="epc-st-flag">Cust SMS</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @{ var oi = 0; }
                            @foreach (var row in _orders)
                            {
                                var k = "os_" + oi.ToString(CultureInfo.InvariantCulture) + "_";
                                <tr draggable="true">
                                    <td class="epc-st-handle" title="Drag to reorder">&#9776;<input type="hidden" name="os_idx" value="@oi" /></td>
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)<input type="hidden" name="@(k + "id")" value="@row.Id" /><input type="hidden" name="@(k + "name")" value="@row.NameKey" /></td>
                                    <td><input class="form-control input-sm" type="text" name="@(k + "caption")" value="@row.Caption" maxlength="120" required disabled="@(!_isAdmin)" /></td>
                                    <td><input type="color" name="@(k + "color")" value="@ColorOrDefault(row.Color)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "for_created")" value="1" checked="@(row.ForCreated == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "for_paid")" value="1" checked="@(row.ForPaid == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "for_finish")" value="1" checked="@(row.ForFinish == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "for_inverse")" value="1" checked="@(row.ForInverse == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "to_manager_email")" value="1" checked="@(row.ToManagerEmail == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "to_manager_sms")" value="1" checked="@(row.ToManagerSms == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "to_customer_email")" value="1" checked="@(row.ToCustomerEmail == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "to_customer_sms")" value="1" checked="@(row.ToCustomerSms == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td>@if (_isAdmin) { <button type="button" class="btn btn-xs btn-danger" onclick="epcStRemove(this)" title="Remove (deleted on save)">&times;</button> }</td>
                                </tr>
                                oi++;
                            }
                            @if (_orders.Count == 0)
                            {
                                <tr class="epc-st-empty"><td colspan="13" class="text-muted">No order statuses yet — add one below.</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    @if (_isAdmin)
                    {
                        <div class="epc-st-actions">
                            <button type="button" class="btn btn-sm btn-default" onclick="epcStAdd('epc_os_grid','os',8)">+ Add order status</button>
                        </div>
                    }
                </div>
            </div>

            <div class="hpanel epc-statuses-card">
                <div class="panel-heading hbuilt">
                    Item statuses
                    <span class="text-muted" style="margin-left:.5rem">@_items.Count.ToString(CultureInfo.InvariantCulture) statuses · @_itemFinish.ToString(CultureInfo.InvariantCulture) finish</span>
                </div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table class="table table-condensed table-striped table-epc epc-st-grid" id="epc_is_grid">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Id</th>
                                    <th>Caption</th>
                                    <th>Colour</th>
                                    <th class="epc-st-flag" title="Set on order creation">Created</th>
                                    <th class="epc-st-flag" title="Final status">Finish</th>
                                    <th class="epc-st-flag" title="Counts toward stock reservation">Count</th>
                                    <th class="epc-st-flag" title="Issue / hand-over">Issue</th>
                                    <th class="epc-st-flag">Mgr email</th>
                                    <th class="epc-st-flag">Mgr SMS</th>
                                    <th class="epc-st-flag">Cust email</th>
                                    <th class="epc-st-flag">Cust SMS</th>
                                    <th class="epc-st-flag" title="Return requested">Return</th>
                                    <th class="epc-st-flag" title="Return under check">Check</th>
                                    <th class="epc-st-flag" title="Return completed">Done</th>
                                    <th class="epc-st-flag" title="Return rejected">Reject</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @{ var ii = 0; }
                            @foreach (var row in _items)
                            {
                                var k = "is_" + ii.ToString(CultureInfo.InvariantCulture) + "_";
                                <tr draggable="true">
                                    <td class="epc-st-handle" title="Drag to reorder">&#9776;<input type="hidden" name="is_idx" value="@ii" /></td>
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)<input type="hidden" name="@(k + "id")" value="@row.Id" /><input type="hidden" name="@(k + "name")" value="@row.NameKey" /></td>
                                    <td><input class="form-control input-sm" type="text" name="@(k + "caption")" value="@row.Caption" maxlength="120" required disabled="@(!_isAdmin)" /></td>
                                    <td><input type="color" name="@(k + "color")" value="@ColorOrDefault(row.Color)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "for_created")" value="1" checked="@(row.ForCreated == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "for_finish")" value="1" checked="@(row.ForFinish == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "count_flag")" value="1" checked="@(row.CountFlag == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "issue_flag")" value="1" checked="@(row.IssueFlag == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "to_manager_email")" value="1" checked="@(row.ToManagerEmail == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "to_manager_sms")" value="1" checked="@(row.ToManagerSms == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "to_customer_email")" value="1" checked="@(row.ToCustomerEmail == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "to_customer_sms")" value="1" checked="@(row.ToCustomerSms == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "for_return")" value="1" checked="@(row.ForReturn == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "check_for_return")" value="1" checked="@(row.CheckForReturn == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "complete_return")" value="1" checked="@(row.CompleteReturn == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td class="epc-st-flag"><input type="checkbox" name="@(k + "reject_return")" value="1" checked="@(row.RejectReturn == 1)" disabled="@(!_isAdmin)" /></td>
                                    <td>@if (_isAdmin) { <button type="button" class="btn btn-xs btn-danger" onclick="epcStRemove(this)" title="Remove (deleted on save)">&times;</button> }</td>
                                </tr>
                                ii++;
                            }
                            @if (_items.Count == 0)
                            {
                                <tr class="epc-st-empty"><td colspan="17" class="text-muted">No item statuses yet — add one below.</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    @if (_isAdmin)
                    {
                        <div class="epc-st-actions">
                            <button type="button" class="btn btn-sm btn-default" onclick="epcStAdd('epc_is_grid','is',12)">+ Add item status</button>
                        </div>
                    }
                </div>
            </div>

            @if (_isAdmin)
            {
                <div class="hpanel epc-statuses-card">
                    <div class="panel-body epc-st-actions">
                        <button type="submit" class="btn btn-primary">Save statuses</button>
                        <a class="btn btn-default" href="/cp/order-statuses-app">Reset</a>
                        <span class="text-muted">Saves both grids in one transaction; captions are stored as translation strings.</span>
                    </div>
                </div>
            }
        </form>

    <script>
        var epcStFlags = {
            os: ['for_created','for_paid','for_finish','for_inverse','to_manager_email','to_manager_sms','to_customer_email','to_customer_sms'],
            is: ['for_created','for_finish','count_flag','issue_flag','to_manager_email','to_manager_sms','to_customer_email','to_customer_sms','for_return','check_for_return','complete_return','reject_return']
        };
        function epcStRemove(btn) {
            var tr = btn.closest('tr');
            if (tr && confirm('Remove this status? It is deleted when you save.')) { tr.parentNode.removeChild(tr); }
        }
        function epcStAdd(gridId, prefix) {
            var tbody = document.getElementById(gridId).querySelector('tbody');
            var empty = tbody.querySelector('.epc-st-empty'); if (empty) { tbody.removeChild(empty); }
            var idx = Date.now() % 100000000;
            var k = prefix + '_' + idx + '_';
            var tr = document.createElement('tr'); tr.setAttribute('draggable', 'true');
            var html = '<td class="epc-st-handle">&#9776;<input type="hidden" name="' + prefix + '_idx" value="' + idx + '"></td>'
                + '<td>new<input type="hidden" name="' + k + 'id" value="0"></td>'
                + '<td><input class="form-control input-sm" type="text" name="' + k + 'caption" maxlength="120" required placeholder="Caption"></td>'
                + '<td><input type="color" name="' + k + 'color" value="#3498db"></td>';
            epcStFlags[prefix].forEach(function (f) { html += '<td class="epc-st-flag"><input type="checkbox" name="' + k + f + '" value="1"></td>'; });
            html += '<td><button type="button" class="btn btn-xs btn-danger" onclick="epcStRemove(this)">&times;</button></td>';
            tr.innerHTML = html;
            tbody.appendChild(tr);
            epcStWireDrag(tr);
            tr.querySelector('input[type=text]').focus();
        }
        var epcStDragging = null;
        function epcStWireDrag(tr) {
            tr.addEventListener('dragstart', function () { epcStDragging = tr; });
            tr.addEventListener('dragover', function (e) {
                e.preventDefault();
                if (!epcStDragging || epcStDragging === tr || epcStDragging.parentNode !== tr.parentNode) { return; }
                var rect = tr.getBoundingClientRect();
                var after = (e.clientY - rect.top) > rect.height / 2;
                tr.parentNode.insertBefore(epcStDragging, after ? tr.nextSibling : tr);
            });
            tr.addEventListener('dragend', function () { epcStDragging = null; });
        }
        document.querySelectorAll('.epc-st-grid tbody tr[draggable]').forEach(epcStWireDrag);
    </script>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/orders/statuses";
    private bool _isAdmin;
    private IReadOnlyList<CpOrderStatusRow> _orders = [];
    private IReadOnlyList<CpItemStatusRow> _items = [];
    private int _orderFinish;
    private int _itemFinish;
    private string _flashOk = "";
    private string _flashErr = "";

    private static string ColorOrDefault(string color)
    {
        var c = (color ?? string.Empty).Trim();
        if (c.Length == 6 && c.All(Uri.IsHexDigit)) { c = "#" + c; }
        return c.Length == 7 && c[0] == '#' && c.Skip(1).All(Uri.IsHexDigit) ? c.ToLowerInvariant() : "#3498db";
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        var result = await Writes.ReadAsync(ctx.RequestAborted);
        _orders = result.Orders;
        _items = result.Items;
        _orderFinish = _orders.Count(r => r.ForFinish == 1);
        _itemFinish = _items.Count(r => r.ForFinish == 1);
    }
}
