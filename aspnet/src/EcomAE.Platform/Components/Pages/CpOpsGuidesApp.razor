@page "/cp/ops-guides-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Ops guides · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Ops guides
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/ops-guides-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/ops-guides-app" IsAdmin="_isAdmin" />

    <p class="help-block">@_summary.GroupCount.ToString(CultureInfo.InvariantCulture) Groups · @_summary.ItemCount.ToString(CultureInfo.InvariantCulture) Items · @_summary.ShowAnywayCount.ToString(CultureInfo.InvariantCulture) Show anyway · @_summary.UrlItemCount.ToString(CultureInfo.InvariantCulture) With URL.</p>
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead><tr><th>Id</th><th>Group</th><th>Caption</th><th>URL</th><th>Show anyway</th><th></th></tr></thead>
        <tbody>
        @if (_rows.Count==0) { <tr><td colspan="6">No records yet.</td></tr> }
        else { @foreach (var row in _rows) { <tr><td>@row.Id</td><td>@row.ItemsGroup</td><td>@row.Caption</td><td>@row.Url</td><td>@row.ShowAnyway</td><td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td></tr> } }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>
@code {
    private const string _phpTab = "/CP/control/cp-guideline";
    private bool _isAdmin;
    private CpOpsGuidesSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpOpsGuidesRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpOpsGuidesDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Items;
        _source = result.Source;
        _message = result.Message;
    }
}
