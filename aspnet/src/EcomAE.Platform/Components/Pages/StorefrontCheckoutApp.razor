@page "/storefront/checkout-app"
@page "/en/shop/checkout"
@page "/shop/checkout"
@page "/en/shop/checkout/how_get"
@page "/shop/checkout/how_get"
@page "/en/shop/checkout/confirm"
@page "/shop/checkout/confirm"
@page "/en/shop/checkout/login_offer"
@page "/shop/checkout/login_offer"
@page "/en/shop/checkout_confirm"
@page "/shop/checkout_confirm"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IStorefrontGuestSessionService Guests
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Checkout · @_brand</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        
        .epc-sf-co-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-sf-co-cta a {
            display:inline-flex; padding:.5rem .85rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#fff; background:#dc2626;
        }
        .epc-sf-co-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); }
        .epc-sf-co-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-sf-co-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-sf-co-kpi strong { display:block; font-size:1.25rem; font-variant-numeric:tabular-nums; }
        .epc-sf-co-kpi span { color:#64748b; font-size:.78rem; }
        .epc-sf-co-steps { display:grid; gap:.55rem; margin-bottom:1rem; }
        .epc-sf-co-step {
            display:flex; gap:.75rem; align-items:flex-start; background:#fff; border:1px solid #e5e7eb;
            border-radius:.55rem; padding:.85rem .95rem;
        }
        .epc-sf-co-step__n {
            flex:0 0 1.6rem; height:1.6rem; border-radius:999px; background:#14532d; color:#fff;
            display:inline-flex; align-items:center; justify-content:center; font-size:.75rem; font-weight:800;
        }
        .epc-sf-co-step h3 { margin:0 0 .2rem; font-size:.95rem; }
        .epc-sf-co-step p { margin:0; color:#64748b; font-size:.84rem; line-height:1.4; }
        .epc-sf-co-step a { color:#15803d; font-weight:700; text-decoration:none; }
        .epc-sf-co-note { margin-top:1rem; padding:.75rem .9rem; background:#fff8e8; border:1px solid #f1d49a; border-radius:.45rem; color:#7a4e00; font-size:.86rem; }
        .epc-sf-co-gate { padding:1.25rem; background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; }
        .office_box { cursor:pointer; }
        .office_box input { margin-right:.45rem; }
        .office_info.hidden_info { display:none; }
        @@media (max-width:900px){ .epc-sf-co-kpis{grid-template-columns:1fr 1fr;} }
    
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontTenantChrome>

    <PhpStorefrontPageHeader Title="@_heroTitle"
                            Subtitle="@_heroLead">
        <a class="btn btn-sm btn-primary" href="@StorefrontSurfaceLinks.CheckoutHowGet">Delivery options</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.CheckoutConfirm">Confirm order</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Cart">Cart</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Login">Sign in</a>
    </PhpStorefrontPageHeader>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
    }

    @if (_step is "how_get" or "confirm" or "login_offer")
    {
        <div class="epc-sf-co-gate" style="margin-bottom:1rem">
            <p style="margin:0 0 .65rem;color:#334155;font-weight:700">@_stepHeading</p>
            <p style="margin:0 0 .75rem;color:#64748b;font-size:.9rem">@_stepHelp</p>
            @if (_step is "how_get")
            {
                <p class="lead">Choose how you want to receive this order:</p>
                @if (_obtainModes.Count == 0)
                {
                    <div class="alert alert-danger">No delivery / pickup methods are available right now. Please contact support.</div>
                }
                else
                {
                    <form method="post" action="@PhpCustomerWrites.CheckoutHowGetWriteHref" style="margin:0 0 .85rem">
                        @foreach (var mode in _obtainModes)
                        {
                            var radioId = "how_get_radio_" + mode.Code;
                            <div class="radio">
                                <input type="radio"
                                       name="how_get"
                                       value="@mode.Code"
                                       id="@radioId"
                                       class="radio_how_get"
                                       onchange="onHowGetChanged('@mode.Code')" />
                                <label class="label_how_get" for="@radioId">@mode.Label</label>
                            </div>
                        }
                        <div id="how_get_options_div">
                            <p class="lead">Pickup office:</p>
                            <div class="list-group">
                                @if (_offices.Count == 0)
                                {
                                    <div class="office_box list-group-item">No pickup offices are listed for this shop yet.</div>
                                }
                                else
                                {
                                    @foreach (var office in _offices)
                                    {
                                        var officeBoxId = "office_box_" + office.Id.ToString(CultureInfo.InvariantCulture);
                                        var officeInfoId = "office_info_" + office.Id.ToString(CultureInfo.InvariantCulture);
                                        var officeRadioId = "office_radio_" + office.Id.ToString(CultureInfo.InvariantCulture);
                                        <label class="office_box list-group-item" id="@officeBoxId" for="@officeRadioId">
                                            <input type="radio"
                                                   name="office_id"
                                                   value="@office.Id.ToString(CultureInfo.InvariantCulture)"
                                                   id="@officeRadioId" />
                                            <span>@(string.IsNullOrWhiteSpace(office.Caption) ? ("Office #" + office.Id.ToString(CultureInfo.InvariantCulture)) : office.Caption), city: @(string.IsNullOrWhiteSpace(office.City) ? "—" : office.City), @(string.IsNullOrWhiteSpace(office.Address) ? "—" : office.Address)</span>
                                        </label>
                                        <div class="office_info hidden_info" id="@officeInfoId"></div>
                                    }
                                }
                            </div>
                            <label style="display:block;margin:.65rem 0 .25rem">City / area</label>
                            <input type="text" name="city" style="width:100%;max-width:22rem;padding:.45rem" />
                            <p style="margin:.75rem 0 .35rem"><a href="@StorefrontSurfaceLinks.Offices">Pickup points</a></p>
                        </div>
                        <button type="submit" class="btn btn-primary" style="margin-top:.75rem">Save delivery option</button>
                    </form>
                    <script>
                        function onHowGetChanged(mode) {
                            var date = new Date(new Date().getTime() + 15552000 * 1000);
                            document.cookie = "obtain_mode=" + JSON.stringify(mode) + "; path=/; expires=" + date.toUTCString();
                        }
                    </script>
                }
            }
            else if (_step is "login_offer")
            {
                <div class="panel panel-primary">
                    <div class="panel-body">
                        <p style="margin:0 0 .75rem">Sign in to continue checkout with your cart, or continue as a guest.</p>
                        <a class="btn btn-ar btn-primary" href="@StorefrontSurfaceLinks.Login">Log in</a>
                        <a class="btn btn-ar btn-default" href="@StorefrontSurfaceLinks.Registration">Register</a>
                        <a class="btn btn-ar btn-default" href="@StorefrontSurfaceLinks.CheckoutHowGet">Continue as guest</a>
                    </div>
                </div>
            }
            else if (_step is "confirm")
            {
                <p class="lead">Please confirm your order</p>
                <p>Review the cart lines, delivery, and totals, then place the order.</p>
                @if (_lines.Count > 0)
                {
                    <div style="overflow: hidden; overflow-x: auto;">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th style="vertical-align: middle; white-space: nowrap;">Product</th>
                                    <th style="vertical-align: middle; white-space: nowrap; text-align: right;">Term</th>
                                    <th style="vertical-align: middle; white-space: nowrap; text-align: right;">Price</th>
                                    <th style="vertical-align: middle; white-space: nowrap; text-align: center;">Qty</th>
                                    <th style="vertical-align: middle; white-space: nowrap; text-align: right;">Sum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < _lines.Count; i++)
                                {
                                    var line = _lines[i];
                                    var rowClass = _lines.Count == 1
                                        ? "product_div_single"
                                        : i == 0
                                            ? "product_div_first"
                                            : i == _lines.Count - 1
                                                ? "product_div_last"
                                                : "";
                                    var lineSum = line.Price * line.CountNeed;
                                    <tr class="@rowClass">
                                        <td style="vertical-align: middle; width: 100%; min-width: 200px; max-width: 800px; word-wrap: break-word;">
                                            @($"{line.Manufacturer} {line.Article} {line.Name}".Trim())
                                        </td>
                                        <td style="vertical-align: middle; white-space: nowrap; text-align: right;">@FormatTerm(line)</td>
                                        <td style="vertical-align: middle; white-space: nowrap; text-align: right;"><font class="price">@line.Price.ToString("N2", CultureInfo.InvariantCulture)</font></td>
                                        <td style="vertical-align: middle; white-space: nowrap; text-align: center;">@line.CountNeed.ToString("0.##", CultureInfo.InvariantCulture)</td>
                                        <td style="vertical-align: middle; white-space: nowrap; text-align: right;"><b><font class="price">@lineSum.ToString("N2", CultureInfo.InvariantCulture)</font></b></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <form method="post" action="@PhpCustomerWrites.CheckoutConfirmWriteHref" style="margin:0 0 .85rem">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="/storefront/checkout-app?step=confirm" />
                    <p class="lead" style="margin:0 0 .5rem;font-weight:700">How to obtain</p>
                    @foreach (var mode in _obtainModes)
                    {
                        var confirmRadioId = "how_get_radio_" + mode.Code;
                        <div class="radio">
                            <input type="radio" name="howGetMode" value="@mode.Code" id="@confirmRadioId" class="radio_how_get" required />
                            <label class="label_how_get" for="@confirmRadioId">@mode.Label</label>
                        </div>
                    }
                    <p class="lead" style="margin:.75rem 0 .35rem">Pickup office:</p>
                    <div class="list-group">
                        @if (_offices.Count == 0)
                        {
                            <label style="display:block;margin:.65rem 0 .25rem">Pickup office id (mode 1)</label>
                            <input type="number" name="officeId" min="0" style="width:8rem;padding:.4rem" />
                        }
                        else
                        {
                            @foreach (var office in _offices)
                            {
                                var confirmOfficeId = "confirm_office_" + office.Id.ToString(CultureInfo.InvariantCulture);
                                <label class="office_box list-group-item" id="office_box_confirm_@office.Id.ToString(CultureInfo.InvariantCulture)" for="@confirmOfficeId">
                                    <input type="radio"
                                           name="officeId"
                                           value="@office.Id.ToString(CultureInfo.InvariantCulture)"
                                           id="@confirmOfficeId" />
                                    <span>@(string.IsNullOrWhiteSpace(office.Caption) ? ("Office #" + office.Id.ToString(CultureInfo.InvariantCulture)) : office.Caption), city: @(string.IsNullOrWhiteSpace(office.City) ? "—" : office.City), @(string.IsNullOrWhiteSpace(office.Address) ? "—" : office.Address)</span>
                                </label>
                            }
                        }
                    </div>
                    @if (!_isCustomer)
                    {
                        <label style="display:block;margin:.65rem 0 .25rem">Phone</label>
                        <input type="tel" name="phone_not_auth" required style="width:100%;max-width:22rem;padding:.45rem" />
                        <label style="display:block;margin:.65rem 0 .25rem">Email (optional)</label>
                        <input type="email" name="email_not_auth" style="width:100%;max-width:22rem;padding:.45rem" />
                    }
                    <label style="display:block;margin:.65rem 0 .25rem">Purchase order</label>
                    <input type="text" name="buyerPoNumber" maxlength="64" style="width:100%;max-width:22rem;padding:.45rem" />
                    <label style="display:block;margin:.65rem 0 .25rem">Order note</label>
                    <textarea name="orderMessage" rows="3" style="width:100%;margin:.25rem 0 .75rem;padding:.45rem"></textarea>
                    <label style="display:block;margin:0 0 .75rem">
                        <input type="checkbox" name="usersAgreement" value="1" required />
                        I accept the user agreement
                    </label>
                    <button type="submit" style="padding:.5rem .85rem;border:0;border-radius:.4rem;background:#dc2626;color:#fff;font-weight:800;cursor:pointer">Place order</button>
                </form>
            }
            <p style="margin:0">
                <a href="@StorefrontSurfaceLinks.Cart" style="display:inline-flex;padding:.5rem .85rem;border-radius:.4rem;background:#dc2626;color:#fff;font-weight:700;text-decoration:none;margin-right:.35rem">Back to cart</a>
            </p>
        </div>
    }

    @if (!_hasShopper)
    {
        @if (_step is not "login_offer")
        {
            <div class="panel panel-primary epc-cart-login-gate">
                <div class="panel-body">
                    <p style="margin:0 0 .75rem;color:#334155">Sign in to continue checkout with your cart, or continue as a guest.</p>
                    <div class="epc-commerce-login-cta">
                        <a class="btn btn-sm btn-primary" href="@StorefrontSurfaceLinks.Login">Log in</a>
                        <span class="epc-commerce-login-cta__sep">or</span>
                        <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Registration">Register</a>
                        <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.CheckoutLoginOffer">Guest checkout</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="epc-sf-co-kpis" aria-label="Checkout readiness KPIs">
            <div class="epc-sf-co-kpi"><strong>@_summary.Count</strong><span>Cart lines</span></div>
            <div class="epc-sf-co-kpi"><strong>@_summary.Sum.ToString("N2", CultureInfo.InvariantCulture)</strong><span>Cart sum</span></div>
            <div class="epc-sf-co-kpi"><strong>@_checkedCount</strong><span>Checked for order</span></div>
            <div class="epc-sf-co-kpi"><strong>@_readiness</strong><span>Readiness</span></div>
        </div>

        @if (_lines.Count > 0 && _step is not "confirm")
        {
            <table style="width:100%;border-collapse:collapse;font-size:.86rem;margin:0 0 1rem;background:#fff">
                <thead>
                    <tr>
                        <th style="text-align:left;padding:.4rem .5rem">Brand</th>
                        <th style="text-align:left;padding:.4rem .5rem">Article</th>
                        <th style="text-align:left;padding:.4rem .5rem">Name</th>
                        <th style="text-align:left;padding:.4rem .5rem">Qty</th>
                        <th style="text-align:left;padding:.4rem .5rem">Price</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in _lines)
                    {
                        <tr>
                            <td style="padding:.4rem .5rem">@(string.IsNullOrWhiteSpace(line.Manufacturer) ? "—" : line.Manufacturer)</td>
                            <td style="padding:.4rem .5rem">@(string.IsNullOrWhiteSpace(line.Article) ? "—" : line.Article)</td>
                            <td style="padding:.4rem .5rem">@(string.IsNullOrWhiteSpace(line.Name) ? "—" : line.Name)</td>
                            <td style="padding:.4rem .5rem">@line.CountNeed.ToString("0.##", CultureInfo.InvariantCulture)</td>
                            <td style="padding:.4rem .5rem">@line.Price.ToString("N2", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="epc-sf-co-steps" aria-label="Checkout steps">
            <div class="epc-sf-co-step">
                <span class="epc-sf-co-step__n">1</span>
                <div>
                    <h3>Review cart</h3>
                    <p>@_summary.Count line(s), @_checkedCount checked. <a href="@StorefrontSurfaceLinks.Cart">Cart</a></p>
                </div>
            </div>
            <div class="epc-sf-co-step">
                <span class="epc-sf-co-step__n">2</span>
                <div>
                    <h3>How to obtain</h3>
                    <p>Choose delivery or pickup.</p>
                    <p style="margin:.35rem 0 0"><a href="@StorefrontSurfaceLinks.CheckoutHowGet">Select delivery / pickup</a></p>
                </div>
            </div>
            <div class="epc-sf-co-step">
                <span class="epc-sf-co-step__n">3</span>
                <div>
                    <h3>Confirm &amp; pay</h3>
                    <p>Review totals and place the order.</p>
                    <p style="margin:.35rem 0 0">
                        <a href="@StorefrontSurfaceLinks.CheckoutConfirm">Confirm order</a>
                        ·
                        <a href="@StorefrontSurfaceLinks.CheckoutLoginOffer">Guest / login offer</a>
                    </p>
                </div>
            </div>
        </div>
        <p class="epc-sf-co-note">
            Readiness: <strong>@_readiness</strong>. Payment completes on the confirm step.
        </p>
    }

</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private bool _isCustomer;
    private bool _hasShopper;
    private StorefrontCartSummary _summary = new(0, 0m, "n/a", "");
    private IReadOnlyList<StorefrontCartLineDigest> _lines = [];
    private int _checkedCount;
    private string _source = "n/a";
    private string _readiness = "n/a";
    private string _step = "";
    private string _heroTitle = "Checkout readiness";
    private string _heroLead = "Review your cart and continue to delivery and payment.";
    private string _stepHeading = "";
    private string _stepHelp = "";
    private IReadOnlyList<(string Code, string Label)> _obtainModes = PhpCustomerWrites.ObtainModes;
    private IReadOnlyList<CpOfficeDigest> _offices = [];
    private string _flashOk = "";
    private string _flashErr = "";
    protected override async Task OnInitializedAsync()
    {
        ResolveStep();
        var ctx = Http.HttpContext;
        _flashOk = ctx?.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx?.Request.Query["err"].ToString() ?? "";
        if (ctx is null) return;
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);
        await LoadOfficesAndModesAsync(ctx);

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        var shopper = session.Kind == LegacySessionKind.Customer && session.UserId > 0
            ? new StorefrontShopper(session.UserId, 0, session.SessionId ?? "", false)
            : await Guests.ResolveAsync(ctx, createIfMissing: true, ctx.RequestAborted);
        if (!shopper.IsSignedIn)
        {
            Guests.ApplyGuestCookies(ctx.Response, shopper);
        }

        if (!shopper.CanShop)
        {
            _isCustomer = false;
            _hasShopper = false;
            return;
        }

        _isCustomer = shopper.IsSignedIn;
        _hasShopper = true;
        var result = await Dashboards.ListStorefrontCartAsync(shopper.UserId, 100, ctx.RequestAborted, shopper.SessionRecordId);
        _summary = result.Summary;
        _lines = result.Lines;
        _source = result.Source;
        _checkedCount = result.Lines.Count(l => l.CheckedForOrder);
        _readiness = result.Summary.Count > 0
            ? (result.Lines.Any(l => l.CheckedForOrder) ? "ready for delivery" : "cart has lines")
            : "empty cart";
    }

    private async Task LoadOfficesAndModesAsync(HttpContext ctx)
    {
        try
        {
            var offices = await Dashboards.BuildCpOfficesDigestAsync(40, ctx.RequestAborted);
            if (offices.Offices.Count > 0)
            {
                _offices = offices.Offices;
            }
        }
        catch (Exception)
        {
            _offices = [];
        }

        try
        {
            var methods = await Dashboards.BuildCpDeliveryMethodsDigestAsync(20, ctx.RequestAborted);
            if (methods.Modes.Count > 0)
            {
                _obtainModes = methods.Modes
                    .Where(m => m.Available)
                    .OrderBy(m => m.SortOrder)
                    .Select(m => (
                        m.Id.ToString(CultureInfo.InvariantCulture),
                        string.IsNullOrWhiteSpace(m.Caption) ? m.Handler : m.Caption))
                    .ToArray();
            }
        }
        catch (Exception)
        {
            _obtainModes = PhpCustomerWrites.ObtainModes;
        }

        if (_obtainModes.Count == 0)
        {
            _obtainModes = PhpCustomerWrites.ObtainModes;
        }
    }

    private void ResolveStep()
    {
        var path = Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (q.TryGetValue("step", out var stepVal) && !string.IsNullOrWhiteSpace(stepVal))
        {
            _step = stepVal.ToString().Trim().ToLowerInvariant();
        }
        else if (path.EndsWith("/how_get", StringComparison.Ordinal))
        {
            _step = "how_get";
        }
        else if (path.EndsWith("/confirm", StringComparison.Ordinal) || path.EndsWith("/checkout_confirm", StringComparison.Ordinal))
        {
            _step = "confirm";
        }
        else if (path.EndsWith("/login_offer", StringComparison.Ordinal))
        {
            _step = "login_offer";
        }

        (_heroTitle, _heroLead, _stepHeading, _stepHelp) = _step switch
        {
            "how_get" => ("Delivery / pickup", "Choose how you want to receive this order.",
                "How to obtain", "Pick courier delivery or warehouse collection."),
            "confirm" => ("Confirm order", "Review totals and place the order.",
                "Confirm & pay", "Review the cart and confirm the order."),
            "login_offer" => ("Guest checkout", "Continue without an account, or sign in / register.",
                "Login offer", "Sign in, register, or continue as a guest."),
            _ => ("Checkout readiness", "Review your cart and continue to delivery and payment.",
                "", "")
        };
    }

    private static string FormatTerm(StorefrontCartLineDigest line)
    {
        var exe = (line.TimeToExe ?? "").Trim();
        var guaranteed = (line.TimeToExeGuaranteed ?? "").Trim();
        if (string.IsNullOrWhiteSpace(exe) || exe == "0")
        {
            return string.IsNullOrWhiteSpace(guaranteed) || guaranteed == "0" ? "In stock" : guaranteed + " days";
        }

        if (!string.IsNullOrWhiteSpace(guaranteed) && guaranteed != exe)
        {
            return exe + " - " + guaranteed + " days";
        }

        return exe + " days";
    }
}
