@page "/storefront/profile-app"
@page "/en/users/profile"
@page "/users/profile"
@page "/en/users/editform"
@page "/users/editform"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Profile · @_brand</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        
        .epc-sf-pf-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-sf-pf-cta a {
            display:inline-flex; padding:.5rem .85rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f172a; background:#fee2e2;
        }
        .epc-sf-pf-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-sf-pf-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-sf-pf-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-sf-pf-kpi strong { display:block; font-size:1.15rem; font-variant-numeric:tabular-nums; word-break:break-all; }
        .epc-sf-pf-kpi span { color:#64748b; font-size:.78rem; }
        .epc-sf-pf-panel { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; margin-bottom:1rem; }
        .epc-sf-pf-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-sf-pf-table th, .epc-sf-pf-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; }
        .epc-sf-pf-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; width:12rem; }
        .epc-sf-pf-table a { color:#0369a1; font-weight:700; text-decoration:none; }
        .epc-sf-pf-badge { display:inline-flex; padding:.15rem .45rem; border-radius:.3rem; font-size:.72rem; font-weight:700; }
        .epc-sf-pf-badge--ok { background:#e0f2fe; color:#075985; }
        .epc-sf-pf-badge--off { background:#fee2e2; color:#991b1b; }
        .epc-sf-pf-note { margin-top:1rem; padding:.75rem .9rem; background:#f0f9ff; border:1px solid #bae6fd; border-radius:.45rem; color:#0c4a6e; font-size:.86rem; }
        .epc-sf-pf-gate { padding:1.25rem; background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; }
        @@media (max-width:900px){ .epc-sf-pf-kpis{grid-template-columns:1fr;} .epc-sf-pf-table th{width:auto;} }
    
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontTenantChrome>

    <PhpStorefrontPageHeader Title="Profile"
                            Subtitle="Browse parts, manage your garage, and track recent orders.">
        <a class="btn btn-sm btn-primary" href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpProfile)">Open module</a>
            <a class="btn btn-sm btn-default" href="/storefront/garage-app">Garage</a>
            <a class="btn btn-sm btn-default" href="/storefront/orders-app">My orders</a>
            <a class="btn btn-sm btn-default" href="/storefront/login">Customer login</a>
    </PhpStorefrontPageHeader>

    @if (!_isCustomer)
    {
        <div class="panel panel-primary epc-sf-pf-gate">
            <div class="panel-body">
                <p style="margin:0 0 .75rem;color:#334155">Sign in with your store account to load your profile.</p>
                <a class="btn btn-ar btn-primary" href="@StorefrontSurfaceLinks.Login">Sign in</a>
                <a class="btn btn-ar btn-default" href="@StorefrontSurfaceLinks.Registration">Register</a>
            </div>
        </div>
    }
    else
    {
        <div id="phone_code_store" style="display:none;" class="hidden">
            <form method="get" action="@StorefrontAspNetCanonical.ConfirmContact">
                <input type="hidden" name="u_id" value="@_userId.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="type" value="phone" />
                <div class="input-group">
                    <input value="" type="text" class="form-control" placeholder="Confirmation code" name="code" id="code" />
                    <span class="input-group-btn">
                        <button class="btn btn-ar btn-primary" type="submit">Confirm</button>
                    </span>
                </div>
            </form>
        </div>

        <table class="table">
            <tr>
                <td><b>E-mail</b></td>
                <td id="email_work">@(string.IsNullOrWhiteSpace(_email) ? "—" : _email)
                    <span class="label @(_emailConfirmed != 0 ? "label-success" : "label-danger")">@(_emailConfirmed != 0 ? "confirmed" : "not confirmed")</span>
                </td>
            </tr>
            <tr>
                <td><b>Phone</b></td>
                <td id="phone_work">@(string.IsNullOrWhiteSpace(_phone) ? "—" : _phone)
                    <span class="label @(_phoneConfirmed != 0 ? "label-success" : "label-danger")">@(_phoneConfirmed != 0 ? "confirmed" : "not confirmed")</span>
                </td>
            </tr>
            <tr>
                <td><b>User ID</b></td>
                <td>@_userId.ToString(CultureInfo.InvariantCulture)</td>
            </tr>
            <tr>
                <td><b>Reg variant</b></td>
                <td>@_regVariant.ToString(CultureInfo.InvariantCulture)</td>
            </tr>
            @foreach (var kv in _fields.OrderBy(x => x.Key, StringComparer.OrdinalIgnoreCase))
            {
                <tr>
                    <td><b>@kv.Key</b></td>
                    <td>@(string.IsNullOrWhiteSpace(kv.Value) ? "—" : kv.Value)</td>
                </tr>
            }
        </table>

        @if (!string.IsNullOrWhiteSpace(_flashOk))
        {
            <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
        }
        @if (!string.IsNullOrWhiteSpace(_flashErr))
        {
            <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
        }

        <form method="post" action="@PhpCustomerWrites.ProfileWriteHref" id="regform">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/storefront/profile-app" />
            <input type="hidden" name="edit_user" value="edit_user" />
            <div id="additional_fields_div">
                <div class="panel panel-primary">
                    <div class="panel-body">
                        <label>First name</label>
                        <input type="text" class="form-control" name="name" value="@Field("name")" maxlength="80" />
                        <label>Last name</label>
                        <input type="text" class="form-control" name="surname" value="@Field("surname")" maxlength="80" />
                        <label>Company / trade name</label>
                        <input type="text" class="form-control" name="company_name" value="@Field("company_name")" maxlength="160" />
                        <label>City</label>
                        <input type="text" class="form-control" name="epc_reg_city" value="@Field("epc_reg_city")" maxlength="80" />
                        <label>Address</label>
                        <input type="text" class="form-control" name="epc_reg_address" value="@Field("epc_reg_address")" maxlength="255" />
                        <button type="submit" class="btn btn-ar btn-primary">Save profile</button>
                    </div>
                </div>
            </div>
        </form>
        <form method="post" action="@PhpCustomerWrites.ProfilePasswordHref">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/storefront/profile-app" />
            <div class="panel panel-primary">
                <div class="panel-body">
                    <div class="form-group col-md-6">
                        <label for="password" class="control-label">New password</label>
                        <input type="password" name="password" class="form-control" id="password" required autocomplete="new-password" />
                    </div>
                    <div class="form-group col-md-6">
                        <label for="password_repeat" class="control-label">Repeat password</label>
                        <input type="password" class="form-control" name="password_repeat" id="password_repeat" autocomplete="new-password" />
                    </div>
                    <button type="submit" class="btn btn-ar btn-primary">Update password</button>
                </div>
            </div>
        </form>
        <p class="epc-sf-pf-note">
            Email and phone confirmation stay on the classic account form.
            <a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref("/en/users/editform")">Classic contacts</a>
        </p>
    }

</StorefrontTenantChrome>

@code {
    private const string _phpProfile = "https://epartscart.com/users/profile";
    private string _brand = "eParts Cart";
    private bool _isCustomer;
    private int _userId;
    private string _email = "";
    private int _emailConfirmed;
    private string _phone = "";
    private int _phoneConfirmed;
    private int _regVariant;
    private IReadOnlyDictionary<string, string> _fields = new Dictionary<string, string>();
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    private string Field(string key)
        => _fields.TryGetValue(key, out var value) ? value : "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Customer || session.UserId <= 0)
        {
            _isCustomer = false;
            return;
        }

        _isCustomer = true;
        var result = await Dashboards.BuildStorefrontProfileAsync(session.UserId, ctx.RequestAborted);
        _userId = result.UserId;
        _email = result.Email;
        _emailConfirmed = result.EmailConfirmed;
        _phone = result.Phone;
        _phoneConfirmed = result.PhoneConfirmed;
        _regVariant = result.RegVariant;
        _fields = result.ProfileFields;
        _source = result.Source;
        _message = result.Message;
    }
}
