@page "/erp/inventory-report-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Inventory report · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Inventory report" BreadcrumbArea="Inventory" BreadcrumbTab="Inventory report">
    <PhpErpModulePageHeader Title="Inventory report" Subtitle="Category hierarchy and valuation snapshots." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Inventory report KPIs">
        <div class="kpi"><div class="lbl">Categories</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Snapshots</div><div class="val">@_snapCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Snapshot value</div><div class="val">@_totalValue.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    <h2 style="font-size:16px;">Categories</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Code</th><th>Name</th><th class="text-right">Level</th><th>Parent</th><th>Status</th></tr></thead>
            <tbody>
                @if (_categories.Count == 0)
                {
                    <tr><td colspan="5">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No inventory categories yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _categories)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(row.Code) ? "—" : row.Code)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Name) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Name)</strong></td>
                            <td class="text-right">@row.Level.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(row.ParentId > 0 ? row.ParentId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><span class="label label-default">@(row.IsActive ? "active" : "inactive")</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="font-size:16px;">Snapshots</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Date</th><th>Category</th><th class="text-right">SKUs</th><th class="text-right">Qty</th><th class="text-right">Value</th><th class="text-right">Avg age</th></tr></thead>
            <tbody>
                @if (_snapshots.Count == 0) { <tr><td colspan="6">No snapshots yet.</td></tr> }
                else
                {
                    @foreach (var row in _snapshots)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(row.SnapshotDate) ? "—" : row.SnapshotDate)</td>
                            <td>@(row.CategoryId > 0 ? row.CategoryId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td class="text-right">@row.TotalSkus.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.TotalQty.ToString("N3", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.TotalValue.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.AvgAgeDays.ToString("N1", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=inventory&tab=inventory_report";
    private bool _isAdmin;
    private IReadOnlyList<ErpInventoryReportCategoryDigest> _categories = [];
    private IReadOnlyList<ErpInventoryReportSnapshotDigest> _snapshots = [];
    private int _count, _snapCount;
    private decimal _totalValue;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpInventoryReportDigestAsync(200, ctx.RequestAborted);
        _categories = result.Categories;
        _snapshots = result.Snapshots;
        _count = result.Count;
        _snapCount = result.SnapshotCount;
        _totalValue = result.TotalValue;
        _source = result.Source;
        _message = result.Message;
    }
}
