@page "/erp/inventory-report-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Inventory report · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Inventory report" BreadcrumbArea="Inventory" BreadcrumbTab="Inventory report">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/inventory-report-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Inventory report" Subtitle="Open a category or snapshot for company id. Snapshot generate stays Classic." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Inventory report KPIs">
        <div class="kpi"><div class="lbl">Categories</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Snapshots</div><div class="val">@_snapCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Snapshot value</div><div class="val">@_totalValue.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedCategory is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCategoryCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedCategoryReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Category id</dt><dd>@_openedCategory.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Code</dt><dd>@(string.IsNullOrWhiteSpace(_openedCategory.Code) ? "—" : _openedCategory.Code)</dd>
                <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_openedCategory.Name) ? "—" : _openedCategory.Name)</dd>
                <dt>Level</dt><dd>@_openedCategory.Level.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Parent</dt><dd>@(_openedCategory.ParentId > 0 ? _openedCategory.ParentId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Sort</dt><dd>@_openedCategory.SortOrder.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Company</dt><dd>@(_openedCategory.CompanyId > 0 ? _openedCategory.CompanyId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Status</dt><dd>@(_openedCategory.IsActive ? "active" : "inactive")</dd>
                <dt>Created</dt><dd>@FormatTime(_openedCategory.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Snapshot generate stays Classic.</p>
            @if (_openedCategorySiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-level siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Code</th><th>Name</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedCategorySiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Code) ? "—" : sib.Code)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Name) ? "—" : sib.Name)</td>
                                <td>@(sib.IsActive ? "active" : "inactive")</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "invrep_cat_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-level siblings yet.</p>
            }
        </div>
    }

    @if (_openedSnapshot is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedSnapshotCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedSnapshotReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Snapshot id</dt><dd>@_openedSnapshot.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Date</dt><dd>@(string.IsNullOrWhiteSpace(_openedSnapshot.SnapshotDate) ? "—" : _openedSnapshot.SnapshotDate)</dd>
                <dt>Category</dt><dd>@(_openedSnapshot.CategoryId > 0 ? _openedSnapshot.CategoryId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>SKUs</dt><dd>@_openedSnapshot.TotalSkus.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Qty</dt><dd>@_openedSnapshot.TotalQty.ToString("N3", CultureInfo.InvariantCulture)</dd>
                <dt>Value</dt><dd>@_openedSnapshot.TotalValue.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Avg age</dt><dd>@_openedSnapshot.AvgAgeDays.ToString("N1", CultureInfo.InvariantCulture)</dd>
                <dt>Company</dt><dd>@(_openedSnapshot.CompanyId > 0 ? _openedSnapshot.CompanyId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Created</dt><dd>@FormatTime(_openedSnapshot.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Snapshot generate stays Classic.</p>
            @if (_openedSnapshotSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-category siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Date</th><th>Value</th><th>Avg age</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedSnapshotSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.SnapshotDate) ? "—" : sib.SnapshotDate)</td>
                                <td>@sib.TotalValue.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@sib.AvgAgeDays.ToString("N1", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "invrep_snap_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-category siblings yet.</p>
            }
        </div>
    }

    <h2 style="font-size:16px;">Categories</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Code</th><th>Name</th><th class="text-right">Level</th><th>Parent</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @if (_categories.Count == 0)
                {
                    <tr><td colspan="6">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No inventory categories yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _categories)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedCategoryId)">
                            <td>@(string.IsNullOrWhiteSpace(row.Code) ? "—" : row.Code)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Name) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Name)</strong></td>
                            <td class="text-right">@row.Level.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(row.ParentId > 0 ? row.ParentId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><span class="label label-default">@(row.IsActive ? "active" : "inactive")</span></td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "invrep_cat_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="font-size:16px;">Snapshots</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Date</th><th>Category</th><th class="text-right">SKUs</th><th class="text-right">Qty</th><th class="text-right">Value</th><th class="text-right">Avg age</th><th></th></tr></thead>
            <tbody>
                @if (_snapshots.Count == 0) { <tr><td colspan="7">No snapshots yet.</td></tr> }
                else
                {
                    @foreach (var row in _snapshots)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedSnapshotId)">
                            <td>@(string.IsNullOrWhiteSpace(row.SnapshotDate) ? "—" : row.SnapshotDate)</td>
                            <td>@(row.CategoryId > 0 ? row.CategoryId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td class="text-right">@row.TotalSkus.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.TotalQty.ToString("N3", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.TotalValue.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.AvgAgeDays.ToString("N1", CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "invrep_snap_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Snapshot generate stays Classic.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=inventory&tab=inventory_report";
    private const string _listHref = "/erp/inventory-report-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpInventoryReportCategoryDigest> _categories = [];
    private IReadOnlyList<ErpInventoryReportSnapshotDigest> _snapshots = [];
    private int _count, _snapCount;
    private decimal _totalValue;
    private string _source = "n/a";
    private string _message = "";
    private long _openedCategoryId;
    private long _openedSnapshotId;
    private ErpInventoryReportCategoryDetail? _openedCategory;
    private ErpInventoryReportSnapshotDetail? _openedSnapshot;
    private IReadOnlyList<ErpInventoryReportCategoryDigest> _openedCategorySiblings = [];
    private IReadOnlyList<ErpInventoryReportSnapshotDigest> _openedSnapshotSiblings = [];

    private long _openedId => _openedCategoryId > 0 ? _openedCategoryId : _openedSnapshotId;

    private bool OpenedFound => _openedCategory is not null || _openedSnapshot is not null;

    private string OpenedCategoryReturnHref => _openedCategoryId > 0
        ? _listHref + "?invrep_cat_id=" + _openedCategoryId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedSnapshotReturnHref => _openedSnapshotId > 0
        ? _listHref + "?invrep_snap_id=" + _openedSnapshotId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedCategoryCaption => _openedCategory is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedCategory.Name)
            ? ("Category #" + _openedCategory.Id.ToString(CultureInfo.InvariantCulture))
            : _openedCategory.Name)
            + (string.IsNullOrWhiteSpace(_openedCategory.Code) ? "" : (" · " + _openedCategory.Code));

    private string OpenedSnapshotCaption => _openedSnapshot is null
        ? ""
        : ("Snapshot #" + _openedSnapshot.Id.ToString(CultureInfo.InvariantCulture)
            + (string.IsNullOrWhiteSpace(_openedSnapshot.SnapshotDate) ? "" : (" · " + _openedSnapshot.SnapshotDate)));

    private string OpenedCaption => _openedCategory is not null ? OpenedCategoryCaption : OpenedSnapshotCaption;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _openedCategoryId = ErpRecordOpen.ReadId(ctx.Request, "invrep_cat_id");
        _openedSnapshotId = ErpRecordOpen.ReadId(ctx.Request, "invrep_snap_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpInventoryReportDigestAsync(200, ctx.RequestAborted);
        _categories = result.Categories;
        _snapshots = result.Snapshots;
        _count = result.Count;
        _snapCount = result.SnapshotCount;
        _totalValue = result.TotalValue;
        _source = result.Source;
        _message = result.Message;

        if (_openedCategoryId > 0)
        {
            var detail = await Dashboards.BuildErpInventoryReportCategoryDetailAsync(_openedCategoryId, ctx.RequestAborted);
            _openedCategory = detail.Category;
            _openedCategorySiblings = detail.Siblings;
            if (_openedCategory is not null)
            {
                var openedList = _categories.FirstOrDefault(c => c.Id == _openedCategoryId);
                if (openedList is not null)
                {
                    _categories = new[] { openedList }.Concat(_categories.Where(c => c.Id != _openedCategoryId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }

        if (_openedSnapshotId > 0)
        {
            var detail = await Dashboards.BuildErpInventoryReportSnapshotDetailAsync(_openedSnapshotId, ctx.RequestAborted);
            _openedSnapshot = detail.Snapshot;
            _openedSnapshotSiblings = detail.Siblings;
            if (_openedSnapshot is not null)
            {
                var openedList = _snapshots.FirstOrDefault(s => s.Id == _openedSnapshotId);
                if (openedList is not null)
                {
                    _snapshots = new[] { openedList }.Concat(_snapshots.Where(s => s.Id != _openedSnapshotId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message) && _openedCategory is null)
            {
                _message = detail.Message;
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
