@page "/marketing/intellectual-property"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>ECOM AE — Intellectual property</PageTitle>
<PhpChromeStyles Surface="marketing" />

<PhpEcomaeMarketingChrome ActiveKey="intellectual_property">
    <PhpHybridWorkspaceFrame PhpHref="@_phpHref" ClearHref="/marketing/intellectual-property" />

    @if (string.IsNullOrWhiteSpace(_phpHref))
    {
        <PhpEcomaeLegalAliasOverview
            Title="Intellectual property"
            Badge="IP"
            Icon="fa-lightbulb-o"
            GradientStart="#713f12"
            GradientMid="#ca8a04"
            PhpSlug="intellectual-property"
            AspNetRoute="/marketing/intellectual-property"
            Lead="Intellectual property terms for the ECOM AE stack. Full policy text is available from the linked policy page."
            CardOne="IP ownership, licenses, and restrictions." />
    }
</PhpEcomaeMarketingChrome>

@code {
    private string? _phpHref;

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        if (ctx?.Request.Query.TryGetValue("php", out var php) == true && !string.IsNullOrWhiteSpace(php))
        {
            _phpHref = php.ToString();
        }
    }
}
