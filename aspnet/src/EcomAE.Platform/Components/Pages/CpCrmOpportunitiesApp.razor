@page "/cp/crm-opportunities-app"
@page "/erp/crm-opportunities-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>CRM opportunities · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                CRM opportunities
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Pipeline rows from tenant CRM tables. Stage edits stay on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/crm-opportunities-app" IsAdmin="_isAdmin" />

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Opportunities</div>
            <div class="panel-body">
                <p class="help-block">@_summary.OpportunityCount.ToString(CultureInfo.InvariantCulture) opportunities · @_summary.OpenOpportunities.ToString(CultureInfo.InvariantCulture) open · @_summary.WonOpportunities.ToString(CultureInfo.InvariantCulture) won · @_summary.PipelineAmount.ToString("0.00", CultureInfo.InvariantCulture) pipeline.</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Title</th>
                                <th>Stage</th>
                                <th>Amount</th>
                                <th>Prob %</th>
                                <th>Owner</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_opportunities.Count == 0)
                        {
                            <tr><td colspan="7">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _opportunities)
                            {
                                <tr>
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Stage) ? row.Stage : "—")</td>
                                    <td>@row.Amount.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                    <td>@row.Probability.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.OwnerUserId.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(row.Active ? "yes" : "no")</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=sales&tab=opportunities&epc_erp_shell=1";
    private bool _isAdmin;
    private CpCrmOpportunitiesSummary _summary = new(0, 0, 0, 0m, "n/a", "");
    private IReadOnlyList<CpCrmOpportunityDigest> _opportunities = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpCrmOpportunitiesDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _opportunities = result.Opportunities;
        _source = result.Source;
        _message = result.Message;
    }
}
