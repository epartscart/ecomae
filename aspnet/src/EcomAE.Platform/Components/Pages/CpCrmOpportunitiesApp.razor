@page "/cp/crm-opportunities-app"
@page "/erp/crm-opportunities-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>CRM opportunities · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                CRM opportunities
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Save an opportunity here. Set a pipeline stage here. Convert and quote email stay Classic. This page does not invent a send.</p>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div>
    }
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/crm-opportunities-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedDetail is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="CRM opportunity KPIs">
        <div class="kpi"><div class="lbl">Opportunities</div><div class="val">@_summary.OpportunityCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open</div><div class="val">@_summary.OpenOpportunities.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Won</div><div class="val">@_summary.WonOpportunities.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Pipeline</div><div class="val">@_summary.PipelineAmount.ToString("0.00", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedDetail is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedDetail.Title) ? _openedDetail.Title : ("Opp #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedDetail.Stage) ? _openedDetail.Stage : "—")</span>
                </div>
                <div class="panel-body">
                    <p>Amount @_openedDetail.Amount.ToString("0.00", CultureInfo.InvariantCulture)
                        · Prob @_openedDetail.Probability.ToString(CultureInfo.InvariantCulture)%
                        · Lead @_openedDetail.LeadId.ToString(CultureInfo.InvariantCulture)</p>
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.Notes))
                    {
                        <p class="text-muted">@_openedDetail.Notes</p>
                    }
                    else
                    {
                        <p class="text-muted">No notes yet.</p>
                    }
                    @if (_isAdmin)
                    {
                        <form method="post" action="/cp/crm/opportunities/write" style="margin:1rem 0 0;display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@ErpRecordOpen.Href(_listHref, "opp_id", _openedDetail.Id)" />
                            <input type="hidden" name="action" value="save_opportunity" />
                            <input type="hidden" name="id" value="@_openedDetail.Id.ToString(CultureInfo.InvariantCulture)" />
                            <label>Title <input type="text" name="title" maxlength="255" value="@_openedDetail.Title" /></label>
                            <label>Lead <input type="text" name="lead_id" inputmode="numeric" value="@_openedDetail.LeadId.ToString(CultureInfo.InvariantCulture)" /></label>
                            <label>Stage
                                <select name="stage">
                                    @foreach (var st in _stages)
                                    {
                                        @if (string.Equals(st, _openedDetail.Stage, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@st" selected>@st</option>
                                        }
                                        else
                                        {
                                            <option value="@st">@st</option>
                                        }
                                    }
                                </select>
                            </label>
                            <label>Amount <input type="text" name="amount" inputmode="decimal" value="@_openedDetail.Amount.ToString(CultureInfo.InvariantCulture)" /></label>
                            <label>Prob % <input type="text" name="probability" inputmode="numeric" value="@_openedDetail.Probability.ToString(CultureInfo.InvariantCulture)" /></label>
                            <label>Close <input type="text" name="close_date" value="@_openedDetail.CloseDate.ToString(CultureInfo.InvariantCulture)" /></label>
                            <label>Notes <input type="text" name="notes" value="@_openedDetail.Notes" /></label>
                            <button type="submit" class="btn btn-primary btn-sm">Save opportunity</button>
                        </form>
                        <form method="post" action="/cp/crm/opportunities/write" style="margin:.75rem 0 0;display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@ErpRecordOpen.Href(_listHref, "opp_id", _openedDetail.Id)" />
                            <input type="hidden" name="action" value="update_stage" />
                            <input type="hidden" name="id" value="@_openedDetail.Id.ToString(CultureInfo.InvariantCulture)" />
                            <label>Stage
                                <select name="stage">
                                    @foreach (var st in _stages)
                                    {
                                        @if (string.Equals(st, _openedDetail.Stage, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@st" selected>@st</option>
                                        }
                                        else
                                        {
                                            <option value="@st">@st</option>
                                        }
                                    }
                                </select>
                            </label>
                            <button type="submit" class="btn btn-primary btn-sm">Set stage</button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Activities</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Due</th>
                                    <th>Done</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedActivities.Count == 0)
                                {
                                    <tr><td colspan="4">No activities yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var act in _openedActivities)
                                    {
                                        <tr>
                                            <td>@(!string.IsNullOrWhiteSpace(act.ActivityType) ? act.ActivityType : "—")</td>
                                            <td>@act.DueDate.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(act.Done ? "yes" : "no")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(act.Notes) ? act.Notes : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_isAdmin)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">New opportunity</div>
                <div class="panel-body">
                    <form method="post" action="/cp/crm/opportunities/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@_listHref" />
                        <input type="hidden" name="action" value="save_opportunity" />
                        <input type="hidden" name="id" value="0" />
                        <label>Title <input type="text" name="title" maxlength="255" /></label>
                        <label>Lead <input type="text" name="lead_id" inputmode="numeric" value="0" /></label>
                        <label>Stage
                            <select name="stage">
                                <option value="prospect" selected>prospect</option>
                                <option value="qualified">qualified</option>
                                <option value="proposal">proposal</option>
                                <option value="negotiation">negotiation</option>
                                <option value="won">won</option>
                                <option value="lost">lost</option>
                            </select>
                        </label>
                        <label>Amount <input type="text" name="amount" inputmode="decimal" value="0" /></label>
                        <label>Prob % <input type="text" name="probability" inputmode="numeric" value="10" /></label>
                        <label>Close <input type="text" name="close_date" value="0" /></label>
                        <label>Notes <input type="text" name="notes" /></label>
                        <button type="submit" class="btn btn-primary btn-sm">Create opportunity</button>
                    </form>
                    <p class="help-block" style="margin:.75rem 0 0">Convert and quote email stay Classic.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">New CRM project</div>
                <div class="panel-body">
                    <form method="post" action="/cp/crm/projects/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@(_openedId > 0 ? ErpRecordOpen.Href(_listHref, "opp_id", _openedId) : _listHref)" />
                        <input type="hidden" name="action" value="save_project" />
                        <input type="hidden" name="id" value="0" />
                        <label>Name <input type="text" name="name" maxlength="255" /></label>
                        <label>Opp <input type="text" name="opportunity_id" inputmode="numeric" value="@(_openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "0")" /></label>
                        <label>Order <input type="text" name="order_id" inputmode="numeric" value="0" /></label>
                        <label>Status
                            <select name="status">
                                <option value="planned" selected>planned</option>
                                <option value="active">active</option>
                                <option value="on_hold">on_hold</option>
                                <option value="done">done</option>
                                <option value="cancelled">cancelled</option>
                            </select>
                        </label>
                        <label>Progress % <input type="text" name="progress_pct" inputmode="numeric" value="0" /></label>
                        <label>Start <input type="text" name="start_date" /></label>
                        <label>End <input type="text" name="end_date" /></label>
                        <label>Notes <input type="text" name="notes" /></label>
                        <button type="submit" class="btn btn-primary btn-sm">Create project</button>
                    </form>
                    <p class="help-block" style="margin:.75rem 0 0">Quote email stays Classic.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">New project task</div>
                <div class="panel-body">
                    <form method="post" action="/cp/crm/projects/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@(_openedId > 0 ? ErpRecordOpen.Href(_listHref, "opp_id", _openedId) : _listHref)" />
                        <input type="hidden" name="action" value="save_project_task" />
                        <label>Project <input type="text" name="project_id" inputmode="numeric" value="0" /></label>
                        <label>Title <input type="text" name="title" maxlength="255" /></label>
                        <label>Status
                            <select name="status">
                                <option value="todo" selected>todo</option>
                                <option value="doing">doing</option>
                                <option value="done">done</option>
                            </select>
                        </label>
                        <label>Progress % <input type="text" name="progress_pct" inputmode="numeric" value="0" /></label>
                        <label>Hours <input type="text" name="hours_est" inputmode="decimal" value="0" /></label>
                        <label>Due <input type="text" name="due_date" /></label>
                        <button type="submit" class="btn btn-primary btn-sm">Add task</button>
                    </form>
                    <p class="help-block" style="margin:.75rem 0 0">Quote email stays Classic.</p>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Opportunities</div>
            <div class="panel-body">
                <p class="help-block">@_summary.OpportunityCount.ToString(CultureInfo.InvariantCulture) opportunities · @_summary.OpenOpportunities.ToString(CultureInfo.InvariantCulture) open · @_summary.WonOpportunities.ToString(CultureInfo.InvariantCulture) won · @_summary.PipelineAmount.ToString("0.00", CultureInfo.InvariantCulture) pipeline.</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Title</th>
                                <th>Stage</th>
                                <th>Amount</th>
                                <th>Prob %</th>
                                <th>Owner</th>
                                <th>Active</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_opportunities.Count == 0)
                        {
                            <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _opportunities)
                            {
                                <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Stage) ? row.Stage : "—")</td>
                                    <td>@row.Amount.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                    <td>@row.Probability.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.OwnerUserId.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(row.Active ? "yes" : "no")</td>
                                    <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "opp_id", row.Id)">Open</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=sales&tab=opportunities&epc_erp_shell=1";
    private bool _isAdmin;
    private CpCrmOpportunitiesSummary _summary = new(0, 0, 0, 0m, "n/a", "");
    private IReadOnlyList<CpCrmOpportunityDigest> _opportunities = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private static readonly string[] _stages = ["prospect", "qualified", "proposal", "negotiation", "won", "lost"];
    private long _openedId;
    private CpCrmOpportunityDetail? _openedDetail;
    private IReadOnlyList<CpCrmOpportunityActivityDigest> _openedActivities = [];
    private string _listHref = "/cp/crm-opportunities-app";

    private string OpenedCaption => _openedDetail is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedDetail.Title) ? ("Opp #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.Title)
            + " · " + (string.IsNullOrWhiteSpace(_openedDetail.Stage) ? "prospect" : _openedDetail.Stage);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var path = ctx.Request.Path.Value;
        _listHref = string.Equals(path, "/erp/crm-opportunities-app", StringComparison.OrdinalIgnoreCase)
            ? "/erp/crm-opportunities-app"
            : "/cp/crm-opportunities-app";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "opp_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpCrmOpportunitiesDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _opportunities = result.Opportunities;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpCrmOpportunityDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Opportunity;
            _openedActivities = detail.Activities;
            if (_openedDetail is not null)
            {
                var openedList = _opportunities.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _opportunities = new[] { openedList }.Concat(_opportunities.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
