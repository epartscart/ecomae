@page "/erp/quality-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Quality · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Quality" BreadcrumbArea="Operations" BreadcrumbTab="Quality">
    <PhpErpModulePageHeader Title="Quality management" Subtitle="Update a non-conformance here. Plan save, inspection create, and NCR create stay on the classic twin." />
    <PhpErpD365ActionPane RefreshHref="@Nav.Uri" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/ajax/qm-ncr-update" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/quality-app" />
            <label>NCR id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <label>Status
                <select name="status">
                    <option value="open">open</option>
                    <option value="investigate">investigate</option>
                    <option value="action">action</option>
                    <option value="closed">closed</option>
                </select>
            </label>
            <label>Disposition
                <select name="disposition">
                    <option value="">—</option>
                    <option value="use_as_is">use_as_is</option>
                    <option value="rework">rework</option>
                    <option value="scrap">scrap</option>
                    <option value="return">return</option>
                </select>
            </label>
            <label>Corrective action <input type="text" name="corrective_action" /></label>
            <button type="submit">Update NCR</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Quality KPIs">
        <div class="kpi"><div class="lbl">Plans</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open orders</div><div class="val">@_openOrders.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open NCRs</div><div class="val">@_openNcrs.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <h2 style="font-size:16px;">Plans</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Code</th><th>Name</th><th class="text-right">Tests</th><th>Status</th></tr></thead>
            <tbody>
                @if (_plans.Count == 0)
                {
                    <tr><td colspan="4">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No quality plans yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _plans)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(row.Code) ? "—" : row.Code)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Name) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Name)</strong></td>
                            <td class="text-right">@row.TestCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td><span class="label label-default">@(row.Active ? "active" : "inactive")</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="font-size:16px;">Orders</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Ref</th><th>Item</th><th class="text-right">Qty</th><th>Status</th><th>Verdict</th></tr></thead>
            <tbody>
                @if (_orders.Count == 0) { <tr><td colspan="5">No inspection orders yet.</td></tr> }
                else
                {
                    @foreach (var row in _orders)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(row.RefId) ? row.RefType : $"{row.RefType} {row.RefId}")</td>
                            <td>@(row.ItemId > 0 ? row.ItemId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td class="text-right">@row.Qty.ToString("N3", CultureInfo.InvariantCulture)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Verdict) ? "—" : row.Verdict)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="font-size:16px;">NCRs</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Title</th><th>Severity</th><th>Disposition</th><th>Status</th></tr></thead>
            <tbody>
                @if (_ncrs.Count == 0) { <tr><td colspan="4">No NCRs yet.</td></tr> }
                else
                {
                    @foreach (var row in _ncrs)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Title) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Title)</strong></td>
                            <td>@row.Severity</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Disposition) ? "—" : row.Disposition)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. NCR update is ASP.NET-live. Plan save, inspection create, and NCR create stay PHP.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private IReadOnlyList<ErpQmPlanDigest> _plans = [];
    private IReadOnlyList<ErpQmOrderDigest> _orders = [];
    private IReadOnlyList<ErpQmNcrDigest> _ncrs = [];
    private int _count, _openOrders, _openNcrs;
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpQualityDigestAsync(200, ctx.RequestAborted);
        _plans = result.Plans;
        _orders = result.Orders;
        _ncrs = result.Ncrs;
        _count = result.Count;
        _openOrders = result.OpenOrderCount;
        _openNcrs = result.OpenNcrCount;
        _source = result.Source;
        _message = result.Message;
    }
}
