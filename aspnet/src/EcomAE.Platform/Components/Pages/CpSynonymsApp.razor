@page "/cp/synonyms-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Brand synonyms · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Brand synonyms
                <a class="btn btn-xs btn-default pull-right" href="/cp/module-ajax/writes/catalog" style="margin-right:.4rem">Write catalog</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/synonyms-app")</p>
                <p>Open a manufacturer to see synonym ids the dump hides. Manufacturer and synonym add/save/delete write here when confirmWrites is set.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/synonyms-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedManufacturer is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Brand synonym KPIs">
        <div class="kpi"><div class="lbl">Manufacturers</div><div class="val">@_manufacturerCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Synonyms</div><div class="val">@_synonymCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Orphans</div><div class="val">@_orphanCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Mapped</div><div class="val">@_mappedCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <div style="display:grid;gap:.65rem;margin:0 0 1rem">
            <form method="post" action="/cp/synonyms/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@_listHref" />
                <input type="hidden" name="action" value="add_manufacturer" />
                <label>Manufacturer name <input type="text" name="name" required maxlength="255" /></label>
                <button type="submit">Add manufacturer</button>
            </form>
            <form method="post" action="/cp/synonyms/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@_returnHref" />
                <input type="hidden" name="action" value="save_manufacturer" />
                <label>Manufacturer id <input type="number" name="id" min="1" required value="@OpenedIdValue" /></label>
                <label>Name <input type="text" name="name" required maxlength="255" value="@OpenedNameValue" /></label>
                <button type="submit">Save manufacturer</button>
            </form>
            <form method="post" action="/cp/synonyms/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@_returnHref" />
                <input type="hidden" name="action" value="del_manufacturer" />
                <label>Manufacturer id <input type="number" name="id" min="1" required value="@OpenedIdValue" /></label>
                <button type="submit">Delete manufacturer</button>
            </form>
            <form method="post" action="/cp/synonyms/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@_returnHref" />
                <input type="hidden" name="action" value="add_synonym" />
                <label>Manufacturer id <input type="number" name="manufacturerId" min="1" required value="@OpenedIdValue" /></label>
                <label>Synonym <input type="text" name="name" required maxlength="255" /></label>
                <button type="submit">Add synonym</button>
            </form>
            <form method="post" action="/cp/synonyms/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@_returnHref" />
                <input type="hidden" name="action" value="save_synonym" />
                <label>Synonym id <input type="number" name="id" min="1" required /></label>
                <label>Synonym <input type="text" name="name" required maxlength="255" /></label>
                <button type="submit">Save synonym</button>
            </form>
            <form method="post" action="/cp/synonyms/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@_returnHref" />
                <input type="hidden" name="action" value="del_synonym" />
                <label>Synonym id <input type="number" name="id" min="1" required /></label>
                <button type="submit">Delete synonym</button>
            </form>
        </div>
    }

    @if (_openedManufacturer is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedManufacturer.Name) ? _openedManufacturer.Name : ("Manufacturer #" + _openedManufacturer.Id.ToString(CultureInfo.InvariantCulture)))
                </div>
                <div class="panel-body">
                    <p>Manufacturer id: <strong>@_openedManufacturer.Id.ToString(CultureInfo.InvariantCulture)</strong></p>
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Synonym id</th>
                                    <th>Synonym</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSynonyms.Count == 0)
                                {
                                    <tr><td colspan="2">No synonyms yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in _openedSynonyms)
                                    {
                                        <tr>
                                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(row.Synonym) ? row.Synonym : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_manufacturerCount.ToString(CultureInfo.InvariantCulture) Manufacturers · @_synonymCount.ToString(CultureInfo.InvariantCulture) Synonyms · @_orphanCount.ToString(CultureInfo.InvariantCulture) Orphans · @_mappedCount.ToString(CultureInfo.InvariantCulture) Mapped.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
        <thead>
            <tr>
                    <th>Manufacturer</th>
                    <th>Synonym</th>
                    <th>Manufacturer id</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="4">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr id="erp-row-@row.ManufacturerId.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.ManufacturerId, _openedId)">
                            <td>@(!string.IsNullOrWhiteSpace(row.Manufacturer) ? row.Manufacturer : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Synonym) ? row.Synonym : "—")</td>
                            <td>@row.ManufacturerId.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "manufacturer_id", row.ManufacturerId)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="epc-nw-note">Add, save, and delete manufacturer and synonym write when confirmWrites is set. List and get stay on the digest.</div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/manufacturers_synonyms";
    private const string _listHref = "/cp/synonyms-app";
    private bool _isAdmin;
    private int _manufacturerCount = 0;
    private int _synonymCount = 0;
    private int _orphanCount = 0;
    private int _mappedCount = 0;
    private IReadOnlyList<CpSynonymsRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private string _returnHref = "/cp/synonyms-app";
    private CpSynonymManufacturerDetail? _openedManufacturer;
    private IReadOnlyList<CpSynonymChildDigest> _openedSynonyms = [];

    private string OpenedCaption => _openedManufacturer is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedManufacturer.Name) ? ("Manufacturer #" + _openedManufacturer.Id.ToString(CultureInfo.InvariantCulture)) : _openedManufacturer.Name);

    private string OpenedIdValue => _openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "";
    private string OpenedNameValue => _openedManufacturer is null ? "" : _openedManufacturer.Name;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "manufacturer_id");
        _returnHref = _openedId > 0
            ? ErpRecordOpen.Href(_listHref, "manufacturer_id", _openedId).Split('#')[0]
            : _listHref;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpSynonymsDigestAsync(200, ctx.RequestAborted);
        _manufacturerCount = result.Summary.ManufacturerCount;
        _synonymCount = result.Summary.SynonymCount;
        _orphanCount = result.Summary.OrphanCount;
        _mappedCount = result.Summary.MappedCount;
        _rows = result.Rows;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpSynonymDetailAsync(_openedId, ctx.RequestAborted);
            _openedManufacturer = detail.Manufacturer;
            _openedSynonyms = detail.Synonyms;
            if (_openedManufacturer is not null)
            {
                var openedList = _rows.Where(r => r.ManufacturerId == _openedId).ToList();
                if (openedList.Count > 0)
                {
                    _rows = openedList.Concat(_rows.Where(r => r.ManufacturerId != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
