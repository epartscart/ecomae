@page "/cp/synonyms-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@inject ICpManufacturerSynonymWriteService Synonyms
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Manufacturer synonyms · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Manufacturer synonyms
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body epc-syn-actions">
                <a class="panel_a" href="/cp">
                    <div class="panel_a_img"><i class="fa fa-power-off"></i></div>
                    <div class="panel_a_caption">Exit</div>
                </a>
            </div>
        </div>
    </div>

<div class="col-lg-12">
<style>
    .epc-syn-actions .panel_a { display:inline-block; text-align:center; text-decoration:none; color:#333; }
    .epc-syn-actions .panel_a_img { width:48px; height:48px; margin:0 auto 4px; border-radius:8px; background:#f1f3f6; display:flex; align-items:center; justify-content:center; font-size:22px; color:#3498db; }
    .epc-syn-actions .panel_a_caption { font-size:12px; }
    .my_table { width:100%; margin-bottom:20px; }
    .my_table td:nth-child(2) { width:120px; text-align:right; }
    .my_table_2 { width:100%; }
    .my_table_2 td:nth-child(2) { width:195px; text-align:right; }
    .manufacturer, .synonym { border:1px solid #fff; position:relative; }
    .manufacturer_name, .synonym_name { padding:10px; cursor:pointer; display:block; color:inherit; text-decoration:none; }
    .manufacturer:hover, .manufacturer_active, .synonym:hover, .synonym_active { background:#eee; border:1px solid #ddd; }
    .manufacturer_edit, .synonym_edit { display:none; padding:6px; }
    .btn_block { position:absolute; display:inline-block; right:10px; top:4px; }
    .btn_block form { display:inline; }
    .epc-syn-scroll { max-height:600px; overflow-y:auto; border-top:1px solid #34495e; padding-top:10px; }
</style>
    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (!_isAdmin)
    {
        <div class="alert alert-warning" role="status">Sign in with an admin CP session to manage manufacturer synonyms. <a href="/cp/login?returnUrl=/cp/synonyms-app">Sign in</a></div>
    }
</div>

    <div class="col-lg-6">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Manufacturers
                <button class="btn btn-xs btn-info btn-circle" type="button" title="Manufacturers are the canonical brand names. Click a manufacturer to manage its synonyms on the right."><i class="fa fa-info"></i></button>
            </div>
            <div class="panel-body">
                @if (_isAdmin)
                {
                    <form method="post" action="/cp/synonyms/write">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@_returnHref" />
                        <input type="hidden" name="action" value="add_manufacturer" />
                        <table class="my_table">
                            <tr>
                                <td><input class="form-control" type="text" id="new_manufacturer" name="name" required maxlength="255" placeholder="New manufacturer" /></td>
                                <td><button type="submit" class="btn btn-ar btn-primary"><i class="fa fa-plus"></i> Add</button></td>
                            </tr>
                        </table>
                    </form>
                }
                <div id="manufacturers_div" class="epc-syn-scroll">
                    @if (_manufacturers.Count == 0)
                    {
                        <p class="text-muted">@(_isAdmin ? "No manufacturers yet." : "")</p>
                    }
                    @foreach (var m in _manufacturers)
                    {
                        var mid = m.Id.ToString(CultureInfo.InvariantCulture);
                        <div class="manufacturer @(m.Id == _openedId ? "manufacturer_active" : "")" id="erp-row-@mid">
                            <div id="manufacturer_@mid">
                                <a id="manufacturer_name_@mid" class="manufacturer_name" href="@ErpRecordOpen.Href(_listHref, "manufacturer_id", m.Id)">@m.Name</a>
                                @if (_isAdmin)
                                {
                                    <div class="btn_block">
                                        <a class="btn btn-sm btn-primary" title="Edit" href="javascript:void(0)" onclick="epcSynEdit('manufacturer', '@mid')"><i class="fas fa-pencil-alt"></i></a>
                                        <form method="post" action="/cp/synonyms/write" onsubmit="return confirm('Delete this manufacturer and all its synonyms?');">
                                            <input type="hidden" name="confirmWrites" value="true" />
                                            <input type="hidden" name="action" value="del_manufacturer" />
                                            <input type="hidden" name="id" value="@mid" />
                                            <button type="submit" class="btn btn-sm btn-primary" title="Delete"><i class="fa fa-times"></i></button>
                                        </form>
                                    </div>
                                }
                            </div>
                            @if (_isAdmin)
                            {
                                <div class="manufacturer_edit" id="manufacturer_edit_block_@mid">
                                    <form method="post" action="/cp/synonyms/write">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="@_returnHref" />
                                        <input type="hidden" name="action" value="save_manufacturer" />
                                        <input type="hidden" name="id" value="@mid" />
                                        <table class="my_table_2">
                                            <tr>
                                                <td><input class="form-control" type="text" id="manufacturer_edit_@mid" name="name" value="@m.Name" required maxlength="255" /></td>
                                                <td>
                                                    <button type="submit" class="btn btn-sm btn-primary"><i class="far fa-save"></i> Save</button>
                                                    <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="epcSynCancel('manufacturer', '@mid')"><i class="fa fa-chevron-left"></i> Cancel</a>
                                                </td>
                                            </tr>
                                        </table>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Synonyms @(_opened is not null ? "· " + _opened.Name : "")</div>
            <div class="panel-body" id="synonyms_div">
                @if (_opened is null)
                {
                    <p>Select a manufacturer on the left to view and manage its synonyms.</p>
                }
                else
                {
                    var oid = _opened.Id.ToString(CultureInfo.InvariantCulture);
                    if (_isAdmin)
                    {
                        <form method="post" action="/cp/synonyms/write">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@_returnHref" />
                            <input type="hidden" name="action" value="add_synonym" />
                            <input type="hidden" name="manufacturer_id" value="@oid" />
                            <table class="my_table">
                                <tr>
                                    <td><input class="form-control" type="text" id="new_synonym" name="name" required maxlength="255" placeholder="New synonym" /></td>
                                    <td><button type="submit" class="btn btn-ar btn-primary"><i class="fa fa-plus" aria-hidden="true"></i> Add</button></td>
                                </tr>
                            </table>
                        </form>
                    }
                    <div class="epc-syn-scroll">
                        @if (_synonyms.Count == 0)
                        {
                            <p class="text-muted">No synonyms yet.</p>
                        }
                        @foreach (var s in _synonyms)
                        {
                            var sid = s.Id.ToString(CultureInfo.InvariantCulture);
                            <div class="synonym">
                                <div id="synonym_@sid">
                                    <div id="synonym_name_@sid" class="synonym_name">@s.Synonym</div>
                                    @if (_isAdmin)
                                    {
                                        <div class="btn_block">
                                            <a class="btn btn-sm btn-primary" title="Edit" href="javascript:void(0)" onclick="epcSynEdit('synonym', '@sid')"><i class="fas fa-pencil-alt"></i></a>
                                            <form method="post" action="/cp/synonyms/write" onsubmit="return confirm('Delete this synonym?');">
                                                <input type="hidden" name="confirmWrites" value="true" />
                                                <input type="hidden" name="returnUrl" value="@_returnHref" />
                                                <input type="hidden" name="action" value="del_synonym" />
                                                <input type="hidden" name="id" value="@sid" />
                                                <button type="submit" class="btn btn-sm btn-primary" title="Delete"><i class="fa fa-times"></i></button>
                                            </form>
                                        </div>
                                    }
                                </div>
                                @if (_isAdmin)
                                {
                                    <div class="synonym_edit" id="synonym_edit_block_@sid">
                                        <form method="post" action="/cp/synonyms/write">
                                            <input type="hidden" name="confirmWrites" value="true" />
                                            <input type="hidden" name="returnUrl" value="@_returnHref" />
                                            <input type="hidden" name="action" value="save_synonym" />
                                            <input type="hidden" name="id" value="@sid" />
                                            <table class="my_table_2">
                                                <tr>
                                                    <td><input class="form-control" type="text" id="synonym_edit_@sid" name="name" value="@s.Synonym" required maxlength="255" /></td>
                                                    <td>
                                                        <button type="submit" class="btn btn-sm btn-primary"><i class="far fa-save"></i> Save</button>
                                                        <a class="btn btn-sm btn-primary" href="javascript:void(0)" onclick="epcSynCancel('synonym', '@sid')"><i class="fa fa-chevron-left"></i> Cancel</a>
                                                    </td>
                                                </tr>
                                            </table>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
<div class="col-lg-12">
<script>
    function epcSynEdit(kind, id) {
        document.getElementById(kind + '_' + id).style.display = 'none';
        document.getElementById(kind + '_edit_block_' + id).style.display = 'block';
        var i = document.getElementById(kind + '_edit_' + id); if (i) { i.focus(); i.select(); }
    }
    function epcSynCancel(kind, id) {
        document.getElementById(kind + '_edit_' + id).value = document.getElementById(kind + '_name_' + id).textContent.trim();
        document.getElementById(kind + '_edit_block_' + id).style.display = 'none';
        document.getElementById(kind + '_' + id).style.display = 'block';
    }
</script>
</div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/manufacturers_synonyms";
    private const string _listHref = "/cp/synonyms-app";
    private bool _isAdmin;
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private string _returnHref = "/cp/synonyms-app";
    private IReadOnlyList<CpManufacturerRow> _manufacturers = [];
    private CpManufacturerRow? _opened;
    private IReadOnlyList<CpManufacturerSynonymRow> _synonyms = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "manufacturer_id");
        _returnHref = _openedId > 0 ? "/cp/synonyms-app?manufacturer_id=" + _openedId.ToString(CultureInfo.InvariantCulture) : "/cp/synonyms-app";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        _manufacturers = await Synonyms.GetManufacturersAsync(ctx.RequestAborted);
        if (_openedId > 0)
        {
            _opened = _manufacturers.FirstOrDefault(m => m.Id == _openedId);
            if (_opened is null)
            {
                _flashErr = "Manufacturer #" + _openedId.ToString(CultureInfo.InvariantCulture) + " was not found.";
                _returnHref = "/cp/synonyms-app";
            }
            else
            {
                _synonyms = await Synonyms.GetSynonymsAsync(_openedId, ctx.RequestAborted);
            }
        }
    }
}
