@page "/cp/storages-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Storages · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Storages
                <a class="btn btn-xs btn-default pull-right" href="/erp/warehouses-app">ERP warehouses</a>
                <a class="btn btn-xs btn-default pull-right" href="/cp/currencies-app" style="margin-right:.4rem">Currencies</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" style="margin-right:.4rem">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Open a warehouse for currency, interface, and a storekeeper excerpt. Add or delete a warehouse group, create or edit a warehouse, and save office membership here. Connector secrets stay on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/storages-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedStorage is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/storages/groups" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/storages-app" />
            <input type="hidden" name="action" value="add_group" />
            <label>Group name <input type="text" name="name" required /></label>
            <label>Warehouse ids <input type="text" name="storages" required placeholder="1,2,3" /></label>
            <button type="submit">Add group</button>
        </form>
        <form method="post" action="/cp/storages/groups" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/storages-app" />
            <input type="hidden" name="action" value="del" />
            <label>Group id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <button type="submit">Delete group</button>
        </form>
        <form method="post" action="/cp/storages/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/storages-app" />
            <input type="hidden" name="action" value="create" />
            <label>Name <input type="text" name="name" required maxlength="255" /></label>
            <label>Short name <input type="text" name="shortName" maxlength="64" /></label>
            <label>Currency id <input type="number" name="currency" min="1" value="1" style="width:5rem" /></label>
            <label>Interface <input type="number" name="interfaceType" min="1" value="1" style="width:5rem" /></label>
            <label>Storekeepers <input type="text" name="users" placeholder="1,2" /></label>
            <label>Hidden
                <select name="hidden">
                    <option value="0" selected>No</option>
                    <option value="1">Yes</option>
                </select>
            </label>
            <button type="submit">Create warehouse</button>
        </form>
        <form method="post" action="/cp/storages/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/storages-app" />
            <input type="hidden" name="action" value="edit" />
            <label>Warehouse id <input type="number" name="storageId" min="1" required style="width:6rem" value="@(_openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "")" /></label>
            <label>Name <input type="text" name="name" required maxlength="255" value="@(_openedStorage is not null ? _openedStorage.Name : "")" /></label>
            <label>Short name <input type="text" name="shortName" maxlength="64" value="@(_openedStorage is not null ? _openedStorage.ShortName : "")" /></label>
            <label>Hidden
                <select name="hidden">
                    <option value="0">No</option>
                    <option value="1">Yes</option>
                </select>
            </label>
            <button type="submit">Save warehouse</button>
        </form>
        <form method="post" action="/cp/storages/membership" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/storages-app" />
            <label>Office id <input type="number" name="officeId" min="1" required value="1" style="width:6rem" /></label>
            <label>Membership JSON <input type="text" name="storagesList" required style="width:28rem" placeholder='[{"id":1,"checked":true,"time_to_shop":0,"groups":[{"id":2,"prices_ranges":[{"max_point":-1,"markup":0}]}]}]' /></label>
            <button type="submit">Save membership</button>
            <a class="btn btn-default btn-xs" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref("/CP/shop/logistics/offices/office/storages_link")">Classic twin</a>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Storage KPIs">
        <div class="kpi"><div class="lbl">Shown</div><div class="val">@_storages.Count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Visible</div><div class="val">@_visible.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Hidden</div><div class="val">@_hidden.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Siblings</div><div class="val">@_openedSiblings.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedStorage is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @OpenedCaption
                    <span class="label label-default pull-right">@(_openedStorage.Hidden ? "hidden" : "visible")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedStorage.ShortName) ? _openedStorage.ShortName : "—")
                        · currency @_openedStorage.Currency.ToString(CultureInfo.InvariantCulture)
                        · interface @_openedStorage.InterfaceType.ToString(CultureInfo.InvariantCulture)
                        · color @_openedStorage.BgLineColor.ToString(CultureInfo.InvariantCulture)</p>
                    @if (!string.IsNullOrWhiteSpace(_openedStorage.UsersExcerpt))
                    {
                        <p>@_openedStorage.UsersExcerpt
                            @if (_openedStorage.UsersLen > _openedStorage.UsersExcerpt.Length)
                            {
                                <span class="text-muted"> (excerpt)</span>
                            }
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">No storekeeper excerpt yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Same-interface siblings</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>Short name</th>
                                    <th>Hidden</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="5">No same-interface siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(string.IsNullOrWhiteSpace(sib.Name) ? "—" : sib.Name)</td>
                                            <td>@(string.IsNullOrWhiteSpace(sib.ShortName) ? "—" : sib.ShortName)</td>
                                            <td>@(sib.Hidden ? "yes" : "no")</td>
                                            <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "storage_id", sib.Id)">Open</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Warehouses</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Short name</th>
                                <th>Hidden</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!_isAdmin)
                        {
                            <tr><td colspan="5">Sign in for live data.</td></tr>
                        }
                        else if (_storages.Count == 0)
                        {
                            <tr><td colspan="5">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var s in _storages)
                            {
                                <tr id="erp-row-@s.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(s.Id, _openedId)">
                                    <td>@s.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(string.IsNullOrWhiteSpace(s.Name) ? "—" : s.Name)</td>
                                    <td>@(string.IsNullOrWhiteSpace(s.ShortName) ? "—" : s.ShortName)</td>
                                    <td>@(s.Hidden ? "yes" : "no")</td>
                                    <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "storage_id", s.Id)">Open</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/logistics/storages";
    private bool _isAdmin;
    private IReadOnlyList<CpStorageDigest> _storages = [];
    private int _visible;
    private int _hidden;
    private int _limit = 200;
    private string _flashOk = "";
    private string _flashErr = "";
    private string _listHref = "/cp/storages-app";
    private long _openedId;
    private CpStorageDetail? _openedStorage;
    private IReadOnlyList<CpStorageDigest> _openedSiblings = [];

    private string OpenedCaption => _openedStorage is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedStorage.Name)
            ? (string.IsNullOrWhiteSpace(_openedStorage.ShortName)
                ? ("Warehouse #" + _openedStorage.Id.ToString(CultureInfo.InvariantCulture))
                : _openedStorage.ShortName)
            : _openedStorage.Name);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "storage_id", "id");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.ListCpStoragesAsync(_limit, ctx.RequestAborted);
        _storages = result.Storages;
        _hidden = _storages.Count(s => s.Hidden);
        _visible = _storages.Count - _hidden;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpStoragesDetailAsync(_openedId, ctx.RequestAborted);
            _openedStorage = detail.Storage;
            _openedSiblings = detail.Siblings;
            if (_openedStorage is not null)
            {
                var openedList = _storages.FirstOrDefault(s => s.Id == _openedId);
                if (openedList is not null)
                {
                    _storages = new[] { openedList }.Concat(_storages.Where(s => s.Id != _openedId)).ToList();
                    _hidden = _storages.Count(s => s.Hidden);
                    _visible = _storages.Count - _hidden;
                }
            }
        }
    }
}
