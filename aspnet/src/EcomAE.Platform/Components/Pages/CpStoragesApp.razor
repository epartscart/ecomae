@page "/cp/storages-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Storages · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Storages
                <a class="btn btn-xs btn-default pull-right" href="/erp/warehouses-app">ERP warehouses</a>
                <a class="btn btn-xs btn-default pull-right" href="/cp/currencies-app" style="margin-right:.4rem">Currencies</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" style="margin-right:.4rem">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Add or delete a warehouse group, create or edit a warehouse, and save office membership here.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/storages-app" IsAdmin="_isAdmin" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/storages/groups" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/storages-app" />
            <input type="hidden" name="action" value="add_group" />
            <label>Group name <input type="text" name="name" required /></label>
            <label>Warehouse ids <input type="text" name="storages" required placeholder="1,2,3" /></label>
            <button type="submit">Add group</button>
        </form>
        <form method="post" action="/cp/storages/groups" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/storages-app" />
            <input type="hidden" name="action" value="del" />
            <label>Group id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <button type="submit">Delete group</button>
        </form>
        <form method="post" action="/cp/storages/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/storages-app" />
            <input type="hidden" name="action" value="create" />
            <label>Name <input type="text" name="name" required maxlength="255" /></label>
            <label>Short name <input type="text" name="shortName" maxlength="64" /></label>
            <label>Currency id <input type="number" name="currency" min="1" value="1" style="width:5rem" /></label>
            <label>Interface <input type="number" name="interfaceType" min="1" value="1" style="width:5rem" /></label>
            <label>Storekeepers <input type="text" name="users" placeholder="1,2" /></label>
            <label>Hidden
                <select name="hidden">
                    <option value="0" selected>No</option>
                    <option value="1">Yes</option>
                </select>
            </label>
            <button type="submit">Create warehouse</button>
        </form>
        <form method="post" action="/cp/storages/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/storages-app" />
            <input type="hidden" name="action" value="edit" />
            <label>Warehouse id <input type="number" name="storageId" min="1" required style="width:6rem" /></label>
            <label>Name <input type="text" name="name" required maxlength="255" /></label>
            <label>Short name <input type="text" name="shortName" maxlength="64" /></label>
            <label>Hidden
                <select name="hidden">
                    <option value="0">No</option>
                    <option value="1">Yes</option>
                </select>
            </label>
            <button type="submit">Save warehouse</button>
        </form>
        <form method="post" action="/cp/storages/membership" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/storages-app" />
            <label>Office id <input type="number" name="officeId" min="1" required value="1" style="width:6rem" /></label>
            <label>Membership JSON <input type="text" name="storagesList" required style="width:28rem" placeholder='[{"id":1,"checked":true,"time_to_shop":0,"groups":[{"id":2,"prices_ranges":[{"max_point":-1,"markup":0}]}]}]' /></label>
            <button type="submit">Save membership</button>
            <a class="btn btn-default btn-xs" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref("/CP/shop/logistics/offices/office/storages_link")">Classic twin</a>
        </form>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Warehouses</div>
            <div class="panel-body">
                <p class="help-block">@_storages.Count shown (limit @_limit) · @_visible visible · @_hidden hidden.</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Short name</th>
                                <th>Hidden</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_storages.Count == 0)
                        {
                            <tr><td colspan="4">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var s in _storages)
                            {
                                <tr>
                                    <td>@s.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(string.IsNullOrWhiteSpace(s.Name) ? "—" : s.Name)</td>
                                    <td>@(string.IsNullOrWhiteSpace(s.ShortName) ? "—" : s.ShortName)</td>
                                    <td>@(s.Hidden ? "yes" : "no")</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/logistics/storages";
    private bool _isAdmin;
    private IReadOnlyList<CpStorageDigest> _storages = [];
    private int _visible;
    private int _hidden;
    private int _limit = 200;
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.ListCpStoragesAsync(_limit, ctx.RequestAborted);
        _storages = result.Storages;
        _hidden = _storages.Count(s => s.Hidden);
        _visible = _storages.Count - _hidden;
    }
}
