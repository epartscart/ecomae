@page "/cp/accessories-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Accessories · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-nw-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-nw-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-nw-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-nw-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-nw-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f172a; background:#fff;
        }
        .epc-nw-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-nw-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-nw-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-nw-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-nw-kpi span { color:#64748b; font-size:.78rem; }
        .epc-nw-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-nw-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-nw-table th, .epc-nw-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-nw-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-nw-note { margin-top:1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:.45rem; color:#334155; font-size:.86rem; }
        @@media (max-width:900px){ .epc-nw-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-nw-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Accessories</h1>
        <p>@CpPhpModuleCopy.PurposeFor(Nav.Uri)</p>
        <div class="epc-nw-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="#listings">Listings</a>
            <a class="ghost" href="#photos">Photos</a>
        </div>
    </section>
    <PhpParityModuleBody AppPath="/cp/accessories-app" IsAdmin="_isAdmin" />


    <div class="epc-nw-kpis" aria-label="Accessories stats">
        <div class="epc-nw-kpi"><strong>@_listingCount.ToString(CultureInfo.InvariantCulture)</strong><span>Listings</span></div>
        <div class="epc-nw-kpi"><strong>@_publishedCount.ToString(CultureInfo.InvariantCulture)</strong><span>Published</span></div>
        <div class="epc-nw-kpi"><strong>@_categoryCount.ToString(CultureInfo.InvariantCulture)</strong><span>Categories</span></div>
        <div class="epc-nw-kpi"><strong>@_photoCount.ToString(CultureInfo.InvariantCulture)</strong><span>Photos</span></div>
    </div>

    <div class="epc-nw-table-wrap">
    <table class="epc-nw-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Title</th>
                    <th>Make</th>
                    <th>Model</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="7">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Make) ? row.Make : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Model) ? row.Model : "—")</td>
                            <td>@row.Price.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>

    <form id="listings" method="post" action="/cp/accessories/listings/write" style="display:flex;flex-direction:column;gap:.45rem;margin:1rem 0;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="/cp/accessories-app" />
        <input type="hidden" name="action" value="save" />
        <div style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
            <label>Listing id <input type="number" name="listingId" min="0" value="0" style="width:6rem" title="0 = create" /></label>
            <label>Category id <input type="number" name="categoryId" min="1" required style="width:6rem" /></label>
            <label>Subcategory id <input type="number" name="subcategoryId" min="0" value="0" style="width:6rem" /></label>
            <label>Title <input type="text" name="title" required /></label>
            <label>Make <input type="text" name="make" /></label>
            <label>Model <input type="text" name="model" /></label>
            <label>Price <input type="number" name="price" min="0" step="0.01" value="0" style="width:7rem" /></label>
            <label>Status
                <select name="status">
                    <option value="published">published</option>
                    <option value="draft">draft</option>
                </select>
            </label>
        </div>
        <label>Description <input type="text" name="description" style="width:100%" /></label>
        <button type="submit">Save listing</button>
    </form>
    <form method="post" action="/cp/accessories/listings/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="/cp/accessories-app" />
        <input type="hidden" name="action" value="set_status" />
        <label>Listing id <input type="number" name="listingId" min="1" required style="width:6rem" /></label>
        <label>Status
            <select name="status">
                <option value="published">published</option>
                <option value="draft">draft</option>
            </select>
        </label>
        <button type="submit">Set listing status</button>
    </form>
    <form method="post" action="/cp/accessories/listings/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="/cp/accessories-app" />
        <input type="hidden" name="action" value="delete" />
        <label>Listing id <input type="number" name="listingId" min="1" required style="width:6rem" /></label>
        <button type="submit">Delete listing</button>
    </form>

    <form id="photos" method="post" action="/cp/accessories/photos" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:1rem 0;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="/cp/accessories-app" />
        <input type="hidden" name="action" value="upload" />
        <label>Listing id <input type="number" name="listingId" min="1" required style="width:6rem" /></label>
        <label>Image name <input type="text" name="fileName" placeholder="acc-cover.png" required /></label>
        <label>Primary <input type="checkbox" name="asPrimary" value="1" /></label>
        <button type="submit">Save photo</button>
    </form>
    <form method="post" action="/cp/accessories/photos" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="/cp/accessories-app" />
        <input type="hidden" name="action" value="set_primary" />
        <label>Listing id <input type="number" name="listingId" min="1" required style="width:6rem" /></label>
        <label>Photo id <input type="number" name="photoId" min="1" required style="width:6rem" /></label>
        <button type="submit">Set primary photo</button>
    </form>
    <form method="post" action="/cp/accessories/photos" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="/cp/accessories-app" />
        <input type="hidden" name="action" value="delete" />
        <label>Listing id <input type="number" name="listingId" min="1" required style="width:6rem" /></label>
        <label>Photo id <input type="number" name="photoId" min="1" required style="width:6rem" /></label>
        <button type="submit">Delete photo</button>
    </form>

    <div class="epc-nw-note">Listing save/status/delete and photo filename attach write here. Multipart photo bytes and taxonomy stay Classic.</div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/accessories";
    private bool _isAdmin;
    private int _listingCount = 0;
    private int _publishedCount = 0;
    private int _categoryCount = 0;
    private int _photoCount = 0;
    private IReadOnlyList<CpAccessoriesRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpAccessoriesDigestAsync(200, ctx.RequestAborted);
        _listingCount = result.Summary.ListingCount;
        _publishedCount = result.Summary.PublishedCount;
        _categoryCount = result.Summary.CategoryCount;
        _photoCount = result.Summary.PhotoCount;
        _rows = result.Rows;
        _source = result.Source;
        _message = result.Message;
    }
}
