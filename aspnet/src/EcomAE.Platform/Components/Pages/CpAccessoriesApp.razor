@page "/cp/accessories-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Accessories · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Accessories
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/accessories-app")</p>
                <p>Open a listing to see description and photos. Listing, taxonomy, and photo writes stay here. Multipart photo bytes stay Classic.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/accessories-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedListing is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Accessories KPIs">
        <div class="kpi"><div class="lbl">Listings</div><div class="val">@_listingCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Published</div><div class="val">@_publishedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Categories</div><div class="val">@_categoryCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Photos</div><div class="val">@_photoCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedListing is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedListing.Title) ? _openedListing.Title : ("Listing #" + _openedListing.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedListing.Status) ? _openedListing.Status : "—")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedListing.Make) ? _openedListing.Make : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedListing.Model) ? _openedListing.Model : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedListing.Year) ? _openedListing.Year : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedListing.City) ? _openedListing.City : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedListing.ConditionType) ? _openedListing.ConditionType : "—")</p>
                    <p>Price: <strong>@_openedListing.Price.ToString("0.00", CultureInfo.InvariantCulture)</strong>
                        @(!string.IsNullOrWhiteSpace(_openedListing.Currency) ? _openedListing.Currency : "AED")
                        · Compare @_openedListing.ComparePrice.ToString("0.00", CultureInfo.InvariantCulture)
                        · Stock @_openedListing.StockQty.ToString(CultureInfo.InvariantCulture)
                        · @(_openedListing.Featured ? "featured" : "standard")</p>
                    <p>Category @_openedListing.CategoryId.ToString(CultureInfo.InvariantCulture)
                        · Subcategory @_openedListing.SubcategoryId.ToString(CultureInfo.InvariantCulture)
                        · Photos @_openedListing.PhotoCount.ToString(CultureInfo.InvariantCulture)</p>
                    @if (string.IsNullOrWhiteSpace(_openedListing.Description))
                    {
                        <p class="text-muted">No description yet.</p>
                    }
                    else
                    {
                        <p>@_openedListing.Description</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedListing.ImageUrl))
                    {
                        <p>Image: @_openedListing.ImageUrl</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedListing.ExternalUrl))
                    {
                        <p>External: @_openedListing.ExternalUrl</p>
                    }
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Photo id</th>
                                    <th>File</th>
                                    <th>Primary</th>
                                    <th>Sort</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedPhotos.Count == 0)
                                {
                                    <tr><td colspan="4">No photos yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in _openedPhotos)
                                    {
                                        <tr>
                                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(row.FileName) ? row.FileName : "—")</td>
                                            <td>@(row.IsPrimary ? "yes" : "no")</td>
                                            <td>@row.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_listingCount.ToString(CultureInfo.InvariantCulture) Listings · @_publishedCount.ToString(CultureInfo.InvariantCulture) Published · @_categoryCount.ToString(CultureInfo.InvariantCulture) Categories · @_photoCount.ToString(CultureInfo.InvariantCulture) Photos.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Title</th>
                    <th>Make</th>
                    <th>Model</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Make) ? row.Make : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Model) ? row.Model : "—")</td>
                            <td>@row.Price.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "listing_id", row.Id)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <form id="listings" method="post" action="/cp/accessories/listings/write" style="display:flex;flex-direction:column;gap:.45rem;margin:1rem 0;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="@_returnHref" />
        <input type="hidden" name="action" value="save" />
        <div style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
            <label>Listing id <input type="number" name="listingId" min="0" value="@OpenedListingIdOrZero" style="width:6rem" title="0 = create" /></label>
            <label>Category id <input type="number" name="categoryId" min="1" required style="width:6rem" value="@OpenedCategoryValue" /></label>
            <label>Subcategory id <input type="number" name="subcategoryId" min="0" value="@OpenedSubcategoryValue" style="width:6rem" /></label>
            <label>Title <input type="text" name="title" required value="@OpenedTitleValue" /></label>
            <label>Make <input type="text" name="make" value="@OpenedMakeValue" /></label>
            <label>Model <input type="text" name="model" value="@OpenedModelValue" /></label>
            <label>Price <input type="number" name="price" min="0" step="0.01" value="@OpenedPriceValue" style="width:7rem" /></label>
            <label>Status
                <select name="status">
                    <option value="published">published</option>
                    <option value="draft">draft</option>
                </select>
            </label>
        </div>
        <label>Description <input type="text" name="description" style="width:100%" value="@OpenedDescriptionValue" /></label>
        <button type="submit">Save listing</button>
    </form>
    <form method="post" action="/cp/accessories/listings/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="@_returnHref" />
        <input type="hidden" name="action" value="set_status" />
        <label>Listing id <input type="number" name="listingId" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
        <label>Status
            <select name="status">
                <option value="published">published</option>
                <option value="draft">draft</option>
            </select>
        </label>
        <button type="submit">Set listing status</button>
    </form>
    <form method="post" action="/cp/accessories/listings/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="@_returnHref" />
        <input type="hidden" name="action" value="delete" />
        <label>Listing id <input type="number" name="listingId" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
        <button type="submit">Delete listing</button>
    </form>

    <form id="taxonomy" method="post" action="/cp/accessories/taxonomy/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:1rem 0;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="@_listHref" />
        <input type="hidden" name="action" value="save_category" />
        <label>Category id <input type="number" name="id" min="0" value="0" style="width:6rem" title="0 = create" /></label>
        <label>Parent id <input type="number" name="parentId" min="0" value="0" style="width:6rem" /></label>
        <label>Label <input type="text" name="label" required /></label>
        <button type="submit">Save category</button>
    </form>
    <form method="post" action="/cp/accessories/taxonomy/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="@_listHref" />
        <input type="hidden" name="action" value="set_category_active" />
        <label>Category id <input type="number" name="id" min="1" required style="width:6rem" /></label>
        <label>Active <input type="checkbox" name="active" value="1" checked /></label>
        <button type="submit">Set category active</button>
    </form>
    <form method="post" action="/cp/accessories/taxonomy/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="@_listHref" />
        <input type="hidden" name="action" value="delete_category" />
        <label>Category id <input type="number" name="id" min="1" required style="width:6rem" /></label>
        <button type="submit">Delete category</button>
    </form>
    <form method="post" action="/cp/accessories/taxonomy/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="@_listHref" />
        <input type="hidden" name="action" value="save_term" />
        <label>Term id <input type="number" name="id" min="0" value="0" style="width:6rem" title="0 = create" /></label>
        <label>Type <input type="text" name="termType" value="make" required style="width:8rem" /></label>
        <label>Label <input type="text" name="label" required /></label>
        <button type="submit">Save term</button>
    </form>
    <form method="post" action="/cp/accessories/taxonomy/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="@_listHref" />
        <input type="hidden" name="action" value="set_term_active" />
        <label>Term id <input type="number" name="id" min="1" required style="width:6rem" /></label>
        <label>Active <input type="checkbox" name="active" value="1" checked /></label>
        <button type="submit">Set term active</button>
    </form>
    <form method="post" action="/cp/accessories/taxonomy/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="@_listHref" />
        <input type="hidden" name="action" value="delete_term" />
        <label>Term id <input type="number" name="id" min="1" required style="width:6rem" /></label>
        <button type="submit">Delete term</button>
    </form>

    <form id="photos" method="post" action="/cp/accessories/photos" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:1rem 0;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="@_returnHref" />
        <input type="hidden" name="action" value="upload" />
        <label>Listing id <input type="number" name="listingId" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
        <label>Image name <input type="text" name="fileName" placeholder="acc-cover.png" required /></label>
        <label>Primary <input type="checkbox" name="asPrimary" value="1" /></label>
        <button type="submit">Save photo</button>
    </form>
    <form method="post" action="/cp/accessories/photos" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="@_returnHref" />
        <input type="hidden" name="action" value="set_primary" />
        <label>Listing id <input type="number" name="listingId" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
        <label>Photo id <input type="number" name="photoId" min="1" required style="width:6rem" /></label>
        <button type="submit">Set primary photo</button>
    </form>
    <form method="post" action="/cp/accessories/photos" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="returnUrl" value="@_returnHref" />
        <input type="hidden" name="action" value="delete" />
        <label>Listing id <input type="number" name="listingId" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
        <label>Photo id <input type="number" name="photoId" min="1" required style="width:6rem" /></label>
        <button type="submit">Delete photo</button>
    </form>

    <div class="epc-nw-note">Listing save/status/delete, photo filename attach, and taxonomy write here. Multipart photo bytes stay Classic.</div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/accessories";
    private const string _listHref = "/cp/accessories-app";
    private bool _isAdmin;
    private int _listingCount = 0;
    private int _publishedCount = 0;
    private int _categoryCount = 0;
    private int _photoCount = 0;
    private IReadOnlyList<CpAccessoriesRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private string _returnHref = "/cp/accessories-app";
    private CpAccessoriesListingDetail? _openedListing;
    private IReadOnlyList<CpAccessoriesPhotoDigest> _openedPhotos = [];

    private string OpenedCaption => _openedListing is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedListing.Title) ? ("Listing #" + _openedListing.Id.ToString(CultureInfo.InvariantCulture)) : _openedListing.Title);

    private string OpenedIdValue => _openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "";
    private string OpenedListingIdOrZero => _openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "0";
    private string OpenedCategoryValue => _openedListing is null || _openedListing.CategoryId <= 0
        ? ""
        : _openedListing.CategoryId.ToString(CultureInfo.InvariantCulture);
    private string OpenedSubcategoryValue => _openedListing is null
        ? "0"
        : _openedListing.SubcategoryId.ToString(CultureInfo.InvariantCulture);
    private string OpenedTitleValue => _openedListing?.Title ?? "";
    private string OpenedMakeValue => _openedListing?.Make ?? "";
    private string OpenedModelValue => _openedListing?.Model ?? "";
    private string OpenedPriceValue => _openedListing is null
        ? "0"
        : _openedListing.Price.ToString(CultureInfo.InvariantCulture);
    private string OpenedDescriptionValue => _openedListing?.Description ?? "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "listing_id");
        _returnHref = _openedId > 0
            ? ErpRecordOpen.Href(_listHref, "listing_id", _openedId).Split('#')[0]
            : _listHref;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpAccessoriesDigestAsync(200, ctx.RequestAborted);
        _listingCount = result.Summary.ListingCount;
        _publishedCount = result.Summary.PublishedCount;
        _categoryCount = result.Summary.CategoryCount;
        _photoCount = result.Summary.PhotoCount;
        _rows = result.Rows;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpAccessoriesListingDetailAsync(_openedId, ctx.RequestAborted);
            _openedListing = detail.Listing;
            _openedPhotos = detail.Photos;
            if (_openedListing is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
