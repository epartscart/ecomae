@page "/erp/cash-entries-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Cash Entries · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<style>
    .epc-fno-entry-shell { border:1px solid #dfe5ee; background:#fff; box-shadow:0 1px 3px rgba(15,23,42,.06); margin:0 0 1rem; }
    .epc-fno-entry-tabs { display:flex; flex-wrap:wrap; gap:0; border-bottom:1px solid #dfe5ee; background:#f6f8fb; }
    .epc-fno-entry-tabs a { display:inline-block; padding:.65rem .9rem; color:#334155; text-decoration:none; border-right:1px solid #e2e8f0; font-size:12px; }
    .epc-fno-entry-tabs a:hover, .epc-fno-entry-tabs a.active { background:#fff; color:#1d4e89; box-shadow:inset 0 -2px 0 #2b6cb0; }
    .epc-fno-entry-body { padding:1rem; }
    .epc-fno-form { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.7rem 1rem; max-width:980px; }
    .epc-fno-form .field { display:flex; flex-direction:column; gap:.25rem; }
    .epc-fno-form .field.wide { grid-column:1 / -1; }
    .epc-fno-form label { color:#334155; font-size:12px; font-weight:600; }
    .epc-fno-form input, .epc-fno-form select { min-height:30px; border:1px solid #cbd5e1; border-radius:3px; padding:.3rem .45rem; }
    .epc-fno-form .form-actions { grid-column:1 / -1; display:flex; flex-wrap:wrap; gap:.45rem; align-items:center; border-top:1px solid #e5e7eb; padding-top:.75rem; }
    @@media (max-width:720px) { .epc-fno-form { grid-template-columns:1fr; } .epc-fno-form .field.wide, .epc-fno-form .form-actions { grid-column:auto; } }
</style>
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Cash Entries" BreadcrumbArea="Cash & Treasury" BreadcrumbTab="Cash ledger">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/cash-entries-app" IsAdmin="_isAdmin" />


    
    <PhpErpModulePageHeader Title="Cash Ledger Entries" Subtitle="Post receipts, payments, transfers, and adjustments with PHP-compatible voucher and audit handling." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    @if (_isAdmin)
    {
        <div class="epc-fno-entry-shell" id="new-voucher">
            <nav class="epc-fno-entry-tabs" aria-label="Cash voucher actions">
                <a class="active" href="#new-voucher"><i class="fa fa-plus-circle"></i> New</a>
                <a href="#receipt-voucher"><i class="fa fa-arrow-down"></i> Receipt journal</a>
                <a href="#payment-voucher"><i class="fa fa-arrow-up"></i> Payment journal</a>
                <a href="#cash-entry"><i class="fa fa-pencil"></i> Create entry</a>
                @if (_openedId > 0)
                {
                    <a href="#voucher-options"><i class="fa fa-cog"></i> Options</a>
                }
            </nav>
            <div class="epc-fno-entry-body">
                <div style="display:flex;justify-content:space-between;gap:1rem;align-items:baseline;margin-bottom:.8rem;">
                    <div>
                        <strong style="font-size:15px;color:#1d2740;">Cash and bank journal workspace</strong>
                        <div class="text-muted" style="font-size:12px;margin-top:3px;">Create a voucher, validate the header, then post it with the PHP-compatible voucher sequence and audit trail.</div>
                    </div>
                    <span class="label label-info">F&amp;O-style workspace</span>
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:.45rem;">
                    <a class="btn btn-sm btn-primary" href="#receipt-voucher"><i class="fa fa-plus"></i> New receipt journal</a>
                    <a class="btn btn-sm btn-primary" href="#payment-voucher"><i class="fa fa-plus"></i> New payment journal</a>
                    <a class="btn btn-sm btn-default" href="#cash-entry"><i class="fa fa-plus"></i> New cash entry</a>
                    <a class="btn btn-sm btn-default" href="@Nav.Uri"><i class="fa fa-refresh"></i> Refresh</a>
                </div>
            </div>
        </div>

        <div class="epc-fno-entry-shell" id="receipt-voucher">
            <div class="epc-fno-entry-body">
                <h4 style="margin:0 0 .25rem;color:#1d2740;"><i class="fa fa-arrow-down" style="color:#16803c;"></i> Receipt journal / receipt voucher</h4>
                <p class="text-muted" style="font-size:12px;margin:0 0 .8rem;">Customer receipt, advance receipt, or invoice settlement. Posted vouchers receive an RV sequence and remain auditable.</p>
                <form method="post" action="@EcomAeRoutes.ErpCashEntriesReceiptVoucher" class="epc-fno-form">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <div class="field"><label for="rv_user_id">Customer user id *</label><input id="rv_user_id" type="number" name="user_id" min="1" required /></div>
                    <div class="field"><label for="rv_account_id">Receipt bank/cash account *</label><input id="rv_account_id" type="number" name="account_id" min="1" required /></div>
                    <div class="field"><label for="rv_amount">Amount *</label><input id="rv_amount" type="number" name="amount" min="0.01" step="0.01" required /></div>
                    <div class="field"><label for="rv_sales_order_id">Sales order id</label><input id="rv_sales_order_id" type="number" name="sales_order_id" min="1" /></div>
                    <div class="field"><label for="rv_sales_invoice_id">Sales invoice id</label><input id="rv_sales_invoice_id" type="number" name="sales_invoice_id" min="1" /></div>
                    <div class="field"><label for="rv_order_id">Order id</label><input id="rv_order_id" type="number" name="order_id" min="1" /></div>
                    <div class="field wide"><label for="rv_note">Narration / note</label><input id="rv_note" type="text" name="note" maxlength="255" /></div>
                    <div class="form-actions">
                        <label style="display:inline-flex;flex-direction:row;align-items:center;gap:.35rem;font-weight:500;"><input type="checkbox" name="is_advance" value="true" /> Advance receipt</label>
                        <label style="display:inline-flex;flex-direction:row;align-items:center;gap:.35rem;font-weight:500;"><input type="checkbox" name="auto_allocate" value="true" /> Auto-allocate open invoices</label>
                        <label style="display:inline-flex;flex-direction:row;align-items:center;gap:.35rem;font-weight:500;"><input type="checkbox" name="post_gl" value="true" checked /> Post to GL</label>
                        <span style="flex:1;"></span>
                        <button type="reset" class="btn btn-sm btn-default">Clear</button>
                        <button type="submit" class="btn btn-sm btn-primary"><i class="fa fa-check"></i> Validate &amp; post RV</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="epc-fno-entry-shell" id="payment-voucher">
            <div class="epc-fno-entry-body">
                <h4 style="margin:0 0 .25rem;color:#1d2740;"><i class="fa fa-arrow-up" style="color:#b45309;"></i> Payment journal / payment voucher</h4>
                <p class="text-muted" style="font-size:12px;margin:0 0 .8rem;">Supplier payment, advance payment, or bill settlement. Posted vouchers receive a PV sequence and remain auditable.</p>
                <form method="post" action="@EcomAeRoutes.ErpCashEntriesPaymentVoucher" class="epc-fno-form">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <div class="field"><label for="pv_supplier_id">Supplier id *</label><input id="pv_supplier_id" type="number" name="supplier_id" min="1" required /></div>
                    <div class="field"><label for="pv_account_id">Payment bank/cash account *</label><input id="pv_account_id" type="number" name="account_id" min="1" required /></div>
                    <div class="field"><label for="pv_amount">Amount *</label><input id="pv_amount" type="number" name="amount" min="0.01" step="0.01" required /></div>
                    <div class="field"><label for="pv_purchase_id">Purchase bill id</label><input id="pv_purchase_id" type="number" name="purchase_id" min="1" /></div>
                    <div class="field"><label for="pv_purchase_order_id">Purchase order id</label><input id="pv_purchase_order_id" type="number" name="purchase_order_id" min="1" /></div>
                    <div class="field"><label for="pv_reference">Reference</label><input id="pv_reference" type="text" name="reference" maxlength="120" /></div>
                    <div class="field wide"><label for="pv_note">Narration / note</label><input id="pv_note" type="text" name="note" maxlength="255" /></div>
                    <div class="form-actions">
                        <label style="display:inline-flex;flex-direction:row;align-items:center;gap:.35rem;font-weight:500;"><input type="checkbox" name="is_advance" value="true" /> Advance payment</label>
                        <label style="display:inline-flex;flex-direction:row;align-items:center;gap:.35rem;font-weight:500;"><input type="checkbox" name="auto_allocate" value="true" /> Auto-allocate open bills</label>
                        <span style="flex:1;"></span>
                        <button type="reset" class="btn btn-sm btn-default">Clear</button>
                        <button type="submit" class="btn btn-sm btn-primary"><i class="fa fa-check"></i> Validate &amp; post PV</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="epc-fno-entry-shell" id="cash-entry">
            <div class="epc-fno-entry-body">
                <h4 style="margin:0 0 .25rem;color:#1d2740;"><i class="fa fa-pencil"></i> Generic cash entry</h4>
                <form method="post" action="@EcomAeRoutes.ErpCashEntriesCreate" class="epc-fno-form">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <div class="field"><label for="ce_account_id">Account *</label><input id="ce_account_id" type="number" name="account_id" min="1" required /></div>
                    <div class="field"><label for="ce_amount">Amount *</label><input id="ce_amount" type="number" name="amount" min="0.01" step="0.01" required /></div>
                    <div class="field"><label for="ce_direction">Direction</label><select id="ce_direction" name="direction"><option value="in">Receipt / in</option><option value="out">Payment / out</option></select></div>
                    <div class="field"><label for="ce_type">Entry type</label><select id="ce_type" name="entry_type"><option value="receipt">Receipt</option><option value="payment">Payment</option><option value="transfer_in">Transfer in</option><option value="transfer_out">Transfer out</option><option value="adjustment">Adjustment</option></select></div>
                    <div class="field"><label for="ce_reference">Reference</label><input id="ce_reference" type="text" name="reference" maxlength="120" /></div>
                    <div class="field wide"><label for="ce_note">Narration / note</label><input id="ce_note" type="text" name="note" maxlength="255" /></div>
                    <div class="form-actions">
                        <button type="reset" class="btn btn-sm btn-default">Clear</button>
                        <button type="submit" class="btn btn-sm btn-primary"><i class="fa fa-check"></i> Validate &amp; create</button>
                    </div>
                </form>
            </div>
        </div>
    }
    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="/erp/cash-entries-app" />


    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Cash entry KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_entries.Count</div></div>
        <div class="kpi"><div class="lbl">Inflows in page</div><div class="val">@_inCount</div></div>
        <div class="kpi"><div class="lbl">Outflows in page</div><div class="val">@_outCount</div></div>
        <div class="kpi"><div class="lbl">Page net amount</div><div class="val">@_net.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedDetail is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="/erp/cash-entries-app">Close</a>
            </p>
            @if (_isAdmin)
            {
                <div id="voucher-options" style="border:1px solid #dfe5ee;background:#f8fafc;padding:.7rem .8rem;margin:0 0 .9rem;">
                    <div style="font-size:12px;font-weight:700;color:#1d2740;margin-bottom:.45rem;"><i class="fa fa-cog"></i> Options</div>
                    <div style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;">
                        <form method="post" action="@EcomAeRoutes.ErpCashEntriesAmend" style="display:flex;gap:.35rem;align-items:end;flex-wrap:wrap;">
                            <input type="hidden" name="entry_id" value="@_openedId" />
                            <input type="hidden" name="confirmWrites" value="true" />
                            <label style="font-size:11px;color:#475569;">Reference <input type="text" name="reference" maxlength="120" value="@_openedDetail?.Reference" /></label>
                            <label style="font-size:11px;color:#475569;">Note <input type="text" name="note" maxlength="255" /></label>
                            <button type="submit" class="btn btn-xs btn-default"><i class="fa fa-pencil"></i> Amend narrative</button>
                        </form>
                        <form method="post" action="@EcomAeRoutes.ErpCashEntriesVoid" onsubmit="return confirm('Void this voucher and post its reversing journal?');" style="display:flex;gap:.35rem;align-items:end;flex-wrap:wrap;">
                            <input type="hidden" name="entry_id" value="@_openedId" />
                            <input type="hidden" name="confirmWrites" value="true" />
                            <label style="font-size:11px;color:#475569;">Void reason <input type="text" name="reason" maxlength="255" required placeholder="Required audit reason" /></label>
                            <button type="submit" class="btn btn-xs btn-warning"><i class="fa fa-ban"></i> Void voucher</button>
                        </form>
                        <span class="text-muted" style="font-size:11px;">Delete is intentionally unavailable for posted vouchers; void creates the reversing journal and preserves the audit trail.</span>
                    </div>
                </div>
            }
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Entry id</dt><dd>@_openedDetail!.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>When</dt><dd>@FormatTime(_openedDetail!.TimeUnix)</dd>
                <dt>Account</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail!.AccountName) ? ("#" + _openedDetail.AccountId.ToString(CultureInfo.InvariantCulture)) : _openedDetail.AccountName)</dd>
                <dt>Account type</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail!.AccountType) ? "—" : _openedDetail.AccountType)</dd>
                <dt>Entry type</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail!.EntryType) ? "—" : _openedDetail.EntryType)</dd>
                <dt>Direction</dt><dd>@FormatDirection(_openedDetail!.Direction)</dd>
                <dt>Amount</dt><dd>@_openedDetail!.Amount.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Reference</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail!.Reference) ? "—" : _openedDetail.Reference)</dd>
                <dt>Counterparty</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail!.CounterpartyType) ? "—" : _openedDetail.CounterpartyType)@(_openedDetail.CounterpartyId > 0 ? (" #" + _openedDetail.CounterpartyId.ToString(CultureInfo.InvariantCulture)) : "")</dd>
                <dt>Order</dt><dd>@(_openedDetail!.OrderId > 0 ? _openedDetail.OrderId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Purchase</dt><dd>@(_openedDetail!.PurchaseId > 0 ? _openedDetail.PurchaseId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Transfer pair</dt><dd>@(_openedDetail!.TransferPairId > 0 ? _openedDetail.TransferPairId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Admin</dt><dd>@(_openedDetail!.AdminId > 0 ? _openedDetail.AdminId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Note and reference remain visible in the ledger list for audit follow-up.</p>
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-type siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>When</th><th>Account</th><th class="text-right">Amount</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@FormatTime(sib.TimeUnix)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.AccountName) ? ("#" + sib.AccountId.ToString(CultureInfo.InvariantCulture)) : sib.AccountName)</td>
                                <td class="text-right">@sib.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href("/erp/cash-entries-app", "entry_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-type siblings yet.</p>
            }
            <p class="text-muted">Cash-entry writes stay Classic-compatible until cash parity is closed.</p>
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Account</th>
                    <th>Type</th>
                    <th>Direction</th>
                    <th>Amount</th>
                    <th>Reference</th>
                    <th>Note</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_entries.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var e in _entries)
                    {
                        var dirClass = e.Direction == 1 ? "" : "out";
                        <tr id="erp-row-@e.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(e.Id, _openedId)">
                            <td>@FormatTime(e.TimeUnix)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(e.AccountName) ? $"#{e.AccountId}" : e.AccountName)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(e.AccountType) ? "—" : e.AccountType)</td>
                            <td><span class="epc-ce-badge @dirClass">@FormatDirection(e.Direction)</span></td>
                            <td>@e.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(e.Reference) ? "—" : e.Reference)</td>
                            <td>@(string.IsNullOrWhiteSpace(e.Note) ? "—" : e.Note)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href("/erp/cash-entries-app", "entry_id", e.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=banking&tab=cash_bank";
    private bool _isAdmin;
    private IReadOnlyList<ErpCashEntryDigest> _entries = [];
    private int _inCount;
    private int _outCount;
    private decimal _net;
    private int _limit = 100;
    private int? _accountId;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpCashEntryDigest? _openedEntry;
    private ErpCashEntryDetail? _openedDetail;
    private IReadOnlyList<ErpCashEntryDigest> _openedSiblings = [];

    private bool OpenedFound => _openedDetail is not null || _openedEntry is not null;

    private string OpenedReturnHref => _openedId > 0
        ? "/erp/cash-entries-app?entry_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : "/erp/cash-entries-app";

    private string OpenedCaption => _openedDetail is not null
        ? (string.IsNullOrWhiteSpace(_openedDetail.Reference) ? ("Cash entry #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.Reference)
            + (string.IsNullOrWhiteSpace(_openedDetail.EntryType) ? "" : (" · " + _openedDetail.EntryType))
        : _openedEntry is null
            ? ""
            : (string.IsNullOrWhiteSpace(_openedEntry.Reference) ? $"Cash entry #{_openedEntry.Id}" : _openedEntry.Reference);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("erp"))
        {
            return; // guest browse — Sign in for live data
        }

        if (ctx.Request.Query.TryGetValue("limit", out var limitRaw)
            && int.TryParse(limitRaw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsedLimit)
            && parsedLimit > 0)
        {
            _limit = Math.Min(parsedLimit, 500);
        }

        if (ctx.Request.Query.TryGetValue("account_id", out var accountRaw)
            && int.TryParse(accountRaw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsedAccount)
            && parsedAccount > 0)
        {
            _accountId = parsedAccount;
        }

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "entry_id");

        _isAdmin = true;
        var result = await Dashboards.ListErpCashEntriesAsync(_accountId, _limit, ctx.RequestAborted);
        _entries = result.Entries;
        _openedEntry = _openedId > 0 ? _entries.FirstOrDefault(e => e.Id == _openedId) : null;
        if (_openedEntry is not null)
        {
            _entries = new[] { _openedEntry }.Concat(_entries.Where(e => e.Id != _openedId)).ToList();
        }
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpCashEntryDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Entry;
            _openedSiblings = detail.Siblings;
            if (_openedDetail is null && !string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
        _inCount = _entries.Count(e => e.Direction == 1);
        _outCount = _entries.Count(e => e.Direction != 1);
        _net = _entries.Sum(e => e.Direction == 1 ? e.Amount : -e.Amount);
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }

    private static string FormatDirection(int direction) => direction == 1 ? "in" : "out";
}
