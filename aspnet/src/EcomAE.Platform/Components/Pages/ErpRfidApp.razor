@page "/erp/rfid-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>RFID · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="RFID" BreadcrumbArea="Inventory" BreadcrumbTab="RFID">
    <PhpErpModulePageHeader Title="RFID registry" Subtitle="Tagged inventory and scan sessions. Register and scan stay on ERP ajax." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="RFID KPIs">
        <div class="kpi"><div class="lbl">Tags</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Sessions</div><div class="val">@_sessionCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <h2 style="font-size:16px;">Tags</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>EPC</th><th>SKU</th><th>Item</th><th>WH</th><th>Zone</th><th>Status</th><th>Last scan</th></tr></thead>
            <tbody>
                @if (_tags.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No RFID tags yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _tags)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(row.RfidEpc) ? "—" : row.RfidEpc)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Sku) ? "—" : row.Sku)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.ItemDescription) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.ItemDescription)</strong></td>
                            <td>@(row.WarehouseId > 0 ? row.WarehouseId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.LocationZone) ? "—" : row.LocationZone)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td>@(string.IsNullOrWhiteSpace(row.LastScannedAt) ? "—" : row.LastScannedAt)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="font-size:16px;">Scan sessions</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Type</th><th>Zone</th><th class="text-right">Scanned</th><th class="text-right">Expected</th><th class="text-right">Found</th><th class="text-right">Missing</th><th>Status</th><th>By</th></tr></thead>
            <tbody>
                @if (_sessions.Count == 0) { <tr><td colspan="8">No scan sessions yet.</td></tr> }
                else
                {
                    @foreach (var row in _sessions)
                    {
                        <tr>
                            <td>@row.SessionType</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Zone) ? "—" : row.Zone)</td>
                            <td class="text-right">@row.TotalScanned.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.TotalExpected.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.TotalFound.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.TotalMissing.ToString(CultureInfo.InvariantCulture)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td>@(string.IsNullOrWhiteSpace(row.ScannedByName) ? "—" : row.ScannedByName)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Register/scan writes stay on ERP ajax.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=inventory&tab=rfid";
    private bool _isAdmin;
    private IReadOnlyList<ErpRfidTagDigest> _tags = [];
    private IReadOnlyList<ErpRfidSessionDigest> _sessions = [];
    private int _count, _active, _sessionCount;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpRfidDigestAsync(200, ctx.RequestAborted);
        _tags = result.Tags;
        _sessions = result.Sessions;
        _count = result.Count;
        _active = result.ActiveTagCount;
        _sessionCount = result.SessionCount;
        _source = result.Source;
        _message = result.Message;
    }
}
