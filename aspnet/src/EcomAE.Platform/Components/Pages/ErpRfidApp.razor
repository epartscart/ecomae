@page "/erp/rfid-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>RFID · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="RFID" BreadcrumbArea="Inventory" BreadcrumbTab="RFID">
    <PhpErpModulePageHeader Title="RFID System" Subtitle="RFID-based inventory management — tag products, bulk scan for stocktaking, real-time tracking, and anti-theft gates." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    <ErpPhpFlash Ok="@_ok" Err="@_err" />

    <div class="epc-erp-section">
        <h4><i class="fa fa-tags"></i> RFID tag management</h4>
        <p class="text-muted">Each product gets a unique RFID tag (UHF or HF). Tags link to the product barcode/SKU in the system.</p>
        <div class="epc-erp-kpi epc-erp-stat-row" aria-label="RFID KPIs">
            <div class="kpi"><div class="lbl">Tagged items</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Active tags</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Missing (alert)</div><div class="val">@_missing.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Scan sessions</div><div class="val">@_sessionCount.ToString(CultureInfo.InvariantCulture)</div></div>
        </div>
    </div>

    <div class="epc-erp-section">
        <h4><i class="fa fa-search"></i> RFID scanner</h4>
        <div class="panel panel-default" style="background:#f0f9ff;border:2px dashed #3b82f6;border-radius:8px;padding:24px;text-align:center;">
            <i class="fa fa-wifi fa-3x" style="color:#3b82f6;margin-bottom:12px;" aria-hidden="true"></i>
            <h5>RFID bulk scan mode</h5>
            <p class="text-muted">Connect handheld reader or fixed gate. Scan results appear automatically when the shop database is bound.</p>
            <form method="get" action="/erp/rfid-app" style="display:inline-block;margin:0 6px;">
                <input type="hidden" name="scan" value="1" />
                <button type="submit" class="btn btn-primary"><i class="fa fa-play"></i> Start scanning</button>
            </form>
            <a class="btn btn-default" href="/erp/rfid-app#recent-scans"><i class="fa fa-list"></i> Last scan results</a>
        </div>
    </div>

    <div class="epc-erp-section" id="recent-scans">
        <h4><i class="fa fa-list"></i> Recent scans</h4>
        <div class="epc-erp-table-wrap">
            <table class="table table-bordered table-condensed table-epc epc-erp-table" style="font-size:13px;">
                <thead><tr><th>Date/time</th><th>Location</th><th>Scanned</th><th>Expected</th><th>Discrepancy</th><th>Duration</th><th></th></tr></thead>
                <tbody>
                    @if (_sessions.Count == 0)
                    {
                        <tr><td colspan="7" class="text-muted">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No scan sessions yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                    }
                    else
                    {
                        @foreach (var row in _sessions)
                        {
                            var disc = row.TotalScanned - row.TotalExpected;
                            <tr>
                                <td>@(row.TimeStarted > 0 ? DateTimeOffset.FromUnixTimeSeconds(row.TimeStarted).UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) : "—")</td>
                                <td>@(string.IsNullOrWhiteSpace(row.Zone) ? "—" : row.Zone)</td>
                                <td>@row.TotalScanned.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@row.TotalExpected.ToString(CultureInfo.InvariantCulture)</td>
                                <td>
                                    @if (disc < 0) { <span class="text-danger">@disc.ToString(CultureInfo.InvariantCulture) items</span> }
                                    else { <span class="text-success">0</span> }
                                </td>
                                <td>—</td>
                                <td><a class="btn btn-xs btn-default" href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Details</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <h2 style="font-size:16px;">Tags</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>EPC</th><th>SKU</th><th>Item</th><th>WH</th><th>Zone</th><th>Status</th><th>Last scan</th></tr></thead>
            <tbody>
                @if (_tags.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No RFID tags yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _tags)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(row.RfidEpc) ? "—" : row.RfidEpc)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Sku) ? "—" : row.Sku)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.ItemDescription) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.ItemDescription)</strong></td>
                            <td>@(row.WarehouseId > 0 ? row.WarehouseId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.LocationZone) ? "—" : row.LocationZone)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td>@(string.IsNullOrWhiteSpace(row.LastScannedAt) ? "—" : row.LastScannedAt)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-section">
        <h4><i class="fa fa-cog"></i> RFID configuration</h4>
        <form method="get" action="/erp/rfid-app" class="pm-fields" style="display:flex;flex-wrap:wrap;gap:12px;align-items:end;">
            <div class="pm-field"><label>Tag type</label>
                <select class="form-control input-sm" name="tag_type">
                    <option>UHF (long range, 1-10m)</option>
                    <option>HF/NFC (short range, 1-10cm)</option>
                </select>
            </div>
            <div class="pm-field"><label>Reader hardware</label>
                <select class="form-control input-sm" name="reader">
                    <option>Zebra FX7500</option>
                    <option>Impinj Speedway</option>
                    <option>ThingMagic M6e</option>
                    <option>Custom / Generic</option>
                </select>
            </div>
            <div class="pm-field"><label>Anti-theft gate</label>
                <select class="form-control input-sm" name="gate">
                    <option value="1">Enabled — alarm on uncleared items</option>
                    <option value="0">Disabled</option>
                </select>
            </div>
            <div class="pm-field"><label>Auto-scan schedule</label>
                <select class="form-control input-sm" name="schedule">
                    <option>Morning open + Evening close</option>
                    <option>Every hour</option>
                    <option>Manual only</option>
                </select>
            </div>
            <div class="pm-field"><label>Alert threshold</label>
                <select class="form-control input-sm" name="threshold">
                    <option>Any discrepancy</option>
                    <option>2+ items</option>
                    <option>5+ items</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Apply layout</button>
        </form>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. KPI values are live digest counts (0 when the shop database is empty). Register/scan writes stay on ERP ajax.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=inventory&tab=rfid";
    private bool _isAdmin;
    private IReadOnlyList<ErpRfidTagDigest> _tags = [];
    private IReadOnlyList<ErpRfidSessionDigest> _sessions = [];
    private int _count, _active, _sessionCount, _missing;
    private string _source = "n/a";
    private string _message = "";
    private string _ok = "";
    private string _err = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _ok = ctx.Request.Query["ok"].ToString();
        _err = ctx.Request.Query["err"].ToString();
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpRfidDigestAsync(200, ctx.RequestAborted);
        _tags = result.Tags;
        _sessions = result.Sessions;
        _count = result.Count;
        _active = result.ActiveTagCount;
        _sessionCount = result.SessionCount;
        _missing = _sessions.Sum(s => s.TotalMissing);
        _source = result.Source;
        _message = result.Message;
    }
}
