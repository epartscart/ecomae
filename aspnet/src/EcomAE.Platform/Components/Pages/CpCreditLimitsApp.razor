@page "/cp/credit-limits-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Credit limits · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Credit limits
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/credit-limits-app")</p>
                <p>Open a row for the 280-character notes excerpt. Set a customer credit limit here.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/credit-limits-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (!string.IsNullOrWhiteSpace(_flash))
    {
        <p class="epc-w16-note" style="@(_flashOk ? "background:#ecfdf5;border-color:#a7f3d0;color:#065f46" : "background:#fffbeb;border-color:#fde68a;color:#92400e")">@_flash</p>
    }

    @if (_isAdmin)
    {
        <form method="post" action="/cp/credit-limits/set" style="margin:0 0 1rem;padding:.85rem .9rem;background:#fff;border:1px solid #e2e8f0;border-radius:.55rem;display:flex;gap:.55rem;flex-wrap:wrap;align-items:end">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@ReturnHref" />
            <label>Site <input name="siteKey" value="epartscart" required style="display:block;margin-top:.25rem" /></label>
            <label>Customer id <input type="number" name="customerId" min="1" required style="display:block;margin-top:.25rem;width:7rem" /></label>
            <label>Limit <input type="number" name="limit" min="0" step="0.01" required style="display:block;margin-top:.25rem;width:7rem" /></label>
            <label>Currency <input name="currency" value="AED" maxlength="8" style="display:block;margin-top:.25rem;width:5rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save limit</button>
        </form>
    }

    @if (!string.IsNullOrWhiteSpace(_flash))
    {
        <p class="epc-w16-note" style="@(_flashOk ? "background:#ecfdf5;border-color:#a7f3d0;color:#065f46" : "background:#fffbeb;border-color:#fde68a;color:#92400e")">@_flash</p>
    }

    @if (_isAdmin)
    {
        <form method="post" action="/cp/credit-limits/set" style="margin:0 0 1rem;padding:.85rem .9rem;background:#fff;border:1px solid #e2e8f0;border-radius:.55rem;display:flex;gap:.55rem;flex-wrap:wrap;align-items:end">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@ReturnHref" />
            <label>Site <input name="siteKey" value="epartscart" required style="display:block;margin-top:.25rem" /></label>
            <label>Customer id <input type="number" name="customerId" min="1" required style="display:block;margin-top:.25rem;width:7rem" /></label>
            <label>Limit <input type="number" name="limit" min="0" step="0.01" required style="display:block;margin-top:.25rem;width:7rem" /></label>
            <label>Currency <input name="currency" value="AED" maxlength="8" style="display:block;margin-top:.25rem;width:5rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save limit</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Credit limit KPIs">
        <div class="kpi"><div class="lbl">Limits</div><div class="val">@_summary.LimitCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_summary.ActiveCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Held</div><div class="val">@_summary.HeldCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Txns</div><div class="val">@_summary.TxnCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @OpenedCaption
                    <a class="btn btn-xs btn-default pull-right" href="@_listHref">Close</a>
                </div>
                <div class="panel-body">
                    <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                        <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Site</dt><dd>@(string.IsNullOrWhiteSpace(_opened.SiteKey) ? "—" : _opened.SiteKey)</dd>
                        <dt>Customer</dt><dd>@_opened.CustomerId.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Limit</dt><dd>@_opened.CreditLimit.ToString(CultureInfo.InvariantCulture) @_opened.Currency</dd>
                        <dt>Used</dt><dd>@_opened.BalanceUsed.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Status) ? "—" : _opened.Status)</dd>
                        <dt>Terms</dt><dd>@(string.IsNullOrWhiteSpace(_opened.PaymentTerms) ? "—" : _opened.PaymentTerms)</dd>
                        <dt>Risk</dt><dd>@_opened.RiskScore.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Approved by</dt><dd>@_opened.ApprovedBy.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Last review</dt><dd>@(string.IsNullOrWhiteSpace(_opened.LastReview) ? "—" : _opened.LastReview)</dd>
                        <dt>Next review</dt><dd>@(string.IsNullOrWhiteSpace(_opened.NextReview) ? "—" : _opened.NextReview)</dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(_opened.HoldReasonExcerpt))
                    {
                        <p style="margin:.85rem 0 0"><strong>Hold reason</strong></p>
                        <pre style="max-height:8rem;overflow:auto;white-space:pre-wrap;margin:.35rem 0 0">@_opened.HoldReasonExcerpt</pre>
                    }
                    @if (!string.IsNullOrWhiteSpace(_opened.NotesExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:.85rem 0 0">@_opened.NotesExcerpt</pre>
                        @if (_opened.NotesLen > _opened.NotesExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_opened.NotesExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NotesLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted" style="margin:.85rem 0 0">No notes excerpt yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Same status</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Customer</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="4">No same-status siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@sib.CustomerId.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                            <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "credit_id", sib.Id)">Open</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Site</th>
                    <th>Customer</th>
                    <th>Limit</th>
                    <th>Used</th>
                    <th>Currency</th>
                    <th>Status</th>
                    <th>Risk</th>
                    <th></th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!_isAdmin)
            {
                <tr><td colspan="10">Sign in for live data.</td></tr>
            }
            else if (_rows.Count == 0)
            {
                <tr><td colspan="10">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.SiteKey) ? row.SiteKey : "—")</td>
                            <td>@row.CustomerId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CreditLimit.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.BalanceUsed.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Currency) ? row.Currency : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@row.RiskScore.ToString(CultureInfo.InvariantCulture)</td>
                            <td>
                                <form method="post" action="/cp/credit-limits/set" style="display:flex;gap:.3rem;align-items:center;margin:0">
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="@ReturnHref" />
                                    <input type="hidden" name="siteKey" value="@row.SiteKey" />
                                    <input type="hidden" name="customerId" value="@row.CustomerId.ToString(CultureInfo.InvariantCulture)" />
                                    <input type="hidden" name="currency" value="@row.Currency" />
                                    <input type="number" name="limit" min="0" step="0.01" value="@row.CreditLimit.ToString(CultureInfo.InvariantCulture)" style="width:6rem" />
                                    <button type="submit" class="btn btn-xs btn-default">Save</button>
                                </form>
                            </td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "credit_id", row.Id)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/epc_credit_limit";
    private bool _isAdmin;
    private CpCreditLimitsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpCreditLimitsLimitDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flash = "";
    private bool _flashOk;
    private string _listHref = "/cp/credit-limits-app";
    private long _openedId;
    private CpCreditLimitsDetail? _opened;
    private IReadOnlyList<CpCreditLimitsLimitDigest> _openedSiblings = [];

    private string OpenedCaption =>
        _opened is null
            ? ""
            : ("Customer #" + _opened.CustomerId.ToString(CultureInfo.InvariantCulture));

    private string ReturnHref =>
        _openedId > 0
            ? _listHref + "?credit_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
            : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "credit_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var ok = ctx.Request.Query["ok"].ToString();
        var err = ctx.Request.Query["err"].ToString();
        if (!string.IsNullOrWhiteSpace(ok)) { _flash = ok; _flashOk = true; }
        else if (!string.IsNullOrWhiteSpace(err)) { _flash = err; _flashOk = false; }

        var result = await Dashboards.BuildCpCreditLimitsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Limits;
        _source = result.Source;
        _message = result.Message;
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpCreditLimitsDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Limit;
            _openedSiblings = detail.Siblings;
        }
    }
}
