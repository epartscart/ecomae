@page "/cp/ai-service-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>AI service · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-ai-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-ai-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-ai-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-ai-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-ai-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f172a; background:#fff;
        }
        .epc-ai-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-ai-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-ai-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-ai-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-ai-kpi span { color:#64748b; font-size:.78rem; }
        .epc-ai-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-ai-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-ai-table th, .epc-ai-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-ai-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-ai-note { margin-top:1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:.45rem; color:#334155; font-size:.86rem; }
        @@media (max-width:900px){ .epc-ai-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-ai-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>AI service</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-ai-cta">
            <a href="@_phpTab">Open module</a>
        </div>
    </section>

    <div class="epc-ai-kpis" aria-label="AI service stats">
        <div class="epc-ai-kpi"><strong>@_summary.QueryCount.ToString(CultureInfo.InvariantCulture)</strong><span>Queries</span></div>
        <div class="epc-ai-kpi"><strong>@_summary.SuccessCount.ToString(CultureInfo.InvariantCulture)</strong><span>Success</span></div>
        <div class="epc-ai-kpi"><strong>@_summary.BlockedCount.ToString(CultureInfo.InvariantCulture)</strong><span>Blocked</span></div>
        <div class="epc-ai-kpi"><strong>@_summary.ProviderCount.ToString(CultureInfo.InvariantCulture)</strong><span>Providers</span></div>
    </div>

    <div class="epc-ai-table-wrap">
        <table class="epc-ai-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Service</th>
                    <th>Intent</th>
                    <th>Status</th>
                    <th>Tokens</th>
                    <th>Ms</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="8">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Service) ? row.Service : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Intent) ? row.Intent : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@row.TokensUsed.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.ExecutionMs.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CreatedAt) ? row.CreatedAt : "—")</td>
                            <td><a href="@_phpTab">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/general_pages/epc_ai_service";
    private bool _isAdmin;
    private CpAiServiceSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpAiServiceQueryDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpAiServiceDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Queries;
        _source = result.Source;
        _message = result.Message;
    }
}
