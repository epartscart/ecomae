@page "/erp/inventory-stock-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Inventory Stock · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Inventory Stock" BreadcrumbArea="Inventory & Fulfilment" BreadcrumbTab="Stock">
    <PhpParityModuleBody AppPath="/erp/inventory-stock-app" IsAdmin="_isAdmin" />


    
    <PhpErpModulePageHeader Title="Inventory Stock" Subtitle="Create warehouse/item, sync from shop storages, set reorder, record movement, transfer, run a closing snapshot, import csv_text, or save dimension links. File CSV upload stays Classic." />
    <PhpErpD365ActionPane RefreshHref="/erp/inventory-stock-app" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 12px;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 12px;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/ajax/inv-set-reorder-level" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <label>Item id <input type="number" name="itemId" min="1" required style="width:6rem" /></label>
            <label>Reorder level <input type="text" name="reorderLevel" required /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save reorder level</button>
        </form>
        <form method="post" action="/erp/ajax/inv-record-movement" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <label>Warehouse id <input type="number" name="warehouseId" min="1" required style="width:6rem" /></label>
            <label>Item id <input type="number" name="itemId" min="1" required style="width:6rem" /></label>
            <label>Qty <input type="text" name="qty" required /></label>
            <label>Unit cost <input type="text" name="unitCost" /></label>
            <label>Type
                <select name="movementType">
                    <option value="adjustment">adjustment</option>
                    <option value="opening">opening</option>
                    <option value="purchase_in">purchase_in</option>
                    <option value="return_in">return_in</option>
                    <option value="sale_out">sale_out</option>
                </select>
            </label>
            <label>Reference <input type="text" name="reference" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Record movement</button>
        </form>
        <form method="post" action="/erp/ajax/inv-transfer" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <label>From warehouse <input type="number" name="fromWarehouseId" min="1" required style="width:6rem" /></label>
            <label>To warehouse <input type="number" name="toWarehouseId" min="1" required style="width:6rem" /></label>
            <label>Item id <input type="number" name="itemId" min="1" required style="width:6rem" /></label>
            <label>Qty <input type="text" name="qty" required /></label>
            <label>Reference <input type="text" name="reference" /></label>
            <button type="submit" class="btn btn-sm btn-default">Transfer stock</button>
        </form>
        <form method="post" action="/erp/ajax/inv-create-warehouse" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <label>Code <input type="text" name="code" required maxlength="32" /></label>
            <label>Name <input type="text" name="name" required maxlength="255" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Create warehouse</button>
        </form>
        <form method="post" action="/erp/ajax/inv-create-item" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <label>SKU <input type="text" name="sku" required maxlength="64" /></label>
            <label>Name <input type="text" name="name" required maxlength="255" /></label>
            <label>Type
                <select name="itemType">
                    <option value="standard">standard</option>
                    <option value="perishable">perishable</option>
                    <option value="serialized">serialized</option>
                </select>
            </label>
            <label>Unit <input type="text" name="unit" value="pcs" maxlength="16" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Create item</button>
        </form>
        <form method="post" action="/erp/ajax/inv-sync-warehouses" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <button type="submit" class="btn btn-sm btn-default">Sync warehouses</button>
        </form>
        <form method="post" action="/erp/ajax/inv-run-closing" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <label>Period end <input type="text" name="periodEnd" placeholder="YYYY-MM-DD" /></label>
            <label>Warehouse id <input type="number" name="warehouseId" min="0" style="width:6rem" /></label>
            <button type="submit" class="btn btn-sm btn-default">Run closing</button>
        </form>
        <form method="post" action="/erp/ajax/inv-import-csv" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <label>Warehouse id <input type="number" name="warehouseId" min="0" style="width:6rem" /></label>
            <label>Default type <input type="text" name="defaultMovementType" value="purchase_in" /></label>
            <label>CSV text <textarea name="csvText" rows="3" cols="48" placeholder="sku,qty,unit_cost,movement_type,warehouse_code"></textarea></label>
            <button type="submit" class="btn btn-sm btn-primary">Import CSV text</button>
        </form>
        <form method="post" action="/erp/ajax/dim-save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <label>Entity type <input type="text" name="entityType" value="inventory_item" required /></label>
            <label>Entity id <input type="number" name="entityId" min="1" required style="width:6rem" /></label>
            <label>Business unit <input type="number" name="dim[business_unit]" min="0" style="width:6rem" /></label>
            <label>Legal entity <input type="number" name="dim[legal_entity]" min="0" style="width:6rem" /></label>
            <label>Class <input type="number" name="dim[class_unit]" min="0" style="width:6rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save dimensions</button>
        </form>
    }


    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Inventory stock KPIs">
        <div class="kpi"><div class="lbl">Stock rows</div><div class="val">@_summary.RowCount.ToString("N0", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Qty on hand</div><div class="val">@_summary.QtyOnHand.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Stock value</div><div class="val">@_summary.StockValue.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Warehouses</div><div class="val">@_summary.WarehouseCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Items</div><div class="val">@_summary.ItemCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Warehouse</th>
                    <th>SKU</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Unit</th>
                    <th>Qty</th>
                    <th>Avg cost</th>
                    <th>Batch</th>
                    <th>Variant</th>
                    <th>Expiry</th>
                </tr>
            </thead>
            <tbody>
                @if (_stock.Count == 0)
                {
                    <tr><td colspan="10">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _stock)
                    {
                        <tr>
                            <td>@row.WarehouseName</td>
                            <td>@row.Sku</td>
                            <td>@row.Name</td>
                            <td>@row.ItemType</td>
                            <td>@row.Unit</td>
                            <td>@row.QtyOnHand.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@row.AvgUnitCost.ToString("N4", CultureInfo.InvariantCulture)</td>
                            <td>@row.BatchNo</td>
                            <td>@row.VariantLabel</td>
                            <td>@row.ExpiryDate</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="margin:1.2rem 0 .5rem;font-size:1rem;">Low stock (reorder)</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Warehouse</th><th>SKU</th><th>Name</th><th>Qty</th><th>Reorder</th><th>Avg cost</th><th></th>
                </tr>
            </thead>
            <tbody>
                @if (_lowStock.Count == 0)
                {
                    <tr><td colspan="7">No low-stock lines.</td></tr>
                }
                else
                {
                    @foreach (var row in _lowStock)
                    {
                        <tr>
                            <td>@row.WarehouseName</td>
                            <td>@row.Sku</td>
                            <td>@row.Name</td>
                            <td>@row.QtyOnHand.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@row.ReorderLevel.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@row.AvgUnitCost.ToString("N4", CultureInfo.InvariantCulture)</td>
                            <td>
                                @if (_isAdmin)
                                {
                                    <form method="post" action="/erp/ajax/inv-set-reorder-level" style="display:flex;gap:.3rem;align-items:center;margin:0">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
                                        <input type="hidden" name="itemId" value="@row.ItemId.ToString(CultureInfo.InvariantCulture)" />
                                        <input type="text" name="reorderLevel" value="@row.ReorderLevel.ToString(CultureInfo.InvariantCulture)" style="width:5rem" />
                                        <button type="submit" class="btn btn-xs btn-default">Save</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_summary.Source. Showing @_stock.Count.ToString(CultureInfo.InvariantCulture) of @_summary.RowCount.ToString(CultureInfo.InvariantCulture) rows;
        @_lowStock.Count.ToString(CultureInfo.InvariantCulture) low-stock alerts.
        Movements, transfers, closing, and csv_text import stay on ERP ajax. File CSV upload stays Classic.
        @if (!string.IsNullOrWhiteSpace(_summary.Message)) { <span> @_summary.Message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private ErpInventoryStockSummaryResult _summary = new(0, 0m, 0m, 0, 0, "migration", string.Empty);
    private IReadOnlyList<ErpInventoryStockDigest> _stock = [];
    private IReadOnlyList<ErpInventoryLowStockDigest> _lowStock = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildErpInventoryStockDigestAsync(200, null, ctx.RequestAborted);
        _summary = result.Summary;
        _stock = result.Stock;
        _lowStock = result.LowStock;
        _message = result.Message;
    }
}
