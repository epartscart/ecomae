@page "/erp/inventory-stock-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Inventory Stock · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<HeadContent>
<style>
        .epc-inv-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#1d4ed8 45%,#2563eb 100%);
        }
        .epc-inv-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-inv-hero p { margin:0; color:#bbf7d0; max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-inv-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-inv-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#14532d; background:#dbeafe;
        }
        .epc-inv-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-inv-kpis { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-inv-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-inv-kpi strong { display:block; font-size:1.25rem; font-variant-numeric:tabular-nums; word-break:break-all; }
        .epc-inv-kpi span { color:#64748b; font-size:.78rem; }
        .epc-inv-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-inv-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-inv-table th, .epc-inv-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-inv-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-inv-note { margin-top:1rem; padding:.75rem .9rem; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:.45rem; color:#14532d; font-size:.86rem; }
        @@media (max-width:1100px){ .epc-inv-kpis{grid-template-columns:1fr 1fr;} }
        @@media (max-width:700px){ .epc-inv-kpis{grid-template-columns:1fr;} }
    
</style>
</HeadContent>


<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Inventory Stock" BreadcrumbArea="Inventory & Fulfilment" BreadcrumbTab="Stock">

    <section class="epc-inv-hero">
        <img src="@LegacyPresentationAssets.EpartsCartMarkUrl" alt="ECOM AE" style="height:28px;filter:brightness(1.1)" />
        <h1>Inventory Stock</h1>
        <p>On-hand stock by warehouse for this company. Open movements for ledger detail.</p>
        <div class="epc-inv-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open inventory</a>
            <a class="ghost" href="/erp/warehouses-app">Warehouses</a>
            <a class="ghost" href="/erp/stock-movements-app">Stock movements</a>
            <a class="ghost" href="/erp/app">ERP dashboard</a>
        </div>
    </section>

    <div class="epc-inv-kpis" aria-label="Inventory stock KPIs">
        <div class="epc-inv-kpi"><strong>@_summary.RowCount.ToString("N0", CultureInfo.InvariantCulture)</strong><span>Stock rows</span></div>
        <div class="epc-inv-kpi"><strong>@_summary.QtyOnHand.ToString("N2", CultureInfo.InvariantCulture)</strong><span>Qty on hand</span></div>
        <div class="epc-inv-kpi"><strong>@_summary.StockValue.ToString("N2", CultureInfo.InvariantCulture)</strong><span>Stock value</span></div>
        <div class="epc-inv-kpi"><strong>@_summary.WarehouseCount.ToString(CultureInfo.InvariantCulture)</strong><span>Warehouses</span></div>
        <div class="epc-inv-kpi"><strong>@_summary.ItemCount.ToString(CultureInfo.InvariantCulture)</strong><span>Items</span></div>
    </div>

    <div class="epc-inv-table-wrap">
        <table class="epc-inv-table">
            <thead>
                <tr>
                    <th>Warehouse</th>
                    <th>SKU</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Unit</th>
                    <th>Qty</th>
                    <th>Avg cost</th>
                    <th>Batch</th>
                    <th>Variant</th>
                    <th>Expiry</th>
                </tr>
            </thead>
            <tbody>
                @if (_stock.Count == 0)
                {
                    <tr><td colspan="10">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _stock)
                    {
                        <tr>
                            <td>@row.WarehouseName</td>
                            <td>@row.Sku</td>
                            <td>@row.Name</td>
                            <td>@row.ItemType</td>
                            <td>@row.Unit</td>
                            <td>@row.QtyOnHand.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@row.AvgUnitCost.ToString("N4", CultureInfo.InvariantCulture)</td>
                            <td>@row.BatchNo</td>
                            <td>@row.VariantLabel</td>
                            <td>@row.ExpiryDate</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="margin:1.2rem 0 .5rem;font-size:1rem;">Low stock (reorder)</h2>
    <div class="epc-inv-table-wrap">
        <table class="epc-inv-table">
            <thead>
                <tr>
                    <th>Warehouse</th><th>SKU</th><th>Name</th><th>Qty</th><th>Reorder</th><th>Avg cost</th>
                </tr>
            </thead>
            <tbody>
                @if (_lowStock.Count == 0)
                {
                    <tr><td colspan="6">No low-stock lines.</td></tr>
                }
                else
                {
                    @foreach (var row in _lowStock)
                    {
                        <tr>
                            <td>@row.WarehouseName</td>
                            <td>@row.Sku</td>
                            <td>@row.Name</td>
                            <td>@row.QtyOnHand.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@row.ReorderLevel.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@row.AvgUnitCost.ToString("N4", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-inv-note">
        Source: @_summary.Source. Showing @_stock.Count.ToString(CultureInfo.InvariantCulture) of @_summary.RowCount.ToString(CultureInfo.InvariantCulture) rows;
        @_lowStock.Count.ToString(CultureInfo.InvariantCulture) low-stock alerts.
        PHP <code>epc_erp_inventory.php</code> remains authoritative for movements, transfers, and closing.
        @if (!string.IsNullOrWhiteSpace(_summary.Message)) { <span> @_summary.Message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=inventory_mgmt&tab=inventory";
    private bool _isAdmin;
    private ErpInventoryStockSummaryResult _summary = new(0, 0m, 0m, 0, 0, "migration", string.Empty);
    private IReadOnlyList<ErpInventoryStockDigest> _stock = [];
    private IReadOnlyList<ErpInventoryLowStockDigest> _lowStock = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildErpInventoryStockDigestAsync(200, null, ctx.RequestAborted);
        _summary = result.Summary;
        _stock = result.Stock;
        _lowStock = result.LowStock;
    }
}
