@page "/erp/inventory-stock-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject IErpDimensionCatalogReadService DimensionCatalog
@inject IErpDimensionLinkReadService DimensionLinks
@inject IErpWriteConnectionFactory TenantDb
@inject IErpInventoryReservationWriteService Reservations

<PageTitle>Inventory Stock · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Inventory Stock" BreadcrumbArea="Inventory & Fulfilment" BreadcrumbTab="Stock">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/inventory-stock-app" IsAdmin="_isAdmin" />


    
    <PhpErpModulePageHeader Title="Inventory Stock" Subtitle="Create warehouse/item, sync from shop storages, set reorder, record movement, transfer, run a closing snapshot, import csv_text, or save dimension links. File CSV upload is not available on this page." />
    <PhpErpD365ActionPane RefreshHref="/erp/inventory-stock-app" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 12px;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 12px;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/ajax/inv-set-reorder-level" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <ErpMasterPicker Kind="item" FieldName="itemId" InputId="inv-reorder-item" Label="Item" Required="true" Min="1" />
            <label>Reorder level <input type="text" name="reorderLevel" required /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save reorder level</button>
        </form>
        <form method="post" action="/erp/ajax/inv-record-movement" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <ErpMasterPicker Kind="warehouse" FieldName="warehouseId" InputId="inv-move-wh" Label="Warehouse" Required="true" Min="1" />
            <ErpMasterPicker Kind="item" FieldName="itemId" InputId="inv-move-item" Label="Item" Required="true" Min="1" />
            <label>Qty <input type="text" name="qty" required /></label>
            <label>Unit cost <input type="text" name="unitCost" /></label>
            <label>Type
                <select name="movementType">
                    <option value="adjustment">adjustment</option>
                    <option value="opening">opening</option>
                    <option value="purchase_in">purchase_in</option>
                    <option value="return_in">return_in</option>
                    <option value="sale_out">sale_out</option>
                </select>
            </label>
            <label>Reference <input type="text" name="reference" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Record movement</button>
            <div id="mv_on_hand_hint" class="muted" style="width:100%;font-size:.8rem;"></div>
        </form>
        <form method="post" action="/erp/ajax/inv-transfer" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <ErpMasterPicker Kind="warehouse" FieldName="fromWarehouseId" InputId="inv-xfer-from" Label="From warehouse" Required="true" Min="1" />
            <ErpMasterPicker Kind="warehouse" FieldName="toWarehouseId" InputId="inv-xfer-to" Label="To warehouse" Required="true" Min="1" />
            <ErpMasterPicker Kind="item" FieldName="itemId" InputId="inv-xfer-item" Label="Item" Required="true" Min="1" />
            <label>Qty <input type="text" name="qty" required /></label>
            <label>Reference <input type="text" name="reference" /></label>
            <button type="submit" class="btn btn-sm btn-default">Transfer stock</button>
            <div id="tf_on_hand_hint" class="muted" style="width:100%;font-size:.8rem;"></div>
        </form>
        <form method="post" action="/erp/ajax/inv-create-warehouse" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <label>Code <input type="text" name="code" required maxlength="32" /></label>
            <label>Name <input type="text" name="name" required maxlength="255" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Create warehouse</button>
        </form>
        <form method="post" action="/erp/ajax/inv-create-item" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <label>SKU <input type="text" name="sku" required maxlength="64" /></label>
            <label>Name <input type="text" name="name" required maxlength="255" /></label>
            <label>Type
                <select name="itemType">
                    <option value="standard">standard</option>
                    <option value="perishable">perishable</option>
                    <option value="serialized">serialized</option>
                </select>
            </label>
            <label>Unit <input type="text" name="unit" value="pcs" maxlength="16" /></label>
            @if (_pimFormHtml.Length > 0)
            {
                <div style="flex-basis:100%;max-width:640px;">
                    <h5 style="margin:6px 0;"><i class="fa fa-tags"></i> PIM custom attributes</h5>
                    @((MarkupString)_pimFormHtml)
                </div>
            }
            <button type="submit" class="btn btn-sm btn-primary">Create item</button>
        </form>
        <form method="post" action="/erp/ajax/inv-sync-warehouses" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <button type="submit" class="btn btn-sm btn-default">Sync warehouses</button>
        </form>
        <form method="post" action="/erp/ajax/inv-run-closing" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <label>Period end <input type="text" name="periodEnd" placeholder="YYYY-MM-DD" /></label>
            <ErpMasterPicker Kind="warehouse" FieldName="warehouseId" InputId="inv-close-wh" Label="Warehouse" />
            <button type="submit" class="btn btn-sm btn-default">Run closing</button>
        </form>
        <form method="post" action="/erp/ajax/inv-import-csv" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <ErpMasterPicker Kind="warehouse" FieldName="warehouseId" InputId="inv-import-wh" Label="Warehouse" />
            <label>Default type <input type="text" name="defaultMovementType" value="purchase_in" /></label>
            <label>CSV text <textarea name="csvText" rows="3" cols="48" placeholder="sku,qty,unit_cost,movement_type,warehouse_code"></textarea></label>
            <button type="submit" class="btn btn-sm btn-primary">Import CSV text</button>
        </form>
        <form method="post" action="/erp/ajax/dim-save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
            <label>Entity type <input type="text" name="entityType" value="@_dimensionEntityType" required /></label>
            <label>Entity id <input type="number" name="entityId" value="@(_dimensionEntityId > 0 ? _dimensionEntityId.ToString(CultureInfo.InvariantCulture) : string.Empty)" min="1" required style="width:6rem" /></label>
            @if (_dimensionCatalog.Count == 0)
            {
                <ErpMasterPicker Kind="business_unit" FieldName="dim[business_unit]" Label="Business unit" InputId="inv-dim-bu" />
                <label>Legal entity <input type="number" name="dim[legal_entity]" min="0" style="width:6rem" /></label>
                <label>Class <input type="number" name="dim[class_unit]" min="0" style="width:6rem" /></label>
            }
            else
            {
                @foreach (var dimension in _dimensionCatalog)
                {
                    <label>@dimension.Label
                        <select name="dim[@dimension.Key]" style="min-width:10rem">
                            <option value="0">— none —</option>
                            @foreach (var option in dimension.Options)
                            {
                                <option value="@option.Id" selected="@IsDimensionSelected(dimension.Key, option.Id)">@option.Code · @option.Name</option>
                            }
                        </select>
                    </label>
                }
            }
            <button type="submit" class="btn btn-sm btn-primary">Save dimensions</button>
        </form>
        @if (_dimensionEntityId > 0)
        {
            <ErpDimensionLinksPanel Links="_openedDimensionLinks" />
        }
    }


    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Inventory stock KPIs">
        <div class="kpi"><div class="lbl">Stock rows</div><div class="val">@_summary.RowCount.ToString("N0", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Qty on hand</div><div class="val">@_summary.QtyOnHand.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Reserved</div><div class="val">@_reservedQty.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Available</div><div class="val">@_availableQty.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Stock value</div><div class="val">@_summary.StockValue.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Warehouses</div><div class="val">@_summary.WarehouseCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Items</div><div class="val">@_summary.ItemCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Warehouse</th>
                    <th>SKU</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Unit</th>
                    <th>Qty</th>
                    <th>Reserved</th>
                    <th>Available</th>
                    <th>Avg cost</th>
                    <th>Batch</th>
                    <th>Variant</th>
                    <th>Expiry</th>
                </tr>
            </thead>
            <tbody>
                @if (_stock.Count == 0)
                {
                    <tr><td colspan="12">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _stock)
                    {
                        <tr>
                            <td>@row.WarehouseName</td>
                            <td>@row.Sku</td>
                            <td>@row.Name</td>
                            <td>@row.ItemType</td>
                            <td>@row.Unit</td>
                            <td>@row.QtyOnHand.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@ReservedFor(row.ItemId).ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@AvailableFor(row.ItemId, row.QtyOnHand).ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@row.AvgUnitCost.ToString("N4", CultureInfo.InvariantCulture)</td>
                            <td>@row.BatchNo</td>
                            <td>@row.VariantLabel</td>
                            <td>@row.ExpiryDate</td>
                        </tr>
                    }
                    <tr style="font-weight:600;background:#f2f6fa">
                        <td>Total</td>
                        <td colspan="4"></td>
                        <td>@_stock.Sum(r => r.QtyOnHand).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td>@_reservedQty.ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td>@_availableQty.ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td colspan="4" class="text-muted">@_stock.Sum(r => r.QtyOnHand * r.AvgUnitCost).ToString("N2", CultureInfo.InvariantCulture) value · @_stock.Count rows</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <section class="epc-erp-form-panel" style="margin:1rem 0">
        <strong>Central stock.</strong>
        Available is on hand minus open reservations for that item. Confirming an order keeps the quantity until it is picked, dispatched, cancelled, or released. A quote hold still drops after 30 minutes. Excel does not reserve stock.
        <a href="@AsapHref("template")">Download ASAP template</a>
        <a href="@AsapHref("package")">Download package</a>
    </section>

    <h2 style="margin:1.2rem 0 .5rem;font-size:1rem;">Open sales holds</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>SKU</th><th>Qty</th><th>Source</th><th>Status</th><th>User</th><th>Expires</th>
                </tr>
            </thead>
            <tbody>
                @if (_holds.Count == 0)
                {
                    <tr><td colspan="6">No open holds. First click on a quote or sales order reserves the qty.</td></tr>
                }
                else
                {
                    @foreach (var hold in _holds)
                    {
                        <tr>
                            <td>@hold.Sku</td>
                            <td>@hold.Qty.ToString("N3", CultureInfo.InvariantCulture)</td>
                            <td>@hold.SourceType #@hold.SourceId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@hold.Status</td>
                            <td>@hold.ReservedBy.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(hold.ExpiresAt > 0 ? DateTimeOffset.FromUnixTimeSeconds(hold.ExpiresAt).ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture) : "until invoice")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="margin:1.2rem 0 .5rem;font-size:1rem;">Low stock (reorder)</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Warehouse</th><th>SKU</th><th>Name</th><th>Qty</th><th>Reorder</th><th>Avg cost</th><th></th>
                </tr>
            </thead>
            <tbody>
                @if (_lowStock.Count == 0)
                {
                    <tr><td colspan="7">No low-stock lines.</td></tr>
                }
                else
                {
                    @foreach (var row in _lowStock)
                    {
                        <tr>
                            <td>@row.WarehouseName</td>
                            <td>@row.Sku</td>
                            <td>@row.Name</td>
                            <td>@row.QtyOnHand.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@row.ReorderLevel.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@row.AvgUnitCost.ToString("N4", CultureInfo.InvariantCulture)</td>
                            <td>
                                @if (_isAdmin)
                                {
                                    <form method="post" action="/erp/ajax/inv-set-reorder-level" style="display:flex;gap:.3rem;align-items:center;margin:0">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="/erp/inventory-stock-app" />
                                        <input type="hidden" name="itemId" value="@row.ItemId.ToString(CultureInfo.InvariantCulture)" />
                                        <input type="text" name="reorderLevel" value="@row.ReorderLevel.ToString(CultureInfo.InvariantCulture)" style="width:5rem" />
                                        <button type="submit" class="btn btn-xs btn-default">Save</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_summary.Source. Showing @_stock.Count.ToString(CultureInfo.InvariantCulture) of @_summary.RowCount.ToString(CultureInfo.InvariantCulture) rows;
        @_lowStock.Count.ToString(CultureInfo.InvariantCulture) low-stock alerts.
        Movements, transfers, closing, and csv_text import stay on ERP ajax. File CSV upload is not available on this page.
        @if (!string.IsNullOrWhiteSpace(_summary.Message)) { <span> @_summary.Message</span> }
    </div>
    <script src="/erp/erp-inventory-stock.js" defer></script>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private ErpInventoryStockSummaryResult _summary = new(0, 0m, 0m, 0, 0, "migration", string.Empty);
    private IReadOnlyList<ErpInventoryStockDigest> _stock = [];
    private IReadOnlyList<ErpInventoryLowStockDigest> _lowStock = [];
    private IReadOnlyList<ErpReservationHold> _holds = [];
    private decimal _reservedQty;
    private decimal _availableQty;
    private IReadOnlyList<ErpDimensionCatalog> _dimensionCatalog = [];
    private IReadOnlyList<ErpDimensionLink> _openedDimensionLinks = [];
    private string _dimensionEntityType = "inventory_item";
    private long _dimensionEntityId;
    private string _pimFormHtml = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _dimensionEntityType = (ctx.Request.Query["dimension_entity_type"].ToString() ?? "inventory_item").Trim();
        if (string.IsNullOrWhiteSpace(_dimensionEntityType))
        {
            _dimensionEntityType = "inventory_item";
        }
        long.TryParse(
            ctx.Request.Query["dimension_entity_id"].ToString(),
            NumberStyles.Integer,
            CultureInfo.InvariantCulture,
            out _dimensionEntityId);
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildErpInventoryStockDigestAsync(200, null, ctx.RequestAborted);
        _summary = result.Summary;
        _stock = result.Stock;
        _lowStock = result.LowStock;
        _message = result.Message;
        _holds = await Reservations.ListActiveHoldsAsync(80, ctx.RequestAborted);
        _reservedQty = _holds.Sum(h => h.Qty);
        _availableQty = Math.Max(0m, _summary.QtyOnHand - _reservedQty);
        _dimensionCatalog = await DimensionCatalog.LoadAsync(100, ctx.RequestAborted);
        _pimFormHtml = await ErpPimCustomFields.TryRenderNewItemFieldsAsync(TenantDb, "inventory", ctx.RequestAborted);
        if (_dimensionEntityId > 0)
        {
            _openedDimensionLinks = await DimensionLinks.LoadAsync(
                _dimensionEntityType,
                _dimensionEntityId,
                ctx.RequestAborted);
        }
    }

    private bool IsDimensionSelected(string key, long valueId)
        => _openedDimensionLinks.Any(link =>
            string.Equals(link.Key, key, StringComparison.OrdinalIgnoreCase) &&
            link.ValueId == valueId);

    private decimal ReservedFor(long itemId)
        => _holds.Where(h => h.ItemId == itemId).Sum(h => h.Qty);

    private decimal AvailableFor(long itemId, decimal onHand)
        => Math.Max(0m, onHand - ReservedFor(itemId));

    private string AsapHref(string kind)
        => ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/asap/workbook?kind=" + kind);
}
