@page "/storefront/product-family-app"
@page "/en/product-family"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation

<PageTitle>Product Family · eParts Cart</PageTitle>
<PhpChromeStyles Surface="storefront" />
<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontCatalogWidgetBody Title="Product Family"
                            Subtitle="Manufacturer → product-family tree for aftermarket part selection."
                            AnchorId="epc-product-family"
                            Html="@_html"
                            PhpComparePath="@StorefrontPhpCanonical.ProductFamily">
    <a class="btn btn-sm btn-primary" href="@StorefrontSurfaceLinks.PartSearch">Part search</a>
    <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.UmapiCatalog">Epart Catalog</a>
    <a class="btn btn-sm btn-default" href="@("/php-reference" + StorefrontPhpCanonical.ProductFamily)" title="Temporary PHP compare only">Compare PHP reference</a>
</StorefrontCatalogWidgetBody>

@code {
    private string _html = "";

    protected override void OnInitialized()
    {
        _html = PhpHomeWidgetHtml.ProductFamily();
        if (string.IsNullOrWhiteSpace(_html))
        {
            _html = "<p style=\"margin:0;color:#64748b\">Product family widget is unavailable in this environment. "
                  + "<a href=\"" + StorefrontSurfaceLinks.PartSearch + "\">Open part search</a>.</p>";
        }
    }
}
