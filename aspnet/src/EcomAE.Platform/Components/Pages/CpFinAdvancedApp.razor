@page "/cp/fin-advanced-app"
@page "/erp/fin-advanced-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Financial depth · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Financial depth
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/fin-advanced-app")</p>
                <p>Set period status, generate periods, and save an allocation rule here.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/fin-advanced-app" IsAdmin="_isAdmin" />

    @if (_isAdmin)
    {
        <form method="post" action="/erp/fin/periods/status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/fin-advanced-app" />
            <label>Company id <input type="number" name="company_id" min="0" style="width:6rem" /></label>
            <label>FY <input type="number" name="fy" min="1" required style="width:6rem" /></label>
            <label>Period no <input type="number" name="period_no" min="1" required style="width:5rem" /></label>
            <label>Status
                <select name="status">
                    <option value="open">open</option>
                    <option value="on_hold">on_hold</option>
                    <option value="closed">closed</option>
                </select>
            </label>
            <button type="submit">Set status</button>
        </form>
        <form method="post" action="/erp/fin/periods/generate" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/fin-advanced-app" />
            <label>FY <input type="number" name="fy" style="width:6rem" /></label>
            <label>Start month <input type="number" name="start_month" min="1" max="12" value="1" style="width:5rem" /></label>
            <button type="submit">Generate periods</button>
        </form>
        <ErpPhpCreateWell Title="New allocation rule">
<form method="post" action="/erp/fin/alloc/save" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                <input type="hidden" name="returnUrl" value="/erp/fin-advanced-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Code <input class="form-control input-sm" name="code" required style="width:100px;" /></label>
                <label>Name <input class="form-control input-sm" name="name" style="width:160px;" /></label>
                <label>Source account <input class="form-control input-sm" name="source_account" style="width:120px;" /></label>
                <label>Basis <textarea class="form-control input-sm" name="basis" rows="3" placeholder="DEPT-A|2&#10;DEPT-B|1" style="width:180px;"></textarea></label>
                <button type="submit" class="btn btn-primary btn-sm">Save rule</button>
            </form>
</ErpPhpCreateWell>
    }

    <p class="help-block">@_summary.PeriodCount.ToString(CultureInfo.InvariantCulture) Periods · @_summary.OpenPeriodCount.ToString(CultureInfo.InvariantCulture) Open · @_summary.AllocRuleCount.ToString(CultureInfo.InvariantCulture) Alloc rules · @_summary.AccrualCount.ToString(CultureInfo.InvariantCulture) Accruals.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Company</th>
                    <th>FY</th>
                    <th>Period</th>
                    <th>Status</th>
                    <th>Start</th>
                    <th>End</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="8">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CompanyId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.Fy.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.PeriodNo.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@row.StartDate.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.EndDate.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=cost_acct&tab=fin_advanced";
    private bool _isAdmin;
    private CpFinAdvancedSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpFinPeriodDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpFinAdvancedDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Periods;
        _source = result.Source;
        _message = result.Message;
    }
}

