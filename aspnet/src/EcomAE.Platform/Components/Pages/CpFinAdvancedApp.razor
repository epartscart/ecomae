@page "/cp/fin-advanced-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Financial depth · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-finadv-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-finadv-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-finadv-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-finadv-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-finadv-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#052e16; background:#fff;
        }
        .epc-finadv-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-finadv-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-finadv-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-finadv-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-finadv-kpi span { color:#64748b; font-size:.78rem; }
        .epc-finadv-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-finadv-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-finadv-table th, .epc-finadv-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-finadv-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-finadv-note { margin-top:1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:.45rem; color:#334155; font-size:.86rem; }
        @@media (max-width:900px){ .epc-finadv-kpis{grid-template-columns:1fr 1fr;} }
    
</style>
</HeadContent>


<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-finadv-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Financial depth</h1>
        <p>@CpPhpModuleCopy.PurposeFor(Nav.Uri)</p>
        <div class="epc-finadv-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
        </div>
    </section>
    <PhpParityModuleBody AppPath="/cp/fin-advanced-app" IsAdmin="_isAdmin" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/fin/periods/status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/fin-advanced-app" />
            <label>Company id <input type="number" name="company_id" min="0" style="width:6rem" /></label>
            <label>FY <input type="number" name="fy" min="1" required style="width:6rem" /></label>
            <label>Period no <input type="number" name="period_no" min="1" required style="width:5rem" /></label>
            <label>Status
                <select name="status">
                    <option value="open">open</option>
                    <option value="on_hold">on_hold</option>
                    <option value="closed">closed</option>
                </select>
            </label>
            <button type="submit">Set status</button>
        </form>
    }

    <div class="epc-finadv-kpis" aria-label="Financial depth stats">
        <div class="epc-finadv-kpi"><strong>@_summary.PeriodCount.ToString(CultureInfo.InvariantCulture)</strong><span>Periods</span></div>
        <div class="epc-finadv-kpi"><strong>@_summary.OpenPeriodCount.ToString(CultureInfo.InvariantCulture)</strong><span>Open</span></div>
        <div class="epc-finadv-kpi"><strong>@_summary.AllocRuleCount.ToString(CultureInfo.InvariantCulture)</strong><span>Alloc rules</span></div>
        <div class="epc-finadv-kpi"><strong>@_summary.AccrualCount.ToString(CultureInfo.InvariantCulture)</strong><span>Accruals</span></div>
    </div>

    <div class="epc-finadv-table-wrap">
        <table class="epc-finadv-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Company</th>
                    <th>FY</th>
                    <th>Period</th>
                    <th>Status</th>
                    <th>Start</th>
                    <th>End</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="8">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CompanyId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.Fy.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.PeriodNo.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@row.StartDate.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.EndDate.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=cost_acct&tab=fin_advanced";
    private bool _isAdmin;
    private CpFinAdvancedSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpFinPeriodDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpFinAdvancedDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Periods;
        _source = result.Source;
        _message = result.Message;
    }
}

