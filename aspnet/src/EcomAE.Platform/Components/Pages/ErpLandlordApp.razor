@page "/erp/landlord-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Services
@inject ILegacySessionValidator Sessions
@inject ICpCsrfGuard Csrf
@inject IHttpContextAccessor Http
@inject IErpLandlordBook Book
@inject IErpTenancyExpiryMail Expiry

<PageTitle>Landlord year book · ERP</PageTitle>
<PhpChromeStyles Surface="erp" />

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Landlord year book" BreadcrumbArea="Industry" BreadcrumbTab="Year book">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/landlord-app" IsAdmin="_isAdmin" />
    <PhpErpModulePageHeader
        Title="Year, return and recovery"
        Subtitle="One page for the year. Income and expenses stay on the property until a flat list exists. An expense can then sit on one flat or be split equally across every listed flat. Investment value and combined costs through 2024 stay blank until those figures arrive."
        PhpTabHref="/erp/landlord-app" />
    <ErpRealEstateWorkspaceTabs Active="yearbook" />
    <ErpPhpFlash Ok="@_flashOk" Err="@_flashErr" />

    @if (_isAdmin)
    {
        <ErpTenancyExpiryPanel Book="_expiry" Note="@_expiryNote" SaveAction="@SaveAction" Csrf="@_csrf" Year="_year" PropertyId="_propertyId" UnitId="_unitId" />
    }

    <form method="get" class="re-filter" action="@AppHref">
        <label>Year
            <select class="form-control input-sm" name="year">
                <option value="0" selected="@(_year <= 0)">All years</option>
                @foreach (var year in _board.Years)
                {
                    <option value="@year" selected="@(_year == year)">@year</option>
                }
            </select>
        </label>
        <label>Property
            <select class="form-control input-sm" name="propertyId">
                <option value="0" selected="@(_propertyId <= 0)">Overall</option>
                @foreach (var property in _board.Properties)
                {
                    <option value="@property.Id" selected="@(_propertyId == property.Id)">@property.Name</option>
                }
            </select>
        </label>
        <label>Flat
            <select class="form-control input-sm" name="unitId">
                <option value="0" selected="@(_unitId <= 0)">All flats</option>
                @foreach (var unit in FlatChoices)
                {
                    <option value="@unit.Id" selected="@(_unitId == unit.Id)">@FlatLabel(unit)</option>
                }
            </select>
        </label>
        <button type="submit" class="btn btn-primary btn-sm">Show this view</button>
        <a class="btn btn-default btn-sm" href="@ReportHref">Download this view</a>
        <a class="btn btn-default btn-sm" href="@RegisterHref">Property register</a>
    </form>

    <p class="text-muted">@_viewLabel. These lines measure the year. They are not posted vouchers. A supplier bill still goes through the expense register and the ledger when it is approved. December 2025 rental lines add to 8,076,457. The sheet total row prints 8,076,455. A few expense columns differ by 1 dirham. The lines are stored as printed.</p>
    @if (!string.IsNullOrWhiteSpace(_board.Message))
    {
        <p class="text-muted">@_board.Message</p>
    }

    <h3 id="profit-and-loss">Profit &amp; loss</h3>
    <p class="text-muted">Profit and loss for this view is income minus expenses. Each figure opens the lines that make it.</p>
    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Selected year">
        <a class="kpi" href="#income-lines"><div class="lbl">@YearMeasureLabel income</div><div class="val">@Money(_board.Totals.Income)</div></a>
        <a class="kpi" href="#expense-lines"><div class="lbl">@YearMeasureLabel expenses</div><div class="val">@Money(_board.Totals.Expense)</div></a>
        <a class="kpi" href="#profit-and-loss"><div class="lbl">@YearMeasureLabel profit &amp; loss</div><div class="val">@Money(_board.Totals.ReturnAmount)</div></a>
        <div class="kpi"><div class="lbl">Recovery</div><div class="val">@RecoveryText(_board.Totals)</div></div>
        <div class="kpi"><div class="lbl">Investment</div><div class="val">@InvestmentText(_board.Totals)</div></div>
        <div class="kpi"><div class="lbl">Costs through 2024</div><div class="val">@ThroughText(_board.Totals)</div></div>
    </div>
    @if (_year > 0)
    {
        <div class="epc-erp-kpi epc-erp-stat-row" aria-label="All years">
            <a class="kpi" href="@ViewHref(0, _propertyId, _unitId)#income-lines"><div class="lbl">All years income</div><div class="val">@Money(_board.Life.Income)</div></a>
            <a class="kpi" href="@ViewHref(0, _propertyId, _unitId)#expense-lines"><div class="lbl">All years expenses</div><div class="val">@Money(_board.Life.Expense)</div></a>
            <a class="kpi" href="@ViewHref(0, _propertyId, _unitId)#profit-and-loss"><div class="lbl">All years profit &amp; loss</div><div class="val">@Money(_board.Life.ReturnAmount)</div></a>
            <div class="kpi"><div class="lbl">All years recovery</div><div class="val">@RecoveryText(_board.Life)</div></div>
            <div class="kpi"><div class="lbl">Investment</div><div class="val">@InvestmentText(_board.Life)</div></div>
            <div class="kpi"><div class="lbl">Costs through 2024</div><div class="val">@ThroughText(_board.Life)</div></div>
        </div>
    }
    <p class="text-muted">
        <a href="@CoaHref(ErpLandlordCoa.Asset)">Assets @ErpLandlordCoa.Asset Investment property</a>
        · <a href="@RegisterHref">Properties</a>
        · <a href="@CoaHref(ErpLandlordCoa.Income)">Income @ErpLandlordCoa.Income Rental income</a>
        · <a href="@CoaHref(ErpLandlordCoa.ExpenseParent)">Expenses @ErpLandlordCoa.ExpenseParent Property operating expenses</a>
        · <a href="@CoaListHref">Chart of accounts</a>
    </p>
    <p class="text-muted">Return is income minus expenses for this view. Combined costs through 2024 stay outside that return. Recovery percent appears when both the recovered amount and the expenses are known. Return on investment appears when the investment value is known. A zero recovery means the sheet said recovered and did not give an amount.</p>

    @if (_unitId <= 0)
    {
        <div class="epc-erp-table-wrap">
            <table class="table table-condensed table-bordered table-epc">
                <thead>
                    <tr>
                        <th>Property</th><th>Holder</th><th>From</th><th>Planned</th><th>Listed</th><th>Income</th><th>Expenses</th><th>Return</th><th>Recovery</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in RollupRows)
                    {
                        <tr>
                            <td><a href="@ViewHref(_year, row.PropertyId, 0)">@row.Name</a></td>
                            <td>@row.Holder</td>
                            <td>@(row.StartYear > 0 ? row.StartYear.ToString(CultureInfo.InvariantCulture) : "")</td>
                            <td>@row.PlannedUnits.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.ListedUnits.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@Money(row.Income)</td>
                            <td>@Money(row.Expense)</td>
                            <td>@Money(row.Income - row.Expense)</td>
                            <td>@(row.Recovery > 0 ? Money(row.Recovery) : "")</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="5"><strong>@_viewLabel</strong></td>
                        <td><strong>@Money(_board.Totals.Income)</strong></td>
                        <td><strong>@Money(_board.Totals.Expense)</strong></td>
                        <td><strong>@Money(_board.Totals.ReturnAmount)</strong></td>
                        <td><strong>@RecoveryText(_board.Totals)</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="text-muted">Planned is the room or flat count from the sheet. Listed is the number of flat codes on file. Labour Camp is 126 rooms, DIC 531-135 is 38 flats, and DIC 531-178 is 99 flats. Those lists arrive later, so nothing is split across placeholder flats.</p>
    }

    @if (_isAdmin)
    {
        <ErpPhpCreateWell Title="Add an expense">
            <form method="post" action="@SaveAction">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                <input type="hidden" name="action" value="save_line" />
                <input type="hidden" name="kind" value="expense" />
                <input type="hidden" name="spread" value="building" />
                <input type="hidden" name="filterYear" value="@_year.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="filterPropertyId" value="@_propertyId.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="filterUnitId" value="@_unitId.ToString(CultureInfo.InvariantCulture)" />
                <label>Year <input class="form-control input-sm" type="number" name="year" min="1990" max="2100" value="@EntryYear" required /></label>
                <label>Property
                    <select class="form-control input-sm" name="propertyId" required>
                        @foreach (var property in _board.Properties)
                        {
                            <option value="@property.Id" selected="@(_propertyId == property.Id)">@property.Name</option>
                        }
                    </select>
                </label>
                <label>Expense
                    <select class="form-control input-sm" name="category">
                        @foreach (var expense in ErpLandlordCoa.Expenses)
                        {
                            <option value="@expense.Category">@expense.Name</option>
                        }
                        <option value="other">Other — type it below</option>
                    </select>
                </label>
                <label>Other expense <input class="form-control input-sm" name="categoryCustom" maxlength="40" placeholder="Only when the list does not have it" /></label>
                <label>Amount <input class="form-control input-sm" type="number" name="amount" min="0.01" step="0.01" required placeholder="0.00" /></label>
                <label>Note <input class="form-control input-sm" name="note" maxlength="255" placeholder="What this expense was for" /></label>
                <div class="form-actions"><button type="submit" class="btn btn-primary btn-sm">Add this expense</button></div>
            </form>
            <p class="text-muted">Each expense is one line on the property and the year. Add the next one the same way. A name that is not in the list uses the other property expense account.</p>
        </ErpPhpCreateWell>
        <ErpPhpCreateWell Title="Add income">
            <form method="post" action="@SaveAction">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                <input type="hidden" name="action" value="save_line" />
                <input type="hidden" name="kind" value="income" />
                <input type="hidden" name="category" value="rental" />
                <input type="hidden" name="spread" value="building" />
                <input type="hidden" name="filterYear" value="@_year.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="filterPropertyId" value="@_propertyId.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="filterUnitId" value="@_unitId.ToString(CultureInfo.InvariantCulture)" />
                <label>Year <input class="form-control input-sm" type="number" name="year" min="1990" max="2100" value="@EntryYear" required /></label>
                <label>Property
                    <select class="form-control input-sm" name="propertyId" required>
                        @foreach (var property in _board.Properties)
                        {
                            <option value="@property.Id" selected="@(_propertyId == property.Id)">@property.Name</option>
                        }
                    </select>
                </label>
                <label>Amount <input class="form-control input-sm" type="number" name="amount" min="0.01" step="0.01" required placeholder="0.00" /></label>
                <label>Note <input class="form-control input-sm" name="note" maxlength="255" placeholder="Rent for this year" /></label>
                <div class="form-actions"><button type="submit" class="btn btn-primary btn-sm">Add this income</button></div>
            </form>
        </ErpPhpCreateWell>
        <ErpPhpCreateWell Title="Add, edit, delete, void or reverse an entry">
            <form id="line-form" method="post" action="@SaveAction">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                <input type="hidden" name="filterYear" value="@_year.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="filterPropertyId" value="@_propertyId.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="filterUnitId" value="@_unitId.ToString(CultureInfo.InvariantCulture)" />
                <label>Entry
                    <select class="form-control input-sm" name="id">
                        <option value="0">New line</option>
                        @foreach (var line in _board.Lines.Where(item => item.ParentId == 0))
                        {
                            <option value="@line.Id" selected="@(_lineId == line.Id)">@LineChoice(line)</option>
                        }
                    </select>
                </label>
                <label>Kind
                    <select class="form-control input-sm" name="kind">
                        <option value="income" selected="@OpenIs("income")">Income</option>
                        <option value="expense" selected="@OpenIs("expense")">Expense</option>
                        <option value="recovery" selected="@OpenIs("recovery")">Recovery</option>
                        <option value="investment" selected="@OpenIs("investment")">Investment</option>
                        <option value="through_2024" selected="@OpenIs("through_2024")">Combined costs through 2024</option>
                    </select>
                </label>
                <label>Year <input class="form-control input-sm" type="number" name="year" min="1990" max="2100" value="@OpenYear" required /></label>
                <label>Property
                    <select class="form-control input-sm" name="propertyId" required>
                        @foreach (var property in _board.Properties)
                        {
                            <option value="@property.Id" selected="@((_open?.PropertyId ?? _propertyId) == property.Id)">@property.Name</option>
                        }
                    </select>
                </label>
                <label>Category <input class="form-control input-sm" name="category" maxlength="40" value="@(_open?.Category ?? "")" placeholder="rental, repairs, recovered" /></label>
                <label>Amount <input class="form-control input-sm" type="number" name="amount" step="0.01" value="@OpenAmount" placeholder="0.00" /></label>
                <label>Where it sits
                    <select class="form-control input-sm" name="spread">
                        <option value="building" selected="@OpenSpread("building")">On the building</option>
                        <option value="flat" selected="@OpenSpread("flat")">On one flat</option>
                        <option value="all_flats" selected="@OpenSpread("all_flats")">Split equally across listed flats</option>
                    </select>
                </label>
                <label>Flat, when it sits on one flat
                    <select class="form-control input-sm" name="unitId">
                        <option value="0">Building</option>
                        @foreach (var unit in FlatChoices)
                        {
                            <option value="@unit.Id" selected="@(_open?.UnitId == unit.Id)">@FlatLabel(unit)</option>
                        }
                    </select>
                </label>
                <label>Date <input class="form-control input-sm" type="date" name="date1" value="@(_open?.MovementDate ?? "")" /></label>
                <label>Note <input class="form-control input-sm" name="note" maxlength="255" value="@(_open?.Note ?? "")" /></label>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-sm" name="action" value="save_line">Add</button>
                    <button type="submit" class="btn btn-primary btn-sm" name="action" value="edit">Save changes</button>
                    <button type="submit" class="btn btn-default btn-sm" name="action" value="delete">Delete</button>
                    <button type="submit" class="btn btn-default btn-sm" name="action" value="void">Void</button>
                    <button type="submit" class="btn btn-default btn-sm" name="action" value="reverse">Reverse</button>
                </div>
            </form>
            <p class="text-muted">Choose New line and Add to record one. Choose an existing line to save a change, delete it, void it, or reverse it. Void keeps the line on file and takes it off the return. Reverse keeps the line and records the opposite amount, so the return goes back by that line. Delete removes it.</p>
        </ErpPhpCreateWell>
    }

    <h3 id="expense-lines">Expenses, one by one</h3>
    <div class="epc-erp-table-wrap">
        <table class="table table-condensed table-bordered table-epc">
            <thead>
                <tr>
                    <th>Year</th><th>Property</th><th>Expense</th><th>Amount</th><th>Account</th><th>Status</th><th>Note</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in KindLines("expense"))
                {
                    var onBuilding = _unitId > 0 && line.UnitId == 0;
                    var property = _board.Properties.FirstOrDefault(item => item.Id == line.PropertyId);
                    <tr>
                        <td>@line.Year.ToString(CultureInfo.InvariantCulture)</td>
                        <td><a href="@ViewHref(line.Year, line.PropertyId, 0)">@line.PropertyName</a></td>
                        <td>@ErpLandlordCoa.Label(line.Category)</td>
                        <td>@Money(line.Amount)</td>
                        <td><a href="@CoaHref(AccountCode(line))">@AccountText(line)</a></td>
                        <td>@line.Status</td>
                        <td>@(onBuilding ? "On the building. Not in this flat total. " : "")@line.Note</td>
                        <td>
                            @if (_isAdmin && line.ParentId == 0 && line.Spread == "building" && line.UnitId == 0 && string.Equals(line.Status, "recorded", StringComparison.OrdinalIgnoreCase))
                            {
                                if ((property?.ListedUnits ?? 0) == 0)
                                {
                                    <span class="text-muted">Stays on the building until flats are listed.</span>
                                }
                                else
                                {
                                    <form method="post" action="@SaveAction">
                                        <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                                        <input type="hidden" name="action" value="distribute" />
                                        <input type="hidden" name="id" value="@line.Id" />
                                        <input type="hidden" name="filterYear" value="@_year.ToString(CultureInfo.InvariantCulture)" />
                                        <input type="hidden" name="filterPropertyId" value="@_propertyId.ToString(CultureInfo.InvariantCulture)" />
                                        <input type="hidden" name="filterUnitId" value="@_unitId.ToString(CultureInfo.InvariantCulture)" />
                                        <select class="form-control input-sm" name="targetUnitId">
                                            <option value="0">Split across all listed flats</option>
                                            @foreach (var unit in _board.Units.Where(item => item.PropertyId == line.PropertyId))
                                            {
                                                <option value="@unit.Id">@unit.Code</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-default btn-xs">Distribute</button>
                                    </form>
                                }
                            }
                            <ErpLandlordLineActions Line="line" Admin="_isAdmin" SaveAction="@SaveAction" EditHref="@EditHref(line.Id)" FilterYear="_year" FilterPropertyId="_propertyId" FilterUnitId="_unitId" Csrf="@_csrf" />
                        </td>
                    </tr>
                }
                <tr>
                    <td colspan="3"><strong>Expenses counted</strong></td>
                    <td><strong>@Money(_board.Totals.Expense)</strong></td>
                    <td colspan="4"></td>
                </tr>
            </tbody>
        </table>
    </div>

    <h3 id="income-lines">Income, one by one</h3>
    <div class="epc-erp-table-wrap">
        <table class="table table-condensed table-bordered table-epc">
            <thead>
                <tr>
                    <th>Year</th><th>Property</th><th>Income</th><th>Amount</th><th>Account</th><th>Status</th><th>Note</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in KindLines("income"))
                {
                    <tr>
                        <td>@line.Year.ToString(CultureInfo.InvariantCulture)</td>
                        <td><a href="@ViewHref(line.Year, line.PropertyId, 0)">@line.PropertyName</a></td>
                        <td>@ErpLandlordCoa.Label(line.Category)</td>
                        <td>@Money(line.Amount)</td>
                        <td><a href="@CoaHref(AccountCode(line))">@AccountText(line)</a></td>
                        <td>@line.Status</td>
                        <td>@line.Note</td>
                        <td>
                            <ErpLandlordLineActions Line="line" Admin="_isAdmin" SaveAction="@SaveAction" EditHref="@EditHref(line.Id)" FilterYear="_year" FilterPropertyId="_propertyId" FilterUnitId="_unitId" Csrf="@_csrf" />
                        </td>
                    </tr>
                }
                <tr>
                    <td colspan="3"><strong>Income counted</strong></td>
                    <td><strong>@Money(_board.Totals.Income)</strong></td>
                    <td colspan="4"></td>
                </tr>
            </tbody>
        </table>
    </div>

    @if (OtherLines.Any())
    {
        <h3>Recovery, investment and costs through 2024</h3>
        <div class="epc-erp-table-wrap">
            <table class="table table-condensed table-bordered table-epc">
                <thead>
                    <tr>
                        <th>Year</th><th>Property</th><th>Kind</th><th>Amount</th><th>Status</th><th>Note</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in OtherLines)
                    {
                        <tr>
                            <td>@line.Year.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@line.PropertyName</td>
                            <td>@line.Kind</td>
                            <td>@Money(line.Amount)</td>
                            <td>@line.Status</td>
                            <td>@line.Note</td>
                            <td>
                                <ErpLandlordLineActions Line="line" Admin="_isAdmin" SaveAction="@SaveAction" EditHref="@EditHref(line.Id)" FilterYear="_year" FilterPropertyId="_propertyId" FilterUnitId="_unitId" Csrf="@_csrf" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private string _flashOk = "";
    private string _flashErr = "";
    private string _csrf = "";
    private string _expiryNote = "";
    private ErpTenancyExpiryBook _expiry = ErpTenancyExpiryBook.Empty("");
    private int _year = ErpLandlordOpening.SheetYear;
    private long _propertyId;
    private long _unitId;
    private long _lineId;
    private ErpLandlordLine? _open;
    private ErpLandlordBoard _board = new(
        ErpLandlordOpening.SheetYear,
        0,
        0,
        new ErpLandlordTotals(0, 0, 0, 0, 0, 0, false),
        new ErpLandlordTotals(0, 0, 0, 0, 0, 0, false),
        [ErpLandlordOpening.SheetYear],
        [],
        [],
        [],
        [],
        "");

    private string AppHref => ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/landlord-app");

    private string SaveAction => ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/landlord/save");

    private string RegisterHref => ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/real-estate-app?tab=properties");

    private string ReportHref
        => ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/landlord/report?year=" + _year.ToString(CultureInfo.InvariantCulture)
            + "&propertyId=" + _propertyId.ToString(CultureInfo.InvariantCulture)
            + "&unitId=" + _unitId.ToString(CultureInfo.InvariantCulture));

    private string EntryYear => (_year > 0 ? _year : ErpLandlordOpening.SheetYear).ToString(CultureInfo.InvariantCulture);

    private string YearMeasureLabel => _year > 0 ? _year.ToString(CultureInfo.InvariantCulture) : "All years";

    private string CoaListHref => ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/coa-accounts-app");

    private IEnumerable<ErpLandlordLine> KindLines(string kind)
        => _board.Lines.Where(line => string.Equals(line.Kind, kind, StringComparison.OrdinalIgnoreCase))
            .OrderBy(line => line.PropertyName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(line => line.Category, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<ErpLandlordLine> OtherLines
        => _board.Lines.Where(line => line.Kind is not ("income" or "expense"))
            .OrderBy(line => line.PropertyName, StringComparer.OrdinalIgnoreCase);

    private string OpenYear => (_open?.Year ?? (_year > 0 ? _year : ErpLandlordOpening.SheetYear)).ToString(CultureInfo.InvariantCulture);

    private string OpenAmount => _open is null ? "" : _open.Amount.ToString("0.00", CultureInfo.InvariantCulture);

    private bool OpenIs(string kind)
        => string.Equals(_open?.Kind ?? "expense", kind, StringComparison.OrdinalIgnoreCase);

    private bool OpenSpread(string spread)
        => string.Equals(_open?.Spread ?? "building", spread, StringComparison.OrdinalIgnoreCase);

    private string EditHref(long lineId)
        => ViewHref(_year, _propertyId, _unitId) + "&line=" + lineId.ToString(CultureInfo.InvariantCulture) + "#line-form";

    private string LineChoice(ErpLandlordLine line)
        => line.Year.ToString(CultureInfo.InvariantCulture) + " " + line.PropertyName + " " + ErpLandlordCoa.Label(line.Category) + " " + Money(line.Amount) + " " + line.Status;

    private string CoaHref(string code)
    {
        var account = (_board.Accounts ?? []).FirstOrDefault(item => string.Equals(item.Code, code, StringComparison.Ordinal));
        var href = account is null || account.Id <= 0
            ? "/erp/coa-accounts-app?code=" + Uri.EscapeDataString(code)
            : "/erp/coa-accounts-app?account_id=" + account.Id.ToString(CultureInfo.InvariantCulture);
        return ClientErpPath.PrefixIfBound(Http.HttpContext, href);
    }

    private string AccountCode(ErpLandlordLine line)
        => string.IsNullOrWhiteSpace(line.CoaCode) ? ErpLandlordCoa.CodeFor(line.Kind, line.Category) : line.CoaCode;

    private string AccountText(ErpLandlordLine line)
    {
        var code = AccountCode(line);
        if (code.Length == 0)
        {
            return "";
        }

        var account = (_board.Accounts ?? []).FirstOrDefault(item => string.Equals(item.Code, code, StringComparison.Ordinal));
        return account is null || string.IsNullOrWhiteSpace(account.Name) ? code : code + " " + account.Name;
    }

    private string _viewLabel => _unitId > 0 ? "This flat" : _propertyId > 0 ? "This property" : "Overall";

    private IEnumerable<ErpLandlordUnit> FlatChoices
        => _propertyId <= 0 ? _board.Units : _board.Units.Where(unit => unit.PropertyId == _propertyId);

    private IEnumerable<ErpLandlordRollup> RollupRows
        => _propertyId <= 0 ? _board.Rollup : _board.Rollup.Where(row => row.PropertyId == _propertyId);

    private string ViewHref(int year, long propertyId, long unitId)
        => ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/landlord-app?year=" + year.ToString(CultureInfo.InvariantCulture)
            + "&propertyId=" + propertyId.ToString(CultureInfo.InvariantCulture)
            + "&unitId=" + unitId.ToString(CultureInfo.InvariantCulture));

    private static string Money(decimal amount)
        => amount.ToString("N2", CultureInfo.InvariantCulture);

    private static string RecoveryText(ErpLandlordTotals totals)
    {
        if (totals.Recovery > 0)
        {
            return Money(totals.Recovery) + (totals.RecoveryPercent is null ? "" : " (" + totals.RecoveryPercent.Value.ToString("0.00", CultureInfo.InvariantCulture) + "%)");
        }

        return totals.RecoveryMarked ? "Marked. Amount later." : "Not recorded";
    }

    private static string InvestmentText(ErpLandlordTotals totals)
    {
        if (totals.Investment <= 0)
        {
            return "Not provided yet";
        }

        var roi = totals.ReturnOnInvestment is null ? "" : " (" + totals.ReturnOnInvestment.Value.ToString("0.00", CultureInfo.InvariantCulture) + "%)";
        return Money(totals.Investment) + roi;
    }

    private static string ThroughText(ErpLandlordTotals totals)
        => totals.Through2024 > 0 ? Money(totals.Through2024) : "Not provided yet";

    private string FlatLabel(ErpLandlordUnit unit)
    {
        if (_propertyId > 0)
        {
            return string.IsNullOrWhiteSpace(unit.Name) ? unit.Code : unit.Code + " " + unit.Name;
        }

        var property = _board.Properties.FirstOrDefault(item => item.Id == unit.PropertyId);
        return (property?.Code ?? "") + " " + unit.Code;
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var yearRaw = ctx.Request.Query["year"].ToString();
        if (!int.TryParse(yearRaw, NumberStyles.Integer, CultureInfo.InvariantCulture, out _year))
        {
            _year = ErpLandlordOpening.SheetYear;
        }

        long.TryParse(ctx.Request.Query["propertyId"].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out _propertyId);
        long.TryParse(ctx.Request.Query["unitId"].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out _unitId);
        long.TryParse(ctx.Request.Query["line"].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out _lineId);
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        _csrf = _isAdmin ? await Csrf.KeyForAsync(ctx, session, ctx.RequestAborted) : "";
        if (!_isAdmin)
        {
            return;
        }

        try
        {
            await Book.EnsureOpeningAsync(ClientErpPath.BoundSiteKey(ctx), ctx.RequestAborted);
            _board = await Book.LoadAsync(_year, _propertyId, _unitId, ctx.RequestAborted);
            _open = _lineId > 0 ? _board.Lines.FirstOrDefault(line => line.Id == _lineId) : null;
            try
            {
                var today = ErpTenancyExpiryMail.GulfToday(DateTime.UtcNow);
                await Expiry.PrepareAsync(today, ctx.RequestAborted);
                _expiry = await Expiry.LoadAsync(today, ctx.RequestAborted);
                if (_expiry.Template.AutoSend)
                {
                    var sent = await Expiry.SendDueAsync(today, ctx.RequestAborted);
                    _expiryNote = sent.Message;
                    _expiry = await Expiry.LoadAsync(today, ctx.RequestAborted);
                }
            }
            catch (Exception expiryEx)
            {
                var text = expiryEx.Message.Length > 300 ? expiryEx.Message[..300] : expiryEx.Message;
                _expiry = ErpTenancyExpiryBook.Empty(text);
            }
        }
        catch (Exception ex)
        {
            _board = _board with { Message = ex.Message.Length > 300 ? ex.Message[..300] : ex.Message };
        }
    }
}
