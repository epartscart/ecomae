@page "/cp/currencies-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Currencies · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Currencies
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Save one ISO rate, mark currencies available, or save the nightly FX schedule here when confirmWrites is set. Live FX pull stays on the Classic twin. This page does not invent a send.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/currencies-app" IsAdmin="_isAdmin" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/currencies/set-rate" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/currencies-app" />
            <label>ISO <input type="text" name="isoCode" required maxlength="3" /></label>
            <label>Rate <input type="text" name="rate" required /></label>
            <button type="submit">Save rate</button>
        </form>
        <form method="post" action="/cp/currencies/set-available" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/currencies-app" />
            <label>ISO codes <input type="text" name="isoCodes" required placeholder="USD,EUR" /></label>
            <label>Available
                <select name="available">
                    <option value="1">yes</option>
                    <option value="0">no</option>
                </select>
            </label>
            <button type="submit">Set available</button>
        </form>
        <form method="post" action="/cp/currencies/schedule-save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/currencies-app" />
            <label>Nightly FX
                <select name="enabled">
                    <option value="1" selected>on</option>
                    <option value="0">off</option>
                </select>
            </label>
            <label>Timezone <input type="text" name="timezone" maxlength="64" value="Asia/Dubai" /></label>
            <label>Hour <input type="number" name="hour" min="0" max="23" value="2" required style="width:5rem" /></label>
            <button type="submit">Save schedule</button>
        </form>
        <p class="help-block" style="margin:0 0 1rem">Live FX pull, apply, and run-now stay Classic. This page does not invent a send.</p>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Rates</div>
            <div class="panel-body">
                <p class="help-block">@_currencies.Count shown (limit @_limit) · @_available available · @_unavailable unavailable.</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>ISO</th>
                                <th>Name</th>
                                <th>Short</th>
                                <th>Rate</th>
                                <th>Available</th>
                                <th>Sort</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_currencies.Count == 0)
                        {
                            <tr><td colspan="8">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var c in _currencies)
                            {
                                <tr>
                                    <td>@c.Id</td>
                                    <td>@(string.IsNullOrWhiteSpace(c.IsoCode) ? "—" : c.IsoCode)</td>
                                    <td>@(string.IsNullOrWhiteSpace(c.IsoName) ? "—" : c.IsoName)</td>
                                    <td>@(string.IsNullOrWhiteSpace(c.CaptionShort) ? "—" : c.CaptionShort)</td>
                                    <td>@c.Rate.ToString("0.####", CultureInfo.InvariantCulture)</td>
                                    <td>@(c.Available ? "yes" : "no")</td>
                                    <td>@c.SortOrder</td>
                                    <td>
                                        @if (_isAdmin && !string.IsNullOrWhiteSpace(c.IsoCode))
                                        {
                                            <form method="post" action="/cp/currencies/set-available" style="display:inline">
                                                <input type="hidden" name="confirmWrites" value="true" />
                                                <input type="hidden" name="returnUrl" value="/cp/currencies-app" />
                                                <input type="hidden" name="isoCodes" value="@c.IsoCode" />
                                                <input type="hidden" name="available" value="@(c.Available ? "0" : "1")" />
                                                <button type="submit">@(c.Available ? "Disable" : "Enable")</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/nastrojka-kursov-valyut";
    private bool _isAdmin;
    private IReadOnlyList<CpCurrencyDigest> _currencies = [];
    private int _available;
    private int _unavailable;
    private int _limit = 200;
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.ListCpCurrenciesAsync(_limit, ctx.RequestAborted);
        _currencies = result.Currencies;
        _available = _currencies.Count(c => c.Available);
        _unavailable = _currencies.Count(c => !c.Available);
    }
}
