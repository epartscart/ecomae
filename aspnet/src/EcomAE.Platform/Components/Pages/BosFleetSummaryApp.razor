@page "/bos/fleet-summary-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Fleet Summary · Super BOS · eParts Cart</PageTitle>
<PhpChromeStyles Surface="bos" />
<HeadContent>
<style>
        .epc-fs-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#000000 0%,#0c4a6e 55%,#0ea5e9 100%);
        }
        .epc-fs-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-fs-hero p { margin:0; color:#bbf7d0; max-width:42rem; font-size:.92rem; line-height:1.45; }
        .epc-fs-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-fs-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#14532d; background:#e0f2fe;
        }
        .epc-fs-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-fs-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-fs-kpi { background:#fff; border:1px solid #d1fae5; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-fs-kpi strong { display:block; font-size:1.45rem; font-variant-numeric:tabular-nums; }
        .epc-fs-kpi span { color:#64748b; font-size:.78rem; }
        .epc-fs-note { margin-top:1rem; padding:.75rem .9rem; background:#ecfdf5; border:1px solid #a7f3d0; border-radius:.45rem; color:#14532d; font-size:.86rem; }
        @@media (max-width:900px){ .epc-fs-kpis{grid-template-columns:1fr 1fr;} }
        @@media (max-width:560px){ .epc-fs-kpis{grid-template-columns:1fr;} }
    
</style>
</HeadContent>


<PhpBosDesktopChrome IsAdmin="_isAdmin" Title="Fleet Summary">

    <section class="epc-fs-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Fleet Summary</h1>
        <p>Fleet provisioning and live health overview.</p>
        <div class="epc-fs-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/bos/fleet-health-app">Fleet health</a>
            <a class="ghost" href="/bos/fleet-readiness-app">Fleet readiness</a>
            <a class="ghost" href="/bos/tenants-app">Fleet tenants</a>
        </div>
    </section>

    <div class="epc-fs-kpis" aria-label="Fleet summary KPIs">
        <div class="epc-fs-kpi"><strong>@_tenants.ToString(CultureInfo.InvariantCulture)</strong><span>Total tenants</span></div>
        <div class="epc-fs-kpi"><strong>@_commerce.ToString(CultureInfo.InvariantCulture)</strong><span>Commerce</span></div>
        <div class="epc-fs-kpi"><strong>@_erpOnly.ToString(CultureInfo.InvariantCulture)</strong><span>ERP only</span></div>
        <div class="epc-fs-kpi"><strong>@_demo.ToString(CultureInfo.InvariantCulture)</strong><span>Demo</span></div>
        <div class="epc-fs-kpi"><strong>@_platform.ToString(CultureInfo.InvariantCulture)</strong><span>Platform</span></div>
        <div class="epc-fs-kpi"><strong>@_active.ToString(CultureInfo.InvariantCulture)</strong><span>Active tenants</span></div>
        <div class="epc-fs-kpi"><strong>@_withDb.ToString(CultureInfo.InvariantCulture)</strong><span>With database</span></div>
        <div class="epc-fs-kpi"><strong>@_sessions.ToString(CultureInfo.InvariantCulture)</strong><span>Admin sessions</span></div>
</div>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/bos/notifications/mark-read" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/bos/fleet-summary-app" />
            <label>Ids <input type="text" name="ids" placeholder="1,2,3 or [1,2,3]" /></label>
            <label>Tenant key <input type="text" name="tenant_key" value="__platform__" /></label>
            <button type="submit">Mark read</button>
        </form>
        <form method="post" action="/bos/notifications/dismiss" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/bos/fleet-summary-app" />
            <label>Notification id <input type="text" name="notification_id" /></label>
            <label>Tenant key <input type="text" name="tenant_key" value="__platform__" /></label>
            <button type="submit">Dismiss</button>
        </form>
        <form method="post" action="/bos/notifications/mark-all-read" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/bos/fleet-summary-app" />
            <label>User id <input type="text" name="user_id" value="0" /></label>
            <label>Tenant key <input type="text" name="tenant_key" value="__platform__" /></label>
            <button type="submit">Mark all read</button>
        </form>
        <form method="post" action="/bos/notifications/prefs-save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/bos/fleet-summary-app" />
            <label>User id <input type="text" name="user_id" value="0" /></label>
            <label>Tenant key <input type="text" name="tenant_key" value="__platform__" /></label>
            <label>Category <input type="text" name="category" value="*" /></label>
            <label>In-app <input type="text" name="channel_in_app" value="1" /></label>
            <label>Email <input type="text" name="channel_email" value="1" /></label>
            <label>Webhook <input type="text" name="channel_webhook" value="0" /></label>
            <label>Digest <input type="text" name="email_digest" value="daily" /></label>
            <button type="submit">Save prefs</button>
        </form>
        <form method="post" action="/bos/notifications/cleanup" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/bos/fleet-summary-app" />
            <label>Days <input type="text" name="days" value="90" /></label>
            <button type="submit">Clean up read</button>
        </form>
        <form method="post" action="/bos/credit/hold" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/bos/fleet-summary-app" />
            <label>Site key <input type="text" name="site_key" /></label>
            <label>Customer id <input type="text" name="customer_id" /></label>
            <label>Reason <input type="text" name="reason" /></label>
            <button type="submit">Hold credit</button>
        </form>
        <form method="post" action="/bos/credit/release" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/bos/fleet-summary-app" />
            <label>Site key <input type="text" name="site_key" /></label>
            <label>Customer id <input type="text" name="customer_id" /></label>
            <button type="submit">Release credit</button>
        </form>
        <form method="post" action="/bos/api-keys/revoke" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/bos/fleet-summary-app" />
            <label>Key id <input type="text" name="key_id" /></label>
            <button type="submit">Revoke API key</button>
        </form>
        <form method="post" action="/bos/webhooks/delete" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/bos/fleet-summary-app" />
            <label>Webhook id <input type="text" name="webhook_id" /></label>
            <button type="submit">Delete webhook</button>
        </form>
        <form method="post" action="/bos/webhooks/dlq-resolve" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/bos/fleet-summary-app" />
            <label>DLQ id <input type="text" name="dlq_id" /></label>
            <button type="submit">Resolve DLQ</button>
        </form>
        <form method="post" action="/bos/po/cancel" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/bos/fleet-summary-app" />
            <label>PO id <input type="text" name="po_id" /></label>
            <button type="submit">Cancel PO</button>
        </form>
        <form method="post" action="/bos/po/reject" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/bos/fleet-summary-app" />
            <label>PO id <input type="text" name="po_id" /></label>
            <label>Tier <input type="text" name="tier" /></label>
            <label>Approver id <input type="text" name="approver_id" /></label>
            <label>Reason <input type="text" name="reason" /></label>
            <button type="submit">Reject PO</button>
        </form>
        <form method="post" action="/bos/fulfillment/pick-item" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/bos/fleet-summary-app" />
            <label>Item id <input type="text" name="item_id" /></label>
            <label>Qty picked <input type="text" name="qty_picked" /></label>
            <button type="submit">Pick item</button>
        </form>
        <form method="post" action="/bos/billing/cancel" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/bos/fleet-summary-app" />
            <label>Subscription id <input type="text" name="subscription_id" /></label>
            <label>Reason <input type="text" name="reason" /></label>
            <button type="submit">Cancel subscription</button>
        </form>
        <p class="help-block" style="margin:0 0 1rem">Send and broadcast stay Classic. This page does not invent a send.</p>
    }

</PhpBosDesktopChrome>

@code {
    private const string _phpTab = "/BOS/";
    private bool _isAdmin;
    private int _tenants;
    private int _active;
    private int _sessions;
    private int _withDb;
    private int _erpOnly;
    private int _commerce;
    private int _demo;
    private int _platform;
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("bos");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var summary = await Dashboards.BuildBosAsync(ctx.RequestAborted);
        _tenants = summary.PortalTenants;
        _active = summary.ActivePortalTenants;
        _sessions = summary.AdminSessions;
        _withDb = summary.WithDatabase;
        _erpOnly = summary.ErpOnly;
        _commerce = summary.CommerceTenants;
        _demo = summary.DemoTenants;
        _platform = summary.PlatformTenants;
        _source = summary.Source;
        _message = summary.Message;
    }
}
