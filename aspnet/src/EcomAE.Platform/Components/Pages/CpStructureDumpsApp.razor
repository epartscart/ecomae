@page "/cp/structure-dumps-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Structure dumps · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Structure dumps
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Saved structure dumps from tenant tables. Create or download stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/structure-dumps-app" IsAdmin="_isAdmin" />

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Dumps</div>
            <div class="panel-body">
                <p class="help-block">@_summary.DumpCount.ToString(CultureInfo.InvariantCulture) dumps · @_summary.TotalRecords.ToString(CultureInfo.InvariantCulture) records · latest @_summary.LatestTimeCreated.ToString(CultureInfo.InvariantCulture) · with file @_summary.WithFileCount.ToString(CultureInfo.InvariantCulture).</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Created</th>
                                <th>Fields</th>
                                <th>File</th>
                                <th>Records</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_rows.Count == 0)
                        {
                            <tr><td colspan="5">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr>
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.TimeCreated.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.FieldsInDump) ? row.FieldsInDump : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.FileName) ? row.FileName : "—")</td>
                                    <td>@row.RecordsCount.ToString(CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/content/structure_dumps";
    private bool _isAdmin;
    private CpStructureDumpsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpStructureDumpsRowDigest> _rows = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpStructureDumpsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Dumps;
    }
}
