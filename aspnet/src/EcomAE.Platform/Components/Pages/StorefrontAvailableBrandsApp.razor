@page "/storefront/available-brands-app"
@page "/en/available-brands"
@page "/en/parts"
@layout Layout.PhpChromeLayout
@using System.Net
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject IStorefrontPriceAccess PriceAccess
@inject IHttpContextAccessor Http

<PageTitle>Available brands · eParts Cart</PageTitle>
<PhpChromeStyles Surface="storefront" />
<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontCatalogWidgetBody Title="Available brands"
                            Subtitle="Brands in stock — open a manufacturer to search live articles."
                            AnchorId="epc-brands"
                            Html="@_html"
                            PhpComparePath="@StorefrontPhpCanonical.AvailableBrands">
    <a class="btn btn-sm btn-primary" href="@StorefrontSurfaceLinks.PartSearch">Part search</a>
    <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.OwnCatalog">Own catalog</a>
    <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.UmapiCatalog">Epart Catalog</a>
</StorefrontCatalogWidgetBody>

@code {
    private string _html = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        var cancellation = ctx?.RequestAborted ?? default;

        // First paint must not wait on DISTINCT epc_umapi_manufacturers / synonym joins.
        // When the shop DB is busy those reads take 10–20s and blank /en/parts.
        // The PHP widget HTML + AJAX is the same-to-same home twin and paints immediately.
        if (!ErpFirstPaint.IsActive)
        {
            try
            {
                var cards = await Dashboards.ListStorefrontBrandCardsAsync(cancellation);
                if (cards.Cards.Count > 0)
                {
                    _html = RenderBrandCards(cards.Cards);
                    return;
                }
            }
            catch
            {
                // Fall through to the widget.
            }
        }

        var pricesVisible = false;
        if (ctx is not null)
        {
            try
            {
                var access = await PriceAccess.ResolveAsync(ctx, cancellation);
                pricesVisible = access.PricesVisible;
            }
            catch
            {
                pricesVisible = false;
            }
        }

        _html = PhpHomeWidgetHtml.AvailableBrands(pricesVisible);
        if (string.IsNullOrWhiteSpace(_html))
        {
            _html = "<p style=\"margin:0;color:#64748b\">Available brands widget is unavailable in this environment. "
                  + "<a href=\"" + StorefrontSurfaceLinks.PartSearch + "\">Open part search</a>.</p>";
        }
    }

    private static string RenderBrandCards(IReadOnlyList<StorefrontBrandCard> cards)
    {
        var sb = new System.Text.StringBuilder();
        var countries = cards.Select(c => c.Country).Where(c => c.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(c => c, StringComparer.OrdinalIgnoreCase).ToList();
        if (countries.Count > 1)
        {
            sb.Append("<div style=\"margin:.35rem 0 .75rem\">"
                + "<select id=\"epc-brand-country\" onchange=\""
                + "var v=this.value;var c=document.querySelectorAll('.epc-brand-card');for(var i=0;i<c.length;i++){c[i].style.display=(!v||c[i].getAttribute('data-country')===v)?'':'none';}"
                + "\" style=\"padding:.4rem .6rem;border:1px solid #cbd5e1;border-radius:.4rem\">"
                + "<option value=\"\">All countries (").Append(countries.Count).Append(")</option>");
            foreach (var country in countries)
            {
                sb.Append("<option value=\"").Append(WebUtility.HtmlEncode(country)).Append("\">")
                  .Append(WebUtility.HtmlEncode(country)).Append("</option>");
            }

            sb.Append("</select></div>");
        }

        sb.Append("<div class=\"epc-sf-brand-grid\" style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(10rem,1fr));gap:.55rem\">");
        foreach (var card in cards)
        {
            var safe = WebUtility.HtmlEncode(card.Brand);
            var href = StorefrontSurfaceLinks.PartSearch + "?brend=" + Uri.EscapeDataString(card.Brand);
            var logo = card.MfaId > 0
                ? "/api/umapi_image.php?kind=manufacturer&id=" + card.MfaId
                : "";
            var detail = card.FullName.Length > 0 && !card.FullName.Equals(card.Brand, StringComparison.OrdinalIgnoreCase)
                ? card.FullName
                : card.Country;
            sb.Append("<a class=\"epc-brand-card\" data-country=\"").Append(WebUtility.HtmlEncode(card.Country)).Append("\" href=\"").Append(href)
              .Append("\" style=\"display:flex;flex-direction:column;align-items:center;gap:.3rem;padding:.7rem .6rem;background:#fff;border:1px solid #e2e8f0;border-radius:.4rem;color:#0f172a;text-decoration:none;text-align:center\">");
            if (logo.Length > 0)
            {
                sb.Append("<img src=\"").Append(logo).Append("\" alt=\"").Append(safe)
                  .Append("\" loading=\"lazy\" style=\"width:64px;height:40px;object-fit:contain\" onerror=\"this.style.display='none'\">");
            }

            sb.Append("<span style=\"font-weight:700\">").Append(safe).Append("</span>");
            if (detail.Length > 0)
            {
                sb.Append("<span style=\"font-size:.75rem;color:#64748b\">").Append(WebUtility.HtmlEncode(detail)).Append("</span>");
            }

            sb.Append("</a>");
        }

        sb.Append("</div>");
        return sb.ToString();
    }
}
