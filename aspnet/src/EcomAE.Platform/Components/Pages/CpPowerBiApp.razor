@page "/cp/power-bi-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Power BI · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Power BI
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/power-bi-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/power-bi-app" IsAdmin="_isAdmin" />


    <p class="help-block">@(_summary.Active ? "active" : "off") Config (@(string.IsNullOrWhiteSpace(_summary.SiteKey) ? "—" : _summary.SiteKey)) · @(string.IsNullOrWhiteSpace(_summary.WorkspaceId) ? "—" : _summary.WorkspaceId) Workspace · @(string.IsNullOrWhiteSpace(_summary.AzureTenantId) ? "—" : _summary.AzureTenantId) Azure tenant · @(string.IsNullOrWhiteSpace(_summary.EmbedMode) ? "—" : _summary.EmbedMode) Embed mode · @_reports.Count.ToString(CultureInfo.InvariantCulture) Reports shown.</p>
    @if (!string.IsNullOrWhiteSpace(_summary.EmbedUrl) || !string.IsNullOrWhiteSpace(_summary.Notes))
    {
        <div class="epc-pbi-note">
            <div><strong>Embed URL:</strong> @(string.IsNullOrWhiteSpace(_summary.EmbedUrl) ? "—" : _summary.EmbedUrl)</div>
            <div><strong>Notes:</strong> @(string.IsNullOrWhiteSpace(_summary.Notes) ? "—" : _summary.Notes)</div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Site</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Report id</th>
                    <th>Dataset</th>
                    <th>Embed URL</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_reports.Count == 0)
                {
                    <tr><td colspan="9">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var r in _reports)
                    {
                        <tr>
                            <td><strong>@r.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(r.SiteKey) ? "—" : r.SiteKey)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.ReportName) ? "—" : r.ReportName)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.Category) ? "—" : r.Category)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.ReportId) ? "—" : r.ReportId)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.DatasetId) ? "—" : r.DatasetId)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.EmbedUrl) ? "—" : r.EmbedUrl)</td>
                            <td>@(r.Active ? "yes" : "no")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_power_bi";
    private bool _isAdmin;
    private CpPowerBiConfigSummary _summary = new("", "", "", "", "", "", "none", "", false, 0, "n/a", "");
    private IReadOnlyList<CpPowerBiReportDigest> _reports = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpPowerBiDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _reports = result.Reports;
        _source = result.Source;
        _message = result.Message;
    }
}
