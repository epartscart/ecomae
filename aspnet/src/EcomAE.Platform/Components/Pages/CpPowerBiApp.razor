@page "/cp/power-bi-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ICpPowerBiService PowerBi
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Power BI · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                <i class="fa fa-bar-chart"></i> Power BI
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Connect Microsoft Power BI to live tenant ERP/commerce data via API key — no Azure AD required for Desktop refresh. Secure embed tokens wait until you supply Azure credentials.</p>
                <p style="margin:12px 0 0">
                    <a class="btn btn-default btn-sm" href="/cp/guides-app?g=power-bi"><i class="fa fa-book"></i> Step-by-step guide</a>
                </p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/power-bi-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">What is possible now</div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-6">
                        <h5>Available without Microsoft login</h5>
                        <ul>
                            @foreach (var cap in PowerBiCatalog.AvailableNow)
                            {
                                <li><code>@cap</code></li>
                            }
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Needs your Azure / Power BI Pro</h5>
                        <ul>
                            @foreach (var need in PowerBiCatalog.NeedsCustomerCredentials)
                            {
                                <li><strong>@need.Key</strong> — @need.Why</li>
                            }
                        </ul>
                    </div>
                </div>
                <ol>
                    @foreach (var step in PowerBiCatalog.ConnectGuide)
                    {
                        <li>@step</li>
                    }
                </ol>
                <p>
                    <a class="btn btn-primary btn-sm" href="/cp/guides-app?g=power-bi"><i class="fa fa-book"></i> Open step-by-step guide</a>
                    <a class="btn btn-default btn-sm" href="/cp/api-documentation-app"><i class="fa fa-key"></i> API keys &amp; scopes</a>
                    <a class="btn btn-default btn-sm" href="@(PowerBiCatalog.ApiRoot + "/catalog")" target="_blank" rel="noopener"><i class="fa fa-external-link"></i> Dataset catalog (needs key)</a>
                </p>
            </div>
        </div>
    </div>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Power BI datasets (Web connector)</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr><th>Dataset</th><th>URL</th><th>Formats</th><th>Scope</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var ds in PowerBiCatalog.Datasets)
                            {
                                <tr>
                                    <td>
                                        <strong>@ds.Name</strong><br /><span class="text-muted">@ds.Description</span>
                                        @if (!string.IsNullOrWhiteSpace(ds.Parameters))
                                        {
                                            <br />
                                            <span class="text-muted">Params: @ds.Parameters</span>
                                        }
                                    </td>
                                    <td><code style="word-break:break-all;font-size:11px;">@ds.Path</code></td>
                                    <td>@string.Join(", ", ds.Formats)</td>
                                    <td><code>@ds.Scope</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <pre style="background:#f8fafc;border:1px solid #e2e8f0;padding:12px;border-radius:6px;font-size:12px;">@PowerBiCatalog.CurlExample</pre>
            </div>
        </div>
    </div>

    @if (_isSuper && _tenants.Count > 0)
    {
        <div class="col-lg-12">
            <form method="get" class="form-inline" style="margin-bottom:12px;">
                <label>Tenant</label>
                <select name="site_key" class="form-control input-sm" onchange="this.form.submit()">
                    @foreach (var tenant in _tenants)
                    {
                        @if (tenant.SiteKey == _siteKey)
                        {
                            <option value="@tenant.SiteKey" selected>@TenantLabel(tenant)</option>
                        }
                        else
                        {
                            <option value="@tenant.SiteKey">@TenantLabel(tenant)</option>
                        }
                    }
                </select>
            </form>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div>
    }

    @if (_isAdmin)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Workspace config — @_siteKey</div>
                <div class="panel-body">
                    <form method="post" action="/cp/power-bi/write" class="well">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@_listHref" />
                        <input type="hidden" name="action" value="save_config" />
                        <div class="form-group">
                            <label>Site key</label>
                            <input type="text" class="form-control" name="site_key" value="@_siteKey" />
                        </div>
                        <div class="form-group">
                            <label>Workspace ID</label>
                            <input type="text" class="form-control" name="workspace_id" maxlength="64" value="@_config.WorkspaceId" placeholder="Power BI workspace GUID" />
                        </div>
                        <div class="form-group">
                            <label>Azure tenant ID</label>
                            <input type="text" class="form-control" name="azure_tenant_id" maxlength="64" value="@_config.AzureTenantId" placeholder="Optional — for future embed tokens" />
                        </div>
                        <div class="form-group">
                            <label>Default report ID</label>
                            <input type="text" class="form-control" name="default_report_id" maxlength="64" value="@_config.DefaultReportId" />
                        </div>
                        <div class="form-group">
                            <label>Default dataset ID</label>
                            <input type="text" class="form-control" name="default_dataset_id" maxlength="64" value="@_config.DefaultDatasetId" />
                        </div>
                        <div class="form-group">
                            <label>Embed mode</label>
                            <select class="form-control" name="embed_mode">
                                @foreach (var mode in EmbedModeLabels)
                                {
                                    @if (CurrentEmbedMode == mode.Key)
                                    {
                                        <option value="@mode.Key" selected>@mode.Label</option>
                                    }
                                    else
                                    {
                                        <option value="@mode.Key">@mode.Label</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Embed URL</label>
                            <input type="text" class="form-control" name="embed_url" maxlength="512" value="@_config.EmbedUrl" placeholder="https://app.powerbi.com/view?r=..." />
                        </div>
                        <div class="form-group">
                            <label>Notes</label>
                            <textarea class="form-control" name="notes" rows="2" maxlength="512">@_config.Notes</textarea>
                        </div>
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Save config</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Registered reports</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead><tr><th>Name</th><th>Report ID</th><th>Category</th><th>Embed</th></tr></thead>
                            <tbody>
                                @if (_liveReports.Count == 0)
                                {
                                    <tr><td colspan="4">No reports registered yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var report in _liveReports)
                                    {
                                        <tr>
                                            <td>@report.ReportName</td>
                                            <td><code>@report.ReportId</code></td>
                                            <td>@report.Category</td>
                                            <td>@(string.IsNullOrWhiteSpace(report.EmbedUrl) ? "—" : "yes")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <form method="post" action="/cp/power-bi/write" class="well">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@_listHref" />
                        <input type="hidden" name="action" value="add_report" />
                        <input type="hidden" name="site_key" value="@_siteKey" />
                        <div class="form-group">
                            <label>Report name</label>
                            <input type="text" class="form-control" name="report_name" maxlength="128" required placeholder="Executive finance" />
                        </div>
                        <div class="form-group">
                            <label>Report ID</label>
                            <input type="text" class="form-control" name="report_id" maxlength="64" placeholder="GUID from Power BI" />
                        </div>
                        <div class="form-group">
                            <label>Dataset ID</label>
                            <input type="text" class="form-control" name="dataset_id" maxlength="64" />
                        </div>
                        <div class="form-group">
                            <label>Category</label>
                            <input type="text" class="form-control" name="category" maxlength="32" value="finance" />
                        </div>
                        <div class="form-group">
                            <label>Report embed URL</label>
                            <input type="text" class="form-control" name="report_embed_url" maxlength="512" placeholder="Optional https://app.powerbi.com/..." />
                        </div>
                        <button type="submit" class="btn btn-default"><i class="fa fa-plus"></i> Add report</button>
                    </form>
                    <p class="help-block" style="margin:.75rem 0 0">Azure embed-token minting needs the tenant's own AAD app and Power BI capacity.</p>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Embed preview</div>
                <div class="panel-body">
                    @if (_embed.Ok)
                    {
                        <iframe src="@_embed.Url" title="Power BI" style="width:100%;min-height:520px;border:1px solid #e2e8f0;border-radius:8px;" allowfullscreen></iframe>
                    }
                    else
                    {
                        <div class="alert alert-info" style="margin:0;">
                            <strong>@_embed.Phase</strong> — @_embed.Error
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedReport is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Power BI KPIs">
        <div class="kpi"><div class="lbl">Reports</div><div class="val">@_reports.Count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_reports.Count(r => r.Active).ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Config</div><div class="val">@(_config.Active ? "on" : "off")</div></div>
        <div class="kpi"><div class="lbl">Opened siblings</div><div class="val">@_openedSiblings.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedReport is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedReport.ReportName) ? _openedReport.ReportName : ("Report #" + _openedReport.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(_openedReport.Active ? "active" : "off")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedReport.SiteKey) ? _openedReport.SiteKey : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedReport.Category) ? _openedReport.Category : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedReport.ReportId) ? _openedReport.ReportId : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedReport.DatasetId) ? _openedReport.DatasetId : "—")</p>
                    <p>@(!string.IsNullOrWhiteSpace(_openedReport.EmbedUrl) ? _openedReport.EmbedUrl : "No embed URL yet.")</p>
                    @if (!string.IsNullOrWhiteSpace(_openedReport.CreatedAt))
                    {
                        <p class="text-muted">@_openedReport.CreatedAt</p>
                    }
                    @if (_openedConfig is not null)
                    {
                        <p>@(_openedConfig.Active ? "config on" : "config off")
                            · @(!string.IsNullOrWhiteSpace(_openedConfig.WorkspaceId) ? _openedConfig.WorkspaceId : "—")
                            · @(!string.IsNullOrWhiteSpace(_openedConfig.AzureTenantId) ? _openedConfig.AzureTenantId : "—")
                            · @(!string.IsNullOrWhiteSpace(_openedConfig.EmbedMode) ? _openedConfig.EmbedMode : "none")</p>
                        @if (!string.IsNullOrWhiteSpace(_openedConfig.NotesExcerpt))
                        {
                            <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedConfig.NotesExcerpt</pre>
                            @if (_openedConfig.NotesLen > _openedConfig.NotesExcerpt.Length)
                            {
                                <p class="text-muted">Excerpt only (@_openedConfig.NotesExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedConfig.NotesLen.ToString(CultureInfo.InvariantCulture) chars). Full notes and embed stay on the Classic twin.</p>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No notes excerpt yet.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No notes excerpt yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Category siblings</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Name</th>
                                    <th>Report id</th>
                                    <th>Dataset</th>
                                    <th>Active</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="5">No category siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.ReportName) ? sib.ReportName : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.ReportId) ? sib.ReportId : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.DatasetId) ? sib.DatasetId : "—")</td>
                                            <td>@(sib.Active ? "yes" : "no")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Site</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Report id</th>
                    <th>Dataset</th>
                    <th>Embed URL</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_reports.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var r in _reports)
                    {
                        <tr id="erp-row-@r.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(r.Id, _openedId)">
                            <td><strong>@r.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(r.SiteKey) ? "—" : r.SiteKey)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.ReportName) ? "—" : r.ReportName)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.Category) ? "—" : r.Category)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.ReportId) ? "—" : r.ReportId)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.DatasetId) ? "—" : r.DatasetId)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.EmbedUrl) ? "—" : r.EmbedUrl)</td>
                            <td>@(r.Active ? "yes" : "no")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "pbi_id", r.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_power_bi";
    private const string _listHref = "/cp/power-bi-app";
    private bool _isAdmin;
    private bool _isSuper;
    private string _siteKey = "";
    private CpPowerBiConfig _config = CpPowerBiConfig.Empty("");
    private IReadOnlyList<CpPowerBiReport> _liveReports = [];
    private IReadOnlyList<CpPowerBiTenantOption> _tenants = [];
    private PowerBiEmbedResolution _embed = PowerBiCatalog.ResolveEmbed(false, "none", "");
    private CpPowerBiConfigSummary _summary = new("", "", "", "", "", "", "none", "", false, 0, "n/a", "");
    private IReadOnlyList<CpPowerBiReportDigest> _reports = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private CpPowerBiReportDetail? _openedReport;
    private CpPowerBiSiteConfigExcerpt? _openedConfig;
    private IReadOnlyList<CpPowerBiReportDigest> _openedSiblings = [];
    private string _flashOk = "";
    private string _flashErr = "";

    private static readonly (string Key, string Label)[] EmbedModeLabels =
    [
        ("none", "None (API datasets only)"),
        ("url", "URL iframe (publish-to-web / share link)"),
        ("azure", "Azure embed (needs credentials)"),
    ];

    private string CurrentEmbedMode => CpPowerBiWriteService.NormalizeEmbedMode(_config.EmbedMode);

    private static string TenantLabel(CpPowerBiTenantOption tenant)
        => (string.IsNullOrWhiteSpace(tenant.TradeName) ? tenant.SiteKey : tenant.TradeName)
            + " (" + tenant.SiteKey + ")";

    private string OpenedCaption => _openedReport is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedReport.ReportName)
            ? ("Report #" + _openedReport.Id.ToString(CultureInfo.InvariantCulture))
            : _openedReport.ReportName)
            + (_openedReport.Active ? " · active" : " · off");

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "pbi_id");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        _isSuper = SuperCpHostGate.IsAllowed(ctx);

        var view = await PowerBi.LoadAsync(
            ctx.Request.Query["site_key"].ToString(),
            ctx.Request.Host.Host,
            ctx.RequestAborted);
        _siteKey = view.SiteKey;
        _config = view.Config;
        _liveReports = view.Reports;
        _tenants = view.Tenants;
        _embed = view.Embed;

        var result = await Dashboards.BuildCpPowerBiDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _reports = result.Reports;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpPowerBiReportDetailAsync(_openedId, ctx.RequestAborted);
            _openedReport = detail.Report;
            _openedConfig = detail.SiteConfig;
            _openedSiblings = detail.Siblings;
            if (_openedReport is not null)
            {
                var openedList = _reports.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _reports = new[] { openedList }.Concat(_reports.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
