@page "/cp/power-bi-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Power BI · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-pbi-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-pbi-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-pbi-hero p { margin:0; color:#bae6fd; max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-pbi-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-pbi-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f172a; background:#38bdf8;
        }
        .epc-pbi-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-pbi-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-pbi-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-pbi-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-pbi-kpi span { color:#64748b; font-size:.78rem; }
        .epc-pbi-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-pbi-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-pbi-table th, .epc-pbi-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-pbi-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-pbi-note { margin-top:1rem; padding:.75rem .9rem; background:#ecfeff; border:1px solid #a5f3fc; border-radius:.45rem; color:#155e75; font-size:.86rem; }
        @@media (max-width:900px){ .epc-pbi-kpis{grid-template-columns:1fr;} }
    
</style>
</HeadContent>


<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-pbi-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Power BI</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-pbi-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/cp/mobile-apps-app">Mobile apps</a>
        </div>
    </section>

    <div class="epc-pbi-kpis" aria-label="Power BI config">
        <div class="epc-pbi-kpi"><strong>@(_summary.Active ? "active" : "off")</strong><span>Config (@(string.IsNullOrWhiteSpace(_summary.SiteKey) ? "—" : _summary.SiteKey))</span></div>
        <div class="epc-pbi-kpi"><strong>@(string.IsNullOrWhiteSpace(_summary.WorkspaceId) ? "—" : _summary.WorkspaceId)</strong><span>Workspace</span></div>
        <div class="epc-pbi-kpi"><strong>@(string.IsNullOrWhiteSpace(_summary.AzureTenantId) ? "—" : _summary.AzureTenantId)</strong><span>Azure tenant</span></div>
        <div class="epc-pbi-kpi"><strong>@(string.IsNullOrWhiteSpace(_summary.EmbedMode) ? "—" : _summary.EmbedMode)</strong><span>Embed mode</span></div>
        <div class="epc-pbi-kpi"><strong>@_reports.Count.ToString(CultureInfo.InvariantCulture)</strong><span>Reports shown</span></div>
    </div>
    @if (!string.IsNullOrWhiteSpace(_summary.EmbedUrl) || !string.IsNullOrWhiteSpace(_summary.Notes))
    {
        <div class="epc-pbi-note">
            <div><strong>Embed URL:</strong> @(string.IsNullOrWhiteSpace(_summary.EmbedUrl) ? "—" : _summary.EmbedUrl)</div>
            <div><strong>Notes:</strong> @(string.IsNullOrWhiteSpace(_summary.Notes) ? "—" : _summary.Notes)</div>
        </div>
    }

    <div class="epc-pbi-table-wrap">
        <table class="epc-pbi-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Site</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Report id</th>
                    <th>Dataset</th>
                    <th>Embed URL</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_reports.Count == 0)
                {
                    <tr><td colspan="9">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var r in _reports)
                    {
                        <tr>
                            <td><strong>@r.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(r.SiteKey) ? "—" : r.SiteKey)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.ReportName) ? "—" : r.ReportName)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.Category) ? "—" : r.Category)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.ReportId) ? "—" : r.ReportId)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.DatasetId) ? "—" : r.DatasetId)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.EmbedUrl) ? "—" : r.EmbedUrl)</td>
                            <td>@(r.Active ? "yes" : "no")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_power_bi";
    private bool _isAdmin;
    private CpPowerBiConfigSummary _summary = new("", "", "", "", "", "", "none", "", false, 0, "n/a", "");
    private IReadOnlyList<CpPowerBiReportDigest> _reports = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpPowerBiDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _reports = result.Reports;
        _source = result.Source;
        _message = result.Message;
    }
}
