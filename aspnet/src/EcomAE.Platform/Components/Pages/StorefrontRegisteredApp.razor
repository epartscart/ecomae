@page "/users/registered"
@page "/en/users/registered"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@using Microsoft.AspNetCore.DataProtection
@inject IHttpContextAccessor Http

<PageTitle>Registration · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" LoginChrome="true" />

<StorefrontTenantChrome>
    <section style="padding:2rem 0 3rem">
        <div class="container" style="max-width:48rem">
            @if (_html is null)
            {
                <p>This registration result has expired. <a href="@StorefrontSurfaceLinks.Login">Sign in</a> or <a href="@StorefrontSurfaceLinks.Registration">register</a>.</p>
            }
            else
            {
                @((MarkupString)_html)
            }
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private string? _html;

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx?.Request.Host.Host);
        _html = StorefrontUsersRegisterEndpoints.ReadResult(ctx?.RequestServices.GetService<IDataProtectionProvider>(), ctx?.Request.Query["r"].ToString());
    }
}
