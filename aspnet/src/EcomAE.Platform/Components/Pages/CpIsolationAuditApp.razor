@page "/cp/isolation-audit-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Isolation audit · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Isolation audit
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/isolation-audit-app")</p>
                <p>Open a run for a short report excerpt and same-day violation excerpts. Full report JSON and IP stay on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/isolation-audit-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedRun is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Isolation audit KPIs">
        <div class="kpi"><div class="lbl">Runs</div><div class="val">@_summary.RunCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Failed</div><div class="val">@_summary.FailedRunCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Violations</div><div class="val">@_summary.ViolationCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Opened day</div><div class="val">@_openedViolations.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedRun is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Run #@_openedRun.Id.ToString(CultureInfo.InvariantCulture)
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedRun.TriggeredBy) ? _openedRun.TriggeredBy : "—")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedRun.RunAt) ? _openedRun.RunAt : "—")
                        · @_openedRun.TotalTenants.ToString(CultureInfo.InvariantCulture) tenants
                        · @_openedRun.Passed.ToString(CultureInfo.InvariantCulture) passed
                        · @_openedRun.Failed.ToString(CultureInfo.InvariantCulture) failed
                        · @_openedRun.Warnings.ToString(CultureInfo.InvariantCulture) warnings</p>
                    @if (!string.IsNullOrWhiteSpace(_openedRun.ReportExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedRun.ReportExcerpt</pre>
                        @if (_openedRun.ReportLen > _openedRun.ReportExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_openedRun.ReportExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedRun.ReportLen.ToString(CultureInfo.InvariantCulture) chars). Full report stays on the Classic twin.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No report excerpt yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Same-day violations</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Site</th>
                                    <th>Actor</th>
                                    <th>Detail</th>
                                    <th>When</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedViolations.Count == 0)
                                {
                                    <tr><td colspan="5">No same-day violations yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var v in _openedViolations)
                                    {
                                        <tr>
                                            <td>@v.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(v.SiteKey) ? v.SiteKey : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(v.Actor) ? v.Actor : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(v.DetailExcerpt) ? v.DetailExcerpt : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(v.CreatedAt) ? v.CreatedAt : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Run at</th>
                    <th>Tenants</th>
                    <th>Passed</th>
                    <th>Failed</th>
                    <th>Warnings</th>
                    <th>By</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.RunAt) ? row.RunAt : "—")</td>
                            <td>@row.TotalTenants.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.Passed.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.Failed.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.Warnings.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.TriggeredBy) ? row.TriggeredBy : "—")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "run_id", row.Id)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_commerce_isolation_audit";
    private const string _listHref = "/cp/isolation-audit-app";
    private bool _isAdmin;
    private CpIsolationAuditSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpIsolationAuditRunDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private CpIsolationAuditRunDetail? _openedRun;
    private IReadOnlyList<CpIsolationAuditViolationDigest> _openedViolations = [];

    private string OpenedCaption => _openedRun is null
        ? ""
        : ("Run #" + _openedRun.Id.ToString(CultureInfo.InvariantCulture)
            + (string.IsNullOrWhiteSpace(_openedRun.TriggeredBy) ? "" : (" · " + _openedRun.TriggeredBy)));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "run_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpIsolationAuditDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Runs;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpIsolationAuditRunDetailAsync(_openedId, ctx.RequestAborted);
            _openedRun = detail.Run;
            _openedViolations = detail.Violations;
            if (_openedRun is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
