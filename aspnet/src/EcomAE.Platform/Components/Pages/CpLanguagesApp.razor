@page "/cp/languages-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Languages · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-w22-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-w22-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-w22-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-w22-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-w22-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f172a; background:#fff;
        }
        .epc-w22-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-w22-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-w22-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-w22-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-w22-kpi span { color:#64748b; font-size:.78rem; }
        .epc-w22-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-w22-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-w22-table th, .epc-w22-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-w22-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-w22-note { margin-top:1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:.45rem; color:#334155; font-size:.86rem; }
        @@media (max-width:900px){ .epc-w22-kpis{grid-template-columns:1fr 1fr;} }
    
</style>
</HeadContent>


<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-w22-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Languages</h1>
        <p>@CpPhpModuleCopy.PurposeFor(Nav.Uri)</p>
        <p>Language list digest plus native editor writes. Flags, translation UPSERT, description, and unused-custom delete write on ASP.NET. String create (domain_path key) and used-found scan stay PHP.</p>
        <div class="epc-w22-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
        </div>
    </section>
    <PhpParityModuleBody AppPath="/cp/languages-app" IsAdmin="_isAdmin" />


    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <div style="display:grid;gap:.65rem;margin:0 0 1rem">
            <form method="post" action="/cp/lang/set-is-custom" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/languages-app" />
                <label>String key <input type="text" name="strKey" required maxlength="190" /></label>
                <label>is_custom
                    <select name="isCustom">
                        <option value="1">1 · custom</option>
                        <option value="0">0 · not custom</option>
                    </select>
                </label>
                <button type="submit">Save is_custom</button>
            </form>
            <form method="post" action="/cp/lang/set-is-error" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/languages-app" />
                <label>String key <input type="text" name="strKey" required maxlength="190" /></label>
                <label>is_error
                    <select name="isError">
                        <option value="1">1 · error</option>
                        <option value="0">0 · not error</option>
                    </select>
                </label>
                <button type="submit">Save is_error</button>
            </form>
            <form method="post" action="/cp/lang/set-same" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/languages-app" />
                <label>String key <input type="text" name="strKey" required maxlength="190" /></label>
                <label>same <input type="text" name="same" required placeholder="no or lang code" maxlength="16" /></label>
                <button type="submit">Save same</button>
            </form>
            <form method="post" action="/cp/lang/set-used-found" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/languages-app" />
                <label>String key <input type="text" name="strKey" required maxlength="190" /></label>
                <label>used_found
                    <select name="usedFound">
                        <option value="0">0 · unknown</option>
                        <option value="1">1 · found</option>
                        <option value="2">2 · not found</option>
                    </select>
                </label>
                <button type="submit">Save used_found</button>
            </form>
            <form method="post" action="/cp/lang/save-translation" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/languages-app" />
                <label>String key <input type="text" name="strKey" required maxlength="190" /></label>
                <label>Lang <input type="text" name="langCode" required maxlength="16" placeholder="en" /></label>
                <label>Translation <input type="text" name="value" required maxlength="8000" style="width:18rem" /></label>
                <button type="submit">Save translation</button>
            </form>
            <form method="post" action="/cp/lang/save-description" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/languages-app" />
                <label>String key <input type="text" name="strKey" required maxlength="190" /></label>
                <label>Description <input type="text" name="value" required maxlength="8000" style="width:18rem" /></label>
                <button type="submit">Save description</button>
            </form>
            <form method="post" action="/cp/lang/delete-not-used" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/languages-app" />
                <button type="submit">Delete unused custom strings</button>
            </form>
        </div>
    }

    <div class="epc-w22-kpis" aria-label="Languages stats">
        <div class="epc-w22-kpi"><strong>@_summary.LanguageCount.ToString(CultureInfo.InvariantCulture)</strong><span>Languages</span></div>
        <div class="epc-w22-kpi"><strong>@_summary.ActiveCount.ToString(CultureInfo.InvariantCulture)</strong><span>Active</span></div>
        <div class="epc-w22-kpi"><strong>@_summary.DefaultCount.ToString(CultureInfo.InvariantCulture)</strong><span>Default</span></div>
        <div class="epc-w22-kpi"><strong>@_summary.InactiveCount.ToString(CultureInfo.InvariantCulture)</strong><span>Inactive</span></div>
    </div>

    <div class="epc-w22-table-wrap">
    <table class="epc-w22-table">
        <thead>
            <tr>
                    <th>Code</th>
                    <th>Active</th>
                    <th>Default</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="4">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                                                        <td>@(!string.IsNullOrWhiteSpace(row.LangCode) ? row.LangCode : "—")</td>
                            <td>@row.Active.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.IsDefault.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/lang";
    private bool _isAdmin;
    private CpLanguagesSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpLanguagesRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpLanguagesDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Languages;
        _source = result.Source;
        _message = result.Message;
    }
}
