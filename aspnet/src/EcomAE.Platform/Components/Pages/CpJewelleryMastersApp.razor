@page "/erp/jewellery-masters-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject IErpGoldRateSetWriteService GoldRates
@inject IErpJwGoldSchemeWriteService GoldSchemes
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Jewellery masters · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="@_spec.Title" BreadcrumbArea="Jewellery" BreadcrumbTab="@_spec.Label">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="@_appPath" IsAdmin="_isAdmin" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />
    <PhpErpModulePageHeader Title="@_spec.Title" Subtitle="@_spec.Subtitle" />
    <ErpPhpFlash Ok="@_ok" Err="@_err" />
    <ErpJewelleryReportsMenu />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Jewellery master KPIs">
        <div class="kpi"><div class="lbl">Karats</div><div class="val">@_summary.KaratCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Rate types</div><div class="val">@_summary.RateTypeCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Barcodes</div><div class="val">@_summary.BarcodeCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Diamonds</div><div class="val">@_summary.DiamondCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong> <a class="btn btn-xs btn-default" href="@_listHref">Close</a></p>
            <dl class="epc-erp-facts">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Karat</dt><dd>@(string.IsNullOrWhiteSpace(_opened.KaratCode) ? "—" : _opened.KaratCode)</dd>
                <dt>Division</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Division) ? "—" : _opened.Division)</dd>
                <dt>STD. Purity</dt><dd>@_opened.StdPurity.ToString("N6", CultureInfo.InvariantCulture)</dd>
                <dt>Range from</dt><dd>@_opened.RangeFrom.ToString("N6", CultureInfo.InvariantCulture)</dd>
                <dt>Range to</dt><dd>@_opened.RangeTo.ToString("N6", CultureInfo.InvariantCulture)</dd>
                <dt>Sp gravity</dt><dd>@_opened.SpGravity.ToString("N4", CultureInfo.InvariantCulture)</dd>
                <dt>POS rate</dt><dd>@_opened.PosRateMinMax.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Created date</dt><dd>@(string.IsNullOrWhiteSpace(_opened.CreatedAt) ? "—" : _opened.CreatedAt)</dd>
                <dt>Created by</dt><dd>@(string.IsNullOrWhiteSpace(_opened.CreatedBy) || _opened.CreatedBy == "—" ? "—" : _opened.CreatedBy)</dd>
            </dl>
            @if (!string.IsNullOrWhiteSpace(_opened.DescriptionExcerpt))
            {
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:.85rem 0 0">@_opened.DescriptionExcerpt</pre>
                @if (_opened.DescriptionLen > _opened.DescriptionExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.DescriptionExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.DescriptionLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No description excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-division siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Karat</th>
                            <th>Division</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.KaratCode) ? "—" : sib.KaratCode)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Division) ? "—" : sib.Division)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "karat_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-division siblings yet.</p>
            }
        </div>
    }

    <ErpPhpViewTabs QueryName="tab" Active="@_tab" BaseHref="@_tabBase" Tabs="@ErpJewelleryModuleChrome.MasterTabs" />

    @if (_isAdmin && _tab == "jw_karat")
    {
        <ErpPhpCreateWell Title="Add / Edit Karat">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryKaratSaveForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <label>Karat Code <input class="form-control input-sm" name="karat_code" required placeholder="22" /></label>
                <label>Description <input class="form-control input-sm" name="description" placeholder="22 Karat" /></label>
                <label>Division
                    <select class="form-control input-sm" name="division">
                        <option value="G">G Gold</option>
                        <option value="D">D Diamond</option>
                        <option value="S">S Silver</option>
                    </select>
                </label>
                <label>STD. Purity <input class="form-control input-sm" name="std_purity" type="number" step="0.000001" value="0.917000" /></label>
                <label>Range From <input class="form-control input-sm" name="range_from" type="number" step="0.000001" value="0.916000" /></label>
                <label>Range To <input class="form-control input-sm" name="range_to" type="number" step="0.000001" value="0.918000" /></label>
                <label>Sp Gravity <input class="form-control input-sm" name="sp_gravity" type="number" step="0.0001" value="0" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save karat</button>
            </form>
        </ErpPhpCreateWell>
        @if (_rows.Count == 0)
        {
            <form method="post" action="@EcomAeRoutes.ErpJewelleryKaratSeedForm" style="margin-bottom:10px;">
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <button type="submit" class="btn btn-success btn-sm">Seed defaults</button>
            </form>
        }
    }
    else if (_isAdmin && _tab == "gold_rate")
    {
        <ErpPhpCreateWell Title="Today's 24K base">
            <form method="post" action="@WriteAction("/erp/gold-rate/daily")" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <input type="hidden" name="source" value="daily" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <label>Date <input class="form-control input-sm" name="rate_date" type="date" value="@DateTime.UtcNow.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" /></label>
                <ErpMasterPicker Kind="jw-currency" FieldName="currency" Label="Currency" ValueMode="code" InputId="jw-masters-139" SelectedCode="AED" />
                <label>24K buy <input class="form-control input-sm" name="base_buy" type="number" step="0.0001" min="0" /></label>
                <label>24K sell <input class="form-control input-sm" name="base_sell" type="number" step="0.0001" min="0" /></label>
                <label>Unit
                    <select class="form-control input-sm" name="unit">
                        <option value="gram">gram</option>
                        <option value="ounce">ounce</option>
                        <option value="tola">tola</option>
                        <option value="kg">kg</option>
                    </select>
                </label>
                <button type="submit" class="btn btn-primary btn-sm">Publish daily rates</button>
            </form>
        </ErpPhpCreateWell>
        <ErpPhpCreateWell Title="One karat override">
            <form method="post" action="@WriteAction("/erp/gold-rate/set")" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <input type="hidden" name="source" value="manual" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <ErpMasterPicker Kind="jw-karat" FieldName="karat" Label="Karat" ValueMode="code" InputId="jw-masters-162" SelectedCode="24" />
                <ErpMasterPicker Kind="jw-currency" FieldName="currency" Label="Currency" ValueMode="code" InputId="jw-masters-163" SelectedCode="AED" />
                <label>Buy <input class="form-control input-sm" name="buy_rate" type="number" step="0.0001" min="0" /></label>
                <label>Sell <input class="form-control input-sm" name="sell_rate" type="number" step="0.0001" min="0" /></label>
                <label>Unit
                    <select class="form-control input-sm" name="unit">
                        <option value="gram">gram</option>
                        <option value="ounce">ounce</option>
                        <option value="tola">tola</option>
                        <option value="kg">kg</option>
                    </select>
                </label>
                <button type="submit" class="btn btn-default btn-sm">Set rate</button>
            </form>
        </ErpPhpCreateWell>
        <p class="text-muted">Today's sell rate applies on jewellery invoices and barcode purchases when the document metal rate is blank. Sample-page demo figures are not shown as KPIs. Yesterday's board rolls forward automatically until you publish a new day.</p>
    }
    else if (_isAdmin && _tab == "gold_scheme")
    {
        <ErpPhpCreateWell Title="Create scheme">
            <form method="post" action="@WriteAction(EcomAeRoutes.ErpJewelleryGoldSchemeCreateForm)" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <label>Scheme code <input class="form-control input-sm" name="scheme_code" required placeholder="GS-11" maxlength="32" /></label>
                <label>Name <input class="form-control input-sm" name="scheme_name" placeholder="11-month value" /></label>
                <label>Type
                    <select class="form-control input-sm" name="scheme_type">
                        <option value="value">Value</option>
                        <option value="gram">Gram</option>
                    </select>
                </label>
                <label>Months <input class="form-control input-sm" name="maturity_months" type="number" min="1" value="11" /></label>
                <label>Bonus
                    <select class="form-control input-sm" name="bonus_type">
                        <option value="free_month">Free month</option>
                        <option value="free_making">Free making</option>
                        <option value="discount_pct">Discount %</option>
                        <option value="bonus_gram">Bonus gram</option>
                        <option value="none">None</option>
                    </select>
                </label>
                <label>Min instalment <input class="form-control input-sm" name="min_installment" type="number" step="0.01" value="500" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Create scheme</button>
            </form>
        </ErpPhpCreateWell>
        <ErpPhpCreateWell Title="Enroll customer">
            <form method="post" action="@WriteAction(EcomAeRoutes.ErpJewelleryGoldSchemeEnrollForm)" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <label>Scheme id <input class="form-control input-sm" name="scheme_id" type="number" min="1" required /></label>
                <ErpMasterPicker Kind="customer" FieldName="customer_name" InputId="jw-scheme-customer" Label="Customer" ValueMode="name" />
                <label>Instalment <input class="form-control input-sm" name="installment_amount" type="number" step="0.01" value="0" /></label>
                <label>Start date <input class="form-control input-sm" name="start_date" type="date" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Enroll customer</button>
            </form>
        </ErpPhpCreateWell>
        <ErpPhpCreateWell Title="Pay instalment">
            <form method="post" action="@WriteAction(EcomAeRoutes.ErpJewelleryGoldSchemePayForm)" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <label>Enrollment id <input class="form-control input-sm" name="enrollment_id" type="number" min="1" required /></label>
                <label>Amount <input class="form-control input-sm" name="amount" type="number" step="0.01" value="0" /></label>
                <label>Mode <input class="form-control input-sm" name="payment_mode" value="cash" /></label>
                <label>Gold rate <input class="form-control input-sm" name="gold_rate" type="number" step="0.0001" value="0" /></label>
                <label>Receipt <input class="form-control input-sm" name="receipt_no" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Pay instalment</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "jw_rate_type")
    {
        <ErpPhpCreateWell Title="Add / Edit Rate type">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryRateTypeSaveForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <label>Metal
                    <select class="form-control input-sm" name="metal">
                        <option value="G">G Gold</option>
                        <option value="S">S Silver</option>
                        <option value="T">T Platinum</option>
                    </select>
                </label>
                <label>Rate type <input class="form-control input-sm" name="rate_type" required placeholder="GMS" /></label>
                <ErpMasterPicker Kind="jw-currency" FieldName="currency" Label="Currency" ValueMode="code" InputId="jw-masters-253" SelectedCode="AED" />
                <label>Conv factor <input class="form-control input-sm" name="conv_factor" type="number" step="0.000001" value="1" /></label>
                <label>Conv oz <input class="form-control input-sm" name="conv_factor_oz" type="number" step="0.0001" value="31.1035" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save rate type</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "jw_currency")
    {
        <ErpPhpCreateWell Title="Add / Edit Currency">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryCurrencySaveForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <label>Currency code <input class="form-control input-sm" name="curr_code" required placeholder="AED" maxlength="5" /></label>
                <label>Description <input class="form-control input-sm" name="description" placeholder="U.A.E. Dirhams" /></label>
                <label>Fraction <input class="form-control input-sm" name="fraction" placeholder="FILLS" /></label>
                <label>Symbol <input class="form-control input-sm" name="symbol" placeholder="Dh" style="width:70px;" /></label>
                <label>Conv rate <input class="form-control input-sm" name="conv_rate" type="number" step="0.000001" value="1" /></label>
                <label>Min conv <input class="form-control input-sm" name="min_conv_rate" type="number" step="0.000001" value="1" /></label>
                <label>Max conv <input class="form-control input-sm" name="max_conv_rate" type="number" step="0.000001" value="1" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save currency</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "jw_diamond")
    {
        <ErpPhpCreateWell Title="Add / Edit Diamond">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryDiamondSaveForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <label>Item code <input class="form-control input-sm" name="item_code" required placeholder="DIA-001" maxlength="20" /></label>
                <label>RFID <input class="form-control input-sm" name="rfid" maxlength="30" /></label>
                <label>Description <input class="form-control input-sm" name="description" placeholder="Round brilliant" /></label>
                <ErpMasterPicker Kind="jw-design" FieldName="design" Label="Design" ValueMode="code" InputId="jw-masters-294" />
                <label>Category <input class="form-control input-sm" name="category" /></label>
                <label>Sub category <input class="form-control input-sm" name="sub_category" /></label>
                <label>Type <input class="form-control input-sm" name="type" /></label>
                <label>Brand <input class="form-control input-sm" name="brand" /></label>
                <label>Color <input class="form-control input-sm" name="color" placeholder="G" /></label>
                <label>Clarity <input class="form-control input-sm" name="clarity" placeholder="VS1" /></label>
                <label>Fluorescence <input class="form-control input-sm" name="fluorescence" /></label>
                <label>Style <input class="form-control input-sm" name="style" /></label>
                <label>Set ref <input class="form-control input-sm" name="set_ref" /></label>
                <label>Country <input class="form-control input-sm" name="country" value="UAE" /></label>
                <label>Vendor <input class="form-control input-sm" name="vendor" /></label>
                <label>Vendor ref <input class="form-control input-sm" name="vendor_ref" /></label>
                <ErpMasterPicker Kind="jw-currency" FieldName="currency" Label="Currency" ValueMode="code" InputId="jw-masters-307" SelectedCode="AED" />
                <label>Currency rate <input class="form-control input-sm" name="currency_rate" type="number" step="0.00001" value="1" /></label>
                <ErpMasterPicker Kind="jw-cc" FieldName="cost_centre" Label="Cost centre" ValueMode="code" InputId="jw-masters-309" AllowNew="true" />
                <label>Cost <input class="form-control input-sm" name="cost_amount" type="number" step="0.01" value="0" /></label>
                <label>Gross wt <input class="form-control input-sm" name="item_gr_wt" type="number" step="0.0001" value="0" /></label>
                <label>Pure wt <input class="form-control input-sm" name="pure_wt" type="number" step="0.0001" value="0" /></label>
                <label>Cust SKU <input class="form-control input-sm" name="cust_sku" /></label>
                <label>Ageing date <input class="form-control input-sm" name="ageing_date" type="date" /></label>
                <label>Certificate no <input class="form-control input-sm" name="certificate_no" /></label>
                <label>Certificate date <input class="form-control input-sm" name="certificate_date" type="date" /></label>
                <label>Certificate by <input class="form-control input-sm" name="certificate_by" /></label>
                <label>Certificate no 1 <input class="form-control input-sm" name="certificate_no_1" /></label>
                <label>Certificate date 1 <input class="form-control input-sm" name="certificate_date_1" type="date" /></label>
                <label>No. of certificates <input class="form-control input-sm" name="no_of_certificates" type="number" min="0" value="0" /></label>
                <label>Setting charge <input class="form-control input-sm" name="setting_charge" type="number" step="0.01" value="0" /></label>
                <label>Polishing charge <input class="form-control input-sm" name="polishing_charge" type="number" step="0.01" value="0" /></label>
                <label>Rhodium charge <input class="form-control input-sm" name="rhodium_charge" type="number" step="0.01" value="0" /></label>
                <label>Labour charge <input class="form-control input-sm" name="labour_charge" type="number" step="0.01" value="0" /></label>
                <label>Misc charge <input class="form-control input-sm" name="misc_charge" type="number" step="0.01" value="0" /></label>
                <label>Landed cost <input class="form-control input-sm" name="landed_cost" type="number" step="0.01" value="0" /></label>
                <label>Foreign cost <input class="form-control input-sm" name="foreign_cost" type="number" step="0.01" value="0" /></label>
                <label>Cost difference <input class="form-control input-sm" name="cost_difference" type="number" step="0.01" value="0" /></label>
                <label>Price 1 code <input class="form-control input-sm" name="price1_code" value="TAG" /></label>
                <label>Price 1 % <input class="form-control input-sm" name="price1_pct" type="number" step="0.01" value="0" /></label>
                <label>Price 1 FC <input class="form-control input-sm" name="price1_fc" type="number" step="0.01" value="0" /></label>
                <label>Price 1 LC <input class="form-control input-sm" name="price1_lc" type="number" step="0.01" value="0" /></label>
                <label>Price 2 code <input class="form-control input-sm" name="price2_code" value="GEN" /></label>
                <label>Price 2 % <input class="form-control input-sm" name="price2_pct" type="number" step="0.01" value="0" /></label>
                <label>Price 2 FC <input class="form-control input-sm" name="price2_fc" type="number" step="0.01" value="0" /></label>
                <label>Price 2 LC <input class="form-control input-sm" name="price2_lc" type="number" step="0.01" value="0" /></label>
                <label><input type="checkbox" name="exclude_gst_metal" value="1" /> Exclude GST metal</label>
                <label><input type="checkbox" name="trn_on_margin" value="1" /> TRN on margin</label>
                <label><input type="checkbox" name="uae_trn_item" value="1" /> UAE TRN item</label>
                <button type="submit" class="btn btn-primary btn-sm">Save diamond</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "jw_design")
    {
        <ErpPhpCreateWell Title="Add / Edit Design">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryDesignSaveForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <label>Design code <input class="form-control input-sm" name="design_code" required placeholder="DSN-001" maxlength="20" /></label>
                <label>Description <input class="form-control input-sm" name="description" placeholder="Solitaire ring" /></label>
                <label>Category <input class="form-control input-sm" name="category" /></label>
                <label>Type <input class="form-control input-sm" name="type" /></label>
                <ErpMasterPicker Kind="jw-currency" FieldName="currency" Label="Currency" ValueMode="code" InputId="jw-masters-358" SelectedCode="AED" />
                <label>Cost <input class="form-control input-sm" name="cost_amount" type="number" step="0.01" value="0" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save design</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "jw_pearl")
    {
        <ErpPhpCreateWell Title="Add / Edit Pearl">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryPearlSaveForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
