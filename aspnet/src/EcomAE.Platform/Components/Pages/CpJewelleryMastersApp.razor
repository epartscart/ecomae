    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Karat, rate-type, currency, diamond, design, pearl and color-stone, barcode and tag rows bind from the master tables <code>epc_jewel_karat_master</code>, <code>epc_jewel_rate_type</code> and <code>epc_jewel_currency</code>. Daily gold rates write <code>epc_gold_rates</code> and apply on invoices when the document metal rate is blank. Karat, rate-type, currency, diamond, design, pearl, color-stone, barcode generate, tag create/sell, gold-scheme create/enroll/pay, and daily gold rate are live when confirmed. Seed is not available on this page.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private int _company;
    private string _tab = "jw_karat";
    private string _appPath = "/erp/jewellery-masters-app";
    private string _tabBase = "/erp/jewellery-masters-app";
    private string _returnHere = "/erp/jewellery-masters-app?tab=jw_karat";
    private ErpJewelleryModuleChrome.TabSpec _spec = ErpJewelleryModuleChrome.MasterSpec("jw_karat");
    private CpJewelleryMastersSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpJewelleryMastersKaratDigest> _rows = [];
    private IReadOnlyList<CpJewelleryMastersRateTypeDigest> _rateTypes = [];
    private IReadOnlyList<CpJewelleryMastersCurrencyDigest> _currencies = [];
    private IReadOnlyList<CpJewelleryMastersDiamondDigest> _diamonds = [];
    private IReadOnlyList<CpJewelleryMastersDesignDigest> _designs = [];
    private IReadOnlyList<CpJewelleryMastersPearlDigest> _pearls = [];
    private IReadOnlyList<CpJewelleryMastersColorStoneDigest> _colorStones = [];
    private IReadOnlyList<CpJewelleryMastersBarcodeDigest> _barcodeRows = [];
    private IReadOnlyList<CpJewelleryMastersTagDigest> _tags = [];
    private IReadOnlyList<ErpGoldRateRow> _goldToday = [];
    private IReadOnlyList<ErpGoldRateDayPivot> _goldHistory = [];
    private IReadOnlyList<ErpGoldSchemeRow> _goldSchemes = [];
    private IReadOnlyList<KaratRow> _karatDisplay = [];
    private string _source = "n/a";
    private string _message = "";
    private string _ok = "";
    private string _err = "";
    private string _listHref = "/erp/jewellery-masters-app";
    private long _openedId;
    private CpJewelleryMastersKaratDetail? _opened;
    private IReadOnlyList<CpJewelleryMastersKaratDigest> _openedSiblings = [];

    private sealed record KaratRow(string No, CpJewelleryMastersKaratDigest Row);

    private string OpenedCaption =>
        !string.IsNullOrWhiteSpace(_opened?.KaratCode)
            ? _opened.KaratCode
            : (_openedId > 0 ? ("Karat #" + _openedId.ToString(CultureInfo.InvariantCulture)) : "");

    private string ReturnHref =>
        _openedId > 0
            ? _listHref + "?karat_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
            : _returnHere;

    private string WriteAction(string path)
        => ClientErpPath.PrefixIfBound(Http.HttpContext, path);

    private static bool IsStaleProvisionFlash(string err)
        => err.Contains("tables are not provisioned", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var path = ctx.Request.Path.Value ?? "/erp/jewellery-masters-app";
        _appPath = path.StartsWith("/erp/", StringComparison.OrdinalIgnoreCase)
            ? "/erp/jewellery-masters-app"
            : "/erp/jewellery-masters-app";
        _listHref = _appPath;
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "karat_id");
        _company = ErpJewelleryModuleChrome.CompanyFromQuery(ctx.Request.Query["company"].ToString());
        _tab = ErpJewelleryModuleChrome.NormalizeTab(ctx.Request.Query["tab"].ToString(), ErpJewelleryModuleChrome.MasterTabs, "jw_karat");
        _ok = ctx.Request.Query["ok"].ToString();
        _err = ctx.Request.Query["err"].ToString();
        _spec = ErpJewelleryModuleChrome.MasterSpec(_tab);
        _tabBase = ErpJewelleryModuleChrome.AppHref(_appPath, _company);
        _returnHere = ErpJewelleryModuleChrome.AppHref(_appPath, _company, ("tab", _tab));

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = ErpJewelleryModuleChrome.HasJewelleryStaffAccess(session);
        if (!_isAdmin)
        {
            _message = "Sign in with ERP or Control Panel capability for live rows.";
            return;
        }

        var result = await Dashboards.BuildCpJewelleryMastersDigestAsync(200, _company, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Karats;
        _rateTypes = result.RateTypes;
        _currencies = result.Currencies;
        _diamonds = result.Diamonds;
        _designs = result.Designs;
        _pearls = result.Pearls;
        _colorStones = result.ColorStones;
        _barcodeRows = result.BarcodeRows;
        _tags = result.Tags;
        _karatDisplay = _rows.Select((r, i) => new KaratRow((i + 1).ToString(CultureInfo.InvariantCulture), r)).ToList();
        _source = result.Source;
        _message = result.Message;
        if (_tab == "gold_rate")
        {
            var board = await GoldRates.LoadBoardAsync(_company, "AED", 30, ctx.RequestAborted);
            _goldToday = board.Today;
            _goldHistory = board.History;
            if (!string.IsNullOrWhiteSpace(board.Message))
            {
                _message = board.Message;
            }

            _source = board.Source;
            if (_goldToday.Count > 0)
            {
                _spec = _spec with
                {
                    Columns = ["No.", "Karat", "Buy", "Sell", "Unit", "Source", "Created date", "Created by"]
                };
            }

            if (IsStaleProvisionFlash(_err) && !board.Message.Contains("not provisioned", StringComparison.OrdinalIgnoreCase))
            {
                _err = "";
            }
        }
        else if (_tab == "gold_scheme")
        {
            var board = await GoldSchemes.LoadBoardAsync(_company, ctx.RequestAborted);
            _goldSchemes = board.Schemes;
            if (!string.IsNullOrWhiteSpace(board.Message))
            {
                _message = board.Message;
            }

            _source = board.Source;
            if (IsStaleProvisionFlash(_err) && !board.Message.Contains("not provisioned", StringComparison.OrdinalIgnoreCase))
            {
                _err = "";
            }
        }
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpJewelleryMastersDetailAsync(_openedId, _company, ctx.RequestAborted);
            _opened = detail.Karat;
            _openedSiblings = detail.Siblings;
        }
    }
}
