@page "/cp/parts-agent-chats-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject ICpPartsAgentWriteService Writes
@inject IHttpContextAccessor Http

<PageTitle>Parts Agent Chats · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Parts Agent Chats
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/parts-agent-chats-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/parts-agent-chats-app" IsAdmin="_isAdmin" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/parts-agent/save-config" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/parts-agent-chats-app" />
            <label>Enabled
                <select name="enabled">
                    @if (_cfg.Enabled)
                    {
                        <option value="1" selected>yes</option>
                        <option value="0">no</option>
                    }
                    else
                    {
                        <option value="1">yes</option>
                        <option value="0" selected>no</option>
                    }
                </select>
            </label>
            <label>Agent name <input type="text" name="agent_name" maxlength="128" value="@_cfg.AgentName" /></label>
            <label>Subtitle <input type="text" name="subtitle" maxlength="255" value="@_cfg.Subtitle" /></label>
            <label>Greeting <input type="text" name="greeting" value="@_cfg.Greeting" /></label>
            <label>Teaser <input type="text" name="teaser_text" maxlength="255" value="@_cfg.TeaserText" /></label>
            <label>Placeholder <input type="text" name="placeholder" maxlength="255" value="@_cfg.Placeholder" /></label>
            <label>Logo URL <input type="text" name="logo_url" maxlength="512" value="@_cfg.LogoUrl" /></label>
            <label>Domain <input type="text" name="domain" maxlength="255" value="@_cfg.Domain" /></label>
            <label style="flex:1 1 100%">Prompt
                <textarea name="system_prompt" rows="3" style="width:100%;display:block">@_cfg.SystemPrompt</textarea>
            </label>
            <button type="submit">Save config</button>
        </form>
        <p class="help-block" style="margin:0 0 1rem">Chat, sync, and export stay Classic. This page does not invent a send.</p>
    }

    <p class="help-block">@(_summary.Enabled ? "on" : "off") Agent @(string.IsNullOrWhiteSpace(_summary.AgentName) ? "—" : _summary.AgentName) · @_summary.TotalSessions.ToString(CultureInfo.InvariantCulture) Total sessions (@_summary.SessionsToday.ToString(CultureInfo.InvariantCulture) today) · @_summary.MessagesToday.ToString(CultureInfo.InvariantCulture) Messages today · @_summary.LoggedInSessions.ToString(CultureInfo.InvariantCulture) logged / @_summary.GuestSessions.ToString(CultureInfo.InvariantCulture) guest.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>Session</th>
                    <th>Updated</th>
                    <th>Msgs</th>
                    <th>Country</th>
                    <th>User</th>
                    <th>Last user</th>
                    <th>Last agent</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_sessions.Count == 0)
                {
                    <tr><td colspan="8">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var s in _sessions)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(s.SessionId) ? "—" : s.SessionId)</strong></td>
                            <td>@(s.UpdatedAt > 0 ? s.UpdatedAt.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@s.MessageCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(s.CountryName) ? (string.IsNullOrWhiteSpace(s.CountryCode) ? "—" : s.CountryCode) : s.CountryName)</td>
                            <td>@(s.UserId > 0 ? s.UserId.ToString(CultureInfo.InvariantCulture) : "guest")</td>
                            <td>@(string.IsNullOrWhiteSpace(s.LastUserText) ? "—" : s.LastUserText)</td>
                            <td>@(string.IsNullOrWhiteSpace(s.LastAgentText) ? "—" : s.LastAgentText)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/parts_agent/parts_agent_chats";
    private bool _isAdmin;
    private CpPartsAgentSummary _summary = new(0, 0, 0, 0, 0, false, "", "", "n/a", "");
    private IReadOnlyList<CpPartsAgentSessionDigest> _sessions = [];
    private CpPartsAgentConfigRow _cfg = new(true, "", "", "", "", "", "", "", "");
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpPartsAgentDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _sessions = result.Sessions;
        _source = result.Source;
        _message = result.Message;
        _cfg = await Writes.LoadConfigAsync(ctx.RequestAborted);
    }
}
