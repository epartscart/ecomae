@page "/cp/parts-agent-chats-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Parts Agent Chats · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-pa-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-pa-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-pa-hero p { margin:0; color:#ddd6fe; max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-pa-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-pa-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#4c1d95; background:#e0f2fe;
        }
        .epc-pa-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-pa-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-pa-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-pa-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-pa-kpi span { color:#64748b; font-size:.78rem; }
        .epc-pa-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-pa-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-pa-table th, .epc-pa-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-pa-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-pa-note { margin-top:1rem; padding:.75rem .9rem; background:#f5f3ff; border:1px solid #c4b5fd; border-radius:.45rem; color:#5b21b6; font-size:.86rem; }
        @@media (max-width:900px){ .epc-pa-kpis{grid-template-columns:1fr;} }
    
</style>
</HeadContent>


<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-pa-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Parts Agent Chats</h1>
        <p>@CpPhpModuleCopy.PurposeFor(Nav.Uri)</p>
        <div class="epc-pa-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/cp/metabase-app">Metabase</a>
        </div>
    </section>
    <PhpParityModuleBody AppPath="/cp/parts-agent-chats-app" IsAdmin="_isAdmin" />


    <div class="epc-pa-kpis" aria-label="Parts agent stats">
        <div class="epc-pa-kpi"><strong>@(_summary.Enabled ? "on" : "off")</strong><span>Agent @(string.IsNullOrWhiteSpace(_summary.AgentName) ? "—" : _summary.AgentName)</span></div>
        <div class="epc-pa-kpi"><strong>@_summary.TotalSessions.ToString(CultureInfo.InvariantCulture)</strong><span>Total sessions (@_summary.SessionsToday.ToString(CultureInfo.InvariantCulture) today)</span></div>
        <div class="epc-pa-kpi"><strong>@_summary.MessagesToday.ToString(CultureInfo.InvariantCulture)</strong><span>Messages today · @_summary.LoggedInSessions.ToString(CultureInfo.InvariantCulture) logged / @_summary.GuestSessions.ToString(CultureInfo.InvariantCulture) guest</span></div>
    </div>

    <div class="epc-pa-table-wrap">
        <table class="epc-pa-table">
            <thead>
                <tr>
                    <th>Session</th>
                    <th>Updated</th>
                    <th>Msgs</th>
                    <th>Country</th>
                    <th>User</th>
                    <th>Last user</th>
                    <th>Last agent</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_sessions.Count == 0)
                {
                    <tr><td colspan="8">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var s in _sessions)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(s.SessionId) ? "—" : s.SessionId)</strong></td>
                            <td>@(s.UpdatedAt > 0 ? s.UpdatedAt.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@s.MessageCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(s.CountryName) ? (string.IsNullOrWhiteSpace(s.CountryCode) ? "—" : s.CountryCode) : s.CountryName)</td>
                            <td>@(s.UserId > 0 ? s.UserId.ToString(CultureInfo.InvariantCulture) : "guest")</td>
                            <td>@(string.IsNullOrWhiteSpace(s.LastUserText) ? "—" : s.LastUserText)</td>
                            <td>@(string.IsNullOrWhiteSpace(s.LastAgentText) ? "—" : s.LastAgentText)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/parts_agent/parts_agent_chats";
    private bool _isAdmin;
    private CpPartsAgentSummary _summary = new(0, 0, 0, 0, 0, false, "", "", "n/a", "");
    private IReadOnlyList<CpPartsAgentSessionDigest> _sessions = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpPartsAgentDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _sessions = result.Sessions;
        _source = result.Source;
        _message = result.Message;
    }
}
