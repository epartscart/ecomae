@page "/cp/parts-agent-chats-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ICpPartsAgentDeskService Desk
@inject ILegacySessionValidator Sessions
@inject ICpPartsAgentWriteService Writes
@inject IHttpContextAccessor Http

<PageTitle>AI Parts Expert — chats · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel epc-agent-cp-frame">
            <div class="panel-heading hbuilt">
                <span class="label label-info">Shop</span> AI Parts Expert — chats
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Review storefront conversations, sync temp sessions into the database, and tune agent branding.</p>
                <div class="epc-agent-cp__toolbar" role="toolbar">
                    <a class="btn btn-sm btn-primary" href="/cp/prices-upload-app"><i class="fa fa-tags"></i> Price list toggles</a>
                    <a class="btn btn-sm btn-default" href="/cp/product-catalogue-app"><i class="fa fa-sitemap"></i> Catalogue</a>
                    <a class="btn btn-sm btn-default" href="@ExportHref()"><i class="fa fa-download"></i> Export CSV</a>
                    <a class="btn btn-sm btn-default" href="/cp/parts-agent-chats-app"><i class="fa fa-undo"></i> Reset</a>
                    <a class="btn btn-sm btn-default" href="/cp"><i class="fa fa-home"></i> Control panel</a>
                </div>
                <p class="help-block">
                    Storefront chats are saved to the database on each reply. Price-list toggles control what the agent can quote.
                    Importing chat JSON from the PHP server's temp folder (<strong>Sync temp files</strong>) stays on the Classic twin —
                    that folder belongs to the PHP host.
                </p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/parts-agent-chats-app" IsAdmin="_isAdmin" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }

    @if (_isAdmin)
    {
        <div class="col-lg-12">
            <div class="hpanel epc-agent-config">
                <div class="panel-heading hbuilt"><strong>Agent configuration</strong> — per-tenant branding &amp; prompts</div>
                <div class="panel-body">
                    <form method="post" action="/cp/parts-agent/save-config" class="epc-agent-config__grid" style="display:flex;flex-wrap:wrap;gap:.6rem;align-items:end">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="/cp/parts-agent-chats-app" />
                        <div class="form-group" style="flex:1 1 100%">
                            <label><input type="checkbox" name="enabled" value="1" checked="@_cfg.Enabled" /> Agent enabled on storefront</label>
                        </div>
                        <div class="form-group">
                            <label>Website domain</label>
                            <input type="text" name="domain" maxlength="255" class="form-control input-sm" placeholder="https://www.example.com" value="@_cfg.Domain" />
                        </div>
                        <div class="form-group">
                            <label>Agent name</label>
                            <input type="text" name="agent_name" maxlength="128" class="form-control input-sm" placeholder="AI Parts Expert" value="@_cfg.AgentName" />
                        </div>
                        <div class="form-group">
                            <label>Logo URL</label>
                            <input type="text" name="logo_url" maxlength="512" class="form-control input-sm" placeholder="/content/files/images/logo.png" value="@_cfg.LogoUrl" />
                        </div>
                        <div class="form-group" style="flex:1 1 100%">
                            <label>Subtitle</label>
                            <input type="text" name="subtitle" maxlength="255" class="form-control input-sm" placeholder="VIN · Part numbers · Export markets" value="@_cfg.Subtitle" />
                        </div>
                        <div class="form-group" style="flex:1 1 100%">
                            <label>Greeting message</label>
                            <textarea name="greeting" rows="3" class="form-control input-sm" placeholder="Hi! I'm your assistant…">@_cfg.Greeting</textarea>
                        </div>
                        <div class="form-group" style="flex:1 1 100%">
                            <label>System prompt (operator notes — optional)</label>
                            <textarea name="system_prompt" rows="3" class="form-control input-sm" placeholder="Extra guidance for agent replies…">@_cfg.SystemPrompt</textarea>
                        </div>
                        <div class="form-group">
                            <label>Teaser text</label>
                            <input type="text" name="teaser_text" maxlength="255" class="form-control input-sm" value="@_cfg.TeaserText" />
                        </div>
                        <div class="form-group">
                            <label>Input placeholder</label>
                            <input type="text" name="placeholder" maxlength="255" class="form-control input-sm" value="@_cfg.Placeholder" />
                        </div>
                        <div class="form-group" style="flex:1 1 100%">
                            <button type="submit" class="btn btn-primary btn-sm">Save configuration</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel epc-agent-stats">
                <div class="panel-body">
                    <span class="label @(_cfg.Enabled ? "label-success" : "label-default")">@(_cfg.Enabled ? "on" : "off")</span>
                    @(string.IsNullOrWhiteSpace(_cfg.AgentName) ? "AI Parts Expert" : _cfg.AgentName)
                    · @_view.Stats.TotalSessions.ToString(CultureInfo.InvariantCulture) total sessions
                    (@_view.Stats.SessionsToday.ToString(CultureInfo.InvariantCulture) today)
                    · @_view.Stats.MessagesToday.ToString(CultureInfo.InvariantCulture) messages today
                    · @_view.Stats.LoggedInSessions.ToString(CultureInfo.InvariantCulture) logged / @_view.Stats.GuestSessions.ToString(CultureInfo.InvariantCulture) guest
                </div>
            </div>
        </div>
    }

    <div class="col-lg-@(_transcript is null ? "12" : "7")">
        <div class="hpanel epc-agent-pane">
            <div class="panel-heading hbuilt">Sessions <small>Newest activity first</small></div>
            <div class="panel-body">
                <form method="get" action="/cp/parts-agent-chats-app" class="epc-agent-filters" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .8rem">
                    <div class="form-group">
                        <label>Search</label>
                        <input type="text" name="q" class="form-control input-sm" placeholder="Session ID, message, or IP" value="@_query.Search" />
                    </div>
                    <div class="form-group">
                        <label>From</label>
                        <input type="date" name="date_from" class="form-control input-sm" value="@_query.DateFrom" />
                    </div>
                    <div class="form-group">
                        <label>To</label>
                        <input type="date" name="date_to" class="form-control input-sm" value="@_query.DateTo" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> Search</button>
                    <a class="btn btn-default btn-sm" href="/cp/parts-agent-chats-app">Reset</a>
                </form>

                @if (!string.IsNullOrWhiteSpace(_view.Message))
                {
                    <div class="alert alert-warning">@_view.Message</div>
                }

                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-hover epc-agent-table">
                        <thead>
                            <tr>
                                <th>Last activity</th>
                                <th>Session</th>
                                <th>Msgs</th>
                                <th>Customer</th>
                                <th>Last customer message</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_view.Sessions.Count == 0)
                            {
                                <tr><td colspan="6">No chat sessions for this filter yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var row in _view.Sessions)
                                {
                                    <tr>
                                        <td>@Stamp(row.UpdatedAt)</td>
                                        <td><strong>@(string.IsNullOrWhiteSpace(row.SessionId) ? "—" : row.SessionId)</strong></td>
                                        <td>@row.MessageCount.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>
                                            @(row.UserId > 0
                                                ? (string.IsNullOrWhiteSpace(row.CustomerLabel) ? "user #" + row.UserId.ToString(CultureInfo.InvariantCulture) : row.CustomerLabel)
                                                : "guest")
                                            @if (!string.IsNullOrWhiteSpace(row.CountryName) || !string.IsNullOrWhiteSpace(row.CountryCode))
                                            {
                                                <small class="epc-agent-meta"> · @(string.IsNullOrWhiteSpace(row.CountryName) ? row.CountryCode : row.CountryName)</small>
                                            }
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(row.LastUserText) ? "—" : row.LastUserText)</td>
                                        <td><a class="btn btn-xs btn-default" href="@DetailHref(row.SessionId)">Open</a></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="epc-agent-pager">
                    @if (_query.Offset > 0)
                    {
                        <a class="btn btn-default btn-sm" href="@PageHref(Math.Max(0, _query.Offset - _query.Limit))">Previous</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-default btn-sm" disabled>Previous</button>
                    }
                    <span style="margin:0 10px;font-size:13px;">
                        Page @_view.Page.ToString(CultureInfo.InvariantCulture) of @_view.Pages.ToString(CultureInfo.InvariantCulture)
                        · @_view.Total.ToString(CultureInfo.InvariantCulture) sessions
                    </span>
                    @if (_query.Offset + _query.Limit < _view.Total)
                    {
                        <a class="btn btn-default btn-sm" href="@PageHref(_query.Offset + _query.Limit)">Next</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-default btn-sm" disabled>Next</button>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (_transcript is not null)
    {
        <div class="col-lg-5">
            <div class="hpanel epc-agent-detail-wrap">
                <div class="panel-heading hbuilt epc-agent-detail-head">
                    Chat detail — @_transcript.Session.SessionId
                    <a class="btn btn-xs btn-default pull-right" href="@PageHref(_query.Offset)">Close</a>
                </div>
                <div class="panel-body epc-agent-detail-body">
                    <div class="epc-agent-meta">
                        @Stamp(_transcript.Session.CreatedAt) → @Stamp(_transcript.Session.UpdatedAt)
                        · @_transcript.Session.MessageCount.ToString(CultureInfo.InvariantCulture) messages
                        · @(_transcript.Session.UserId > 0
                            ? (string.IsNullOrWhiteSpace(_transcript.Session.CustomerLabel) ? "user #" + _transcript.Session.UserId.ToString(CultureInfo.InvariantCulture) : _transcript.Session.CustomerLabel)
                            : "guest")
                    </div>
                    @if (_transcript.Messages.Count == 0)
                    {
                        <div class="epc-agent-empty">No stored transcript for this session.</div>
                    }
                    else
                    {
                        @foreach (var message in _transcript.Messages)
                        {
                            <div class="epc-agent-bubble epc-agent-bubble--@message.Role" style="margin:.4rem 0;padding:.5rem .7rem;border-radius:8px;background:@(message.Role == "user" ? "#eef4ff" : "#f5f5f5")">
                                <div class="epc-agent-meta"><strong>@(message.Role == "user" ? "Customer" : "Agent")</strong> · @Stamp(message.CreatedAt)</div>
                                <div>@message.Text</div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/parts_agent/parts_agent_chats";
    private bool _isAdmin;
    private CpPartsAgentDeskQuery _query = CpPartsAgentDeskQuery.Create(null, null, null, null, null);
    private CpPartsAgentDeskView _view = CpPartsAgentDeskView.Empty(
        CpPartsAgentDeskQuery.Create(null, null, null, null, null), "n/a", "");
    private CpPartsAgentTranscript? _transcript;
    private CpPartsAgentConfigRow _cfg = new(true, "", "", "", "", "", "", "", "");
    private string _flashOk = "";
    private string _flashErr = "";

    private static string Stamp(long unixSeconds)
        => unixSeconds > 0
            ? DateTimeOffset.FromUnixTimeSeconds(unixSeconds).UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)
            : "—";

    private string Filters()
    {
        var parts = new List<string>();
        if (_query.Search.Length > 0)
        {
            parts.Add("q=" + Uri.EscapeDataString(_query.Search));
        }

        if (_query.DateFrom.Length > 0)
        {
            parts.Add("date_from=" + Uri.EscapeDataString(_query.DateFrom));
        }

        if (_query.DateTo.Length > 0)
        {
            parts.Add("date_to=" + Uri.EscapeDataString(_query.DateTo));
        }

        return string.Join('&', parts);
    }

    private string PageHref(int offset)
    {
        var query = Filters();
        var suffix = offset > 0 ? "offset=" + offset.ToString(CultureInfo.InvariantCulture) : "";
        var all = string.Join('&', new[] { query, suffix }.Where(part => part.Length > 0));
        return all.Length > 0 ? "/cp/parts-agent-chats-app?" + all : "/cp/parts-agent-chats-app";
    }

    private string DetailHref(string sessionId)
    {
        var all = string.Join('&', new[]
        {
            Filters(),
            _query.Offset > 0 ? "offset=" + _query.Offset.ToString(CultureInfo.InvariantCulture) : "",
            "session_id=" + Uri.EscapeDataString(sessionId),
        }.Where(part => part.Length > 0));
        return "/cp/parts-agent-chats-app?" + all;
    }

    private string ExportHref()
    {
        var query = Filters();
        return query.Length > 0 ? "/cp/parts-agent/export.csv?" + query : "/cp/parts-agent/export.csv";
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        _query = CpPartsAgentDeskQuery.Create(
            ctx.Request.Query["q"].ToString(),
            ctx.Request.Query["date_from"].ToString(),
            ctx.Request.Query["date_to"].ToString(),
            int.TryParse(ctx.Request.Query["limit"], NumberStyles.Integer, CultureInfo.InvariantCulture, out var limit) ? limit : null,
            int.TryParse(ctx.Request.Query["offset"], NumberStyles.Integer, CultureInfo.InvariantCulture, out var offset) ? offset : null);

        _view = await Desk.LoadAsync(_query, ctx.RequestAborted);
        _cfg = await Writes.LoadConfigAsync(ctx.RequestAborted);

        var sessionId = ctx.Request.Query["session_id"].ToString();
        if (!string.IsNullOrWhiteSpace(sessionId))
        {
            _transcript = await Desk.LoadTranscriptAsync(sessionId, ctx.RequestAborted);
        }
    }
}
