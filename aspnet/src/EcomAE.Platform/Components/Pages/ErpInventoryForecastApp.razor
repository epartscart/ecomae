@page "/erp/inventory-forecast-app"
@page "/cp/shop/finance/epc_inventory_forecast"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Components.Shared.Desktop
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav
@inject IErpMultiEntityMemberReadService Members

<PageTitle>Inventory forecast · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Inventory forecast" BreadcrumbArea="Inventory" BreadcrumbTab="Forecast">

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Inventory forecast" Subtitle="Open a row for site key, lead time, safety stock, and EOQ. Recompute writes here." PhpTabHref="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" />
    <PhpErpD365ActionPane PhpTabHref="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" RefreshHref="@Nav.Uri" />

    @if (!string.IsNullOrWhiteSpace(_flash))
    {
        <div class="alert @(_flashOk ? "alert-success" : "alert-warning")" style="margin:0 0 12px">@_flash</div>
    }

    @if (_isAdmin)
    {
        <form method="post" action="/erp/inventory-forecast/recompute" class="form-inline" style="margin:0 0 12px;padding:10px;border:1px solid #c5d4de;background:#fff">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
            @if (_memberOptions.Count == 0)
            {
                <label style="margin-right:8px">Site <input name="siteKey" value="@_defaultSite" required style="width:9rem" /></label>
            }
            else
            {
                <label style="margin-right:8px">Site
                    <select name="siteKey" required style="min-width:9rem">
                        @foreach (var member in _memberOptions)
                        {
                            <option value="@member.SiteKey">@member.SiteKey@(string.IsNullOrWhiteSpace(member.Name) ? "" : " · " + member.Name)</option>
                        }
                    </select>
                </label>
            }
            <label style="margin-right:8px">SKU <input name="sku" required style="width:9rem" /></label>
            <label style="margin-right:8px">Stock <input type="number" name="currentStock" value="0" min="0" style="width:5rem" /></label>
            <label style="margin-right:8px">Name <input name="productName" style="width:10rem" /></label>
            <label style="margin-right:8px">Lead days <input type="number" name="leadTimeDays" value="7" min="1" style="width:4rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Recompute</button>
        </form>
        <form method="post" action="/erp/inventory-forecast/demand" class="form-inline" style="margin:0 0 12px;padding:10px;border:1px solid #c5d4de;background:#fff">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
            @if (_memberOptions.Count == 0)
            {
                <label style="margin-right:8px">Site <input name="siteKey" value="@_defaultSite" required style="width:9rem" /></label>
            }
            else
            {
                <label style="margin-right:8px">Site
                    <select name="siteKey" required style="min-width:9rem">
                        @foreach (var member in _memberOptions)
                        {
                            <option value="@member.SiteKey">@member.SiteKey@(string.IsNullOrWhiteSpace(member.Name) ? "" : " · " + member.Name)</option>
                        }
                    </select>
                </label>
            }
            <label style="margin-right:8px">SKU <input name="sku" required style="width:9rem" /></label>
            <label style="margin-right:8px">Period <input type="date" name="period" required style="width:9rem" /></label>
            <label style="margin-right:8px">Sold <input type="number" name="qtySold" min="0" value="0" style="width:5rem" /></label>
            <label style="margin-right:8px">Returned <input type="number" name="qtyReturned" min="0" value="0" style="width:5rem" /></label>
            <label style="margin-right:8px">Revenue <input type="number" name="revenue" min="0" step="0.01" value="0" style="width:6rem" /></label>
            <button type="submit" class="btn btn-sm btn-default">Record demand</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Inventory forecast KPIs">
        <div class="kpi"><div class="lbl">SKUs</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Healthy</div><div class="val">@_healthy.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Low</div><div class="val">@_low.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Critical</div><div class="val">@_critical.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Stockout</div><div class="val">@_stockout.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_opened is not null)
    {
        <ErpDocumentWorkspace
            DocumentKind="Inventory forecast"
            Title="@OpenedCaption"
            DocumentNumber="@_opened.Id.ToString(CultureInfo.InvariantCulture)"
            PartyLabel="Site"
            Party="@_opened.SiteKey"
            ReferenceLabel="SKU"
            Reference="@_opened.Sku"
            Status="@_opened.ForecastStatus"
            ApprovalState="@(_opened.StockoutDate.Length == 0 ? "Within coverage" : "Stockout risk")"
            CompanyContext="Tenant / company"
            Currency="—"
            Fields="@ForecastWorkspaceFields"
            Lines="@ForecastWorkspaceLines"
            Tabs="@ForecastWorkspaceTabs" />
            <p class="text-muted" style="margin:.85rem 0 0">Recompute writes stay here. Guarded demand-history recording is live; schema ownership stays PHP.</p>
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Status</th>
                            <th>Days</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Sku) ? "—" : sib.Sku)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.ForecastStatus) ? "—" : sib.ForecastStatus)</td>
                                <td>@sib.DaysOfStock.ToString(CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "inv_forecast_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Name</th>
                    <th class="text-right">Stock</th>
                    <th class="text-right">Daily demand</th>
                    <th class="text-right">ROP</th>
                    <th class="text-right">Days</th>
                    <th>Status</th>
                    <th>Stockout</th>
                    <th>Computed</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_forecasts.Count == 0)
                {
                    <tr><td colspan="10">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No forecast rows yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _forecasts)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Sku) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Sku)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.ProductName) ? "—" : row.ProductName)</td>
                            <td class="text-right">@row.CurrentStock.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.AvgDailyDemand.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.ReorderPoint.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.DaysOfStock.ToString(CultureInfo.InvariantCulture)</td>
                            <td><span class="label label-default">@row.ForecastStatus</span></td>
                            <td>@(string.IsNullOrWhiteSpace(row.StockoutDate) ? "—" : row.StockoutDate)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.LastComputed) ? "—" : row.LastComputed)</td>
                            <td>
                                <a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "inv_forecast_id", row.Id)">Open</a>
                                <form method="post" action="/erp/inventory-forecast/recompute" style="margin:4px 0 0">
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
                                    <input type="hidden" name="siteKey" value="@_defaultSite" />
                                    <input type="hidden" name="sku" value="@row.Sku" />
                                    <input type="hidden" name="currentStock" value="@row.CurrentStock.ToString(CultureInfo.InvariantCulture)" />
                                    <input type="hidden" name="productName" value="@row.ProductName" />
                                    <input type="hidden" name="leadTimeDays" value="@row.LeadTimeDays.ToString(CultureInfo.InvariantCulture)" />
                                    <button type="submit" class="btn btn-xs btn-default">Recompute</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Recompute and demand-history recording are live on the guarded twin; schema ownership stays PHP.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/epc_inventory_forecast";
    private string _listHref = "/erp/inventory-forecast-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpInventoryForecastDigest> _forecasts = [];
    private int _count;
    private int _healthy;
    private int _low;
    private int _critical;
    private int _stockout;
    private string _source = "n/a";
    private string _message = "";
    private string _flash = "";
    private bool _flashOk;
    private string _defaultSite = "epartscart";
    private IReadOnlyList<ErpMultiEntityMemberOption> _memberOptions = [];
    private long _openedId;
    private ErpInventoryForecastDetail? _opened;
    private IReadOnlyList<ErpInventoryForecastDigest> _openedSiblings = [];
    private IReadOnlyList<string> ForecastWorkspaceTabs => ["General", "Demand", "Replenishment", "Audit"];

    private IReadOnlyList<ErpDocumentWorkspaceField> ForecastWorkspaceFields => _opened is null
        ? []
        : [
            new("Site", _opened.SiteKey, "General"),
            new("SKU", _opened.Sku, "General"),
            new("Product", _opened.ProductName, "General"),
            new("Current stock", _opened.CurrentStock.ToString(CultureInfo.InvariantCulture), "Demand"),
            new("Average daily demand", _opened.AvgDailyDemand.ToString("N2", CultureInfo.InvariantCulture), "Demand"),
            new("Lead time days", _opened.LeadTimeDays.ToString(CultureInfo.InvariantCulture), "Replenishment"),
            new("Safety stock", _opened.SafetyStock.ToString(CultureInfo.InvariantCulture), "Replenishment"),
            new("Reorder point", _opened.ReorderPoint.ToString(CultureInfo.InvariantCulture), "Replenishment"),
            new("EOQ", _opened.Eoq.ToString(CultureInfo.InvariantCulture), "Replenishment"),
            new("Days of stock", _opened.DaysOfStock.ToString(CultureInfo.InvariantCulture), "Demand"),
            new("Stockout date", _opened.StockoutDate, "Demand"),
            new("Last computed", _opened.LastComputed, "Audit")
        ];

    private IReadOnlyList<ErpDocumentWorkspaceLine> ForecastWorkspaceLines => _opened is null
        ? []
        : [
            new("1", string.IsNullOrWhiteSpace(_opened.ProductName) ? _opened.Sku : _opened.ProductName,
                1, "forecast", _opened.SiteKey, "—", 0, 0, 0, 0, 0,
                $"ROP {_opened.ReorderPoint.ToString(CultureInfo.InvariantCulture)} · {_opened.ForecastStatus}")
        ];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.Sku)
            ? _opened.Sku
            : ("Forecast #" + _opened.Id.ToString(CultureInfo.InvariantCulture)));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?inv_forecast_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var path = ctx.Request.Path.Value ?? "";
        _listHref = path.Contains("/cp/shop/finance/epc_inventory_forecast", StringComparison.OrdinalIgnoreCase)
            ? "/cp/shop/finance/epc_inventory_forecast"
            : "/erp/inventory-forecast-app";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "inv_forecast_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var ok = ctx.Request.Query["ok"].ToString();
        var err = ctx.Request.Query["err"].ToString();
        if (!string.IsNullOrWhiteSpace(ok)) { _flash = ok; _flashOk = true; }
        else if (!string.IsNullOrWhiteSpace(err)) { _flash = err; _flashOk = false; }

        var result = await Dashboards.ListErpInventoryForecastAsync(200, ctx.RequestAborted);
        _forecasts = result.Forecasts;
        _count = result.Count;
        _healthy = result.HealthyCount;
        _low = result.LowCount;
        _critical = result.CriticalCount;
        _stockout = result.StockoutCount;
        _source = result.Source;
        _message = result.Message;
        _memberOptions = await Members.LoadAsync(ctx.RequestAborted);

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpInventoryForecastDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Forecast;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _forecasts.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _forecasts = new[] { openedList }.Concat(_forecasts.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }

}
