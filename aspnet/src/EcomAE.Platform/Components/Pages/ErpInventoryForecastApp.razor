@page "/erp/inventory-forecast-app"
@page "/cp/shop/finance/epc_inventory_forecast"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Inventory forecast · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Inventory forecast" BreadcrumbArea="Inventory" BreadcrumbTab="Forecast">

    <PhpErpModulePageHeader Title="Inventory forecast" Subtitle="Read-only reorder points and stockout dates from epc_inventory_forecast. Recompute stays on PHP." />
    <PhpErpD365ActionPane RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Inventory forecast KPIs">
        <div class="kpi"><div class="lbl">SKUs</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Healthy</div><div class="val">@_healthy.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Low</div><div class="val">@_low.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Critical</div><div class="val">@_critical.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Stockout</div><div class="val">@_stockout.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Name</th>
                    <th class="text-right">Stock</th>
                    <th class="text-right">Daily demand</th>
                    <th class="text-right">ROP</th>
                    <th class="text-right">Days</th>
                    <th>Status</th>
                    <th>Stockout</th>
                    <th>Computed</th>
                </tr>
            </thead>
            <tbody>
                @if (_forecasts.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No forecast rows yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _forecasts)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Sku) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Sku)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.ProductName) ? "—" : row.ProductName)</td>
                            <td class="text-right">@row.CurrentStock.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.AvgDailyDemand.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.ReorderPoint.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.DaysOfStock.ToString(CultureInfo.InvariantCulture)</td>
                            <td><span class="label label-default">@row.ForecastStatus</span></td>
                            <td>@(string.IsNullOrWhiteSpace(row.StockoutDate) ? "—" : row.StockoutDate)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.LastComputed) ? "—" : row.LastComputed)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Demand history write stays PHP. Digest: <code>/erp/inventory-forecast</code>.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private IReadOnlyList<ErpInventoryForecastDigest> _forecasts = [];
    private int _count;
    private int _healthy;
    private int _low;
    private int _critical;
    private int _stockout;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpInventoryForecastAsync(200, ctx.RequestAborted);
        _forecasts = result.Forecasts;
        _count = result.Count;
        _healthy = result.HealthyCount;
        _low = result.LowCount;
        _critical = result.CriticalCount;
        _stockout = result.StockoutCount;
        _source = result.Source;
        _message = result.Message;
    }
}
