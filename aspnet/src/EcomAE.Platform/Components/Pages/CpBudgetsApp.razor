@page "/cp/budgets-app"
@page "/erp/budgets-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Routing
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Budgets · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Budgets
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Open a budget for a note excerpt and monthly lines. Save a platform budget, add a line, advance a plan, and record a cheque here. FX import stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/budgets-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedBudget is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Budget KPIs">
        <div class="kpi"><div class="lbl">Budgets</div><div class="val">@_summary.BudgetCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_summary.ActiveBudgets.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Lines</div><div class="val">@_summary.BudgetLineCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Opened lines</div><div class="val">@_openedLines.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedBudget is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @OpenedCaption
                    <span class="label label-default pull-right">@(_openedBudget.Active ? "active" : "inactive")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedBudget.Code) ? _openedBudget.Code : "—")
                        · FY @(!string.IsNullOrWhiteSpace(_openedBudget.FiscalYear) ? _openedBudget.FiscalYear : "—")
                        · BU @_openedBudget.BusinessUnitId.ToString(CultureInfo.InvariantCulture)
                        · @(_openedBudget.IsMaster ? "master" : "member")
                        · created @_openedBudget.TimeCreated.ToString(CultureInfo.InvariantCulture)
                        · updated @_openedBudget.TimeUpdated.ToString(CultureInfo.InvariantCulture)</p>
                    @if (!string.IsNullOrWhiteSpace(_openedBudget.NoteExcerpt))
                    {
                        <p>@_openedBudget.NoteExcerpt
                            @if (_openedBudget.NoteLen > _openedBudget.NoteExcerpt.Length)
                            {
                                <span class="text-muted"> (excerpt)</span>
                            }
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">No note excerpt yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Monthly lines</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Account</th>
                                    <th>Name</th>
                                    <th>Month</th>
                                    <th>Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedLines.Count == 0)
                                {
                                    <tr><td colspan="5">No budget lines yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var line in _openedLines)
                                    {
                                        <tr>
                                            <td>@line.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(line.AccountCode) ? line.AccountCode : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(line.AccountName) ? line.AccountName : "—")</td>
                                            <td>@line.MonthNo.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@line.Amount.ToString(CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Same-FY siblings</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Master</th>
                                    <th>Active</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="6">No same-FY siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Code) ? sib.Code : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Name) ? sib.Name : "—")</td>
                                            <td>@(sib.IsMaster ? "yes" : "no")</td>
                                            <td>@(sib.Active ? "yes" : "no")</td>
                                            <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "budget_id", sib.Id)">Open</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Budgets</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Code</th>
                                <th>Name</th>
                                <th>Fiscal year</th>
                                <th>BU</th>
                                <th>Master</th>
                                <th>Active</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!_isAdmin)
                        {
                            <tr><td colspan="8">Sign in for live data.</td></tr>
                        }
                        else if (_budgets.Count == 0)
                        {
                            <tr><td colspan="8">@(!string.IsNullOrWhiteSpace(_message) ? _message : "No records yet.")</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _budgets)
                            {
                                <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Code) ? row.Code : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.FiscalYear) ? row.FiscalYear : "—")</td>
                                    <td>@row.BusinessUnitId.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(row.IsMaster ? "yes" : "no")</td>
                                    <td>@(row.Active ? "yes" : "no")</td>
                                    <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "budget_id", row.Id)">Open</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <form method="post" action="/erp/budgets/advance" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/budgets-app" />
            <label>Plan id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <button type="submit">Advance plan</button>
        </form>

<ErpPhpCreateWell Title="Attach listing to voucher">
<form method="post" action="/erp/pm/listings/attach" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                <input type="hidden" name="returnUrl" value="/erp/budgets-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Listing id <input class="form-control input-sm" name="id" placeholder="Id" style="width:80px;" /></label>
                <label>Voucher <input class="form-control input-sm" name="voucher_ref" placeholder="Ref" style="width:180px;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Attach</button>
            </form>
</ErpPhpCreateWell>

<ErpPhpCreateWell Title="Record cheque">
<form method="post" action="/erp/pm/cheques/save" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                <input type="hidden" name="returnUrl" value="/erp/budgets-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Bank account id <input class="form-control input-sm" name="bank_account_id" placeholder="0" style="width:80px;" /></label>
                <label>Cheque no <input class="form-control input-sm" name="cheque_no" placeholder="No" style="width:120px;" /></label>
                <label>Pay to <input class="form-control input-sm" name="pay_to" placeholder="Payee" style="width:180px;" /></label>
                <label>Amount <input class="form-control input-sm" name="amount" placeholder="0.00" style="width:100px;" /></label>
                <label>Date <input class="form-control input-sm" name="cheque_date" type="date" style="width:150px;" /></label>
                <label>Memo <input class="form-control input-sm" name="memo" placeholder="Memo" style="width:180px;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Record</button>
            </form>
</ErpPhpCreateWell>

<ErpPhpCreateWell Title="Toggle platform master">
<form method="post" action="/erp/pm/toggle" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                <input type="hidden" name="returnUrl" value="/erp/budgets-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Table
                    <select class="form-control input-sm" name="pm_table" style="width:220px;">
                        <option value="epc_erp_pm_business_units">Business units</option>
                        <option value="epc_erp_pm_class_units">Class units</option>
                        <option value="epc_erp_pm_legal_entities">Legal entities</option>
                        <option value="epc_erp_pm_dimensions">Dimensions</option>
                        <option value="epc_erp_pm_dimension_values">Dimension values</option>
                        <option value="epc_erp_pm_vendor_groups">Vendor groups</option>
                        <option value="epc_erp_pm_customer_groups">Customer groups</option>
                        <option value="epc_erp_pm_pay_methods">Pay methods</option>
                        <option value="epc_erp_pm_pay_terms">Pay terms</option>
                        <option value="epc_erp_pm_inv_groups">Inventory groups</option>
                        <option value="epc_erp_pm_barcode_formats">Barcode formats</option>
                    </select>
                </label>
                <label>Id <input class="form-control input-sm" name="id" placeholder="Id" style="width:80px;" /></label>
                <label>Active
                    <select class="form-control input-sm" name="active" style="width:80px;">
                        <option value="1">yes</option>
                        <option value="0">no</option>
                    </select>
                </label>
                <button type="submit" class="btn btn-primary btn-sm">Update</button>
            </form>
</ErpPhpCreateWell>

<ErpPhpCreateWell Title="Add budget line">
<form method="post" action="/erp/pm/budget-lines/add" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                <input type="hidden" name="returnUrl" value="/erp/budgets-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Budget id <input class="form-control input-sm" name="budget_id" placeholder="Id" style="width:80px;" value="@(_openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "")" /></label>
                <label>Account <input class="form-control input-sm" name="account_code" placeholder="Code" style="width:120px;" /></label>
                <label>Name <input class="form-control input-sm" name="account_name" placeholder="Name" style="width:180px;" /></label>
                <label>Month <input class="form-control input-sm" name="month_no" placeholder="1-12" style="width:70px;" /></label>
                <label>Amount <input class="form-control input-sm" name="amount" placeholder="0.00" style="width:100px;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Add line</button>
            </form>
</ErpPhpCreateWell>

<ErpPhpCreateWell Title="Save platform budget">
<form method="post" action="/erp/pm/budgets/save" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                <input type="hidden" name="returnUrl" value="/erp/budgets-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Id <input class="form-control input-sm" name="id" placeholder="0 = new" style="width:80px;" value="@(_openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "")" /></label>
                <label>Code <input class="form-control input-sm" name="code" placeholder="Code" style="width:120px;" value="@(_openedBudget is not null ? _openedBudget.Code : "")" /></label>
                <label>Name <input class="form-control input-sm" name="name" placeholder="Name" style="width:180px;" value="@(_openedBudget is not null ? _openedBudget.Name : "")" /></label>
                <label>Fiscal year <input class="form-control input-sm" name="fiscal_year" placeholder="FY" style="width:90px;" value="@(_openedBudget is not null ? _openedBudget.FiscalYear : "")" /></label>
                <label>BU id <input class="form-control input-sm" name="business_unit_id" placeholder="0" style="width:80px;" value="@(_openedBudget is not null ? _openedBudget.BusinessUnitId.ToString(CultureInfo.InvariantCulture) : "")" /></label>
                <label>Master
                    <select class="form-control input-sm" name="is_master" style="width:80px;">
                        <option value="0">no</option>
                        <option value="1">yes</option>
                    </select>
                </label>
                <label>Note <input class="form-control input-sm" name="note" placeholder="Note" style="width:180px;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
            </form>
</ErpPhpCreateWell>

<ErpPhpCreateWell Title="Save platform master">
