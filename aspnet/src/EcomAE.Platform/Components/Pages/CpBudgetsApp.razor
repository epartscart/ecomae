<ErpPhpCreateWell Title="Add worksheet line">
<form method="post" action="@EcomAeRoutes.ErpBudgetPlanLineAdd" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                <input type="hidden" name="returnUrl" value="/erp/budgets-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Plan <input class="form-control input-sm" name="plan_id" placeholder="Plan id" style="width:80px;" required /></label>
                <label>Account <input class="form-control input-sm" name="account" placeholder="Account" style="width:110px;" /></label>
                <label>Dimension <input class="form-control input-sm" name="dimension" placeholder="Dimension" style="width:120px;" /></label>
                <label>Scenario <input class="form-control input-sm" name="scenario" value="base" style="width:90px;" /></label>
                <label>Period <input class="form-control input-sm" name="period" placeholder="Period" style="width:90px;" /></label>
                <label>Amount <input class="form-control input-sm" name="amount" placeholder="0" style="width:90px;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Add</button>
            </form>
</ErpPhpCreateWell>

<ErpPhpCreateWell Title="New budget plan">
<form method="post" action="@EcomAeRoutes.ErpBudgetPlanSave" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                <input type="hidden" name="returnUrl" value="/erp/budgets-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Name <input class="form-control input-sm" name="name" placeholder="Name" style="width:180px;" required /></label>
                <label>Fiscal year <input class="form-control input-sm" name="fiscal_year" placeholder="FY" style="width:90px;" /></label>
                <label>Owner <input class="form-control input-sm" name="owner" placeholder="Owner" style="width:140px;" /></label>
                <label>Notes <input class="form-control input-sm" name="notes" placeholder="Notes" style="width:180px;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
            </form>
</ErpPhpCreateWell>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=budgeting&tab=budgeting&epc_erp_shell=1";
    private bool _isAdmin;
    private CpBudgetsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpBudgetDigest> _budgets = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpBudgetsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _budgets = result.Budgets;
        _source = result.Source;
        _message = result.Message;
    }
}
