</ErpPhpCreateWell>

<ErpPhpCreateWell Title="New budget plan">
<form method="post" action="@EcomAeRoutes.ErpBudgetPlanSave" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                <input type="hidden" name="returnUrl" value="/erp/budgets-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Name <input class="form-control input-sm" name="name" placeholder="Name" style="width:180px;" required /></label>
                <label>Fiscal year <input class="form-control input-sm" name="fiscal_year" placeholder="FY" style="width:90px;" /></label>
                <label>Owner <input class="form-control input-sm" name="owner" placeholder="Owner" style="width:140px;" /></label>
                <label>Notes <input class="form-control input-sm" name="notes" placeholder="Notes" style="width:180px;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
            </form>
</ErpPhpCreateWell>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=budgeting&tab=budgeting&epc_erp_shell=1";
    private bool _isAdmin;
    private CpBudgetsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpBudgetDigest> _budgets = [];
    private string _source = "n/a";
    private string _message = "";
    private string _listHref = "/cp/budgets-app";
    private long _openedId;
    private CpBudgetDetail? _openedBudget;
    private IReadOnlyList<CpBudgetLineDigest> _openedLines = [];
    private IReadOnlyList<CpBudgetDigest> _openedSiblings = [];

    private string OpenedCaption => _openedBudget is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedBudget.Name)
            ? (string.IsNullOrWhiteSpace(_openedBudget.Code)
                ? ("Budget #" + _openedBudget.Id.ToString(CultureInfo.InvariantCulture))
                : _openedBudget.Code)
            : _openedBudget.Name);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var path = ctx.Request.Path.Value;
        _listHref = string.Equals(path, "/erp/budgets-app", StringComparison.OrdinalIgnoreCase)
            ? "/erp/budgets-app"
            : "/cp/budgets-app";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "budget_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpBudgetsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _budgets = result.Budgets;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpBudgetsDetailAsync(_openedId, ctx.RequestAborted);
            _openedBudget = detail.Budget;
            _openedLines = detail.Lines;
            _openedSiblings = detail.Siblings;
            if (_openedBudget is not null)
            {
                var openedList = _budgets.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _budgets = new[] { openedList }.Concat(_budgets.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
