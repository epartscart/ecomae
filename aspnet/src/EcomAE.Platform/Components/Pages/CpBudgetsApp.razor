@page "/cp/budgets-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Budgets · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-bud-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0f766e 0%,#0d9488 50%,#14b8a6 100%);
        }
        .epc-bud-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-bud-hero p { margin:0; color:rgba(255,255,255,.85); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-bud-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-bud-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#115e59; background:#99f6e4;
        }
        .epc-bud-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-bud-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-bud-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-bud-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-bud-kpi span { color:#64748b; font-size:.78rem; }
        .epc-bud-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-bud-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-bud-table th, .epc-bud-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-bud-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-bud-note { margin-top:1rem; padding:.75rem .9rem; background:#f0fdfa; border:1px solid #5eead4; border-radius:.45rem; color:#115e59; font-size:.86rem; }
        @@media (max-width:900px){ .epc-bud-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-bud-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Budgets</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-bud-cta">
            <a href="@_phpTab">Open module</a>
        </div>
    </section>

    <div class="epc-bud-kpis" aria-label="Budgets stats">
        <div class="epc-bud-kpi"><strong>@_summary.BudgetCount.ToString(CultureInfo.InvariantCulture)</strong><span>Budgets</span></div>
        <div class="epc-bud-kpi"><strong>@_summary.ActiveBudgets.ToString(CultureInfo.InvariantCulture)</strong><span>Active</span></div>
        <div class="epc-bud-kpi"><strong>@_summary.BudgetLineCount.ToString(CultureInfo.InvariantCulture)</strong><span>Budget lines</span></div>
        <div class="epc-bud-kpi"><strong>@_summary.DimensionCount.ToString(CultureInfo.InvariantCulture)</strong><span>Dimensions</span></div>
    </div>

    <div class="epc-bud-table-wrap">
        <table class="epc-bud-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Fiscal year</th>
                    <th>BU</th>
                    <th>Master</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_budgets.Count == 0)
                {
                    <tr><td colspan="8">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _budgets)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Code) ? row.Code : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.FiscalYear) ? row.FiscalYear : "—")</td>
                            <td>@row.BusinessUnitId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(row.IsMaster ? "yes" : "no")</td>
                            <td>@(row.Active ? "yes" : "no")</td>
                            <td><a href="@_phpTab">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=budgeting&tab=budgeting&epc_erp_shell=1";
    private bool _isAdmin;
    private CpBudgetsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpBudgetDigest> _budgets = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpBudgetsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _budgets = result.Budgets;
        _source = result.Source;
        _message = result.Message;
    }
}
