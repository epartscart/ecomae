@page "/cp/design-tokens-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Design tokens · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Design tokens
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>White-label tokens from tenant tables. Edit stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/design-tokens-app" IsAdmin="_isAdmin" />

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Tokens</div>
            <div class="panel-body">
                <p class="help-block">@_summary.TokenCount.ToString(CultureInfo.InvariantCulture) tokens · @_summary.TenantCount.ToString(CultureInfo.InvariantCulture) tenants · @_summary.WhiteLabelCount.ToString(CultureInfo.InvariantCulture) white-label · @_summary.UpdatedRecentCount.ToString(CultureInfo.InvariantCulture) updated 30d.</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>Site</th>
                                <th>Key</th>
                                <th>Updated</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_rows.Count == 0)
                        {
                            <tr><td colspan="3">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr>
                                    <td>@(!string.IsNullOrWhiteSpace(row.SiteKey) ? row.SiteKey : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.SettingKey) ? row.SettingKey : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.UpdatedAt) ? row.UpdatedAt : "—")</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_design_tokens";
    private bool _isAdmin;
    private CpDesignTokensSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpDesignTokensRowDigest> _rows = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpDesignTokensDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Tokens;
    }
}
