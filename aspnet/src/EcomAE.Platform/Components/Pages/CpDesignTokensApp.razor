@page "/cp/design-tokens-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Design tokens · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Design tokens
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>White-label tokens from tenant tables. Save an allowlisted brand token here. CSS emit stays on the Classic twin. This page does not invent a send.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/design-tokens-app" IsAdmin="_isAdmin" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div>
    }

    @if (_isAdmin)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Save token</div>
                <div class="panel-body">
                    <form method="post" action="/cp/design-tokens/write" class="well">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="/cp/design-tokens-app" />
                        <input type="hidden" name="action" value="save" />
                        <div class="form-group">
                            <label>Site key</label>
                            <input type="text" class="form-control" name="site_key" />
                        </div>
                        <div class="form-group">
                            <label>Setting key</label>
                            <select class="form-control" name="setting_key">
                                @foreach (var key in CpDesignTokensWriteService.AllowedKeys)
                                {
                                    <option value="@key">@key</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Value</label>
                            <input type="text" class="form-control" name="setting_value" maxlength="256" />
                        </div>
                        <button type="submit" class="btn btn-default">Save token</button>
                    </form>
                    <p class="help-block" style="margin:.75rem 0 0">CSS emit stay Classic.</p>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Tokens</div>
            <div class="panel-body">
                <p class="help-block">@_summary.TokenCount.ToString(CultureInfo.InvariantCulture) tokens · @_summary.TenantCount.ToString(CultureInfo.InvariantCulture) tenants · @_summary.WhiteLabelCount.ToString(CultureInfo.InvariantCulture) white-label · @_summary.UpdatedRecentCount.ToString(CultureInfo.InvariantCulture) updated 30d.</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>Site</th>
                                <th>Key</th>
                                <th>Updated</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_rows.Count == 0)
                        {
                            <tr><td colspan="3">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr>
                                    <td>@(!string.IsNullOrWhiteSpace(row.SiteKey) ? row.SiteKey : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.SettingKey) ? row.SettingKey : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.UpdatedAt) ? row.UpdatedAt : "—")</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_design_tokens";
    private bool _isAdmin;
    private CpDesignTokensSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpDesignTokensRowDigest> _rows = [];
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpDesignTokensDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Tokens;
    }
}
