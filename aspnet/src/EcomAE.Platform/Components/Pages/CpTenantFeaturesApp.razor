@page "/cp/tenant-features-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Tenant features · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

@if (_allowed)
{
    <PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Tenant features
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/tenant-features-app")</p>
                <p>Save per-tenant feature flags here. Schema-ensure stays on the Classic twin. This page does not invent a send.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/tenant-features-app" IsAdmin="_isAdmin" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div>
    }

    <p class="help-block">@_siteCount.ToString(CultureInfo.InvariantCulture) Sites · @_flagCount.ToString(CultureInfo.InvariantCulture) Flags · @_enabledCount.ToString(CultureInfo.InvariantCulture) Enabled · @_disabledCount.ToString(CultureInfo.InvariantCulture) Disabled.</p>

    @if (_isAdmin)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Save feature flags</div>
                <div class="panel-body">
                    <form method="get" action="/cp/tenant-features-app" class="form-inline" style="margin-bottom:1rem">
                        <label>Tenant
                            <input type="text" class="form-control input-sm" name="site_key" value="@_selectedSite" />
                        </label>
                        <button type="submit" class="btn btn-default btn-sm">Load</button>
                    </form>
                    <form method="post" action="/cp/tenant-features/write" class="well">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@ReturnHref" />
                        <input type="hidden" name="action" value="save_feature_flags" />
                        <input type="hidden" name="site_key" value="@_selectedSite" />
                        <div class="row">
                            @foreach (var feat in _saveable)
                            {
                                var on = FeatureOn(feat.Key, feat.DefaultEnabled);
                                <div class="col-md-4 col-sm-6" style="margin-bottom:10px">
                                    <label class="checkbox" style="font-weight:normal">
                                        @if (on)
                                        {
                                            <input type="checkbox" name="features_@feat.Key" value="1" checked />
                                        }
                                        else
                                        {
                                            <input type="checkbox" name="features_@feat.Key" value="1" />
                                        }
                                        @feat.Label
                                    </label>
                                </div>
                            }
                        </div>
                        <button type="submit" class="btn btn-success">Save feature flags</button>
                    </form>
                    <p class="help-block" style="margin:.75rem 0 0">Schema-ensure stays Classic.</p>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Site</th>
                    <th>Feature</th>
                    <th>Enabled</th>
                    <th>Updated</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="5">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@(!string.IsNullOrWhiteSpace(row.SiteKey) ? row.SiteKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.FeatureKey) ? row.FeatureKey : "—")</td>
                            <td>@(row.Enabled ? "yes" : "no")</td>
                            <td>@row.UpdatedAt.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="epc-nw-note">Super CP host only. tenant_registry is not saved here.</div>

</PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>This control is available on the platform Super CP host only.</p>
        <p><a href="/cp">Open Control Panel</a></p>
    </div>
}

@code {
    private bool _allowed;
    private const string _phpTab = "/CP/control/portal/epc_tenant_features";
    private bool _isAdmin;
    private int _siteCount = 0;
    private int _flagCount = 0;
    private int _enabledCount = 0;
    private int _disabledCount = 0;
    private IReadOnlyList<CpTenantFeaturesRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private string _selectedSite = "";
    private readonly IReadOnlyList<CpIntegrationsHubCatalogEntry> _saveable = CpTenantFeaturesWriteService.SaveableCatalog;

    private string ReturnHref => string.IsNullOrWhiteSpace(_selectedSite)
        ? "/cp/tenant-features-app"
        : "/cp/tenant-features-app?site_key=" + Uri.EscapeDataString(_selectedSite);

    private bool FeatureOn(string featureKey, bool fallback)
    {
        if (string.IsNullOrWhiteSpace(_selectedSite))
        {
            return fallback;
        }

        var row = _rows.FirstOrDefault(r =>
            string.Equals(r.SiteKey, _selectedSite, StringComparison.OrdinalIgnoreCase)
            && string.Equals(r.FeatureKey, featureKey, StringComparison.OrdinalIgnoreCase));
        return row is null ? fallback : row.Enabled;
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _selectedSite = CpTenantFeaturesWriteService.NormalizeSiteKey(ctx.Request.Query["site_key"].ToString());

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpTenantFeaturesDigestAsync(200, ctx.RequestAborted);
        _siteCount = result.Summary.SiteCount;
        _flagCount = result.Summary.FlagCount;
        _enabledCount = result.Summary.EnabledCount;
        _disabledCount = result.Summary.DisabledCount;
        _rows = result.Rows;
        _source = result.Source;
        _message = result.Message;
        if (_selectedSite.Length == 0)
        {
            _selectedSite = _rows.Select(r => r.SiteKey).FirstOrDefault(s => !string.IsNullOrWhiteSpace(s)) ?? "";
        }
    }
}
