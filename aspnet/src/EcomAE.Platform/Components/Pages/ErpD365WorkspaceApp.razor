@page "/erp/rebate-workspace-app"
@page "/erp/retail-workspace-app"
@page "/erp/sales-workspace-app"
@page "/erp/service-workspace-app"
@page "/erp/system-admin-workspace-app"
@page "/erp/tax-workspace-app"
