@page "/marketing/acceptable-use"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>ECOM AE — Acceptable use</PageTitle>
<PhpChromeStyles Surface="marketing" />

<PhpEcomaeMarketingChrome ActiveKey="acceptable_use">
    <PhpHybridWorkspaceFrame PhpHref="@_phpHref" ClearHref="/marketing/acceptable-use" />

    @if (string.IsNullOrWhiteSpace(_phpHref))
    {
        <PhpEcomaeLegalAliasOverview
            Title="Acceptable use"
            Badge="Acceptable use"
            Icon="fa-check-square-o"
            GradientStart="#365314"
            GradientMid="#65a30d"
            PhpSlug="acceptable-use"
            AspNetRoute="/marketing/acceptable-use"
            Lead="Acceptable use rules for the ECOM AE platform. Full policy text is available from the linked policy page."
            CardOne="Prohibited activities and fair-use expectations." />
    }
</PhpEcomaeMarketingChrome>

@code {
    private string? _phpHref;

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        if (ctx?.Request.Query.TryGetValue("php", out var php) == true && !string.IsNullOrWhiteSpace(php))
        {
            _phpHref = php.ToString();
        }
    }
}
