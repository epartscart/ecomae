@page "/cp/auth-mfa-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Auth MFA · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Auth MFA
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/auth-mfa-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/auth-mfa-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_summary.SecretCount.ToString(CultureInfo.InvariantCulture) Enrollments · @_summary.ConfirmedCount.ToString(CultureInfo.InvariantCulture) Confirmed · @_summary.BackupUnusedCount.ToString(CultureInfo.InvariantCulture) Backup unused · @_summary.PolicyCount.ToString(CultureInfo.InvariantCulture) Policies.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>User</th>
                    <th>Method</th>
                    <th>Confirmed</th>
                    <th>Label</th>
                    <th>Created</th>
                    <th>Last used</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="8">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.UserId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Method) ? row.Method : "—")</td>
                            <td>@row.Confirmed.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Label) ? row.Label : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CreatedAt) ? row.CreatedAt : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.LastUsedAt) ? row.LastUsedAt : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_cp_auth_settings";
    private bool _isAdmin;
    private CpAuthMfaSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpAuthMfaSecretDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpAuthMfaDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Secrets;
        _source = result.Source;
        _message = result.Message;
    }
}
