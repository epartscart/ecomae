@page "/cp/sitemap-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@inject ICpSitemapEditorService Sitemap
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Sitemap · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<style>
    .epc-sm-actions .panel_a { display:inline-block; text-align:center; text-decoration:none; color:#333; margin-right:14px; vertical-align:top; cursor:pointer; }
    .epc-sm-actions .panel_a_img { width:48px; height:48px; margin:0 auto 4px; border-radius:8px; background:#f1f3f6; display:flex; align-items:center; justify-content:center; font-size:22px; color:#3498db; }
    .epc-sm-actions .panel_a_caption { font-size:12px; }
    #container_A { height:350px; overflow:auto; border:1px solid #e4e5e7; background:#fff; }
    #container_A ul { list-style:none; margin:0; padding-left:18px; }
    #container_A > ul { padding-left:4px; }
    #container_A li > .epc-sm-row { display:flex; align-items:center; gap:6px; padding:3px 6px; border-radius:3px; }
    #container_A li > .epc-sm-row:hover { background:#f5f7fa; }
    #container_A .epc-sm-tog { width:14px; color:#888; font-size:11px; text-align:center; cursor:pointer; }
    #container_A li.epc-closed > ul { display:none; }
    #container_A .epc-sm-val { flex:1; }
    #container_A .epc-sm-val.epc-unpub { color:#AAA; }
    #container_A .epc-sm-val.epc-main { font-weight:bold; }
    #container_A .epc-sm-ico { color:#999; font-size:11px; }
    #container_A .epc-sm-url { color:#999; font-size:11px; }
</style>

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    @if (!_isAdmin)
    {
        <div class="col-lg-12"><div class="hpanel"><div class="panel-body">
            <div class="alert alert-warning" role="status">Sign in to the Control Panel to build the sitemap. <a href="/cp/login?returnUrl=/cp/sitemap-app">Login</a></div>
        </div></div></div>
    }
    else
    {
        @* ---- sitemap.php twin ---- *@
        <div id="messages"></div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Sitemap
                    <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
                </div>
                <div class="panel-body epc-sm-actions">
                    <a class="panel_a" onclick="create_sitemap();" href="javascript:void(0);"><div class="panel_a_img"><i class="fa fa-save"></i></div><div class="panel_a_caption">Create sitemap</div></a>
                    <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div> }
        @if (!_page.OutputWritable)
        {
            <div class="col-lg-12"><div class="alert alert-warning" role="status">Site root folder is not configured (EcomAE:PhpReference:PhpDocRoot); sitemap files cannot be written until the operator sets it.</div></div>
        }

        <form name="form_to_save" id="form_to_save" method="post" action="/cp/content/create-sitemap" style="display:none">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_listHref" />
            <input type="hidden" name="action" value="create" />
            <input name="url_list" id="url_list" type="hidden" value="" />
        </form>

        <div class="col-lg-6">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Site pages</div>
                <div class="panel-body">
                    <div style="padding:0 0 10px 0;">
                        <button type="button" onclick="epcCheckAll(true);" class="btn w-xs btn-success">Check all</button>
                        <button type="button" onclick="epcCheckAll(false);" class="btn w-xs btn-primary2">Uncheck all</button>
                    </div>
                    <div id="container_A"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="hpanel">
                <div class="panel-heading hbuilt">How it works</div>
                <div class="panel-body">
                    Tick the pages to include, then press "Create sitemap". Published catalogue categories and products are added automatically.
                    <br/>
                    Files sitemap1.xml … sitemapN.xml (max 30 000 URLs / 5 MB each) and the index sitemap.xml are rewritten in the site root: <code>@(_page.OutputDirectory.Length == 0 ? "(not configured)" : _page.OutputDirectory)</code>; locations use <code>@_page.DomainPath</code>.
                    <br/>
                    <span class="text-muted">Pages: @_page.Nodes.Count.ToString(CultureInfo.InvariantCulture) · product URL mode: @_page.ProductUrlMode</span>
                </div>
            </div>
        </div>

        <script>
            var content_tree_dump = @((MarkupString)_page.ToTreeJson());
            function epcNode(item) {
                var li = document.createElement('li');
                li.setAttribute('data-id', item.id);
                li.setAttribute('data-url', item.url || '');
                var row = document.createElement('div');
                row.className = 'epc-sm-row';
                row.innerHTML = '<span class="epc-sm-tog"></span><input type="checkbox" class="epc-sm-chk" /><span class="epc-sm-val"></span><span class="epc-sm-ico"></span><span class="epc-sm-url"></span>';
                var val = row.querySelector('.epc-sm-val');
                val.textContent = item.value || '';
                if (item.published_flag == 0) val.classList.add('epc-unpub');
                if (item.main_flag == 1) val.classList.add('epc-main');
                var ico = '';
                if (item.system_flag == 1) ico += '\u2699 ';
                if (item.published_flag == 0) ico += '\uD83D\uDD12 ';
                if (item.main_flag == 1) ico += '\u2605';
                row.querySelector('.epc-sm-ico').textContent = ico;
                row.querySelector('.epc-sm-url').textContent = item.url || '';
                row.querySelector('.epc-sm-tog').onclick = function (e) { e.stopPropagation(); li.classList.toggle('epc-closed'); epcRefreshToggle(li); };
                li.appendChild(row);
                var ul = document.createElement('ul');
                (item.data || []).forEach(function (c) { ul.appendChild(epcNode(c)); });
                li.appendChild(ul);
                epcRefreshToggle(li);
                return li;
            }
            function epcRefreshToggle(li) {
                var has = li.querySelector(':scope > ul > li') !== null;
                li.querySelector(':scope > .epc-sm-row > .epc-sm-tog').textContent = has ? (li.classList.contains('epc-closed') ? '+' : '\u2212') : '';
            }
            function epcCheckAll(on) {
                document.querySelectorAll('#container_A .epc-sm-chk').forEach(function (c) { c.checked = on; });
            }
            function create_sitemap() {
                document.getElementById('messages').innerHTML = '';
                var url_list = [];
                document.querySelectorAll('#container_A li').forEach(function (li) {
                    var chk = li.querySelector(':scope > .epc-sm-row > .epc-sm-chk');
                    if (chk && chk.checked) url_list.push({ url: li.getAttribute('data-url') });
                });
                if (url_list.length == 0) { alert('Select at least one page for the sitemap.'); return; }
                document.getElementById('url_list').value = JSON.stringify(url_list);
                document.getElementById('form_to_save').submit();
            }
            (function () {
                var root = document.createElement('ul');
                content_tree_dump.forEach(function (n) { root.appendChild(epcNode(n)); });
                document.getElementById('container_A').appendChild(root);
            })();
        </script>
    }
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/content/sitemap";
    private const string _listHref = "/cp/sitemap-app";
    private bool _isAdmin;
    private string _flashOk = "";
    private string _flashErr = "";
    private CpSitemapPage _page = new([], "", false, "", "alias");

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        _page = await Sitemap.LoadAsync(ctx.RequestAborted);
    }
}
