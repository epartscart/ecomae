@page "/cp/sitemap-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Sitemap · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Sitemap
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Content URLs, categories, and products counted from tenant tables. Rebuild stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/sitemap-app" IsAdmin="_isAdmin" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (_opened is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @OpenedCaption
                    <a class="btn btn-xs btn-default pull-right" href="@OpenedReturnHref">This row</a>
                    <a class="btn btn-xs btn-default pull-right" href="@_listHref" style="margin-right:.35rem">Close</a>
                </div>
                <div class="panel-body">
                    <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                        <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Alias</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Alias) ? "—" : _opened.Alias)</dd>
                        <dt>URL</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Url) ? "—" : _opened.Url)</dd>
                        <dt>Title</dt><dd>@(string.IsNullOrWhiteSpace(_opened.TitleTag) ? "—" : _opened.TitleTag)</dd>
                        <dt>Lang</dt><dd>@_opened.ValueLangId.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Frontend</dt><dd>@_opened.IsFrontend.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Published</dt><dd>@_opened.PublishedFlag.ToString(CultureInfo.InvariantCulture)</dd>
                    </dl>
                    <p class="text-muted" style="margin:.85rem 0 0">Rebuild stays on the Classic twin.</p>
                    @if (!string.IsNullOrWhiteSpace(_opened.ContentExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:.85rem 0 0">@_opened.ContentExcerpt</pre>
                        @if (_opened.ContentLen > _opened.ContentExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_opened.ContentExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.ContentLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted" style="margin:.85rem 0 0">No content excerpt yet.</p>
                    }
                    @if (_openedSiblings.Count > 0)
                    {
                        <p class="text-muted" style="margin:1rem 0 .4rem">Same-published siblings</p>
                        <div class="table-responsive">
                            <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                                <thead>
                                    <tr>
                                        <th>Id</th>
                                        <th>Alias</th>
                                        <th>Published</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Alias) ? sib.Alias : "—")</td>
                                            <td>@sib.PublishedFlag.ToString(CultureInfo.InvariantCulture)</td>
                                            <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "sm_id", sib.Id)">Open</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No same-published siblings yet.</p>
                    }
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Pages</div>
            <div class="panel-body">
                <p class="help-block">@_summary.ContentUrlCount.ToString(CultureInfo.InvariantCulture) content URLs · @_summary.CategoryCount.ToString(CultureInfo.InvariantCulture) categories · @_summary.ProductCount.ToString(CultureInfo.InvariantCulture) products · @_summary.FrontendContentCount.ToString(CultureInfo.InvariantCulture) frontend pages.</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Alias</th>
                                <th>Frontend</th>
                                <th>Published</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_rows.Count == 0)
                        {
                            <tr><td colspan="5">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Alias) ? row.Alias : "—")</td>
                                    <td>@row.IsFrontend.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.PublishedFlag.ToString(CultureInfo.InvariantCulture)</td>
                                    <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "sm_id", row.Id)">Open</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/content/sitemap";
    private const string _listHref = "/cp/sitemap-app";
    private bool _isAdmin;
    private CpSitemapSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpSitemapRowDigest> _rows = [];
    private long _openedId;
    private CpSitemapDetail? _opened;
    private IReadOnlyList<CpSitemapRowDigest> _openedSiblings = [];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.Alias)
            ? _opened.Alias
            : (!string.IsNullOrWhiteSpace(_opened.TitleTag)
                ? _opened.TitleTag
                : ("Page #" + _opened.Id.ToString(CultureInfo.InvariantCulture))));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?sm_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "sm_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpSitemapDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Pages;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpSitemapDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Page;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }
}
