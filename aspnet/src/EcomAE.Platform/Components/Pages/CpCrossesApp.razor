@page "/cp/crosses-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@inject ICpCrossWriteService Crosses
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Crosses · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">
<div class="col-lg-12">
<style>
    .epc-cx__hint { color:#777; font-size:12px; margin:6px 0 0; }
    .epc-cx__grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .epc-cx__grid label { font-weight:600; font-size:12px; }
    .epc-cx__actions { margin-top:12px; text-align:right; }
    .epc-cross-banner { background:#f7f9fb; border:1px solid #e4e5e7; padding:8px 10px; margin-bottom:10px; font-size:13px; }
    .epc-cross-banner-ok { background:#eefaf1; border-color:#cfe9d6; }
    .table_crosses th a { color:inherit; text-decoration:none; }
    .table_crosses th a.sort-on { text-decoration:underline; }
    .epc-cx-pair__art { font-weight:600; }
    .epc-cx-pair__mfr { color:#555; }
    .table_crosses tr.edit_line td { background:#fffbe6; }
    .table_crosses tr.hidden { display:none; }
    .btn_block form { display:inline; }
    .pagination_box a, .pagination_box span { display:inline-block; padding:3px 8px; margin:0 2px; border:1px solid #ddd; border-radius:3px; text-decoration:none; }
    .pagination_box .pagination_active { background:#3498db; color:#fff; border-color:#3498db; }
</style>
    <div class="hpanel">
        <div class="panel-heading hbuilt">
            Crosses
            <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (!_isAdmin)
    {
        <div class="alert alert-warning" role="status">Sign in with an admin CP session to manage crosses. <a href="/cp/login?returnUrl=/cp/crosses-app">Sign in</a></div>
    }
</div>

@if (_isAdmin)
{
    <div class="col-lg-6">
        <div class="hpanel">
            <div class="panel-heading hbuilt"><i class="fa fa-plus"></i> Add cross</div>
            <div class="panel-body">
                <form method="post" action="/cp/crosses/write">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@_returnHref" />
                    <input type="hidden" name="action" value="add_crosses" />
                    <div class="epc-cx__grid">
                        <div><label for="new_article">Article</label><input class="form-control" type="text" id="new_article" name="article" placeholder="e.g. 45114STD" autocomplete="off" required /></div>
                        <div><label for="new_manufacturer_article">Manufacturer</label><input class="form-control" type="text" id="new_manufacturer_article" name="manufacturer_article" placeholder="e.g. TEIKINP" autocomplete="off" /></div>
                        <div><label for="new_analog">Analog</label><input class="form-control" type="text" id="new_analog" name="analog" placeholder="Interchange article" autocomplete="off" required /></div>
                        <div><label for="new_manufacturer_analog">Manufacturer</label><input class="form-control" type="text" id="new_manufacturer_analog" name="manufacturer_analog" placeholder="Interchange brand" autocomplete="off" /></div>
                    </div>
                    <p class="epc-cx__hint">Leave a manufacturer empty to resolve it from the existing catalog.</p>
                    <div class="epc-cx__actions"><button id="btn_crosses_add" type="submit" class="btn btn-ar btn-primary"><i class="fa fa-plus"></i> Add</button></div>
                </form>
                <hr />
                <form method="post" action="/cp/crosses/write" enctype="multipart/form-data">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@_returnHref" />
                    <input type="hidden" name="action" value="import_csv" />
                    <label for="file_csv">Import from CSV</label>
                    <input class="form-control" type="file" id="file_csv" name="file" accept=".csv,text/csv" required />
                    <p class="epc-cx__hint">Columns: manufacturer;article;manufacturer_cross;article_cross · <a href="/cp/crosses/download.csv">Download current crosses as CSV</a></p>
                    <div class="epc-cx__actions"><button id="btn_crosses_add_of_csv" type="submit" class="btn btn-ar btn-default"><i class="fa fa-upload"></i> Import CSV</button></div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="hpanel">
            <div class="panel-heading hbuilt"><i class="fa fa-filter"></i> Search</div>
            <div class="panel-body">
                <form method="get" action="/cp/crosses-app" id="search_form">
                    <div class="epc-cx__grid">
                        <div><label for="search_article">Article</label><input class="form-control" type="text" id="search_article" name="article" value="@_q.Article" placeholder="Part number" autocomplete="off" /></div>
                        <div>
                            <label for="search_manufacturer">Manufacturer</label>
                            <select id="search_manufacturer" name="manufacturer" class="form-control">
                                <option value="">All</option>
                                @foreach (var m in _result.Manufacturers)
                                {
                                    <option value="@m" selected="@(string.Equals(m, _q.Manufacturer, StringComparison.OrdinalIgnoreCase))">@m</option>
                                }
                            </select>
                        </div>
                        <div><label for="search_id_from">ID from</label><input class="form-control" type="number" id="search_id_from" name="id_from" value="@(_q.IdFrom > 0 ? _q.IdFrom.ToString(CultureInfo.InvariantCulture) : "")" /></div>
                        <div><label for="search_id_before">ID to</label><input class="form-control" type="number" id="search_id_before" name="id_before" value="@(_q.IdBefore > 0 ? _q.IdBefore.ToString(CultureInfo.InvariantCulture) : "")" /></div>
                    </div>
                    <div style="margin-top:8px"><label><input type="checkbox" id="search_null" name="null" value="1" checked="@_q.EmptyOnly" /> Only rows with an empty field</label></div>
                    <input type="hidden" name="sort" value="@_q.SortField" />
                    <input type="hidden" name="dir" value="@(_q.SortAsc ? "asc" : "desc")" />
                    <div class="epc-cx__actions">
                        <a href="/cp/crosses-app" class="btn btn-ar btn-default"><i class="fa fa-eraser"></i> Clear</a>
                        <button type="submit" class="btn btn-ar btn-primary"><i class="fa fa-search"></i> Search</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="hpanel">
            <div class="panel-heading hbuilt"><i class="fa fa-trash"></i> Delete search results</div>
            <div class="panel-body">
                <p class="epc-cx__hint" style="margin-top:0;">Deletes every cross matching the current search filters (max 50000 per run). Requires at least one filter.</p>
                <form method="post" action="/cp/crosses/write" onsubmit="return confirm('Delete all crosses matching the current search?');">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="/cp/crosses-app" />
                    <input type="hidden" name="action" value="del_search_crosses" />
                    <input type="hidden" name="article" value="@_q.Article" />
                    <input type="hidden" name="manufacturer" value="@_q.Manufacturer" />
                    <input type="hidden" name="null" value="@(_q.EmptyOnly ? "1" : "0")" />
                    <input type="hidden" name="id_from" value="@_q.IdFrom" />
                    <input type="hidden" name="id_before" value="@_q.IdBefore" />
                    <button type="submit" class="btn btn-ar btn-danger btn-block" disabled="@(!_result.Filtered)"><i class="fa fa-trash"></i> Delete found crosses</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                <i class="fa fa-table"></i> Crosses table
                <a class="pull-right" href="/cp/crosses/download.csv" title="Download crosses CSV"><i class="fa fa-download"></i> Download CSV</a>
            </div>
            <div class="panel-body" id="table_crosses">
                @if (!string.IsNullOrWhiteSpace(_result.Message))
                {
                    <div class="alert alert-danger">@_result.Message</div>
                }
                @if (!_result.Filtered)
                {
                    <div class="epc-cross-banner">Browsing latest links@(_result.TotalApprox ? " (~" + _result.Total.ToString("N0", CultureInfo.InvariantCulture) + " in catalog)" : ""). Search by part number for exact matches.</div>
                }
                else
                {
                    <div class="epc-cross-banner epc-cross-banner-ok">Filtered: <strong>@_result.Total.ToString("N0", CultureInfo.InvariantCulture)</strong> row(s).</div>
                }
                @if (_result.Rows.Count == 0)
                {
                    <p class="text-muted">No records</p>
                }
                else
                {
                    <table class="table table-striped table_crosses">
                        <thead>
                            <tr>
                                <th><a href="@SortHref("article")" class="@SortClass("article")">Article</a></th>
                                <th><a href="@SortHref("manufacturer_article")" class="@SortClass("manufacturer_article")">Manufacturer</a></th>
                                <th><a href="@SortHref("analog")" class="@SortClass("analog")">Analog</a></th>
                                <th><a href="@SortHref("manufacturer_analog")" class="@SortClass("manufacturer_analog")">Analog manufacturer</a></th>
                                <th><a href="@SortHref("id")" class="@SortClass("id")">ID</a></th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var r in _result.Rows)
                        {
                            var rid = r.Id.ToString(CultureInfo.InvariantCulture);
                            var open = r.Id == _openedId;
                            <tr id="erp-row-@rid" class="@(open ? "hidden" : "")">
                                <td><span class="epc-cx-pair__art">@r.Article</span></td>
                                <td><span class="epc-cx-pair__mfr">@r.ManufacturerArticle</span></td>
                                <td><span class="epc-cx-pair__art">@r.Analog</span></td>
                                <td><span class="epc-cx-pair__mfr">@r.ManufacturerAnalog</span></td>
                                <td>@rid</td>
                                <td class="btn_block">
                                    <a class="btn btn-sm btn-primary" title="Edit" href="@ErpRecordOpen.Href(_listHref + _queryTail, "cross_id", r.Id)"><i class="fas fa-pencil-alt"></i></a>
                                    <form method="post" action="/cp/crosses/write" onsubmit="return confirm('Delete this cross?');">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="@_returnHref" />
                                        <input type="hidden" name="action" value="del_crosses" />
                                        <input type="hidden" name="id" value="@rid" />
                                        <button type="submit" class="btn btn-sm btn-danger" title="Delete"><i class="fa fa-times"></i></button>
                                    </form>
                                </td>
                            </tr>
                            @if (open)
                            {
                                <tr class="edit_line" id="edit_line_@rid">
                                    <td colspan="6">
                                        <form method="post" action="/cp/crosses/write">
                                            <input type="hidden" name="confirmWrites" value="true" />
                                            <input type="hidden" name="returnUrl" value="@_returnHref" />
                                            <input type="hidden" name="action" value="save_crosses" />
                                            <input type="hidden" name="id" value="@rid" />
                                            <div class="epc-cx__grid">
                                                <input class="form-control" type="text" id="article_edit_@rid" name="article" value="@r.Article" required />
                                                <input class="form-control" type="text" id="manufacturer_article_edit_@rid" name="manufacturer_article" value="@r.ManufacturerArticle" />
                                                <input class="form-control" type="text" id="analog_edit_@rid" name="analog" value="@r.Analog" required />
                                                <input class="form-control" type="text" id="manufacturer_analog_edit_@rid" name="manufacturer_analog" value="@r.ManufacturerAnalog" />
                                            </div>
                                            <div class="epc-cx__actions">
                                                <button type="submit" class="btn btn-sm btn-success"><i class="far fa-save"></i> Save</button>
                                                <a class="btn btn-sm btn-default" href="@_returnHref"><i class="fa fa-chevron-left"></i> Cancel</a>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                }
            </div>
            @if (_result.Pages > 1)
            {
                <div class="panel-footer">
                    <div class="pagination_box">
                        @foreach (var p in PageNumbers())
                        {
                            if (p == _result.Page)
                            {
                                <span class="pagination_active">@p</span>
                            }
                            else if (p < 0)
                            {
                                <span>…</span>
                            }
                            else
                            {
                                <a href="@PageHref(p)">@p</a>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/crosses";
    private const string _listHref = "/cp/crosses-app";
    private bool _isAdmin;
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private string _queryTail = "";
    private string _returnHref = "/cp/crosses-app";
    private CpCrossSearchRequest _q = new("", "", false, 0, 0, 1, 30, "id", false);
    private CpCrossSearchResult _result = new([], 0, false, false, 1, 30, [], "");

    private string SortHref(string field)
    {
        var asc = string.Equals(_q.SortField, field, StringComparison.Ordinal) ? !_q.SortAsc : field != "id";
        return Build(_q with { SortField = field, SortAsc = asc, Page = 1 });
    }

    private string SortClass(string field) => string.Equals(_q.SortField, field, StringComparison.Ordinal) && _result.Filtered ? "sort-on" : "";

    private string PageHref(int page) => Build(_q with { Page = page });

    private IEnumerable<int> PageNumbers()
    {
        var pages = _result.Pages;
        var cur = _result.Page;
        var last = 0;
        for (var p = 1; p <= pages; p++)
        {
            if (p <= 2 || p > pages - 2 || Math.Abs(p - cur) <= 2)
            {
                if (last > 0 && p - last > 1) yield return -1;
                yield return p;
                last = p;
            }
        }
    }

    private static string Build(CpCrossSearchRequest q)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(q.Article)) parts.Add("article=" + Uri.EscapeDataString(q.Article));
        if (!string.IsNullOrWhiteSpace(q.Manufacturer)) parts.Add("manufacturer=" + Uri.EscapeDataString(q.Manufacturer));
        if (q.EmptyOnly) parts.Add("null=1");
        if (q.IdFrom > 0) parts.Add("id_from=" + q.IdFrom.ToString(CultureInfo.InvariantCulture));
        if (q.IdBefore > 0) parts.Add("id_before=" + q.IdBefore.ToString(CultureInfo.InvariantCulture));
        if (q.SortField != "id") parts.Add("sort=" + q.SortField);
        if (q.SortAsc) parts.Add("dir=asc");
        if (q.Page > 1) parts.Add("page=" + q.Page.ToString(CultureInfo.InvariantCulture));
        return parts.Count == 0 ? _listHref : _listHref + "?" + string.Join("&", parts);
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var rq = ctx.Request.Query;
        _flashOk = rq["ok"].ToString() ?? "";
        _flashErr = rq["err"].ToString() ?? "";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "cross_id");
        _q = new CpCrossSearchRequest(
            rq["article"].ToString(),
            rq["manufacturer"].ToString(),
            rq["null"].ToString() is "1" or "true" or "on",
            long.TryParse(rq["id_from"], NumberStyles.Integer, CultureInfo.InvariantCulture, out var f) ? f : 0,
            long.TryParse(rq["id_before"], NumberStyles.Integer, CultureInfo.InvariantCulture, out var b) ? b : 0,
            int.TryParse(rq["page"], NumberStyles.Integer, CultureInfo.InvariantCulture, out var p) && p > 0 ? p : 1,
            30,
            string.IsNullOrWhiteSpace(rq["sort"]) ? "id" : rq["sort"].ToString(),
            string.Equals(rq["dir"], "asc", StringComparison.OrdinalIgnoreCase));
        _returnHref = Build(_q);
        _queryTail = _returnHref.Length > _listHref.Length ? _returnHref[_listHref.Length..] : "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin) return;

        _result = await Crosses.SearchAsync(_q, ctx.RequestAborted);
        if (_openedId > 0 && !_result.Rows.Any(r => r.Id == _openedId))
        {
            var one = await Crosses.SearchAsync(new CpCrossSearchRequest("", "", false, _openedId, _openedId, 1, 1, "id", false), ctx.RequestAborted);
            if (one.Rows.Count == 1)
            {
                _result = _result with { Rows = one.Rows.Concat(_result.Rows).ToList() };
            }
            else
            {
                _flashErr = "Cross #" + _openedId.ToString(CultureInfo.InvariantCulture) + " was not found.";
            }
        }
    }
}
