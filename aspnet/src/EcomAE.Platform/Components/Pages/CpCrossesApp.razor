@page "/cp/crosses-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Crosses · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Crosses
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/crosses-app")</p>
                <p>Cross add/save/delete write here when confirmWrites is set.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/crosses-app" IsAdmin="_isAdmin" />


    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <div style="display:grid;gap:.65rem;margin:0 0 1rem">
            <form method="post" action="/cp/crosses/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/crosses-app" />
                <input type="hidden" name="action" value="save_crosses" />
                <label>Id <input type="number" name="id" min="1" required /></label>
                <label>Article <input type="text" name="article" required maxlength="255" /></label>
                <label>Manufacturer <input type="text" name="manufacturer_article" required maxlength="255" /></label>
                <label>Analog <input type="text" name="analog" required maxlength="255" /></label>
                <label>Analog manufacturer <input type="text" name="manufacturer_analog" required maxlength="255" /></label>
                <button type="submit">Save cross</button>
            </form>
            <form method="post" action="/cp/crosses/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/crosses-app" />
                <input type="hidden" name="action" value="del_crosses" />
                <label>Id <input type="number" name="id" min="1" required /></label>
                <button type="submit">Delete cross</button>
            </form>
            <form method="post" action="/cp/crosses/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/crosses-app" />
                <input type="hidden" name="action" value="add_crosses" />
                <label>Article <input type="text" name="article" required maxlength="255" /></label>
                <label>Manufacturer <input type="text" name="manufacturer_article" maxlength="255" placeholder="optional" /></label>
                <label>Analog <input type="text" name="analog" required maxlength="255" /></label>
                <label>Analog manufacturer <input type="text" name="manufacturer_analog" maxlength="255" placeholder="optional" /></label>
                <button type="submit">Add cross</button>
            </form>
            <form method="post" action="/cp/crosses/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/crosses-app" />
                <input type="hidden" name="action" value="del_search_crosses" />
                <label>Article <input type="text" name="article" maxlength="255" /></label>
                <label>Manufacturer <input type="text" name="manufacturer" maxlength="255" /></label>
                <label>Id from <input type="number" name="id_from" min="0" /></label>
                <label>Id before <input type="number" name="id_before" min="0" /></label>
                <label><input type="checkbox" name="empty_only" value="1" /> Empty fields only</label>
                <button type="submit">Search-delete</button>
            </form>
        </div>
    }

    <p class="help-block">@_summary.TotalPairs.ToString(CultureInfo.InvariantCulture) Total pairs · @_summary.Brands.ToString(CultureInfo.InvariantCulture) Brands.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Manufacturer</th>
                    <th>Article</th>
                    <th>Cross mfr</th>
                    <th>Cross article</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_pairs.Count == 0)
                {
                    <tr><td colspan="6">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var p in _pairs)
                    {
                        <tr>
                            <td><strong>@p.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(p.Manufacturer) ? "—" : p.Manufacturer)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.Article) ? "—" : p.Article)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.CrossManufacturer) ? "—" : p.CrossManufacturer)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.CrossArticle) ? "—" : p.CrossArticle)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

    <div class="epc-x-note">Save, add, delete, and search-delete write when confirmWrites is set. File import and crossbase stay on the PHP twin.</div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/crosses";
    private bool _isAdmin;
    private CpCrossesSummary _summary = new(0, 0, "n/a", "");
    private IReadOnlyList<CpCrossPairDigest> _pairs = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpCrossesDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _pairs = result.Pairs;
        _source = result.Source;
        _message = result.Message;
    }
}
