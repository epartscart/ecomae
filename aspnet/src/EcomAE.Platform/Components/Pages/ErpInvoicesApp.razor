@page "/erp/invoices-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Invoices · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Invoices" BreadcrumbArea="Order to Cash" BreadcrumbTab="Invoices">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/invoices-app" IsAdmin="_isAdmin" />


    
    <PhpErpModulePageHeader Title="Invoices" Subtitle="Open an invoice for the payment-terms excerpt, VAT, and amount due. Writes stay Classic." PhpTabHref="@_phpTab" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="/erp/invoices-app" />
    <p class="text-muted" style="margin:0 0 10px;">
        <a href="/erp/sales-orders-app">Sales orders</a>
        · <a href="/erp/invoices-app">Invoices</a>
        · <a href="/erp/receivables-app">Receivables</a>
        · <a href="/erp/delivery-notes-app">Delivery notes</a>
    </p>
    <form method="get" action="/erp/invoices-app" class="form-inline" style="margin-bottom:10px;">
        <label>Show</label>
        <select name="f_status" class="form-control input-sm" onchange="this.form.submit()">
            <option value="all" selected="@(_status == "all")">All</option>
            <option value="open" selected="@(_status == "open")">Open</option>
            <option value="paid" selected="@(_status == "paid")">Paid</option>
            <option value="cancelled" selected="@(_status == "cancelled")">Cancelled</option>
        </select>
    </form>

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Invoice KPIs">
        <div class="kpi"><div class="lbl">Shown</div><div class="val">@_visible.Count</div></div>
        <div class="kpi"><div class="lbl">Open</div><div class="val">@_open</div></div>
        <div class="kpi"><div class="lbl">Total incl. VAT</div><div class="val">@_totalInclVat.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedDetail is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="/erp/invoices-app">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Invoice id</dt><dd>@_openedDetail.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Invoice #</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.InvoiceNumber) ? "—" : _openedDetail.InvoiceNumber)</dd>
                <dt>Category</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.DocCategory) ? "—" : _openedDetail.DocCategory)</dd>
                <dt>Customer</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.CustomerEmail) ? ("user " + _openedDetail.UserId.ToString(CultureInfo.InvariantCulture)) : _openedDetail.CustomerEmail)</dd>
                <dt>Order</dt><dd>@(_openedDetail.OrderId > 0 ? _openedDetail.OrderId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Issued</dt><dd>@FormatTime(_openedDetail.IssueDate)</dd>
                <dt>Due</dt><dd>@FormatTime(_openedDetail.PaymentDueDate)</dd>
                <dt>Currency</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.CurrencyCode) ? "—" : _openedDetail.CurrencyCode)</dd>
                <dt>Ex VAT</dt><dd>@_openedDetail.SubtotalExVat.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>VAT</dt><dd>@_openedDetail.TotalVat.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Total</dt><dd>@_openedDetail.TotalInclVat.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Paid</dt><dd>@_openedDetail.PaidAmount.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Amount due</dt><dd>@_openedDetail.AmountDue.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.Status) ? "—" : _openedDetail.Status)</dd>
                <dt>Validated</dt><dd>@(_openedDetail.ValidationOk ? "yes" : "no")</dd>
                <dt>ASP</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.AspName) ? "—" : _openedDetail.AspName)</dd>
                <dt>ASP ref</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.AspReference) ? "—" : _openedDetail.AspReference)</dd>
                <dt>FTA</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.FtaReportStatus) ? "—" : _openedDetail.FtaReportStatus)</dd>
                <dt>Admin</dt><dd>@(_openedDetail.AdminId > 0 ? _openedDetail.AdminId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Created</dt><dd>@FormatTime(_openedDetail.TimeCreated)</dd>
                <dt>Updated</dt><dd>@FormatTime(_openedDetail.TimeUpdated)</dd>
                <dt>Submitted</dt><dd>@FormatTime(_openedDetail.TimeSubmitted)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Writes stay Classic.</p>
            @if (!string.IsNullOrWhiteSpace(_openedDetail.PaymentTermsExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">payment-terms excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedDetail.PaymentTermsExcerpt</pre>
                @if (_openedDetail.PaymentTermsLen > _openedDetail.PaymentTermsExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_openedDetail.PaymentTermsExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedDetail.PaymentTermsLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No payment-terms excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Invoice #</th><th>Customer</th><th class="text-right">Total</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.InvoiceNumber) ? "—" : sib.InvoiceNumber)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.CustomerEmail) ? ("user " + sib.UserId.ToString(CultureInfo.InvariantCulture)) : sib.CustomerEmail)</td>
                                <td class="text-right">@sib.TotalInclVat.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href("/erp/invoices-app", "inv_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Issued</th>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Total incl. VAT</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_visible.Count == 0)
                {
                    <tr><td colspan="7" class="text-muted">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No invoices." : _message) : "Sign in with ERP capability for live invoices.")</td></tr>
                }
                else
                {
                    @foreach (var inv in _visible)
                    {
                        <tr id="erp-row-@inv.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(inv.Id, _openedId)">
                            <td><a href="@ErpRecordOpen.Href("/erp/invoices-app", "inv_id", inv.Id)"><strong>@(string.IsNullOrWhiteSpace(inv.InvoiceNumber) ? $"#{inv.Id}" : inv.InvoiceNumber)</strong></a></td>
                            <td>@FormatTime(inv.IssueDate)</td>
                            <td>@(inv.OrderId > 0 ? inv.OrderId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(inv.CustomerEmail) ? $"user {inv.UserId}" : inv.CustomerEmail)</td>
                            <td><span class="label label-@ErpPhpStatusLabel.Class(inv.Status)">@inv.Status</span></td>
                            <td>@inv.TotalInclVat.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href("/erp/invoices-app", "inv_id", inv.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=sales&tab=invoices";
    private bool _isAdmin;
    private IReadOnlyList<ErpInvoiceDigest> _invoices = [];
    private IReadOnlyList<ErpInvoiceDigest> _visible = [];
    private int _open;
    private decimal _totalInclVat;
    private int _limit = 100;
    private string _status = "all";
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpInvoiceDigest? _openedInvoice;
    private ErpInvoiceDetail? _openedDetail;
    private IReadOnlyList<ErpInvoiceDigest> _openedSiblings = [];

    private bool OpenedFound => _openedDetail is not null || _openedInvoice is not null;

    private string OpenedReturnHref => _openedId > 0
        ? "/erp/invoices-app?inv_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : "/erp/invoices-app";

    private string OpenedCaption => _openedDetail is not null
        ? (string.IsNullOrWhiteSpace(_openedDetail.InvoiceNumber) ? ("Invoice #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.InvoiceNumber)
            + (string.IsNullOrWhiteSpace(_openedDetail.DocCategory) ? "" : (" · " + _openedDetail.DocCategory))
        : _openedInvoice is null
            ? ""
            : (string.IsNullOrWhiteSpace(_openedInvoice.InvoiceNumber) ? $"Invoice #{_openedInvoice.Id}" : _openedInvoice.InvoiceNumber) + " · " + _openedInvoice.Status;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _status = (ctx.Request.Query["f_status"].ToString() ?? "all").Trim().ToLowerInvariant();
        if (_status is not ("all" or "open" or "paid" or "cancelled")) _status = "all";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "inv_id", "invoice_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListErpInvoicesAsync(_limit, ctx.RequestAborted);
        _invoices = result.Invoices;
        _visible = _status switch
        {
            "paid" => _invoices.Where(i => string.Equals(i.Status, "paid", StringComparison.OrdinalIgnoreCase) || string.Equals(i.Status, "closed", StringComparison.OrdinalIgnoreCase)).ToList(),
            "cancelled" => _invoices.Where(i => i.Status.Contains("cancel", StringComparison.OrdinalIgnoreCase) || string.Equals(i.Status, "void", StringComparison.OrdinalIgnoreCase)).ToList(),
            "open" => _invoices.Where(IsOpenInvoice).ToList(),
            _ => _invoices,
        };
        _openedInvoice = _openedId > 0 ? _invoices.FirstOrDefault(i => i.Id == _openedId) : null;
        if (_openedInvoice is not null && !_visible.Any(i => i.Id == _openedId))
        {
            _visible = new[] { _openedInvoice }.Concat(_visible).ToList();
        }
        else if (_openedInvoice is not null)
        {
            _visible = new[] { _openedInvoice }.Concat(_visible.Where(i => i.Id != _openedId)).ToList();
        }
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpInvoiceDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Invoice;
            _openedSiblings = detail.Siblings;
            if (_openedDetail is null && !string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
        _open = _invoices.Count(IsOpenInvoice);
        _totalInclVat = _visible.Sum(i => i.TotalInclVat);
        _source = result.Source;
        _message = result.Message;
    }

    private static bool IsOpenInvoice(ErpInvoiceDigest i) =>
        !string.Equals(i.Status, "closed", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(i.Status, "cancelled", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(i.Status, "canceled", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(i.Status, "void", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(i.Status, "paid", StringComparison.OrdinalIgnoreCase);

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
