@page "/erp/invoices-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Invoices · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Invoices" BreadcrumbArea="Order to Cash" BreadcrumbTab="Invoices">

    
    <PhpErpModulePageHeader Title="Invoices" Subtitle="ASP.NET Core digest — PHP compare only under /php-reference/*." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />


    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Invoice KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_invoices.Count</div></div>
        <div class="kpi"><div class="lbl">Non-closed in page</div><div class="val">@_open</div></div>
        <div class="kpi"><div class="lbl">Page total incl. VAT</div><div class="val">@_totalInclVat.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Issued</th>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Total incl. VAT</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_invoices.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "Nothing to show yet." : _message) : "Sign in with ERP capability for live invoices.")</td></tr>
                }
                else
                {
                    @foreach (var inv in _invoices)
                    {
                        var phpHref = $"{_phpTab}&inv_id={inv.Id.ToString(CultureInfo.InvariantCulture)}";
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(inv.InvoiceNumber) ? $"#{inv.Id}" : inv.InvoiceNumber)</strong></td>
                            <td>@FormatTime(inv.IssueDate)</td>
                            <td>@(inv.OrderId > 0 ? inv.OrderId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(inv.CustomerEmail) ? $"user {inv.UserId}" : inv.CustomerEmail)</td>
                            <td><span class="label label-default">@inv.Status</span></td>
                            <td>@inv.TotalInclVat.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(phpHref)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=sales&tab=invoices";
    private bool _isAdmin;
    private IReadOnlyList<ErpInvoiceDigest> _invoices = [];
    private int _open;
    private decimal _totalInclVat;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListErpInvoicesAsync(_limit, ctx.RequestAborted);
        _invoices = result.Invoices;
        _open = _invoices.Count(i => !string.Equals(i.Status, "closed", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(i.Status, "cancelled", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(i.Status, "canceled", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(i.Status, "void", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(i.Status, "paid", StringComparison.OrdinalIgnoreCase));
        _totalInclVat = _invoices.Sum(i => i.TotalInclVat);
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
