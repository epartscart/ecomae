@page "/cp/workshop-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Workshop · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <PhpCpModulePageHeader Title="Workshop &amp; service desk"
                           Subtitle="Assign, save bay, save tech, and set status write here. Seed, create-job, lines, and appointments stay on the PHP twin."
                           PhpTabHref="@_phpTab">
        <a class="ghost" href="/cp/sao-app">SAO</a>
        <a class="ghost" href="/cp/orders">Orders</a>
        <a class="ghost" href="/cp/storages-app">Storages</a>
    </PhpCpModulePageHeader>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (!_isAdmin)
    {
        <div class="alert alert-info" role="status">Sign in with a Control Panel admin session to load live tenant data. Guest browse shows the PHP-parity shell.</div>
    }
    else
    {
        <form method="post" action="/cp/workshop/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/workshop-app" />
            <input type="hidden" name="action" value="assign" />
            <label>Job id <input type="number" name="jobId" min="1" required style="width:6rem" /></label>
            <label>Bay id <input type="number" name="bayId" min="0" value="0" style="width:6rem" /></label>
            <label>Tech id <input type="number" name="techId" min="0" value="0" style="width:6rem" /></label>
            <button type="submit" class="btn btn-xs btn-primary">Assign</button>
        </form>
        <form method="post" action="/cp/workshop/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/workshop-app" />
            <input type="hidden" name="action" value="save_bay" />
            <label>Bay id (0=new) <input type="number" name="id" min="0" value="0" style="width:6rem" /></label>
            <label>Code <input type="text" name="code" required maxlength="32" /></label>
            <label>Name <input type="text" name="name" required maxlength="190" /></label>
            <label>Active
                <select name="active">
                    <option value="1">1</option>
                    <option value="0">0</option>
                </select>
            </label>
            <button type="submit" class="btn btn-xs btn-default">Save bay</button>
        </form>
        <form method="post" action="/cp/workshop/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/workshop-app" />
            <input type="hidden" name="action" value="save_tech" />
            <label>Tech id (0=new) <input type="number" name="id" min="0" value="0" style="width:6rem" /></label>
            <label>Name <input type="text" name="name" required maxlength="190" /></label>
            <label>Phone <input type="text" name="phone" maxlength="64" /></label>
            <label>Skill <input type="text" name="skill" maxlength="190" /></label>
            <label>Active
                <select name="active">
                    <option value="1">1</option>
                    <option value="0">0</option>
                </select>
            </label>
            <button type="submit" class="btn btn-xs btn-default">Save tech</button>
        </form>
        <form method="post" action="/cp/workshop/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/workshop-app" />
            <input type="hidden" name="action" value="set_status" />
            <label>Job id <input type="number" name="jobId" min="1" required style="width:6rem" /></label>
            <label>Status
                <select name="status">
                    <option value="checkin">checkin</option>
                    <option value="estimate">estimate</option>
                    <option value="approved">approved</option>
                    <option value="in_progress">in_progress</option>
                    <option value="qc">qc</option>
                    <option value="ready">ready</option>
                    <option value="delivered">delivered</option>
                    <option value="cancelled">cancelled</option>
                </select>
            </label>
            <button type="submit" class="btn btn-xs btn-primary">Set status</button>
        </form>
    }

    <div class="epc-scp-kpi" aria-label="Workshop KPIs">
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Open jobs</div>
            <div class="epc-scp-kpi__val">@_summary.OpenCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">In progress / QC</div>
            <div class="epc-scp-kpi__val">@_summary.InProgressCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Ready for collection</div>
            <div class="epc-scp-kpi__val">@_summary.ReadyCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Delivered today</div>
            <div class="epc-scp-kpi__val">@_summary.DeliveredToday.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Open job value</div>
            <div class="epc-scp-kpi__val">AED @_summary.RevenueOpen.ToString("N0", CultureInfo.InvariantCulture)</div>
        </div>
    </div>

    <div class="epc-scp-tool-grid" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;margin-bottom:1rem;">
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab + "?tab=board")">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">Board</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">job cards</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab + "?tab=jobs")">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">Jobs</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">list/filter</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab + "?tab=checkin")">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">Check-in</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">technician intake</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab + "?tab=schedule")">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">Schedule</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">calendar slots</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab + "?tab=resources")">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">Bays &amp; techs</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">resources</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab + "?tab=guide")">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">Guide</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">operator help</p>
        </a>
    </div>

    <div class="epc-scp-table-card">
        <div class="epc-scp-table-card__head">
            <div>
                <h3>Jobs</h3>
                <p class="epc-users-hint">PHP job list — job_no, plate, make/model/year, customer, status, bay, tech, grand_total. Phone/email omitted.</p>
            </div>
            <a class="btn btn-primary btn-xs" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Open PHP module</a>
        </div>
        <table class="epc-scp-data-table table table-epc-pro">
            <thead>
                <tr>
                    <th>Job no</th>
                    <th>Plate</th>
                    <th>Make / model / year</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Bay</th>
                    <th>Tech</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_jobs.Count == 0)
                {
                    <tr><td colspan="9">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _jobs)
                    {
                        var vehicle = string.Join(" / ", new[] { row.Make, row.Model, row.Year }.Where(s => !string.IsNullOrWhiteSpace(s)));
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.JobNo) ? row.Id.ToString(CultureInfo.InvariantCulture) : row.JobNo)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Plate) ? "—" : row.Plate)</td>
                            <td>@(string.IsNullOrWhiteSpace(vehicle) ? "—" : vehicle)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.CustomerName) ? "—" : row.CustomerName)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Status) ? "—" : row.Status)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.BayName) ? "—" : row.BayName)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.TechName) ? "—" : row.TechName)</td>
                            <td>@row.GrandTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref($"{_phpTab}?tab=jobs&job_id={row.Id.ToString(CultureInfo.InvariantCulture)}")">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/workshop";
    private bool _isAdmin;
    private CpWorkshopSummary _summary = new(0, 0, 0, 0, 0m, "n/a", "");
    private IReadOnlyList<CpWorkshopJobDigest> _jobs = [];
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpWorkshopDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _jobs = result.Jobs;
    }
}
