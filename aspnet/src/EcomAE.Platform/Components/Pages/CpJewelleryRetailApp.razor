@page "/erp/jewellery-retail-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Jewellery retail · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="@_spec.Title" BreadcrumbArea="Jewellery" BreadcrumbTab="@_spec.Label">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="@_appPath" IsAdmin="_isAdmin" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />
    <PhpErpModulePageHeader Title="@_spec.Title" Subtitle="@_spec.Subtitle" />
    <ErpPhpFlash Ok="@_ok" Err="@_err" />
    <ErpJewelleryReportsMenu />
    @if (_opened is not null)
    {
        <ErpRecordDetailView Caption="@OpenedCaption" ListHref="@_listHref" PrintHref="@($"/erp/jewellery/voucher-print?id={_openedId}")" DesignKind="invoice" GlReferencePrefix="@($"JW-V-{_openedId}-")">
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong> <a class="btn btn-xs btn-default" href="@_listHref">Close</a></p>
            <dl class="epc-erp-facts">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Voc no</dt><dd>@_opened.VocNo.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Date</dt><dd>@(string.IsNullOrWhiteSpace(_opened.VocDate) ? "—" : _opened.VocDate)</dd>
                <dt>Type</dt><dd>@(string.IsNullOrWhiteSpace(_opened.VocType) ? "—" : _opened.VocType)</dd>
                <dt>Party</dt><dd>@(string.IsNullOrWhiteSpace(_opened.PartyName) ? "—" : _opened.PartyName)</dd>
                <dt>Party code</dt><dd>@(string.IsNullOrWhiteSpace(_opened.PartyCode) ? "—" : _opened.PartyCode)</dd>
                <dt>Salesman</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Salesman) ? "—" : _opened.Salesman)</dd>
                <dt>Business unit</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Branch) ? "—" : _opened.Branch)</dd>
                <dt>Net</dt><dd>@_opened.NetAmount.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Status) ? "—" : _opened.Status)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Customer PII omitted.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.NarrationExcerpt))
            {
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:.85rem 0 0">@_opened.NarrationExcerpt</pre>
                @if (_opened.NarrationLen > _opened.NarrationExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.NarrationExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NarrationLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No narration excerpt yet.</p>
            }
            @if (_opened.LineItems.Count > 0)
            {
                <h4>Voucher lines</h4>
                <div class="epc-erp-table-wrap">
                    <table class="table table-bordered table-condensed table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Line</th>
                                <th>Stock code</th>
                                <th>Description</th>
                                <th>Division</th>
                                <th>Pcs</th>
                                <th>Gross wt</th>
                                <th>Purity</th>
                                <th>Pure wt</th>
                                <th>Metal</th>
                                <th>Making</th>
                                <th>Stone</th>
                                <th>Discount</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in _opened.LineItems)
                            {
                                <tr>
                                    <td>@line.LineNo</td>
                                    <td>@line.StockCode</td>
                                    <td>@line.Description</td>
                                    <td>@line.Division</td>
                                    <td>@line.Pcs</td>
                                    <td>@line.GrossWeight.ToString("N4", CultureInfo.InvariantCulture)</td>
                                    <td>@line.Purity.ToString("N6", CultureInfo.InvariantCulture)</td>
                                    <td>@line.PureWeight.ToString("N4", CultureInfo.InvariantCulture)</td>
                                    <td>@line.MetalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@line.MakingAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@line.StoneAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@line.DiscountAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@line.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                            <tr style="font-weight:600;background:#f2f6fa">
                                <td colspan="4">Total</td>
                                <td>@_opened.LineItems.Sum(l => l.Pcs)</td>
                                <td>@_opened.LineItems.Sum(l => l.GrossWeight).ToString("N4", CultureInfo.InvariantCulture)</td>
                                <td></td>
                                <td>@_opened.LineItems.Sum(l => l.PureWeight).ToString("N4", CultureInfo.InvariantCulture)</td>
                                <td>@_opened.LineItems.Sum(l => l.MetalAmount).ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@_opened.LineItems.Sum(l => l.MakingAmount).ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@_opened.LineItems.Sum(l => l.StoneAmount).ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@_opened.LineItems.Sum(l => l.DiscountAmount).ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@_opened.LineItems.Sum(l => l.TotalAmount).ToString("N2", CultureInfo.InvariantCulture)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Voc no</th>
                            <th>Party</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@sib.VocNo.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.PartyName) ? "—" : sib.PartyName)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "voc_id", sib.Id)" target="_blank" rel="noopener">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
            </ErpRecordDetailView>
    }
    else
    {

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Jewellery retail stats">
        <div class="kpi"><div class="lbl">Vouchers</div><div class="val">@_summary.VoucherCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open vouchers</div><div class="val">@_summary.OpenVouchers.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Tags</div><div class="val">@_summary.TagCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Metal stock rows</div><div class="val">@_summary.MetalStockRows.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <ErpPhpViewTabs QueryName="tab" Active="@_tab" BaseHref="@_tabBase" Tabs="@ErpJewelleryModuleChrome.RetailTabs" />

    <div class="epc-erp-empty" style="display:block;margin:12px 0;padding:10px;border:1px solid #c5d4de;background:#f8fafc;color:#334155;">
        <strong>Metal books.</strong> Net weight is gross minus stones and other material. Pure gold is that net times purity per thousand. An exchange keeps the full sale and the old-gold purchase apart. A POS line keeps metal, making, stones, and VAT, and the cash taken cannot exceed that sale. A melt records the variance and leaves the original tag weight in place.
        <a href="@WorkbookHref("template")">Download template</a>
        <a href="@WorkbookHref("package")">Download package</a>
    </div>

    @if (_isAdmin)
    {
        <div class="epc-erp-empty" style="display:block;margin:12px 0;padding:10px;border:1px solid #c5d4de;background:#f8fafc;">
            <form method="get" action="@_appPath" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin:0;">
                <input type="hidden" name="tab" value="@_tab" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <label>Tag / barcode / stock code
                    <input class="form-control input-sm" name="lookup" value="@_lookupQuery" maxlength="100" />
                </label>
                <button type="submit" class="btn btn-default btn-sm">Find item</button>
            </form>
            @if (_lookupQuery.Length > 0)
            {
                <p class="text-muted" style="margin:.6rem 0 .35rem">@_lookupMessage</p>
                @if (_lookupRows.Count > 0)
                {
                    <div class="epc-erp-table-wrap">
                        <table class="table table-bordered table-condensed table-epc epc-erp-table">
                            <thead>
                                <tr><th>Source</th><th>Tag</th><th>Barcode</th><th>Description / stock</th><th>Status</th><th>Gross wt</th><th>Net wt</th><th>Sell price</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _lookupRows)
                                {
                                    <tr>
                                        <td>@item.SourceTable</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.TagNo) ? "—" : item.TagNo)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Barcode) ? "—" : item.Barcode)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Status) ? "—" : item.Status)</td>
                                        <td>@item.GrossWeight.ToString("N4", CultureInfo.InvariantCulture)</td>
                                        <td>@item.NetWeight.ToString("N4", CultureInfo.InvariantCulture)</td>
                                        <td>@item.SellPrice.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    }


    @if (_isAdmin && _tab == "jw_pos_advance")
    {
        <ErpPhpCreateWell Title="New POS advance">
            <form method="post" action="@WriteAction(EcomAeRoutes.ErpJewelleryVoucherSaveForm)" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <input type="hidden" name="action" value="jw_pos_advance_save" />
                <input type="hidden" name="voc_type" value="ADV" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <ErpVoucherHeaderFields NumberPreview="Auto" />
                <ErpMasterPicker Kind="customer" FieldName="customer_name" InputId="jw-pos-advance-customer" Label="Customer" ValueMode="name" Required="true" CodeFieldName="party_code" />
                <input type="hidden" name="party_code" value="" />
                <label>Amount <input class="form-control input-sm" name="net_amount" type="number" step="0.01" value="0" /></label>
                <label>Narration <input class="form-control input-sm" name="narration" maxlength="200" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save POS advance</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "jw_petty_cash")
    {
        <ErpPhpCreateWell Title="New petty cash">
            <form method="post" action="@WriteAction(EcomAeRoutes.ErpJewelleryPettyCashSaveForm)" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <ErpVoucherHeaderFields DateFieldName="voc_date" NumberPreview="Auto" />
                <label>Paid to <input class="form-control input-sm" name="paid_to" required maxlength="120" /></label>
                <ErpMasterPicker Kind="coa" FieldName="account_code" InputId="jw-petty-coa" Label="Chart account" ValueMode="code" />
                <label>Amount <input class="form-control input-sm" name="total" type="number" step="0.01" value="0" /></label>
                <label>Narration <input class="form-control input-sm" name="narration" maxlength="200" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save petty cash</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "jw_journal_voucher")
    {
        <ErpPhpCreateWell Title="New journal voucher">
            <form method="post" action="@WriteAction(EcomAeRoutes.ErpJewelleryVoucherSaveForm)" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <input type="hidden" name="action" value="jw_journal_voucher_save" />
                <input type="hidden" name="voc_type" value="JVL" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <ErpVoucherHeaderFields NumberPreview="Auto" />
                <label>Description <input class="form-control input-sm" name="party_name" required /></label>
                <label>Amount <input class="form-control input-sm" name="net_amount" type="number" step="0.01" value="0" /></label>
                <label>Narration <input class="form-control input-sm" name="narration" maxlength="200" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save journal voucher</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "jw_tourist_vat")
    {
        <ErpPhpCreateWell Title="New tourist VAT refund">
            <form method="post" action="@WriteAction(EcomAeRoutes.ErpJewelleryTouristVatSaveForm)" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <ErpVoucherHeaderFields DateFieldName="voc_date" DateLabel="Refund date" NumberLabel="Refund no" NumberPreview="Auto" />
                <label>Tourist name <input class="form-control input-sm" name="tourist_name" required maxlength="120" /></label>
                <label>Passport <input class="form-control input-sm" name="passport_no" maxlength="20" /></label>
                <label>Nationality <input class="form-control input-sm" name="nationality" maxlength="50" /></label>
                <label>Invoice no <input class="form-control input-sm" name="invoice_no" maxlength="30" /></label>
                <label>VAT <input class="form-control input-sm" name="total_vat" type="number" step="0.01" value="0" /></label>
                <label>Refund <input class="form-control input-sm" name="refund_amount" type="number" step="0.01" value="0" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save tourist VAT</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && (_tab == "jw_retail_sales" || _tab == "jewellery" || _tab == "retail_commerce" || _tab == "jw_metal_sales" || _tab == "jw_sales_return"))
    {
        @if (_savedId > 0)
        {
            <div class="jw-saved" role="status">
                <i class="fa fa-check-circle" aria-hidden="true"></i>
                <span>Invoice saved and posted to the general ledger and stock.</span>
                <a class="btn btn-sm btn-primary" href="/erp/jewellery/voucher-print?id=@_savedId.ToString(CultureInfo.InvariantCulture)" target="_blank" rel="noopener"><i class="fa fa-print" aria-hidden="true"></i> Invoice print preview</a>
                <a class="btn btn-sm btn-default" href="@ErpRecordOpen.Href(_listHref, "voc_id", _savedId)" target="_blank" rel="noopener">Open posted invoice</a>
                <a class="btn btn-sm btn-default" href="@ReturnHref">New entry</a>
            </div>
        }
        <ErpJwEntryStyles />
        <ErpPhpCreateWell Title="@(_tab == "jw_retail_sales" || _tab == "jewellery" || _tab == "retail_commerce" ? "Retail invoice" : _spec.Label)">
            <form method="post" action="@WriteAction(EcomAeRoutes.ErpJewelleryVoucherSaveForm)" class="epc-jw-bm-form jw-mp" data-epc-jw-purchase="1" data-jw-mode="sale" data-jw-draft="@("jw-" + _tab)" autocomplete="off">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <input type="hidden" name="action" value="@RetailVoucherAction(_tab)" />
                <input type="hidden" name="voc_type" value="@RetailVocType(_tab)" />
                <input type="hidden" name="after_save" value="" data-jw-after-save />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <div class="jw-mp-wrap" style="grid-column:1 / -1;display:block;width:100%;min-width:0">
                <section class="jw-mp-card">
                    <h4>Invoice details</h4>
                    <div class="jw-mp-grid">
                        <ErpMasterPicker Kind="business_unit" FieldName="branch" Label="Business unit" ValueMode="code" SelectedCode="HQ" InputId="jw-rt-bu" />
                        <label>Voc Type <input class="form-control input-sm" value="@RetailVocType(_tab)" readonly /></label>
                        <label>Invoice date <input class="form-control input-sm" name="voc_date" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" required /></label>
                        <label>Invoice no <input class="form-control input-sm" value="Auto" readonly /></label>
                        <ErpMasterPicker Kind="customer" FieldName="customer_name" InputId="jw-retail-invoice-customer" Label="Customer" ValueMode="name" Required="true" CodeFieldName="party_code" />
                        <label>Mobile <input class="form-control input-sm" name="mobile" /></label>
                        <ErpMasterPicker Kind="jw-salesman" FieldName="salesman" Label="Salesman" ValueMode="code" InputId="jw-retail-303" AllowNew="true" />
                        <ErpMasterPicker Kind="jw-currency" FieldName="currency" Label="Currency" ValueMode="code" InputId="jw-retail-304" SelectedCode="AED" />
                        <label>Currency rate <input class="form-control input-sm" name="currency_rate" type="number" step="0.000001" value="1" /></label>
                        <label>Metal rate / g (pure) <input class="form-control input-sm" name="metal_rate" type="number" step="0.00001" min="0" value="0" /></label>
                        @if (_tab == "jw_sales_return")
                        {
                            <label>Source invoice id <input class="form-control input-sm" name="ref_invoice_no" type="number" min="1" required /></label>
                        }
                        <label>Narration <input class="form-control input-sm" name="narration" maxlength="200" /></label>
                    </div>
                    <input type="hidden" name="party_code" value="" />
                </section>

                <section class="jw-mp-card">
                    <div class="jw-mp-tabs epc-jw-panel-nav" role="tablist" aria-label="Invoice panels">
                        <button type="button" class="is-active" data-jw-panel-btn="lines">1. Line Items</button>
                        <button type="button" data-jw-panel-btn="addins">2. Tender / receipt</button>
                    </div>
                    <div class="jw-mp-panel epc-jw-panel jw-mp-lines" data-jw-panel="lines">
                        <table>
                            <thead>
                                <tr>
                                    <th>No.</th><th>Stock Code</th><th>Tag / barcode</th><th>Description</th><th>Div</th><th>PCS</th><th>Gr. Wt</th><th>Stone Wt</th><th>Net Wt</th><th>Purity</th><th>Pure Wt</th>
                                    <th>Wstg %</th><th>Wstg Qty</th><th>Metal Rate</th><th>Metal Amount</th><th>Mkg. Rate</th><th>Mkg. Amount</th><th>St. Amount</th><th>Discount</th><th>Total</th><th></th>
                                </tr>
                            </thead>
                            <tbody data-jw-lines>
                                <tr data-jw-line>
                                    <td data-jw-line-no>1</td>
                                    <td class="jw-stock"><ErpMasterPicker Kind="jw-metal-stock" FieldName="line_stock_code" Label="Stock" ValueMode="code" InputId="jw-retail-306" /></td>
                                    <td class="jw-stock"><ErpMasterPicker Kind="jw-tag" FieldName="line_tag_no" Label="Tag" ValueMode="code" InputId="jw-retail-307" /></td>
                                    <td><input class="form-control input-sm" name="line_description" maxlength="120" style="text-align:left;min-width:10rem" /></td>
                                    <td>
                                        <select class="form-control input-sm" name="line_division" style="min-width:5rem">
                                            <option value="G">Gold</option><option value="D">Diamond</option><option value="S">Silver</option><option value="P">Pearl</option>
                                        </select>
                                        <input type="hidden" name="line_karat" value="" />
                                    </td>
                                    <td><input class="form-control input-sm" name="line_pcs" type="number" min="0" value="1" /></td>
                                    <td><input class="form-control input-sm" name="line_gr_wt" type="number" step="0.0001" min="0" value="0" /></td>
                                    <td><input class="form-control input-sm" name="line_stone_wt" type="number" step="0.0001" min="0" value="0" /></td>
                                    <td><input class="form-control input-sm" data-jw-net-wt type="number" value="0.0000" readonly tabindex="-1" /></td>
                                    <td><input class="form-control input-sm" name="line_purity" type="number" step="0.000001" min="0" max="1" value="0.916" /></td>
                                    <td><input class="form-control input-sm" name="line_pure_wt" type="number" value="0.0000" readonly tabindex="-1" /></td>
                                    <td><input class="form-control input-sm" name="line_wastage_pct" type="number" step="0.0001" min="0" value="0" /></td>
                                    <td><input class="form-control input-sm" name="line_wastage_qty" type="number" value="0.0000" readonly tabindex="-1" /></td>
                                    <td><input class="form-control input-sm" name="line_metal_rate" type="number" value="0" readonly tabindex="-1" /></td>
                                    <td><input class="form-control input-sm" name="line_metal_amount" type="number" value="0.00" readonly tabindex="-1" /></td>
                                    <td><input class="form-control input-sm" name="line_mkg_rate" type="number" step="0.0001" min="0" value="0" /></td>
                                    <td><input class="form-control input-sm" name="line_mkg_amount" type="number" value="0.00" readonly tabindex="-1" /></td>
                                    <td><input class="form-control input-sm" name="line_stone_amount" type="number" step="0.01" min="0" value="0" /></td>
                                    <td><input class="form-control input-sm" name="line_disc_amount" type="number" step="0.01" min="0" value="0" /></td>
                                    <td><input class="form-control input-sm" data-jw-item-total type="number" value="0.00" readonly tabindex="-1" /></td>
                                    <td><button type="button" class="btn btn-xs btn-default" data-jw-line-remove title="Remove line"><i class="fa fa-trash" aria-hidden="true"></i></button></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5"><button type="button" class="btn btn-xs btn-primary" data-jw-line-add><i class="fa fa-plus" aria-hidden="true"></i> Add line</button></td>
                                    <td data-jw-sum="pcs">0</td><td data-jw-sum="gr">0.0000</td><td data-jw-sum="stone">0.0000</td><td data-jw-sum="net">0.0000</td><td></td><td data-jw-sum="pure">0.0000</td>
                                    <td></td><td data-jw-sum="wstg">0.0000</td><td></td><td data-jw-sum="metal">0.00</td><td></td><td data-jw-sum="mkg">0.00</td><td data-jw-sum="st">0.00</td><td data-jw-sum="disc">0.00</td><td data-jw-sum="total">0.00</td><td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="jw-mp-panel epc-jw-panel jw-mp-lines" data-jw-panel="addins" hidden>
                        <table style="min-width:50rem">
                            <thead><tr><th>Mode</th><th>Currency</th><th>Rate</th><th>Amount FC</th><th>Amount LC</th></tr></thead>
                            <tbody>
                                <tr>
                                    <td><select class="form-control input-sm" name="receipt_mode"><option>CASH</option><option>CARD</option><option>BANK</option><option>CHEQUE</option><option>ADVANCE</option></select></td>
                                    <td class="jw-stock"><ErpMasterPicker Kind="jw-currency" FieldName="receipt_currency" Label="Currency" ValueMode="code" SelectedCode="AED" InputId="jw-rt-rcur" /></td>
                                    <td><input class="form-control input-sm" name="receipt_currency_rate" type="number" step="0.000001" value="1" /></td>
                                    <td><input class="form-control input-sm" name="receipt_amount_fc" type="number" step="0.01" min="0" value="0" /></td>
                                    <td><input class="form-control input-sm" name="receipt_amount_lc" type="number" step="0.01" min="0" value="0" /></td>
                                </tr>
                            </tbody>
                        </table>
                        <input type="hidden" name="addin_amount" value="0" />
                    </div>
                </section>

                <div class="jw-mp-bottom">
                    <section class="jw-mp-card">
                        <h4>Adjustments</h4>
                        <div class="jw-mp-grid">
                            <label>Sale return adjustment <input class="form-control input-sm" name="adjust_sale_return" type="number" step="0.01" min="0" value="0" /></label>
                            <label>Old-gold purchase <input class="form-control input-sm" name="old_gold_exchange" type="number" step="0.01" min="0" value="0" title="Kept apart from the sale. Cash due is the sale minus this purchase." /></label>
                            <label>Scheme redemption <input class="form-control input-sm" name="gold_scheme_redeem" type="number" step="0.01" min="0" value="0" /></label>
                            <label>Refund due <input class="form-control input-sm" name="refund_due" type="number" step="0.01" min="0" value="0" /></label>
                            <label>VAT basis
                                <select class="form-control input-sm" name="vat_basis" data-jw-vat-basis>
                                    <option value="full" selected>Full invoice value</option>
                                    <option value="mkg">Making + stone only</option>
                                    <option value="none">Zero-rated / no VAT</option>
                                </select>
                            </label>
                        </div>
                    </section>
                    <section class="jw-mp-card">
                        <h4>Invoice summary</h4>
                        <div class="jw-mp-sum">
                            <table>
                                <tr><td>Metal value</td><td><input class="form-control input-sm" data-jw-tot="metal" value="0.00" readonly tabindex="-1" /></td></tr>
                                <tr><td>Making charges</td><td><input class="form-control input-sm" data-jw-tot="mkg" value="0.00" readonly tabindex="-1" /></td></tr>
                                <tr><td>Stone amount</td><td><input class="form-control input-sm" data-jw-tot="st" value="0.00" readonly tabindex="-1" /></td></tr>
                                <tr><td>Discount</td><td><input class="form-control input-sm" data-jw-tot="disc" value="0.00" readonly tabindex="-1" /></td></tr>
                                <tr><td>Net amount</td><td><input class="form-control input-sm" name="net_amount" value="0.00" readonly tabindex="-1" /></td></tr>
                                <tr><td>Taxable value <em class="jw-mp-note" data-jw-basis-note>(incl. metal)</em></td><td><input class="form-control input-sm" data-jw-tot="taxable" value="0.00" readonly tabindex="-1" /></td></tr>
                                <tr><td>VAT %</td><td><input class="form-control input-sm" name="vat_pct" type="number" step="0.01" min="0" value="5" /></td></tr>
                                <tr><td>Output VAT</td><td><input class="form-control input-sm" name="vat_amount" value="0.00" readonly tabindex="-1" /></td></tr>
                                <tr><td>Round off</td><td><input class="form-control input-sm" name="round_off" type="number" step="0.01" value="0" /></td></tr>
                                <tr class="jw-mp-grand"><td>Invoice total</td><td><input class="form-control input-sm" name="gross_total" value="0.00" readonly tabindex="-1" /></td></tr>
                                <tr><td>Cash due <em class="jw-mp-note">(total − old gold − scheme − return adj.)</em></td><td><input class="form-control input-sm" data-jw-tot="due" value="0.00" readonly tabindex="-1" /></td></tr>
                            </table>
                            <input type="hidden" name="other_amount" value="0" />
                            <input type="hidden" name="rcm_vat" value="0" />
                        </div>
                    </section>
                </div>

                <div class="jw-mp-actions">
                    <button type="submit" class="btn btn-primary btn-sm" data-jw-submit><i class="fa fa-save" aria-hidden="true"></i> Save invoice</button>
                    <button type="submit" class="btn btn-success btn-sm" data-jw-submit data-jw-submit-print><i class="fa fa-print" aria-hidden="true"></i> Save &amp; print preview</button>
                    <button type="button" class="btn btn-default btn-sm" data-jw-clear><i class="fa fa-eraser" aria-hidden="true"></i> Clear</button>
                    <span class="jw-mp-status" data-jw-status>Draft is kept automatically until you save.</span>
                </div>
                </div>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "retail_barcode")
    {
        <ErpPhpCreateWell Title="Generate barcode">
            <form method="post" action="@WriteAction(EcomAeRoutes.ErpJewelleryBarcodeGenerateForm)" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <label>Stock code <input class="form-control input-sm" name="stock_code" required placeholder="MST-001" maxlength="20" /></label>
                <label>Division <input class="form-control input-sm" name="division" value="G" maxlength="2" style="width:4rem" /></label>
                <ErpMasterPicker Kind="jw-karat" FieldName="karat" Label="Karat" ValueMode="code" InputId="jw-retail-379" SelectedCode="22" />
                <label>Gross wt <input class="form-control input-sm" name="gross_wt" type="number" step="0.0001" value="0" /></label>
                <label>Purity <input class="form-control input-sm" name="purity" type="number" step="0.000001" value="0.916" /></label>
                <label>Tag price <input class="form-control input-sm" name="tag_price" type="number" step="0.01" value="0" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Generate barcode</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin)
    {
        <ErpPhpCreateWell Title="@("New " + _spec.Label)">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryModuleSaveForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <input type="hidden" name="action" value="@(_tab + "_save")" />
                <label>Code <input class="form-control input-sm" name="code" required /></label>
                <ErpMasterPicker Kind="customer" FieldName="customer_name" InputId="jw-retail-module-customer" Label="Customer" ValueMode="name" />
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
            </form>
        </ErpPhpCreateWell>
        <form method="post" action="/erp/retail/discounts/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@ReturnHref" />
            <strong style="width:100%;font-size:.85rem">Save discount</strong>
            <label>Code <input name="code" maxlength="40" style="width:8rem" /></label>
            <label>Name <input name="name" maxlength="160" style="width:12rem" /></label>
            <label>Type
                <select name="disc_type">
                    <option value="percent" selected>percent</option>
                    <option value="amount">amount</option>
                </select>
            </label>
            <label>Value <input type="number" name="value" step="0.0001" value="0" style="width:7rem" /></label>
            <label>Channel id <input type="number" name="channel_id" min="0" value="0" style="width:6rem" /></label>
            <label>Active
                <select name="active">
                    <option value="1" selected>active</option>
                    <option value="0">inactive</option>
                </select>
            </label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </form>
        <form method="post" action="/erp/retail/assortments/set" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@ReturnHref" />
            <strong style="width:100%;font-size:.85rem">Set assortment</strong>
            <label>Channel id <input type="number" name="channel_id" min="0" required style="width:6rem" /></label>
            <ErpMasterPicker Kind="item" FieldName="item_id" InputId="retail-assortment-item" Label="Item" Required="true" Min="1" />
            <label>Active
                <select name="active">
                    <option value="1" selected>active</option>
                    <option value="0">inactive</option>
                </select>
            </label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </form>
        <form method="post" action="/erp/retail/channels/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@ReturnHref" />
            <input type="hidden" name="id" value="0" />
            <label>Code <input type="text" name="code" required maxlength="40" style="width:8rem" /></label>
            <label>Name <input type="text" name="name" maxlength="160" style="width:12rem" /></label>
            <label>Type
                <select name="channel_type">
                    <option value="store" selected>store</option>
                    <option value="online">online</option>
                    <option value="callcenter">callcenter</option>
                </select>
            </label>
            <ErpMasterPicker Kind="jw-currency" FieldName="currency" Label="Currency" ValueMode="code" InputId="jw-retail-449" />
            <label>Active
                <select name="active">
                    <option value="1" selected>active</option>
                    <option value="0">inactive</option>
                </select>
            </label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save channel</button>
        </form>
    }

    @if (_tab == "jw_sales_analysis")
    {
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead><tr><th>Period</th><th class="text-right">Invoices</th><th class="text-right">Pcs</th><th class="text-right">Net wt</th><th class="text-right">Metal</th><th class="text-right">Making</th><th class="text-right">Total</th></tr></thead>
                <tbody>
                    @if (_analysis.Count == 0)
                    {
                        <tr><td colspan="7" class="text-muted">@(_isAdmin ? _spec.EmptyCopy : "Sign in with ERP or Control Panel capability for live rows.")</td></tr>
                    }
                    else
                    {
                        @foreach (var row in _analysis)
                        {
                            <tr>
                                <td><strong>@(string.IsNullOrWhiteSpace(row.GroupKey) ? "—" : row.GroupKey)</strong></td>
                                <td class="text-right">@row.VocCount.ToString(CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@row.TotalPcs.ToString("N0", CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@row.TotalWt.ToString("N4", CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@row.MetalTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@row.MakingTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@row.GrandTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                        <tr style="font-weight:600;background:#f2f6fa">
                            <td>Total</td>
                            <td class="text-right">@_analysis.Sum(r => r.VocCount).ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@_analysis.Sum(r => r.TotalPcs).ToString("N0", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@_analysis.Sum(r => r.TotalWt).ToString("N4", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@_analysis.Sum(r => r.MetalTotal).ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@_analysis.Sum(r => r.MakingTotal).ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@_analysis.Sum(r => r.GrandTotal).ToString("N2", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
    <div class="epc-erp-table-wrap">
        <table class="table table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    @foreach (var col in _spec.Columns)
                    {
                        <th>@col</th>
                    }
                    @if (_showVouchers)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (_display.Count == 0)
                {
                    <tr><td colspan="@(_spec.Columns.Count + (_showVouchers ? 1 : 0))" class="text-muted">@(_isAdmin ? _spec.EmptyCopy : "Sign in with ERP or Control Panel capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _display)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.No</td>
                            <td><strong>@row.InvNo</strong></td>
                            <td>@row.InvDate</td>
                            <td>@row.Customer</td>
                            <td>—</td>
                            <td>1</td>
                            <td class="text-right">@row.Net</td>
                            <td>@row.Status</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "voc_id", row.Id)" target="_blank" rel="noopener">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    }

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Retail vouchers bind from <code>epc_jewel_voucher</code>. Voucher save is live when confirmed. Other retail forms stay dry-run.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
    }
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private int _company;
    private string _tab = "jw_retail_sales";
    private string _appPath = "/erp/jewellery-retail-app";
    private string _tabBase = "/erp/jewellery-retail-app";
    private string _returnHere = "/erp/jewellery-retail-app?tab=jw_retail_sales";
    private ErpJewelleryModuleChrome.TabSpec _spec = ErpJewelleryModuleChrome.RetailSpec("jw_retail_sales");
    private CpJewelleryRetailSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<SaleRow> _display = [];
    private IReadOnlyList<CpJewellerySalesAnalysisRow> _analysis = [];
    private string _source = "n/a";
    private string _message = "";
    private string _ok = "";
    private string _err = "";
    private string WorkbookHref(string kind)
    {
        var href = "/erp/jewellery/workbook?kind=" + kind;
        if (_company > 0)
        {
            href += "&company=" + _company.ToString(CultureInfo.InvariantCulture);
        }

        return href;
    }

    private string _listHref = "/erp/jewellery-retail-app";
    private long _openedId;
    private CpJewelleryVoucherDetail? _opened;
    private IReadOnlyList<CpJewelleryVoucherDigest> _openedSiblings = [];
    private IReadOnlyList<CpJewelleryTagLookupRow> _lookupRows = [];
    private string _lookupQuery = "";
    private string _lookupMessage = "";
    private bool _showVouchers;
    private long _savedId;

    private sealed record SaleRow(long Id, string No, string InvNo, string InvDate, string Customer, string Net, string Status);

    private string OpenedCaption =>
        _opened is not null && _opened.VocNo > 0
            ? ("Voc " + _opened.VocNo.ToString(CultureInfo.InvariantCulture))
            : (_openedId > 0 ? ("Voucher #" + _openedId.ToString(CultureInfo.InvariantCulture)) : "");

    private string WriteAction(string path) => ErpJewelleryModuleChrome.AppHref(path, _company);

    private string ReturnHref =>
        _openedId > 0
            ? _listHref + "?voc_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
            : _returnHere;

    private static string RetailVocType(string tab) => tab switch
    {
        "jw_metal_sales" => "MSL",
        "jw_sales_return" => "SRT",
        "jw_pos_advance" => "ADV",
        "jw_journal_voucher" => "JVL",
        _ => "RIN"
    };

    private static string RetailVoucherAction(string tab) => tab switch
    {
        "jw_metal_sales" => "jw_metal_sale_save",
        "jw_sales_return" => "jw_sales_return_save",
        _ => "jw_retail_sale_save"
    };

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var path = ctx.Request.Path.Value ?? "/erp/jewellery-retail-app";
        _appPath = path.StartsWith("/erp/", StringComparison.OrdinalIgnoreCase)
            ? "/erp/jewellery-retail-app"
            : "/erp/jewellery-retail-app";
        _listHref = _appPath;
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "voc_id");
        _savedId = ErpRecordOpen.ReadId(ctx.Request, "saved_id");
        _company = ErpJewelleryModuleChrome.CompanyFromQuery(ctx.Request.Query["company"].ToString());
        _tab = ErpJewelleryModuleChrome.NormalizeTab(ctx.Request.Query["tab"].ToString(), ErpJewelleryModuleChrome.RetailTabs, "jw_retail_sales");
        _ok = ctx.Request.Query["ok"].ToString();
        _err = ctx.Request.Query["err"].ToString();
        _lookupQuery = ctx.Request.Query["lookup"].ToString().Trim();
        _spec = ErpJewelleryModuleChrome.RetailSpec(_tab);
        _tabBase = ErpJewelleryModuleChrome.AppHref(_appPath, _company);
        _returnHere = ErpJewelleryModuleChrome.AppHref(_appPath, _company, ("tab", _tab));

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = ErpJewelleryModuleChrome.HasJewelleryStaffAccess(session);
        if (!_isAdmin)
        {
            _message = "Sign in with ERP or Control Panel capability for live rows.";
            return;
        }

        var result = await Dashboards.BuildCpJewelleryRetailDigestAsync(200, _company, ctx.RequestAborted);
        _summary = result.Summary;
        _source = result.Source;
        _message = result.Message;
        if (_lookupQuery.Length > 0)
        {
            var lookup = await Dashboards.LookupCpJewelleryTagsAsync(_lookupQuery, 50, _company, ctx.RequestAborted);
            _lookupRows = lookup.Rows;
            _lookupMessage = lookup.Rows.Count == 0
                ? "No tag, barcode, or stock-code match found."
                : lookup.Rows.Count.ToString(CultureInfo.InvariantCulture) + " item match(es) found.";
            if (!string.IsNullOrWhiteSpace(lookup.Message))
            {
                _lookupMessage = lookup.Message;
            }
        }
        _analysis = _tab == "jw_sales_analysis" ? result.SalesAnalysis : [];
        var wantedTypes = ErpJwVocTypes.AliasesForTab(_tab);
        _showVouchers = wantedTypes.Count > 0;
        _display = _showVouchers
            ? result.Vouchers
                .Where(v => ErpJwVocTypes.Matches(v.VocType, wantedTypes))
                .Select((v, i) => new SaleRow(
            v.Id,
            (i + 1).ToString(CultureInfo.InvariantCulture),
            v.VocNo.ToString(CultureInfo.InvariantCulture),
            string.IsNullOrWhiteSpace(v.VocDate) ? "—" : v.VocDate,
            string.IsNullOrWhiteSpace(v.PartyName) ? "—" : v.PartyName,
            v.NetAmount.ToString("N2", CultureInfo.InvariantCulture),
            string.IsNullOrWhiteSpace(v.Status) ? "—" : v.Status)).ToList()
            : [];
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpJewelleryVoucherDetailAsync(_openedId, _company, ctx.RequestAborted);
            _opened = detail.Voucher;
            _openedSiblings = detail.Siblings;
        }
    }
}
