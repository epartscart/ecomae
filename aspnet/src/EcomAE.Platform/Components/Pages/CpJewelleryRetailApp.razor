@page "/cp/jewellery-retail-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Jewellery Retail · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-jw-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-jw-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-jw-hero p { margin:0; color:#ffedd5; max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-jw-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-jw-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#7c2d12; background:#e0f2fe;
        }
        .epc-jw-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-jw-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-jw-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-jw-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-jw-kpi span { color:#64748b; font-size:.78rem; }
        .epc-jw-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-jw-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-jw-table th, .epc-jw-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-jw-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-jw-note { margin-top:1rem; padding:.75rem .9rem; background:#fffbeb; border:1px solid #fde68a; border-radius:.45rem; color:#78350f; font-size:.86rem; }
        @@media (max-width:900px){ .epc-jw-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-jw-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Jewellery Retail</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-jw-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/cp/pos-overview-app">POS overview</a>
        </div>
    </section>

    <div class="epc-jw-kpis" aria-label="Jewellery stats">
        <div class="epc-jw-kpi"><strong>@_summary.VoucherCount.ToString(CultureInfo.InvariantCulture)</strong><span>Vouchers</span></div>
        <div class="epc-jw-kpi"><strong>@_summary.OpenVouchers.ToString(CultureInfo.InvariantCulture)</strong><span>Open vouchers</span></div>
        <div class="epc-jw-kpi"><strong>@_summary.TagCount.ToString(CultureInfo.InvariantCulture)</strong><span>Tags</span></div>
        <div class="epc-jw-kpi"><strong>@_summary.MetalStockRows.ToString(CultureInfo.InvariantCulture)</strong><span>Metal stock rows</span></div>
    </div>

    <div class="epc-jw-table-wrap">
        <table class="epc-jw-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Voc no</th>
                    <th>Party</th>
                    <th>Status</th>
                    <th>Net</th>
                    <th>VAT</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_vouchers.Count == 0)
                {
                    <tr><td colspan="10">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var v in _vouchers)
                    {
                        <tr>
                            <td><strong>@v.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(v.VocType) ? "—" : v.VocType)</td>
                            <td>@(string.IsNullOrWhiteSpace(v.VocDate) ? "—" : v.VocDate)</td>
                            <td>@v.VocNo.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(v.PartyName) ? "—" : v.PartyName)</td>
                            <td>@(string.IsNullOrWhiteSpace(v.Status) ? "—" : v.Status)</td>
                            <td>@v.NetAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@v.VatAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@v.TotalWithVat.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=retail&tab=retail_commerce&epc_erp_shell=1";
    private bool _isAdmin;
    private CpJewelleryRetailSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpJewelleryVoucherDigest> _vouchers = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpJewelleryRetailDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _vouchers = result.Vouchers;
        _source = result.Source;
        _message = result.Message;
    }
}
