@page "/cp/marketplace-channels-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Marketplace channels · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-w16-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-w16-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-w16-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-w16-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-w16-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0c4a6e; background:#e0f2fe;
        }
        .epc-w16-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-w16-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-w16-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-w16-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-w16-kpi span { color:#64748b; font-size:.78rem; }
        .epc-w16-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-w16-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-w16-table th, .epc-w16-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-w16-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        @@media (max-width:900px){ .epc-w16-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-w16-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Marketplace channels</h1>
        <p>Amazon, eBay, noon, and regional sell channels — sync listings, map SKUs, and import marketplace orders.</p>
        <div class="epc-w16-cta">
            <a href="@_configureHref">Manage channels</a>
            <a class="ghost" href="@_carriersHref">Couriers</a>
        </div>
    </section>

    <div class="epc-w16-kpis" aria-label="Marketplace channels stats">
        <div class="epc-w16-kpi"><strong>@_summary.ChannelCount.ToString(CultureInfo.InvariantCulture)</strong><span>Channels</span></div>
        <div class="epc-w16-kpi"><strong>@_summary.ActiveCount.ToString(CultureInfo.InvariantCulture)</strong><span>Active</span></div>
        <div class="epc-w16-kpi"><strong>@_summary.SkuMapCount.ToString(CultureInfo.InvariantCulture)</strong><span>SKU maps</span></div>
        <div class="epc-w16-kpi"><strong>@_summary.OrderCount.ToString(CultureInfo.InvariantCulture)</strong><span>Orders</span></div>
    </div>

    <div class="epc-w16-table-wrap">
    <table class="epc-w16-table">
        <thead>
            <tr>
                    <th>Channel</th>
                    <th>Family</th>
                    <th>Region</th>
                    <th>API</th>
                    <th>Active</th>
                    <th>Demo</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="7">No marketplace channels seeded yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : row.Code)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Family) ? row.Family : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Region) ? row.Region : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Api) ? row.Api : "—")</td>
                            <td>@(row.Active != 0 ? "yes" : "no")</td>
                            <td>@(row.DemoMode != 0 ? "yes" : "no")</td>
                            <td><a href="@_configureHref">Configure</a></td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _configureHref = "/CP/shop/channels/channels_main";
    private const string _carriersHref = "/CP/shop/logistics/carriers";
    private bool _isAdmin;
    private CpMarketplaceChannelsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpMarketplaceChannelsChannelDigest> _rows = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpMarketplaceChannelsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Channels;
    }
}
