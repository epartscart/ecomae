@page "/cp/marketplace-channels-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Marketplace channels · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Marketplace channels
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/marketplace-channels-app")</p>
                <p>Toggle a marketplace channel here.</p>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/channels/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/marketplace-channels-app" />
            <input type="hidden" name="action" value="toggle_channel" />
            <label>Channel code <input type="text" name="code" required maxlength="64" /></label>
            <label>Enabled
                <select name="enabled">
                    <option value="1">1 · on</option>
                    <option value="0">0 · off</option>
                </select>
            </label>
            <button type="submit">Toggle channel</button>
        </form>
    }

    <p class="help-block">@_summary.ChannelCount.ToString(CultureInfo.InvariantCulture) Channels · @_summary.ActiveCount.ToString(CultureInfo.InvariantCulture) Active · @_summary.SkuMapCount.ToString(CultureInfo.InvariantCulture) SKU maps · @_summary.OrderCount.ToString(CultureInfo.InvariantCulture) Orders.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>ID</th>
                    <th>Channel</th>
                    <th>Marketplace id</th>
                    <th>Family</th>
                    <th>Region</th>
                    <th>API</th>
                    <th>Blurb</th>
                    <th>Active</th>
                    <th>Demo</th>
                    <th>Last sync</th>
                    <th>Created</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="12">No marketplace channels seeded yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : row.Code)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.MarketplaceId) ? row.MarketplaceId : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Family) ? row.Family : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Region) ? row.Region : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Api) ? row.Api : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Blurb) ? row.Blurb : "—")</td>
                            <td>@(row.Active != 0 ? "yes" : "no")</td>
                            <td>@(row.DemoMode != 0 ? "yes" : "no")</td>
                            <td>@row.LastSyncAt.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.TimeCreated.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@_configureHref">Configure</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/channels";
    private const string _configureHref = "/cp/marketplace-channels-app";
    private const string _carriersHref = "/cp/carriers-app";
    private bool _isAdmin;
    private CpMarketplaceChannelsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpMarketplaceChannelsChannelDigest> _rows = [];
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpMarketplaceChannelsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Channels;
    }
}
