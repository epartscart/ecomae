@page "/marketing/contact"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>ECOM AE — Contact</PageTitle>
<PhpChromeStyles Surface="marketing" />

<PhpEcomaeMarketingChrome ActiveKey="contact">
    <PhpHybridWorkspaceFrame PhpHref="@_phpHref" ClearHref="/marketing/contact" />

    @if (string.IsNullOrWhiteSpace(_phpHref))
    {
        <PhpEcomaeContactOverview />
    }
</PhpEcomaeMarketingChrome>

@code {
    private string? _phpHref;

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        if (ctx?.Request.Query.TryGetValue("php", out var php) == true && !string.IsNullOrWhiteSpace(php))
        {
            _phpHref = php.ToString();
        }
    }
}
