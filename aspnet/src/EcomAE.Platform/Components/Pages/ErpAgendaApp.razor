@page "/erp/agenda-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Components.Shared.Desktop
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Agenda · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Agenda" BreadcrumbArea="Workspace" BreadcrumbTab="Agenda">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/agenda-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Agenda" Subtitle="Open a row for the 280-character notes excerpt. Add event writes here." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Agenda KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_events.Count</div></div>
        <div class="kpi"><div class="lbl">Digest source</div><div class="val">@_source</div></div>
        <div class="kpi"><div class="lbl">Session</div><div class="val">@(_isAdmin ? "live" : "guest")</div></div>
    </div>

    @if (_opened is not null)
    {
        <ErpDocumentWorkspace
            DocumentKind="Agenda event"
            Title="@OpenedCaption"
            DocumentNumber="@_opened.Id.ToString(CultureInfo.InvariantCulture)"
            PartyLabel="Assignee"
            Party="@(_opened.AssignedUserId > 0 ? _opened.AssignedUserId.ToString(CultureInfo.InvariantCulture) : "Unassigned")"
            ReferenceLabel="Linked record"
            Reference="@(_opened.EntityId > 0 ? $"{_opened.EntityType} #{_opened.EntityId.ToString(CultureInfo.InvariantCulture)}" : "—")"
            Status="@(_opened.EventType.Length == 0 ? "Scheduled" : _opened.EventType)"
            ApprovalState="@(_opened.AllDay ? "All day" : "Scheduled time")"
            CompanyContext="Tenant / company"
            Currency="—"
            Fields="@AgendaWorkspaceFields"
            Lines="@AgendaWorkspaceLines"
            Tabs="@AgendaWorkspaceTabs" />
        <p class="text-muted" style="margin:.85rem 0 0">Add event writes here.</p>
        @if (_openedSiblings.Count > 0)
        {
            <div class="epc-erp-table-wrap" style="margin:12px 0">
                <strong>Same-type siblings</strong>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Title) ? "—" : sib.Title)</td>
                                <td>@FormatTime(sib.StartAt)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "event_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Location</th>
                    <th>Linked</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_events.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _events)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Title) ? $"#{row.Id}" : row.Title)</strong></td>
                            <td><span class="label label-default">@row.EventType</span></td>
                            <td>@FormatTime(row.StartAt)</td>
                            <td>@FormatTime(row.EndAt)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Location) ? "—" : row.Location)</td>
                            <td><span class="label label-default">@row.EntityType</span></td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "event_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">@_message</div>
    }

</PhpErpDesktopChrome>

<form method="post" action="/erp/agenda/events/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(_openedId > 0 ? _listHref + "?event_id=" + _openedId.ToString(CultureInfo.InvariantCulture) : _listHref)" />
            <label>Title <input type="text" name="title" required maxlength="255" style="width:14rem" /></label>
            <label>Start <input type="text" name="start_at" placeholder="YYYY-MM-DD HH:MM" style="width:11rem" /></label>
            <label>End <input type="text" name="end_at" placeholder="YYYY-MM-DD HH:MM" style="width:11rem" /></label>
            <label>Type
                <select name="event_type">
                    <option value="meeting">Meeting</option>
                    <option value="call">Call</option>
                    <option value="task">Task</option>
                </select>
            </label>
            <label>Location <input type="text" name="location" maxlength="255" style="width:10rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Add event</button>
        </form>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=common&tab=agenda";
    private const string _listHref = "/erp/agenda-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpAgendaEventDigest> _events = [];
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpAgendaEventDetail? _opened;
    private IReadOnlyList<ErpAgendaEventDigest> _openedSiblings = [];
    private IReadOnlyList<string> AgendaWorkspaceTabs => ["General", "Schedule", "Link", "Notes"];

    private IReadOnlyList<ErpDocumentWorkspaceField> AgendaWorkspaceFields => _opened is null
        ? []
        : [
            new("Event type", string.IsNullOrWhiteSpace(_opened.EventType) ? "—" : _opened.EventType, "General"),
            new("Start", FormatTime(_opened.StartAt), "Schedule"),
            new("End", FormatTime(_opened.EndAt), "Schedule"),
            new("All day", _opened.AllDay ? "Yes" : "No", "Schedule"),
            new("Location", string.IsNullOrWhiteSpace(_opened.Location) ? "—" : _opened.Location, "General"),
            new("Entity type", string.IsNullOrWhiteSpace(_opened.EntityType) ? "—" : _opened.EntityType, "Link"),
            new("Entity id", _opened.EntityId > 0 ? _opened.EntityId.ToString(CultureInfo.InvariantCulture) : "—", "Link"),
            new("Notes", string.IsNullOrWhiteSpace(_opened.NotesExcerpt) ? "—" : _opened.NotesExcerpt, "Notes"),
            new("Notes length", _opened.NotesLen.ToString(CultureInfo.InvariantCulture), "Notes"),
            new("Created", FormatTime(_opened.TimeCreated), "Audit")
        ];

    private IReadOnlyList<ErpDocumentWorkspaceLine> AgendaWorkspaceLines => _opened is null
        ? []
        : [
            new("1", string.IsNullOrWhiteSpace(_opened.EventType) ? "Agenda event" : _opened.EventType, 1, "event",
                _opened.Location, "—", 0, 0, 0, 0, 0, _opened.EntityId > 0 ? $"{_opened.EntityType} #{_opened.EntityId.ToString(CultureInfo.InvariantCulture)}" : "Internal agenda")
        ];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.Title)
            ? _opened.Title
            : ("Event #" + _opened.Id.ToString(CultureInfo.InvariantCulture)));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?event_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "event_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpAgendaEventsAsync(_limit, ctx.RequestAborted);
        _events = result.Events;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpAgendaEventDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Event;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _events.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _events = new[] { openedList }.Concat(_events.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
