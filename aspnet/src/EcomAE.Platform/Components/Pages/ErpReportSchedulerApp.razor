@page "/erp/report-scheduler-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Report scheduler · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Report scheduler" BreadcrumbArea="Reports" BreadcrumbTab="Report scheduler">
    <PhpErpModulePageHeader Title="Report scheduler" Subtitle="Automated report cadence. Recipients and body stay on ERP ajax." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Report scheduler KPIs">
        <div class="kpi"><div class="lbl">Schedules</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Name</th><th>Type</th><th>Frequency</th><th>Time</th><th>Format</th><th>Last status</th><th>Status</th></tr></thead>
            <tbody>
                @if (_schedules.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No report schedules yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _schedules)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.ReportName) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.ReportName)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.ReportType) ? "—" : row.ReportType)</td>
                            <td>@row.Frequency</td>
                            <td>@row.TimeOfDay</td>
                            <td>@row.Format</td>
                            <td>@(string.IsNullOrWhiteSpace(row.LastStatus) ? "—" : row.LastStatus)</td>
                            <td><span class="label label-default">@(row.IsActive ? "active" : "inactive")</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Recipients and body omitted.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=reports&tab=report_scheduler";
    private bool _isAdmin;
    private IReadOnlyList<ErpReportScheduleDigest> _schedules = [];
    private int _count, _active;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpReportSchedulerDigestAsync(200, ctx.RequestAborted);
        _schedules = result.Schedules;
        _count = result.Count;
        _active = result.ActiveCount;
        _source = result.Source;
        _message = result.Message;
    }
}
