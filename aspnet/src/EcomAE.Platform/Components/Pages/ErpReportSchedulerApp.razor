@page "/erp/report-scheduler-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Report scheduler · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Report scheduler" BreadcrumbArea="Reports" BreadcrumbTab="Report scheduler">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/report-scheduler-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Report scheduler" Subtitle="Open a row for company id and last-sent time. Recipients and body stay off the Open pane. Create stays on this page. Send and email stay Classic." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    <ErpPhpFlash Ok="@_ok" Err="@_err" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Report scheduler KPIs">
        <div class="kpi"><div class="lbl">Schedules</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <ErpPhpCreateWell Title="New report schedule">
            <form method="post" action="@EcomAeRoutes.ErpReportSchedulerCreateForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/erp/report-scheduler-app" />
                <label>Name <input class="form-control input-sm" name="report_name" required placeholder="Weekly aging" /></label>
                <label>Type
                    <select class="form-control input-sm" name="report_type">
                        <option value="sales">Sales</option>
                        <option value="aging">Aging</option>
                        <option value="inventory">Inventory</option>
                        <option value="vat">VAT</option>
                        <option value="pl">P&amp;L</option>
                        <option value="balance_sheet">Balance sheet</option>
                        <option value="custom">Custom</option>
                    </select>
                </label>
                <label>Frequency
                    <select class="form-control input-sm" name="frequency">
                        <option value="daily">Daily</option>
                        <option value="weekly" selected>Weekly</option>
                        <option value="monthly">Monthly</option>
                        <option value="quarterly">Quarterly</option>
                    </select>
                </label>
                <label>Time <input class="form-control input-sm" name="time_of_day" value="08:00" /></label>
                <label>Format
                    <select class="form-control input-sm" name="format">
                        <option value="pdf">PDF</option>
                        <option value="excel">Excel</option>
                        <option value="csv">CSV</option>
                        <option value="html">HTML</option>
                    </select>
                </label>
                <label>Recipients <input class="form-control input-sm" name="recipients" placeholder="ops@local.test" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Create schedule</button>
            </form>
        </ErpPhpCreateWell>
    }

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Id</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_opened.ReportName) ? "—" : _opened.ReportName)</dd>
                <dt>Type</dt><dd>@(string.IsNullOrWhiteSpace(_opened.ReportType) ? "—" : _opened.ReportType)</dd>
                <dt>Frequency</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Frequency) ? "—" : _opened.Frequency)</dd>
                <dt>Week day</dt><dd>@_opened.DayOfWeek.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Month day</dt><dd>@_opened.DayOfMonth.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Time</dt><dd>@(string.IsNullOrWhiteSpace(_opened.TimeOfDay) ? "—" : _opened.TimeOfDay)</dd>
                <dt>Format</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Format) ? "—" : _opened.Format)</dd>
                <dt>Last status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.LastStatus) ? "—" : _opened.LastStatus)</dd>
                <dt>Last sent</dt><dd>@(string.IsNullOrWhiteSpace(_opened.LastSentAt) ? "—" : _opened.LastSentAt)</dd>
                <dt>Company</dt><dd>@(_opened.CompanyId > 0 ? _opened.CompanyId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Status</dt><dd>@(_opened.IsActive ? "active" : "inactive")</dd>
                <dt>Created</dt><dd>@FormatTime(_opened.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Recipients and body stay off this pane. Create stays on this page. Send and email stay Classic.</p>
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-type siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Frequency</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.ReportName) ? "—" : sib.ReportName)</td>
                                <td>@sib.Frequency</td>
                                <td>@(sib.IsActive ? "active" : "inactive")</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "rsched_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-type siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Id</th><th>Name</th><th>Type</th><th>Frequency</th><th>Time</th><th>Format</th><th>Last status</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @if (_schedules.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No report schedules yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _schedules)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.ReportName) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.ReportName)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.ReportType) ? "—" : row.ReportType)</td>
                            <td>@row.Frequency</td>
                            <td>@row.TimeOfDay</td>
                            <td>@row.Format</td>
                            <td>@(string.IsNullOrWhiteSpace(row.LastStatus) ? "—" : row.LastStatus)</td>
                            <td><span class="label label-default">@(row.IsActive ? "active" : "inactive")</span></td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "rsched_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Recipients and body omitted from the digest and the Open pane.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
        Report schedule create is live when confirmed. Send and email stay Classic.
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=reports&tab=report_scheduler";
    private const string _listHref = "/erp/report-scheduler-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpReportScheduleDigest> _schedules = [];
    private int _count, _active;
    private string _source = "n/a";
    private string _message = "";
    private string _ok = "";
    private string _err = "";
    private long _openedId;
    private ErpReportScheduleDetail? _opened;
    private IReadOnlyList<ErpReportScheduleDigest> _openedSiblings = [];

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?rsched_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedCaption => _opened is null
        ? ""
        : (string.IsNullOrWhiteSpace(_opened.ReportName)
            ? ("Schedule #" + _opened.Id.ToString(CultureInfo.InvariantCulture))
            : _opened.ReportName)
            + (string.IsNullOrWhiteSpace(_opened.ReportType) ? "" : (" · " + _opened.ReportType));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _ok = ctx.Request.Query["ok"].ToString();
        _err = ctx.Request.Query["err"].ToString();
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "rsched_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpReportSchedulerDigestAsync(200, ctx.RequestAborted);
        _schedules = result.Schedules;
        _count = result.Count;
        _active = result.ActiveCount;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpReportScheduleDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Schedule;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _schedules.FirstOrDefault(s => s.Id == _openedId);
                if (openedList is not null)
                {
                    _schedules = new[] { openedList }.Concat(_schedules.Where(s => s.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
