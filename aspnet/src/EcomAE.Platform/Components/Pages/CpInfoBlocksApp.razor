@page "/cp/info-blocks-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ICpInfoBlocksWriteService Blocks
@inject ICpPriceConfigsWriteService Tenants
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Info blocks · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12 epc-scp-panel epc-scp-info-blocks">
        <div class="epc-scp-panel__hero">
            <div>
                <span class="epc-scp-dashboard__badge">Super CP</span>
                <h2 class="epc-scp-dashboard__title">Content &amp; info blocks</h2>
                <p class="epc-scp-dashboard__sub">Manage CMS info blocks shown on platform marketing pages, tenant storefronts, checkout, and CP notices.</p>
            </div>
            <div class="epc-scp-dashboard__hero-actions">
                <a class="btn btn-sm btn-default" href="@IndustrySettingsHref"><i class="fa fa-cog"></i> Industry settings</a>
                <a class="btn btn-sm btn-primary" href="@OperatorGuideHref"><i class="fa fa-book"></i> Operator guide</a>
                <a class="btn btn-sm btn-default ghost" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" target="_blank" rel="noopener"><i class="fa fa-code"></i> Classic twin</a>
            </div>
        </div>

        <div class="epc-scp-intro-panel">
            <div class="epc-scp-intro-panel__body">
                <strong>Operator workspace — Info blocks</strong>
                <p>Publish HTML banners and notices on platform marketing pages, tenant storefronts, checkout, and CP dashboard slots. Scope blocks platform-wide or per tenant.</p>
            </div>
            <a class="btn btn-sm btn-default" href="@OperatorGuideHref"><i class="fa fa-book"></i> Operator guide</a>
        </div>

        @if (!string.IsNullOrWhiteSpace(_flashOk))
        {
            <div class="alert alert-success">@_flashOk</div>
        }
        @if (!string.IsNullOrWhiteSpace(_flashErr))
        {
            <div class="alert alert-danger">@_flashErr</div>
        }

        @if (!_isSuper)
        {
            <div class="alert alert-warning">Info blocks are managed from the Super CP host only. Tenant CPs are independent.</div>
        }
        else if (!_isAdmin)
        {
            <div class="alert alert-warning">Sign in with a Super CP admin session to manage info blocks. <a href="/cp/login?returnUrl=/cp/info-blocks-app">Sign in</a></div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger">@_error</div>
            }

            <div class="epc-scp-filter-bar">
                <form method="get" class="form-inline" action="@_listHref">
                    <select name="placement" class="form-control input-sm">
                        <option value="">All placements</option>
                        @foreach (var place in CpInfoBlocksWriteService.Placements)
                        {
                            <option value="@place.Key" selected="@(_filterPlacement == place.Key)">@place.Value</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-default btn-sm">Filter</button>
                </form>
            </div>

            <div class="row">
                <div class="col-md-5">
                    <div class="epc-scp-form-card">
                        <h4><i class="fa fa-@(_edit is not null ? "edit" : "plus")"></i> @(_edit is not null ? "Edit block" : "New block")</h4>
                        <form method="post" action="/cp/info-blocks/write">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="content_replace" value="1" />
                            <input type="hidden" name="returnUrl" value="@FilterHref" />
                            <input type="hidden" name="action" value="save_info_block" />
                            <input type="hidden" name="id" value="@((_edit?.Id ?? 0).ToString(CultureInfo.InvariantCulture))" />
                            <div class="form-group"><label>Block key</label><input class="form-control input-sm" name="block_key" required pattern="[a-z0-9_-]+" value="@(_edit?.BlockKey ?? "")" placeholder="summer_promo" /></div>
                            <div class="form-group"><label>Title</label><input class="form-control input-sm" name="title" required value="@(_edit?.Title ?? "")" /></div>
                            <div class="form-group"><label>Scope</label>
                                <select class="form-control input-sm" name="scope">
                                    <option value="platform" selected="@(EditScope == "platform")">Platform</option>
                                    <option value="tenant" selected="@(EditScope == "tenant")">Tenant</option>
                                </select>
                            </div>
                            <div class="form-group"><label>Tenant</label>
                                <select class="form-control input-sm" name="site_key">
                                    <option value="">—</option>
                                    @foreach (var t in _tenants)
                                    {
                                        <option value="@t.SiteKey" selected="@((_edit?.SiteKey ?? "") == t.SiteKey)">@t.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group"><label>Placement</label>
                                <select class="form-control input-sm" name="placement">
                                    @foreach (var place in CpInfoBlocksWriteService.Placements)
                                    {
                                        <option value="@place.Key" selected="@(EditPlacement == place.Key)">@place.Value</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group"><label>Locale</label><input class="form-control input-sm" name="locale" maxlength="8" value="@(_edit?.Locale ?? "en")" /></div>
                            <div class="form-group"><label>Sort order</label><input class="form-control input-sm" type="number" name="sort_order" value="@((_edit?.SortOrder ?? 0).ToString(CultureInfo.InvariantCulture))" /></div>
                            <div class="form-group"><label>HTML content</label><textarea class="form-control" name="content_html" rows="6">@(_edit?.ContentHtml ?? "")</textarea></div>
                            <div class="checkbox"><label><input type="checkbox" name="active" value="1" checked="@(_edit is null || _edit.Active)" /> Active</label></div>
                            <button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-save"></i> Save</button>
                            @if (_edit is not null)
                            {
                                <a class="btn btn-default btn-sm" href="@_listHref">Cancel</a>
                            }
                        </form>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="epc-scp-table-card">
                        <h4><i class="fa fa-th-large"></i> Blocks (@_blocks.Count.ToString(CultureInfo.InvariantCulture))</h4>
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered table-condensed epc-scp-data-table">
                                <thead><tr><th>Key / title</th><th>Placement</th><th>Scope</th><th>Locale</th><th></th></tr></thead>
                                <tbody>
                                @if (_blocks.Count == 0)
                                {
                                    <tr><td colspan="5" class="epc-scp-empty-cell">
                                        <div class="epc-scp-empty-state">
                                            <div class="epc-scp-empty-state__icon"><i class="fa fa-inbox"></i></div>
                                            <h4>No info blocks yet</h4>
                                            <p>Create a block for homepage, checkout, or CP notices — platform-wide or scoped to one tenant.</p>
                                            <div class="epc-scp-empty-state__actions">
                                                <a class="btn btn-sm btn-default" href="@IndustrySettingsHref"><i class="fa fa-cog"></i> Industry settings</a>
                                                <a class="btn btn-sm btn-primary" href="@OperatorGuideHref"><i class="fa fa-book"></i> Operator guide</a>
                                            </div>
                                        </div>
                                    </td></tr>
                                }
                                @foreach (var b in _blocks)
                                {
                                    <tr class="@(b.Active ? "" : "text-muted")">
                                        <td>
                                            <strong>@b.Title</strong>
                                            <div><code>@b.BlockKey</code>@if (!b.Active) {<text> </text><span class="label label-default">off</span>}</div>
                                        </td>
                                        <td>@(CpInfoBlocksWriteService.Placements.TryGetValue(b.Placement, out var label) ? label : b.Placement)</td>
                                        <td>@b.Scope@if (!string.IsNullOrEmpty(b.SiteKey)) {<br /><code>@b.SiteKey</code>}</td>
                                        <td>@b.Locale</td>
                                        <td class="epc-scp-actions-cell">
                                            <a class="btn btn-xs btn-default" href="@EditHref(b.Id)"><i class="fa fa-edit"></i></a>
                                            <form method="post" action="/cp/info-blocks/write" style="display:inline" onsubmit="return confirm('Delete this block?');">
                                                <input type="hidden" name="confirmWrites" value="true" />
                                                <input type="hidden" name="returnUrl" value="@FilterHref" />
                                                <input type="hidden" name="action" value="delete_info_block" />
                                                <input type="hidden" name="id" value="@b.Id.ToString(CultureInfo.InvariantCulture)" />
                                                <button type="submit" class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_super_cp_info_blocks";
    private const string _listHref = "/cp/info-blocks-app";
    private const string IndustrySettingsHref = "/cp/industry-settings-app";
    private const string OperatorGuideHref = "/cp/super-cp-operator-guide-app";
    private bool _isAdmin;
    private bool _isSuper;
    private string _filterPlacement = "";
    private string _error = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private IReadOnlyList<CpInfoBlockRow> _blocks = [];
    private IReadOnlyList<CpPriceConfigTenantOption> _tenants = [];
    private CpInfoBlockRow? _edit;

    private string EditScope => CpInfoBlocksWriteService.NormalizeScope(_edit?.Scope);
    private string EditPlacement => CpInfoBlocksWriteService.NormalizePlacement(_edit?.Placement);

    private string FilterHref => _filterPlacement.Length == 0
        ? _listHref
        : _listHref + "?placement=" + Uri.EscapeDataString(_filterPlacement);

    private string EditHref(long id)
        => _listHref + "?edit=" + id.ToString(CultureInfo.InvariantCulture)
           + (_filterPlacement.Length == 0 ? "" : "&placement=" + Uri.EscapeDataString(_filterPlacement));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _isSuper = SuperCpHostGate.IsAllowed(ctx);
        _flashOk = ctx.Request.Query["ok"].ToString();
        _flashErr = ctx.Request.Query["err"].ToString();
        _filterPlacement = ctx.Request.Query["placement"].ToString().Trim();

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!(_isAdmin && _isSuper))
        {
            return;
        }

        var list = await Blocks.ListAsync(_filterPlacement, ctx.RequestAborted);
        _blocks = list.Blocks;
        _error = list.Error;
        _tenants = await Tenants.ListTenantOptionsAsync(ctx.RequestAborted);

        var editId = long.TryParse(ctx.Request.Query["edit"].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var e) ? e : 0;
        if (editId <= 0)
        {
            editId = ErpRecordOpen.ReadId(ctx.Request, "block_id");
        }
        if (editId > 0)
        {
            _edit = _blocks.FirstOrDefault(b => b.Id == editId);
            if (_edit is null && _filterPlacement.Length > 0)
            {
                var all = await Blocks.ListAsync("", ctx.RequestAborted);
                _edit = all.Blocks.FirstOrDefault(b => b.Id == editId);
            }
        }
    }
}
