@page "/cp/info-blocks-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Info blocks · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Info blocks
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Info-block catalog from tenant tables. Edit stays on the Classic twin.</p>
                <p>Open a block for a short content excerpt and other blocks in the same placement.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/info-blocks-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedBlock is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Info block KPIs">
        <div class="kpi"><div class="lbl">Blocks</div><div class="val">@_summary.BlockCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_summary.ActiveCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Placements</div><div class="val">@_summary.PlacementCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Opened siblings</div><div class="val">@_openedSiblings.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedBlock is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedBlock.Title) ? _openedBlock.Title : (!string.IsNullOrWhiteSpace(_openedBlock.BlockKey) ? _openedBlock.BlockKey : ("Block #" + _openedBlock.Id.ToString(CultureInfo.InvariantCulture))))
                    <span class="label label-default pull-right">@(_openedBlock.Active != 0 ? "active" : "inactive")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedBlock.BlockKey) ? _openedBlock.BlockKey : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedBlock.Scope) ? _openedBlock.Scope : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedBlock.SiteKey) ? _openedBlock.SiteKey : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedBlock.Placement) ? _openedBlock.Placement : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedBlock.Locale) ? _openedBlock.Locale : "—")</p>
                    <p>Sort @_openedBlock.SortOrder.ToString(CultureInfo.InvariantCulture)
                        · created @_openedBlock.CreatedAt.ToString(CultureInfo.InvariantCulture)
                        · updated @_openedBlock.UpdatedAt.ToString(CultureInfo.InvariantCulture)</p>
                    @if (!string.IsNullOrWhiteSpace(_openedBlock.ContentExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedBlock.ContentExcerpt</pre>
                        @if (_openedBlock.ContentLen > _openedBlock.ContentExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_openedBlock.ContentExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedBlock.ContentLen.ToString(CultureInfo.InvariantCulture) chars). Full content stays on the Classic twin.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No content excerpt yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Placement siblings</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Key</th>
                                    <th>Title</th>
                                    <th>Locale</th>
                                    <th>Active</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="5">No placement siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.BlockKey) ? sib.BlockKey : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Title) ? sib.Title : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Locale) ? sib.Locale : "—")</td>
                                            <td>@sib.Active.ToString(CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Key</th>
                                <th>Title</th>
                                <th>Scope</th>
                                <th>Placement</th>
                                <th>Locale</th>
                                <th>Active</th>
                                <th>Sort</th>
                                <th>Updated</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_rows.Count == 0)
                        {
                            <tr><td colspan="10">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.BlockKey) ? row.BlockKey : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Scope) ? row.Scope : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Placement) ? row.Placement : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Locale) ? row.Locale : "—")</td>
                                    <td>@row.Active.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.UpdatedAt.ToString(CultureInfo.InvariantCulture)</td>
                                    <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "block_id", row.Id)">Open</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_super_cp_info_blocks";
    private const string _listHref = "/cp/info-blocks-app";
    private bool _isAdmin;
    private CpInfoBlocksSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpInfoBlocksRowDigest> _rows = [];
    private string _message = "";
    private long _openedId;
    private CpInfoBlocksBlockDetail? _openedBlock;
    private IReadOnlyList<CpInfoBlocksRowDigest> _openedSiblings = [];

    private string OpenedCaption => _openedBlock is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedBlock.Title)
            ? (string.IsNullOrWhiteSpace(_openedBlock.BlockKey)
                ? ("Block #" + _openedBlock.Id.ToString(CultureInfo.InvariantCulture))
                : _openedBlock.BlockKey)
            : _openedBlock.Title)
            + (string.IsNullOrWhiteSpace(_openedBlock.Placement) ? "" : (" · " + _openedBlock.Placement));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "block_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpInfoBlocksDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Blocks;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpInfoBlocksBlockDetailAsync(_openedId, ctx.RequestAborted);
            _openedBlock = detail.Block;
            _openedSiblings = detail.Siblings;
            if (_openedBlock is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
