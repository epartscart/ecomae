@page "/cp/info-blocks-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Info blocks · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Info blocks
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Info-block catalog from tenant tables. Edit stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/info-blocks-app" IsAdmin="_isAdmin" />

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Blocks</div>
            <div class="panel-body">
                <p class="help-block">@_summary.BlockCount.ToString(CultureInfo.InvariantCulture) blocks · @_summary.ActiveCount.ToString(CultureInfo.InvariantCulture) active · @_summary.PlacementCount.ToString(CultureInfo.InvariantCulture) placements · @_summary.LocaleCount.ToString(CultureInfo.InvariantCulture) locales.</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Key</th>
                                <th>Title</th>
                                <th>Scope</th>
                                <th>Placement</th>
                                <th>Locale</th>
                                <th>Active</th>
                                <th>Sort</th>
                                <th>Updated</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_rows.Count == 0)
                        {
                            <tr><td colspan="9">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr>
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.BlockKey) ? row.BlockKey : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Scope) ? row.Scope : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Placement) ? row.Placement : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Locale) ? row.Locale : "—")</td>
                                    <td>@row.Active.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.UpdatedAt.ToString(CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_super_cp_info_blocks";
    private bool _isAdmin;
    private CpInfoBlocksSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpInfoBlocksRowDigest> _rows = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpInfoBlocksDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Blocks;
    }
}
