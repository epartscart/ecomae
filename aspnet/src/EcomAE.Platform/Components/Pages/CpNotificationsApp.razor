@page "/cp/notifications-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using System.Text.Json
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ICpNotificationSettingsEditorService Notifications
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>@(_editor is null ? "Notification settings" : _editor.Caption) · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
    <link rel="stylesheet" href="/epc-static.php?f=cp/content/control/epc_comms_notify.css&amp;v=20260922" />
</HeadContent>

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    @if (!_isAdmin)
    {
        <div class="col-lg-12"><div class="alert alert-warning">Sign in to the Control Panel to manage notification settings.</div></div>
    }
    else if (_editor is not null)
    {
        @* ---- notification.php twin (editor) ---- *@
        <div class="col-lg-12 epc-cn">
            <div class="epc-cn-hero">
                <h3>@_editor.Caption</h3>
                <p>Edit the e-mail and SMS template for this event. Use placeholders from the variables list. Restore factory text anytime, then Save.</p>
                <div class="epc-cn-hero__actions">
                    <button type="button" class="btn btn-sm btn-primary" onclick="document.forms['save_notification_form'].submit();"><i class="fas fa-save"></i> Save</button>
                    <button type="button" class="btn btn-sm" onclick="set_default();"><i class="fas fa-undo"></i> Restore default settings</button>
                    <a class="btn btn-sm" href="@_listHref"><i class="fas fa-envelope-open-text"></i> Back to notifications</a>
                    <a class="btn btn-sm" href="/cp/communications-test-app"><i class="fas fa-vial"></i> Test delivery</a>
                    <a class="btn btn-sm" href="/cp"><i class="fas fa-home"></i> Home</a>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_flashOk))
            {
                <div class="alert alert-success" role="status">@_flashOk</div>
            }
            @if (!string.IsNullOrWhiteSpace(_flashErr))
            {
                <div class="alert alert-danger" role="status">@_flashErr</div>
            }

            <div class="epc-cn-guide">
                <h4>Editing guide</h4>
                <ol class="epc-cn-steps">
                    <li><strong>Channels</strong>Enable e-mail and/or SMS only if this event supports them.</li>
                    <li><strong>Placeholders</strong>Insert codes like <code>%order_id%</code> from the variables panel — they are replaced at send time.</li>
                    <li><strong>Restore</strong>Loads factory subject/body into the form; click Save to persist.</li>
                    <li><strong>Test</strong>After saving, verify SMTP/SMS from Communications.</li>
                </ol>
            </div>

            <form method="post" name="save_notification_form" id="save_notification_form" action="/cp/notifications/save">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@_editorHref" />
                <input type="hidden" name="notification_id" value="@_editor.Id.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="lang_code" value="@_lang" />

                <div class="epc-cn-edit-grid">
                    <div class="epc-cn-side">
                        <div class="epc-cn-card">
                            <div class="epc-cn-card__head">
                                <div>
                                    <h4>Notification</h4>
                                    <p>Event metadata</p>
                                </div>
                            </div>
                            <div class="epc-cn-card__body">
                                <dl class="epc-cn-kv">
                                    <dt>ID</dt><dd>@_editor.Id.ToString(CultureInfo.InvariantCulture)</dd>
                                    <dt>Name</dt><dd><code>@_editor.Name</code></dd>
                                    <dt>Caption</dt><dd>@_editor.Caption</dd>
                                    <dt>Event</dt><dd>@_editor.Event</dd>
                                    <dt>Description</dt><dd>@_editor.Description</dd>
                                    <dt>Send for not confirmed users</dt>
                                    <dd>@(_editor.SendForNotConfirmed == 1 ? "Yes" : "No")</dd>
                                </dl>
                            </div>
                        </div>

                        <div class="epc-cn-card">
                            <div class="epc-cn-card__head">
                                <div>
                                    <h4>Variables</h4>
                                    <p>Placeholders replaced at send time</p>
                                </div>
                            </div>
                            <div class="epc-cn-card__body" style="padding:0;">
                                <table class="table epc-cn-vars">
                                    <thead>
                                        <tr>
                                            <th>Caption</th>
                                            <th>Code</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @if (_editor.Vars.Count == 0)
                                    {
                                        <tr><td colspan="2" class="epc-cn-empty">No variables for this template.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var v in _editor.Vars)
                                        {
                                            <tr>
                                                <td>@v.Caption</td>
                                                <td><code>%@(v.Name)%</code></td>
                                            </tr>
                                        }
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="epc-cn-main">
                        <div class="epc-cn-card is-email" style="margin-bottom:14px;">
                            <div class="epc-cn-card__head">
                                <div>
                                    <h4><i class="far fa-envelope"></i> E-mail</h4>
                                    <p>Subject and HTML body</p>
                                </div>
                            </div>
                            <div class="epc-cn-card__body">
                                @if (_editor.ForeseenEmail == 1)
                                {
                                    <div class="epc-cn-field">
                                        <label class="epc-cn-check">
                                            <input type="checkbox" name="email_on" id="email_on" value="1" checked="@(_editor.EmailOn == 1)" />
                                            Send e-mail for this event
                                        </label>
                                    </div>
                                    <div class="epc-cn-field">
                                        <label for="email_subject">Subject</label>
                                        <input class="form-control" type="text" name="email_subject" id="email_subject" value="@_editor.EmailSubject" placeholder="E-mail subject" />
                                    </div>
                                    <div class="epc-cn-field">
                                        <label for="email_body">Body (HTML)</label>
                                        <textarea style="min-height:400px" class="form-control tinymce_editor" id="email_body" name="email_body">@_editor.EmailBody</textarea>
                                    </div>
                                }
                                else
                                {
                                    <p class="epc-cn-meta">E-mail is not available for this event.</p>
                                }
                            </div>
                        </div>

                        <div class="epc-cn-card is-sms">
                            <div class="epc-cn-card__head">
                                <div>
                                    <h4><i class="fas fa-mobile-alt"></i> SMS</h4>
                                    <p>Plain text message</p>
                                </div>
                            </div>
                            <div class="epc-cn-card__body">
                                @if (_editor.ForeseenSms == 1)
                                {
                                    <div class="epc-cn-field">
                                        <label class="epc-cn-check">
                                            <input type="checkbox" name="sms_on" id="sms_on" value="1" checked="@(_editor.SmsOn == 1)" />
                                            Send SMS for this event
                                        </label>
                                    </div>
                                    <div class="epc-cn-field">
                                        <label for="sms_body">Text</label>
                                        <textarea class="form-control" name="sms_body" id="sms_body" rows="5" placeholder="SMS text">@_editor.SmsBody</textarea>
                                    </div>
                                }
                                else
                                {
                                    <p class="epc-cn-meta">SMS is not available for this event.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="epc-cn-sticky">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save</button>
                    <button type="button" class="btn btn-default" onclick="set_default();"><i class="fas fa-undo"></i> Restore default settings</button>
                    <a class="btn btn-default" href="@_listHref">Back to notifications</a>
                    <span class="epc-cn-sticky__hint">Changes apply after Save · then test under Communications</span>
                </div>
            </form>
        </div>

        <script src="/epc-static.php?f=cp/lib/tinymce/tinymce.min.js"></script>
        <script>
        window.EPC_COMMS_NOTIFY = { page: 'notification_edit' };
        var epcCnDefaults = @((MarkupString)JsonSerializer.Serialize(new { emailSubject = _editor.DefaultEmailSubject, emailBody = _editor.DefaultEmailBody, smsBody = _editor.DefaultSmsBody }));
        function init_TinyMCE()
        {
            if (typeof tinymce === 'undefined' || !document.getElementById('email_body')) { return; }
            tinymce.baseURL = '/epc-static.php?f=cp/lib/tinymce';
            tinymce.init({
                selector: 'textarea.tinymce_editor',
                toolbar: 'bold italic | fontselect | fontsizeselect | styleselect | forecolor | backcolor | code fullscreen',
                plugins: ['code fullscreen textcolor'],
                convert_urls: false
            });
        }
        init_TinyMCE();
        function set_default()
        {
            var emailOn = document.getElementById('email_on');
            if (emailOn) {
                emailOn.checked = true;
                document.getElementById('email_subject').value = epcCnDefaults.emailSubject;
                if (typeof tinymce !== 'undefined' && tinymce.get('email_body')) {
                    tinymce.get('email_body').setContent(epcCnDefaults.emailBody);
                } else {
                    document.getElementById('email_body').value = epcCnDefaults.emailBody;
                }
            }
            var smsOn = document.getElementById('sms_on');
            if (smsOn) {
                smsOn.checked = true;
                document.getElementById('sms_body').value = epcCnDefaults.smsBody;
            }
            alert('Default settings were loaded into the form. Click Save to apply them.');
        }
        </script>
    }
    else
    {
        @* ---- notifications.php twin (list) ---- *@
        <div class="col-lg-12 epc-cn" id="epc-cn-notify-root" data-filter="all">
            <div class="epc-cn-hero">
                <h3>Notification settings</h3>
                <p>Turn e-mail and SMS on or off for each shop event, edit message templates, and restore factory text when needed. Delivery itself is configured under Communications, SMTP, and SMS Operators.</p>
                <div class="epc-cn-hero__actions">
                    <button type="button" class="btn btn-sm btn-primary" onclick="set_default_checked();"><i class="fas fa-undo"></i> Restore default settings</button>
                    <a class="btn btn-sm" href="/cp/communications-test-app"><i class="fas fa-broadcast-tower"></i> Communications</a>
                    <a class="btn btn-sm" href="/cp/sms-whatsapp-app"><i class="fas fa-mobile-alt"></i> SMS operators</a>
                    <a class="btn btn-sm" href="/cp"><i class="fas fa-home"></i> Home</a>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_flashOk))
            {
                <div class="alert alert-success" role="status">@_flashOk</div>
            }
            @if (!string.IsNullOrWhiteSpace(_flashErr))
            {
                <div class="alert alert-danger" role="status">@_flashErr</div>
            }
            @if (_openedId > 0 && _editor is null && !string.IsNullOrWhiteSpace(_openMessage))
            {
                <div class="alert alert-warning" role="status">@_openMessage</div>
            }

            <div class="epc-cn-quick">
                <a class="is-email" href="/cp/config-items-app?need_config_group=3">
                    <span class="epc-cn-quick__icon"><i class="far fa-envelope"></i></span>
                    <strong>SMTP first</strong>
                    <span>Templates only send when e-mail/SMTP is configured.</span>
                </a>
                <a class="is-sms" href="/cp/sms-whatsapp-app">
                    <span class="epc-cn-quick__icon"><i class="fas fa-mobile-alt"></i></span>
                    <strong>SMS operator</strong>
                    <span>Activate one operator and set the sender number.</span>
                </a>
                <a class="is-templates" href="/cp/communications-test-app">
                    <span class="epc-cn-quick__icon"><i class="fas fa-vial"></i></span>
                    <strong>Test delivery</strong>
                    <span>Send a test e-mail or SMS from Communications.</span>
                </a>
                <a href="/cp/guides-app">
                    <span class="epc-cn-quick__icon"><i class="fas fa-book"></i></span>
                    <strong>CP guideline</strong>
                    <span>Where notifications fit in the order workflow.</span>
                </a>
            </div>

            <div class="epc-cn-guide">
                <h4>How to use this page</h4>
                <ol class="epc-cn-steps">
                    <li><strong>Scan channels</strong>Green = on, red = off. Click the icon to toggle e-mail or SMS for that event.</li>
                    <li><strong>Edit a template</strong>Open the pencil to change subject, HTML body, or SMS text and placeholders.</li>
                    <li><strong>Restore defaults</strong>Tick rows (or one row’s undo) to reset text and channel flags to factory values.</li>
                    <li><strong>Verify send</strong>After changes, test from Communications so SMTP / SMS credentials are confirmed.</li>
                </ol>
            </div>

            <form method="post" name="set_default_form" id="set_default_form" action="/cp/notifications/restore">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@_listHref" />
                <input type="hidden" name="notifications_ids" id="notifications_ids" value="" />
            </form>

            <div class="epc-cn-filter">
                <input type="search" id="epc-cn-notify-q" placeholder="Search caption, code, event…" autocomplete="off" />
                <button type="button" class="epc-cn-chip is-active" data-filter-chip="all">All</button>
                <button type="button" class="epc-cn-chip" data-filter-chip="email">E-mail on</button>
                <button type="button" class="epc-cn-chip" data-filter-chip="sms">SMS on</button>
                <button type="button" class="epc-cn-chip" data-filter-chip="off">Both off</button>
                <span class="epc-cn-count" id="epc-cn-notify-count">@_rows.Count.ToString(CultureInfo.InvariantCulture) / @_rows.Count.ToString(CultureInfo.InvariantCulture)</span>
            </div>

            <div class="epc-cn-table-wrap table-responsive">
                <table class="table epc-cn-table" data-sort="false">
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="check_uncheck_all" name="check_uncheck_all" onchange="on_check_uncheck_all();" /></th>
                            <th>ID</th>
                            <th>Caption</th>
                            <th>Name</th>
                            <th>Event</th>
                            <th>Description</th>
                            <th class="text-center">E-mail</th>
                            <th class="text-center">SMS</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (_rows.Count == 0)
                    {
                        <tr><td colspan="9" class="epc-cn-empty">No notification templates found.</td></tr>
                    }
                    else
                    {
                        @foreach (var r in _rows)
                        {
                            var id = r.Id.ToString(CultureInfo.InvariantCulture);
                            var href = EditorHref(r.Id);
                            var search = (r.Caption + " " + r.Name + " " + r.Event + " " + r.Description + " " + id).ToLowerInvariant();
                            <tr data-notify-row data-search="@search" data-email-on="@r.EmailOn.ToString(CultureInfo.InvariantCulture)" data-sms-on="@r.SmsOn.ToString(CultureInfo.InvariantCulture)">
                                <td><input type="checkbox" class="epc-cn-row-check" onchange="on_one_check_changed('checked_@(id)');" id="checked_@(id)" name="checked_@(id)" data-notification-id="@id" /></td>
                                <td><a href="@href">@id</a></td>
                                <td><a href="@href">@r.Caption</a></td>
                                <td><a href="@href"><span class="epc-cn-muted">@r.Name</span></a></td>
                                <td><a href="@href">@r.Event</a></td>
                                <td><a href="@href"><span class="epc-cn-muted">@r.Description</span></a></td>
                                <td class="text-center">
                                    <form method="post" name="set_send_email_@(id)" action="/cp/notifications/toggle" style="display:inline">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="@_listHref" />
                                        <input type="hidden" name="type" value="email" />
                                        <input type="hidden" name="notification_id" value="@id" />
                                        @if (r.ForeseenEmail == 0)
                                        {
                                            <span class="epc-cn-toggle is-na" title="E-mail not available for this event"><i class="far fa-circle"></i></span>
                                        }
                                        else if (r.EmailOn == 1)
                                        {
                                            <input type="hidden" name="set_send" value="0" />
                                            <button type="submit" class="epc-cn-toggle is-on" title="E-mail is on — click to switch off"><i class="fas fa-check-circle"></i></button>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="set_send" value="1" />
                                            <button type="submit" class="epc-cn-toggle is-off" title="E-mail is off — click to switch on"><i class="fas fa-minus-circle"></i></button>
                                        }
                                    </form>
                                </td>
                                <td class="text-center">
                                    <form method="post" name="set_send_sms_@(id)" action="/cp/notifications/toggle" style="display:inline">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="@_listHref" />
                                        <input type="hidden" name="type" value="sms" />
                                        <input type="hidden" name="notification_id" value="@id" />
                                        @if (r.ForeseenSms == 0)
                                        {
                                            <span class="epc-cn-toggle is-na" title="SMS not available for this event"><i class="far fa-circle"></i></span>
                                        }
                                        else if (r.SmsOn == 1)
                                        {
                                            <input type="hidden" name="set_send" value="0" />
                                            <button type="submit" class="epc-cn-toggle is-on" title="SMS is on — click to switch off"><i class="fas fa-check-circle"></i></button>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="set_send" value="1" />
                                            <button type="submit" class="epc-cn-toggle is-off" title="SMS is off — click to switch on"><i class="fas fa-minus-circle"></i></button>
                                        }
                                    </form>
                                </td>
                                <td class="text-center">
                                    <span class="epc-cn-actions">
                                        <button type="button" class="is-reset" title="Restore default settings" onclick="set_default_one(@id);"><i class="fas fa-undo"></i></button>
                                        <a class="is-edit" href="@href" title="Edit template"><i class="fas fa-edit"></i></a>
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <script src="/epc-static.php?f=cp/content/control/epc_comms_notify.js&amp;v=20260922"></script>
        <script>
        window.EPC_COMMS_NOTIFY = { page: 'notifications' };
        function on_check_uncheck_all()
        {
            var all = document.getElementById('check_uncheck_all').checked;
            var boxes = document.querySelectorAll('.epc-cn-row-check');
            for (var i = 0; i < boxes.length; i++) { boxes[i].checked = all; }
        }
        function on_one_check_changed(id)
        {
            if (!document.getElementById(id).checked) { document.getElementById('check_uncheck_all').checked = false; }
        }
        function set_default_ids(ids)
        {
            if (!ids.length) { alert('Select at least one notification.'); return; }
            if (!confirm('Restore factory text and channel settings for ' + ids.length + ' notification(s)?')) { return; }
            document.getElementById('notifications_ids').value = JSON.stringify(ids);
            document.forms['set_default_form'].submit();
        }
        function set_default_checked()
        {
            var ids = [];
            var boxes = document.querySelectorAll('.epc-cn-row-check');
            for (var i = 0; i < boxes.length; i++) {
                if (boxes[i].checked) { ids.push(parseInt(boxes[i].getAttribute('data-notification-id'), 10)); }
            }
            set_default_ids(ids);
        }
        function set_default_one(id)
        {
            set_default_ids([id]);
        }
        </script>
    }
</PhpCpDesktopChrome>

@code {
    private const string _listHref = "/cp/notifications-app";
    private const string _lang = "en";
    private bool _isAdmin;
    private string _flashOk = "";
    private string _flashErr = "";
    private string _openMessage = "";
    private long _openedId;
    private string _editorHref = _listHref;
    private IReadOnlyList<CpNotificationRow> _rows = [];
    private CpNotificationDetail? _editor;

    private static string EditorHref(long id) => _listHref + "?notification_id=" + id.ToString(CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "notification_id");
        _flashOk = ctx.Request.Query["ok"].ToString();
        _flashErr = ctx.Request.Query["err"].ToString();

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        if (_openedId > 0)
        {
            _editor = await Notifications.OpenAsync(_openedId, _lang, ctx.RequestAborted);
            _editorHref = EditorHref(_openedId);
            if (_editor is not null)
            {
                return;
            }

            _openMessage = "Notification #" + _openedId.ToString(CultureInfo.InvariantCulture) + " was not found.";
        }

        _rows = await Notifications.ListAsync(_lang, ctx.RequestAborted);
    }
}
