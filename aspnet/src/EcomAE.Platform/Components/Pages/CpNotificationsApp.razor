@page "/cp/notifications-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Notifications · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
    .epc-cn { --cn-ink:#0f172a; --cn-muted:#64748b; --cn-line:#e2e8f0; --cn-soft:#f8fafc; color:var(--cn-ink); }
    .epc-cn-hero { background:linear-gradient(125deg,#0f172a 0%,#134e4a 52%,#0f766e 100%); color:#fff; border-radius:14px; padding:20px 22px; margin:0 0 16px; }
    .epc-cn-hero h3 { margin:0 0 6px; color:#fff; font-size:20px; }
    .epc-cn-hero p { margin:0; opacity:.92; max-width:52rem; line-height:1.45; font-size:13px; }
    .epc-cn-hero__actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }
    .epc-cn-hero__actions .btn { border:1px solid rgba(255,255,255,.28); background:rgba(255,255,255,.12); color:#fff; font-weight:600; }
    .epc-cn-hero__actions .btn-primary { background:#fff; color:#0f172a; border-color:#fff; }
    .epc-cn-quick { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:12px; margin:0 0 16px; }
    .epc-cn-quick a { display:block; background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:14px 15px; color:#0f172a; text-decoration:none !important; }
    .epc-cn-quick strong { display:block; font-size:14px; margin-bottom:3px; }
    .epc-cn-quick span { display:block; font-size:12px; color:#64748b; line-height:1.4; }
    .epc-cn-guide { background:linear-gradient(135deg,#f0fdfa 0%,#f0f9ff 100%); border:1px solid #cce7e2; border-radius:12px; padding:16px 18px; margin:0 0 16px; }
    .epc-cn-guide h4 { margin:0 0 10px; font-size:14px; font-weight:700; color:#134e4a; }
    .epc-cn-steps { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:10px; margin:0; padding:0; list-style:none; }
    .epc-cn-steps li { background:rgba(255,255,255,.75); border:1px solid #d9ebe7; border-radius:10px; padding:12px; font-size:12px; line-height:1.45; color:#334155; }
    .epc-cn-steps strong { display:block; color:#0f172a; font-size:13px; margin-bottom:2px; }
</style>
</HeadContent>

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12 epc-cn" id="epc-cn-notify-root">
        <div class="epc-cn-hero">
            <h3>Notification settings</h3>
            <p>Turn e-mail and SMS on or off for each shop event. Channel toggles write here. Edit message templates and restore factory text stay on the Classic twin. Delivery itself is configured under Communications, SMTP, and SMS Operators. This page does not invent a send.</p>
            <div class="epc-cn-hero__actions">
                <a class="btn btn-sm btn-primary" href="/cp/communications-test-app">Communications</a>
                <a class="btn btn-sm" href="/cp/sms-whatsapp-app">SMS operators</a>
                <a class="btn btn-sm" href="/cp/tenant-email-app">E-mail settings</a>
                <a class="btn btn-sm" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
        </div>

        <div class="epc-cn-quick">
            <a class="is-email" href="/cp/tenant-email-app">
                <strong>SMTP first</strong>
                <span>Templates only send when e-mail/SMTP is configured.</span>
            </a>
            <a class="is-sms" href="/cp/sms-whatsapp-app">
                <strong>SMS operator</strong>
                <span>Activate one operator and set the sender number.</span>
            </a>
            <a class="is-templates" href="/cp/communications-test-app">
                <strong>Test delivery</strong>
                <span>Last-test status on Communications. Send stays Classic.</span>
            </a>
            <a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">
                <strong>Edit templates</strong>
                <span>Template text and factory restore stay on the Classic twin.</span>
            </a>
        </div>

        <div class="epc-cn-guide">
            <h4>How to use this page</h4>
            <ol class="epc-cn-steps">
                <li><strong>Scan digest</strong>Unread and channel counts come from tenant notification tables.</li>
                <li><strong>Toggle channels</strong>Enable or disable e-mail and SMS for events that support them.</li>
                <li><strong>Edit a template</strong>Open the Classic twin to change subject, HTML body, or SMS text.</li>
                <li><strong>Restore defaults</strong>Factory reset stays on the Classic twin.</li>
                <li><strong>Verify send</strong>Test from Classic Communications so SMTP / SMS credentials are confirmed.</li>
            </ol>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Shop event channels</div>
            <div class="panel-body">
                <p class="help-block">@(_isAdmin ? $"{_settings.Count} events. Template HTML and SMS text stay off this list." : "Sign in to load channel flags.")</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>E-mail</th>
                                <th>SMS</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!_isAdmin)
                        {
                            <tr><td colspan="4">Sign in for live data.</td></tr>
                        }
                        else if (_settings.Count == 0)
                        {
                            <tr><td colspan="4">No notification settings yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var s in _settings)
                            {
                                <tr>
                                    <td>@s.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(string.IsNullOrWhiteSpace(s.Name) ? "—" : s.Name)</td>
                                    <td>
                                        @if (s.ForeseenEmail == 0)
                                        {
                                            <span class="text-muted">n/a</span>
                                        }
                                        else
                                        {
                                            <form method="post" action="/cp/notifications/toggle" style="display:inline">
                                                <input type="hidden" name="confirmWrites" value="true" />
                                                <input type="hidden" name="returnUrl" value="/cp/notifications-app" />
                                                <input type="hidden" name="notification_id" value="@s.Id.ToString(CultureInfo.InvariantCulture)" />
                                                <input type="hidden" name="type" value="email" />
                                                <input type="hidden" name="set_send" value="@(s.EmailOn == 0 ? "1" : "0")" />
                                                <button type="submit" class="btn btn-xs @(s.EmailOn == 0 ? "btn-primary" : "btn-default")">@(s.EmailOn == 0 ? "Enable e-mail" : "Disable e-mail")</button>
                                            </form>
                                        }
                                    </td>
                                    <td>
                                        @if (s.ForeseenSms == 0)
                                        {
                                            <span class="text-muted">n/a</span>
                                        }
                                        else
                                        {
                                            <form method="post" action="/cp/notifications/toggle" style="display:inline">
                                                <input type="hidden" name="confirmWrites" value="true" />
                                                <input type="hidden" name="returnUrl" value="/cp/notifications-app" />
                                                <input type="hidden" name="notification_id" value="@s.Id.ToString(CultureInfo.InvariantCulture)" />
                                                <input type="hidden" name="type" value="sms" />
                                                <input type="hidden" name="set_send" value="@(s.SmsOn == 0 ? "1" : "0")" />
                                                <button type="submit" class="btn btn-xs @(s.SmsOn == 0 ? "btn-primary" : "btn-default")">@(s.SmsOn == 0 ? "Enable SMS" : "Disable SMS")</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/notifications-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedNote is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Notification KPIs">
        <div class="kpi"><div class="lbl">Notifications</div><div class="val">@_summary.NotificationCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Unread</div><div class="val">@_summary.UnreadCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Channels</div><div class="val">@_summary.ChannelCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Opened siblings</div><div class="val">@_openedSiblings.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedNote is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedNote.Title) ? _openedNote.Title : ("Note #" + _openedNote.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedNote.Severity) ? _openedNote.Severity : "—")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedNote.TenantKey) ? _openedNote.TenantKey : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedNote.Channel) ? _openedNote.Channel : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedNote.Category) ? _openedNote.Category : "—")
                        · user @_openedNote.UserId.ToString(CultureInfo.InvariantCulture)
                        · @(_openedNote.IsRead != 0 ? "read" : "unread")
                        · @(_openedNote.Dismissed != 0 ? "dismissed" : "open")</p>
                    <p>Created @_openedNote.CreatedAt
                        · read @_openedNote.ReadAt</p>
                    @if (!string.IsNullOrWhiteSpace(_openedNote.BodyExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedNote.BodyExcerpt</pre>
                        @if (_openedNote.BodyLen > _openedNote.BodyExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_openedNote.BodyExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedNote.BodyLen.ToString(CultureInfo.InvariantCulture) chars). Full body stays on the Classic twin.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No body excerpt yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Category siblings</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Title</th>
                                    <th>Severity</th>
                                    <th>Channel</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="5">No category siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Title) ? sib.Title : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Severity) ? sib.Severity : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Channel) ? sib.Channel : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.CreatedAt) ? sib.CreatedAt : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Recent notifications</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Title</th>
                                <th>Severity</th>
                                <th>Category</th>
                                <th>Channel</th>
                                <th>Read</th>
                                <th>Created</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!_isAdmin)
                        {
                            <tr><td colspan="8">Sign in for live data.</td></tr>
                        }
                        else if (_rows.Count == 0)
                        {
                            <tr><td colspan="8">@(!string.IsNullOrWhiteSpace(_message) ? _message : "No records yet.")</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Severity) ? row.Severity : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Category) ? row.Category : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Channel) ? row.Channel : "—")</td>
                                    <td>@row.IsRead.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.CreatedAt) ? row.CreatedAt : "—")</td>
                                    <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "notif_id", row.Id)">Open</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/notifications_settings";
    private const string _listHref = "/cp/notifications-app";
    private bool _isAdmin;
    private string _flashOk = "";
    private string _flashErr = "";
    private CpNotificationsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpNotificationSettingDigest> _settings = [];
    private IReadOnlyList<CpNotificationsRowDigest> _rows = [];
    private string _message = "";
    private long _openedId;
    private CpNotificationsDetail? _openedNote;
    private IReadOnlyList<CpNotificationsRowDigest> _openedSiblings = [];

    private string OpenedCaption => _openedNote is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedNote.Title)
            ? ("Note #" + _openedNote.Id.ToString(CultureInfo.InvariantCulture))
            : _openedNote.Title)
            + (string.IsNullOrWhiteSpace(_openedNote.Severity) ? "" : (" · " + _openedNote.Severity));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "notif_id");
        _flashOk = ctx.Request.Query["ok"].ToString();
        _flashErr = ctx.Request.Query["err"].ToString();

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpNotificationsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Notifications;
        _message = result.Message;
        var settings = await Dashboards.BuildCpNotificationSettingsDigestAsync(200, ctx.RequestAborted);
        _settings = settings.Settings;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpNotificationsDetailAsync(_openedId, ctx.RequestAborted);
            _openedNote = detail.Notification;
            _openedSiblings = detail.Siblings;
            if (_openedNote is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
