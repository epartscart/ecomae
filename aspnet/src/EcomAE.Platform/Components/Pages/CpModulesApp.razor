@page "/cp/modules-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Modules · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <PhpParityModuleBody AppPath="/cp/modules-app" IsAdmin="_isAdmin" />


    <PhpCpModulePageHeader Title="Modules"
                           Subtitle="Create, save, activate, or delete a module here. Page binding and group access write with the save."
                           PhpTabHref="@_phpTab">
        <a class="ghost" href="/cp/pages-app">Pages</a>
        <a class="ghost" href="/cp/menus-app">Menus</a>
    </PhpCpModulePageHeader>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/modules/write" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/modules-app" />
            <input type="hidden" name="langCode" value="en" />
            <div style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <label>Action
                    <select name="action">
                        <option value="create">create</option>
                        <option value="edit">edit</option>
                    </select>
                </label>
                <label>Module id <input type="number" name="moduleId" min="0" value="0" style="width:6rem" title="0 = create" /></label>
                <label>Prototype id <input type="number" name="prototypeId" min="0" value="0" style="width:6rem" /></label>
                <label>Caption <input type="text" name="caption" /></label>
                <label>Type
                    <select name="contentType">
                        <option value="text">text</option>
                        <option value="php">php</option>
                    </select>
                </label>
                <label>Position <input type="text" name="position" placeholder="left" /></label>
                <label>Activated
                    <select name="activated">
                        <option value="1">Yes</option>
                        <option value="0">No</option>
                    </select>
                </label>
                <label>Frontend
                    <select name="isFrontend">
                        <option value="1">Yes</option>
                        <option value="0">No</option>
                    </select>
                </label>
            </div>
            <label>Body
                <textarea name="content" rows="4" style="width:100%;font-family:monospace" placeholder="HTML for type=text, or a .php path for type=php"></textarea>
            </label>
            <div style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <label>Data JSON <input type="text" name="dataJson" placeholder="[]" /></label>
                <label>Pages <input type="text" name="contentIds" placeholder="[]" /></label>
                <label>Groups <input type="text" name="groupsAllowed" placeholder="[]" /></label>
            </div>
            <button type="submit">Save module</button>
        </form>
        <form method="post" action="/cp/modules/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/modules-app" />
            <input type="hidden" name="action" value="activate" />
            <label>Ids <input type="text" name="ids" required placeholder="[1] or 1,2" /></label>
            <label>Activated
                <select name="activated">
                    <option value="1">Yes</option>
                    <option value="0">No</option>
                </select>
            </label>
            <button type="submit">Set activated</button>
        </form>
        <form method="post" action="/cp/modules/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/modules-app" />
            <input type="hidden" name="action" value="delete" />
            <input type="hidden" name="isFrontend" value="1" />
            <label>Ids <input type="text" name="ids" required placeholder="[1] or 1,2" /></label>
            <button type="submit">Delete modules</button>
        </form>
    }

    <div class="epc-scp-kpi" aria-label="Modules KPIs">
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Shown (limit @_limit)</div>
            <div class="epc-scp-kpi__val">@_modules.Count</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Activated in page</div>
            <div class="epc-scp-kpi__val">@_activated</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Frontend modules</div>
            <div class="epc-scp-kpi__val">@_frontend</div>
        </div>
    </div>

    <div class="epc-scp-table-card">
        <table class="epc-scp-data-table table table-epc-pro">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Caption</th>
                    <th>Activated</th>
                    <th>Frontend</th>
                    <th>Prototype</th>
                    <th>Control</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_modules.Count == 0)
                {
                    <tr><td colspan="7">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var m in _modules)
                    {
                        <tr>
                            <td><strong>@m.Id</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(m.Caption) ? "—" : m.Caption)</td>
                            <td>
                                @if (m.Activated)
                                {
                                    <span class="epc-scp-badge epc-scp-badge--ok">yes</span>
                                }
                                else
                                {
                                    <span class="epc-scp-badge epc-scp-badge--off">no</span>
                                }
                            </td>
                            <td><span class="epc-scp-badge">@(m.IsFrontend ? "yes" : "no")</span></td>
                            <td><span class="epc-scp-badge">@(m.IsPrototype ? "yes" : "no")</span></td>
                            <td><span class="epc-scp-badge">@(m.ControlAvailable ? "yes" : "no")</span></td>
                            <td class="epc-scp-actions-cell"><a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/modules/modules_manager";
    private bool _isAdmin;
    private IReadOnlyList<CpModuleDigest> _modules = [];
    private int _activated;
    private int _frontend;
    private int _limit = 200;
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListCpModulesAsync(_limit, ctx.RequestAborted);
        _modules = result.Modules;
        _activated = _modules.Count(m => m.Activated);
        _frontend = _modules.Count(m => m.IsFrontend);
        _source = result.Source;
        _message = result.Message;
    }
}
