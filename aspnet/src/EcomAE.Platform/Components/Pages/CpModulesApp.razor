@page "/cp/modules-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Modules · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/modules-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />


    <PhpCpModulePageHeader Title="Modules"
                           Subtitle="Create, save, activate, or delete a module here. Page binding and group access write with the save."
                           PhpTabHref="@_phpTab">
        <a class="ghost" href="/cp/pages-app">Pages</a>
        <a class="ghost" href="/cp/menus-app">Menus</a>
    </PhpCpModulePageHeader>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/modules/write" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(_openedId > 0 ? _listHref + "?module_id=" + _openedId.ToString(CultureInfo.InvariantCulture) : _listHref)" />
            <input type="hidden" name="langCode" value="en" />
            <div style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <label>Action
                    <select name="action">
                        <option value="create">create</option>
                        <option value="edit">edit</option>
                    </select>
                </label>
                <label>Module id <input type="number" name="moduleId" min="0" value="@(_openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "0")" style="width:6rem" title="0 = create" /></label>
                <label>Prototype id <input type="number" name="prototypeId" min="0" value="0" style="width:6rem" /></label>
                <label>Caption <input type="text" name="caption" /></label>
                <label>Type
                    <select name="contentType">
                        <option value="text">text</option>
                        <option value="php">php</option>
                    </select>
                </label>
                <label>Position <input type="text" name="position" placeholder="left" /></label>
                <label>Activated
                    <select name="activated">
                        <option value="1">Yes</option>
                        <option value="0">No</option>
                    </select>
                </label>
                <label>Frontend
                    <select name="isFrontend">
                        <option value="1">Yes</option>
                        <option value="0">No</option>
                    </select>
                </label>
            </div>
            <label>Body
                <textarea name="content" rows="4" style="width:100%;font-family:monospace" placeholder="HTML for type=text, or a .php path for type=php"></textarea>
            </label>
            <div style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <label>Data JSON <input type="text" name="dataJson" placeholder="[]" /></label>
                <label>Pages <input type="text" name="contentIds" placeholder="[]" /></label>
                <label>Groups <input type="text" name="groupsAllowed" placeholder="[]" /></label>
            </div>
            <button type="submit">Save module</button>
        </form>
        <form method="post" action="/cp/modules/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(_openedId > 0 ? _listHref + "?module_id=" + _openedId.ToString(CultureInfo.InvariantCulture) : _listHref)" />
            <input type="hidden" name="action" value="activate" />
            <label>Ids <input type="text" name="ids" required placeholder="[1] or 1,2" /></label>
            <label>Activated
                <select name="activated">
                    <option value="1">Yes</option>
                    <option value="0">No</option>
                </select>
            </label>
            <button type="submit">Set activated</button>
        </form>
        <form method="post" action="/cp/modules/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(_openedId > 0 ? _listHref + "?module_id=" + _openedId.ToString(CultureInfo.InvariantCulture) : _listHref)" />
            <input type="hidden" name="action" value="delete" />
            <input type="hidden" name="isFrontend" value="1" />
            <label>Ids <input type="text" name="ids" required placeholder="[1] or 1,2" /></label>
            <button type="submit">Delete modules</button>
        </form>
    }

    <div class="epc-scp-kpi" aria-label="Modules KPIs">
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Shown (limit @_limit)</div>
            <div class="epc-scp-kpi__val">@_modules.Count</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Activated in page</div>
            <div class="epc-scp-kpi__val">@_activated</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Frontend modules</div>
            <div class="epc-scp-kpi__val">@_frontend</div>
        </div>
    </div>

    <div class="epc-scp-table-card">
        <div class="epc-scp-table-card__head">
            <div>
                <h3>Modules</h3>
                <p class="epc-users-hint">Open a row for the 280-character body excerpt. Full HTML stays on the Classic twin.</p>
            </div>
            <a class="btn btn-primary btn-xs" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
        </div>
        <table class="epc-scp-data-table table table-epc-pro">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Caption</th>
                    <th>Activated</th>
                    <th>Frontend</th>
                    <th>Prototype</th>
                    <th>Control</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_modules.Count == 0)
                {
                    <tr><td colspan="7">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var m in _modules)
                    {
                        <tr id="erp-row-@m.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(m.Id, _openedId)">
                            <td><strong>@m.Id</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(m.Caption) ? "—" : m.Caption)</td>
                            <td>
                                @if (m.Activated)
                                {
                                    <span class="epc-scp-badge epc-scp-badge--ok">yes</span>
                                }
                                else
                                {
                                    <span class="epc-scp-badge epc-scp-badge--off">no</span>
                                }
                            </td>
                            <td><span class="epc-scp-badge">@(m.IsFrontend ? "yes" : "no")</span></td>
                            <td><span class="epc-scp-badge">@(m.IsPrototype ? "yes" : "no")</span></td>
                            <td><span class="epc-scp-badge">@(m.ControlAvailable ? "yes" : "no")</span></td>
                            <td class="epc-scp-actions-cell">
                                <a href="@ErpRecordOpen.Href(_listHref, "module_id", m.Id)">Open</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-scp-table-card" style="margin-top:1rem">
            <div class="epc-scp-table-card__head">
                <div>
                    <h3>@OpenedCaption</h3>
                    <p class="epc-users-hint">Module field preview. Full HTML stays on the Classic twin.</p>
                </div>
                <a class="btn btn-default btn-xs" href="@_listHref">Close</a>
            </div>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Type</dt><dd>@(string.IsNullOrWhiteSpace(_opened.ContentType) ? "—" : _opened.ContentType)</dd>
                <dt>Position</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Position) ? "—" : _opened.Position)</dd>
                <dt>Show caption</dt><dd>@(_opened.ShowCaption ? "yes" : "no")</dd>
                <dt>Order</dt><dd>@_opened.SortOrder.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>For all</dt><dd>@(_opened.ForAll ? "yes" : "no")</dd>
            </dl>
            @if (!string.IsNullOrWhiteSpace(_opened.BodyExcerpt))
            {
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:.85rem 0 0">@_opened.BodyExcerpt</pre>
                @if (_opened.BodyLen > _opened.BodyExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.BodyExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.BodyLen.ToString(CultureInfo.InvariantCulture) chars). Full HTML stays on the Classic twin.</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No body excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="epc-users-hint" style="margin:1rem 0 .4rem">Same position</p>
                <table class="table table-condensed table-striped table-epc">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Caption</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Caption) ? "—" : sib.Caption)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "module_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-position siblings yet.</p>
            }
            <p style="margin:.85rem 0 0;font-size:.86rem;">
                <a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref($"/CP/modules/module?module_id={_opened.Id.ToString(CultureInfo.InvariantCulture)}")">Classic twin editor</a>
            </p>
        </div>
    }
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/modules/modules_manager";
    private bool _isAdmin;
    private long _openedId;
    private IReadOnlyList<CpModuleDigest> _modules = [];
    private CpModuleDetail? _opened;
    private IReadOnlyList<CpModuleDigest> _openedSiblings = [];
    private int _activated;
    private int _frontend;
    private int _limit = 200;
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private string _listHref = "/cp/modules-app";

    private string OpenedCaption =>
        !string.IsNullOrWhiteSpace(_opened?.Caption)
            ? _opened.Caption
            : (_openedId > 0 ? ("Module #" + _openedId.ToString(CultureInfo.InvariantCulture)) : "");

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "module_id");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListCpModulesAsync(_limit, ctx.RequestAborted);
        _modules = result.Modules;
        _activated = _modules.Count(m => m.Activated);
        _frontend = _modules.Count(m => m.IsFrontend);
        _source = result.Source;
        _message = result.Message;
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpModulesDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Module;
            _openedSiblings = detail.Siblings;
        }
    }
}
