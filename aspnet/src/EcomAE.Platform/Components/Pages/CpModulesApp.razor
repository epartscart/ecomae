@page "/cp/modules-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@inject ICpTemplatesPluginsService Modules
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Modules manager · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<style>
    .epc-md-actions .panel_a { display:inline-block; text-align:center; text-decoration:none; color:#333; margin-right:14px; vertical-align:top; }
    .epc-md-actions .panel_a_img { width:48px; height:48px; margin:0 auto 4px; border-radius:8px; background:#f1f3f6; display:flex; align-items:center; justify-content:center; font-size:22px; color:#3498db; }
    .epc-md-actions .panel_a_caption { font-size:12px; }
    .epc-md-list td a { color:inherit; display:block; text-decoration:none; }
    .epc-md-list .pagination { margin:8px 0 0; }
    .epc-md-form .form-group { margin-bottom:10px; }
    .epc-md-form .hr-line-dashed { border-top:1px dashed #e4e5e7; margin:12px 0; }
    .epc-md-form .control-label { text-align:right; padding-top:7px; }
    .epc-md-tree { height:300px; overflow:auto; border:1px solid #e4e5e7; padding:6px; }
    .epc-md-tree label { display:block; font-weight:normal; margin:2px 0; }
    .epc-md-tree.epc-off { opacity:.5; pointer-events:none; }
    .epc-md-content textarea { min-height:220px; font-family:monospace; }
    .epc-md-protos a { display:block; padding:6px 10px; border-bottom:1px solid #eee; }
    .epc-md-pos a { display:inline-block; margin:2px 6px 2px 0; }
</style>

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    @if (!_isAdmin)
    {
        <div class="col-lg-12"><div class="alert alert-warning">Admin CP session required. <a href="/cp/login?returnUrl=/cp/modules-app">Log in</a>.</div></div>
    }
    else if (_editor is not null || _editId > 0 || _prototypeId > 0)
    {
        @* ---- edit_module.php twin (create from prototype / edit) ---- *@
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Control
                    <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_editId > 0 ? "/CP/modules/module?module_id=" + _editId.ToString(CultureInfo.InvariantCulture) : "/CP/modules/module?prototype_id=" + _prototypeId.ToString(CultureInfo.InvariantCulture))">Classic twin</a>
                </div>
                <div class="panel-body epc-md-actions">
                    @if (_editor is not null)
                    {
                        <a class="panel_a" href="javascript:void(0);" onclick="epcSaveModule();"><div class="panel_a_img"><i class="fa fa-save"></i></div><div class="panel_a_caption">Save</div></a>
                    }
                    <a class="panel_a" href="@_listHref"><div class="panel_a_img"><i class="fa fa-cubes"></i></div><div class="panel_a_caption">Modules</div></a>
                    <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div> }

        @if (_editor is null)
        {
            <div class="col-lg-12"><div class="alert alert-danger">@(_editId > 0 ? "Module #" + _editId.ToString(CultureInfo.InvariantCulture) : "Prototype #" + _prototypeId.ToString(CultureInfo.InvariantCulture)) was not found.</div></div>
        }
        else
        {
            var e = _editor;
            <form id="module_form" method="post" action="/cp/modules/write" class="form-horizontal epc-md-form" onsubmit="return epcCollect();">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@(e.Mode == "edit" ? EditHref(e.Id) : _listHref)" />
                <input type="hidden" name="module_save_action" value="@e.Mode" />
                <input type="hidden" name="id" value="@e.Id.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="prototype_id" value="@e.PrototypeId.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="prototype_name_lang_str_id" value="@e.PrototypeNameLangStrId" />
                <input type="hidden" name="caption_lang_str_id" value="@e.CaptionLangStrId" />
                <input type="hidden" name="content_type" value="@e.ContentType" />
                <input type="hidden" name="content_lang_str_id" value="@e.ContentLangStrId" />
                <input type="hidden" name="is_frontend" value="@e.IsFrontend.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="data_value" id="data_value" value="" />
                <input type="hidden" name="content_array" id="content_array" value="" />
                <input type="hidden" name="groups_allowed" id="groups_allowed" value="" />
                <input type="hidden" name="activated" id="activated" value="@(e.Activated ? "1" : "0")" />
                <input type="hidden" name="show_caption" id="show_caption" value="@(e.ShowCaption ? "1" : "0")" />
                <input type="hidden" name="for_all" id="for_all" value="@(e.ForAll ? "1" : "0")" />
                @if (e.ContentType != "text")
                {
                    <input type="hidden" name="content" value="@e.Content" />
                }

                <div class="col-lg-6">
                    <div class="hpanel">
                        <div class="panel-heading hbuilt">Module</div>
                        <div class="panel-body">
                            <div class="form-group">
                                <label for="caption_input" class="col-lg-3 control-label">Caption</label>
                                <div class="col-lg-9"><input type="text" name="caption" id="caption_input" value="@e.Caption" class="form-control" required /></div>
                            </div>
                            <div class="hr-line-dashed col-lg-12"></div>
                            <div class="form-group">
                                <label for="show_caption_checkbox" class="col-lg-3 control-label">Show caption</label>
                                <div class="col-lg-9"><input type="checkbox" id="show_caption_checkbox" data-flag="show_caption" checked="@e.ShowCaption" onchange="epcFlag(this);" /></div>
                            </div>
                            <div class="hr-line-dashed col-lg-12"></div>
                            <div class="form-group">
                                <label for="activated_checkbox" class="col-lg-3 control-label">Activated</label>
                                <div class="col-lg-9"><input type="checkbox" id="activated_checkbox" data-flag="activated" checked="@e.Activated" onchange="epcFlag(this);" /></div>
                            </div>
                            <div class="hr-line-dashed col-lg-12"></div>
                            <div class="form-group">
                                <label for="position_input" class="col-lg-3 control-label">Position</label>
                                <div class="col-lg-9">
                                    <div class="input-group">
                                        <input class="form-control" type="text" name="position" id="position_input" value="@e.Position" />
                                        <span class="input-group-btn"><button onclick="epcTogglePositions();" class="btn btn-success" type="button"><i class="fa fa-upload"></i> <span class="bold">Choose</span></button></span>
                                    </div>
                                    <div id="positions_box" class="epc-md-pos" style="display:none;margin-top:6px">
                                        @if (e.Templates.Count == 0)
                                        {
                                            <span class="text-muted">No templates with module positions.</span>
                                        }
                                        @foreach (var t in e.Templates)
                                        {
                                            <div><strong>@t.Caption</strong>:
                                                @if (t.Positions.Count == 0) { <span class="text-muted">none</span> }
                                                @foreach (var p in t.Positions)
                                                {
                                                    <a href="javascript:void(0);" class="btn btn-xs btn-default" onclick="epcSetPosition('@p.Value');">@p.Caption</a>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="hr-line-dashed col-lg-12"></div>
                            <div class="form-group">
                                <label for="order_input" class="col-lg-3 control-label">Order</label>
                                <div class="col-lg-9"><input type="number" name="order" id="order_input" value="@e.Order.ToString(CultureInfo.InvariantCulture)" class="form-control" /></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="hpanel">
                        <div class="panel-heading hbuilt">Information</div>
                        <div class="panel-body">
                            @if (e.Mode == "edit")
                            {
                                <div class="form-group">
                                    <label class="col-lg-6 control-label">ID</label>
                                    <div class="col-lg-6"><p class="form-control-static">@e.Id.ToString(CultureInfo.InvariantCulture)</p></div>
                                </div>
                                <div class="hr-line-dashed col-lg-12"></div>
                            }
                            <div class="form-group">
                                <label class="col-lg-6 control-label">Prototype</label>
                                <div class="col-lg-6"><p class="form-control-static">@e.PrototypeName</p></div>
                            </div>
                            <div class="hr-line-dashed col-lg-12"></div>
                            <div class="form-group">
                                <label class="col-lg-6 control-label">Content type</label>
                                <div class="col-lg-6"><p class="form-control-static">@e.ContentType</p></div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (e.ContentType == "text")
                {
                    <div class="col-lg-12">
                        <div class="hpanel epc-md-content">
                            <div class="panel-heading hbuilt">Content</div>
                            <div class="panel-body">
                                <textarea class="form-control" name="content" id="content_editor">@e.Content</textarea>
                            </div>
                        </div>
                    </div>
                }

                <div class="col-lg-6">
                    <div class="hpanel">
                        <div class="panel-heading hbuilt">Pages</div>
                        <div class="panel-body">
                            <div class="form-group">
                                <label for="for_all_checkbox" class="col-lg-7 control-label">Show on all pages</label>
                                <div class="col-lg-5"><input type="checkbox" id="for_all_checkbox" data-flag="for_all" checked="@e.ForAll" onchange="epcFlag(this); epcForAll();" /></div>
                            </div>
                            <p>
                                <button onclick="epcCheckTree('content_tree', true);" class="btn btn-success btn-sm" type="button"><i class="fa fa-check-square"></i> <span class="bold">Check all</span></button>
                                <button onclick="epcCheckTree('content_tree', false);" class="btn btn-success btn-sm" type="button"><i class="fa fa-square-o"></i> <span class="bold">Uncheck all</span></button>
                            </p>
                            <div id="content_tree" class="epc-md-tree @(e.ForAll ? "epc-off" : "")"></div>
                        </div>
                    </div>
                </div>

                @if (e.Fields.Count > 0)
                {
                    <div class="col-lg-6">
                        <div class="hpanel">
                            <div class="panel-heading hbuilt">Special settings</div>
                            <div class="panel-body">
                                @for (var i = 0; i < e.Fields.Count; i++)
                                {
                                    var f = e.Fields[i];
                                    if (f.Type == "hidden")
                                    {
                                        <CpDataStructureWidget Field="f" />
                                        continue;
                                    }
                                    if (i > 0) { <div class="hr-line-dashed col-lg-12"></div> }
                                    <div class="form-group">
                                        <label for="@f.Name" class="col-lg-6 control-label">@f.Caption</label>
                                        <div class="col-lg-6"><CpDataStructureWidget Field="f" /></div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <div class="col-lg-6">
                    <div class="hpanel">
                        <div class="panel-heading hbuilt">Access groups</div>
                        <div class="panel-body">
                            <p>
                                <button onclick="epcCheckTree('groups_tree', true);" class="btn btn-success btn-sm" type="button"><i class="fa fa-check-square"></i> <span class="bold">Check all</span></button>
                                <button onclick="epcCheckTree('groups_tree', false);" class="btn btn-success btn-sm" type="button"><i class="fa fa-square-o"></i> <span class="bold">Uncheck all</span></button>
                            </p>
                            <div id="groups_tree" class="epc-md-tree">
                                @if (e.Groups.Count == 0) { <span class="text-muted">No user groups.</span> }
                                @foreach (var g in e.Groups)
                                {
                                    <label style="margin-left:@((Math.Max(0, g.Level - 1) * 16).ToString(CultureInfo.InvariantCulture))px">
                                        <input type="checkbox" class="epc-group" value="@g.Id.ToString(CultureInfo.InvariantCulture)" checked="@e.GroupsAllowed.Contains(g.Id)" /> @g.Caption
                                    </label>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </form>
            <script>
                var siteContent = @((MarkupString)e.ContentTreeJson);
                var boundPages = @((MarkupString)("[" + string.Join(",", e.ContentIds.Select(x => x.ToString(CultureInfo.InvariantCulture))) + "]"));
                (function () {
                    var box = document.getElementById('content_tree');
                    var byParent = {};
                    siteContent.forEach(function (n) { (byParent[n.parent] = byParent[n.parent] || []).push(n); });
                    function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
                    function render(parent, depth) {
                        var html = '';
                        (byParent[parent] || []).forEach(function (n) {
                            var on = boundPages.indexOf(n.id) >= 0 ? ' checked' : '';
                            html += '<label style="margin-left:' + (depth * 16) + 'px"><input type="checkbox" class="epc-page" value="' + n.id + '"' + on + '> ' + esc(n.value) + '</label>';
                            html += render(n.id, depth + 1);
                        });
                        return html;
                    }
                    box.innerHTML = render(0, 0) || '<span class="text-muted">No pages.</span>';
                })();
                function epcFlag(cb) { document.getElementById(cb.getAttribute('data-flag')).value = cb.checked ? '1' : '0'; }
                function epcForAll() {
                    document.getElementById('content_tree').classList.toggle('epc-off', document.getElementById('for_all_checkbox').checked);
                }
                function epcCheckTree(id, on) {
                    document.querySelectorAll('#' + id + ' input[type=checkbox]').forEach(function (c) { c.checked = on; });
                }
                function epcTogglePositions() {
                    var b = document.getElementById('positions_box');
                    b.style.display = b.style.display == 'none' ? 'block' : 'none';
                }
                function epcSetPosition(name) {
                    document.getElementById('position_input').value = name;
                    document.getElementById('positions_box').style.display = 'none';
                }
                function epcCollect() {
                    var pages = [], groups = [], data = {};
                    document.querySelectorAll('#content_tree .epc-page:checked').forEach(function (c) { pages.push(parseInt(c.value, 10)); });
                    document.querySelectorAll('#groups_tree .epc-group:checked').forEach(function (c) { groups.push(parseInt(c.value, 10)); });
                    document.querySelectorAll('#module_form [name^="dv["]').forEach(function (i) { data[i.name.slice(3, -1)] = i.value; });
                    document.getElementById('content_array').value = JSON.stringify(pages);
                    document.getElementById('groups_allowed').value = JSON.stringify(groups);
                    document.getElementById('data_value').value = JSON.stringify(data);
                    return true;
                }
                function epcSaveModule() {
                    var c = document.getElementById('caption_input');
                    if (!c.value.trim()) { alert('Caption is required.'); c.focus(); return; }
                    document.getElementById('module_form').requestSubmit();
                }
            </script>
        }
    }
    else
    {
        @* ---- modules_manager.php twin ---- *@
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Control
                    <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
                </div>
                <div class="panel-body epc-md-actions">
                    <a class="panel_a" href="javascript:void(0);" onclick="epcTogglePrototypes();"><div class="panel_a_img"><i class="fa fa-plus"></i></div><div class="panel_a_caption">Add</div></a>
                    <a class="panel_a" href="javascript:void(0);" onclick="deleteModules(0);"><div class="panel_a_img"><i class="fa fa-trash"></i></div><div class="panel_a_caption">Delete</div></a>
                    <a class="panel_a" href="javascript:void(0);" onclick="activateModules(0, 1);"><div class="panel_a_img"><i class="fa fa-toggle-on"></i></div><div class="panel_a_caption">Activate</div></a>
                    <a class="panel_a" href="javascript:void(0);" onclick="activateModules(0, 0);"><div class="panel_a_img"><i class="fa fa-toggle-off"></i></div><div class="panel_a_caption">Deactivate</div></a>
                    @if (_isFrontend == 1)
                    {
                        <a class="panel_a" href="javascript:void(0);" onclick="epcEditMode('backend');"><div class="panel_a_img"><i class="fa fa-cogs"></i></div><div class="panel_a_caption">Backend editing</div></a>
                    }
                    else
                    {
                        <a class="panel_a" href="javascript:void(0);" onclick="epcEditMode('frontend');"><div class="panel_a_img"><i class="fa fa-desktop"></i></div><div class="panel_a_caption">Frontend editing</div></a>
                    }
                    <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div> }

        <div class="col-lg-12" id="prototypes_panel" style="display:none">
            <div class="hpanel epc-md-protos">
                <div class="panel-heading hbuilt">Choose a module prototype</div>
                <div class="panel-body">
                    @if (_prototypes.Count == 0) { <span class="text-muted">No prototypes available for this mode.</span> }
                    @foreach (var p in _prototypes)
                    {
                        <a href="@(_listHref)?prototype_id=@p.Id.ToString(CultureInfo.InvariantCulture)">@p.Name</a>
                    }
                </div>
            </div>
        </div>

        <form name="modules_manager_action_form" id="modules_manager_action_form" method="post" action="/cp/modules/write" style="display:none">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@PageHref(_list.Page)" />
            <input type="hidden" name="modules_action" value="modules_action" />
            <input type="hidden" name="modules_action_type" id="modules_action_type" value="" />
            <input type="hidden" name="modules_list" id="modules_list" value="" />
            <input type="hidden" name="flag_value" id="flag_value" value="" />
            <input type="hidden" name="is_frontend" value="@_isFrontend.ToString(CultureInfo.InvariantCulture)" />
        </form>
        <form id="edit_mode_form" method="post" action="/cp/control/edit-mode" style="display:none">
            <input type="hidden" name="returnUrl" value="@_listHref" />
            <input type="hidden" name="edit_mode" id="edit_mode" value="" />
        </form>

        <div class="col-lg-12">
            <div class="hpanel epc-md-list">
                <div class="panel-heading hbuilt">@(_isFrontend == 1 ? "Storefront modules" : "Control panel modules")</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped" id="modules_table">
                            <thead>
                                <tr>
                                    <th style="width:30px"><input type="checkbox" id="check_uncheck_all" onchange="on_check_uncheck_all();" /></th>
                                    <th style="width:70px">ID</th>
                                    <th>Caption</th>
                                    <th>Prototype</th>
                                    <th style="width:90px">Type</th>
                                    <th>Position</th>
                                    <th class="text-center" style="width:110px">Activated</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (_list.Items.Count == 0)
                            {
                                <tr><td colspan="7" class="text-muted">No @(_isFrontend == 1 ? "storefront" : "control panel") modules yet. Use Add to create one from a prototype.</td></tr>
                            }
                            @foreach (var m in _list.Items)
                            {
                                var id = m.Id.ToString(CultureInfo.InvariantCulture);
                                <tr>
                                    <td><input type="checkbox" class="epc-row-check" data-id="@id" id="checked_@id" name="checked_@id" onchange="on_one_check_changed('checked_@id');" /></td>
                                    <td><a href="@EditHref(m.Id)">@id</a></td>
                                    <td><a href="@EditHref(m.Id)">@m.Caption</a></td>
                                    <td><a href="@EditHref(m.Id)">@m.PrototypeName</a></td>
                                    <td><a href="@EditHref(m.Id)">@m.ContentType</a></td>
                                    <td><a href="@EditHref(m.Id)">@m.Position</a></td>
                                    <td class="text-center">
                                        @if (m.Activated)
                                        {
                                            <a href="javascript:void(0);" onclick="activateModules(@id, 0);" title="Deactivate" style="display:inline"><i class="fa fa-check text-success"></i></a>
                                        }
                                        else
                                        {
                                            <a href="javascript:void(0);" onclick="activateModules(@id, 1);" title="Activate" style="display:inline"><i class="fa fa-times text-danger"></i></a>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    @if (_list.Pages > 1)
                    {
                        <div class="row">
                            <div class="col-lg-12 text-center">
                                <div class="dataTables_paginate paging_simple_numbers">
                                    <ul class="pagination">
                                        @for (var i = 0; i < _list.Pages; i++)
                                        {
                                            var n = (i + 1).ToString(CultureInfo.InvariantCulture);
                                            if (i == _list.Page)
                                            {
                                                <li class="paginate_button active"><a href="javascript:void(0);">@n</a></li>
                                            }
                                            else
                                            {
                                                <li class="paginate_button"><a href="@PageHref(i)">@n</a></li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <script>
            function epcChecked() {
                var ids = [];
                document.querySelectorAll('#modules_table .epc-row-check:checked').forEach(function (c) { ids.push(parseInt(c.getAttribute('data-id'), 10)); });
                return ids;
            }
            function on_check_uncheck_all() {
                var on = document.getElementById('check_uncheck_all').checked;
                document.querySelectorAll('#modules_table .epc-row-check').forEach(function (c) { c.checked = on; });
            }
            function on_one_check_changed(id) {
                if (!document.getElementById(id).checked) { document.getElementById('check_uncheck_all').checked = false; }
            }
            function epcTogglePrototypes() {
                var p = document.getElementById('prototypes_panel');
                p.style.display = p.style.display == 'none' ? 'block' : 'none';
            }
            function epcSubmit(type, ids, flag) {
                document.getElementById('modules_action_type').value = type;
                document.getElementById('modules_list').value = JSON.stringify(ids);
                document.getElementById('flag_value').value = flag;
                document.getElementById('modules_manager_action_form').submit();
            }
            function activateModules(id, flag) {
                var ids = id > 0 ? [id] : epcChecked();
                if (ids.length == 0) { alert('Select modules first.'); return; }
                epcSubmit('activated', ids, flag);
            }
            function deleteModules(id) {
                var ids = id > 0 ? [id] : epcChecked();
                if (ids.length == 0) { alert('Select modules to delete.'); return; }
                if (!confirm('Delete ' + ids.length + ' module(s)? They are also unbound from all pages.')) { return; }
                epcSubmit('delete', ids, '');
            }
            function epcEditMode(mode) {
                document.getElementById('edit_mode').value = mode;
                document.getElementById('edit_mode_form').submit();
            }
        </script>
    }
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/modules/modules_manager";
    private const string _listHref = "/cp/modules-app";
    private bool _isAdmin;
    private string _flashOk = "";
    private string _flashErr = "";
    private int _isFrontend = 1;
    private long _editId;
    private long _prototypeId;
    private CpPagedList<CpModuleRow> _list = new([], 0, 0, 0);
    private IReadOnlyList<CpModulePrototype> _prototypes = [];
    private CpModuleEditor? _editor;

    private static string EditHref(long id) => _listHref + "?module_id=" + id.ToString(CultureInfo.InvariantCulture);

    private static string PageHref(int page) => page <= 0 ? _listHref : _listHref + "?s_page=" + page.ToString(CultureInfo.InvariantCulture);

    private static long ReadId(HttpRequest request, string key)
        => long.TryParse(request.Query[key].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var id) && id > 0 ? id : 0;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString();
        _flashErr = ctx.Request.Query["err"].ToString();
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        _isFrontend = CpTemplatesPluginsService.ReadIsFrontend(ctx.Request);
        _editId = ReadId(ctx.Request, "module_id");
        _prototypeId = ReadId(ctx.Request, "prototype_id");
        if (_editId > 0 || _prototypeId > 0)
        {
            _editor = await Modules.ModuleEditorAsync(_editId, _prototypeId, _isFrontend, ctx.RequestAborted);
            return;
        }

        _list = await Modules.ModulesAsync(_isFrontend, CpTemplatesPluginsService.ReadPage(ctx.Request), ctx.RequestAborted);
        _prototypes = await Modules.ModulePrototypesAsync(_isFrontend, ctx.RequestAborted);
    }
}
