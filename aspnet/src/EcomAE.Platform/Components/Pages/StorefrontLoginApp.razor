@page "/storefront/login"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@inject NavigationManager Nav

<PageTitle>Customer login · eParts Cart</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" LoginChrome="true" />

<style>
    .epc-asp-login-sf .login_form--page h1 { margin:.2rem 0 .35rem; font-size:1.45rem; }
    .epc-asp-login-sf .login_form--page .lead { color:#64748b; font-size:.92rem; margin-bottom:1rem; }
    .epc-asp-login-sf .epc-login-field { margin:0 0 .75rem; }
    .epc-asp-login-sf .epc-login-field label { display:block; font-size:.82rem; font-weight:600; margin-bottom:.25rem; }
    .epc-asp-login-sf .epc-login-field input, .epc-asp-login-sf .epc-login-field select { width:100%; padding:.55rem .65rem; border:1px solid #d1d5db; border-radius:.4rem; }
    .epc-asp-login-sf .epc-login-submit { width:100%; margin-top:.35rem; padding:.7rem 1rem; border:0; border-radius:.45rem; background:#dc2626; color:#fff; font-weight:700; cursor:pointer; }
    .epc-asp-login-sf .epc-login-error { background:#fef2f2; color:#991b1b; border:1px solid #fecaca; border-radius:.4rem; padding:.55rem .7rem; margin-bottom:.75rem; }
    .epc-asp-login-sf .epc-login-bridge-note { color:#64748b; font-size:.78rem; line-height:1.4; margin:.85rem 0 .35rem; }
    .epc-asp-login-sf .epc-login-php { color:#dc2626; font-weight:700; }
</style>

<div class="epc-asp-login-sf">
    <PhpStorefrontDesktopChrome>
        <div class="row login_form login_form--page">
            <div class="col-md-8 col-md-offset-2">
                <h1>Customer login</h1>
                <p class="lead">Sign in to your parts account to view orders, garage, and saved carts.</p>
                <LegacyAdminLoginForm Surface="LegacyLoginSurface.Storefront" SurfaceLabel="storefront" PhpLoginHref="/php-reference/home" ErrorMessage="@_error" SubmitLabel="Log in" Accent="red" />
            </div>
        </div>
    </PhpStorefrontDesktopChrome>
</div>

@code {
    private string? _error;
    protected override void OnInitialized() => _error = LoginErrorHelper.FromUri(Nav.Uri);
}
