@page "/cp/data-transfer-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@inject ICpDataTransferDeskService Desk
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Data transfer · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Data transfer
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Catalogue export to XML/JSON and catalogue import from XML/JSON, over the own warehouses (<code>interface_type = 1</code>) assigned to your account.</p>
                <ul class="nav nav-tabs" style="margin-bottom:10px">
                    <li class="@(_tab == "export" ? "active" : null)"><a href="/cp/data-transfer-app?tab=export">Catalogue export (XML/JSON)</a></li>
                    <li class="@(_tab == "import" ? "active" : null)"><a href="/cp/data-transfer-app?tab=import">Catalogue import (XML/JSON)</a></li>
                    <li class="@(_tab == "csv" ? "active" : null)"><a href="/cp/data-transfer-app?tab=csv">Catalogue import (CSV)</a></li>
                </ul>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div>
    }
    @if (_downloadFile.Length > 0)
    {
        <div class="col-lg-12">
            <div class="alert alert-info" role="status">
                Generated file:
                <a href="@("/cp/data-transfer/download?file=" + Uri.EscapeDataString(_downloadFile))" target="_blank" rel="noopener">@_downloadFile</a>
            </div>
        </div>
    }

    @if (!_isAdmin)
    {
        <div class="col-lg-12"><div class="alert alert-warning" role="status">Sign in with an admin CP session to transfer catalogue data. <a href="/cp/login?returnUrl=/cp/data-transfer-app">Sign in</a></div></div>
    }
    else if (!_desk.Available)
    {
        <div class="col-lg-12"><div class="alert alert-warning" role="status">@_desk.Message</div></div>
    }
    else if (_tab == "export")
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Export the product catalogue to XML / JSON</div>
                <div class="panel-body">
                    <form method="post" action="/cp/data-transfer/export">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <div class="form-group">
                            <label><input type="checkbox" name="output_products_text" value="1" checked /> Output product text</label><br />
                            <label><input type="checkbox" name="output_products_images" value="1" checked /> Output product images</label><br />
                            <label><input type="checkbox" name="output_products_suggestions" value="1" checked /> Output product suggestions</label>
                        </div>
                        <div class="form-group">
                            <label for="offices">Pickup points</label>
                            <select class="form-control" id="offices" name="offices" multiple size="5">
                                @foreach (var office in _desk.Offices)
                                {
                                    <option value="@office.Id">@office.Caption</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="groups">Customer group (prices)</label>
                            <select class="form-control" id="groups" name="group_id">
                                @foreach (var group in _desk.Groups)
                                {
                                    <option value="@group.Id">@group.Caption</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="output_format">Output format</label>
                            <select class="form-control" id="output_format" name="output_format">
                                <option value="xml">XML</option>
                                <option value="json">JSON</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary"><i class="fa fa-download"></i> Export</button>
                        <a class="btn btn-default" href="/cp"><i class="fa fa-home"></i> Control panel</a>
                    </form>
                </div>
            </div>
        </div>
    }
    else if (_tab == "import")
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Import a product catalogue from XML / JSON</div>
                <div class="panel-body">
                    @if (_desk.Storages.Count == 0)
                    {
                        <p class="text-muted" style="margin:0">No own warehouse is assigned to your account, so imports are disabled.</p>
                    }
                    else
                    {
                        <form method="post" action="/cp/data-transfer/import" enctype="multipart/form-data">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <div class="form-group">
                                <label for="file">XML / JSON file</label>
                                <input type="file" id="file" name="file" accept=".xml,.json" required />
                            </div>
                            <div class="form-group">
                                <label for="storages">Warehouse</label>
                                <select class="form-control" id="storages" name="storages" required>
                                    @foreach (var storage in _desk.Storages)
                                    {
                                        <option value="@storage.Id">@storage.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label><input type="radio" name="clear_table" value="0" checked /> Do not clear anything</label><br />
                                <label><input type="radio" name="clear_table" value="1" /> Clear this warehouse's stock rows first</label><br />
                                <label><input type="radio" name="clear_table" value="2" /> Clear the whole product catalogue first</label>
                            </div>
                            <div class="form-group">
                                <label><input type="checkbox" name="confirmClearCatalogue" value="1" /> I confirm clearing the whole catalogue (needed for the last option)</label>
                            </div>
                            <button type="submit" class="btn btn-primary"><i class="fa fa-upload"></i> Import</button>
                            <a class="btn btn-default" href="/cp"><i class="fa fa-home"></i> Control panel</a>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Import products into a category from CSV</div>
                <div class="panel-body">
                    <p>Pick the end category, map every CSV column number (1-based, <code>0</code> = column not used), then upload the file. Products are written into the chosen own warehouse.</p>
                    <form method="get" action="/cp/data-transfer-app" class="form-inline" style="margin-bottom:12px">
                        <input type="hidden" name="tab" value="csv" />
                        <label for="category_id">Category&nbsp;</label>
                        <select class="form-control" id="category_id" name="category_id">
                            <option value="0">— select an end category —</option>
                            @foreach (var category in _desk.Categories.Where(c => c.Leaf))
                            {
                                <option value="@category.Id" selected="@(category.Id == _categoryId)">@(new string('·', Math.Max(0, category.Level)) + " " + category.Caption)</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-default">Load properties</button>
                    </form>

                    @if (_category is null)
                    {
                        <p class="text-muted" style="margin:0">Categories that still have sub-categories cannot hold products, so only end categories are listed.</p>
                    }
                    else if (_desk.Storages.Count == 0)
                    {
                        <p class="text-muted" style="margin:0">No own warehouse is assigned to your account, so CSV import is disabled.</p>
                    }
                    else
                    {
                        <form method="post" action="/cp/data-transfer/csv-import" enctype="multipart/form-data">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="category_id" value="@_category.Id" />
                            <table class="table table-condensed table-striped">
                                <thead>
                                    <tr><th style="width:45%">Field</th><th style="width:25%">CSV column</th><th>URL</th></tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Name</td>
                                        <td><input class="form-control" type="number" min="1" name="col_name" value="1" required /></td>
                                        <td><input type="checkbox" name="col_name_url_check" value="1" checked /></td>
                                    </tr>
                                    <tr>
                                        <td>Description</td>
                                        <td><input class="form-control" type="number" min="0" name="col_text" value="0" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Image</td>
                                        <td><input class="form-control" type="number" min="0" name="col_img" value="0" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Price</td>
                                        <td><input class="form-control" type="number" min="1" name="col_price" value="2" required /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Quantity</td>
                                        <td><input class="form-control" type="number" min="1" name="col_exist" value="3" required /></td>
                                        <td></td>
                                    </tr>
                                    @foreach (var property in _category.Properties)
                                    {
                                        <tr>
                                            <td>@property.Caption</td>
                                            <td><input class="form-control" type="number" min="0" name="@("col_" + property.Id.ToString(CultureInfo.InvariantCulture))" value="0" /></td>
                                            <td><input type="checkbox" name="@("col_" + property.Id.ToString(CultureInfo.InvariantCulture) + "_url_check")" value="1" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="form-group">
                                <label for="strings_to_left">Skip rows at the top of the file</label>
                                <input class="form-control" type="number" min="0" id="strings_to_left" name="strings_to_left" value="0" />
                            </div>
                            <div class="form-group">
                                <label for="csv_storages">Warehouse</label>
                                <select class="form-control" id="csv_storages" name="storages" required>
                                    @foreach (var storage in _desk.Storages)
                                    {
                                        <option value="@storage.Id">@storage.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="encoding">File encoding</label>
                                <select class="form-control" id="encoding" name="encoding">
                                    <option value="windows-1251">Windows-1251 (ANSI)</option>
                                    <option value="UTF-8" selected>UTF-8</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label><input type="checkbox" name="delete_storage_data" value="1" /> Delete this warehouse's rows for the category first</label><br />
                                <label><input type="checkbox" name="delete_products_data" value="1" /> Delete the category's products first</label><br />
                                <label><input type="checkbox" name="confirmDeleteProducts" value="1" /> I confirm deleting the category's products (needed for the option above)</label>
                            </div>
                            <div class="form-group">
                                <label for="csv_file">CSV file</label>
                                <input type="file" id="csv_file" name="csv_file" accept=".csv,.txt" required />
                            </div>
                            <button type="submit" class="btn btn-primary"><i class="fa fa-upload"></i> Import CSV</button>
                            <a class="btn btn-default" href="/cp"><i class="fa fa-home"></i> Control panel</a>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/data_transfer";
    private bool _isAdmin;
    private string _tab = "export";
    private string _flashOk = "";
    private string _flashErr = "";
    private string _downloadFile = "";
    private long _categoryId;
    private CpDataTransferCategory? _category;
    private CpDataTransferDesk _desk = CpDataTransferDesk.Unavailable("");

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _downloadFile = ctx.Request.Query["file"].ToString() ?? "";
        var tab = ctx.Request.Query["tab"].ToString();
        if (tab is "import" or "csv" or "export")
        {
            _tab = tab;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        _desk = await Desk.LoadAsync(session.UserId, ctx.RequestAborted);

        if (long.TryParse(ctx.Request.Query["category_id"].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var categoryId) && categoryId > 0)
        {
            _categoryId = categoryId;
            _category = _desk.Categories.FirstOrDefault(c => c.Id == categoryId && c.Leaf);
        }
    }
}
