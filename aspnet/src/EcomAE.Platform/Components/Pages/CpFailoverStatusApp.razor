@page "/cp/failover-status-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Failover status · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
@if (_allowed)
{
<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Failover status
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/failover-status-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/failover-status-app" IsAdmin="_isAdmin" />

    <p class="help-block">@_summary.ModeFilePresent.ToString(CultureInfo.InvariantCulture) Mode file · @_summary.StatusJsonPresent.ToString(CultureInfo.InvariantCulture) Status JSON · @_summary.ConfigPresent.ToString(CultureInfo.InvariantCulture) Config · @_summary.BackupMode.ToString(CultureInfo.InvariantCulture) Backup mode.</p>
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead><tr><th>Path</th><th>Present</th><th>Kind</th><th></th></tr></thead>
        <tbody>
        @if (_rows.Count==0) { <tr><td colspan="4">No records yet.</td></tr> }
        else { @foreach (var row in _rows) { <tr><td>@row.Path</td><td>@row.Present</td><td>@row.Kind</td><td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td></tr> } }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>Failover status is available on the platform Super CP host only.</p>
        <p><a href="/cp">Open Control Panel</a></p>
    </div>
}
@code {
    private const string _phpTab = "/CP/control/portal/epc_platform_failover_guide";
    private bool _allowed;
    private bool _isAdmin;
    private CpFailoverStatusSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpFailoverStatusRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpFailoverStatusDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Signals;
        _source = result.Source;
        _message = result.Message;
    }
}
