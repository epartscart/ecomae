@page "/cp/crm-activities-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>CRM activities · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-w15-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0f172a 0%,#1e3a5f 50%,#0ea5e9 100%);
        }
        .epc-w15-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-w15-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-w15-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-w15-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f172a; background:#fff;
        }
        .epc-w15-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-w15-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-w15-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-w15-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-w15-kpi span { color:#64748b; font-size:.78rem; }
        .epc-w15-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-w15-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-w15-table th, .epc-w15-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-w15-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-w15-note { margin-top:1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:.45rem; color:#334155; font-size:.86rem; }
        @@media (max-width:900px){ .epc-w15-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-w15-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>CRM activities</h1>
        <p>Read-only CRM activities KPIs + rows from <code>/cp/crm-activities</code>. Notes stay on live PHP.</p>
        <div class="epc-w15-cta">
            <a href="@_phpTab">Open PHP</a>
            <a class="ghost" href="@PhpModuleCatalog.HybridWorkspaceHref("/cp/app", _phpTab)">Hybrid workspace</a>
            <a class="ghost" href="/cp/app">Command centre</a>
        </div>
    </section>

    <div class="epc-w15-kpis" aria-label="CRM activities stats">
        <div class="epc-w15-kpi"><strong>@_summary.ActivityCount.ToString(CultureInfo.InvariantCulture)</strong><span>Activities</span></div>
        <div class="epc-w15-kpi"><strong>@_summary.OpenCount.ToString(CultureInfo.InvariantCulture)</strong><span>Open</span></div>
        <div class="epc-w15-kpi"><strong>@_summary.OverdueCount.ToString(CultureInfo.InvariantCulture)</strong><span>Overdue</span></div>
        <div class="epc-w15-kpi"><strong>@_summary.DoneCount.ToString(CultureInfo.InvariantCulture)</strong><span>Done</span></div>
    </div>

    <div class="epc-w15-table-wrap">
    <table class="epc-w15-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Type</th>
                    <th>Related</th>
                    <th>Related id</th>
                    <th>Due</th>
                    <th>Done</th>
                    <th>Owner</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="8">No rows in digest (@_source). @_message</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ActivityType) ? row.ActivityType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.RelatedType) ? row.RelatedType : "—")</td>
                            <td>@row.RelatedId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.DueDate.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.Done.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.OwnerUserId.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@_phpTab">Open in PHP</a></td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>

    <div class="epc-w15-note">
        Read-only preview · JSON digest <a href="/cp/crm-activities?limit=200">/cp/crm-activities</a>. PHP CRM activities remain authoritative · Not a broad /cp cutover · tenant product chrome stays PHP.
        Source: <code>@_source</code>. Tables: <code>epc_crm_activities</code>.
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/crm/crm_main?tab=activities";
    private bool _isAdmin;
    private CpCrmActivitiesSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpCrmActivitiesActivityDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpCrmActivitiesDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Activities;
        _source = result.Source;
        _message = result.Message;
    }
}
