@page "/cp/crm-activities-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>CRM activities · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                CRM activities
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Mark an activity done or reopen it here. Create stays Classic. This page does not invent a send.</p>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div>
    }
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/crm-activities-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedActivity is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="CRM activity KPIs">
        <div class="kpi"><div class="lbl">Activities</div><div class="val">@_summary.ActivityCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open</div><div class="val">@_summary.OpenCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Overdue</div><div class="val">@_summary.OverdueCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Related siblings</div><div class="val">@_openedSiblings.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedActivity is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedActivity.ActivityType) ? _openedActivity.ActivityType : ("Activity #" + _openedActivity.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(_openedActivity.Done != 0 ? "done" : "open")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedActivity.RelatedType) ? _openedActivity.RelatedType : "—")
                        · related @_openedActivity.RelatedId.ToString(CultureInfo.InvariantCulture)
                        · owner @_openedActivity.OwnerUserId.ToString(CultureInfo.InvariantCulture)
                        · @(_openedActivity.Active != 0 ? "active" : "inactive")</p>
                    <p>Due @_openedActivity.DueDate.ToString(CultureInfo.InvariantCulture)
                        · created @_openedActivity.TimeCreated.ToString(CultureInfo.InvariantCulture)
                        · updated @_openedActivity.TimeUpdated.ToString(CultureInfo.InvariantCulture)</p>
                    @if (!string.IsNullOrWhiteSpace(_openedActivity.NotesExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedActivity.NotesExcerpt</pre>
                        @if (_openedActivity.NotesLen > _openedActivity.NotesExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_openedActivity.NotesExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedActivity.NotesLen.ToString(CultureInfo.InvariantCulture) chars). Full notes stay on the Classic twin.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No notes excerpt yet.</p>
                    }
                    @if (_isAdmin)
                    {
                        <form method="post" action="/cp/crm/activities/write" style="margin:1rem 0 0">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@ErpRecordOpen.Href(_listHref, "activity_id", _openedActivity.Id)" />
                            <input type="hidden" name="action" value="toggle_activity" />
                            <input type="hidden" name="id" value="@_openedActivity.Id.ToString(CultureInfo.InvariantCulture)" />
                            @if (_openedActivity.Done != 0)
                            {
                                <input type="hidden" name="done" value="0" />
                                <button type="submit" class="btn btn-default btn-sm">Reopen</button>
                            }
                            else
                            {
                                <input type="hidden" name="done" value="1" />
                                <button type="submit" class="btn btn-primary btn-sm">Mark done</button>
                            }
                        </form>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Related siblings</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Type</th>
                                    <th>Related</th>
                                    <th>Due</th>
                                    <th>Done</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="5">No related siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.ActivityType) ? sib.ActivityType : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.RelatedType) ? sib.RelatedType : "—") #@sib.RelatedId.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@sib.DueDate.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@sib.Done.ToString(CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Activities</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Type</th>
                                <th>Related</th>
                                <th>Related id</th>
                                <th>Due</th>
                                <th>Done</th>
                                <th>Owner</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!_isAdmin)
                        {
                            <tr><td colspan="8">Sign in for live data.</td></tr>
                        }
                        else if (_rows.Count == 0)
                        {
                            <tr><td colspan="8">@(!string.IsNullOrWhiteSpace(_message) ? _message : "No records yet.")</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.ActivityType) ? row.ActivityType : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.RelatedType) ? row.RelatedType : "—")</td>
                                    <td>@row.RelatedId.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.DueDate.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.Done.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.OwnerUserId.ToString(CultureInfo.InvariantCulture)</td>
                                    <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "activity_id", row.Id)">Open</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/crm/crm_main?tab=activities";
    private const string _listHref = "/cp/crm-activities-app";
    private bool _isAdmin;
    private CpCrmActivitiesSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpCrmActivitiesActivityDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private CpCrmActivitiesDetail? _openedActivity;
    private IReadOnlyList<CpCrmActivitiesActivityDigest> _openedSiblings = [];

    private string OpenedCaption => _openedActivity is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedActivity.ActivityType)
            ? ("Activity #" + _openedActivity.Id.ToString(CultureInfo.InvariantCulture))
            : _openedActivity.ActivityType)
            + (_openedActivity.Done != 0 ? " · done" : " · open");

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "activity_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpCrmActivitiesDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Activities;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpCrmActivitiesDetailAsync(_openedId, ctx.RequestAborted);
            _openedActivity = detail.Activity;
            _openedSiblings = detail.Siblings;
            if (_openedActivity is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
