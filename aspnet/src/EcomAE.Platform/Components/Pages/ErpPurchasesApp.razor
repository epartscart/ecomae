@page "/erp/purchases-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Components.Shared.Desktop
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@using EcomAE.Platform.Erp
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav
@inject IErpDimensionLinkReadService DimensionLinks

<PageTitle>Purchases · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Purchases" BreadcrumbArea="Procure to Pay" BreadcrumbTab="Purchases">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/purchases-app" IsAdmin="_isAdmin" />


    
    <PhpErpModulePageHeader Title="Purchases" Subtitle="Purchase invoices (PI) after LPO and PO. Official tax-invoice print preview opens once the bill is posted." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" EntryHref="/erp/purchases-app?view=entry" EntryLabel="New supplier bill" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="/erp/purchases-app" />

    @if (_entry && _isAdmin)
    {
        <div class="epc-d365-entry">
            <div class="epc-d365-entry-head">
                <span>Supplier bill entry</span>
                <a class="btn btn-xs btn-default" href="/erp/purchases-app">Back to list</a>
            </div>
            <div class="epc-d365-entry-body">
                <p class="text-muted" style="margin:0">Supplier bills are created from purchase orders and LPOs. Open a posted bill to amend, void, settle, or print it.</p>
            </div>
        </div>
    }
    else
    {
    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Purchase KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_purchases.Count</div></div>
        <div class="kpi"><div class="lbl">Non-closed in page</div><div class="val">@_open</div></div>
        <div class="kpi"><div class="lbl">Page total amount</div><div class="val">@_totalAmount.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_bySupplier.Count > 0 || _byItem.Count > 0)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div>
            <p style="margin:0 0 .4rem"><strong>Purchases by supplier</strong> <span class="text-muted">(top 10)</span></p>
            <table class="table table-bordered table-condensed table-epc epc-erp-table">
                <thead><tr><th>Supplier</th><th class="text-right">Bills</th><th class="text-right">Paid</th><th class="text-right">Open</th><th class="text-right">Bill value</th><th class="text-right">Due</th></tr></thead>
                <tbody>
                    @foreach (var s in _bySupplier)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(s.SupplierName) ? ("#" + s.SupplierId.ToString(CultureInfo.InvariantCulture)) : s.SupplierName)</td>
                            <td class="text-right">@s.Bills</td>
                            <td class="text-right">@s.Settled</td>
                            <td class="text-right">@s.Open</td>
                            <td class="text-right">@s.Total.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@s.Due.ToString("N2", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            <div>
            <p style="margin:0 0 .4rem"><strong>Purchases by item</strong> <span class="text-muted">(top 10)</span></p>
            <table class="table table-bordered table-condensed table-epc epc-erp-table">
                <thead><tr><th>Item</th><th class="text-right">Qty bought</th><th class="text-right">Bill lines</th><th class="text-right">Value</th></tr></thead>
                <tbody>
                    @foreach (var r in _byItem)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(r.ItemCode) ? "—" : r.ItemCode)</td>
                            <td class="text-right">@r.Qty.ToString("N3", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@r.Lines</td>
                            <td class="text-right">@r.Total.ToString("N2", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            </div>
        </div>
    }

    @if (_openedDetail is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="/erp/purchases-app">Close</a>
                <a class="btn btn-xs btn-default" href="/erp/purchase-print?id=@_openedDetail.Id" target="_blank" rel="noopener">Print PI</a>
                @if (_openedDetail.OrderId > 0)
                {
                    <a class="btn btn-xs btn-default" href="/erp/lpo-print?id=@_openedDetail.OrderId.ToString(CultureInfo.InvariantCulture)" target="_blank" rel="noopener">Print LPO</a>
                }
            </p>
            <div class="epc-erp-fact-row">
            <dl class="epc-erp-facts">
                <dt>Purchase id</dt><dd>@_openedDetail.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Invoice #</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.InvoiceNumber) ? "—" : _openedDetail.InvoiceNumber)</dd>
                <dt>Supplier</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.SupplierName) ? ("#" + _openedDetail.SupplierId.ToString(CultureInfo.InvariantCulture)) : _openedDetail.SupplierName)</dd>
                <dt>Date</dt><dd>@FormatTime(_openedDetail.PurchaseDate)</dd>
                <dt>Ex VAT</dt><dd>@_openedDetail.AmountExVat.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>VAT</dt><dd>@_openedDetail.VatAmount.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Total</dt><dd>@_openedDetail.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.Status) ? "—" : _openedDetail.Status)</dd>
                <dt>Order</dt><dd>@(_openedDetail.OrderId > 0 ? _openedDetail.OrderId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Storage</dt><dd>@(_openedDetail.StorageId > 0 ? _openedDetail.StorageId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Admin</dt><dd>@(_openedDetail.AdminId > 0 ? _openedDetail.AdminId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Created</dt><dd>@FormatTime(_openedDetail.TimeCreated)</dd>
            </dl>
            @if (_isAdmin && _openedDetail.Id > 0)
            {
                <div class="epc-erp-action-pane" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;padding:.65rem;border:1px solid #c5d4de;background:#fff">
                    <strong style="width:100%">Supplier bill actions</strong>
                    <form method="post" action="@EcomAeRoutes.ErpPurchasesAmend" style="display:flex;flex-wrap:wrap;gap:.35rem;align-items:end">
                        <input type="hidden" name="purchaseId" value="@_openedDetail.Id" />
                        <label>Invoice # <input class="form-control input-sm" type="text" name="invoiceNumber" maxlength="64" value="@_openedDetail.InvoiceNumber" /></label>
                        <label>Ex VAT <input class="form-control input-sm" type="number" name="amountExVat" min="0" step="0.01" value="@_openedDetail.AmountExVat.ToString("0.00", CultureInfo.InvariantCulture)" /></label>
                        <label>Note <input class="form-control input-sm" type="text" name="note" maxlength="255" /></label>
                        <button type="submit" name="confirmWrites" value="false" class="btn btn-default btn-xs">Validate edit</button>
                        <button type="submit" name="confirmWrites" value="true" class="btn btn-primary btn-xs">Save edit</button>
                    </form>
                    @if (string.Equals(_openedDetail.Status, "draft", StringComparison.OrdinalIgnoreCase))
                    {
                        <form method="post" action="@EcomAeRoutes.ErpPurchasesDelete">
                            <input type="hidden" name="purchaseId" value="@_openedDetail.Id" />
                            <button type="submit" name="confirmWrites" value="false" class="btn btn-default btn-xs">Validate delete</button>
                            <button type="submit" name="confirmWrites" value="true" class="btn btn-danger btn-xs">Delete draft</button>
                        </form>
                    }
                    @if (!string.Equals(_openedDetail.Status, "voided", StringComparison.OrdinalIgnoreCase)
                        && !string.Equals(_openedDetail.Status, "cancelled", StringComparison.OrdinalIgnoreCase))
                    {
                        <form method="post" action="@EcomAeRoutes.ErpPurchasesVoid" style="display:flex;gap:.35rem;align-items:end">
                            <input type="hidden" name="purchaseId" value="@_openedDetail.Id" />
                            <input class="form-control input-sm" type="text" name="reason" maxlength="255" placeholder="Void reason" />
                            <button type="submit" name="confirmWrites" value="false" class="btn btn-default btn-xs">Validate void</button>
                            <button type="submit" name="confirmWrites" value="true" class="btn btn-warning btn-xs">Void bill</button>
                        </form>
                    }
                    @if (_openedDetail.SupplierId > 0
                        && !string.Equals(_openedDetail.Status, "voided", StringComparison.OrdinalIgnoreCase)
                        && !string.Equals(_openedDetail.Status, "cancelled", StringComparison.OrdinalIgnoreCase))
                    {
                        <form method="post" action="@EcomAeRoutes.ErpSupplierSettlement" style="display:flex;flex-wrap:wrap;gap:.35rem;align-items:end">
                            <input type="hidden" name="supplier_id" value="@_openedDetail.SupplierId" />
                            <input type="hidden" name="purchase_id" value="@_openedDetail.Id" />
                            <input type="hidden" name="direction" value="decrease" />
                            <input type="hidden" name="entry_kind" value="settlement" />
                            <label>Settlement amount <input class="form-control input-sm" type="number" name="amount" min="0" step="0.01" value="@_openedDetail.TotalAmount.ToString("0.00", CultureInfo.InvariantCulture)" /></label>
                            <label>Reference <input class="form-control input-sm" type="text" name="reference" maxlength="120" value="@_openedDetail.InvoiceNumber" /></label>
                            <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
                            <button type="submit" name="confirmWrites" value="false" class="btn btn-default btn-xs">Validate settlement</button>
                            <button type="submit" name="confirmWrites" value="true" class="btn btn-success btn-xs">Settle bill</button>
                        </form>
                    }
                </div>
            }
            </div>
            <ErpDimensionLinksPanel Links="_openedDimensionLinks" />
            @if (!string.IsNullOrWhiteSpace(_openedDetail.NoteExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">note excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedDetail.NoteExcerpt</pre>
                @if (_openedDetail.NoteLen > _openedDetail.NoteExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_openedDetail.NoteExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedDetail.NoteLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No note excerpt yet.</p>
            }
            <ErpDocumentReadbacks Lines="_openedLines" Attachments="_openedAttachments" AuditTrail="_openedAuditTrail" />
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Invoice #</th><th>Supplier</th><th class="text-right">Total</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.InvoiceNumber) ? "—" : sib.InvoiceNumber)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.SupplierName) ? ("#" + sib.SupplierId.ToString(CultureInfo.InvariantCulture)) : sib.SupplierName)</td>
                                <td class="text-right">@sib.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href("/erp/purchases-app", "purchase_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    @if (_apAgingTotal > 0)
    {
        <div class="epc-erp-kpi epc-erp-stat-row" aria-label="AP aging">
            <div class="kpi"><div class="lbl">AP open</div><div class="val">@_apAgingTotal.ToString("N2", CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">0–30 days</div><div class="val">@_apAging0To30.ToString("N2", CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">31–60 days</div><div class="val">@_apAging31To60.ToString("N2", CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">61–90 days</div><div class="val">@_apAging61To90.ToString("N2", CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">90+ days</div><div class="val">@_apAging90Plus.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Date</th>
                    <th>Supplier</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Paid</th>
                    <th>Due</th>
                    <th>PO / Order</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_purchases.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var p in _purchases)
                    {
                        <tr id="erp-row-@p.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(p.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(p.InvoiceNumber) ? $"#{p.Id}" : p.InvoiceNumber)</strong></td>
                            <td>@FormatTime(p.PurchaseDate)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.SupplierName) ? $"#{p.SupplierId}" : p.SupplierName)</td>
                            <td><span class="label label-default">@p.Status</span></td>
                            <td>@p.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@p.PaidAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@p.AmountDue.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(p.OrderId > 0 ? p.OrderId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>
                                <a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href("/erp/purchases-app", "purchase_id", p.Id)">Open</a>
                                <a class="btn btn-xs btn-default" href="/erp/purchase-print?id=@p.Id.ToString(CultureInfo.InvariantCulture)" target="_blank" rel="noopener">@(ErpPurchaseDocumentPrint.IsOfficialPi(p.Status) ? "Print" : "Preview")</a>
                            </td>
                        </tr>
                        @if (p.Lines.Count > 0)
                        {
                            <tr class="epc-erp-doc-lines">
                                <td colspan="9">
                                    <table class="table table-condensed table-bordered" style="margin-bottom:0">
                                        <thead>
                                            <tr>
                                                <th style="width:18%">Item / SKU</th>
                                                <th>Description</th>
                                                <th style="width:12%" class="text-right">Qty</th>
                                                <th style="width:14%" class="text-right">Unit cost</th>
                                                <th style="width:14%" class="text-right">Line total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var line in p.Lines)
                                            {
                                                <tr>
                                                    <td>@(string.IsNullOrWhiteSpace(line.ItemCode) ? "—" : line.ItemCode)</td>
                                                    <td>@line.Description</td>
                                                    <td class="text-right">@line.Qty.ToString("N3", CultureInfo.InvariantCulture)</td>
                                                    <td class="text-right">@line.UnitPriceExVat.ToString("N4", CultureInfo.InvariantCulture)</td>
                                                    <td class="text-right">@line.LineExVat.ToString("N2", CultureInfo.InvariantCulture)</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="4" class="text-right"><strong>Lines total (ex VAT)</strong></td>
                                                <td class="text-right">@p.Lines.Sum(l => l.LineExVat).ToString("N2", CultureInfo.InvariantCulture)</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                    <tr style="font-weight:600;background:#f2f6fa">
                        <td>Total</td>
                        <td colspan="3"></td>
                        <td>@_purchases.Sum(p => p.TotalAmount).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td>@_purchases.Sum(p => p.PaidAmount).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td>@_purchases.Sum(p => p.AmountDue).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td></td>
                        <td class="text-muted">@_purchases.Count bills</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=purchasing&tab=purchases";
    private bool _isAdmin;
    private IReadOnlyList<ErpPurchaseDigest> _purchases = [];
    private int _open;
    private decimal _totalAmount;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private IReadOnlyList<ErpDimensionLink> _openedDimensionLinks = [];
    private ErpPurchaseDigest? _openedPurchase;
    private ErpPurchaseDetail? _openedDetail;
    private IReadOnlyList<ErpPurchaseDigest> _openedSiblings = [];
    private decimal _apAgingTotal;
    private decimal _apAging0To30;
    private decimal _apAging31To60;
    private decimal _apAging61To90;
    private decimal _apAging90Plus;
    private IReadOnlyList<BillSupplierRow> _bySupplier = [];
    private IReadOnlyList<BillItemRow> _byItem = [];
    private IReadOnlyList<ErpAuditTrailRow> _openedAuditTrail = [];
    private IReadOnlyList<ErpDocumentAttachmentRow> _openedAttachments = [];
    private IReadOnlyList<ErpDocumentLineDigest> _openedLines = [];

    private bool _entry => string.Equals(Http.HttpContext?.Request.Query["view"].ToString(), "entry", StringComparison.OrdinalIgnoreCase);

    private bool OpenedFound => _openedDetail is not null || _openedPurchase is not null;

    private string OpenedReturnHref => _openedId > 0
        ? "/erp/purchases-app?purchase_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : "/erp/purchases-app";

    private string OpenedCaption => _openedDetail is not null
        ? (string.IsNullOrWhiteSpace(_openedDetail.InvoiceNumber) ? ("Purchase #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.InvoiceNumber)
            + (string.IsNullOrWhiteSpace(_openedDetail.SupplierName) ? "" : (" · " + _openedDetail.SupplierName))
        : _openedPurchase is null
            ? ""
            : (string.IsNullOrWhiteSpace(_openedPurchase.InvoiceNumber) ? $"Purchase #{_openedPurchase.Id}" : _openedPurchase.InvoiceNumber) + " · " + _openedPurchase.Status;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "purchase_id");
        var result = await Dashboards.ListErpPurchasesAsync(_limit, ctx.RequestAborted);
        _purchases = result.Purchases;
        _openedPurchase = _openedId > 0 ? _purchases.FirstOrDefault(p => p.Id == _openedId) : null;
        if (_openedPurchase is not null)
        {
            _purchases = new[] { _openedPurchase }.Concat(_purchases.Where(p => p.Id != _openedId)).ToList();
        }
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpPurchaseDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Purchase;
            _openedSiblings = detail.Siblings;
            _openedAuditTrail = detail.AuditTrail;
            _openedAttachments = detail.Attachments;
            _openedLines = detail.Lines;
            if (_openedDetail is null && !string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
            _openedDimensionLinks = await DimensionLinks.LoadAsync(
                "purchase",
                _openedId,
                ctx.RequestAborted);
        }
        var nowUnixAp = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var openAp = _purchases.Where(p => p.AmountDue > 0.005m
            && !string.Equals(p.Status, "voided", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(p.Status, "cancelled", StringComparison.OrdinalIgnoreCase)).ToList();
        _apAging0To30 = openAp.Where(p => nowUnixAp - p.PurchaseDate <= 30L * 86400).Sum(p => p.AmountDue);
        _apAging31To60 = openAp.Where(p => nowUnixAp - p.PurchaseDate > 30L * 86400 && nowUnixAp - p.PurchaseDate <= 60L * 86400).Sum(p => p.AmountDue);
        _apAging61To90 = openAp.Where(p => nowUnixAp - p.PurchaseDate > 60L * 86400 && nowUnixAp - p.PurchaseDate <= 90L * 86400).Sum(p => p.AmountDue);
        _apAging90Plus = openAp.Where(p => nowUnixAp - p.PurchaseDate > 90L * 86400).Sum(p => p.AmountDue);
        _apAgingTotal = _apAging0To30 + _apAging31To60 + _apAging61To90 + _apAging90Plus;

        _bySupplier = _purchases
            .GroupBy(p => (p.SupplierId, p.SupplierName))
            .Select(g => new BillSupplierRow(
                g.Key.SupplierId,
                g.Key.SupplierName,
                g.Count(),
                g.Count(p => p.AmountDue <= 0.005m),
                g.Count(p => p.AmountDue > 0.005m),
                g.Sum(p => p.TotalAmount),
                g.Sum(p => p.AmountDue)))
            .OrderByDescending(s => s.Total)
            .Take(10)
            .ToList();
        _byItem = _purchases
            .SelectMany(p => p.Lines)
            .GroupBy(l => l.ItemCode)
            .Select(g => new BillItemRow(g.Key, g.Sum(l => l.Qty), g.Count(), g.Sum(l => l.LineExVat)))
            .OrderByDescending(r => r.Total)
            .Take(10)
            .ToList();

        _open = _purchases.Count(p => !string.Equals(p.Status, "closed", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(p.Status, "cancelled", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(p.Status, "canceled", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(p.Status, "posted", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(p.Status, "paid", StringComparison.OrdinalIgnoreCase));
        _totalAmount = _purchases.Sum(p => p.TotalAmount);
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    private sealed record BillSupplierRow(long SupplierId, string SupplierName, int Bills, int Settled, int Open, decimal Total, decimal Due);

    private sealed record BillItemRow(string ItemCode, decimal Qty, int Lines, decimal Total);
}
