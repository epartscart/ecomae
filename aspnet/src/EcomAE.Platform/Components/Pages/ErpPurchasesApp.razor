@page "/erp/purchases-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Purchases · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<HeadContent>
<style>
        .epc-pur-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#1d4ed8 45%,#2563eb 100%);
        }
        .epc-pur-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-pur-hero p { margin:0; color:#d9f99d; max-width:42rem; font-size:.92rem; line-height:1.45; }
        .epc-pur-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-pur-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#fff; background:#2563eb;
        }
        .epc-pur-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); }
        .epc-pur-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-pur-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-pur-kpi strong { display:block; font-size:1.45rem; font-variant-numeric:tabular-nums; }
        .epc-pur-kpi span { color:#64748b; font-size:.78rem; }
        .epc-pur-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-pur-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-pur-table th, .epc-pur-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-pur-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-pur-table a { color:#4d7c0f; font-weight:700; text-decoration:none; }
        .epc-pur-badge { display:inline-flex; padding:.15rem .45rem; border-radius:.3rem; font-size:.72rem; font-weight:700; background:#ecfccb; color:#3f6212; }
        .epc-pur-note { margin-top:1rem; padding:.75rem .9rem; background:#f7fee7; border:1px solid #bef264; border-radius:.45rem; color:#365314; font-size:.86rem; }
        @@media (max-width:900px){ .epc-pur-kpis{grid-template-columns:1fr;} }
    
</style>
</HeadContent>


<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Purchases" BreadcrumbArea="Procure to Pay" BreadcrumbTab="Purchases">

    <section class="epc-pur-hero">
        <img src="@LegacyPresentationAssets.EpartsCartMarkUrl" alt="ECOM AE" style="height:28px;filter:brightness(1.1)" />
        <h1>Purchases</h1>
        <p>Purchase documents and supplier intake for this company.</p>
        <div class="epc-pur-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/erp/purchase-orders-app">Purchase orders</a>
            <a class="ghost" href="/erp/suppliers-app">Suppliers</a>
            <a class="ghost" href="/erp/app">ERP dashboard</a>
        </div>
    </section>

    <div class="epc-pur-kpis" aria-label="Purchase KPIs">
        <div class="epc-pur-kpi"><strong>@_purchases.Count</strong><span>Shown (limit @_limit)</span></div>
        <div class="epc-pur-kpi"><strong>@_open</strong><span>Non-closed in page</span></div>
        <div class="epc-pur-kpi"><strong>@_totalAmount.ToString("N2", CultureInfo.InvariantCulture)</strong><span>Page total amount</span></div>
    </div>

    <div class="epc-pur-table-wrap">
        <table class="epc-pur-table">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Date</th>
                    <th>Supplier</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>PO / Order</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_purchases.Count == 0)
                {
                    <tr><td colspan="7">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var p in _purchases)
                    {
                        var phpHref = $"{_phpTab}&purchase_id={p.Id.ToString(CultureInfo.InvariantCulture)}";
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(p.InvoiceNumber) ? $"#{p.Id}" : p.InvoiceNumber)</strong></td>
                            <td>@FormatTime(p.PurchaseDate)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.SupplierName) ? $"#{p.SupplierId}" : p.SupplierName)</td>
                            <td><span class="epc-pur-badge">@p.Status</span></td>
                            <td>@p.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(p.OrderId > 0 ? p.OrderId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(phpHref)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=purchasing&tab=purchases";
    private bool _isAdmin;
    private IReadOnlyList<ErpPurchaseDigest> _purchases = [];
    private int _open;
    private decimal _totalAmount;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListErpPurchasesAsync(_limit, ctx.RequestAborted);
        _purchases = result.Purchases;
        _open = _purchases.Count(p => !string.Equals(p.Status, "closed", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(p.Status, "cancelled", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(p.Status, "canceled", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(p.Status, "posted", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(p.Status, "paid", StringComparison.OrdinalIgnoreCase));
        _totalAmount = _purchases.Sum(p => p.TotalAmount);
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
