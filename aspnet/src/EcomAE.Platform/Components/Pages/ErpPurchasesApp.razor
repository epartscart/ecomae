@page "/erp/purchases-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Purchases · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Purchases" BreadcrumbArea="Procure to Pay" BreadcrumbTab="Purchases">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/purchases-app" IsAdmin="_isAdmin" />


    
    <PhpErpModulePageHeader Title="Purchases" Subtitle="Open a purchase for the note excerpt and VAT. Writes stay Classic." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="/erp/purchases-app" />


    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Purchase KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_purchases.Count</div></div>
        <div class="kpi"><div class="lbl">Non-closed in page</div><div class="val">@_open</div></div>
        <div class="kpi"><div class="lbl">Page total amount</div><div class="val">@_totalAmount.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedDetail is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="/erp/purchases-app">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Purchase id</dt><dd>@_openedDetail.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Invoice #</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.InvoiceNumber) ? "—" : _openedDetail.InvoiceNumber)</dd>
                <dt>Supplier</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.SupplierName) ? ("#" + _openedDetail.SupplierId.ToString(CultureInfo.InvariantCulture)) : _openedDetail.SupplierName)</dd>
                <dt>Date</dt><dd>@FormatTime(_openedDetail.PurchaseDate)</dd>
                <dt>Ex VAT</dt><dd>@_openedDetail.AmountExVat.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>VAT</dt><dd>@_openedDetail.VatAmount.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Total</dt><dd>@_openedDetail.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.Status) ? "—" : _openedDetail.Status)</dd>
                <dt>Order</dt><dd>@(_openedDetail.OrderId > 0 ? _openedDetail.OrderId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Storage</dt><dd>@(_openedDetail.StorageId > 0 ? _openedDetail.StorageId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Admin</dt><dd>@(_openedDetail.AdminId > 0 ? _openedDetail.AdminId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Created</dt><dd>@FormatTime(_openedDetail.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Writes stay Classic.</p>
            @if (!string.IsNullOrWhiteSpace(_openedDetail.NoteExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">note excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedDetail.NoteExcerpt</pre>
                @if (_openedDetail.NoteLen > _openedDetail.NoteExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_openedDetail.NoteExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedDetail.NoteLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No note excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Invoice #</th><th>Supplier</th><th class="text-right">Total</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.InvoiceNumber) ? "—" : sib.InvoiceNumber)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.SupplierName) ? ("#" + sib.SupplierId.ToString(CultureInfo.InvariantCulture)) : sib.SupplierName)</td>
                                <td class="text-right">@sib.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href("/erp/purchases-app", "purchase_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Date</th>
                    <th>Supplier</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>PO / Order</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_purchases.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var p in _purchases)
                    {
                        <tr id="erp-row-@p.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(p.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(p.InvoiceNumber) ? $"#{p.Id}" : p.InvoiceNumber)</strong></td>
                            <td>@FormatTime(p.PurchaseDate)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.SupplierName) ? $"#{p.SupplierId}" : p.SupplierName)</td>
                            <td><span class="label label-default">@p.Status</span></td>
                            <td>@p.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(p.OrderId > 0 ? p.OrderId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href("/erp/purchases-app", "purchase_id", p.Id)">Open</a></td>
                        </tr>
                        @if (p.Lines.Count > 0)
                        {
                            <tr class="epc-erp-doc-lines">
                                <td colspan="7">
                                    <table class="table table-condensed table-bordered" style="margin-bottom:0">
                                        <thead>
                                            <tr>
                                                <th style="width:18%">Item / SKU</th>
                                                <th>Description</th>
                                                <th style="width:12%" class="text-right">Qty</th>
                                                <th style="width:14%" class="text-right">Unit cost</th>
                                                <th style="width:14%" class="text-right">Line total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var line in p.Lines)
                                            {
                                                <tr>
                                                    <td>@(string.IsNullOrWhiteSpace(line.ItemCode) ? "—" : line.ItemCode)</td>
                                                    <td>@line.Description</td>
                                                    <td class="text-right">@line.Qty.ToString("N3", CultureInfo.InvariantCulture)</td>
                                                    <td class="text-right">@line.UnitPriceExVat.ToString("N4", CultureInfo.InvariantCulture)</td>
                                                    <td class="text-right">@line.LineExVat.ToString("N2", CultureInfo.InvariantCulture)</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="4" class="text-right"><strong>Lines total (ex VAT)</strong></td>
                                                <td class="text-right">@p.Lines.Sum(l => l.LineExVat).ToString("N2", CultureInfo.InvariantCulture)</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=purchasing&tab=purchases";
    private bool _isAdmin;
    private IReadOnlyList<ErpPurchaseDigest> _purchases = [];
    private int _open;
    private decimal _totalAmount;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpPurchaseDigest? _openedPurchase;
    private ErpPurchaseDetail? _openedDetail;
    private IReadOnlyList<ErpPurchaseDigest> _openedSiblings = [];

    private bool OpenedFound => _openedDetail is not null || _openedPurchase is not null;

    private string OpenedReturnHref => _openedId > 0
        ? "/erp/purchases-app?purchase_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : "/erp/purchases-app";

    private string OpenedCaption => _openedDetail is not null
        ? (string.IsNullOrWhiteSpace(_openedDetail.InvoiceNumber) ? ("Purchase #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.InvoiceNumber)
            + (string.IsNullOrWhiteSpace(_openedDetail.SupplierName) ? "" : (" · " + _openedDetail.SupplierName))
        : _openedPurchase is null
            ? ""
            : (string.IsNullOrWhiteSpace(_openedPurchase.InvoiceNumber) ? $"Purchase #{_openedPurchase.Id}" : _openedPurchase.InvoiceNumber) + " · " + _openedPurchase.Status;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "purchase_id");
        var result = await Dashboards.ListErpPurchasesAsync(_limit, ctx.RequestAborted);
        _purchases = result.Purchases;
        _openedPurchase = _openedId > 0 ? _purchases.FirstOrDefault(p => p.Id == _openedId) : null;
        if (_openedPurchase is not null)
        {
            _purchases = new[] { _openedPurchase }.Concat(_purchases.Where(p => p.Id != _openedId)).ToList();
        }
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpPurchaseDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Purchase;
            _openedSiblings = detail.Siblings;
            if (_openedDetail is null && !string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
        _open = _purchases.Count(p => !string.Equals(p.Status, "closed", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(p.Status, "cancelled", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(p.Status, "canceled", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(p.Status, "posted", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(p.Status, "paid", StringComparison.OrdinalIgnoreCase));
        _totalAmount = _purchases.Sum(p => p.TotalAmount);
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
