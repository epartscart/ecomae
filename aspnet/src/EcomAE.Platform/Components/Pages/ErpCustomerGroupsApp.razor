@page "/erp/customer-groups-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Customer groups · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Customer groups" BreadcrumbArea="Sales" BreadcrumbTab="Customer groups">
    <PhpErpModulePageHeader Title="Customer groups" Subtitle="Wholesale, corporate and price-list tiers. Membership writes stay on ERP ajax." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Customer group KPIs">
        <div class="kpi"><div class="lbl">Groups</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Members</div><div class="val">@_members.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Code</th><th>Name</th><th>Type</th><th class="text-right">Discount %</th><th class="text-right">Credit</th><th class="text-right">Terms</th><th class="text-right">Members</th><th>Status</th></tr></thead>
            <tbody>
                @if (_groups.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No customer groups yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _groups)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(row.GroupCode) ? "—" : row.GroupCode)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.GroupName) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.GroupName)</strong></td>
                            <td>@row.GroupType</td>
                            <td class="text-right">@row.DiscountPct.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.CreditLimit.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.PaymentTermsDays.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.MemberCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td><span class="label label-default">@(row.IsActive ? "active" : "inactive")</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=sales&tab=customer_groups";
    private bool _isAdmin;
    private IReadOnlyList<ErpCustomerGroupDigest> _groups = [];
    private int _count, _active, _members;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.ListErpCustomerGroupsAsync(200, ctx.RequestAborted);
        _groups = result.Groups;
        _count = result.Count;
        _active = result.ActiveCount;
        _members = result.MemberTotal;
        _source = result.Source;
        _message = result.Message;
    }
}
