@page "/erp/customer-groups-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Customer groups · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Customer groups" BreadcrumbArea="Sales" BreadcrumbTab="Customer groups">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/customer-groups-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Customer groups" Subtitle="Open a row for the 280-character description excerpt. Create and assign stay on this page." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    <ErpPhpFlash Ok="@_ok" Err="@_err" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Customer group KPIs">
        <div class="kpi"><div class="lbl">Groups</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Members</div><div class="val">@_members.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <ErpPhpCreateWell Title="New customer group">
            <form method="post" action="@EcomAeRoutes.ErpCustomerGroupsCreateForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/erp/customer-groups-app" />
                <label>Code <input class="form-control input-sm" name="group_code" placeholder="Auto" /></label>
                <label>Name <input class="form-control input-sm" name="group_name" placeholder="Wholesale" /></label>
                <label>Type
                    <select class="form-control input-sm" name="group_type">
                        <option value="general">General</option>
                        <option value="wholesale" selected>Wholesale</option>
                        <option value="corporate">Corporate</option>
                        <option value="retail">Retail</option>
                        <option value="vip">VIP</option>
                        <option value="government">Government</option>
                    </select>
                </label>
                <label>Discount % <input class="form-control input-sm" name="discount_pct" type="number" step="0.01" value="0" /></label>
                <label>Credit <input class="form-control input-sm" name="credit_limit" type="number" step="0.01" value="0" /></label>
                <label>Terms <input class="form-control input-sm" name="payment_terms_days" type="number" value="30" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Create group</button>
            </form>
        </ErpPhpCreateWell>
        <ErpPhpCreateWell Title="Assign customer">
            <form method="post" action="@EcomAeRoutes.ErpCustomerGroupsAssignForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/erp/customer-groups-app" />
                <label>Group id <input class="form-control input-sm" name="group_id" type="number" min="1" required /></label>
                <label>Customer id <input class="form-control input-sm" name="customer_id" type="number" min="1" required /></label>
                <button type="submit" class="btn btn-primary btn-sm">Assign customer</button>
            </form>
        </ErpPhpCreateWell>
    }

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Id</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Code</dt><dd>@(string.IsNullOrWhiteSpace(_opened.GroupCode) ? "—" : _opened.GroupCode)</dd>
                <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_opened.GroupName) ? "—" : _opened.GroupName)</dd>
                <dt>Type</dt><dd>@(string.IsNullOrWhiteSpace(_opened.GroupType) ? "—" : _opened.GroupType)</dd>
                <dt>Discount %</dt><dd>@_opened.DiscountPct.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Credit</dt><dd>@_opened.CreditLimit.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Terms</dt><dd>@_opened.PaymentTermsDays.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Members</dt><dd>@_opened.MemberCount.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Price list</dt><dd>@(_opened.PriceListId > 0 ? _opened.PriceListId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Company</dt><dd>@(_opened.CompanyId > 0 ? _opened.CompanyId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Status</dt><dd>@(_opened.IsActive ? "active" : "inactive")</dd>
                <dt>Created</dt><dd>@FormatTime(_opened.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Create and assign stay on this page. Schema-ensure stays Classic.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.DescriptionExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">description excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.DescriptionExcerpt</pre>
                @if (_opened.DescriptionLen > _opened.DescriptionExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.DescriptionExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.DescriptionLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No description excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-type siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Members</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.GroupCode) ? "—" : sib.GroupCode)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.GroupName) ? "—" : sib.GroupName)</td>
                                <td>@sib.MemberCount.ToString(CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "cgroup_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-type siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Id</th><th>Code</th><th>Name</th><th>Type</th><th class="text-right">Discount %</th><th class="text-right">Credit</th><th class="text-right">Terms</th><th class="text-right">Members</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @if (_groups.Count == 0)
                {
                    <tr><td colspan="10">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No customer groups yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _groups)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.GroupCode) ? "—" : row.GroupCode)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.GroupName) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.GroupName)</strong></td>
                            <td>@row.GroupType</td>
                            <td class="text-right">@row.DiscountPct.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.CreditLimit.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.PaymentTermsDays.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.MemberCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td><span class="label label-default">@(row.IsActive ? "active" : "inactive")</span></td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "cgroup_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
        Customer group create and assign are live when confirmed. Schema-ensure stays Classic.
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=sales&tab=customer_groups";
    private const string _listHref = "/erp/customer-groups-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpCustomerGroupDigest> _groups = [];
    private int _count, _active, _members;
    private string _source = "n/a";
    private string _message = "";
    private string _ok = "";
    private string _err = "";
    private long _openedId;
    private ErpCustomerGroupDetail? _opened;
    private IReadOnlyList<ErpCustomerGroupDigest> _openedSiblings = [];

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?cgroup_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedCaption => _opened is null
        ? ""
        : (string.IsNullOrWhiteSpace(_opened.GroupName)
            ? ("Group #" + _opened.Id.ToString(CultureInfo.InvariantCulture))
            : _opened.GroupName)
            + (string.IsNullOrWhiteSpace(_opened.GroupType) ? "" : (" · " + _opened.GroupType));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _ok = ctx.Request.Query["ok"].ToString();
        _err = ctx.Request.Query["err"].ToString();
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "cgroup_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.ListErpCustomerGroupsAsync(200, ctx.RequestAborted);
        _groups = result.Groups;
        _count = result.Count;
        _active = result.ActiveCount;
        _members = result.MemberTotal;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpCustomerGroupDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Group;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _groups.FirstOrDefault(g => g.Id == _openedId);
                if (openedList is not null)
                {
                    _groups = new[] { openedList }.Concat(_groups.Where(g => g.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
