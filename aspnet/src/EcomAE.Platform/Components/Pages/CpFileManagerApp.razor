@page "/cp/file-manager-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>File manager · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                File manager
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/file-manager-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/file-manager-app" IsAdmin="_isAdmin" />

    <p class="help-block">@_summary.RootPresent.ToString(CultureInfo.InvariantCulture) Root OK · @_summary.FileCount.ToString(CultureInfo.InvariantCulture) Files · @_summary.DirCount.ToString(CultureInfo.InvariantCulture) Dirs · @_summary.TotalBytes.ToString(CultureInfo.InvariantCulture) Bytes.</p>
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead><tr><th>Name</th><th>Dir</th><th>Bytes</th><th>Ext</th><th></th></tr></thead>
        <tbody>
        @if (_rows.Count==0) { <tr><td colspan="5">No records yet.</td></tr> }
        else { @foreach (var row in _rows) { <tr><td>@row.Name</td><td>@row.IsDirectory</td><td>@row.SizeBytes</td><td>@row.Extension</td><td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td></tr> } }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>
@code {
    private const string _phpTab = "/CP/filemanager";
    private bool _isAdmin;
    private CpFileManagerSummary _summary = new(0, 0, 0, 0L, "n/a", "");
    private IReadOnlyList<CpFileManagerRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpFileManagerDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Entries;
        _source = result.Source;
        _message = result.Message;
    }
}
