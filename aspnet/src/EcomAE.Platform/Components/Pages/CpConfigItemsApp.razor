@page "/cp/config-items-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Config Items · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Config items
                <a class="btn btn-xs btn-default pull-right" href="/cp/api-clients-app">API clients</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" style="margin-right:.4rem">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Configuration field catalog from tenant tables. Edit values on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/config-items-app" IsAdmin="_isAdmin" />

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Items</div>
            <div class="panel-body">
                <p class="help-block">@_items.Count shown (limit @_limit) · @_visible visible · @_groups config groups.</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Caption</th>
                                <th>Type</th>
                                <th>Group</th>
                                <th>Visible</th>
                                <th>Order</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_items.Count == 0)
                        {
                            <tr><td colspan="6">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in _items)
                            {
                                <tr>
                                    <td>@(string.IsNullOrWhiteSpace(item.Name) ? "—" : item.Name)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Caption) ? "—" : item.Caption)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Type) ? "—" : item.Type)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ConfigGroup) ? "—" : item.ConfigGroup)</td>
                                    <td>@(item.Visible ? "yes" : "no")</td>
                                    <td>@item.Order.ToString(CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/config_edit";
    private bool _isAdmin;
    private IReadOnlyList<CpConfigItemMetaDigest> _items = [];
    private int _visible;
    private int _groups;
    private int _limit = 200;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.ListCpConfigItemsMetaAsync(_limit, ctx.RequestAborted);
        _items = result.Items;
        _visible = _items.Count(i => i.Visible);
        _groups = _items.Select(i => i.ConfigGroup).Where(g => !string.IsNullOrWhiteSpace(g)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    }
}
