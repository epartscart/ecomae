@page "/cp/customer-board-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Customer board · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

@if (_allowed)
{
    <PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Customer board
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/customer-board-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/customer-board-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_userCount.ToString(CultureInfo.InvariantCulture) Users · @_withEmail.ToString(CultureInfo.InvariantCulture) With email · @_withPhone.ToString(CultureInfo.InvariantCulture) With phone · @_recentLogins.ToString(CultureInfo.InvariantCulture) Recent (30d).</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Email</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Registered</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="6">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Email) ? row.Email : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Phone) ? row.Phone : "—")</td>
                            <td>@row.RegTime.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="epc-nw-note">Super CP host only. Customer writes remain PHP / dry-run.</div>

</PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>This control is available on the platform Super CP host only.</p>
        <p><a href="/cp">Open Control Panel</a></p>
    </div>
}

@code {
    private bool _allowed;
    private const string _phpTab = "/CP/control/portal/epc_super_cp_customer_board";
    private bool _isAdmin;
    private int _userCount = 0;
    private int _withEmail = 0;
    private int _withPhone = 0;
    private int _recentLogins = 0;
    private IReadOnlyList<CpCustomerBoardRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpCustomerBoardDigestAsync(200, ctx.RequestAborted);
        _userCount = result.Summary.UserCount;
        _withEmail = result.Summary.WithEmail;
        _withPhone = result.Summary.WithPhone;
        _recentLogins = result.Summary.RecentLogins;
        _rows = result.Rows;
        _source = result.Source;
        _message = result.Message;
    }
}
