@page "/cp/customer-board-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ICpSuperCustomerBoardService Board
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Customer board · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

@if (_allowed)
{
    <PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12 epc-scp-panel epc-scp-customer-board">
        <div class="epc-scp-panel__hero">
            <div>
                <span class="epc-scp-dashboard__badge">Super CP</span>
                <h2 class="epc-scp-dashboard__title">Customer board</h2>
                <p class="epc-scp-dashboard__sub">Search and filter customers across the platform and live tenant databases — open CRM or ERP in one click.</p>
            </div>
            <div class="epc-scp-dashboard__hero-actions">
                <a class="btn btn-sm btn-default" href="@TenantHubHref"><i class="fa fa-cloud"></i> Tenant hub</a>
                <a class="btn btn-sm btn-primary" href="@CommunicationHref"><i class="fa fa-envelope"></i> Communication</a>
                <a class="btn btn-sm btn-default" href="@OperatorGuideHref"><i class="fa fa-book"></i> Operator guide</a>
            </div>
        </div>

        <div class="epc-scp-intro-panel">
            <div class="epc-scp-intro-panel__body">
                <strong>Operator workspace — Customer board</strong>
                <p>Search customers across the platform registry and every live tenant database, then jump into CRM, ERP or the tenant CP without signing into each client separately.</p>
            </div>
            <a class="btn btn-sm btn-default" href="@OperatorGuideHref"><i class="fa fa-book"></i> Operator guide</a>
        </div>
    </div>

    <PhpParityModuleBody AppPath="/cp/customer-board-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    @if (!_isAdmin)
    {
        <div class="col-lg-12">
            <div class="alert alert-warning" role="status">Please log in to Super CP with a staff session.</div>
        </div>
    }

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedUser is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-scp-kpi" aria-label="Customer board KPIs">
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Results</div>
            <div class="epc-scp-kpi__val">@_result.Total.ToString(CultureInfo.InvariantCulture)</div>
            <div class="epc-scp-kpi__hint">Matching customers</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Platform</div>
            <div class="epc-scp-kpi__val">@_result.PlatformCount.ToString(CultureInfo.InvariantCulture)</div>
            <div class="epc-scp-kpi__hint">ecomae DB</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Tenants scanned</div>
            <div class="epc-scp-kpi__val">@_result.TenantsScanned.ToString(CultureInfo.InvariantCulture)</div>
            <div class="epc-scp-kpi__hint">@_result.TenantsWithHits.ToString(CultureInfo.InvariantCulture) with hits</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Live tenants</div>
            <div class="epc-scp-kpi__val">@_tenants.Count.ToString(CultureInfo.InvariantCulture)</div>
            <div class="epc-scp-kpi__hint">In registry</div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="col-lg-12"><div class="alert alert-warning" role="status">@_message</div></div>
    }

    <div class="col-lg-12">
        <div class="epc-scp-filter-bar">
            <form method="get" class="form-inline">
                <div class="form-group">
                    <label class="sr-only" for="scp-q">Search</label>
                    <input type="search" id="scp-q" name="q" class="form-control input-sm" placeholder="Email, phone, name, company…" value="@_search" style="min-width:220px" />
                </div>
                <div class="form-group">
                    <select name="tenant" class="form-control input-sm">
                        <option value="" selected="@(_tenantFilter.Length == 0)">All sources</option>
                        <option value="platform" selected="@(_tenantFilter == "platform")">Platform only</option>
                        @foreach (var tenant in _tenants)
                        {
                            <option value="@tenant.SiteKey" selected="@(_tenantFilter == tenant.SiteKey)">@tenant.DropdownLabel</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> Search</button>
                @if (_search.Length > 0 || _tenantFilter.Length > 0)
                {
                    <a class="btn btn-default btn-sm" href="@_listHref">Clear</a>
                }
            </form>
        </div>
    </div>

    @if (_openedUser is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @OpenedTitle
                    <span class="label label-default pull-right">@(_openedUser.Unlocked != 0 ? "unlocked" : "locked")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedUser.Email) ? _openedUser.Email : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedUser.Phone) ? _openedUser.Phone : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedUser.RegVariant) ? _openedUser.RegVariant : "—")</p>
                    <p>Registered @_openedUser.TimeRegistered.ToString(CultureInfo.InvariantCulture)
                        · last visit @_openedUser.TimeLastVisit.ToString(CultureInfo.InvariantCulture)
                        · email @(_openedUser.EmailConfirmed != 0 ? "confirmed" : "unconfirmed")
                        · phone @(_openedUser.PhoneConfirmed != 0 ? "confirmed" : "unconfirmed")</p>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Groups</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Group</th>
                                    <th>Backend</th>
                                    <th>Unblocked</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedGroups.Count == 0)
                                {
                                    <tr><td colspan="4">No groups yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var group in _openedGroups)
                                    {
                                        <tr>
                                            <td>@group.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(group.Value) ? group.Value : "—")</td>
                                            <td>@(group.ForBackend != 0 ? "yes" : "no")</td>
                                            <td>@(group.Unblocked != 0 ? "yes" : "no")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="epc-scp-table-card">
            <div class="table-responsive">
                <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Email / phone</th>
                            <th>Source</th>
                            <th>Registered</th>
                            <th>Quick actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_result.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="5">
                                    <div class="epc-scp-empty-state">
                                        <h4>No customers found</h4>
                                        <p>
                                            @(_search.Length > 0 || _tenantFilter.Length > 0
                                                ? "Try a broader search, clear the filters, or pick another tenant from the registry."
                                                : "Search by email, phone, name, or company to find users across the platform and tenant databases.")
                                        </p>
                                        <div class="epc-scp-empty-state__actions">
                                            <a class="btn btn-xs btn-default" href="@_listHref">Clear search</a>
                                            <a class="btn btn-xs btn-default" href="@OperatorGuideHref">Operator guide</a>
                                            <a class="btn btn-xs btn-default" href="@TenantHubHref">Tenant hub</a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in _result.Rows)
                            {
                                <tr id="@RowDomId(row)" class="@RowClass(row)">
                                    <td>
                                        <strong>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</strong>
                                        <div class="text-muted small">#@row.UserId.ToString(CultureInfo.InvariantCulture)</div>
                                    </td>
                                    <td>
                                        <div>@(!string.IsNullOrWhiteSpace(row.Email) ? row.Email : "—")</div>
                                        <div class="text-muted small">@(!string.IsNullOrWhiteSpace(row.Phone) ? row.Phone : "—")</div>
                                    </td>
                                    <td>
                                        <span class="label label-default">@(!string.IsNullOrWhiteSpace(row.SourceLabel) ? row.SourceLabel : row.Source)</span>
                                        @if (!string.IsNullOrWhiteSpace(row.Hostname))
                                        {
                                            <div class="text-muted small">@row.Hostname</div>
                                        }
                                    </td>
                                    <td>@RegisteredCell(row.TimeRegistered)</td>
                                    <td>
                                        @if (row.Source == "platform")
                                        {
                                            <a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "user_id", row.UserId)">Open</a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(row.CrmUrl))
                                        {
                                            <a class="btn btn-xs btn-default" href="@row.CrmUrl" target="_blank" rel="noopener">CRM</a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(row.ErpUrl))
                                        {
                                            <a class="btn btn-xs btn-default" href="@row.ErpUrl" target="_blank" rel="noopener">ERP</a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(row.CpUrl))
                                        {
                                            <a class="btn btn-xs btn-default" href="@row.CpUrl" target="_blank" rel="noopener">CP</a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (PageCount > 1)
            {
                <div class="epc-scp-pagination">
                    @for (var p = 1; p <= Math.Min(PageCount, 12); p++)
                    {
                        <a class="btn btn-xs @(p == _page ? "btn-primary" : "btn-default")" href="@PageHref(p)">@p.ToString(CultureInfo.InvariantCulture)</a>
                    }
                </div>
            }
        </div>
    </div>

    <div class="epc-nw-note">Super CP host only. The PHP customer board is read/search — customer edits stay in the owning tenant CP.</div>

</PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>This control is available on the platform Super CP host only.</p>
        <p><a href="/cp">Open Control Panel</a></p>
    </div>
}

@code {
    private const string _listHref = "/cp/customer-board-app";
    private const string OperatorGuideHref = "/cp/super-cp-operator-guide-app";
    private const string TenantHubHref = "/cp/tenants-app";
    private const string CommunicationHref = "/cp/platform-communication-app";
    private const int PerPage = 50;

    private bool _allowed;
    private bool _isAdmin;
    private string _search = "";
    private string _tenantFilter = "";
    private string _message = "";
    private int _page = 1;
    private IReadOnlyList<CpSuperCustomerTenantOption> _tenants = [];
    private CpSuperCustomerBoardResult _result = new([], 0, 1, PerPage, 0, 0, 0, "n/a", "");
    private long _openedId;
    private CpCustomerBoardUserDetail? _openedUser;
    private IReadOnlyList<CpCustomerBoardGroupDigest> _openedGroups = [];

    private int PageCount => (int)Math.Ceiling(Math.Max(1, _result.Total) / (double)Math.Max(1, _result.PerPage));

    private string OpenedTitle => _openedUser is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_openedUser.Name)
            ? _openedUser.Name
            : (!string.IsNullOrWhiteSpace(_openedUser.Email)
                ? _openedUser.Email
                : "User #" + _openedUser.Id.ToString(CultureInfo.InvariantCulture)));

    private string OpenedCaption => _openedUser is null
        ? ""
        : OpenedTitle + (_openedUser.Unlocked != 0 ? " · unlocked" : " · locked");

    /// <summary>PHP <c>date('Y-m-d', time_reg)</c>, em dash when unset.</summary>
    private static string RegisteredCell(long timeRegistered)
        => timeRegistered > 0
            ? DateTimeOffset.FromUnixTimeSeconds(timeRegistered).UtcDateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
            : "—";

    private static string RowDomId(CpSuperCustomerRow row)
        => row.Source == "platform"
            ? "erp-row-" + row.UserId.ToString(CultureInfo.InvariantCulture)
            : "row-" + row.Source + "-" + row.UserId.ToString(CultureInfo.InvariantCulture);

    private string RowClass(CpSuperCustomerRow row)
        => row.Source == "platform" ? ErpRecordOpen.RowClass(row.UserId, _openedId) : "";

    private string PageHref(int page)
    {
        var query = new List<string>();
        if (_search.Length > 0)
        {
            query.Add("q=" + Uri.EscapeDataString(_search));
        }

        if (_tenantFilter.Length > 0)
        {
            query.Add("tenant=" + Uri.EscapeDataString(_tenantFilter));
        }

        query.Add("page=" + page.ToString(CultureInfo.InvariantCulture));
        return _listHref + "?" + string.Join("&", query);
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "user_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        _search = (ctx.Request.Query["q"].ToString() ?? string.Empty).Trim();
        _tenantFilter = CpSuperCustomerBoardService.NormalizeTenantFilter(ctx.Request.Query["tenant"].ToString());
        _page = int.TryParse(ctx.Request.Query["page"].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed)
            ? Math.Max(1, parsed)
            : 1;

        _tenants = await Board.ListTenantOptionsAsync(ctx.RequestAborted);
        _result = await Board.SearchAsync(_search, _tenantFilter, _page, PerPage, ctx.RequestAborted);
        _message = _result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpCustomerBoardUserDetailAsync(_openedId, ctx.RequestAborted);
            _openedUser = detail.User;
            _openedGroups = detail.Groups;
            if (_openedUser is null && !string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
