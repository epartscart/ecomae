@page "/lifeos/cinematic-app"
@layout Layout.LifeOsProductLayout
@using EcomAE.Platform.LifeOs.Cinematic
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ILifeOsCinematicFilm Film

<PageTitle>LifeOS™ · Daily clone routine film</PageTitle>
<PhpSurfaceHead Surface="lifeos" />
<PhpChromeBodyClass Surface="lifeos" />
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<style>@((MarkupString)_css)</style>
<HeadContent>
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<meta name="ecomae-chrome-surface" content="lifeos-cinematic" />
<style>@((MarkupString)_css)</style>
</HeadContent>

<div class="locine">
  <header class="locine-top">
    <div class="brand">Life<em>OS</em>™</div>
    <nav>
      <a href="@EcomAeRoutes.LifeOs">Home</a>
      <a href="@EcomAeRoutes.LifeOsDemoApp">Demo</a>
      <a class="is-active" href="@EcomAeRoutes.LifeOsCinematicApp">Film</a>
      <a href="@EcomAeRoutes.LifeOsCinematic">JSON</a>
    </nav>
  </header>

  <main class="locine-stage" aria-label="LifeOS daily human + AI clone routine film">
    <p class="locine-kicker">1:22 · morning → evening · @Film.ProtagonistName ↔ @Film.ProtagonistName</p>
    <h1>LifeOS — Human + same-name AI clone, all day</h1>
    <p class="locine-lede">
      @Film.ProtagonistName speaks with @Film.ProtagonistName — the identical LifeOS clone — for advice at every daily stage. Sound is on the file: use the player volume control. Jump to any beat below.
    </p>

    <div class="locine-player">
      <video id="lifeos-launch-film"
             controls
             playsinline
             preload="auto"
             poster="@Film.PosterUrl"
             aria-label="LifeOS daily human + AI clone routine film with dialogue">
        <source src="@Film.VideoUrl" type="video/mp4" />
        Your browser does not support HTML5 video.
      </video>
    </div>

    <ol class="locine-timeline" aria-label="Shot list" id="lifeos-film-timeline">
      @foreach (var s in Film.Scenes)
      {
        <li>
          <button type="button" class="locine-seek" data-seek="@s.StartSeconds">
            <em>@FormatTime(s.StartSeconds)</em>
            <strong>@s.Title</strong>
            <span>@s.OnScreenText</span>
          </button>
        </li>
      }
    </ol>

    <section class="locine-meta">
      <p>Published at <code>@Film.VideoUrl</code> · poster + keyframes under <code>/lifeos/media/</code>.</p>
      <p class="locine-downloads">
        <a class="locine-dl" href="@Film.VideoDownloadUrl" download="LifeOS-Daily-Clone-Routine.mp4">Download MP4</a>
        <a class="locine-dl ghost" href="@Film.PosterUrl" download="LifeOS-Daily-Clone-Poster.png">Download poster</a>
        <a class="locine-link" href="@EcomAeRoutes.IpApp">IP panel →</a>
        <a class="locine-link" href="@EcomAeRoutes.LifeOsDemoApp">Board-meeting sample →</a>
      </p>
    </section>
  </main>
</div>

<script>
(() => {
  const bind = () => {
    const v = document.getElementById('lifeos-launch-film');
    if (!v) return;
    document.querySelectorAll('.locine-seek').forEach((btn) => {
      btn.addEventListener('click', () => {
        const sec = Number(btn.getAttribute('data-seek') || 0);
        v.currentTime = Math.max(0, sec);
        v.play().catch(() => {});
      });
    });
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bind);
  } else {
    bind();
  }
})();
</script>

@code {
    private static string FormatTime(int seconds)
    {
        var m = seconds / 60;
        var s = seconds % 60;
        return $"{m}:{s:00}";
    }

