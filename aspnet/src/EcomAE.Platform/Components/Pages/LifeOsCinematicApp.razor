@page "/lifeos/cinematic-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.LifeOs.Cinematic
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ILifeOsCinematicFilm Film
@implements IDisposable

<PageTitle>LifeOS™ · Cinematic launch film</PageTitle>
<PhpSurfaceHead Surface="lifeos" />
<PhpChromeBodyClass Surface="lifeos" />
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<style>@((MarkupString)_css)</style>
<HeadContent>
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<meta name="ecomae-chrome-surface" content="lifeos-cinematic" />
<style>@((MarkupString)_css)</style>
</HeadContent>

<div class="locine">
  <header class="locine-top">
    <div class="brand">Life<em>OS</em>™</div>
    <nav>
      <a href="@EcomAeRoutes.LifeOs">Home</a>
      <a href="@EcomAeRoutes.LifeOsDemoApp">Demo</a>
      <a class="is-active" href="@EcomAeRoutes.LifeOsCinematicApp">Film</a>
      <a href="@EcomAeRoutes.LifeOsCinematic">JSON</a>
    </nav>
  </header>

  <main class="locine-stage" aria-label="LifeOS cinematic storyboard">
    <div class="locine-frame">
      @if (!string.IsNullOrEmpty(_scene.KeyframeUrl))
      {
        <img class="locine-key" src="@_scene.KeyframeUrl" alt="@_scene.Title" />
      }
      else
      {
        <div class="locine-placeholder" aria-hidden="true">
          <div class="locine-orb"></div>
          <ul class="locine-modules">
            @foreach (var beat in _scene.Beats.Take(4))
            {
              <li>@beat</li>
            }
          </ul>
        </div>
      }
      <div class="locine-veil"></div>
      <div class="locine-caption">
        <p class="locine-kicker">Scene @_scene.Number · @_scene.Beat · @_timecode</p>
        <h1>@_scene.Title</h1>
        <p class="locine-text">@_scene.OnScreenText</p>
        <p class="locine-visual">@_scene.Visual</p>
      </div>
    </div>

    <div class="locine-controls">
      <button type="button" class="locine-play" @onclick="TogglePlay">
        @(_playing ? "Pause" : "Play film")
      </button>
      <div class="locine-progress" role="progressbar" aria-valuemin="0" aria-valuemax="@Film.Digest().DurationSeconds" aria-valuenow="@_elapsed">
        <div class="locine-progress__bar" style="width:@(_progressPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
      </div>
      <span class="locine-clock">@_timecode / 3:00</span>
    </div>

    <ol class="locine-timeline" aria-label="Shot list">
      @foreach (var s in Film.Scenes)
      {
        <li>
          <button type="button"
                  class="@(s.Number == _scene.Number ? "is-active" : null)"
                  @onclick="() => JumpTo(s.StartSeconds)">
            <em>@FormatTime(s.StartSeconds)</em>
            <strong>@s.Title</strong>
          </button>
        </li>
      }
    </ol>

    <section class="locine-meta">
      <p>
        16:9 · 4K HDR · 60fps · Apple keynote × JARVIS × holographic OS.
        Full motion render pending Higgsfield authentication — keyframe storyboard is live now.
      </p>
      <a class="locine-link" href="@EcomAeRoutes.LifeOsDemoApp">Run the board-meeting sample →</a>
    </section>
  </main>
</div>

@code {
    private LifeOsCinematicScene _scene = default!;
    private int _elapsed;
    private bool _playing = true;
    private System.Threading.Timer? _timer;
    private double _progressPct;
    private string _timecode = "0:00";

    protected override void OnInitialized()
    {
        _scene = Film.Scenes[0];
        RefreshDerived();
        _timer = new System.Threading.Timer(_ =>
        {
            if (!_playing)
            {
                return;
            }

            _elapsed++;
            if (_elapsed >= LifeOsCinematicFilm.TotalDurationSeconds)
            {
                _elapsed = 0;
            }

            SyncScene();
            _ = InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void TogglePlay() => _playing = !_playing;

    private void JumpTo(int start)
    {
        _elapsed = start;
        SyncScene();
    }

    private void SyncScene()
    {
        _scene = Film.Scenes.LastOrDefault(s => _elapsed >= s.StartSeconds) ?? Film.Scenes[0];
        RefreshDerived();
    }

    private void RefreshDerived()
    {
        _progressPct = 100.0 * _elapsed / LifeOsCinematicFilm.TotalDurationSeconds;
        _timecode = FormatTime(_elapsed);
    }

    private static string FormatTime(int seconds)
    {
        var m = seconds / 60;
        var s = seconds % 60;
        return $"{m}:{s:00}";
    }

    public void Dispose() => _timer?.Dispose();

    private const string _css = """
        .locine {
          --lo-bg: #05070c;
          --lo-ink: #f4f7fb;
          --lo-mute: #9fb0c6;
          --lo-cyan: #5ec8ff;
          --lo-blue: #2f6bff;
          --lo-gold: #c9a96a;
          min-height: 100vh;
          background:
            radial-gradient(1200px 600px at 50% -10%, rgba(47,107,255,.28), transparent 55%),
            radial-gradient(900px 500px at 80% 80%, rgba(94,200,255,.12), transparent 50%),
            linear-gradient(180deg, #05070c 0%, #0a1220 55%, #05070c 100%);
          color: var(--lo-ink);
          font-family: "Segoe UI Variable", "Avenir Next", "Helvetica Neue", sans-serif;
        }
        .locine-top {
          display: flex; align-items: center; justify-content: space-between;
          padding: 1rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,.06);
        }
        .locine-top .brand { font-size: 1.35rem; letter-spacing: .04em; font-weight: 650; }
        .locine-top .brand em { font-style: normal; color: var(--lo-cyan); }
        .locine-top nav { display: flex; gap: 1rem; }
        .locine-top a { color: var(--lo-mute); text-decoration: none; font-size: .92rem; }
        .locine-top a.is-active, .locine-top a:hover { color: var(--lo-ink); }
        .locine-stage { max-width: 1120px; margin: 0 auto; padding: 1.25rem 1.25rem 3rem; }
        .locine-frame {
          position: relative; aspect-ratio: 16 / 9; border-radius: 4px; overflow: hidden;
          background: #000; box-shadow: 0 30px 80px rgba(0,0,0,.55);
        }
        .locine-key { width: 100%; height: 100%; object-fit: cover; display: block; animation: locine-ken 18s ease-in-out infinite alternate; }
        @keyframes locine-ken { from { transform: scale(1.02); } to { transform: scale(1.08); } }
        .locine-placeholder {
          width: 100%; height: 100%;
          background:
            radial-gradient(circle at 50% 45%, rgba(94,200,255,.35), transparent 40%),
            radial-gradient(circle at 30% 70%, rgba(47,107,255,.25), transparent 35%),
            #02050c;
          display: grid; place-items: center; position: relative;
        }
        .locine-orb {
          width: min(38%, 280px); aspect-ratio: 1; border-radius: 50%;
          background: radial-gradient(circle at 35% 30%, #fff, var(--lo-cyan) 35%, var(--lo-blue) 70%, transparent 72%);
          filter: blur(.2px); box-shadow: 0 0 80px rgba(94,200,255,.45); animation: locine-pulse 3.2s ease-in-out infinite;
        }
        @keyframes locine-pulse { 50% { transform: scale(1.05); opacity: .9; } }
        .locine-modules {
          position: absolute; inset: auto 8% 12%; list-style: none; margin: 0; padding: 0;
          display: grid; gap: .35rem; color: var(--lo-mute); font-size: .85rem;
        }
        .locine-veil {
          position: absolute; inset: 0;
          background: linear-gradient(180deg, transparent 35%, rgba(5,7,12,.82) 88%);
          pointer-events: none;
        }
        .locine-caption {
          position: absolute; left: 0; right: 0; bottom: 0; padding: 1.4rem 1.6rem 1.5rem;
          z-index: 2;
        }
        .locine-kicker {
          margin: 0 0 .35rem; text-transform: uppercase; letter-spacing: .16em;
          font-size: .68rem; color: var(--lo-cyan);
        }
        .locine-caption h1 {
          margin: 0 0 .4rem; font-size: clamp(1.4rem, 3.2vw, 2.2rem); font-weight: 650;
          letter-spacing: -.02em;
        }
        .locine-text { margin: 0 0 .35rem; font-size: clamp(1rem, 2vw, 1.25rem); color: #e8eef8; max-width: 40rem; }
        .locine-visual { margin: 0; font-size: .9rem; color: var(--lo-mute); max-width: 42rem; }
        .locine-controls {
          display: grid; grid-template-columns: auto 1fr auto; gap: .85rem; align-items: center;
          margin: 1rem 0 1.25rem;
        }
        .locine-play {
          border: 0; border-radius: 999px; padding: .65rem 1.2rem; cursor: pointer;
          background: linear-gradient(135deg, var(--lo-blue), #1a3f99); color: #fff; font-weight: 600;
        }
        .locine-progress {
          height: 4px; background: rgba(255,255,255,.1); border-radius: 999px; overflow: hidden;
        }
        .locine-progress__bar {
          height: 100%; background: linear-gradient(90deg, var(--lo-cyan), var(--lo-blue), var(--lo-gold));
          transition: width .35s linear;
        }
        .locine-clock { font-variant-numeric: tabular-nums; color: var(--lo-mute); font-size: .88rem; }
        .locine-timeline {
          list-style: none; margin: 0; padding: 0;
          display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: .5rem;
        }
        .locine-timeline button {
          width: 100%; text-align: left; border: 1px solid rgba(255,255,255,.08);
          background: rgba(255,255,255,.03); color: inherit; padding: .65rem .7rem; border-radius: 6px;
          cursor: pointer; min-height: 4.2rem;
        }
        .locine-timeline button em { display: block; font-style: normal; color: var(--lo-cyan); font-size: .72rem; }
        .locine-timeline button strong { display: block; font-size: .82rem; font-weight: 600; margin-top: .2rem; }
        .locine-timeline button.is-active {
          border-color: rgba(94,200,255,.55);
          background: linear-gradient(180deg, rgba(94,200,255,.14), rgba(255,255,255,.03));
        }
        .locine-meta { margin-top: 1.5rem; color: var(--lo-mute); font-size: .92rem; max-width: 46rem; }
        .locine-link { color: var(--lo-cyan); }
        @media (max-width: 720px) {
          .locine-controls { grid-template-columns: 1fr; }
          .locine-modules { display: none; }
        }
        """;
}
