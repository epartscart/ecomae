@page "/erp/sales-orders-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Sales Orders · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Sales Orders" BreadcrumbArea="Order to Cash" BreadcrumbTab="Sales Orders">
    <style>
        .epc-so-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#1d4ed8 45%,#2563eb 100%);
        }
        .epc-so-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-so-hero p { margin:0; color:#fed7aa; max-width:38rem; font-size:.92rem; line-height:1.45; }
        .epc-so-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-so-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#fff; background:#2563eb;
        }
        .epc-so-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); }
        .epc-so-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-so-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-so-kpi strong { display:block; font-size:1.45rem; font-variant-numeric:tabular-nums; }
        .epc-so-kpi span { color:#64748b; font-size:.78rem; }
        .epc-so-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-so-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-so-table th, .epc-so-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-so-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-so-table a { color:#c2410c; font-weight:700; text-decoration:none; }
        .epc-so-badge { display:inline-flex; padding:.15rem .45rem; border-radius:.3rem; font-size:.72rem; font-weight:700; background:#ffedd5; color:#9a3412; }
        .epc-so-note { margin-top:1rem; padding:.75rem .9rem; background:#fff7ed; border:1px solid #fdba74; border-radius:.45rem; color:#7c2d12; font-size:.86rem; }
        @@media (max-width:900px){ .epc-so-kpis{grid-template-columns:1fr;} }
    </style>

    <section class="epc-so-hero">
        <img src="@LegacyPresentationAssets.EpartsCartMarkUrl" alt="ECOM AE" style="height:28px;filter:brightness(1.1)" />
        <h1>Sales Orders</h1>
        <p>Operational finance, inventory, and approvals for this company.</p>
        <div class="epc-so-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/erp/app">ERP dashboard</a>
        </div>
    </section>

    <div class="epc-so-kpis" aria-label="Sales order KPIs">
        <div class="epc-so-kpi"><strong>@_orders.Count</strong><span>Shown (limit @_limit)</span></div>
        <div class="epc-so-kpi"><strong>@_open</strong><span>Non-closed in page</span></div>
        <div class="epc-so-kpi"><strong>@_totalAmount.ToString("N2", CultureInfo.InvariantCulture)</strong><span>Page total amount</span></div>
    </div>

    <div class="epc-so-table-wrap">
        <table class="epc-so-table">
            <thead>
                <tr>
                    <th>SO #</th>
                    <th>When</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_orders.Count == 0)
                {
                    <tr><td colspan="6">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var o in _orders)
                    {
                        var phpHref = $"{_phpTab}&order_id={o.Id.ToString(CultureInfo.InvariantCulture)}";
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(o.SoNo) ? $"#{o.Id}" : o.SoNo)</strong></td>
                            <td>@FormatTime(o.TimeCreated)</td>
                            <td>@o.CustomerUserId</td>
                            <td><span class="epc-so-badge">@o.Status</span></td>
                            <td>@o.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(phpHref)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=sales&tab=sales_orders";
    private bool _isAdmin;
    private IReadOnlyList<ErpSalesOrderDigest> _orders = [];
    private int _open;
    private decimal _totalAmount;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("erp"))
        {
            Nav.NavigateTo("/erp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.ListErpSalesOrdersAsync(_limit, ctx.RequestAborted);
        _orders = result.Orders;
        _open = _orders.Count(o => !string.Equals(o.Status, "closed", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(o.Status, "cancelled", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(o.Status, "canceled", StringComparison.OrdinalIgnoreCase));
        _totalAmount = _orders.Sum(o => o.TotalAmount);
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
