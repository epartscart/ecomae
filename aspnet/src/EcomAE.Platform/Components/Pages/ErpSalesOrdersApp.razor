@page "/erp/sales-orders-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Sales Orders · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Sales Orders" BreadcrumbArea="Order to Cash" BreadcrumbTab="Sales Orders">
    <PhpParityModuleBody AppPath="/erp/sales-orders-app" IsAdmin="_isAdmin" />


    
    <PhpErpModulePageHeader Title="@_title" Subtitle="@_subtitle" PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <p class="text-muted" style="margin:8px 0 12px;">
        <a href="/erp/sales-orders-app">Sales orders</a>
        · <a href="/erp/sales-orders-app?tab=subscriptions">Subscriptions</a>
    </p>

    @if (_view == "subscriptions")
    {
        <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Subscription KPIs">
            <div class="kpi"><div class="lbl">Active</div><div class="val">@_subs.Active.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">MRR</div><div class="val">@_subs.Mrr.ToString("N2", CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">ARR</div><div class="val">@_subs.Arr.ToString("N2", CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Recognised</div><div class="val">@_subs.Recognized.ToString("N2", CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Deferred</div><div class="val">@_subs.Deferred.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        </div>
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Customer</th>
                        <th>Plan</th>
                        <th>Cycle</th>
                        <th class="text-right">MRR</th>
                        <th class="text-right">Recognised</th>
                        <th class="text-right">Deferred</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_subscriptions.Count == 0)
                    {
                        <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No subscriptions yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                    }
                    else
                    {
                        @foreach (var s in _subscriptions)
                        {
                            <tr>
                                <td><strong>@(string.IsNullOrWhiteSpace(s.Code) ? $"#{s.Id}" : s.Code)</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(s.Customer) ? "—" : s.Customer)</td>
                                <td>@(string.IsNullOrWhiteSpace(s.PlanName) ? "—" : s.PlanName)</td>
                                <td>@s.Cycle</td>
                                <td class="text-right">@s.Mrr.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@s.Recognized.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@s.Deferred.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><span class="label label-default">@s.Status</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Sales order KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_orders.Count</div></div>
        <div class="kpi"><div class="lbl">Non-closed in page</div><div class="val">@_open</div></div>
        <div class="kpi"><div class="lbl">Page total amount</div><div class="val">@_totalAmount.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <div class="panel panel-default" id="epc-so-new">
            <div class="panel-heading"><strong>New sales order</strong> <span class="text-muted">SO number, VAT and totals follow the tenant jurisdiction kit.</span></div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-sm-2"><label for="so-customer">Customer user id</label><input id="so-customer" class="form-control" type="number" min="1" step="1" /></div>
                    <div class="col-sm-4"><label for="so-title">Title</label><input id="so-title" class="form-control" type="text" maxlength="255" /></div>
                    <div class="col-sm-2"><label for="so-amount">Amount (ex VAT)</label><input id="so-amount" class="form-control" type="number" min="0" step="0.01" readonly aria-describedby="so-amount-help" /><span id="so-amount-help" class="help-block small">Sum of lines</span></div>
                    <div class="col-sm-3"><label for="so-notes">Notes</label><input id="so-notes" class="form-control" type="text" /></div>
                    <div class="col-sm-1"><label for="so-save">&nbsp;</label><button id="so-save" type="button" class="btn btn-primary btn-block">Save</button></div>
                </div>

                <datalist id="erp-item-list">
                    @foreach (var item in _items)
                    {
                        <option value="@item.Sku" label="@item.Name"></option>
                    }
                </datalist>

                <div class="epc-erp-table-wrap" style="margin-top:10px">
                    <table class="table table-bordered table-condensed table-epc" id="so-lines">
                        <thead>
                            <tr>
                                <th style="width:22%">Item / SKU</th>
                                <th>Description</th>
                                <th style="width:12%">Qty</th>
                                <th style="width:15%">Unit price (ex VAT)</th>
                                <th style="width:15%">Line total</th>
                                <th style="width:6%">&nbsp;</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-right"><strong>Total (ex VAT)</strong></td>
                                <td id="so-lines-total">0.00</td>
                                <td>&nbsp;</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <button id="so-line-add" type="button" class="btn btn-default btn-xs">Add line</button>
                <select id="so-item-picker" class="form-control input-sm" style="display:inline-block;width:auto;margin-left:8px" aria-label="Link inventory item to the last line">
                    <option value="">-- Link Inventory Item --</option>
                    @foreach (var item in _items)
                    {
                        var price = item.SalesPrice.ToString("0.00", CultureInfo.InvariantCulture);
                        <option value="@item.Id.ToString(CultureInfo.InvariantCulture)"
                                data-sku="@item.Sku"
                                data-name="@item.Name"
                                data-price="@price">@item.Sku — @item.Name</option>
                    }
                </select>
                <input id="so-id" type="hidden" value="0" />
                <p id="so-feedback" class="text-muted" role="status" aria-live="polite"></p>
            </div>
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>SO #</th>
                    <th>When</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (_orders.Count == 0)
                {
                    <tr><td colspan="6">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live sales orders.")</td></tr>
                }
                else
                {
                    @foreach (var o in _orders)
                    {
                        var phpHref = $"{_phpTab}&order_id={o.Id.ToString(CultureInfo.InvariantCulture)}";
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(o.SoNo) ? $"#{o.Id}" : o.SoNo)</strong></td>
                            <td>@FormatTime(o.TimeCreated)</td>
                            <td>@o.CustomerUserId</td>
                            <td><span class="label label-default">@o.Status</span></td>
                            <td>@o.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>
                                <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(phpHref)">Open</a>
                                @if (_isAdmin)
                                {
                                    <span class="epc-so-actions" data-so-id="@o.Id.ToString(CultureInfo.InvariantCulture)">
                                        <button type="button" class="btn btn-link btn-xs epc-so-status" data-status="confirmed">Confirm</button>
                                        <button type="button" class="btn btn-link btn-xs epc-so-status" data-status="cancelled">Cancel</button>
                                        @if (o.Status is "draft" or "confirmed")
                                        {
                                            <button type="button" class="btn btn-link btn-xs epc-so-invoice">Invoice</button>
                                        }
                                        <button type="button" class="btn btn-link btn-xs epc-so-delete">Delete</button>
                                    </span>
                                }
                            </td>
                        </tr>
                        @if (o.Lines.Count > 0)
                        {
                            <tr class="epc-erp-doc-lines">
                                <td colspan="6">
                                    <table class="table table-condensed table-bordered" style="margin-bottom:0">
                                        <thead>
                                            <tr>
                                                <th style="width:22%">Item / SKU</th>
                                                <th>Description</th>
                                                <th style="width:12%" class="text-right">Qty</th>
                                                <th style="width:15%" class="text-right">Unit price</th>
                                                <th style="width:15%" class="text-right">Line total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var line in o.Lines)
                                            {
                                                <tr>
                                                    <td>@(string.IsNullOrWhiteSpace(line.ItemCode) ? "—" : line.ItemCode)</td>
                                                    <td>@line.Description</td>
                                                    <td class="text-right">@line.Qty.ToString("N3", CultureInfo.InvariantCulture)</td>
                                                    <td class="text-right">@line.UnitPriceExVat.ToString("N4", CultureInfo.InvariantCulture)</td>
                                                    <td class="text-right">@line.LineExVat.ToString("N2", CultureInfo.InvariantCulture)</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="4" class="text-right"><strong>Lines total (ex VAT)</strong></td>
                                                <td class="text-right">@o.Lines.Sum(l => l.LineExVat).ToString("N2", CultureInfo.InvariantCulture)</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
    }

</PhpErpDesktopChrome>

@if (_isAdmin && _view != "subscriptions")
{
    <script src="/erp/erp-sales-orders.js" defer></script>
}

@code {
    private string _phpTab = "/ERP/?epc_erp_shell=1&area=sales&tab=sales_orders";
    private string _title = "Sales Orders";
    private string _subtitle = "Sales orders with line totals.";
    private string _view = "sales_orders";
    private bool _isAdmin;
    private IReadOnlyList<ErpSalesOrderDigest> _orders = [];
    private IReadOnlyList<ErpInventoryItemPickerDigest> _items = [];
    private ErpSubscriptionsSummary _subs = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<ErpSubscriptionDigest> _subscriptions = [];
    private int _open;
    private decimal _totalAmount;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var tab = (ctx.Request.Query["tab"].ToString() ?? "").Trim().ToLowerInvariant();
        _view = tab == "subscriptions" ? "subscriptions" : "sales_orders";
        _phpTab = _view == "subscriptions"
            ? "/ERP/?epc_erp_shell=1&area=sales&tab=subscriptions"
            : "/ERP/?epc_erp_shell=1&area=sales&tab=sales_orders";
        _title = _view == "subscriptions" ? "Subscriptions" : "Sales Orders";
        _subtitle = _view == "subscriptions"
            ? "Recurring plans, MRR / ARR and straight-line revenue recognition."
            : "Sales orders with line totals.";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        if (_view == "subscriptions")
        {
            var subs = await Dashboards.BuildErpSubscriptionsDigestAsync(_limit, ctx.RequestAborted);
            _subs = subs.Summary;
            _subscriptions = subs.Subscriptions;
            _source = subs.Source;
            _message = subs.Message;
            return;
        }

        var result = await Dashboards.ListErpSalesOrdersAsync(_limit, ctx.RequestAborted);
        _orders = result.Orders;
        _items = (await Dashboards.ListErpInventoryItemsForPickerAsync(1000, ctx.RequestAborted)).Items;
        _open = _orders.Count(o => !string.Equals(o.Status, "closed", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(o.Status, "cancelled", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(o.Status, "canceled", StringComparison.OrdinalIgnoreCase));
        _totalAmount = _orders.Sum(o => o.TotalAmount);
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
