@page "/erp/sales-orders-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Sales Orders · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Sales Orders" BreadcrumbArea="Order to Cash" BreadcrumbTab="Sales Orders">

    
    <PhpErpModulePageHeader Title="Sales Orders" Subtitle="ASP.NET Core digest — PHP compare only under /php-reference/*." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />


    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Sales order KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_orders.Count</div></div>
        <div class="kpi"><div class="lbl">Non-closed in page</div><div class="val">@_open</div></div>
        <div class="kpi"><div class="lbl">Page total amount</div><div class="val">@_totalAmount.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <div class="panel panel-default" id="epc-so-new">
            <div class="panel-heading"><strong>New sales order</strong> <span class="text-muted">SO number, VAT and totals follow the tenant jurisdiction kit.</span></div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-sm-2"><label for="so-customer">Customer user id</label><input id="so-customer" class="form-control" type="number" min="1" step="1" /></div>
                    <div class="col-sm-4"><label for="so-title">Title</label><input id="so-title" class="form-control" type="text" maxlength="255" /></div>
                    <div class="col-sm-2"><label for="so-amount">Amount (ex VAT)</label><input id="so-amount" class="form-control" type="number" min="0" step="0.01" /></div>
                    <div class="col-sm-3"><label for="so-notes">Notes</label><input id="so-notes" class="form-control" type="text" /></div>
                    <div class="col-sm-1"><label for="so-save">&nbsp;</label><button id="so-save" type="button" class="btn btn-primary btn-block">Save</button></div>
                </div>
                <input id="so-id" type="hidden" value="0" />
                <p id="so-feedback" class="text-muted" role="status" aria-live="polite"></p>
            </div>
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>SO #</th>
                    <th>When</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (_orders.Count == 0)
                {
                    <tr><td colspan="6">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "Nothing to show yet." : _message) : "Sign in with ERP capability for live sales orders.")</td></tr>
                }
                else
                {
                    @foreach (var o in _orders)
                    {
                        var phpHref = $"{_phpTab}&order_id={o.Id.ToString(CultureInfo.InvariantCulture)}";
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(o.SoNo) ? $"#{o.Id}" : o.SoNo)</strong></td>
                            <td>@FormatTime(o.TimeCreated)</td>
                            <td>@o.CustomerUserId</td>
                            <td><span class="label label-default">@o.Status</span></td>
                            <td>@o.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>
                                <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(phpHref)">Open</a>
                                @if (_isAdmin)
                                {
                                    <span class="epc-so-actions" data-so-id="@o.Id.ToString(CultureInfo.InvariantCulture)">
                                        <button type="button" class="btn btn-link btn-xs epc-so-status" data-status="confirmed">Confirm</button>
                                        <button type="button" class="btn btn-link btn-xs epc-so-status" data-status="cancelled">Cancel</button>
                                        @if (o.Status is "draft" or "confirmed")
                                        {
                                            <button type="button" class="btn btn-link btn-xs epc-so-invoice">Invoice</button>
                                        }
                                        <button type="button" class="btn btn-link btn-xs epc-so-delete">Delete</button>
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@if (_isAdmin)
{
    <script src="/erp/erp-sales-orders.js" defer></script>
}

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=sales&tab=sales_orders";
    private bool _isAdmin;
    private IReadOnlyList<ErpSalesOrderDigest> _orders = [];
    private int _open;
    private decimal _totalAmount;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListErpSalesOrdersAsync(_limit, ctx.RequestAborted);
        _orders = result.Orders;
        _open = _orders.Count(o => !string.Equals(o.Status, "closed", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(o.Status, "cancelled", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(o.Status, "canceled", StringComparison.OrdinalIgnoreCase));
        _totalAmount = _orders.Sum(o => o.TotalAmount);
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
