@page "/storefront/app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>eParts Cart (Autoparts)</PageTitle>
<PhpChromeStyles Surface="storefront" />
<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<PhpStorefrontDesktopChrome>
    <PhpHybridWorkspaceFrame PhpHref="@_phpHref" ClearHref="/storefront/app" />

    @if (string.IsNullOrWhiteSpace(_phpHref))
    {
        @* PHP piston hero banner + engine animation (epc_automotive_spareparts_piston_banner.php) *@
        <PhpAspPistonBanner />

        <div class="epc-asp-home-banners" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:.75rem;margin:1rem 0 1.25rem">
            <a href="https://epartscart.com/shop/part_search" style="display:block;padding:1rem;border-radius:.7rem;background:linear-gradient(135deg,#dc2626,#991b1b);color:#fff;text-decoration:none">
                <strong style="display:block;margin-bottom:.25rem"><i class="fa fa-barcode"></i> Search by part number</strong>
                <span style="font-size:.85rem;opacity:.9">Quickly check price, availability and delivery time.</span>
            </a>
            <a href="https://epartscart.com/" style="display:block;padding:1rem;border-radius:.7rem;background:linear-gradient(135deg,#2563eb,#1e3a8a);color:#fff;text-decoration:none">
                <strong style="display:block;margin-bottom:.25rem"><i class="fa fa-shield"></i> Trusted brands</strong>
                <span style="font-size:.85rem;opacity:.9">Browse available manufacturers and product lines.</span>
            </a>
            <a href="https://epartscart.com/" style="display:block;padding:1rem;border-radius:.7rem;background:linear-gradient(135deg,#059669,#065f46);color:#fff;text-decoration:none">
                <strong style="display:block;margin-bottom:.25rem"><i class="fa fa-sitemap"></i> Electronic catalog</strong>
                <span style="font-size:.85rem;opacity:.9">Find parts through vehicle catalog navigation.</span>
            </a>
        </div>

        <PhpHybridModuleDirectory
            Title="Storefront surface directory"
            Subtitle="Commerce UX remains on live PHP storefront hosts — every surface linked"
            Links="@PhpModuleCatalog.StorefrontSurfaces"
            PhpWorkspaceBase="/storefront/app" />

        <div class="epc-sf-note" style="margin:1rem 0;padding:.8rem;background:#fff8e8;color:#7a4e00;border-radius:.45rem;font-size:.88rem">
            Live homepage remains <a href="https://epartscart.com/">epartscart.com</a> (authoritative hero/slider media).
            ASP.NET preview reuses PHP piston CSS classes + industry attrs — not a broad `/` cutover.
        </div>
    }
</PhpStorefrontDesktopChrome>

@code {
    private string? _phpHref;

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        if (ctx?.Request.Query.TryGetValue("php", out var php) == true && !string.IsNullOrWhiteSpace(php))
        {
            _phpHref = php.ToString();
        }
    }
}
