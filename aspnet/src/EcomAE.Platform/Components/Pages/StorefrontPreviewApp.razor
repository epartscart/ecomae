@page "/storefront/app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>@_pageTitle</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" />
<StorefrontAnalytics Enabled="false" IncludeClarity="true" ClarityId="xoflbamawu" />

<PhpStorefrontDesktopChrome>
    <PhpHybridWorkspaceFrame PhpHref="@_phpHref" ClearHref="/storefront/app" />

    @if (string.IsNullOrWhiteSpace(_phpHref))
    {
        @* PHP piston hero banner + engine animation (epc_automotive_spareparts_piston_banner.php) *@
        <PhpAspPistonBanner />
        <PhpStorefrontHomeDepth />

        <PhpHybridModuleDirectory
            Title="Storefront surface directory"
            Subtitle="Storefront browse, account, and checkout surfaces"
            Links="@PhpModuleCatalog.StorefrontSurfaces"
            PhpWorkspaceBase="/storefront/app" />
    }
</PhpStorefrontDesktopChrome>

@code {
    private string? _phpHref;
    private string _pageTitle = "eParts Cart (Autoparts)";

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        _pageTitle = StorefrontIndustryHostResolver.ResolveStorefrontTitle(ctx?.Request.Host.Host);
        if (ctx?.Request.Query.TryGetValue("php", out var php) == true && !string.IsNullOrWhiteSpace(php))
        {
            _phpHref = php.ToString();
        }
    }
}
