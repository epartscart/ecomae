@page "/storefront/app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>eParts Cart (Autoparts)</PageTitle>
<PhpChromeStyles Surface="storefront" />
<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<PhpStorefrontDesktopChrome>
    <PhpHybridWorkspaceFrame PhpHref="@_phpHref" ClearHref="/storefront/app" />

    @if (string.IsNullOrWhiteSpace(_phpHref))
    {
        <style>
            .epc-sf-hero {
                display:grid; grid-template-columns:1.2fr .9fr; gap:1.2rem; align-items:center;
                padding:1.4rem 0 1.8rem; color:#f8fafc; border-radius:.7rem; margin-bottom:1rem;
                background:radial-gradient(900px 500px at 20% 0%,rgba(220,38,38,.25),transparent 55%), linear-gradient(180deg,#0b1220,#111827);
            }
            .epc-sf-hero-inner { display:grid; grid-template-columns:1.2fr .9fr; gap:1.2rem; padding:0 1rem; }
            .epc-sf-pill { display:inline-block; padding:.25rem .55rem; border-radius:999px; background:rgba(220,38,38,.2); color:#fecaca; font-size:.72rem; font-weight:700; }
            .epc-sf-hero h1 { margin:.45rem 0 .7rem; font-size:clamp(1.5rem,3.2vw,2.2rem); line-height:1.12; }
            .epc-sf-hero .lede { color:#cbd5e1; max-width:34rem; line-height:1.5; margin:0 0 1rem; }
            .epc-sf-cta-row { display:flex; gap:.4rem; flex-wrap:wrap; }
            .epc-sf-btn { display:inline-flex; padding:.55rem .8rem; border-radius:.4rem; font-weight:700; font-size:.85rem; border:1px solid transparent; text-decoration:none; }
            .epc-sf-btn-red { background:#dc2626; color:#fff; }
            .epc-sf-btn-ghost { background:transparent; border-color:rgba(255,255,255,.35); color:#fff; }
            .epc-sf-feats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.55rem; margin-top:1rem; }
            .epc-sf-feat { background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1); border-radius:.5rem; padding:.7rem .75rem; font-size:.78rem; font-weight:700; }
            .epc-sf-media { background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.12); border-radius:.8rem; min-height:200px; padding:1rem; display:flex; flex-direction:column; justify-content:flex-end; }
            .epc-sf-note { margin:1rem 0; padding:.8rem; background:#fff8e8; color:#7a4e00; border-radius:.45rem; font-size:.88rem; }
            @@media (max-width:900px){ .epc-sf-hero-inner,.epc-sf-feats{grid-template-columns:1fr;} }
        </style>

        <section class="epc-sf-hero">
            <div class="epc-sf-hero-inner">
                <div>
                    <span class="epc-sf-pill">PROFESSIONAL AUTO SPARE PARTS STORE</span>
                    <h1>Find genuine and aftermarket spare parts faster, cleaner, and with confidence.</h1>
                    <p class="lede">Batch 2 modex chrome: header-top-line, header-full-top search, navbar. Cart/checkout remain on live PHP storefront.</p>
                    <div class="epc-sf-cta-row">
                        <a class="epc-sf-btn epc-sf-btn-red" href="https://epartscart.com/shop/part_search">Search parts</a>
                        <a class="epc-sf-btn epc-sf-btn-ghost" href="https://epartscart.com/">Open catalog</a>
                    </div>
                    <div class="epc-sf-feats">
                        <div class="epc-sf-feat">FAST ARTICLE SEARCH</div>
                        <div class="epc-sf-feat">VIN REQUEST SUPPORT</div>
                        <div class="epc-sf-feat">AED</div>
                    </div>
                </div>
                <div class="epc-sf-media">
                    <strong>Piston power animation</strong>
                    <p style="margin:.4rem 0 0;color:#cbd5e1;font-size:.9rem">Live media remains on PHP storefront.</p>
                </div>
            </div>
        </section>

        <PhpHybridModuleDirectory
            Title="Storefront surface directory"
            Subtitle="Commerce UX remains on live PHP storefront hosts — every surface linked"
            Links="@PhpModuleCatalog.StorefrontSurfaces"
            PhpWorkspaceBase="/storefront/app" />

        <div class="epc-sf-note">
            Live homepage remains <a href="https://epartscart.com/">epartscart.com</a>. Digests: <a href="/storefront/account-summary">account-summary</a>. Not a broad `/` cutover.
        </div>
    }
</PhpStorefrontDesktopChrome>

@code {
    private string? _phpHref;

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        if (ctx?.Request.Query.TryGetValue("php", out var php) == true && !string.IsNullOrWhiteSpace(php))
        {
            _phpHref = php.ToString();
        }
    }
}
