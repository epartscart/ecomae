@page "/storefront/app"
@page "/storefront"
@page "/storefront/"
@page "/en"
@page "/en/"
@page "/ar"
@page "/ar/"
@page "/me"
@page "/me/"
@page "/ru"
@page "/ru/"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>@_pageTitle</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" IncludePublicSeo="true" />
<PhpChromeBodyClass Surface="storefront" />
@* Live epartscart `/` proxies here (ASP.NET). Public SEO via IncludePublicSeo; PHP product only via /php-reference/*. *@

@if (!string.IsNullOrEmpty(_tenantSnapshotHtml))
{
    @* Custom storefront package (electronicae / stylenlook / thejewellerytrend / taxofinca):
       PHP renders package header + home + newsletter + footer instead of the nero chrome.
       Snapshot is the PHP-rendered output (scripts/render_php_home_snapshots.php). *@
    <div class="epc-php-font-root">
        @((MarkupString)_tenantSnapshotHtml)
    </div>
}
else
{
    <PhpStorefrontDesktopChrome>
        <HomeContent>
            @if (string.IsNullOrWhiteSpace(_phpHref))
            {
                @* Same slot + order as PHP templates/nero/desktop.php home — rendered
                   BEFORE #sb-site so professional-shell #Container ink rules never
                   darken the hero/VIN text (invisible-text live bug). *@
                <PhpAspPistonBanner
                    SearchHref="@_home.Parts"
                    CatalogHref="@_home.Umapi"
                    BrandsHref="@_home.Brands" />
                <PhpAspHomeBanners
                    PartsHref="@_home.Parts"
                    BrandsHref="@_home.Brands"
                    CatalogHref="@_home.Umapi"
                    VinHref="@_home.Vin" />
                <PhpVinRequestSection SellerHref="@_home.Vin" />
                <PhpEpartFrontSections LangHref="@_home.Lang" />
            }
        </HomeContent>
        <ChildContent>
            @if (!string.IsNullOrWhiteSpace(_phpHref))
            {
                <div class="epc-sf-preview-note" style="max-width:52rem;margin:1rem 0;padding:1rem 1.25rem;border:1px solid #fde68a;background:#fffbeb;border-radius:.5rem;font:600 .9rem/1.45 system-ui,sans-serif;color:#78350f;">
                    Workspace preview query is ignored for product clicks.
                    Continue on the <a href="/">storefront home</a> or <a href="@StorefrontSurfaceLinks.PartSearch">search</a>.
                </div>
            }
        </ChildContent>
    </PhpStorefrontDesktopChrome>
}

@code {
    private string? _phpHref;
    private string _pageTitle = "eParts Cart (Autoparts)";
    private string _tenantSnapshotHtml = string.Empty;
    private (string Lang, string Parts, string Umapi, string Brands, string Vin) _home =
        ("/en", "/en/parts", "/en/umapi_catalog", "/en/available-brands", "/en/zapros-prodavczu");

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        var host = ctx?.Request.Host.Host ?? string.Empty;
        _pageTitle = StorefrontIndustryHostResolver.ResolveStorefrontTitle(host);
        var attrs = StorefrontIndustryHostResolver.Resolve(host);
        if (PhpTenantHomeSnapshots.IsCustomPackage(attrs.StorefrontPackage))
        {
            _tenantSnapshotHtml = PhpTenantHomeSnapshots.HtmlFor(attrs.StorefrontPackage);
        }

        var lang = StorefrontPhpHomeLinks.LangHref(ctx);
        _home = (
            lang,
            StorefrontPhpHomeLinks.Parts(lang),
            StorefrontPhpHomeLinks.UmapiCatalog(lang),
            StorefrontPhpHomeLinks.AvailableBrands(lang),
            StorefrontPhpHomeLinks.SellerRequest(lang));

        if (ctx?.Request.Query.TryGetValue("php", out var php) == true && !string.IsNullOrWhiteSpace(php))
        {
            _phpHref = php.ToString();
        }
    }
}
