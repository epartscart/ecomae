@page "/storefront/app"
@page "/storefront"
@page "/storefront/"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>@_pageTitle</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" />
@* Live epartscart `/` proxies here (ASP.NET). PHP style chrome; PHP product only via /php-reference/*. *@

<PhpStorefrontDesktopChrome>
    @if (string.IsNullOrWhiteSpace(_phpHref))
    {
        <PhpAspPistonBanner
            SearchHref="@StorefrontPhpCanonical.PartSearch"
            CatalogHref="@StorefrontPhpCanonical.UmapiCatalog"
            BrandsHref="@StorefrontPhpCanonical.AvailableBrands" />
        <PhpStorefrontHomeDepth
            BrandsHref="@StorefrontPhpCanonical.UmapiCatalog"
            CatalogHref="@StorefrontPhpCanonical.ProductFamily"
            VinHref="@StorefrontPhpCanonical.LaximoVin" />

        @* Hybrid module directory omitted on live home — catalog/search use PHP /en/… canonical. *@
    }
    else
    {
        <div class="epc-sf-preview-note" style="max-width:52rem;margin:1rem 0;padding:1rem 1.25rem;border:1px solid #fde68a;background:#fffbeb;border-radius:.5rem;font:600 .9rem/1.45 system-ui,sans-serif;color:#78350f;">
            Workspace preview query is ignored for product clicks.
            Continue on the <a href="/">storefront home</a> or <a href="@StorefrontPhpCanonical.PartSearch">search</a>.
        </div>
    }
</PhpStorefrontDesktopChrome>

@code {
    private string? _phpHref;
    private string _pageTitle = "eParts Cart (Autoparts)";

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        var host = ctx?.Request.Host.Host ?? string.Empty;
        _pageTitle = StorefrontIndustryHostResolver.ResolveStorefrontTitle(host);
        if (ctx?.Request.Query.TryGetValue("php", out var php) == true && !string.IsNullOrWhiteSpace(php))
        {
            _phpHref = php.ToString();
        }
    }
}
