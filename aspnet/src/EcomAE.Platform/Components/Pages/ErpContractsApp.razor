@page "/erp/contracts-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Contracts · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Contracts" BreadcrumbArea="Sales" BreadcrumbTab="Contracts">

    <PhpErpModulePageHeader Title="Contracts register" Subtitle="Open a row for the 280-character body and OCR excerpts. Save, sign, and OCR stay on this page." PhpTabHref="/ERP/?epc_erp_shell=1&amp;area=sales&amp;tab=contracts" />
    <PhpErpD365ActionPane PhpTabHref="/ERP/?epc_erp_shell=1&amp;area=sales&amp;tab=contracts" RefreshHref="@Nav.Uri" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form id="erp-module-new" method="post" action="/erp/contracts/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/contracts-app" />
            <label>Code <input name="code" required maxlength="40" style="width:7rem" /></label>
            <label>Title <input name="title" required maxlength="200" style="width:12rem" /></label>
            <label>Counterparty <input name="counterparty" maxlength="200" style="width:10rem" /></label>
            <label>Value <input type="number" name="contract_value" min="0" step="0.01" value="0" style="width:6rem" /></label>
            <label>Currency <input name="currency" value="AED" maxlength="3" style="width:3.5rem" /></label>
            <button type="submit">Save contract</button>
        </form>
        <form method="post" action="/erp/ajax/ctr-status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/contracts-app" />
            <label>Contract id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <label>Status
                <select name="status">
                    <option value="draft">draft</option>
                    <option value="sent">sent</option>
                    <option value="signed">signed</option>
                    <option value="active">active</option>
                    <option value="expired">expired</option>
                    <option value="terminated">terminated</option>
                </select>
            </label>
            <button type="submit">Set status</button>
        </form>
        <form method="post" action="/erp/contracts/sign" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/contracts-app" />
            <label>Contract id <input type="number" name="contract_id" style="width:6rem" /></label>
            <label>Signer <input name="signer_name" placeholder="Name" style="width:10rem" /></label>
            <label>Email <input name="signer_email" placeholder="Email" style="width:12rem" /></label>
            <button type="submit">Sign</button>
        </form>
        <form method="post" action="/erp/contracts/ocr" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/contracts-app" />
            <label>Contract id <input type="number" name="contract_id" style="width:6rem" /></label>
            <label>OCR text <input name="text" placeholder="Extracted text" style="width:16rem" /></label>
            <button type="submit">Save OCR</button>
        </form>
    }

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Id</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Code</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Code) ? "—" : _opened.Code)</dd>
                <dt>Title</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Title) ? "—" : _opened.Title)</dd>
                <dt>Counterparty</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Counterparty) ? "—" : _opened.Counterparty)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Status) ? "—" : _opened.Status)</dd>
                <dt>Value</dt><dd>@_opened.ContractValue.ToString("N2", CultureInfo.InvariantCulture) @(string.IsNullOrWhiteSpace(_opened.Currency) ? "AED" : _opened.Currency)</dd>
                <dt>Start</dt><dd>@FormatDate(_opened.StartDate)</dd>
                <dt>End</dt><dd>@FormatDate(_opened.EndDate)</dd>
                <dt>Version</dt><dd>@_opened.Version.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Created</dt><dd>@FormatDate(_opened.TimeCreated)</dd>
                <dt>Updated</dt><dd>@FormatDate(_opened.TimeUpdated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Signature hashes stay off this pane. Save, sign, and OCR stay on this page.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.BodyExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">body excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.BodyExcerpt</pre>
                @if (_opened.BodyLen > _opened.BodyExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.BodyExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.BodyLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No body excerpt yet.</p>
            }
            @if (!string.IsNullOrWhiteSpace(_opened.OcrExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">OCR excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.OcrExcerpt</pre>
                @if (_opened.OcrLen > _opened.OcrExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.OcrExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.OcrLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No OCR excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Title</th>
                            <th>Counterparty</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Code) ? "—" : sib.Code)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Title) ? "—" : sib.Title)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Counterparty) ? "—" : sib.Counterparty)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "contract_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Contract KPIs">
        <div class="kpi"><div class="lbl">Contracts</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Value</div><div class="val">@_value.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Title</th>
                    <th>Counterparty</th>
                    <th class="text-right">Value</th>
                    <th>Currency</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_contracts.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No contracts yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _contracts)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@(string.IsNullOrWhiteSpace(row.Code) ? "—" : row.Code)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Title) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Title)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Counterparty) ? "—" : row.Counterparty)</td>
                            <td class="text-right">@row.ContractValue.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Currency) ? "AED" : row.Currency)</td>
                            <td>@FormatDate(row.StartDate)</td>
                            <td>@FormatDate(row.EndDate)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "contract_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _listHref = "/erp/contracts-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpContractDigest> _contracts = [];
    private int _count;
    private int _active;
    private decimal _value;
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private ErpContractDetail? _opened;
    private IReadOnlyList<ErpContractDigest> _openedSiblings = [];

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?contract_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedCaption => _opened is null
        ? ""
        : (string.IsNullOrWhiteSpace(_opened.Title) ? $"Contract #{_opened.Id}" : _opened.Title) + " · " + _opened.Status;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "contract_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpContractsAsync(200, ctx.RequestAborted);
        _contracts = result.Contracts;
        _count = result.Count;
        _active = result.ActiveCount;
        _value = result.ValueTotal;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpContractDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Contract;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _contracts.FirstOrDefault(c => c.Id == _openedId);
                if (openedList is not null)
                {
                    _contracts = new[] { openedList }.Concat(_contracts.Where(c => c.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }

    private static string FormatDate(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
