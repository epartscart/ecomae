@page "/erp/contracts-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Contracts · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Contracts" BreadcrumbArea="Sales" BreadcrumbTab="Contracts">

    <PhpErpModulePageHeader Title="Contracts register" Subtitle="Save a contract or set status here. Sign and OCR stay on the Classic twin." />
    <PhpErpD365ActionPane RefreshHref="@Nav.Uri" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/contracts/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/contracts-app" />
            <label>Code <input name="code" required maxlength="40" style="width:7rem" /></label>
            <label>Title <input name="title" required maxlength="200" style="width:12rem" /></label>
            <label>Counterparty <input name="counterparty" maxlength="200" style="width:10rem" /></label>
            <label>Value <input type="number" name="contract_value" min="0" step="0.01" value="0" style="width:6rem" /></label>
            <label>Currency <input name="currency" value="AED" maxlength="3" style="width:3.5rem" /></label>
            <button type="submit">Save contract</button>
        </form>
        <form method="post" action="/erp/ajax/ctr-status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/contracts-app" />
            <label>Contract id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <label>Status
                <select name="status">
                    <option value="draft">draft</option>
                    <option value="sent">sent</option>
                    <option value="signed">signed</option>
                    <option value="active">active</option>
                    <option value="expired">expired</option>
                    <option value="terminated">terminated</option>
                </select>
            </label>
            <button type="submit">Set status</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Contract KPIs">
        <div class="kpi"><div class="lbl">Contracts</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Value</div><div class="val">@_value.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Title</th>
                    <th>Counterparty</th>
                    <th class="text-right">Value</th>
                    <th>Currency</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_contracts.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No contracts yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _contracts)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(row.Code) ? "—" : row.Code)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Title) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Title)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Counterparty) ? "—" : row.Counterparty)</td>
                            <td class="text-right">@row.ContractValue.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Currency) ? "AED" : row.Currency)</td>
                            <td>@FormatDate(row.StartDate)</td>
                            <td>@FormatDate(row.EndDate)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td><a href="/erp/contracts-app">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Sign and OCR stay on the Classic twin.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private IReadOnlyList<ErpContractDigest> _contracts = [];
    private int _count;
    private int _active;
    private decimal _value;
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpContractsAsync(200, ctx.RequestAborted);
        _contracts = result.Contracts;
        _count = result.Count;
        _active = result.ActiveCount;
        _value = result.ValueTotal;
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatDate(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
