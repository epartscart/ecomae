@page "/erp/contracts-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IErpContractSaveDryRun ContractSave
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Contracts · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Contracts" BreadcrumbArea="Sales" BreadcrumbTab="Contracts">

    <PhpErpModulePageHeader Title="Contracts register" Subtitle="Counterparty, value and status. Body and OCR stay off this list. Saves stay dry-run." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Contract KPIs">
        <div class="kpi"><div class="lbl">Contracts</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Value</div><div class="val">@_value.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <form @onsubmit="OnSave" @onsubmit:preventDefault="true" style="margin:12px 0;padding:10px;border:1px solid #c5d4de;background:#fff;">
            <strong>New contract (dry-run)</strong>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;align-items:end;">
                <label>Code <input class="form-control" @bind="_formCode" /></label>
                <label>Title <input class="form-control" @bind="_formTitle" /></label>
                <button type="submit" class="btn btn-primary">Validate save</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_formResult))
            {
                <p style="margin:8px 0 0;font-size:12px;">@_formResult</p>
            }
        </form>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Title</th>
                    <th>Counterparty</th>
                    <th class="text-right">Value</th>
                    <th>Currency</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_contracts.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No contracts yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _contracts)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(row.Code) ? "—" : row.Code)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Title) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Title)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Counterparty) ? "—" : row.Counterparty)</td>
                            <td class="text-right">@row.ContractValue.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Currency) ? "AED" : row.Currency)</td>
                            <td>@FormatDate(row.StartDate)</td>
                            <td>@FormatDate(row.EndDate)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Dry-run: <code>ctr_save</code> — writes=0.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=sales&tab=contracts";
    private bool _isAdmin;
    private IReadOnlyList<ErpContractDigest> _contracts = [];
    private int _count;
    private int _active;
    private decimal _value;
    private string _source = "n/a";
    private string _message = "";
    private string _formCode = "";
    private string _formTitle = "";
    private string _formResult = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpContractsAsync(200, ctx.RequestAborted);
        _contracts = result.Contracts;
        _count = result.Count;
        _active = result.ActiveCount;
        _value = result.ValueTotal;
        _source = result.Source;
        _message = result.Message;
    }

    private void OnSave()
    {
        var result = ContractSave.Evaluate(new ErpContractSaveRequest(_formCode, _formTitle, 0, false));
        _formResult = $"{result.Status}: {result.Detail} (writes={result.Writes.ToString(CultureInfo.InvariantCulture)})";
    }

    private static string FormatDate(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
