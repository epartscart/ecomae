@page "/cp/product-catalogue-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Product catalogue · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
@foreach (var href in LegacyPresentationAssets.CpUsersConsoleStylesheets)
{
    <link rel="stylesheet" href="@href" />
}

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <PhpParityModuleBody AppPath="/cp/product-catalogue-app" IsAdmin="_isAdmin" />


    <PhpCpModulePageHeader Title="Product catalogue"
                           Subtitle="Min-limit, templates, line/tree lists, brunch, SKU profile/spec/photo-meta, homepage slots, special searches, and the catalogue tree write here. SKU photo file upload, item images, template file upload, special-search images, category images, and drag-tree UX stay on the compare twin."
                           PhpTabHref="@_phpTab">
        <a class="ghost" href="/cp/prices-upload-app">Prices upload</a>
        <a class="ghost" href="/cp/crosses-app">Crosses</a>
        <a class="ghost" href="/cp/accessories-app">Accessories</a>
    </PhpCpModulePageHeader>

    <div class="epc-scp-tool-grid" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;margin-bottom:1rem;">
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="#line-lists">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">Line lists</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">Save / delete write here. Drag-tree stays Classic.</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="#tree-lists">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">Tree lists</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">Save / delete / brunch write here. Item images stay Classic.</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="#homepage-slots">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">Homepage slots</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">Save writes here. Drag-tree stays Classic.</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref("/CP/shop/catalogue/related_products")">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">Related</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">PHP related_products</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref("/CP/shop/catalogue/reviews")">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">Reviews</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">PHP reviews</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="#sku-media">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">SKU media</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">Profile / spec / photo-meta write here. Photo file upload stays Classic.</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="#special-searches">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">Special searches</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">Save / delete write here. Image upload stays Classic.</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="#catalogue-tree">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">Catalogue tree</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">Save writes here. Images and drag-tree stay Classic.</p>
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/catalogue/set-min-limit" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(_selectedId > 0 ? "/cp/product-catalogue-app?product_id=" + _selectedId.ToString(CultureInfo.InvariantCulture) : "/cp/product-catalogue-app")" />
            <input type="hidden" name="action" value="enable" />
            <label>Product id <input type="number" name="productId" min="1" required value="@(_selectedId > 0 ? _selectedId.ToString(CultureInfo.InvariantCulture) : "")" style="width:6rem" /></label>
            <label>min_limit_enable
                <select name="enabled">
                    <option value="1">1 · on</option>
                    <option value="0">0 · off</option>
                </select>
            </label>
            <button type="submit" class="btn btn-xs btn-primary">Save flag</button>
        </form>
        <form method="post" action="/cp/catalogue/set-min-limit" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(_selectedId > 0 ? "/cp/product-catalogue-app?product_id=" + _selectedId.ToString(CultureInfo.InvariantCulture) : "/cp/product-catalogue-app")" />
            <input type="hidden" name="action" value="value" />
            <label>Product id <input type="number" name="productId" min="1" required value="@(_selectedId > 0 ? _selectedId.ToString(CultureInfo.InvariantCulture) : "")" style="width:6rem" /></label>
            <label>min_limit <input type="number" name="value" min="0" step="1" required style="width:6rem" /></label>
            <button type="submit" class="btn btn-xs btn-default">Save value</button>
        </form>
        <form id="category-templates" method="post" action="/cp/catalogue/templates-actions" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/product-catalogue-app" />
            <input type="hidden" name="action" value="create" />
            <input type="hidden" name="imageType" value="from_input" />
            <div style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <label>Caption <input type="text" name="caption" required /></label>
                <label>Image name <input type="text" name="imageName" placeholder="optional" /></label>
            </div>
            <label>Category object JSON
                <textarea name="categoryObject" rows="3" style="width:100%;font-family:monospace" placeholder='{"id":1,"value":"Root"}'></textarea>
            </label>
            <label>Image base64 (optional — file upload stays Classic)
                <textarea name="imageBase64" rows="2" style="width:100%;font-family:monospace" placeholder="optional"></textarea>
            </label>
            <button type="submit">Create template</button>
        </form>
        <form method="post" action="/cp/catalogue/templates-actions" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/product-catalogue-app" />
            <input type="hidden" name="action" value="delete" />
            <label>Category template id <input type="number" name="templateId" min="1" required style="width:6rem" /></label>
            <button type="submit" class="btn btn-xs btn-default">Delete template</button>
        </form>
        <form id="line-lists" method="post" action="/cp/catalogue/line-lists/write" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/product-catalogue-app" />
            <input type="hidden" name="langCode" value="en" />
            <div style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <label>Action
                    <select name="action">
                        <option value="create">create</option>
                        <option value="edit">edit</option>
                    </select>
                </label>
                <label>List id <input type="number" name="listId" min="0" value="0" style="width:6rem" title="0 = create" /></label>
                <label>Caption <input type="text" name="caption" /></label>
                <label>Type
                    <select name="type">
                        <option value="1">1</option>
                        <option value="2">2</option>
                    </select>
                </label>
                <label>Data type
                    <select name="dataType">
                        <option value="text">text</option>
                        <option value="number">number</option>
                    </select>
                </label>
                <label>Auto sort
                    <select name="autoSort">
                        <option value="no">no</option>
                        <option value="asc">asc</option>
                        <option value="desc">desc</option>
                    </select>
                </label>
            </div>
            <label>Items JSON
                <textarea name="itemsJson" rows="4" style="width:100%;font-family:monospace" placeholder='[{"value":"Red"}] or [{"id":1,"value":"Red","value_lang_str_id":"..."}]'></textarea>
            </label>
            <button type="submit">Save line list</button>
        </form>
        <form method="post" action="/cp/catalogue/line-lists/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/product-catalogue-app" />
            <input type="hidden" name="action" value="delete" />
            <label>Ids <input type="text" name="ids" required placeholder="[1] or 1,2" /></label>
            <button type="submit">Delete line lists</button>
        </form>
        <form id="tree-lists" method="post" action="/cp/catalogue/tree-lists/write" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/product-catalogue-app" />
            <input type="hidden" name="langCode" value="en" />
            <div style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <label>Action
                    <select name="action">
                        <option value="create">create</option>
                        <option value="edit">edit</option>
                    </select>
                </label>
                <label>List id <input type="number" name="listId" min="0" value="0" style="width:6rem" title="0 = create" /></label>
                <label>Caption <input type="text" name="caption" /></label>
                <label>Data type
                    <select name="dataType">
                        <option value="text">text</option>
                        <option value="number">number</option>
                    </select>
                </label>
            </div>
            <label>Tree JSON
                <textarea name="treeJson" rows="4" style="width:100%;font-family:monospace" placeholder='[{"id":1,"value":"Root","$count":0,"$level":1,"$parent":0}]'></textarea>
            </label>
            <button type="submit">Save tree list</button>
        </form>
        <form method="post" action="/cp/catalogue/tree-lists/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/product-catalogue-app" />
            <input type="hidden" name="action" value="delete" />
            <label>Ids <input type="text" name="ids" required placeholder="[1] or 1,2" /></label>
            <button type="submit">Delete tree lists</button>
        </form>
        <form id="tree-brunch" method="post" action="/cp/catalogue/tree-lists/write" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/product-catalogue-app" />
            <input type="hidden" name="langCode" value="en" />
            <div style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <label>Action
                    <select name="action">
                        <option value="branch_create">branch_create</option>
                        <option value="branch_edit">branch_edit</option>
                    </select>
                </label>
                <label>List id <input type="number" name="listId" min="0" value="0" style="width:6rem" title="0 = create" /></label>
                <label>Parent id <input type="number" name="parentId" min="0" value="0" style="width:6rem" /></label>
                <label>Caption <input type="text" name="caption" /></label>
                <label>Data type
                    <select name="dataType">
                        <option value="text">text</option>
                        <option value="number">number</option>
                    </select>
                </label>
            </div>
            <label>Branch items JSON
                <textarea name="treeJson" rows="4" style="width:100%;font-family:monospace" placeholder='[{"id":1,"value":"Sibling","alias":"sib","url":"/sib"}]'></textarea>
            </label>
            <button type="submit">Save brunch</button>
        </form>
        <form id="sku-media" method="post" action="/cp/catalogue/sku-media/write" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/product-catalogue-app" />
            <div style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <label>Action
                    <select name="action">
                        <option value="save_profile">save_profile</option>
                        <option value="ensure">ensure</option>
                        <option value="delete_profile">delete_profile</option>
                    </select>
                </label>
                <label>Profile id <input type="number" name="profileId" min="0" value="0" style="width:6rem" title="0 = create" /></label>
                <label>Product id <input type="number" name="productId" min="0" value="0" style="width:6rem" /></label>
                <label>Brand <input type="text" name="brand" /></label>
                <label>Article <input type="text" name="article" /></label>
                <label>Title <input type="text" name="title" /></label>
                <label>Subtitle <input type="text" name="subtitle" /></label>
                <label>Status
                    <select name="status">
                        <option value="active">active</option>
                        <option value="draft">draft</option>
                        <option value="hidden">hidden</option>
                    </select>
                </label>
            </div>
            <button type="submit">Save SKU profile</button>
        </form>
        <form id="sku-specs" method="post" action="/cp/catalogue/sku-media/write" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/product-catalogue-app" />
            <div style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <label>Action
                    <select name="action">
                        <option value="add_spec_group">add_spec_group</option>
                        <option value="delete_spec_group">delete_spec_group</option>
                        <option value="add_spec_row">add_spec_row</option>
                        <option value="update_spec_row">update_spec_row</option>
                        <option value="delete_spec_row">delete_spec_row</option>
                        <option value="update_photo">update_photo</option>
                        <option value="delete_photo">delete_photo</option>
                    </select>
                </label>
                <label>Profile id <input type="number" name="profileId" min="0" value="0" style="width:6rem" /></label>
                <label>Group id <input type="number" name="groupId" min="0" value="0" style="width:6rem" /></label>
                <label>Row id <input type="number" name="rowId" min="0" value="0" style="width:6rem" /></label>
                <label>Photo id <input type="number" name="photoId" min="0" value="0" style="width:6rem" /></label>
                <label>Name <input type="text" name="name" /></label>
                <label>Code <input type="text" name="code" /></label>
                <label>Icon <input type="text" name="icon" placeholder="fa-list" /></label>
                <label>Label <input type="text" name="label" /></label>
                <label>Value <input type="text" name="value" /></label>
                <label>Value type
                    <select name="valueType">
                        <option value="text">text</option>
                        <option value="number">number</option>
                        <option value="bool">bool</option>
                        <option value="list">list</option>
                        <option value="rich">rich</option>
                    </select>
                </label>
                <label>Unit <input type="text" name="unit" /></label>
                <label>Alt <input type="text" name="alt" /></label>
                <label>Caption <input type="text" name="caption" /></label>
                <label>Photo type
                    <select name="photoType">
                        <option value="product">product</option>
                        <option value="packaging">packaging</option>
                        <option value="detail">detail</option>
                        <option value="diagram">diagram</option>
                        <option value="install">install</option>
                        <option value="datasheet">datasheet</option>
                        <option value="other">other</option>
                    </select>
                </label>
                <label>Sort <input type="number" name="sortOrder" min="0" value="0" style="width:5rem" /></label>
                <label>Primary
                    <select name="isPrimary">
                        <option value="">keep</option>
                        <option value="1">1</option>
                        <option value="0">0</option>
                    </select>
                </label>
            </div>
            <button type="submit">Save SKU spec</button>
        </form>
        <form id="homepage-slots" method="post" action="/cp/catalogue/main-page-products/write" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/product-catalogue-app" />
            <input type="hidden" name="langCode" value="en" />
            <label>Homepage groups JSON
                <textarea name="treeJson" rows="5" style="width:100%;font-family:monospace" placeholder='[{"value":"Featured","show_caption":1,"active":1,"data":[{"product_id":1}]}]'></textarea>
            </label>
            <button type="submit">Save homepage slots</button>
        </form>
        <form id="special-searches" method="post" action="/cp/catalogue/special-searches/write" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/product-catalogue-app" />
            <input type="hidden" name="langCode" value="en" />
            <input type="hidden" name="action" value="save" />
            <div style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                <label>Search id <input type="number" name="searchId" min="0" value="0" style="width:6rem" /></label>
                <label>Caption <input type="text" name="caption" /></label>
                <label>Alias <input type="text" name="alias" /></label>
                <label>Title <input type="text" name="title" /></label>
                <label>Order <input type="number" name="order" value="0" style="width:5rem" /></label>
                <label>Active
                    <select name="active">
                        <option value="1">1</option>
                        <option value="0">0</option>
                    </select>
                </label>
            </div>
            <label>Description <input type="text" name="description" style="width:100%" /></label>
            <label>Keywords <input type="text" name="keywords" style="width:100%" /></label>
            <label>Robots <input type="text" name="robots" value="index,follow" /></label>
            <label>Steps JSON
                <textarea name="treeJson" rows="5" style="width:100%;font-family:monospace" placeholder='[{"value":"Brand","alias":"brand","type":1,"objects":[1],"is_new":true,"levels":[{"value":"Level 1","h1":"H1","title":"Title","description":"Desc","keywords":"kw","robots":"index,follow"}]}]'></textarea>
            </label>
            <label>Deleted step ids JSON
                <input type="text" name="deletedSteps" value="[]" style="width:100%;font-family:monospace" />
            </label>
            <button type="submit">Save special search</button>
        </form>
        <form id="special-searches-delete" method="post" action="/cp/catalogue/special-searches/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/product-catalogue-app" />
            <input type="hidden" name="action" value="delete" />
            <label>Search ids JSON
                <input type="text" name="searchesIds" placeholder="[1,2]" style="width:16rem;font-family:monospace" />
            </label>
            <button type="submit">Delete special searches</button>
        </form>
        <form id="catalogue-tree" method="post" action="/cp/catalogue/editor/write" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/product-catalogue-app" />
            <input type="hidden" name="langCode" value="en" />
            <label>Catalogue tree JSON
                <textarea name="treeJson" rows="5" style="width:100%;font-family:monospace" placeholder='[{"id":1,"value":"Tires","alias":"tires","url":"/tires","published_flag":1,"$level":1,"$parent":0,"$count":0,"data":[]}]'></textarea>
            </label>
            <button type="submit">Save catalogue tree</button>
        </form>
    }
    @if (!_isAdmin)
    {
        <div class="alert alert-info" role="status">Sign in with a Control Panel admin session to load the live catalogue.</div>
    }
    else if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-warning" role="status">@_message <span class="text-muted small">(@_source)</span></div>
    }

    <div class="epc-scp-kpi" aria-label="Product catalogue stats">
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Products</div>
            <div class="epc-scp-kpi__val">@_summary.ProductCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Published</div>
            <div class="epc-scp-kpi__val">@_summary.PublishedCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Unpublished</div>
            <div class="epc-scp-kpi__val">@_summary.UnpublishedCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Categories</div>
            <div class="epc-scp-kpi__val">@_summary.CategoryCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
    </div>

    <div class="epc-scp-users-workspace @(_selectedId > 0 ? "is-detail-active" : null)">
        <div class="epc-scp-users-workspace__list">
            <div class="epc-scp-table-card">
                <div class="epc-scp-table-card__head">
                    <div>
                        <h3>Catalogue products</h3>
                        <p class="epc-users-hint">Open a row for read console. Tree JSON save writes here; drag-tree UX stays Classic.</p>
                    </div>
                    <a class="btn btn-primary btn-xs" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Open PHP editor</a>
                </div>
                <div class="table-responsive">
                    <table class="epc-scp-data-table table table-epc-pro table-hover">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Category</th>
                                <th>Caption</th>
                                <th>Alias</th>
                                <th>Published</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_products.Count == 0)
                            {
                                <tr><td colspan="6">Nothing to show yet — bind shop DB / seed catalogue, or open the PHP editor.</td></tr>
                            }
                            else
                            {
                                @foreach (var row in _products)
                                {
                                    <tr class="@(_selectedId == row.Id ? "active" : null)">
                                        <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@row.CategoryId.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.Caption) ? row.Caption : "—")</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.Alias) ? row.Alias : "—")</td>
                                        <td>@(row.PublishedFlag ? "yes" : "no")</td>
                                        <td class="epc-scp-actions-cell">
                                            <a href="/cp/product-catalogue-app?product_id=@row.Id.ToString(CultureInfo.InvariantCulture)">Open</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (_selected is not null)
        {
            <div class="epc-scp-users-workspace__detail">
                <div class="epc-scp-table-card">
                    <div class="epc-scp-table-card__head">
                        <div>
                            <h3>@_selected.Caption</h3>
                            <p class="epc-users-hint">Product read console</p>
                        </div>
                        <a class="btn btn-default btn-xs" href="/cp/product-catalogue-app">Close</a>
                    </div>
                    <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                        <dt>Id</dt><dd>@_selected.Id.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Category</dt><dd>@_selected.CategoryId.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Alias</dt><dd><code>@(_selected.Alias is { Length: > 0 } ? _selected.Alias : "—")</code></dd>
                        <dt>Published</dt><dd>@(_selected.PublishedFlag ? "yes" : "no")</dd>
                    </dl>
                    <p style="margin:.85rem 0 0;font-size:.86rem;">
                        <a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref($"{_phpTab}?product_id={_selected.Id.ToString(CultureInfo.InvariantCulture)}")">Edit in PHP catalogue_editor</a>
                    </p>
                </div>
            </div>
        }
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/catalogue/catalogue_editor";
    private bool _isAdmin;
    private long _selectedId;
    private CpProductCatalogueSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpProductCatalogueDigest> _products = [];
    private CpProductCatalogueDigest? _selected;
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("product_id", out var idRaw)
            && long.TryParse(idRaw.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var id))
        {
            _selectedId = id;
        }

        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpProductCatalogueDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _products = result.Products;
        _source = result.Source;
        _message = result.Message;
        if (_selectedId > 0)
        {
            _selected = _products.FirstOrDefault(p => p.Id == _selectedId);
        }
    }
}
