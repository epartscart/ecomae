@page "/cp/product-catalogue-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Product catalogue · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-pc-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#14532d 0%,#15803d 50%,#4ade80 100%);
        }
        .epc-pc-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-pc-hero p { margin:0; color:rgba(255,255,255,.85); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-pc-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-pc-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#14532d; background:#dcfce7;
        }
        .epc-pc-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-pc-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-pc-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-pc-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-pc-kpi span { color:#64748b; font-size:.78rem; }
        .epc-pc-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-pc-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-pc-table th, .epc-pc-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-pc-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-pc-note { margin-top:1rem; padding:.75rem .9rem; background:#f0fdf4; border:1px solid #86efac; border-radius:.45rem; color:#14532d; font-size:.86rem; }
        @@media (max-width:900px){ .epc-pc-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-pc-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Product catalogue</h1>
        <p>Read-only product KPIs + rows from <code>/cp/product-catalogue</code>. Edits and category trees stay on live PHP.</p>
        <div class="epc-pc-cta">
            <a href="@_phpTab">Open PHP</a>
            <a class="ghost" href="@PhpModuleCatalog.HybridWorkspaceHref("/cp/app", _phpTab)">Hybrid workspace</a>
            <a class="ghost" href="/cp/app">Command centre</a>
        </div>
    </section>

    <div class="epc-pc-kpis" aria-label="Product catalogue stats">
        <div class="epc-pc-kpi"><strong>@_summary.ProductCount.ToString(CultureInfo.InvariantCulture)</strong><span>Products</span></div>
        <div class="epc-pc-kpi"><strong>@_summary.PublishedCount.ToString(CultureInfo.InvariantCulture)</strong><span>Published</span></div>
        <div class="epc-pc-kpi"><strong>@_summary.UnpublishedCount.ToString(CultureInfo.InvariantCulture)</strong><span>Unpublished</span></div>
        <div class="epc-pc-kpi"><strong>@_summary.CategoryCount.ToString(CultureInfo.InvariantCulture)</strong><span>Categories</span></div>
    </div>

    <div class="epc-pc-table-wrap">
        <table class="epc-pc-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Category</th>
                    <th>Caption</th>
                    <th>Alias</th>
                    <th>Published</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_products.Count == 0)
                {
                    <tr><td colspan="6">No rows in digest (@_source). @_message</td></tr>
                }
                else
                {
                    @foreach (var row in _products)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CategoryId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Caption) ? row.Caption : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Alias) ? row.Alias : "—")</td>
                            <td>@(row.PublishedFlag ? "yes" : "no")</td>
                            <td><a href="@_phpTab">Open in PHP</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-pc-note">
        Read-only preview · JSON digest <a href="/cp/product-catalogue?limit=200">/cp/product-catalogue</a>. PHP catalogue editor remains authoritative · Not a broad /cp cutover · tenant product chrome stays PHP.
        Source: <code>@_source</code>.
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/catalogue/catalogue_editor";
    private bool _isAdmin;
    private CpProductCatalogueSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpProductCatalogueDigest> _products = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpProductCatalogueDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _products = result.Products;
        _source = result.Source;
        _message = result.Message;
    }
}
