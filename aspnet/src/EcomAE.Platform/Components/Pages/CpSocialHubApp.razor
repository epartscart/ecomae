@page "/cp/social-hub-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Social media hub · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Social media hub
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/social-hub-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/social-hub-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_accountCount.ToString(CultureInfo.InvariantCulture) Accounts · @_draftCount.ToString(CultureInfo.InvariantCulture) Drafts · @_publishedCount.ToString(CultureInfo.InvariantCulture) Published · @_errorCount.ToString(CultureInfo.InvariantCulture) Errors.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Platform</th>
                    <th>Username</th>
                    <th>Status</th>
                    <th>Draft</th>
                    <th>Draft status</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="6">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@(!string.IsNullOrWhiteSpace(row.Platform) ? row.Platform : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Username) ? row.Username : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.DraftStatus) ? row.DraftStatus : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="epc-nw-note">Credentials omitted. Draft save/publish remain portal_social dry-run; PHP social hub authoritative.</div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_social_media_hub";
    private bool _isAdmin;
    private int _accountCount = 0;
    private int _draftCount = 0;
    private int _publishedCount = 0;
    private int _errorCount = 0;
    private IReadOnlyList<CpSocialHubRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpSocialHubDigestAsync(200, ctx.RequestAborted);
        _accountCount = result.Summary.AccountCount;
        _draftCount = result.Summary.DraftCount;
        _publishedCount = result.Summary.PublishedCount;
        _errorCount = result.Summary.ErrorCount;
        _rows = result.Rows;
        _source = result.Source;
        _message = result.Message;
    }
}
