@page "/cp/social-hub-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Social media hub · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Social media hub
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/social-hub-app")</p>
                <p>Open an account for last-test status and draft titles. Save a draft here. Publish, generate caption, credentials, and test stay on the Classic twin. This page does not invent a send.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/social-hub-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedAccount is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div>
    }

    @if (_isAdmin)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Save draft</div>
                <div class="panel-body">
                    <form method="post" action="/cp/social-hub/write" class="well">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@(_openedId > 0 ? ErpRecordOpen.Href(_listHref, "social_id", _openedId) : _listHref)" />
                        <input type="hidden" name="action" value="save_draft" />
                        <input type="hidden" name="id" value="0" />
                        @if (_isSuper)
                        {
                            <div class="form-group">
                                <label>Site key</label>
                                <input type="text" class="form-control" name="site_key" value="@OpenedSiteKey" />
                            </div>
                        }
                        else
                        {
                            <input type="hidden" name="site_key" value="@OpenedSiteKey" />
                        }
                        <div class="form-group">
                            <label>Platform</label>
                            <select class="form-control" name="platform">
                                @foreach (var p in _platforms)
                                {
                                    @if (OpenedPlatform == p)
                                    {
                                        <option value="@p" selected>@p</option>
                                    }
                                    else
                                    {
                                        <option value="@p">@p</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Title</label>
                            <input type="text" class="form-control" name="title" value="" />
                        </div>
                        <div class="form-group">
                            <label>Caption</label>
                            <textarea class="form-control" name="caption" rows="3"></textarea>
                        </div>
                        <div class="form-group">
                            <label>Hashtags</label>
                            <input type="text" class="form-control" name="hashtags" value="" />
                        </div>
                        <div class="form-group">
                            <label>Public media URL</label>
                            <input type="url" class="form-control" name="media_url" value="" />
                        </div>
                        <button type="submit" class="btn btn-default">Save draft</button>
                    </form>
                    <p class="help-block" style="margin:.75rem 0 0">Publish stay Classic.</p>
                </div>
            </div>
        </div>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Social hub KPIs">
        <div class="kpi"><div class="lbl">Accounts</div><div class="val">@_accountCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Drafts</div><div class="val">@_draftCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Published</div><div class="val">@_publishedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Opened drafts</div><div class="val">@_openedDrafts.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedAccount is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedAccount.AccountLabel) ? _openedAccount.AccountLabel : (!string.IsNullOrWhiteSpace(_openedAccount.Username) ? _openedAccount.Username : ("Account #" + _openedAccount.Id.ToString(CultureInfo.InvariantCulture))))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedAccount.Status) ? _openedAccount.Status : "—")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedAccount.SiteKey) ? _openedAccount.SiteKey : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedAccount.Platform) ? _openedAccount.Platform : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedAccount.Username) ? _openedAccount.Username : "—")</p>
                    <p>Last test @_openedAccount.LastTestAt.ToString(CultureInfo.InvariantCulture)
                        · @(_openedAccount.LastTestOk != 0 ? "ok" : "not ok")
                        · created @_openedAccount.CreatedAt.ToString(CultureInfo.InvariantCulture)
                        · updated @_openedAccount.UpdatedAt.ToString(CultureInfo.InvariantCulture)</p>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Drafts</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Scheduled</th>
                                    <th>Caption</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedDrafts.Count == 0)
                                {
                                    <tr><td colspan="5">No drafts yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var draft in _openedDrafts)
                                    {
                                        <tr>
                                            <td>@draft.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(draft.Title) ? draft.Title : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(draft.Status) ? draft.Status : "—")</td>
                                            <td>@draft.ScheduledAt.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(draft.CaptionExcerpt))
                                                {
                                                    @draft.CaptionExcerpt
                                                    @if (draft.CaptionLen > draft.CaptionExcerpt.Length)
                                                    {
                                                        <span class="text-muted"> (excerpt)</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <text>—</text>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Platform</th>
                    <th>Username</th>
                    <th>Status</th>
                    <th>Draft</th>
                    <th>Draft status</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Platform) ? row.Platform : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Username) ? row.Username : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.DraftStatus) ? row.DraftStatus : "—")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "social_id", row.Id)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="epc-nw-note">Credentials omitted. Publish, generate caption, and test stay Classic.</div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_social_media_hub";
    private const string _listHref = "/cp/social-hub-app";
    private bool _isAdmin;
    private int _accountCount = 0;
    private int _draftCount = 0;
    private int _publishedCount = 0;
    private int _errorCount = 0;
    private IReadOnlyList<CpSocialHubRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private CpSocialHubAccountDetail? _openedAccount;
    private IReadOnlyList<CpSocialHubDraftDigest> _openedDrafts = [];
    private bool _isSuper;
    private string _flashOk = "";
    private string _flashErr = "";
    private static readonly string[] _platforms = ["instagram", "tiktok", "facebook", "linkedin", "x"];

    private string OpenedSiteKey => _openedAccount is not null && !string.IsNullOrWhiteSpace(_openedAccount.SiteKey)
        ? _openedAccount.SiteKey
        : (_isSuper ? "platform" : "");

    private string OpenedPlatform
    {
        get
        {
            var raw = (_openedAccount?.Platform ?? string.Empty).Trim().ToLowerInvariant();
            return _platforms.Contains(raw) ? raw : "instagram";
        }
    }

    private string OpenedCaption => _openedAccount is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedAccount.AccountLabel)
            ? (string.IsNullOrWhiteSpace(_openedAccount.Username)
                ? ("Account #" + _openedAccount.Id.ToString(CultureInfo.InvariantCulture))
                : _openedAccount.Username)
            : _openedAccount.AccountLabel)
            + (string.IsNullOrWhiteSpace(_openedAccount.Platform) ? "" : (" · " + _openedAccount.Platform));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "social_id");
        _isSuper = SuperCpHostGate.IsAllowed(ctx);
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpSocialHubDigestAsync(200, ctx.RequestAborted);
        _accountCount = result.Summary.AccountCount;
        _draftCount = result.Summary.DraftCount;
        _publishedCount = result.Summary.PublishedCount;
        _errorCount = result.Summary.ErrorCount;
        _rows = result.Rows;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpSocialHubAccountDetailAsync(_openedId, ctx.RequestAborted);
            _openedAccount = detail.Account;
            _openedDrafts = detail.Drafts;
            if (_openedAccount is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
