@page "/cp/social-hub-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Social media hub · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-nw-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-nw-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-nw-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-nw-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-nw-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f172a; background:#fff;
        }
        .epc-nw-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-nw-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-nw-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-nw-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-nw-kpi span { color:#64748b; font-size:.78rem; }
        .epc-nw-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-nw-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-nw-table th, .epc-nw-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-nw-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-nw-note { margin-top:1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:.45rem; color:#334155; font-size:.86rem; }
        @@media (max-width:900px){ .epc-nw-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-nw-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Social media hub</h1>
        <p>@CpPhpModuleCopy.PurposeFor(Nav.Uri)</p>
        <div class="epc-nw-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/cp/module-ajax/dry-run/portal_social/generate_caption">Caption dry-run</a>
        </div>
    </section>
    <PhpParityModuleBody AppPath="/cp/social-hub-app" IsAdmin="_isAdmin" />


    <div class="epc-nw-kpis" aria-label="Social media hub stats">
        <div class="epc-nw-kpi"><strong>@_accountCount.ToString(CultureInfo.InvariantCulture)</strong><span>Accounts</span></div>
        <div class="epc-nw-kpi"><strong>@_draftCount.ToString(CultureInfo.InvariantCulture)</strong><span>Drafts</span></div>
        <div class="epc-nw-kpi"><strong>@_publishedCount.ToString(CultureInfo.InvariantCulture)</strong><span>Published</span></div>
        <div class="epc-nw-kpi"><strong>@_errorCount.ToString(CultureInfo.InvariantCulture)</strong><span>Errors</span></div>
    </div>

    <div class="epc-nw-table-wrap">
    <table class="epc-nw-table">
        <thead>
            <tr>
                    <th>Platform</th>
                    <th>Username</th>
                    <th>Status</th>
                    <th>Draft</th>
                    <th>Draft status</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="6">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@(!string.IsNullOrWhiteSpace(row.Platform) ? row.Platform : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Username) ? row.Username : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.DraftStatus) ? row.DraftStatus : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>

    <div class="epc-nw-note">Credentials omitted. Draft save/publish remain portal_social dry-run; PHP social hub authoritative.</div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_social_media_hub";
    private bool _isAdmin;
    private int _accountCount = 0;
    private int _draftCount = 0;
    private int _publishedCount = 0;
    private int _errorCount = 0;
    private IReadOnlyList<CpSocialHubRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpSocialHubDigestAsync(200, ctx.RequestAborted);
        _accountCount = result.Summary.AccountCount;
        _draftCount = result.Summary.DraftCount;
        _publishedCount = result.Summary.PublishedCount;
        _errorCount = result.Summary.ErrorCount;
        _rows = result.Rows;
        _source = result.Source;
        _message = result.Message;
    }
}
