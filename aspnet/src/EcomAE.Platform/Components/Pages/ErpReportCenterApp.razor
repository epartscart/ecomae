@page "/erp/report-center-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject IErpFinancialStatementReadService Statements
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>@_pageTitle · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="@_pageTitle" BreadcrumbArea="Record to Report" BreadcrumbTab="@_pageTitle">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/report-center-app" IsAdmin="_isAdmin" />


    
    <PhpErpModulePageHeader Title="@_pageTitle" Subtitle="@_pageSubtitle" PhpTabHref="@_phpTab" />
    <style>
        .epc-stmt-actions a{display:inline-block;background:#1f4e79;color:#fff !important;text-decoration:none;border-radius:.25rem;padding:.35rem .7rem;margin:0 .35rem .35rem 0}
    </style>

    @if (_statement is not null)
    {
        <p class="help-block">
            Posted journals through to the statement.
            <a href="@StatementHref("pl", _level, _businessUnit, _currency)">Profit and loss</a>
            · <a href="@StatementHref("balance_sheet", _level, _businessUnit, _currency)">Balance sheet</a>
            · <a href="@StatementHref("pl", "company", _businessUnit, _currency)">Company</a>
            · <a href="@StatementHref("pl", "business_unit", _businessUnit, _currency)">Business unit</a>
            · <a href="@StatementHref("balance_sheet", "consolidation", _businessUnit, _currency)">Consolidation</a>
            · <a href="@WithCompany("/erp/trial-balance-app")">Trial balance</a>
            · <a href="@WithCompany("/erp/tax-external-reporting-app")">External reporting</a>
            · <a href="@WithCompany("/erp/report-center-app?tab=reports")">All reports</a>
        </p>
        <p class="help-block">Each legal entity posts in the currency of its country. Consolidation is the head office reporting currency, and each exchange rate is applied before the accounts are added.</p>
        <form method="get" action="/erp/report-center-app" data-epc-inline="1" class="epc-ui-toolbar" style="display:flex;flex-wrap:wrap;gap:.5rem;align-items:end;margin:0 0 1rem;">
            <input type="hidden" name="tab" value="@_navTab" />
            @if (_company > 0)
            {
                <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
            }
            <label>Level
                <select class="form-control input-sm" name="level">
                    <option value="company" selected="@(_level == "company")">Company</option>
                    <option value="business_unit" selected="@(_level == "business_unit")">Business unit</option>
                    <option value="consolidation" selected="@(_level == "consolidation")">Consolidation</option>
                </select>
            </label>
            <label>Business unit
                <select class="form-control input-sm" name="bu">
                    <option value="0">All units</option>
                    @foreach (var unit in _statement.BusinessUnits)
                    {
                        <option value="@unit.Id.ToString(CultureInfo.InvariantCulture)" selected="@(unit.Id == _businessUnit)">@unit.Code @unit.Name</option>
                    }
                </select>
            </label>
            <label>Reporting currency
                <input class="form-control input-sm" name="currency" value="@_currency" maxlength="8" placeholder="@_statement.AccountingCurrency" style="width:6rem;" />
            </label>
            <button type="submit" class="btn btn-primary btn-sm">Run statement</button>
        </form>
        <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Statement totals">
            <div class="kpi"><div class="lbl">Level</div><div class="val">@_statement.LevelLabel</div></div>
            <div class="kpi"><div class="lbl">Accounting</div><div class="val">@_statement.AccountingCurrency</div></div>
            <div class="kpi"><div class="lbl">Reporting</div><div class="val">@_statement.ReportingCurrency</div></div>
            @if (_statement.Query.Kind == ErpFinancialStatementKind.ProfitAndLoss)
            {
                <div class="kpi"><div class="lbl">Net profit</div><div class="val">@Money(_statement.NetProfitAccounting)</div></div>
            }
            else
            {
                <div class="kpi"><div class="lbl">Assets</div><div class="val">@Money(_statement.AssetAccounting)</div></div>
                <div class="kpi"><div class="lbl">Out of balance</div><div class="val">@Money(_statement.BalanceCheckAccounting)</div></div>
            }
        </div>
        <p class="text-muted">@_statement.Message</p>
        <style>
            .epc-ifrs{color:#1d2740}
            .epc-ifrs h2{margin:0 0 .35rem;font-size:1.05rem;color:#1d2740}
            .epc-ifrs p,.epc-ifrs td,.epc-ifrs th{color:#1d2740}
            .epc-stmt-section td{background:#e8eef5;font-weight:700;color:#1d2740}
            .epc-stmt-subtotal td{font-weight:700;border-top:2px solid #1f4e79;color:#1d2740}
            .epc-stmt-total td{font-weight:800;border-top:2px solid #1d2740;border-bottom:3px double #1d2740;color:#1d2740}
            .epc-stmt-note td{color:#334155;font-size:.92rem}
            .epc-stmt-actions a{display:inline-block;background:#1f4e79;color:#fff !important;text-decoration:none;border-radius:.25rem;padding:.35rem .7rem;margin:0 .35rem .35rem 0}
            @@media print {
                .epc-stmt-actions,.epc-ui-toolbar,.help-block,.epc-erp-kpi,.epc-erp-topnav,.epc-erp-d365{display:none !important}
                .epc-ifrs,.epc-ifrs td,.epc-ifrs th{color:#111 !important;background:#fff !important}
            }
        </style>
        <section class="epc-ifrs" aria-label="IFRS 18 statement">
            <h2>@(_statement.Query.Kind == ErpFinancialStatementKind.BalanceSheet ? "Statement of financial position" : "Statement of profit or loss")</h2>
            <p>Presented under IFRS 18. Income and expenses are classified as operating, investing, or financing, then income taxes and discontinued operations. The face carries operating profit or loss, profit or loss before financing and income taxes, and profit or loss. The statement of financial position shows current and non-current groups, Total assets, and Total liabilities and equity. No management-defined performance measure is added.</p>
            <p class="epc-stmt-actions">
                <a href="@FileHref("print")" target="_blank" rel="noopener">Print</a>
                <a href="@FileHref("pdf")">PDF</a>
                <a href="@FileHref("xlsx")">Excel</a>
            </p>
            <div class="epc-erp-table-wrap">
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Line</th>
                            <th class="text-right">@_statement.AccountingCurrency</th>
                            <th class="text-right">@_statement.ReportingCurrency</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _face)
                        {
                            <tr class="@RowClass(row.Kind)">
                                <td>@row.Code</td>
                                <td>@row.Label</td>
                                <td class="text-right">@(row.Accounting is null ? "" : Money(row.Accounting.Value))</td>
                                <td class="text-right">@(row.Reporting is null ? "" : Money(row.Reporting.Value))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    else
    {
    <p class="epc-stmt-actions">
        <a href="@CatalogFileHref("print")" target="_blank" rel="noopener">Print</a>
        <a href="@CatalogFileHref("pdf")">PDF</a>
        <a href="@CatalogFileHref("xlsx")">Excel</a>
    </p>
    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Report center stats">
        <div class="kpi"><div class="lbl">Reports</div><div class="val">@_summary.ReportCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Areas</div><div class="val">@_summary.AreaCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Selected key</div><div class="val">@(string.IsNullOrEmpty(_summary.SelectedKey) ? "—" : _summary.SelectedKey)</div></div>
        <div class="kpi"><div class="lbl">Selected rows</div><div class="val">@_summary.SelectedRowCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Key</th>
                    <th>Area</th>
                    <th>Name</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @if (_reports.Count == 0)
                {
                    <tr><td colspan="4">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _reports)
                    {
                        <tr>
                            <td><a href="@AppHref(row.Key)"><code>@row.Key</code></a></td>
                            <td>@row.Area</td>
                            <td>@row.Name</td>
                            <td>@row.Desc</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrEmpty(_summary.SelectedKey))
    {
        <h2 style="margin:0 0 .5rem;font-size:1rem;">Peek · @_summary.SelectedKey</h2>
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead>
                    <tr>
                        @if (_columns.Count == 0)
                        {
                            <th>Columns</th>
                        }
                        else
                        {
                            @foreach (var col in _columns)
                            {
                                <th>@col</th>
                            }
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (_rows.Count == 0)
                    {
                        <tr><td colspan="@Math.Max(1, _columns.Count)">No peek rows (empty table or migration mode).</td></tr>
                    }
                    else
                    {
                        @foreach (var row in _rows)
                        {
                            <tr>
                                @foreach (var col in _columns)
                                {
                                    <td>@(row.TryGetValue(col, out var v) ? v : "")</td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <p style="margin:0 0 1rem;font-size:.85rem;"><a href="@AppHref(null)">Clear selection</a> · <a href="@DigestHref(_summary.SelectedKey)">Data feed</a></p>
    }
    }

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_summary.Source. Worker <code>erp-reports</code> dry-run stays writes=0 (sales|inventory|vat|ar-aging).
        @if (!string.IsNullOrWhiteSpace(_summary.Message)) { <span> @_summary.Message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private string _message = "";
    private ErpReportCenterSummary _summary = new(0, 0, string.Empty, 0, "migration", string.Empty);
    private IReadOnlyList<ErpReportCenterReportDigest> _reports = [];
    private IReadOnlyList<string> _columns = [];
    private IReadOnlyList<IReadOnlyDictionary<string, string>> _rows = [];
    private string _navTab = "reports";
    private string _phpTab = "/ERP/?epc_erp_shell=1&area=finance&tab=rc_finance";
    private string _pageTitle = "Report center";
    private string _pageSubtitle = "Run financial and operational reports.";
    private ErpFinancialStatement? _statement;
    private IReadOnlyList<ErpIfrs18Row> _face = [];
    private string _level = "company";
    private long _businessUnit;
    private string _currency = "";
    private int _company;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        if (ctx.Request.Query.TryGetValue("tab", out var tabVals) && !string.IsNullOrWhiteSpace(tabVals))
        {
            _navTab = tabVals.ToString().Trim();
        }

        (_pageTitle, _pageSubtitle) = _navTab.ToLowerInvariant() switch
        {
            "pl" => ("Statement of profit or loss", "IFRS 18 categories and the three mandatory subtotals, from the posted ledger."),
            "balance_sheet" => ("Statement of financial position", "Current and non-current assets, liabilities, and equity, from the posted ledger."),
            "enterprise_reports" or "jw_trial_balance" => ("Trial balance", "Use the dedicated trial-balance list for date range, date interval, posting layer, Amount, and voucher drill."),
            _ => ("Report center", "Run financial and operational reports."),
        };
        _phpTab = "/ERP/?epc_erp_shell=1&area=finance&tab=" + Uri.EscapeDataString(_navTab);
        _company = ErpHostContext.ActiveCompanyIdFromQuery(ctx.Request) ?? 0;
        if (ctx.Request.Query.TryGetValue("level", out var levelVals) && !string.IsNullOrWhiteSpace(levelVals))
        {
            _level = levelVals.ToString().Trim().ToLowerInvariant();
        }

        if (long.TryParse(ctx.Request.Query["bu"].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var bu) && bu > 0)
        {
            _businessUnit = bu;
        }

        _currency = ctx.Request.Query["currency"].ToString().Trim();

        var session = await Sessions.ValidateAsync(ctx);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (IsStatementTab(_navTab))
        {
            if (!_isAdmin)
            {
                return;
            }

            _statement = await Statements.ReadAsync(
                ErpFinancialStatementQuery.FromQuery(
                    _navTab,
                    _level,
                    _company.ToString(CultureInfo.InvariantCulture),
                    _businessUnit.ToString(CultureInfo.InvariantCulture),
                    _currency),
                ctx.RequestAborted);
            _face = _statement.Query.Kind == ErpFinancialStatementKind.BalanceSheet
                ? ErpIfrs18Face.FinancialPosition(_statement)
                : ErpIfrs18Face.ProfitOrLoss(_statement);
            _level = _statement.Query.Level switch
            {
                ErpFinancialStatementLevel.BusinessUnit => "business_unit",
                ErpFinancialStatementLevel.Consolidation => "consolidation",
                _ => "company",
            };
            _businessUnit = _statement.Query.BusinessUnitId;
            _summary = new ErpReportCenterSummary(
                0,
                0,
                _navTab,
                _statement.Lines.Count,
                _statement.Source,
                _statement.Message);
            return;
        }

        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        string? key = null;
        if (ctx.Request.Query.TryGetValue("key", out var keyVals) && !string.IsNullOrWhiteSpace(keyVals))
        {
            key = keyVals.ToString();
        }

        key ??= ErpReportCenterRegistry.KeyForNavTab(_navTab);

        int? companyId = _company > 0 ? _company : null;
        if (ctx.Request.Query.TryGetValue("companyId", out var coVals)
            && int.TryParse(coVals.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var co)
            && co > 0)
        {
            companyId = co;
        }

        var result = await Dashboards.BuildErpReportCenterDigestAsync(key, 100, ctx.RequestAborted, companyId);
        _summary = result.Summary;
        _reports = result.Reports;
        _columns = result.Columns;
        _rows = result.Rows;
        _message = result.Message;
    }

    private string AppHref(string? key)
    {
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(_navTab))
        {
            qs.Add("tab=" + Uri.EscapeDataString(_navTab));
        }

        if (!string.IsNullOrWhiteSpace(key))
        {
            qs.Add("key=" + Uri.EscapeDataString(key));
        }

        if (_company > 0)
        {
            qs.Add("company=" + _company.ToString(CultureInfo.InvariantCulture));
        }

        return qs.Count == 0 ? "/erp/report-center-app" : "/erp/report-center-app?" + string.Join("&", qs);
    }

    private string StatementHref(string tab, string level, long businessUnit, string currency)
    {
        var qs = new List<string>
        {
            "tab=" + Uri.EscapeDataString(tab),
            "level=" + Uri.EscapeDataString(string.IsNullOrWhiteSpace(level) ? "company" : level),
        };
        if (businessUnit > 0)
        {
            qs.Add("bu=" + businessUnit.ToString(CultureInfo.InvariantCulture));
        }

        if (!string.IsNullOrWhiteSpace(currency))
        {
            qs.Add("currency=" + Uri.EscapeDataString(currency.Trim()));
        }

        if (_company > 0)
        {
            qs.Add("company=" + _company.ToString(CultureInfo.InvariantCulture));
        }

        return "/erp/report-center-app?" + string.Join("&", qs);
    }

    private string WithCompany(string path)
    {
        if (_company <= 0 || path.Contains("company=", StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        var hash = string.Empty;
        var hashAt = path.IndexOf('#');
        if (hashAt >= 0)
        {
            hash = path[hashAt..];
            path = path[..hashAt];
        }

        var join = path.Contains('?', StringComparison.Ordinal) ? "&" : "?";
        return path + join + "company=" + _company.ToString(CultureInfo.InvariantCulture) + hash;
    }

    private static bool IsStatementTab(string tab)
        => tab.Equals("pl", StringComparison.OrdinalIgnoreCase)
            || tab.Equals("balance_sheet", StringComparison.OrdinalIgnoreCase);

    private string FileHref(string format)
    {
        var href = StatementHref(_navTab, _level, _businessUnit, _currency);
        var query = href.Contains('?', StringComparison.Ordinal) ? href[(href.IndexOf('?') + 1)..] : "";
        return "/erp/financial-reports/file?" + query + "&format=" + Uri.EscapeDataString(format);
    }

    private string CatalogFileHref(string format)
    {
        var href = AppHref(string.IsNullOrWhiteSpace(_summary.SelectedKey) ? null : _summary.SelectedKey);
        var query = href.Contains('?', StringComparison.Ordinal) ? href[(href.IndexOf('?') + 1)..] : "tab=reports";
        return "/erp/financial-reports/file?" + query + "&format=" + Uri.EscapeDataString(format);
    }

    private static string RowClass(string kind) => kind switch
    {
        "section" => "epc-stmt-section",
        "subtotal" or "total" => kind == "total" ? "epc-stmt-total" : "epc-stmt-subtotal",
        "note" => "epc-stmt-note",
        _ => "",
    };

    private static string Money(decimal value)
        => value.ToString("N2", CultureInfo.InvariantCulture);

    private static string DigestHref(string? key)
        => string.IsNullOrWhiteSpace(key)
            ? "/erp/report-center"
            : "/erp/report-center?key=" + Uri.EscapeDataString(key);
}
