@page "/erp/report-center-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Report center · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<HeadContent>
<style>
        .epc-rc-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#1d4ed8 45%,#2563eb 100%);
        }
        .epc-rc-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-rc-hero p { margin:0; color:rgba(255,255,255,.88); max-width:46rem; font-size:.92rem; line-height:1.45; }
        .epc-rc-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-rc-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#134e4a; background:#ccfbf1;
        }
        .epc-rc-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-rc-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-rc-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-rc-kpi strong { display:block; font-size:1.2rem; }
        .epc-rc-kpi span { color:#64748b; font-size:.78rem; }
        .epc-rc-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; margin-bottom:1rem; }
        .epc-rc-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-rc-table th, .epc-rc-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; }
        .epc-rc-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; white-space:nowrap; }
        .epc-rc-table a { color:#0f766e; font-weight:700; text-decoration:none; }
        .epc-rc-table a:hover { text-decoration:underline; }
        .epc-rc-note { margin-top:1rem; padding:.75rem .9rem; background:#ecfeff; border:1px solid #67e8f9; border-radius:.45rem; color:#164e63; font-size:.86rem; }
        @@media (max-width:900px){ .epc-rc-kpis{grid-template-columns:1fr 1fr;} }
    
</style>
</HeadContent>


<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Report center" BreadcrumbArea="Overview" BreadcrumbTab="Reports">

    <section class="epc-rc-hero">
        <img src="@LegacyPresentationAssets.EpartsCartMarkUrl" alt="ECOM AE" style="height:28px;filter:brightness(1.1)" />
        <h1>Report center</h1>
        <p>Report registry for this company (33 inquiries). Select a key for a limited peek.</p>
        <div class="epc-rc-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open reports</a>
            <a class="ghost" href="/erp/dashboard-summary-app">ERP dashboard</a>
            <a class="ghost" href="@DigestHref(null)">Data feed</a>
        </div>
    </section>

    <div class="epc-rc-kpis" aria-label="Report center stats">
        <div class="epc-rc-kpi"><strong>@_summary.ReportCount.ToString(CultureInfo.InvariantCulture)</strong><span>Reports</span></div>
        <div class="epc-rc-kpi"><strong>@_summary.AreaCount.ToString(CultureInfo.InvariantCulture)</strong><span>Areas</span></div>
        <div class="epc-rc-kpi"><strong>@(string.IsNullOrEmpty(_summary.SelectedKey) ? "—" : _summary.SelectedKey)</strong><span>Selected key</span></div>
        <div class="epc-rc-kpi"><strong>@_summary.SelectedRowCount.ToString(CultureInfo.InvariantCulture)</strong><span>Selected rows</span></div>
    </div>

    <div class="epc-rc-table-wrap">
        <table class="epc-rc-table">
            <thead>
                <tr>
                    <th>Key</th>
                    <th>Area</th>
                    <th>Name</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @if (_reports.Count == 0)
                {
                    <tr><td colspan="4">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _reports)
                    {
                        <tr>
                            <td><a href="@AppHref(row.Key)"><code>@row.Key</code></a></td>
                            <td>@row.Area</td>
                            <td>@row.Name</td>
                            <td>@row.Desc</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrEmpty(_summary.SelectedKey))
    {
        <h2 style="margin:0 0 .5rem;font-size:1rem;">Peek · @_summary.SelectedKey</h2>
        <div class="epc-rc-table-wrap">
            <table class="epc-rc-table">
                <thead>
                    <tr>
                        @if (_columns.Count == 0)
                        {
                            <th>Columns</th>
                        }
                        else
                        {
                            @foreach (var col in _columns)
                            {
                                <th>@col</th>
                            }
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (_rows.Count == 0)
                    {
                        <tr><td colspan="@Math.Max(1, _columns.Count)">No peek rows (empty table or migration mode).</td></tr>
                    }
                    else
                    {
                        @foreach (var row in _rows)
                        {
                            <tr>
                                @foreach (var col in _columns)
                                {
                                    <td>@(row.TryGetValue(col, out var v) ? v : "")</td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <p style="margin:0 0 1rem;font-size:.85rem;"><a href="@AppHref(null)">Clear selection</a> · <a href="@DigestHref(_summary.SelectedKey)">Data feed</a></p>
    }

    <div class="epc-rc-note">
        Source: @_summary.Source. Worker <code>erp-reports</code> dry-run stays writes=0 (sales|inventory|vat|ar-aging).
        @if (!string.IsNullOrWhiteSpace(_summary.Message)) { <span> @_summary.Message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private ErpReportCenterSummary _summary = new(0, 0, string.Empty, 0, "migration", string.Empty);
    private IReadOnlyList<ErpReportCenterReportDigest> _reports = [];
    private IReadOnlyList<string> _columns = [];
    private IReadOnlyList<IReadOnlyDictionary<string, string>> _rows = [];
    private readonly string _phpTab = "/ERP/?epc_erp_shell=1&area=finance&tab=rc_finance";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        string? key = null;
        if (ctx.Request.Query.TryGetValue("key", out var keyVals) && !string.IsNullOrWhiteSpace(keyVals))
        {
            key = keyVals.ToString();
        }

        int? companyId = null;
        if (ctx.Request.Query.TryGetValue("companyId", out var coVals)
            && int.TryParse(coVals.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var co)
            && co > 0)
        {
            companyId = co;
        }

        var result = await Dashboards.BuildErpReportCenterDigestAsync(key, 100, ctx.RequestAborted, companyId);
        _summary = result.Summary;
        _reports = result.Reports;
        _columns = result.Columns;
        _rows = result.Rows;
    }

    private static string AppHref(string? key)
        => string.IsNullOrWhiteSpace(key)
            ? "/erp/report-center-app"
            : "/erp/report-center-app?key=" + Uri.EscapeDataString(key);

    private static string DigestHref(string? key)
        => string.IsNullOrWhiteSpace(key)
            ? "/erp/report-center"
            : "/erp/report-center?key=" + Uri.EscapeDataString(key);
}
