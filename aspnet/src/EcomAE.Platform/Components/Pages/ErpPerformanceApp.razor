@page "/erp/performance-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IErpHrtReviewSaveDryRun ReviewSave
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Performance · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Performance" BreadcrumbArea="People" BreadcrumbTab="Performance">
    <PhpErpModulePageHeader Title="Performance reviews" Subtitle="Reviews and weighted goals. Saves stay dry-run." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Performance KPIs">
        <div class="kpi"><div class="lbl">Reviews</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open</div><div class="val">@_open.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Completed</div><div class="val">@_done.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <form @onsubmit="OnSave" @onsubmit:preventDefault="true" style="margin:12px 0;padding:10px;border:1px solid #c5d4de;background:#fff;">
            <strong>New review (dry-run)</strong>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;align-items:end;">
                <label>Employee <input class="form-control" @bind="_formCode" /></label>
                <button type="submit" class="btn btn-primary">Validate save</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_formResult)) { <p style="margin:8px 0 0;font-size:12px;">@_formResult</p> }
        </form>
    }

    <h2 style="font-size:16px;">Reviews</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Employee</th><th>Period</th><th>Reviewer</th><th class="text-right">Rating</th><th>Status</th></tr></thead>
            <tbody>
                @if (_reviews.Count == 0)
                {
                    <tr><td colspan="5">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No performance reviews yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _reviews)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.EmployeeName) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.EmployeeName)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Period) ? "—" : row.Period)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Reviewer) ? "—" : row.Reviewer)</td>
                            <td class="text-right">@row.OverallRating.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="font-size:16px;">Goals</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Goal</th><th>Review</th><th>Target</th><th class="text-right">Weight</th><th class="text-right">Rating</th></tr></thead>
            <tbody>
                @if (_goals.Count == 0) { <tr><td colspan="5">No goals yet.</td></tr> }
                else
                {
                    @foreach (var row in _goals)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Title) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Title)</strong></td>
                            <td>@(row.ReviewId > 0 ? row.ReviewId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Target) ? "—" : row.Target)</td>
                            <td class="text-right">@row.Weight.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.Rating.ToString(CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Dry-run: <code>hrt_review_save</code> — writes=0.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=people&tab=performance";
    private bool _isAdmin;
    private IReadOnlyList<ErpPerformanceReviewDigest> _reviews = [];
    private IReadOnlyList<ErpPerformanceGoalDigest> _goals = [];
    private int _count, _open, _done;
    private string _source = "n/a";
    private string _message = "";
    private string _formCode = "";
    private string _formResult = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpPerformanceDigestAsync(200, ctx.RequestAborted);
        _reviews = result.Reviews;
        _goals = result.Goals;
        _count = result.Count;
        _open = result.OpenCount;
        _done = result.DoneCount;
        _source = result.Source;
        _message = result.Message;
    }

    private void OnSave()
    {
        var result = ReviewSave.Evaluate(new ErpHrtReviewSaveRequest(0, _formCode, false));
        _formResult = $"{result.Status}: {result.Detail} (writes={result.Writes.ToString(CultureInfo.InvariantCulture)})";
    }
}
