@page "/cp/data-migrations-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Data migrations · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-w21-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-w21-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-w21-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-w21-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-w21-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f172a; background:#fff;
        }
        .epc-w21-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-w21-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-w21-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-w21-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-w21-kpi span { color:#64748b; font-size:.78rem; }
        .epc-w21-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-w21-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-w21-table th, .epc-w21-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-w21-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-w21-note { margin-top:1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:.45rem; color:#334155; font-size:.86rem; }
        @@media (max-width:900px){ .epc-w21-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-w21-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Data migrations</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-w21-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
        </div>
    </section>

    <div class="epc-w21-kpis" aria-label="Data migrations stats">
        <div class="epc-w21-kpi"><strong>@_summary.MigrationCount.ToString(CultureInfo.InvariantCulture)</strong><span>Migrations</span></div>
        <div class="epc-w21-kpi"><strong>@_summary.CompletedCount.ToString(CultureInfo.InvariantCulture)</strong><span>Completed</span></div>
        <div class="epc-w21-kpi"><strong>@_summary.FailedCount.ToString(CultureInfo.InvariantCulture)</strong><span>Failed / rolled back</span></div>
        <div class="epc-w21-kpi"><strong>@_summary.RowCount.ToString(CultureInfo.InvariantCulture)</strong><span>Row records</span></div>
    </div>

    <div class="epc-w21-table-wrap">
    <table class="epc-w21-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Type</th>
                    <th>Entity</th>
                    <th>File</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Valid</th>
                    <th>Errors</th>
                    <th>Imported</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="10">Nothing to show yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.MigrationType) ? row.MigrationType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.EntityType) ? row.EntityType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.FileName) ? row.FileName : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@row.TotalRows.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.ValidRows.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.ErrorRows.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.ImportedRows.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=setup&tab=data_import&epc_erp_shell=1";
    private bool _isAdmin;
    private CpDataMigrationsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpDataMigrationsRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpDataMigrationsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Migrations;
        _source = result.Source;
        _message = result.Message;
    }
}
