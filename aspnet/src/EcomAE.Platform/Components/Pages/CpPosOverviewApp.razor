@page "/cp/pos-overview-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>POS Overview · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-pos-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-pos-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-pos-hero p { margin:0; color:#fed7aa; max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-pos-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-pos-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#9a3412; background:#e0f2fe;
        }
        .epc-pos-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-pos-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-pos-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-pos-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-pos-kpi span { color:#64748b; font-size:.78rem; }
        .epc-pos-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-pos-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-pos-table th, .epc-pos-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-pos-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-pos-note { margin-top:1rem; padding:.75rem .9rem; background:#fff7ed; border:1px solid #fed7aa; border-radius:.45rem; color:#9a3412; font-size:.86rem; }
        @@media (max-width:900px){ .epc-pos-kpis{grid-template-columns:1fr;} }
    
</style>
</HeadContent>


<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-pos-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>POS Overview</h1>
        <p>@CpPhpModuleCopy.PurposeFor(Nav.Uri)</p>
        <div class="epc-pos-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/cp/tax-toolkits-app">Tax toolkits</a>
        </div>
    </section>

    <div class="epc-pos-kpis" aria-label="POS stats">
        <div class="epc-pos-kpi"><strong>@(_summary.PosEnabled ? "enabled" : "off")</strong><span>Register @(string.IsNullOrWhiteSpace(_summary.RegisterName) ? "—" : _summary.RegisterName)</span></div>
        <div class="epc-pos-kpi"><strong>@_summary.OpenSessions.ToString(CultureInfo.InvariantCulture)</strong><span>Open sessions</span></div>
        <div class="epc-pos-kpi"><strong>@_summary.SalesToday.ToString(CultureInfo.InvariantCulture)</strong><span>Sales today · @_summary.SalesTotalToday.ToString("N2", CultureInfo.InvariantCulture) total</span></div>
    </div>

    <div class="epc-pos-table-wrap">
        <table class="epc-pos-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Sale #</th>
                    <th>Session</th>
                    <th>Customer</th>
                    <th>Subtotal</th>
                    <th>VAT</th>
                    <th>Total</th>
                    <th>Payment</th>
                    <th>Tax kit</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_sales.Count == 0)
                {
                    <tr><td colspan="12">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var s in _sales)
                    {
                        <tr>
                            <td><strong>@s.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(s.SaleNo) ? "—" : s.SaleNo)</td>
                            <td>@s.SessionId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(s.CustomerLabel) ? "—" : s.CustomerLabel)</td>
                            <td>@s.SubtotalEx.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@s.VatAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@s.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(s.PaymentMethod) ? "—" : s.PaymentMethod)</td>
                            <td>@(string.IsNullOrWhiteSpace(s.TaxKitCode) ? "—" : s.TaxKitCode)</td>
                            <td>@(string.IsNullOrWhiteSpace(s.Status) ? "—" : s.Status)</td>
                            <td>@(s.TimeCreated > 0 ? s.TimeCreated.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/shop/pos";
    private bool _isAdmin;
    private CpPosOverviewSummary _summary = new(false, "", 0, 0, 0m, "n/a", "");
    private IReadOnlyList<CpPosSaleDigest> _sales = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpPosOverviewDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _sales = result.Sales;
        _source = result.Source;
        _message = result.Message;
    }
}
