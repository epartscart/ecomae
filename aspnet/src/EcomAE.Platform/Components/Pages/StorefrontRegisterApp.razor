@page "/storefront/register-app"
@page "/en/users/registration"
@page "/users/registration"
@page "/en/users/regform"
@page "/users/regform"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject ILegacySessionValidator Sessions
@inject IStorefrontGuestSessionService Guests
@inject IHttpContextAccessor Http
@inject EcomAE.Platform.Data.ITenantDbConnectionFactory Connections
@inject Microsoft.Extensions.Options.IOptions<EcomAE.Platform.Configuration.PhpReferenceOptions> PhpReference
@inject IWebHostEnvironment Env
@*
  PHP twin: content/users/regform.php. The form posts to {lang}/users/register (StorefrontUsersRegisterEndpoints).
*@

<PageTitle>Customer registration · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" LoginChrome="true" />

<StorefrontTenantChrome>
    <section style="padding:2rem 0 3rem">
        <div class="container">
            <script src="/lib/jQuery/jQuery.js"></script>
            @((MarkupString)_html)
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private string _html = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);
        var langHref = StorefrontPhpHomeLinks.LangHref(ctx);
        var config = new Dictionary<string, string>(EcomAE.Platform.Cp.PriceImport.CpPhpConfig.Read(PhpReference.Value), StringComparer.Ordinal)
        {
            ["domain_path"] = ctx.Request.Scheme + "://" + ctx.Request.Host.Value + "/",
        };
        var tenant = ctx.Items[EcomAE.Platform.Middleware.TenantResolutionMiddleware.HttpContextItemKey] as EcomAE.Platform.Services.TenantContext;

        try
        {
            var session = await Sessions.ValidateCustomerAsync(ctx, ctx.RequestAborted);
            var loggedIn = session.Kind == LegacySessionKind.Customer && session.UserId > 0;
            string? sessionCookie = ctx.Request.Cookies["session"];
            string? userCookie = ctx.Request.Cookies["u_id"];
            if (!loggedIn)
            {
                var shopper = await Guests.ResolveAsync(ctx, createIfMissing: true, ctx.RequestAborted);
                Guests.ApplyGuestCookies(ctx.Response, shopper);
                if (shopper.SessionToken.Length > 0)
                {
                    sessionCookie = shopper.SessionToken;
                    userCookie = "0";
                }
            }

            await using var connection = await Connections.OpenForTenantAsync(tenant, ctx.RequestAborted);
            _html = await StorefrontRegFormLoader.RenderAsync(
                ctx,
                connection,
                Connections,
                PhpReference.Value,
                Env,
                new StorefrontRegFormLoader.Request(loggedIn, langHref, sessionCookie, userCookie, ctx.Request.Cookies["epc_oauth_last_google_email"], config, tenant),
                ctx.RequestAborted);
        }
        catch (System.Data.Common.DbException)
        {
            _html = "<p>Registration is unavailable right now.</p>";
        }
        catch (InvalidOperationException)
        {
            _html = "<p>Registration is unavailable right now.</p>";
        }
    }
}
