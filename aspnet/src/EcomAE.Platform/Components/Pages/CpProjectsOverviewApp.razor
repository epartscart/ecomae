@page "/cp/projects-overview-app"
@page "/erp/projects-overview-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Projects Overview · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Projects overview
                <a class="btn btn-xs btn-default pull-right" href="/cp/production-overview-app" style="margin-right:.4rem">Production overview</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/projects-overview-app")</p>
                <p>Open a project to see budget, tasks, and timesheet rates. Save a project, a project task, and a time log here.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/projects-overview-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedProject is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Project KPIs">
        <div class="kpi"><div class="lbl">Open projects</div><div class="val">@_summary.OpenProjects.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Tasks</div><div class="val">@_summary.TaskCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Contracts</div><div class="val">@_summary.ContractCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <form method="post" action="/erp/projects/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Id <input type="number" name="id" min="0" style="width:5rem" placeholder="new" value="@OpenedIdOrBlank" /></label>
            <label>Code <input type="text" name="code" required placeholder="PRJ-001" value="@OpenedCodeValue" /></label>
            <label>Name <input type="text" name="name" value="@OpenedNameValue" /></label>
            <label>Customer id <input type="number" name="customer_id" min="0" style="width:6rem" value="@OpenedCustomerValue" /></label>
            <label>Billing
                <select name="billing_type">
                    <option value="tm">tm</option>
                    <option value="fixed">fixed</option>
                </select>
            </label>
            <label>Budget <input type="number" name="budget_cost" step="0.01" style="width:7rem" value="@OpenedBudgetValue" /></label>
            <label>Contract <input type="number" name="contract_value" step="0.01" style="width:7rem" value="@OpenedContractValue" /></label>
            <label>Status
                <select name="status">
                    <option value="open">open</option>
                    <option value="closed">closed</option>
                </select>
            </label>
            <button type="submit">Save project</button>
        </form>
        <form method="post" action="/erp/projects/tasks/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Project id <input type="number" name="project_id" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
            <label>Id <input type="number" name="id" min="0" style="width:5rem" placeholder="new" /></label>
            <label>Name <input type="text" name="name" placeholder="Task / milestone" /></label>
            <label>Planned hrs <input type="number" name="planned_hours" step="0.01" style="width:6rem" /></label>
            <label>% done <input type="number" name="percent_complete" step="1" min="0" max="100" style="width:5rem" /></label>
            <label>Status
                <select name="status">
                    <option value="open">open</option>
                    <option value="closed">closed</option>
                </select>
            </label>
            <button type="submit">Save task</button>
        </form>
        <form method="post" action="/erp/projects/timesheets/log" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Project id <input type="number" name="project_id" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
            <label>Task id <input type="number" name="task_id" min="0" style="width:5rem" /></label>
            <label>Employee id <input type="number" name="employee_id" min="0" style="width:6rem" /></label>
            <label>Hours <input type="number" name="hours" step="0.25" required style="width:5rem" /></label>
            <label>Cost/hr <input type="number" name="cost_rate" step="0.01" style="width:6rem" /></label>
            <label>Bill/hr <input type="number" name="bill_rate" step="0.01" style="width:6rem" /></label>
            <label style="font-weight:normal"><input type="checkbox" name="billable" value="1" checked /> Billable</label>
            <button type="submit">Log time</button>
        </form>
    }

    @if (_openedProject is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedProject.Code) ? _openedProject.Code : ("Project #" + _openedProject.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedProject.Status) ? _openedProject.Status : "—")</span>
                </div>
                <div class="panel-body">
                    <p><strong>@(!string.IsNullOrWhiteSpace(_openedProject.Name) ? _openedProject.Name : "—")</strong>
                        · @(!string.IsNullOrWhiteSpace(_openedProject.BillingType) ? _openedProject.BillingType : "—")
                        · Customer @_openedProject.CustomerId.ToString(CultureInfo.InvariantCulture)</p>
                    <p>Budget @_openedProject.BudgetCost.ToString("0.00", CultureInfo.InvariantCulture)
                        · Contract @_openedProject.ContractValue.ToString("0.00", CultureInfo.InvariantCulture)</p>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Tasks</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Name</th>
                                    <th>Planned hrs</th>
                                    <th>% done</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedTasks.Count == 0)
                                {
                                    <tr><td colspan="5">No tasks yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in _openedTasks)
                                    {
                                        <tr>
                                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                                            <td>@row.PlannedHours.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                            <td>@row.PercentComplete.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Timesheets</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Task</th>
                                    <th>Employee</th>
                                    <th>Hours</th>
                                    <th>Cost/hr</th>
                                    <th>Bill/hr</th>
                                    <th>Billable</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedTimesheets.Count == 0)
                                {
                                    <tr><td colspan="7">No timesheets yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in _openedTimesheets)
                                    {
                                        <tr>
                                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@row.TaskId.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@row.EmployeeId.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@row.Hours.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                            <td>@row.CostRate.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                            <td>@row.BillRate.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                            <td>@(row.Billable ? "yes" : "no")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_summary.OpenProjects.ToString(CultureInfo.InvariantCulture) Open projects · @_summary.TaskCount.ToString(CultureInfo.InvariantCulture) Tasks · @_summary.ContractCount.ToString(CultureInfo.InvariantCulture) Contracts.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Billing</th>
                    <th>Contract value</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_projects.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var p in _projects)
                    {
                        <tr id="erp-row-@p.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(p.Id, _openedId)">
                            <td><strong>@p.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(p.Code) ? "—" : p.Code)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.Name) ? "—" : p.Name)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.Status) ? "—" : p.Status)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.BillingType) ? "—" : p.BillingType)</td>
                            <td>@p.ContractValue.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "project_id", p.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=projects&tab=projects&epc_erp_shell=1";
    private string _listHref = "/cp/projects-overview-app";
    private bool _isAdmin;
    private CpProjectsOverviewSummary _summary = new(0, 0, 0, "n/a", "");
    private IReadOnlyList<CpProjectDigest> _projects = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private string _returnHref = "/cp/projects-overview-app";
    private CpProjectDetail? _openedProject;
    private IReadOnlyList<CpProjectTaskDigest> _openedTasks = [];
    private IReadOnlyList<CpProjectTimesheetDigest> _openedTimesheets = [];

    private string OpenedCaption => _openedProject is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedProject.Code) ? ("Project #" + _openedProject.Id.ToString(CultureInfo.InvariantCulture)) : _openedProject.Code)
            + (string.IsNullOrWhiteSpace(_openedProject.Name) ? "" : (" · " + _openedProject.Name));

    private string OpenedIdValue => _openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "";
    private string OpenedIdOrBlank => _openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "";
    private string OpenedCodeValue => _openedProject?.Code ?? "";
    private string OpenedNameValue => _openedProject?.Name ?? "";
    private string OpenedCustomerValue => _openedProject is null ? "" : _openedProject.CustomerId.ToString(CultureInfo.InvariantCulture);
    private string OpenedBudgetValue => _openedProject is null ? "" : _openedProject.BudgetCost.ToString(CultureInfo.InvariantCulture);
    private string OpenedContractValue => _openedProject is null ? "" : _openedProject.ContractValue.ToString(CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var path = ctx.Request.Path.Value;
        _listHref = string.Equals(path, "/erp/projects-overview-app", StringComparison.OrdinalIgnoreCase)
            ? "/erp/projects-overview-app"
            : "/cp/projects-overview-app";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "project_id");
        _returnHref = _openedId > 0
            ? ErpRecordOpen.Href(_listHref, "project_id", _openedId).Split('#')[0]
            : _listHref;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpProjectsOverviewDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _projects = result.Projects;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpProjectDetailAsync(_openedId, ctx.RequestAborted);
            _openedProject = detail.Project;
            _openedTasks = detail.Tasks;
            _openedTimesheets = detail.Timesheets;
            if (_openedProject is not null)
            {
                var openedList = _projects.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _projects = new[] { openedList }.Concat(_projects.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
