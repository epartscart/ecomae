@page "/cp/projects-overview-app"
@page "/erp/projects-overview-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Projects Overview · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Projects overview
                <a class="btn btn-xs btn-default pull-right" href="/cp/production-overview-app" style="margin-right:.4rem">Production overview</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/projects-overview-app")</p>
                <p>Save a project, a project task, and a time log here.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/projects-overview-app" IsAdmin="_isAdmin" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/projects/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/projects-overview-app" />
            <label>Id <input type="number" name="id" min="0" style="width:5rem" placeholder="new" /></label>
            <label>Code <input type="text" name="code" required placeholder="PRJ-001" /></label>
            <label>Name <input type="text" name="name" /></label>
            <label>Customer id <input type="number" name="customer_id" min="0" style="width:6rem" /></label>
            <label>Billing
                <select name="billing_type">
                    <option value="tm">tm</option>
                    <option value="fixed">fixed</option>
                </select>
            </label>
            <label>Budget <input type="number" name="budget_cost" step="0.01" style="width:7rem" /></label>
            <label>Contract <input type="number" name="contract_value" step="0.01" style="width:7rem" /></label>
            <label>Status
                <select name="status">
                    <option value="open">open</option>
                    <option value="closed">closed</option>
                </select>
            </label>
            <button type="submit">Save project</button>
        </form>
        <form method="post" action="/erp/projects/tasks/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/projects-overview-app" />
            <label>Project id <input type="number" name="project_id" min="1" required style="width:6rem" /></label>
            <label>Id <input type="number" name="id" min="0" style="width:5rem" placeholder="new" /></label>
            <label>Name <input type="text" name="name" placeholder="Task / milestone" /></label>
            <label>Planned hrs <input type="number" name="planned_hours" step="0.01" style="width:6rem" /></label>
            <label>% done <input type="number" name="percent_complete" step="1" min="0" max="100" style="width:5rem" /></label>
            <label>Status
                <select name="status">
                    <option value="open">open</option>
                    <option value="closed">closed</option>
                </select>
            </label>
            <button type="submit">Save task</button>
        </form>
        <form method="post" action="/erp/projects/timesheets/log" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/projects-overview-app" />
            <label>Project id <input type="number" name="project_id" min="1" required style="width:6rem" /></label>
            <label>Task id <input type="number" name="task_id" min="0" style="width:5rem" /></label>
            <label>Employee id <input type="number" name="employee_id" min="0" style="width:6rem" /></label>
            <label>Hours <input type="number" name="hours" step="0.25" required style="width:5rem" /></label>
            <label>Cost/hr <input type="number" name="cost_rate" step="0.01" style="width:6rem" /></label>
            <label>Bill/hr <input type="number" name="bill_rate" step="0.01" style="width:6rem" /></label>
            <label style="font-weight:normal"><input type="checkbox" name="billable" value="1" checked /> Billable</label>
            <button type="submit">Log time</button>
        </form>
    }

    <p class="help-block">@_summary.OpenProjects.ToString(CultureInfo.InvariantCulture) Open projects · @_summary.TaskCount.ToString(CultureInfo.InvariantCulture) Tasks · @_summary.ContractCount.ToString(CultureInfo.InvariantCulture) Contracts.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Billing</th>
                    <th>Contract value</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_projects.Count == 0)
                {
                    <tr><td colspan="7">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var p in _projects)
                    {
                        <tr>
                            <td><strong>@p.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(p.Code) ? "—" : p.Code)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.Name) ? "—" : p.Name)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.Status) ? "—" : p.Status)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.BillingType) ? "—" : p.BillingType)</td>
                            <td>@p.ContractValue.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=projects&tab=projects&epc_erp_shell=1";
    private bool _isAdmin;
    private CpProjectsOverviewSummary _summary = new(0, 0, 0, "n/a", "");
    private IReadOnlyList<CpProjectDigest> _projects = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpProjectsOverviewDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _projects = result.Projects;
        _source = result.Source;
        _message = result.Message;
    }
}
