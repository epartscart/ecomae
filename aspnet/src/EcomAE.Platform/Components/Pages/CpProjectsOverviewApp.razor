@page "/cp/projects-overview-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Projects Overview · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-prj-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-prj-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-prj-hero p { margin:0; color:#fef3c7; max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-prj-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-prj-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#92400e; background:#e0f2fe;
        }
        .epc-prj-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-prj-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-prj-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-prj-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-prj-kpi span { color:#64748b; font-size:.78rem; }
        .epc-prj-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-prj-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-prj-table th, .epc-prj-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-prj-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-prj-note { margin-top:1rem; padding:.75rem .9rem; background:#fffbeb; border:1px solid #fde68a; border-radius:.45rem; color:#92400e; font-size:.86rem; }
        @@media (max-width:900px){ .epc-prj-kpis{grid-template-columns:1fr;} }
    </style>

    <section class="epc-prj-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Projects Overview</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-prj-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/cp/production-overview-app">Production overview</a>
        </div>
    </section>

    <div class="epc-prj-kpis" aria-label="Projects stats">
        <div class="epc-prj-kpi"><strong>@_summary.OpenProjects.ToString(CultureInfo.InvariantCulture)</strong><span>Open projects</span></div>
        <div class="epc-prj-kpi"><strong>@_summary.TaskCount.ToString(CultureInfo.InvariantCulture)</strong><span>Tasks</span></div>
        <div class="epc-prj-kpi"><strong>@_summary.ContractCount.ToString(CultureInfo.InvariantCulture)</strong><span>Contracts</span></div>
    </div>

    <div class="epc-prj-table-wrap">
        <table class="epc-prj-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Billing</th>
                    <th>Contract value</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_projects.Count == 0)
                {
                    <tr><td colspan="7">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var p in _projects)
                    {
                        <tr>
                            <td><strong>@p.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(p.Code) ? "—" : p.Code)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.Name) ? "—" : p.Name)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.Status) ? "—" : p.Status)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.BillingType) ? "—" : p.BillingType)</td>
                            <td>@p.ContractValue.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=projects&tab=projects&epc_erp_shell=1";
    private bool _isAdmin;
    private CpProjectsOverviewSummary _summary = new(0, 0, 0, "n/a", "");
    private IReadOnlyList<CpProjectDigest> _projects = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpProjectsOverviewDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _projects = result.Projects;
        _source = result.Source;
        _message = result.Message;
    }
}
