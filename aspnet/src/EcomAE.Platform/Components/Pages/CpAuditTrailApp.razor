@page "/cp/audit-trail-app"
@page "/erp/audit-trail-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Audit trail · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Audit trail
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/audit-trail-app")</p>
                <p>Open a row for old/new JSON, IP, and device.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/audit-trail-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedDetail is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Audit trail KPIs">
        <div class="kpi"><div class="lbl">Entries</div><div class="val">@_summary.EntryCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Actions</div><div class="val">@_summary.ActionCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Admins</div><div class="val">@_summary.AdminCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Entity types</div><div class="val">@_summary.EntityTypeCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedDetail is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedDetail.Action) ? _openedDetail.Action : ("Event #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@_openedDetail.TimeUnix.ToString(CultureInfo.InvariantCulture)</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedDetail.EntityType) ? _openedDetail.EntityType : "—")
                        #@_openedDetail.EntityId.ToString(CultureInfo.InvariantCulture)
                        · Admin @_openedDetail.AdminId.ToString(CultureInfo.InvariantCulture)</p>
                    <p>@(!string.IsNullOrWhiteSpace(_openedDetail.Summary) ? _openedDetail.Summary : "—")</p>
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.IpAddress) || !string.IsNullOrWhiteSpace(_openedDetail.UserAgent))
                    {
                        <p>@(!string.IsNullOrWhiteSpace(_openedDetail.IpAddress) ? _openedDetail.IpAddress : "—")
                            @if (!string.IsNullOrWhiteSpace(_openedDetail.UserAgent))
                            {
                                <span> · @_openedDetail.UserAgent</span>
                            }
                        </p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.OldJson) || !string.IsNullOrWhiteSpace(_openedDetail.NewJson))
                    {
                        <p class="text-muted">Old @(!string.IsNullOrWhiteSpace(_openedDetail.OldJson) ? _openedDetail.OldJson : "—")
                            → New @(!string.IsNullOrWhiteSpace(_openedDetail.NewJson) ? _openedDetail.NewJson : "—")</p>
                    }
                    else
                    {
                        <p class="text-muted">No JSON yet.</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.DetailJson))
                    {
                        <p class="text-muted">@_openedDetail.DetailJson</p>
                    }
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_summary.EntryCount.ToString(CultureInfo.InvariantCulture) Entries · @_summary.ActionCount.ToString(CultureInfo.InvariantCulture) Actions · @_summary.AdminCount.ToString(CultureInfo.InvariantCulture) Admins · @_summary.EntityTypeCount.ToString(CultureInfo.InvariantCulture) Entity types.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Time</th>
                                <th>Admin</th>
                                <th>Action</th>
                                <th>Entity</th>
                                <th>Entity id</th>
                                <th>Summary</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_rows.Count == 0)
                            {
                                <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
                            }
                            else
                            {
                                @foreach (var row in _rows)
                                {
                                    <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                        <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@row.TimeUnix.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@row.AdminId.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.Action) ? row.Action : "—")</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.EntityType) ? row.EntityType : "—")</td>
                                        <td>@row.EntityId.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.Summary) ? row.Summary : "—")</td>
                                        <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "event_id", row.Id)">Open</a></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=audit_wb&tab=audit";
    private bool _isAdmin;
    private CpAuditTrailSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpAuditTrailEntryDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private CpAuditTrailEntryDetail? _openedDetail;
    private string _listHref = "/cp/audit-trail-app";

    private string OpenedCaption => _openedDetail is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedDetail.Action) ? ("Event #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.Action)
            + " · " + (string.IsNullOrWhiteSpace(_openedDetail.EntityType) ? "audit" : _openedDetail.EntityType);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var path = ctx.Request.Path.Value;
        _listHref = string.Equals(path, "/erp/audit-trail-app", StringComparison.OrdinalIgnoreCase)
            ? "/erp/audit-trail-app"
            : "/cp/audit-trail-app";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "event_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpAuditTrailDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Entries;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpAuditTrailDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Entry;
            if (_openedDetail is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
