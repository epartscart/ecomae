@page "/cp/audit-trail-app"
@page "/erp/audit-trail-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Audit trail · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Audit trail
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/audit-trail-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/audit-trail-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_summary.EntryCount.ToString(CultureInfo.InvariantCulture) Entries · @_summary.ActionCount.ToString(CultureInfo.InvariantCulture) Actions · @_summary.AdminCount.ToString(CultureInfo.InvariantCulture) Admins · @_summary.EntityTypeCount.ToString(CultureInfo.InvariantCulture) Entity types.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Time</th>
                    <th>Admin</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Entity id</th>
                    <th>Summary</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="8">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.TimeUnix.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.AdminId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Action) ? row.Action : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.EntityType) ? row.EntityType : "—")</td>
                            <td>@row.EntityId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Summary) ? row.Summary : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=audit_wb&tab=audit";
    private bool _isAdmin;
    private CpAuditTrailSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpAuditTrailEntryDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpAuditTrailDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Entries;
        _source = result.Source;
        _message = result.Message;
    }
}
