@page "/cp/slider-banners-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Slider / banners · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Slider / banners
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Homepage slider images and timing. Save settings, add a path, or reorder here.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/slider-banners-app" IsAdmin="_isAdmin" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/slider-banners/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/slider-banners-app" />
            <input type="hidden" name="action" value="setings" />
            <label>Connected
                <select name="connected">
                    <option value="1">Yes</option>
                    <option value="0">No</option>
                </select>
            </label>
            <label>Visible <input type="number" name="cntImg" value="1" min="1" style="width:5rem" /></label>
            <label>Scroll <input type="number" name="cntImgNext" value="1" min="1" style="width:5rem" /></label>
            <label>Seconds <input type="number" name="timeNext" value="3" min="1" style="width:5rem" /></label>
            <button type="submit">Save settings</button>
        </form>
        <form method="post" action="/cp/slider-banners/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/slider-banners-app" />
            <input type="hidden" name="action" value="add" />
            <label>Path <input type="text" name="href" required placeholder="/content/files/images/slide.jpg" /></label>
            <label>Link <input type="text" name="link" placeholder="/shop" /></label>
            <button type="submit">Add path</button>
        </form>
        <form method="post" action="/cp/slider-banners/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/slider-banners-app" />
            <input type="hidden" name="action" value="up" />
            <label>Image id <input type="number" name="imageId" min="1" required style="width:6rem" /></label>
            <button type="submit">Move up</button>
        </form>
        <form method="post" action="/cp/slider-banners/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/slider-banners-app" />
            <input type="hidden" name="action" value="do" />
            <label>Image id <input type="number" name="imageId" min="1" required style="width:6rem" /></label>
            <button type="submit">Move down</button>
        </form>
        <form method="post" action="/cp/slider-banners/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/slider-banners-app" />
            <input type="hidden" name="action" value="del" />
            <label>Image id <input type="number" name="imageId" min="1" required style="width:6rem" /></label>
            <button type="submit">Delete image</button>
        </form>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Images</div>
            <div class="panel-body">
                <p class="help-block">@_summary.ImageCount.ToString(CultureInfo.InvariantCulture) images · connected @_summary.Connected.ToString(CultureInfo.InvariantCulture) · visible @_summary.CntImg.ToString(CultureInfo.InvariantCulture) · scroll @_summary.CntImgNext.ToString(CultureInfo.InvariantCulture).</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Order</th>
                                <th>Link</th>
                                <th>Href</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_rows.Count == 0)
                        {
                            <tr><td colspan="4">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr>
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Link) ? row.Link : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Href) ? row.Href : "—")</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/content/slider";
    private bool _isAdmin;
    private CpSliderBannersSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpSliderBannersRowDigest> _rows = [];
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpSliderBannersDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Images;
    }
}
