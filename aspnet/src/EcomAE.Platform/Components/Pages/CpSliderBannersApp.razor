@page "/cp/slider-banners-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@inject ICpSliderEditorService Slider
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Slider · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<style>
    .epc-sl-thumb { max-width:120px; max-height:60px; border:1px solid #e4e5e7; background:#fafafa; }
    .epc-sl-table td, .epc-sl-table th { vertical-align:middle; }
    .epc-sl-table .btn-link { padding:0; }
</style>

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    @if (!_isAdmin)
    {
        <div class="hpanel"><div class="panel-body">
            <div class="alert alert-warning" role="status">Sign in to the Control Panel to manage the slider. <a href="/cp/login?returnUrl=/cp/slider-banners-app">Login</a></div>
        </div></div>
    }
    else
    {
        @* ---- content/slider/slider.php twin ---- *@
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Slider
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="alert alert-success" role="status">@_flashOk</div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="alert alert-danger" role="status">@_flashErr</div> }

        <div class="row">
            <div class="col-md-6">
                <div class="hpanel">
                    <div class="panel-heading hbuilt">Add image</div>
                    <div class="panel-body">
                        <small>
                            <strong>Help</strong><br />
                            The slider shows images from the list below in the given order.<br /><br />
                            Upload the image with the <a href="/cp/file-manager-app">file manager</a> and paste its path here, or use a full URL.<br /><br />
                            Recommended: images of equal size.<br />
                            The link is optional — leave it empty for a non-clickable slide.
                        </small>
                        <br /><br />
                        <form method="post" action="/cp/slider-banners/write">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@_listHref" />
                            <input type="hidden" name="action" value="add" />
                            <label for="href">Image <small>(path or URL)</small>:</label><br />
                            <input type="text" id="href" name="href" class="form-control" required placeholder="Example: /images/slider/banner1.jpg" />
                            <br />
                            <label for="link">Link <small>(opens on click)</small>:</label><br />
                            <input type="text" id="link" name="link" class="form-control" placeholder="Example: /shop/katalog-tovarov" />
                            <br />
                            <input type="submit" class="btn btn-ar btn-primary" value="Add" />
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="hpanel">
                    <div class="panel-heading hbuilt">Slider settings</div>
                    <div class="panel-body">
                        <form method="post" action="/cp/slider-banners/write">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@_listHref" />
                            <input type="hidden" name="action" value="setings" />
                            <label for="cnt_img">Images visible at once:</label><br />
                            <input class="form-control" type="number" id="cnt_img" name="cnt_img" min="1" placeholder="Example: 1" value="@_page.Settings.CntImg.ToString(CultureInfo.InvariantCulture)" />
                            <br />
                            <label for="cnt_img_next">Images scrolled per step:</label><br />
                            <input class="form-control" type="number" id="cnt_img_next" name="cnt_img_next" min="1" placeholder="Example: 1" value="@_page.Settings.CntImgNext.ToString(CultureInfo.InvariantCulture)" />
                            <br />
                            <label for="time_next">Interval, seconds:</label><br />
                            <input class="form-control" type="number" id="time_next" name="time_next" min="1" placeholder="Example: 5" value="@_page.Settings.TimeNextSeconds.ToString(CultureInfo.InvariantCulture)" />
                            <br /><br />
                            <input style="width:25px;height:25px;" id="connected" type="checkbox" name="connected" checked="@_page.Settings.Connected" />
                            <label style="cursor:pointer;position:relative;top:-7px;" for="connected">Slider enabled</label>
                            <br /><br />
                            <input type="submit" class="btn btn-ar btn-primary" value="Save" />
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="hpanel">
            <div class="panel-heading hbuilt">Images</div>
            <div class="panel-body">
                @if (_page.Images.Count == 0)
                {
                    <p>No slider images yet.</p>
                }
                else
                {
                    <form id="action_form" name="action_form" method="post" action="/cp/slider-banners/write">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@_listHref" />
                        <input id="action" type="hidden" name="action" value="" />
                        <input id="id" type="hidden" name="id" value="" />
                    </form>
                    <table class="table epc-sl-table" style="text-align:left;">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>&nbsp;</th>
                                <th>&nbsp;</th>
                                <th>Image</th>
                                <th>Link</th>
                                <th>&nbsp;</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var img in _page.Images)
                        {
                            var idText = img.Id.ToString(CultureInfo.InvariantCulture);
                            <tr id="erp-row-@idText">
                                <td>@img.Order.ToString(CultureInfo.InvariantCulture)</td>
                                <td><a onclick="save_action('up', '@idText');" href="javascript:void(0);">Up</a></td>
                                <td><a onclick="save_action('do', '@idText');" href="javascript:void(0);">Down</a></td>
                                <td style="width:40%;"><img class="epc-sl-thumb" src="@img.Href" alt="" loading="lazy" /> <span>@img.Href</span></td>
                                <td style="width:40%;">@img.Link</td>
                                <td><a class="btn btn-ar btn-primary" onclick="if (confirm('Delete this image?')) save_action('del', '@idText');" href="javascript:void(0);">Delete</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <script>
                        function save_action(action, id) {
                            document.getElementById('action').value = action;
                            document.getElementById('id').value = id;
                            document.forms["action_form"].submit();
                        }
                    </script>
                }
            </div>
            <div class="panel-footer">Order changes and deletions are applied immediately.</div>
        </div>
    }
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/content/slider";
    private const string _listHref = "/cp/slider-banners-app";
    private bool _isAdmin;
    private string _flashOk = "";
    private string _flashErr = "";
    private CpSliderPage _page = new(new CpSliderSettings(1, 1, 5, false), []);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        _page = await Slider.LoadAsync(ctx.RequestAborted);
    }
}
