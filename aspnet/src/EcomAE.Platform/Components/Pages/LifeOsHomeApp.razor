@page "/lifeos"
@* No trailing-slash twin — /lifeos vs /lifeos/ AmbiguousMatchException under ASP.NET routing. *@
@layout Layout.LifeOsProductLayout
@using EcomAE.Platform.LifeOs.Cinematic
@using EcomAE.Platform.LifeOs.Purpose
@using EcomAE.Platform.LifeOs.Spec
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ILifeOsMasterSpec Spec
@inject ILifeOsCinematicFilm Film
@inject ILifeOsDailyRoutineMatrix Routine

<PageTitle>LifeOS™ — Universal Ambient Artificial Intelligence</PageTitle>
<PhpSurfaceHead Surface="lifeos" />
<PhpChromeBodyClass Surface="lifeos" />

@*
  Editorial LifeOS home — brand-led hero over cinema, restrained sections.
  Critical CSS duplicated in the BODY stream — live SSR may drop HeadContent.
  Video sources / ambient JS untouched.
*@
<HeadContent>
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<meta name="ecomae-lifeos-chrome-css" content="body-inline" />
<style>@((MarkupString)_css)</style>
</HeadContent>
<style>@((MarkupString)_css)</style>

<div class="lifeos-ambient lifeos-infographic">
  <section class="lifeos-hero" aria-label="LifeOS hero">
    <div class="lifeos-hero__plane" aria-hidden="true">
      <video id="lifeos-hero-video"
             class="lifeos-hero__video"
             autoplay
             muted
             loop
             playsinline
             preload="auto"
             poster="@Film.PosterUrl">
        <source src="@Film.HeroVideoUrl" type="video/mp4" />
      </video>
    </div>
    <div class="lifeos-hero__veil" aria-hidden="true"></div>
    @* Decorative motion anchors (tests + reduced-motion). *@
    <svg class="lifeos-hero__spark" viewBox="0 0 120 40" aria-hidden="true" focusable="false">
      <defs>
        <marker id="loHeroMarker" marker-end="url(#loHeroArrow)" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 0 L10 5 L0 10 Z" fill="currentColor" />
        </marker>
        <marker id="loHeroArrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0 0 L10 5 L0 10 Z" fill="currentColor" />
        </marker>
      </defs>
      <path d="M4 28 C28 8, 52 32, 88 12" fill="none" stroke="currentColor" stroke-width="1.4" marker-end="url(#loHeroArrow)" />
    </svg>
    <div class="lifeos-hero__flow-a" aria-hidden="true"></div>
    <div class="lifeos-hero__flow-b" aria-hidden="true"></div>
    <div class="lifeos-hero__figure" aria-hidden="true"></div>

    <div class="lifeos-hero__content">
      <h1 class="lifeos-brand">Life<em>OS</em>™</h1>
      <p class="lifeos-hero__headline">Your day, with your clone beside you</p>
      <p class="lifeos-hero__lede">
        Morning to evening — @Film.ProtagonistName talks with @Film.ProtagonistName, the same-name AI clone, for advice on every daily move. Human control always first.
      </p>
      <div class="lifeos-cta">
        <a class="lifeos-cta__primary" href="@EcomAeRoutes.LifeOsJoin">Join &amp; install</a>
        <a class="lifeos-cta__ghost" href="@EcomAeRoutes.LifeOsCinematicApp">Watch the film</a>
        <a class="lifeos-cta__ghost" href="@EcomAeRoutes.LifeOsApp">Enter LifeOS</a>
      </div>
    </div>
    <button type="button"
            id="lifeos-ambient-toggle"
            class="lifeos-ambient-toggle"
            aria-pressed="false"
            aria-controls="lifeos-hero-video"
            title="Turn ambient dialogue sound on">
      ◀ AMBIENT
    </button>
  </section>
  <script>
  (() => {
    const KEY = 'lifeos-hero-ambient-on';
    const bind = () => {
      const v = document.getElementById('lifeos-hero-video');
      const btn = document.getElementById('lifeos-ambient-toggle');
      if (!v || !btn) return;

      const setUi = (on) => {
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        btn.classList.toggle('is-on', on);
        btn.title = on ? 'Mute ambient dialogue' : 'Turn ambient dialogue sound on';
        btn.textContent = on ? '◼ SOUND ON' : '◀ AMBIENT';
      };

      const apply = (on) => {
        v.muted = !on;
        v.volume = on ? 0.85 : 0;
        if (on) {
          v.play().catch(() => {});
        }
        setUi(on);
        try { sessionStorage.setItem(KEY, on ? '1' : '0'); } catch (_) {}
      };

      btn.addEventListener('click', () => {
        const next = v.muted || btn.getAttribute('aria-pressed') !== 'true';
        apply(next);
      });

      let preferOn = false;
      try { preferOn = sessionStorage.getItem(KEY) === '1'; } catch (_) {}
      setUi(false);
      v.muted = true;
      v.volume = 0.85;
      v.play().catch(() => {});

      if (preferOn) {
        const unlock = () => {
          apply(true);
          window.removeEventListener('pointerdown', unlock, true);
          window.removeEventListener('keydown', unlock, true);
        };
        window.addEventListener('pointerdown', unlock, true);
        window.addEventListener('keydown', unlock, true);
      }
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bind);
    } else {
      bind();
    }
  })();
  </script>

  <nav class="lifeos-navstrip" aria-label="LifeOS destinations">
    <a href="@EcomAeRoutes.LifeOsMobile">Mobile companion</a>
    <a href="@EcomAeRoutes.LifeOsResults">My results</a>
    <a href="@EcomAeRoutes.LifeOsRoutine">24/7 routine</a>
    <a href="@EcomAeRoutes.LifeOsDemoApp">How it works</a>
    <a href="@EcomAeRoutes.LifeOsSpec">Master Spec v@_version</a>
    <a href="@EcomAeRoutes.LifeOsRoadmapApp">Part 10 roadmap</a>
  </nav>

  <section class="lifeos-section lifeos-film" aria-labelledby="lo-film-title">
    <h2 id="lo-film-title">Daily clone film</h2>
    <p class="lifeos-section__lede">
      Morning → evening with human @Film.ProtagonistName and identical AI clone @Film.ProtagonistName — advice at every stage.
    </p>
    <div class="lifeos-film__player">
      <video id="lifeos-film-inline"
             controls
             playsinline
             preload="metadata"
             poster="@Film.PosterUrl"
             aria-label="LifeOS daily human + AI clone routine film with dialogue">
        <source src="@Film.VideoUrl" type="video/mp4" />
      </video>
    </div>
    <p class="lifeos-film__more">
      <a class="lifeos-film__dl" href="@Film.VideoDownloadUrl" download="LifeOS-Daily-Clone-Routine.mp4">Download MP4</a>
      <a href="@EcomAeRoutes.LifeOsCinematicApp">Open film theatre →</a>
      <a href="@EcomAeRoutes.IpApp">IP download panel →</a>
    </p>
  </section>

  <section class="lifeos-section lifeos-flow" aria-labelledby="lo-flow-title">
    <h2 id="lo-flow-title">How LifeOS moves with you</h2>
    <p class="lifeos-section__lede">A continuous loop — never a black box.</p>
    <ol class="lifeos-flow__track">
      <li>
        <strong>Perceive</strong>
        <span>Context, markets, routines, devices</span>
      </li>
      <li class="lifeos-flow__arrow" aria-hidden="true">→</li>
      <li>
        <strong>Decide</strong>
        <span>Reasoning, risk, ethics, confidence</span>
      </li>
      <li class="lifeos-flow__arrow" aria-hidden="true">→</li>
      <li>
        <strong>Act</strong>
        <span>Plans, alerts, workflows you approve</span>
      </li>
      <li class="lifeos-flow__arrow" aria-hidden="true">→</li>
      <li>
        <strong>Learn</strong>
        <span>Preferences deepen — authority stays yours</span>
      </li>
    </ol>
  </section>

  <section class="lifeos-section lifeos-lifestyle" aria-labelledby="lo-life-title">
    <h2 id="lo-life-title">Professional life, one operating system</h2>
    <p class="lifeos-section__lede">Five domains LifeOS keeps in balance — with financial clarity at the center.</p>
    <ul class="lifeos-lifestyle__grid">
      <li>
        <strong>Work</strong>
        <span>Priorities, meetings, focus blocks</span>
      </li>
      <li>
        <strong>Wealth</strong>
        <span>Cashflow signals, commitments, goals</span>
      </li>
      <li>
        <strong>Health</strong>
        <span>Energy, recovery, sustainable pace</span>
      </li>
      <li>
        <strong>Home</strong>
        <span>Household routines and continuity</span>
      </li>
      <li>
        <strong>Mobility</strong>
        <span>Travel, vehicle, on-the-move assist</span>
      </li>
    </ul>
  </section>

  <section class="lifeos-section lifeos-routine" aria-labelledby="lo-routine-title">
    <h2 id="lo-routine-title">24/7 Daily Human Routine Matrix</h2>
    <p class="lifeos-section__lede">
      Purpose coverage across the full day — proactive assistance and cloned-voice responses from wake to sleep.
      Verdict: <strong>@Routine.Digest().CoverageVerdict</strong>.
    </p>
    <ol class="lifeos-routine__list">
      @foreach (var s in Routine.Segments.Where(x => x.IsCorePurposeRow))
      {
        <li>
          <em>@s.Window</em>
          <strong>@s.Mode</strong>
          <span>@s.HumanActivity</span>
        </li>
      }
    </ol>
    <p class="lifeos-routine__more">
      <a href="@EcomAeRoutes.LifeOsRoutine">Open full matrix + cloned voice samples →</a>
    </p>
  </section>

  <section class="lifeos-section lifeos-brain" aria-labelledby="lo-brain-title">
    <h2 id="lo-brain-title">Nine brain engines</h2>
    <p class="lifeos-section__lede">Foundational cognition before domain agents assemble a response.</p>
    <div class="lifeos-brain__row" aria-label="LifeOS brain engines">
      @foreach (var engine in _engines)
      {
        <span>@engine</span>
      }
    </div>
  </section>

  <section class="lifeos-section lifeos-parts" aria-labelledby="lo-parts-title">
    <h2 id="lo-parts-title">Master Spec v@_version — full stack</h2>
    <p class="lifeos-section__lede">Parts 1–10 are live scaffolds — including Part 10 execution strategy (Ch.151–168).</p>
    <ol class="lifeos-parts__timeline">
      @foreach (var part in Spec.Parts)
      {
        var href = PartHref(part.Number);
        <li>
          <div class="lifeos-parts__index">
            <span class="lifeos-parts__num">@part.Number.ToString("00")</span>
            <span class="lifeos-parts__rail" aria-hidden="true"></span>
          </div>
          <div class="lifeos-parts__body">
            <h3>@part.Title</h3>
            <p>@string.Join(" · ", part.Chapters.Take(4))@(part.Chapters.Count > 4 ? " ·…" : "")</p>
            @if (href is not null)
            {
              <a href="@href">Open part →</a>
            }
          </div>
        </li>
      }
    </ol>
  </section>

  <section class="lifeos-section lifeos-principles" aria-labelledby="lo-prin-title">
    <h2 id="lo-prin-title">Non‑negotiable principles</h2>
    <p class="lifeos-section__lede">The product never overrides your authority.</p>
    <ul class="lifeos-principles__list">
      <li><strong>Ambient intelligence</strong><span>Context without repeated prompts.</span></li>
      <li><strong>Human control</strong><span>No irreversible action without permission.</span></li>
      <li><strong>Explainability</strong><span>Reasoning, confidence, sources, uncertainty.</span></li>
      <li><strong>Privacy by design</strong><span>Sensitive perception stays local first.</span></li>
      <li><strong>Continuous learning</strong><span>Goals deepen — instructions stay sovereign.</span></li>
    </ul>
  </section>

</div>

<PhpLifeOsAmbientAudio ButtonId="lifeOsHomeAmbient" />

@code {
    private string _version = "4.0";
    private static readonly string[] _engines =
    [
        "Context", "Memory", "Planning", "Decision", "Reasoning",
        "Learning", "Safety", "Emotion & Personality", "Agent Orchestrator"
    ];

    protected override void OnInitialized()
    {
        _version = Spec.Version;
    }

    private static string? PartHref(int number) => number switch
    {
        1 => EcomAeRoutes.LifeOsApp,
        2 => EcomAeRoutes.LifeOsArchitectureApp,
        3 => EcomAeRoutes.LifeOsCognitiveApp,
        4 => EcomAeRoutes.LifeOsMultimodalApp,
        5 => EcomAeRoutes.LifeOsPlatformApp,
        6 => EcomAeRoutes.LifeOsInfraApp,
        7 => EcomAeRoutes.LifeOsSecurityApp,
        8 => EcomAeRoutes.LifeOsClientsApp,
        9 => EcomAeRoutes.LifeOsPluginsApp,
        10 => EcomAeRoutes.LifeOsRoadmapApp,
        _ => null
    };

    private const string _css = """
:root {
  --lo-black: #020617;
  --lo-ink: #0f172a;
  --lo-blue: #1d4ed8;
  --lo-blue-bright: #2563eb;
  --lo-blue-deep: #0b1b3a;
  --lo-white: #ffffff;
  --lo-paper: #f1f5f9;
  --lo-line: #cbd5e1;
  --lo-muted: #475569;
  --lo-display: "Fraunces", Georgia, serif;
  --lo-sans: "Sora", "Segoe UI", sans-serif;
}
html, body.lifeos-body {
  margin: 0;
  min-height: 100vh;
  background: var(--lo-paper);
  color: var(--lo-ink);
  font-family: var(--lo-sans);
}
.lifeos-infographic { color: var(--lo-ink); font-family: var(--lo-sans); }
.lifeos-hero {
  position: relative;
  min-height: calc(100vh - 3.5rem);
  min-height: calc(100dvh - 3.5rem);
  display: flex;
  align-items: flex-end;
  padding: clamp(1.75rem, 5vw, 4rem);
  overflow: hidden;
  color: var(--lo-white);
  background: var(--lo-black);
}
.lifeos-hero__plane {
  position: absolute; inset: 0; z-index: 0; overflow: hidden; background: #020617;
}
.lifeos-hero__video {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center center;
  display: block; transform: scale(1.03);
  filter: saturate(1.02) contrast(1.04);
}
.lifeos-hero__veil {
  position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background:
    linear-gradient(105deg, rgba(2,6,23,.9) 0%, rgba(2,6,23,.55) 42%, rgba(2,6,23,.22) 72%, rgba(2,6,23,.4) 100%),
    linear-gradient(0deg, rgba(2,6,23,.78) 0%, transparent 52%);
}
.lifeos-hero__spark {
  position: absolute; left: clamp(1rem, 4vw, 3rem); top: 18%;
  width: min(28vw, 11rem); height: auto; z-index: 2;
  color: rgba(147,197,253,.55);
  animation: lifeos-spark 2.8s ease-in-out infinite alternate;
}
.lifeos-hero__flow-a, .lifeos-hero__flow-b {
  position: absolute; z-index: 2; pointer-events: none;
  height: 1px; background: linear-gradient(90deg, transparent, rgba(147,197,253,.45), transparent);
}
.lifeos-hero__flow-a { top: 28%; left: 38%; width: 22%; animation: lifeos-flowline 4s ease-in-out infinite; }
.lifeos-hero__flow-b { top: 62%; right: 12%; width: 18%; animation: lifeos-flowline 5.2s ease-in-out infinite reverse; }
.lifeos-hero__figure {
  position: absolute; right: 8%; top: 22%; z-index: 2; width: 8rem; height: 8rem;
  border: 1px solid rgba(148,163,184,.22); border-radius: 50%;
  animation: lifeos-rise 1.2s ease-out both;
}
.lifeos-hero__content {
  position: relative; z-index: 3;
  max-width: 34rem;
  animation: lifeos-rise .85s ease-out both;
}
.lifeos-ambient-toggle {
  position: absolute;
  right: clamp(1rem, 3vw, 2rem);
  bottom: clamp(1rem, 3vw, 2rem);
  z-index: 4;
  appearance: none;
  border: 1px solid rgba(255,255,255,.35);
  background: rgba(2,6,23,.75);
  color: #e2e8f0;
  font-family: var(--lo-sans);
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  padding: .6rem .85rem;
  border-radius: .15rem;
  cursor: pointer;
}
.lifeos-ambient-toggle:hover,
.lifeos-ambient-toggle.is-on {
  background: rgba(29,78,216,.9);
  border-color: rgba(147,197,253,.65);
  color: #fff;
}
@@keyframes lifeos-rise {
  from { opacity: 0; transform: translateY(14px); }
  to { opacity: 1; transform: none; }
}
