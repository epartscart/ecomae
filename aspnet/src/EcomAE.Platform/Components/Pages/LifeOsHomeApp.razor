.lifeos-routine__list {
  list-style: none; margin: 0; padding: 0;
  display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0;
  border-top: 1px solid var(--lo-line);
}
.lifeos-routine__list li {
  padding: 1rem .95rem 1.1rem 0;
  border-bottom: 1px solid var(--lo-line);
  background: transparent;
}
.lifeos-routine__list em {
  display: block; font-style: normal; color: var(--lo-blue);
  font-size: .75rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
}
.lifeos-routine__list strong { display: block; margin: .25rem 0 .3rem; font-size: 1rem; }
.lifeos-routine__list span { color: var(--lo-muted); font-size: .86rem; line-height: 1.4; }
.lifeos-routine__more { margin: 1rem auto 0; }
.lifeos-routine__more a { color: var(--lo-blue); font-weight: 700; text-decoration: none; }
.lifeos-routine__more a:hover { text-decoration: underline; }
.lifeos-brain__row {
  display: flex; flex-wrap: wrap; gap: .4rem .9rem;
  border-top: 1px solid var(--lo-line);
  padding-top: 1rem;
}
.lifeos-brain__row span {
  font-size: .86rem; font-weight: 650;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--lo-ink);
  border-radius: 0;
}
.lifeos-brain__row span::before {
  content: "·";
  color: var(--lo-blue);
  margin-right: .4rem;
  font-weight: 800;
}
.lifeos-parts__timeline {
  list-style: none; margin: 0; padding: 0;
  display: flex; flex-direction: column; gap: 0;
}
.lifeos-parts__timeline > li {
  display: grid;
  grid-template-columns: 4.25rem 1fr;
  gap: 1rem;
  padding: 1.05rem 0;
  border-bottom: 1px solid var(--lo-line);
}
.lifeos-parts__num {
  font-family: var(--lo-display);
  font-size: 1.55rem;
  font-weight: 700;
  color: var(--lo-blue);
  line-height: 1;
}
.lifeos-parts__rail {
  display: block; width: 1px; height: 100%; min-height: 2rem;
  margin: .4rem 0 0 .85rem;
  background: var(--lo-line);
}
.lifeos-parts__body h3 {
  margin: 0 0 .3rem;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--lo-black);
}
.lifeos-parts__body p {
  margin: 0 0 .5rem;
  color: var(--lo-muted);
  font-size: .9rem;
  line-height: 1.45;
}
.lifeos-parts__body a {
  color: var(--lo-blue);
  font-weight: 700;
  text-decoration: none;
  font-size: .9rem;
}
.lifeos-parts__body a:hover { text-decoration: underline; }
.lifeos-principles__list {
  list-style: none; margin: 0; padding: 0;
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
  border-top: 1px solid var(--lo-line);
}
.lifeos-principles__list li {
  display: grid;
  grid-template-columns: minmax(10rem, 14rem) 1fr;
  gap: 1rem;
  padding: 1rem 0;
  border-bottom: 1px solid var(--lo-line);
}
.lifeos-principles__list strong {
  font-size: .98rem; color: var(--lo-black);
}
.lifeos-principles__list span { color: var(--lo-muted); font-size: .92rem; line-height: 1.5; }
@@media (max-width: 900px) {
  .lifeos-lifestyle__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .lifeos-flow__track { grid-template-columns: 1fr; }
  .lifeos-flow__arrow { display: none; }
  .lifeos-principles__list li { grid-template-columns: 1fr; gap: .25rem; }
}
@@media (max-width: 720px) {
  .lifeos-hero { align-items: center; }
  .lifeos-parts__timeline > li { grid-template-columns: 3.1rem 1fr; }
  .lifeos-hero__figure { display: none; }
}
@@media (prefers-reduced-motion: reduce) {
  .lifeos-hero__spark, .lifeos-hero__flow-a, .lifeos-hero__flow-b,
  .lifeos-hero__figure, .lifeos-hero__content { animation: none !important; }
  .lifeos-hero__spark { stroke-dashoffset: 0; }
}
