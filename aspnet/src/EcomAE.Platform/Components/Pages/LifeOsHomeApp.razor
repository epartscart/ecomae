}
.lifeos-brand {
  font-family: var(--lo-display);
  font-size: clamp(3.4rem, 11vw, 6.4rem);
  line-height: .9;
  letter-spacing: -.03em;
  margin: 0 0 .7rem;
  font-weight: 700;
  color: var(--lo-white);
}
.lifeos-brand em {
  font-style: italic;
  font-weight: 500;
  color: #93c5fd;
}
.lifeos-hero__headline {
  margin: 0 0 .55rem;
  font-family: var(--lo-sans);
  font-weight: 700;
  font-size: clamp(1.05rem, 2.1vw, 1.3rem);
  color: #e2e8f0;
}
.lifeos-hero__lede {
  margin: 0 0 1.25rem;
  max-width: 30rem;
  font-size: clamp(.94rem, 1.6vw, 1.05rem);
  line-height: 1.55;
  color: rgba(226,232,240,.88);
}
.lifeos-cta { display: flex; flex-wrap: wrap; gap: .65rem; }
.lifeos-cta a {
  display: inline-flex; align-items: center;
  padding: .8rem 1.15rem;
  border-radius: .18rem;
  font-weight: 700; font-size: .9rem;
  text-decoration: none;
  transition: background .2s ease, color .2s ease, border-color .2s ease;
}
.lifeos-cta__primary { background: var(--lo-blue); color: var(--lo-white); }
.lifeos-cta__primary:hover { background: #1e40af; }
.lifeos-cta__ghost {
  background: transparent;
  color: var(--lo-white);
  border: 1px solid rgba(255,255,255,.42);
}
.lifeos-cta__ghost:hover { border-color: #fff; background: rgba(255,255,255,.06); }
.lifeos-navstrip {
  display: flex; flex-wrap: wrap; gap: .55rem 1.25rem;
  justify-content: center;
  padding: .95rem clamp(1rem, 3vw, 2rem);
  background: var(--lo-white);
  border-bottom: 1px solid var(--lo-line);
  font-size: .86rem;
}
.lifeos-navstrip a {
  color: var(--lo-muted);
  text-decoration: none;
  font-weight: 650;
}
.lifeos-navstrip a:hover { color: var(--lo-black); }
.lifeos-section {
  padding: clamp(2.5rem, 5.5vw, 4.25rem) clamp(1.25rem, 4vw, 3rem);
  max-width: 70rem;
  margin: 0 auto;
}
.lifeos-section h2 {
  font-family: var(--lo-display);
  font-size: clamp(1.75rem, 3.6vw, 2.55rem);
  font-weight: 700;
  margin: 0 0 .35rem;
  color: var(--lo-black);
  letter-spacing: -.02em;
}
.lifeos-section__lede {
  margin: 0 0 1.6rem;
  max-width: 36rem;
  color: var(--lo-muted);
  line-height: 1.55;
  font-size: .98rem;
}
.lifeos-film {
  max-width: none;
  background: var(--lo-black);
  color: var(--lo-white);
  border-block: 1px solid rgba(148,163,184,.18);
}
.lifeos-film h2 { color: var(--lo-white); }
.lifeos-film .lifeos-section__lede { color: #94a3b8; }
.lifeos-film > h2,
.lifeos-film > .lifeos-section__lede,
.lifeos-film > .lifeos-film__player,
.lifeos-film > .lifeos-film__more {
  max-width: 70rem; margin-left: auto; margin-right: auto;
}
.lifeos-film__player {
  overflow: hidden;
  background: #000;
  border: 1px solid rgba(148,163,184,.2);
}
.lifeos-film__player video {
  display: block; width: 100%; aspect-ratio: 16 / 9; background: #000;
}
.lifeos-film__more {
  margin: 1rem 0 0;
  display: flex; flex-wrap: wrap; gap: .7rem 1.1rem; align-items: center;
}
.lifeos-film__more a { color: #93c5fd; text-decoration: none; font-weight: 650; }
.lifeos-film__more a:hover { text-decoration: underline; }
.lifeos-film__dl {
  display: inline-block;
  padding: .5rem .95rem;
  border-radius: .18rem;
  font-weight: 700;
  background: var(--lo-blue);
  color: #fff !important;
  text-decoration: none !important;
}
.lifeos-flow {
  background: var(--lo-white);
  border-block: 1px solid var(--lo-line);
  max-width: none;
}
.lifeos-flow > h2, .lifeos-flow > .lifeos-section__lede,
.lifeos-flow > .lifeos-flow__track {
  max-width: 70rem; margin-left: auto; margin-right: auto;
}
.lifeos-flow__track {
  list-style: none; margin: 0; padding: 0;
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
  gap: .75rem 0.5rem;
