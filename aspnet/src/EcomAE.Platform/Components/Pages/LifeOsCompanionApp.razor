@page "/lifeos/mobile"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing

<PageTitle>LifeOS™ Companion</PageTitle>
<PhpSurfaceHead Surface="lifeos" />
<PhpChromeBodyClass Surface="lifeos" />
<link rel="manifest" href="@EcomAeRoutes.LifeOsManifest" />
<meta name="theme-color" content="#2563eb" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<style>@((MarkupString)_css)</style>
<HeadContent>
<link rel="manifest" href="@EcomAeRoutes.LifeOsManifest" />
<meta name="theme-color" content="#2563eb" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="ecomae-chrome-surface" content="lifeos-mobile" />
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<style>@((MarkupString)_css)</style>
</HeadContent>

<div class="locomp" id="lifeos-companion">
  <header class="locomp-top">
    <div>
      <div class="brand">Life<em>OS</em></div>
      <p class="who" id="locomp-who">Loading…</p>
    </div>
    <div class="locomp-top-actions">
      <a class="ghost" id="locomp-results" href="@EcomAeRoutes.LifeOsResults">Results</a>
      <button type="button" id="locomp-install" class="ghost">Install</button>
      <a class="ghost" href="@EcomAeRoutes.LifeOsJoin">Join</a>
    </div>
  </header>

  <nav class="locomp-tabs" role="tablist" aria-label="Companion modes">
    <button type="button" data-mode="track" class="is-on">track</button>
    <button type="button" data-mode="talk">talk</button>
    <button type="button" data-mode="listen">listen</button>
    <button type="button" data-mode="guide">guide</button>
  </nav>

  <main class="locomp-main">
    <section data-panel="track">
      <h1>Track</h1>
      <p class="lede">Log movement and focus. Your clone advises beside you.</p>
      <div class="row">
        <button type="button" class="primary" data-track="walk|Walk|1">Start walk</button>
        <button type="button" class="ghost" data-track="workout|Workout set|1">Log set</button>
        <button type="button" class="ghost" data-track="focus|Focus block|25">Focus 25m</button>
      </div>
      <p class="bubble" id="locomp-track-advice" hidden></p>
      <h2>Recent tracks</h2>
      <ul class="feed" id="locomp-track-feed"><li class="muted">No events yet — tap Start walk.</li></ul>
    </section>

    <section data-panel="talk" hidden>
      <h1>Talk</h1>
      <p class="lede">Speak to your same-name clone. Mic uses the browser Speech API when available.</p>
      <label>
        <span>You → clone</span>
        <textarea id="locomp-utterance" rows="3" placeholder="Walk me through today."></textarea>
      </label>
      <div class="row">
        <button type="button" class="primary" id="locomp-mic">Hold to talk</button>
        <button type="button" class="ghost" id="locomp-send">Send</button>
      </div>
      <p class="bubble" id="locomp-talk-reply" hidden></p>
    </section>

    <section data-panel="listen" hidden>
      <h1>Listen</h1>
      <p class="lede">Clone speaks the next guide beat aloud.</p>
      <div class="row">
        <button type="button" class="primary" id="locomp-listen-next">Speak next beat</button>
        <button type="button" class="ghost" id="locomp-listen-stop">Stop</button>
      </div>
      <ol class="beats" id="locomp-beats"></ol>
    </section>

    <section data-panel="guide" hidden>
      <h1>Guide</h1>
      <p class="lede">Morning → evening prompts with your clone.</p>
      <div class="row">
        <button type="button" class="primary" data-guide="Walk me through today.">Morning brief</button>
        <button type="button" class="ghost" data-guide="How should I handle this meeting?">Deep work</button>
        <button type="button" class="ghost" data-guide="Check my form.">Gym</button>
        <button type="button" class="ghost" data-guide="Summarize my day and plan tomorrow.">Evening</button>
      </div>
      <p class="bubble" id="locomp-guide-reply" hidden></p>
    </section>
  </main>

  <footer class="locomp-foot">
    <a href="@EcomAeRoutes.LifeOs">Home</a>
    <a id="locomp-foot-results" href="@EcomAeRoutes.LifeOsResults">My results</a>
    <span>No login · PWA scaffold</span>
  </footer>
</div>

<script src="/lifeos/companion.js" defer></script>

@code {
    private const string _css = """
.locomp {
  --bg:#05070c; --ink:#f4f7fb; --mute:#9fb0c6; --blue:#2563eb; --cyan:#5ec8ff;
  min-height:100vh; min-height:100dvh; background:var(--bg); color:var(--ink);
  font-family:"Sora","Segoe UI",sans-serif; display:flex; flex-direction:column;
  padding-bottom:env(safe-area-inset-bottom);
}
.locomp-top {
  display:flex; justify-content:space-between; align-items:flex-start; gap:1rem;
  padding:calc(.85rem + env(safe-area-inset-top)) 1rem .75rem;
  border-bottom:1px solid rgba(255,255,255,.08);
  background:linear-gradient(180deg,rgba(37,99,235,.25),transparent);
}
.brand { font-weight:750; font-size:1.25rem; }
.brand em { font-style:normal; color:var(--cyan); }
.who { margin:.2rem 0 0; color:var(--mute); font-size:.82rem; }
.locomp-top-actions { display:flex; gap:.4rem; flex-wrap:wrap; }
.locomp-tabs {
  display:grid; grid-template-columns:repeat(4,1fr); gap:.35rem; padding:.65rem .75rem;
  position:sticky; top:0; z-index:5; background:rgba(5,7,12,.92); backdrop-filter:blur(8px);
}
.locomp-tabs button {
  appearance:none; border:1px solid rgba(255,255,255,.12); background:rgba(255,255,255,.03);
  color:var(--mute); padding:.65rem .2rem; border-radius:8px; font-weight:700; text-transform:capitalize; cursor:pointer;
}
.locomp-tabs button.is-on { background:var(--blue); border-color:transparent; color:#fff; }
.locomp-main { flex:1; padding:1rem 1rem 1.5rem; }
.locomp-main h1 { margin:0 0 .35rem; font-size:1.55rem; }
.locomp-main h2 { margin:1.1rem 0 .45rem; font-size:1rem; color:var(--mute); font-weight:650; }
.lede { color:var(--mute); margin:0 0 1rem; line-height:1.45; }
.row { display:flex; flex-wrap:wrap; gap:.5rem; margin-bottom:.9rem; }
button.primary, a.primary {
  appearance:none; border:0; background:var(--blue); color:#fff; padding:.8rem 1rem; border-radius:8px;
  font-weight:700; cursor:pointer; text-decoration:none;
}
button.ghost, a.ghost {
  appearance:none; border:1px solid rgba(255,255,255,.3); background:transparent; color:#fff;
  padding:.7rem .9rem; border-radius:8px; font-weight:700; cursor:pointer; text-decoration:none; font-size:.85rem;
}
textarea {
  width:100%; box-sizing:border-box; min-height:5.5rem; border-radius:8px; border:1px solid rgba(255,255,255,.15);
  background:#0b1220; color:#fff; padding:.8rem; font:inherit; font-size:16px; margin:.35rem 0 .75rem;
}
label span { display:block; font-size:.78rem; color:var(--mute); }
.bubble {
  background:rgba(56,189,248,.12); border:1px solid rgba(56,189,248,.35);
  padding:.85rem 1rem; border-radius:10px; line-height:1.45; margin:.5rem 0 1rem;
}
.feed, .beats { margin:0; padding-left:1.1rem; color:var(--mute); line-height:1.5; }
.feed li, .beats li { margin-bottom:.45rem; word-break:break-word; }
.muted { color:var(--mute); }
.locomp-foot {
  display:flex; flex-wrap:wrap; gap:.75rem; justify-content:space-between;
  padding:.85rem 1rem calc(.85rem + env(safe-area-inset-bottom));
  border-top:1px solid rgba(255,255,255,.08); color:var(--mute); font-size:.78rem;
}
.locomp-foot a { color:var(--cyan); text-decoration:none; }
""";
}
