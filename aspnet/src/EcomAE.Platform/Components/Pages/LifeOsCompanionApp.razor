  display:flex; flex-wrap:wrap; gap:.75rem; justify-content:space-between;
  padding:.85rem 1rem calc(.85rem + env(safe-area-inset-bottom));
  border-top:1px solid rgba(255,255,255,.08); color:var(--mute); font-size:.78rem;
}
