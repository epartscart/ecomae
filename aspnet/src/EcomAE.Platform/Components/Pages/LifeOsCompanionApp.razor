  min-height:100vh; min-height:100dvh; background:var(--bg); color:var(--ink);
  font-family:"Sora","Segoe UI",sans-serif; display:flex; flex-direction:column;
  padding-bottom:env(safe-area-inset-bottom);
}
.locomp-top {
  display:flex; justify-content:space-between; align-items:flex-start; gap:1rem;
  padding:calc(.85rem + env(safe-area-inset-top)) 1rem .75rem;
  border-bottom:1px solid rgba(255,255,255,.08);
  background:linear-gradient(180deg,rgba(37,99,235,.25),transparent);
}
.brand { font-weight:750; font-size:1.25rem; letter-spacing:.02em; }
.brand em { font-style:normal; color:var(--cyan); }
