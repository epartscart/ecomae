.locomp-top-actions { display:flex; gap:.4rem; }
.locomp-tabs {
  display:grid; grid-template-columns:repeat(4,1fr); gap:.35rem; padding:.65rem .75rem;
  position:sticky; top:0; z-index:5; background:rgba(5,7,12,.92); backdrop-filter:blur(8px);
}
.locomp-tabs button {
  appearance:none; border:1px solid rgba(255,255,255,.12); background:rgba(255,255,255,.03);
  color:var(--mute); padding:.65rem .2rem; border-radius:8px; font-weight:700; text-transform:capitalize; cursor:pointer;
}
.locomp-tabs button.is-on { background:var(--blue); border-color:transparent; color:#fff; }
.locomp-main { flex:1; padding:1rem 1rem 1.5rem; }
.locomp-main h1 { margin:0 0 .35rem; font-size:1.55rem; }
.locomp-main h2 { margin:1.1rem 0 .45rem; font-size:1rem; color:var(--mute); font-weight:650; }
.lede { color:var(--mute); margin:0 0 1rem; line-height:1.45; }
.row { display:flex; flex-wrap:wrap; gap:.5rem; margin-bottom:.9rem; }
button.primary, a.primary {
  appearance:none; border:0; background:var(--blue); color:#fff; padding:.8rem 1rem; border-radius:8px;
  font-weight:700; cursor:pointer; text-decoration:none;
}
button.ghost, a.ghost {
  appearance:none; border:1px solid rgba(255,255,255,.3); background:transparent; color:#fff;
  padding:.7rem .9rem; border-radius:8px; font-weight:700; cursor:pointer; text-decoration:none; font-size:.85rem;
}
textarea {
  width:100%; box-sizing:border-box; min-height:5.5rem; border-radius:8px; border:1px solid rgba(255,255,255,.15);
  background:#0b1220; color:#fff; padding:.8rem; font:inherit; margin:.35rem 0 .75rem;
}
label span { display:block; font-size:.78rem; color:var(--mute); }
.bubble {
  background:rgba(56,189,248,.12); border:1px solid rgba(56,189,248,.35);
  padding:.85rem 1rem; border-radius:10px; line-height:1.45; margin:.5rem 0 1rem;
}
.feed, .beats, .actions { margin:0; padding-left:1.1rem; color:var(--mute); line-height:1.5; }
.feed li, .beats li { margin-bottom:.45rem; word-break:break-word; }
