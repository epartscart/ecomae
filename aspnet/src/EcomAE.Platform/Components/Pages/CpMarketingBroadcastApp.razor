@page "/cp/marketing-broadcast-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Marketing Broadcast · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-mkt-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-mkt-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-mkt-hero p { margin:0; color:#fed7aa; max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-mkt-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-mkt-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#7c2d12; background:#e0f2fe;
        }
        .epc-mkt-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-mkt-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-mkt-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-mkt-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-mkt-kpi span { color:#64748b; font-size:.78rem; }
        .epc-mkt-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-mkt-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-mkt-table th, .epc-mkt-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-mkt-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-mkt-note { margin-top:1rem; padding:.75rem .9rem; background:#fff7ed; border:1px solid #fed7aa; border-radius:.45rem; color:#9a3412; font-size:.86rem; }
        @@media (max-width:900px){ .epc-mkt-kpis{grid-template-columns:1fr;} }
    
</style>
</HeadContent>


<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-mkt-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Marketing Broadcast</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-mkt-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/cp/demo-tenants-app">Demo tenants</a>
        </div>
    </section>

    <div class="epc-mkt-kpis" aria-label="Broadcast stats">
        <div class="epc-mkt-kpi"><strong>@_summary.Campaigns.ToString(CultureInfo.InvariantCulture)</strong><span>Campaigns</span></div>
        <div class="epc-mkt-kpi"><strong>@_summary.EmailsSent.ToString(CultureInfo.InvariantCulture)</strong><span>Emails sent (ok)</span></div>
        <div class="epc-mkt-kpi"><strong>@_summary.WhatsappSent.ToString(CultureInfo.InvariantCulture)</strong><span>WhatsApp sent (ok)</span></div>
    </div>

    <div class="epc-mkt-table-wrap">
        <table class="epc-mkt-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Channel</th>
                    <th>Subject</th>
                    <th>Audience</th>
                    <th>Targets</th>
                    <th>OK / Fail</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_campaigns.Count == 0)
                {
                    <tr><td colspan="8">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var c in _campaigns)
                    {
                        <tr>
                            <td><strong>@c.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(c.Channel) ? "—" : c.Channel)</td>
                            <td>@(string.IsNullOrWhiteSpace(c.Subject) ? "—" : c.Subject)</td>
                            <td>@(string.IsNullOrWhiteSpace(c.AudienceMode) ? "—" : c.AudienceMode)</td>
                            <td>@c.TotalTargets.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@c.SentOk.ToString(CultureInfo.InvariantCulture) / @c.SentFail.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(c.Status) ? "—" : c.Status)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_marketing_broadcast";
    private bool _isAdmin;
    private CpMarketingBroadcastSummary _summary = new(0, 0, 0, "n/a", "");
    private IReadOnlyList<CpMarketingBroadcastCampaignDigest> _campaigns = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpMarketingBroadcastDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _campaigns = result.Campaigns;
        _source = result.Source;
        _message = result.Message;
    }
}
