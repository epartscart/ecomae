@page "/cp/marketing-broadcast-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Marketing Broadcast · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Marketing broadcast
                <a class="btn btn-xs btn-default pull-right" href="/cp/demo-tenants-app" style="margin-right:.4rem">Demo tenants</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/marketing-broadcast-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/marketing-broadcast-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_summary.Campaigns.ToString(CultureInfo.InvariantCulture) Campaigns · @_summary.EmailsSent.ToString(CultureInfo.InvariantCulture) Emails sent (ok) · @_summary.WhatsappSent.ToString(CultureInfo.InvariantCulture) WhatsApp sent (ok).</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Created</th>
                    <th>Channel</th>
                    <th>Template</th>
                    <th>Subject</th>
                    <th>Preview</th>
                    <th>Audience</th>
                    <th>Audience meta</th>
                    <th>Targets</th>
                    <th>OK / Fail</th>
                    <th>Status</th>
                    <th>Operator</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_campaigns.Count == 0)
                {
                    <tr><td colspan="13">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var c in _campaigns)
                    {
                        <tr>
                            <td><strong>@c.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@c.CreatedAt.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(c.Channel) ? "—" : c.Channel)</td>
                            <td>@(string.IsNullOrWhiteSpace(c.TemplateKey) ? "—" : c.TemplateKey)</td>
                            <td>@(string.IsNullOrWhiteSpace(c.Subject) ? "—" : c.Subject)</td>
                            <td>@(string.IsNullOrWhiteSpace(c.Preview) ? "—" : c.Preview)</td>
                            <td>@(string.IsNullOrWhiteSpace(c.AudienceMode) ? "—" : c.AudienceMode)</td>
                            <td>@(string.IsNullOrWhiteSpace(c.AudienceMeta) ? "—" : c.AudienceMeta)</td>
                            <td>@c.TotalTargets.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@c.SentOk.ToString(CultureInfo.InvariantCulture) / @c.SentFail.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(c.Status) ? "—" : c.Status)</td>
                            <td>@c.OperatorId.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_marketing_broadcast";
    private bool _isAdmin;
    private CpMarketingBroadcastSummary _summary = new(0, 0, 0, "n/a", "");
    private IReadOnlyList<CpMarketingBroadcastCampaignDigest> _campaigns = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpMarketingBroadcastDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _campaigns = result.Campaigns;
        _source = result.Source;
        _message = result.Message;
    }
}
