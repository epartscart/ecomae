@page "/cp/bulk-upload-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Bulk upload · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <PhpCpModulePageHeader Title="Bulk upload"
                           Subtitle="PHP bulk_upload_hub parity — operator history from epc_bulk_upload_history. process_upload / review / quote / cart writes stay PHP."
                           PhpTabHref="@_phpTab">
        <a class="ghost" href="/cp/prices-upload-app">Prices upload</a>
        <a class="ghost" href="/storefront/bulk-upload-app">Storefront bulk</a>
        <a class="ghost" href="/cp/orders">Orders</a>
    </PhpCpModulePageHeader>

    @if (!_isAdmin)
    {
        <div class="alert alert-info" role="status">Sign in with a Control Panel admin session to load live tenant data. Guest browse shows the PHP-parity shell.</div>
    }

    <div class="epc-scp-kpi" aria-label="Bulk upload stats">
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Uploads</div>
            <div class="epc-scp-kpi__val">@_summary.UploadCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Uploaded lines</div>
            <div class="epc-scp-kpi__val">@_summary.UploadedLines.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Available</div>
            <div class="epc-scp-kpi__val">@_summary.AvailableCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Not found</div>
            <div class="epc-scp-kpi__val">@_summary.NotFoundCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
    </div>

    <div class="epc-scp-tool-grid" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin-bottom:1rem;">
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">process_upload</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">ingest file</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">mark_reviewed</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">operator review</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">create_quote</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">quote handoff</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">add_to_cart</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">cart handoff</p>
        </a>
    </div>

    <div class="epc-scp-table-card">
        <div class="epc-scp-table-card__head">
            <div>
                <h3>Upload history</h3>
                <p class="epc-users-hint">PHP ajax_bulk_cp history — file, priority, line counts. File bodies omitted.</p>
            </div>
            <a class="btn btn-primary btn-xs" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Open PHP module</a>
        </div>
        <table class="epc-scp-data-table table table-epc-pro">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>File</th>
                    <th>Priority</th>
                    <th>Uploaded</th>
                    <th>Available</th>
                    <th>Cross</th>
                    <th>Short</th>
                    <th>Not found</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_uploads.Count == 0)
                {
                    <tr><td colspan="10">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _uploads)
                    {
                        <tr>
                            <td><strong>@row.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.FileName) ? "—" : row.FileName)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Priority) ? "—" : row.Priority)</td>
                            <td>@row.UploadedCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.AvailableCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CrossCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.ShortCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.NotFoundCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.CreatedAt) ? "—" : row.CreatedAt)</td>
                            <td><a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/bulk_upload";
    private bool _isAdmin;
    private CpBulkUploadSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpBulkUploadRowDigest> _uploads = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpBulkUploadDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _uploads = result.Uploads;
    }
}
