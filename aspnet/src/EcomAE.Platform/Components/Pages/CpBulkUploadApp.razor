@page "/cp/bulk-upload-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Bulk upload · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/bulk-upload-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpCpModulePageHeader Title="Bulk upload"
                           Subtitle="Open a row for the 280-character notes, result, and csv excerpts. process_upload / review / quote / cart writes stay PHP."
                           PhpTabHref="@_phpTab">
        <a class="ghost" href="/cp/prices-upload-app">Prices upload</a>
        <a class="ghost" href="/storefront/bulk-upload-app">Storefront bulk</a>
        <a class="ghost" href="/cp/orders">Orders</a>
    </PhpCpModulePageHeader>

    @if (!_isAdmin)
    {
        <div class="alert alert-info" role="status">Sign in with a Control Panel admin session to load live tenant data. Guest browse shows the PHP-parity shell.</div>
    }

    <div class="epc-scp-kpi" aria-label="Bulk upload stats">
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Uploads</div>
            <div class="epc-scp-kpi__val">@_summary.UploadCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Uploaded lines</div>
            <div class="epc-scp-kpi__val">@_summary.UploadedLines.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Available</div>
            <div class="epc-scp-kpi__val">@_summary.AvailableCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Not found</div>
            <div class="epc-scp-kpi__val">@_summary.NotFoundCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
    </div>

    <div class="epc-scp-tool-grid" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin-bottom:1rem;">
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">process_upload</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">ingest file</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">mark_reviewed</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">operator review</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">create_quote</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">quote handoff</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">add_to_cart</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">cart handoff</p>
        </a>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-scp-table-card" style="margin-bottom:1rem">
            <div class="epc-scp-table-card__head">
                <div>
                    <h3>@OpenedCaption</h3>
                    <p class="epc-users-hint">process_upload / review / quote / cart stay on the Classic twin. File bodies omitted.</p>
                </div>
                <a class="btn btn-default btn-xs" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-default btn-xs" href="@_listHref">Close</a>
            </div>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>File</dt><dd>@(string.IsNullOrWhiteSpace(_opened.FileName) ? "—" : _opened.FileName)</dd>
                <dt>Priority</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Priority) ? "—" : _opened.Priority)</dd>
                <dt>Source</dt><dd>@(string.IsNullOrWhiteSpace(_opened.SourceLabel) ? "—" : _opened.SourceLabel)</dd>
                <dt>User</dt><dd>@_opened.UserId.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Uploaded</dt><dd>@_opened.UploadedCount.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Available</dt><dd>@_opened.AvailableCount.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Cross</dt><dd>@_opened.CrossCount.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Short</dt><dd>@_opened.ShortCount.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Not found</dt><dd>@_opened.NotFoundCount.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Shop quote</dt><dd>@_opened.ShopQuoteId.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>CRM quote</dt><dd>@_opened.CrmQuoteId.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Cart added</dt><dd>@_opened.CartAddedCount.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Created</dt><dd>@(string.IsNullOrWhiteSpace(_opened.CreatedAt) ? "—" : _opened.CreatedAt)</dd>
                <dt>Updated</dt><dd>@(string.IsNullOrWhiteSpace(_opened.UpdatedAt) ? "—" : _opened.UpdatedAt)</dd>
            </dl>
            @if (!string.IsNullOrWhiteSpace(_opened.NotesExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">notes excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.NotesExcerpt</pre>
                @if (_opened.NotesLen > _opened.NotesExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.NotesExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NotesLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No notes excerpt yet.</p>
            }
            @if (!string.IsNullOrWhiteSpace(_opened.ResultExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">result excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.ResultExcerpt</pre>
                @if (_opened.ResultLen > _opened.ResultExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.ResultExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.ResultLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No result excerpt yet.</p>
            }
            @if (!string.IsNullOrWhiteSpace(_opened.CsvExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">csv excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.CsvExcerpt</pre>
                @if (_opened.CsvLen > _opened.CsvExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.CsvExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.CsvLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No csv excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-priority siblings</p>
                <table class="epc-scp-data-table table table-epc-pro">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>File</th>
                            <th>Priority</th>
                            <th>Not found</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.FileName) ? "—" : sib.FileName)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Priority) ? "—" : sib.Priority)</td>
                                <td>@sib.NotFoundCount.ToString(CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "upload_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-priority siblings yet.</p>
            }
        </div>
    }

    <div class="epc-scp-table-card">
        <div class="epc-scp-table-card__head">
            <div>
                <h3>Upload history</h3>
                <p class="epc-users-hint">Open uses <code>?upload_id=</code>. File bodies omitted.</p>
            </div>
            <a class="btn btn-primary btn-xs" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Open PHP module</a>
        </div>
        <table class="epc-scp-data-table table table-epc-pro">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>File</th>
                    <th>Priority</th>
                    <th>Uploaded</th>
                    <th>Available</th>
                    <th>Cross</th>
                    <th>Short</th>
                    <th>Not found</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_uploads.Count == 0)
                {
                    <tr><td colspan="10">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _uploads)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td><strong>@row.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.FileName) ? "—" : row.FileName)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Priority) ? "—" : row.Priority)</td>
                            <td>@row.UploadedCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.AvailableCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CrossCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.ShortCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.NotFoundCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.CreatedAt) ? "—" : row.CreatedAt)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "upload_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/bulk_upload";
    private const string _listHref = "/cp/bulk-upload-app";
    private bool _isAdmin;
    private CpBulkUploadSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpBulkUploadRowDigest> _uploads = [];
    private long _openedId;
    private CpBulkUploadDetail? _opened;
    private IReadOnlyList<CpBulkUploadRowDigest> _openedSiblings = [];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.FileName)
            ? _opened.FileName
            : ("Upload #" + _opened.Id.ToString(CultureInfo.InvariantCulture)));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?upload_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "upload_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpBulkUploadDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _uploads = result.Uploads;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpBulkUploadDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Upload;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _uploads.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _uploads = new[] { openedList }.Concat(_uploads.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }
}
