@page "/cp/system-requests-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>System requests · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                System requests
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Open a VIN request for a text excerpt and thread. Mark viewed here. Live Laximo decode and file attachments stay on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/system-requests-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedRequest is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/requests/set-vin-viewed" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/system-requests-app" />
            <label>VIN request id <input type="number" name="requestId" min="1" required style="width:6rem" value="@(_openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "")" /></label>
            <label>Viewed <input type="number" name="viewedFlag" min="0" max="1" value="1" style="width:3rem" /></label>
            <button type="submit" class="btn btn-xs btn-primary">Mark viewed</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="VIN request KPIs">
        <div class="kpi"><div class="lbl">Requests</div><div class="val">@_summary.RequestCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Unviewed</div><div class="val">@_summary.UnviewedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Viewed</div><div class="val">@_summary.ViewedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Opened messages</div><div class="val">@_openedMessages.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedRequest is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Request #@_openedRequest.Id.ToString(CultureInfo.InvariantCulture)
                    <span class="label label-default pull-right">@(_openedRequest.Viewed != 0 ? "viewed" : "unviewed")</span>
                </div>
                <div class="panel-body">
                    <p>User @_openedRequest.UserId.ToString(CultureInfo.InvariantCulture)
                        · time @_openedRequest.TimeUnix.ToString(CultureInfo.InvariantCulture)</p>
                    @if (!string.IsNullOrWhiteSpace(_openedRequest.TextExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedRequest.TextExcerpt</pre>
                        @if (_openedRequest.TextLen > _openedRequest.TextExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_openedRequest.TextExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedRequest.TextLen.ToString(CultureInfo.InvariantCulture) chars). Full HTML and files stay on the Classic twin.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No request excerpt yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Messages</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>From</th>
                                    <th>Time</th>
                                    <th>Excerpt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedMessages.Count == 0)
                                {
                                    <tr><td colspan="4">No messages yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var msg in _openedMessages)
                                    {
                                        <tr>
                                            <td>@msg.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(msg.IsCustomer != 0 ? "customer" : "staff")</td>
                                            <td>@msg.TimeUnix.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(msg.TextExcerpt))
                                                {
                                                    @msg.TextExcerpt
                                                    @if (msg.TextLen > msg.TextExcerpt.Length)
                                                    {
                                                        <span class="text-muted"> (excerpt)</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <text>—</text>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Same-user siblings</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Time</th>
                                    <th>Viewed</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="3">No same-user siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@sib.TimeUnix.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@sib.Viewed.ToString(CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Requests</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Time</th>
                                <th>User</th>
                                <th>Viewed</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!_isAdmin)
                        {
                            <tr><td colspan="5">Sign in for live data.</td></tr>
                        }
                        else if (_rows.Count == 0)
                        {
                            <tr><td colspan="5">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.TimeUnix.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.UserId.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.Viewed.ToString(CultureInfo.InvariantCulture)</td>
                                    <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "vin_id", row.Id)">Open</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/requests";
    private const string _listHref = "/cp/system-requests-app";
    private bool _isAdmin;
    private CpSystemRequestsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpSystemRequestsRowDigest> _rows = [];
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private CpSystemRequestsDetail? _openedRequest;
    private IReadOnlyList<CpSystemRequestMessageDigest> _openedMessages = [];
    private IReadOnlyList<CpSystemRequestsRowDigest> _openedSiblings = [];

    private string OpenedCaption => _openedRequest is null
        ? ""
        : ("Request #" + _openedRequest.Id.ToString(CultureInfo.InvariantCulture)
            + (_openedRequest.Viewed != 0 ? " · viewed" : " · unviewed"));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "vin_id");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpSystemRequestsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Requests;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpSystemRequestsDetailAsync(_openedId, ctx.RequestAborted);
            _openedRequest = detail.Request;
            _openedMessages = detail.Messages;
            _openedSiblings = detail.Siblings;
            if (_openedRequest is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }
}
