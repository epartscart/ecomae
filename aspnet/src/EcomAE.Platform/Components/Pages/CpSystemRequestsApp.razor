@page "/cp/system-requests-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>System requests · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                System requests
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Mark VIN requests viewed here. Live Laximo decode stays on the catalogue.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/system-requests-app" IsAdmin="_isAdmin" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/requests/set-vin-viewed" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/system-requests-app" />
            <label>VIN request id <input type="number" name="requestId" min="1" required style="width:6rem" /></label>
            <label>Viewed <input type="number" name="viewedFlag" min="0" max="1" value="1" style="width:3rem" /></label>
            <button type="submit" class="btn btn-xs btn-primary">Mark viewed</button>
        </form>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Requests</div>
            <div class="panel-body">
                <p class="help-block">@_summary.RequestCount.ToString(CultureInfo.InvariantCulture) requests · @_summary.UnviewedCount.ToString(CultureInfo.InvariantCulture) unviewed · @_summary.ViewedCount.ToString(CultureInfo.InvariantCulture) viewed · @_summary.WithUserCount.ToString(CultureInfo.InvariantCulture) with user.</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Time</th>
                                <th>User</th>
                                <th>Viewed</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_rows.Count == 0)
                        {
                            <tr><td colspan="4">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr>
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.TimeUnix.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.UserId.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.Viewed.ToString(CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/requests";
    private bool _isAdmin;
    private CpSystemRequestsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpSystemRequestsRowDigest> _rows = [];
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpSystemRequestsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Requests;
    }
}
