@page "/erp/sales-quotations-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Sales quotations · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Sales quotations" BreadcrumbArea="Sales" BreadcrumbTab="Proposals">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/sales-quotations-app" IsAdmin="_isAdmin" />
    <ErpPhpFlash Ok="@_flashOk" Err="@_flashErr" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Sales quotations" Subtitle="Save a CRM quote here. Open a row for lead/customer ids and the notes excerpt. Line bodies omitted. Accept and quote email stay on the Classic twin. This page does not invent a send." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Sales quotation stats">
        <div class="kpi"><div class="lbl">Quotes</div><div class="val">@_summary.QuoteCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Draft</div><div class="val">@_summary.DraftCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Sent</div><div class="val">@_summary.SentCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Accepted</div><div class="val">@_summary.AcceptedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Subtotal</div><div class="val">@_summary.SubtotalSum.ToString("0.00", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Quote #</dt><dd>@(string.IsNullOrWhiteSpace(_opened.QuoteNumber) ? "—" : _opened.QuoteNumber)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Status) ? "—" : _opened.Status)</dd>
                <dt>Currency</dt><dd>@(string.IsNullOrWhiteSpace(_opened.CurrencyCode) ? "—" : _opened.CurrencyCode)</dd>
                <dt>Subtotal</dt><dd>@_opened.Subtotal.ToString("0.00", CultureInfo.InvariantCulture)</dd>
                <dt>Opp</dt><dd>@(_opened.OpportunityId > 0 ? _opened.OpportunityId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Lead</dt><dd>@(_opened.LeadId > 0 ? _opened.LeadId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Customer</dt><dd>@(_opened.CustomerUserId > 0 ? _opened.CustomerUserId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Order</dt><dd>@(_opened.ShopOrderId > 0 ? _opened.ShopOrderId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Active</dt><dd>@(_opened.Active ? "yes" : "no")</dd>
                <dt>Updated</dt><dd>@(_opened.TimeUpdated > 0 ? _opened.TimeUpdated.ToString(CultureInfo.InvariantCulture) : "—")</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Line bodies omitted. Accept and quote email stay Classic.</p>
            @if (_isAdmin)
            {
                <form method="post" action="/cp/crm/quotes/write" style="margin:1rem 0 0;display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
                    <input type="hidden" name="action" value="save_quote" />
                    <input type="hidden" name="id" value="@_opened.Id.ToString(CultureInfo.InvariantCulture)" />
                    <label>Quote # <input type="text" name="quote_number" maxlength="32" value="@_opened.QuoteNumber" /></label>
                    <label>Opp <input type="text" name="opportunity_id" inputmode="numeric" value="@_opened.OpportunityId.ToString(CultureInfo.InvariantCulture)" /></label>
                    <label>Lead <input type="text" name="lead_id" inputmode="numeric" value="@_opened.LeadId.ToString(CultureInfo.InvariantCulture)" /></label>
                    <label>Customer <input type="text" name="customer_user_id" inputmode="numeric" value="@_opened.CustomerUserId.ToString(CultureInfo.InvariantCulture)" /></label>
                    <label>Status
                        <select name="status">
                            @foreach (var st in _statuses)
                            {
                                @if (string.Equals(st, _opened.Status, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@st" selected>@st</option>
                                }
                                else
                                {
                                    <option value="@st">@st</option>
                                }
                            }
                        </select>
                    </label>
                    @if (_opened.NotesLen > _opened.NotesExcerpt.Length)
                    {
                        <p class="text-muted" style="flex-basis:100%;margin:0">Full notes stay on the Classic twin. Leave notes blank here to keep them.</p>
                        <label>Notes <input type="text" name="notes" /></label>
                    }
                    else
                    {
                        <label>Notes <input type="text" name="notes" value="@_opened.NotesExcerpt" /></label>
                    }
                    <label>Line <input type="text" name="line_description" maxlength="512" /></label>
                    <label>Qty <input type="text" name="line_qty" inputmode="decimal" value="1" /></label>
                    <label>Price <input type="text" name="line_unit_price" inputmode="decimal" value="0" /></label>
                    <button type="submit" class="btn btn-primary btn-sm">Save quote</button>
                </form>
            }
            @if (!string.IsNullOrWhiteSpace(_opened.NotesExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">notes excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.NotesExcerpt</pre>
                @if (_opened.NotesLen > _opened.NotesExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.NotesExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NotesLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No notes excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Quote #</th>
                            <th>Status</th>
                            <th>Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.QuoteNumber) ? "—" : sib.QuoteNumber)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                <td>@sib.Subtotal.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "quote_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    @if (_isAdmin)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>New CRM quote</strong></p>
            <form method="post" action="/cp/crm/quotes/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@_listHref" />
                <input type="hidden" name="action" value="save_quote" />
                <input type="hidden" name="id" value="0" />
                <label>Quote # <input type="text" name="quote_number" maxlength="32" placeholder="Auto" /></label>
                <label>Opp <input type="text" name="opportunity_id" inputmode="numeric" value="0" /></label>
                <label>Lead <input type="text" name="lead_id" inputmode="numeric" value="0" /></label>
                <label>Customer <input type="text" name="customer_user_id" inputmode="numeric" value="0" /></label>
                <label>Status
                    <select name="status">
                        <option value="draft" selected>draft</option>
                        <option value="sent">sent</option>
                        <option value="accepted">accepted</option>
                        <option value="rejected">rejected</option>
                    </select>
                </label>
                <label>Notes <input type="text" name="notes" /></label>
                <label>Line <input type="text" name="line_description" maxlength="512" /></label>
                <label>Qty <input type="text" name="line_qty" inputmode="decimal" value="1" /></label>
                <label>Price <input type="text" name="line_unit_price" inputmode="decimal" value="0" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Create quote</button>
            </form>
            <p class="help-block" style="margin:.75rem 0 0">Accept and quote email stay Classic.</p>
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Quote #</th>
                    <th>Status</th>
                    <th>Currency</th>
                    <th>Subtotal</th>
                    <th>Opp</th>
                    <th>Order</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_quotations.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _quotations)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.QuoteNumber) ? row.QuoteNumber : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CurrencyCode) ? row.CurrencyCode : "—")</td>
                            <td>@row.Subtotal.ToString("0.00", CultureInfo.InvariantCulture)</td>
                            <td>@(row.OpportunityId > 0 ? row.OpportunityId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(row.ShopOrderId > 0 ? row.ShopOrderId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(row.Active ? "yes" : "no")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "quote_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=sales&tab=proposals";
    private const string _listHref = "/erp/sales-quotations-app";
    private bool _isAdmin;
    private ErpSalesQuotationsSummary _summary = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<ErpSalesQuotationDigest> _quotations = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private ErpSalesQuotationDetail? _opened;
    private IReadOnlyList<ErpSalesQuotationDigest> _openedSiblings = [];
    private static readonly string[] _statuses = ["draft", "sent", "accepted", "rejected"];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.QuoteNumber)
            ? _opened.QuoteNumber
            : ("Quote #" + _opened.Id.ToString(CultureInfo.InvariantCulture)));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?quote_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "quote_id");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildErpSalesQuotationsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _quotations = result.Quotations;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpSalesQuotationDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Quotation;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _quotations.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _quotations = new[] { openedList }.Concat(_quotations.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }
}
