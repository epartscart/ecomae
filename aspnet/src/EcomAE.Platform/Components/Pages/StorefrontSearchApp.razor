    tr.innerHTML =
      '<td class="td_manufacturer"><strong>' + esc(p.manufacturer || '') + '</strong></td>' +
      '<td class="td_article">' + esc(show) + '</td>' +
      '<td class="td_name">' + esc(p.name || '—') + '</td>' +
      '<td class="td_exist ' + (pricesVisible && exist > 0 ? 'epc-stock-ok' : 'epc-stock-out') + '">' + avail + '</td>' +
      '<td class="td_time_to_exe">' + term + '</td>' +
      '<td class="td_price ' + (pricesVisible ? '' : 'epc-sf-price-mask') + '">' + price + '</td>' +
