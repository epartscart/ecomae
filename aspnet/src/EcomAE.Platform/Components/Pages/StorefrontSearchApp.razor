@page "/storefront/search-app"
@page "/en/shop/part_search"
@page "/en/shop/warehouse-search"
@page "/parts/{PathBrand}/{PathArticle}"
@page "/en/parts/{PathBrand}/{PathArticle}"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject IStorefrontPriceAccess PriceAccess
@inject IHttpContextAccessor Http
@inject NavigationManager Navigation

<PageTitle>@PageTitleText</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<link rel="stylesheet" href="/platform-assets/epc_warehouse_search_parity.css?v=20260811x" />
<style>
        /* Keep PHP professional-shell look; only hide inventing ASP.NET chrome on CHPU/picker. */
        .epc-chpu-direct-part-search .epc-sf-search-form,
        .epc-chpu-direct-part-search .epc-sf-page-actions .btn-default,
        .epc-brand-picker-mode .epc-sf-search-kpis,
        .epc-chpu-direct-part-search .epc-sf-search-kpis { display:none !important; }
        .epc-sf-search-form { display:flex; gap:.45rem; flex-wrap:wrap; align-items:center; }
        .epc-sf-search-form input {
            flex:1; min-width:140px; padding:.4rem .65rem; border:1px solid #cbd5e1; border-radius:3px; font-size:.9rem; background:#fff; color:#111;
        }
        .epc-sf-poll-progress {
            margin:.65rem 0 12px; padding:.55rem .75rem; border-radius:.45rem;
            background:#eff6ff; border:1px solid #bfdbfe; color:#1e3a8a; font-size:.84rem;
        }
        .epc-sf-poll-progress[data-done="1"] { background:#f0fdf4; border-color:#bbf7d0; color:#14532d; }
        .epc-sf-price-gate {
            margin:0 0 .85rem; padding:.7rem .9rem; border-radius:.5rem; font-size:.86rem; line-height:1.4;
            background:#fff7ed; border:1px solid #fed7aa; color:#9a3412;
        }
        .epc-sf-price-gate a { color:#b91c1c; font-weight:700; }
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<PhpStorefrontDesktopChrome>

    @if (!_showBrandPicker && !_hideInPageSearch)
    {
        <PhpStorefrontPageHeader Title="@_heroTitle" Subtitle="@_heroSubtitle">
            <form class="epc-sf-search-form" method="get" action="@SearchFormAction">
                @if (string.Equals(_mode, "attr", StringComparison.OrdinalIgnoreCase))
                {
                    <input type="hidden" name="mode" value="attr" />
                    <input type="search" name="q" value="@_attrQuery" placeholder="Engine, size, country, cross ref…" aria-label="Warehouse / more info search" />
                }
                else if (string.Equals(_mode, "vin", StringComparison.OrdinalIgnoreCase))
                {
                    <input type="hidden" name="mode" value="vin" />
                    <input type="search" name="identString" value="@_articleInput" placeholder="Enter VIN / Frame" aria-label="VIN" maxlength="32" />
                }
                else if (string.Equals(_mode, "engine", StringComparison.OrdinalIgnoreCase))
                {
                    <input type="hidden" name="mode" value="engine" />
                    <input type="search" name="engine" value="@_articleInput" placeholder="Engine code (e.g. 3L, 12R)" aria-label="Engine code" />
                }
                else
                {
                    <input type="search" name="article" value="@_articleInput" placeholder="Part number / article" aria-label="Part number" required />
                    <input type="search" name="brand" value="@_brandInput" placeholder="Brand (optional)" aria-label="Brand" />
                }
                <button type="submit" class="btn btn-sm btn-primary">Search</button>
            </form>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.WarehouseSearch">Warehouse / more info</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.LaximoVin">VIN search</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.VehicleCatalog">Vehicle catalog</a>
        </PhpStorefrontPageHeader>
    }

    @if (_showBrandPicker)
    {
        <div class="row epc-part-search-layout epc-brand-picker-mode">
            <div class="epc-part-search-main col-md-12">
                <div class="epc-brand-picker-top">
                    <div class="epc-brand-picker-top__head">
                        <span class="epc-brand-picker-top__eyebrow"><i class="fa fa-search" aria-hidden="true"></i> Article</span>
                        <h2 class="epc-brand-picker-top__title">@_normalized</h2>
                        <p class="epc-brand-picker-top__hint">Several manufacturers use this part number. Choose a brand, then open warehouse prices and stock.</p>
                    </div>
                    <div id="work_area" class="epc-brand-picker-work-area">
                        <div id="products_area" class="epc-part-search-results" role="region" aria-label="Part search results">
                            @if (_brands.Count == 0)
                            {
                                <div class="epc-brand-picker-empty">
                                    No manufacturers found for this article (warehouse + local crosses). Try another part number.
                                    @if (!string.IsNullOrWhiteSpace(_message))
                                    {
                                        <div style="margin-top:.5rem;color:#92400e;">Brand lookup: <strong>@_source</strong> — @_message</div>
                                    }
                                </div>
                            }
                            else
                            {
                                var mask = StorefrontPriceAccess.SensitiveMask;
                                <div id="table-manufacturers" class="table-responsive epc-brand-picker-ssr">
                                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped epc-brand-picker-table">
                                        <thead>
                                            <tr>
                                                <th>Manufacturer</th>
                                                <th>Article</th>
                                                <th>Name</th>
                                                <th class="text-center">Availability</th>
                                                <th>Term</th>
                                                <th class="text-right">Price</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var brand in _brands)
                                            {
                                                var href = BrandArticleHref(_normalized, brand.Brand);
                                                <tr class="epc-brand-picker-row">
                                                    <td><a href="@href">@brand.Brand</a></td>
                                                    <td><a href="@href">@_normalized</a></td>
                                                    <td><a href="@href">—</a></td>
                                                    <td class="text-center"><a href="@href">@(_pricesVisible ? "—" : mask)</a></td>
                                                    <td><a href="@href">@(_pricesVisible ? "Open brand for stock" : mask)</a></td>
                                                    <td class="text-right"><a href="@href">@(_pricesVisible ? "—" : mask)</a></td>
                                                    <td class="text-right"><a class="btn btn-ar btn-primary btn-sm" href="@href">Open prices</a></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row epc-part-search-layout epc-chpu-direct-part-search">
            <div id="filter_div" class="col-md-3">
                <div class="panel panel-primary">
                    <div class="panel-heading" style="position:relative;">
                        <a id="filter_div_a_text" href="javascript:void(0);"><i class="fa fa-arrow-circle-up" aria-hidden="true"></i> Hide filter</a>
                    </div>
                    <div id="filter_div_style_body" class="panel-body" data-open="1">
                        <div id="filter_position">
                            <div class="one_property" id="manufacturer_blok" data-epc-filter="manufacturer">
                                <strong>Manufacturer</strong>
                                <div class="list_div" id="epc_filter_manufacturer_options">
                                    <span class="epc-fitment-message">Waiting for offers…</span>
                                </div>
                            </div>
                            <hr />
                            <div class="one_property" id="storages_blok" data-epc-filter="storages">
                                <strong>Storage / warehouse</strong>
                                <div class="list_div" id="epc_filter_storage_options">
                                    <span class="epc-fitment-message">Waiting for offers…</span>
                                </div>
                            </div>
                            <hr />
                            <div class="one_property" id="price_blok" data-epc-filter="price">
                                <strong>Price</strong>
                                <div class="slider_ranges">
                                    <input id="epc_filter_price_min" type="number" min="0" step="0.01" placeholder="Min" aria-label="Min price" class="form-control input-sm" style="width:48%;display:inline-block;" />
                                    <input id="epc_filter_price_max" type="number" min="0" step="0.01" placeholder="Max" aria-label="Max price" class="form-control input-sm" style="width:48%;display:inline-block;float:right;" />
                                </div>
                            </div>
                            <hr />
                            <div class="one_property" id="time_to_exe_blok" data-epc-filter="time_to_exe">
                                <strong>Delivery term (days)</strong>
                                <div class="slider_ranges">
                                    <input id="epc_filter_term_min" type="number" min="0" step="1" placeholder="Min" aria-label="Min term" class="form-control input-sm" style="width:48%;display:inline-block;" />
                                    <input id="epc_filter_term_max" type="number" min="0" step="1" placeholder="Max" aria-label="Max term" class="form-control input-sm" style="width:48%;display:inline-block;float:right;" />
                                </div>
                            </div>
                            <hr />
                            <div class="one_property" id="exist_blok" data-epc-filter="exist">
                                <strong>Availability</strong>
                                <div class="list_div">
                                    <input class="css-checkbox" type="checkbox" id="epc_filter_instock" />
                                    <label class="css-label" for="epc_filter_instock">In stock only</label>
                                </div>
                            </div>
                            <div id="epc_filter_status" class="epc-fitment-message" style="margin-top:10px;">Filter ready</div>
                        </div>
                    </div>
                    <div id="footer_filter_reset">
                        <a href="javascript:void(0);" class="btn btn-ar btn-primary" id="epc_filter_reset">Reset filter</a>
                    </div>
                    <div id="footer-filter"></div>
                </div>
            </div>

            <div class="epc-part-search-main col-md-9">
                <div id="epc-chpu-actions-bar" class="epc-chpu-actions-bar epc-parts-result-tools">
                    <button type="button" class="btn btn-default btn-sm epc-fitment-check-btn" id="epc-fitment-check-btn"
                            data-article="@_normalized" data-brand="@_brandInput">
                        <i class="fa fa-car" aria-hidden="true"></i> Fitment check
                    </button>
                    <button type="button" class="btn btn-default btn-sm epc-cross-search-btn" id="epc-cross-search-btn"
                            data-article="@_normalized" title="Open all cross references">
                        <i class="fa fa-random" aria-hidden="true"></i>
                        <span id="epc-cross-search-count">@(_crossRefs.Count + _relatedBrandCross.Count) references</span>
                    </button>
                    <a class="btn btn-default btn-sm" href="@ArticleOnlyHref(_articleInput)">Change manufacturer</a>
                </div>

                <div class="epc-fitment-panel" id="epc-fitment-panel" aria-live="polite">
                    <div class="epc-fitment-panel__head">
                        <div>
                            <div class="epc-fitment-panel__title">Part Fitment</div>
                            <div class="epc-fitment-panel__hint">Choose the matching brand/number — vehicle fitment loads automatically.</div>
                        </div>
                        <button type="button" class="epc-fitment-panel__close" id="epc-fitment-close" aria-label="Close fitment check">&times;</button>
                    </div>
                    <div class="epc-fitment-panel__body">
                        <div id="epc-fitment-brands" class="epc-fitment-message">Click Fitment check to load matching brands from eparts catalog.</div>
                        <div class="epc-fitment-type-tabs" id="epc-fitment-types" style="display:none;">
                            <button type="button" data-section="PC" class="active">Passenger</button>
                            <button type="button" data-section="CV">Commercial</button>
                            <button type="button" data-section="Motorcycle">Motorbike</button>
                            <button type="button" data-section="ALL">All vehicles</button>
                        </div>
                        <div class="epc-fitment-widget-shell" id="epc-fitment-widget-shell" style="display:none;">
                            <div id="epc-fitment-part" class="epc-fitment-part" style="display:none;" aria-live="polite"></div>
                            <div id="applicability_widget" class="epc-fitment-message">Select a brand/part box to load fitment.</div>
                        </div>
                    </div>
                </div>

                @if (!_pricesVisible)
                {
                    <div class="epc-sf-price-gate" data-access-state="@_accessState">
                        @((MarkupString)_loginCtaHtml)
                    </div>
                }

                <div id="epcSfPollProgress" class="epc-sf-poll-progress" hidden
                     data-article="@_normalized" data-brand="@_brandInput" aria-live="polite">
                    Polling suppliers… <span id="epcSfPollCount">0</span> of <span id="epcSfPollTotal">0</span>
                </div>

                <div id="products_area" class="epc-part-search-results" role="region" aria-label="Part search results">
                    <table id="all_table_products" class="epc-ssr-warehouse-table"
                           data-prices-visible="@(_pricesVisible ? "1" : "0")"
                           data-access-state="@_accessState">
                        <thead>
                            <tr>
                                <th class="th_photo"></th>
                                <th class="th_manufacturer">Manufacturer</th>
                                <th class="th_article">Article</th>
                                <th class="th_name">Name</th>
                                <th class="th_exist">Availability</th>
                                <th class="th_time_to_exe">Term</th>
                                <th class="th_info">Info</th>
                                <th class="th_price">Price</th>
                                <th class="th_add_to_cart">Actions</th>
                                <th class="th_color"></th>
                            </tr>
                        </thead>
                        <tbody id="epcSfOfferBody">
                            @if (string.IsNullOrWhiteSpace(_normalized))
                            {
                                <tr data-empty="1"><td colspan="10">Enter article and brand to load warehouse offers.</td></tr>
                            }
                            else if (_genuineRows.Count == 0 && _aftermarketRows.Count == 0)
                            {
                                <tr data-empty="1">
                                    <td colspan="10">
                                        No warehouse offers yet for <strong>@_brandInput @_normalized</strong> — polling suppliers…
                                        @if (!string.IsNullOrWhiteSpace(_message))
                                        {
                                            <div style="margin-top:.5rem;color:#92400e;">Offer lookup: <strong>@_source</strong> — @_message</div>
                                        }
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @if (_genuineRows.Count > 0)
                                {
                                    <tr>
                                        <td colspan="10" class="epc-part-type-split epc-part-type-split--genuine" data-section="genuine">
                                            <div class="epc-part-type-split__inner">
                                                <div class="epc-part-type-split__head">
                                                    <span class="epc-part-type-badge epc-part-type-badge--genuine">OE</span>
                                                    <strong class="epc-part-type-split__title">Genuine (OE) <span class="epc-part-type-count">(@_genuineRows.Count)</span></strong>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    @foreach (var row in _genuineRows)
                                    {
                                        @OfferRow(row, "genuine")
                                    }
                                }
                                @if (_aftermarketRows.Count > 0)
                                {
                                    <tr>
                                        <td colspan="10" class="epc-part-type-split epc-part-type-split--aftermarket" data-section="aftermarket">
                                            <div class="epc-part-type-split__inner">
                                                <div class="epc-part-type-split__head">
                                                    <span class="epc-part-type-badge epc-part-type-badge--am">AM</span>
                                                    <strong class="epc-part-type-split__title">Aftermarket <span class="epc-part-type-count">(@_aftermarketRows.Count)</span></strong>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    @foreach (var row in _aftermarketRows)
                                    {
                                        @OfferRow(row, "aftermarket")
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (!string.IsNullOrWhiteSpace(_brandInput))
                {
                    <nav class="epc-seo-cross-refs" id="epc-cross-base" aria-label="Cross references and OE numbers">
                        <h2>@_brandInput @_normalized — cross references &amp; OE numbers</h2>
                        <p style="margin:0 0 10px;font-size:13px;color:#475569">Part number / article <strong>@_normalized</strong> interchanges with:</p>
                        @if (_crossRefs.Count == 0 && _relatedBrandCross.Count == 0)
                        {
                            <p style="margin:0;font-size:13px;color:#64748b;">No local cross references for this brand + article.</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var cross in _crossRefs)
                                {
                                    var label = string.IsNullOrWhiteSpace(cross.Brand) ? cross.Article : $"{cross.Brand} {cross.Article}";
                                    <li>
                                        <a href="@BrandArticleHref(cross.Article, cross.Brand)">@label</a>
                                        <span style="color:#64748b">(part number @cross.Article)</span>
                                        @if (cross.InStock)
                                        {
                                            <span class="epc-avail-yes">In stock</span>
                                        }
                                        else
                                        {
                                            <span class="epc-avail-no">Not in stock</span>
                                        }
                                    </li>
                                }
                                @foreach (var brand in _relatedBrandCross)
                                {
                                    <li>
                                        <a href="@BrandArticleHref(_normalized, brand)">@brand @_normalized</a>
                                        <span style="color:#64748b">(related manufacturer)</span>
                                    </li>
                                }
                            </ul>
                        }
                        @if (_crossStockRefs.Count > 0)
                        {
                            <div class="epc-sf-cross-stock">
                                <strong>In stock on warehouse price lists (@_crossStockRefs.Count)</strong>
                                <ul>
                                    @foreach (var cross in _crossStockRefs)
                                    {
                                        <li>
                                            <a href="@BrandArticleHref(cross.Article, cross.Brand)">@cross.Brand @cross.Article</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </nav>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_normalized) && !string.IsNullOrWhiteSpace(_brandInput))
        {
            <script>
(function () {
  var article = @JsonArticle;
  var brand = @JsonBrand;
  var genuine = @JsonGenuine;
  if (!article || !brand) return;
  var progress = document.getElementById('epcSfPollProgress');
  var countEl = document.getElementById('epcSfPollCount');
  var totalEl = document.getElementById('epcSfPollTotal');
  var body = document.getElementById('epcSfOfferBody');
  if (!body) return;
  var table = document.getElementById('all_table_products');
  var pricesVisible = !table || table.getAttribute('data-prices-visible') === '1';
  var seen = Object.create(null);
  body.querySelectorAll('tr[data-offer-key]').forEach(function (tr) {
    seen[tr.getAttribute('data-offer-key')] = 1;
  });
  function normBrand(b) { return String(b || '').trim().toUpperCase(); }
  function isGenuine(b) { return !!genuine[normBrand(b)]; }
  function offerKey(p) {
    return [normBrand(p.manufacturer), String(p.article || ''), String(p.storage || ''), String(p.price || '')].join('|');
  }
  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]);
    });
  }
  function ensureSection(kind) {
    var sel = 'td.epc-part-type-split[data-section="' + kind + '"]';
    var cell = body.querySelector(sel);
    if (cell) return cell.closest('tr');
    var tr = document.createElement('tr');
    var title = kind === 'genuine' ? 'Genuine (OE)' : 'Aftermarket';
    var badge = kind === 'genuine'
      ? '<span class="epc-part-type-badge epc-part-type-badge--genuine">OE</span>'
      : '<span class="epc-part-type-badge epc-part-type-badge--am">AM</span>';
    tr.innerHTML = '<td colspan="10" class="epc-part-type-split epc-part-type-split--' + kind + '" data-section="' + kind + '">' +
      '<div class="epc-part-type-split__inner"><div class="epc-part-type-split__head">' + badge +
      '<strong class="epc-part-type-split__title">' + title + ' <span class="epc-part-type-count">(0)</span></strong></div></div></td>';
    if (kind === 'genuine') body.insertBefore(tr, body.firstChild);
    else body.appendChild(tr);
    return tr;
  }
  function bumpCaption(kind) {
    var cell = body.querySelector('td.epc-part-type-split[data-section="' + kind + '"]');
    if (!cell) return;
    var n = body.querySelectorAll('tr.epc-part-type-row--' + kind + ':not([data-filtered-out="1"])').length;
    var count = cell.querySelector('.epc-part-type-count');
    if (count) count.textContent = '(' + n + ')';
    cell.closest('tr').style.display = n === 0 ? 'none' : '';
  }
  var aidSeq = 1000;
  function actionsHtml(p, exist, show) {
    var aid = aidSeq++;
    var minOrder = Math.max(1, Number(p.minOrder || p.min_order || 1));
    var fit = '<button type="button" class="btn btn-sm epc-btn-fitment epc-fitment-check-btn epc-fitment-check-btn--row">Fitment</button>';
    if (!pricesVisible) {
      return '<div class="epc-product-actions epc-product-actions--guest"><div class="epc-product-actions__tools epc-product-actions__tools--guest">' +
        fit + ' <a href="/storefront/login">Log in</a> or <a href="/storefront/register-app">register</a></div></div>';
    }
    var wa = 'https://wa.me/?text=' + encodeURIComponent((p.manufacturer || '') + ' ' + show + ' ' + (p.name || '') + ' ' + (p.price != null ? p.price : ''));
    var tools = '<div class="epc-product-actions__tools">' + fit +
      ' <a class="epc-wa-share-btn" href="' + wa + '" target="_blank" rel="noopener" title="WhatsApp"><i class="fa fa-whatsapp"></i></a></div>';
    if (exist > 0) {
      return '<div class="epc-product-actions" data-aid="' + aid + '">' + tools +
        '<div class="epc-product-actions__buy"><div class="epc-product-actions__qty">' +
        '<a class="count_need_minus" href="#"><i class="fa fa-minus"></i></a>' +
        '<input class="epc-qty-input" id="count_need_' + aid + '" value="' + minOrder + '" />' +
        '<a class="count_need_plus" href="#"><i class="fa fa-plus"></i></a></div>' +
        '<button type="button" class="btn btn-sm btn-danger epc-btn-cart">Add to Cart</button></div></div>';
    }
    return '<div class="epc-product-actions epc-product-actions--quote-only" data-aid="' + aid + '">' + tools +
      '<button type="button" class="btn btn-sm btn-primary epc-btn-quote">Add to Quote</button></div>';
  }
  function appendProduct(p) {
    var key = offerKey(p);
    if (seen[key]) return;
    seen[key] = 1;
    var empty = body.querySelector('tr[data-empty="1"]');
    if (empty) empty.remove();
    var kind = isGenuine(p.manufacturer) ? 'genuine' : 'aftermarket';
    var cap = ensureSection(kind);
    var tr = document.createElement('tr');
    var show = p.articleShow || p.article || '';
    var exist = Number(p.exist || 0);
    var termRaw = p.timeToExe || p.time_to_exe || '0';
    var storageRaw = p.storage || '—';
    var plist = p.priceList || p.price_list || '';
    var info = plist || storageRaw || 'Warehouse';
    var priceRaw = Number(p.price || 0);
    var aid = aidSeq;
    tr.className = 'epc-part-type-row--' + kind;
    tr.setAttribute('data-offer-key', key);
    tr.setAttribute('data-aid', String(aid));
    tr.setAttribute('data-manufacturer', p.manufacturer || '');
    tr.setAttribute('data-article', p.article || show);
    tr.setAttribute('data-article-show', show);
    tr.setAttribute('data-name', p.name || '');
    tr.setAttribute('data-exist', String(exist));
    tr.setAttribute('data-price', String(priceRaw));
    tr.setAttribute('data-term', String(termRaw));
    tr.setAttribute('data-term-g', String(p.timeToExeGuaranteed || p.time_to_exe_guaranteed || termRaw));
    tr.setAttribute('data-storage', storageRaw);
