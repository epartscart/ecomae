@page "/storefront/search-app"
@page "/en/shop/part_search"
@page "/en/shop/warehouse-search"
@page "/parts/{PathBrand}/{PathArticle}"
@page "/en/parts/{PathBrand}/{PathArticle}"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject IStorefrontPriceAccess PriceAccess
@inject IHttpContextAccessor Http
@inject NavigationManager Navigation

<PageTitle>@PageTitleText</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<link rel="stylesheet" href="/platform-assets/epc_warehouse_search_parity.css?v=20260811w" />
<style>
        .epc-sf-search-form { display:flex; gap:.45rem; flex-wrap:wrap; align-items:center; }
        .epc-sf-search-form input {
            flex:1; min-width:140px; padding:.4rem .65rem; border:1px solid #cbd5e1; border-radius:3px; font-size:.9rem; background:#fff; color:#111;
        }
        /* PHP site_professional_shell: CHPU results keep header search only. */
        .epc-chpu-direct-part-search .epc-sf-search-form,
        .epc-chpu-direct-part-search .epc-sf-page-actions .btn-default { display:none !important; }
        .epc-sf-search-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-sf-search-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-sf-search-kpi strong { display:block; font-size:1.35rem; font-variant-numeric:tabular-nums; }
        .epc-sf-search-kpi span { color:#64748b; font-size:.78rem; }
        .epc-sf-search-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-sf-search-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-sf-search-table th, .epc-sf-search-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-sf-search-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-sf-search-table a { color:#b91c1c; font-weight:700; text-decoration:none; }
        .epc-sf-search-note { margin-top:1rem; padding:.75rem .9rem; background:#fff8e8; border:1px solid #f1d49a; border-radius:.45rem; color:#7a4e00; font-size:.86rem; }
        .epc-sf-brand-picker { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:1rem 1.1rem; margin-bottom:1rem; }
        .epc-sf-brand-picker h2 { margin:0 0 .65rem; font-size:1.05rem; color:#0f172a; }
        .epc-sf-brand-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); gap:.45rem; }
        .epc-sf-brand-grid a {
            display:block; padding:.55rem .7rem; border:1px solid #e2e8f0; border-radius:.45rem; text-decoration:none;
            color:#b91c1c; font-weight:700; font-size:.84rem; background:#f8fafc;
        }
        .epc-sf-result-head { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:.5rem; margin:0 0 .65rem; }
        .epc-sf-result-head h2 { margin:0; font-size:1.1rem; color:#0f172a; }
        .epc-sf-result-head a { color:#b91c1c; font-weight:700; font-size:.82rem; text-decoration:none; }
        .epc-sf-cross-refs {
            margin:1rem 0; padding:14px 18px; border:1px solid #e2e8f0; border-radius:10px; background:#f8fafc;
        }
        .epc-sf-cross-refs h2 { margin:0 0 8px; font-size:18px; color:#0f172a; }
        .epc-sf-cross-refs ul { margin:0; padding-left:18px; columns:2; column-gap:24px; font-size:13px; line-height:1.55; }
        .epc-sf-cross-stock { margin-top:.75rem; }
        .epc-sf-cross-stock strong { display:block; margin-bottom:.35rem; font-size:.82rem; color:#0f172a; }
        .epc-avail-yes { color:#15803d; font-weight:700; font-size:.75rem; }
        .epc-avail-no { color:#64748b; font-size:.75rem; }
        .epc-stock-ok { color:#15803d; font-weight:700; }
        .epc-stock-out { color:#94a3b8; }
        .epc-part-type-caption td {
            background:#0f172a; color:#f8fafc; font-weight:800; font-size:.78rem;
            text-transform:uppercase; letter-spacing:.04em; padding:.65rem .7rem;
        }
        .epc-part-type-caption--aftermarket td { background:#334155; }
        .epc-part-type-row--genuine { background:#f0fdf4; }
        .epc-part-type-row--aftermarket { background:#fff; }
        .epc-sf-poll-progress {
            margin:.65rem 0 0; padding:.55rem .75rem; border-radius:.45rem;
            background:#eff6ff; border:1px solid #bfdbfe; color:#1e3a8a; font-size:.84rem;
        }
        .epc-sf-poll-progress[data-done="1"] { background:#f0fdf4; border-color:#bbf7d0; color:#14532d; }
        .epc-sf-price-gate {
            margin:0 0 .85rem; padding:.7rem .9rem; border-radius:.5rem; font-size:.86rem; line-height:1.4;
            background:#fff7ed; border:1px solid #fed7aa; color:#9a3412;
        }
        .epc-sf-price-gate a { color:#b91c1c; font-weight:700; }
        .epc-sf-price-mask { color:#64748b; font-weight:700; letter-spacing:.04em; }
        @@media (max-width:900px){ .epc-sf-search-kpis{grid-template-columns:1fr;} .epc-sf-cross-refs ul{columns:1;} }
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<PhpStorefrontDesktopChrome>

    <div class="@(_hideInPageSearch ? "epc-chpu-direct-part-search" : null)">
        <PhpStorefrontPageHeader Title="@_heroTitle" Subtitle="@_heroSubtitle">
            @if (!_hideInPageSearch)
            {
                <form class="epc-sf-search-form" method="get" action="@SearchFormAction">
                    @if (string.Equals(_mode, "attr", StringComparison.OrdinalIgnoreCase))
                    {
                        <input type="hidden" name="mode" value="attr" />
                        <input type="search" name="q" value="@_attrQuery" placeholder="Engine, size, country, cross ref…" aria-label="Warehouse / more info search" />
                    }
                    else if (string.Equals(_mode, "vin", StringComparison.OrdinalIgnoreCase))
                    {
                        <input type="hidden" name="mode" value="vin" />
                        <input type="search" name="identString" value="@_articleInput" placeholder="Enter VIN / Frame" aria-label="VIN" maxlength="32" />
                    }
                    else if (string.Equals(_mode, "engine", StringComparison.OrdinalIgnoreCase))
                    {
                        <input type="hidden" name="mode" value="engine" />
                        <input type="search" name="engine" value="@_articleInput" placeholder="Engine code (e.g. 3L, 12R)" aria-label="Engine code" />
                    }
                    else
                    {
                        <input type="search" name="article" value="@_articleInput" placeholder="Part number / article" aria-label="Part number" required />
                        <input type="search" name="brand" value="@_brandInput" placeholder="Brand (optional)" aria-label="Brand" />
                    }
                    <button type="submit" class="btn btn-sm btn-primary">Search</button>
                </form>
                <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.WarehouseSearch">Warehouse / more info</a>
                <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.LaximoVin">VIN search</a>
                <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.VehicleCatalog">Vehicle catalog</a>
            }
        </PhpStorefrontPageHeader>
    </div>

    <div class="epc-sf-search-kpis" aria-label="Search KPIs">
        <div class="epc-sf-search-kpi"><strong>@(_normalized.Length == 0 ? "—" : _normalized)</strong><span>Article</span></div>
        <div class="epc-sf-search-kpi"><strong>@(_showBrandPicker ? _brands.Count : _rows.Count)</strong><span>@(_showBrandPicker ? "Brands found" : "Warehouse offers")</span></div>
        <div class="epc-sf-search-kpi"><strong>@(_brandInput.Length == 0 ? "—" : _brandInput)</strong><span>Brand</span></div>
    </div>

    @if (_showBrandPicker)
    {
        <section class="epc-sf-brand-picker" aria-label="Manufacturer picker">
            <h2>Select manufacturer for <strong>@_normalized</strong></h2>
            <p style="margin:0 0 .75rem;color:#64748b;font-size:.86rem;">
                PHP part_search flow: article → brand → warehouse prices + cross references.
            </p>
            @if (_brands.Count == 0)
            {
                <p>No manufacturers found for this article (warehouse + local crosses). Try another part number or open warehouse / more info search.</p>
                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div style="margin-top:.5rem;color:#92400e;background:#fffbeb;border:1px solid #fde68a;border-radius:.4rem;padding:.5rem .7rem;font-size:12px;">
                        Brand lookup: <strong>@_source</strong> — @_message
                    </div>
                }
            }
            else
            {
                <div class="epc-sf-brand-grid">
                    @foreach (var brand in _brands)
                    {
                        <a href="@BrandArticleHref(_articleInput, brand.Brand)">@brand.Brand</a>
                    }
                </div>
            }
        </section>
    }
    else
    {
        <div class="row epc-part-search-layout epc-chpu-direct-part-search">
            <div id="filter_div" class="col-md-3">
                <div class="panel panel-primary epc-wh-filter">
                    <div class="panel-heading" style="position:relative;">
                        <a id="filter_div_a_text" href="javascript:void(0);"><i class="fa fa-arrow-circle-up" aria-hidden="true"></i> Hide filter</a>
                    </div>
                    <div id="filter_div_style_body" class="panel-body" data-open="1">
                        <div id="filter_position">
                            <div class="epc-wh-filter-block" id="manufacturer_blok">
                                <div class="epc-wh-filter-block__title">Manufacturer</div>
                                <div class="epc-wh-filter-options" id="epc_filter_manufacturer_options">
                                    <span class="epc-fitment-message">Waiting for offers…</span>
                                </div>
                            </div>
                            <div class="epc-wh-filter-block" id="storages_blok">
                                <div class="epc-wh-filter-block__title">Storage / warehouse</div>
                                <div class="epc-wh-filter-options" id="epc_filter_storage_options">
                                    <span class="epc-fitment-message">Waiting for offers…</span>
                                </div>
                            </div>
                            <div class="epc-wh-filter-block" id="price_blok">
                                <div class="epc-wh-filter-block__title">Price</div>
                                <div class="epc-wh-filter-range">
                                    <input id="epc_filter_price_min" type="number" min="0" step="0.01" placeholder="Min" aria-label="Min price" />
                                    <input id="epc_filter_price_max" type="number" min="0" step="0.01" placeholder="Max" aria-label="Max price" />
                                </div>
                            </div>
                            <div class="epc-wh-filter-block" id="time_to_exe_blok">
                                <div class="epc-wh-filter-block__title">Delivery term (days)</div>
                                <div class="epc-wh-filter-range">
                                    <input id="epc_filter_term_min" type="number" min="0" step="1" placeholder="Min" aria-label="Min term" />
                                    <input id="epc_filter_term_max" type="number" min="0" step="1" placeholder="Max" aria-label="Max term" />
                                </div>
                            </div>
                            <div class="epc-wh-filter-block" id="exist_blok">
                                <div class="epc-wh-filter-block__title">Availability</div>
                                <div class="epc-wh-filter-toggles">
                                    <label><input id="epc_filter_instock" type="checkbox" /> In stock only</label>
                                </div>
                            </div>
                            <div id="epc_filter_status" class="epc-fitment-message">Filter ready</div>
                        </div>
                    </div>
                    <div class="epc-wh-filter-footer" id="footer_filter_reset">
                        <button type="button" class="btn btn-default btn-sm" id="epc_filter_reset">Reset filter</button>
                    </div>
                </div>
            </div>

            <div class="epc-part-search-main col-md-9" id="products_area">
                <div class="epc-sf-result-head">
                    <h2>@_brandInput @_normalized — warehouse offers</h2>
                    <a href="@ArticleOnlyHref(_articleInput)">Change manufacturer</a>
                </div>
                <div class="epc-parts-result-tools">
                    <button type="button" class="btn btn-default btn-sm epc-fitment-check-btn" id="epc-fitment-check-btn"
                            data-article="@_normalized" data-brand="@_brandInput">
                        <i class="fa fa-car" aria-hidden="true"></i> Fitment check
                    </button>
                    <button type="button" class="btn btn-default btn-sm epc-cross-search-btn" id="epc-cross-search-btn"
                            data-article="@_normalized" title="Open all cross references">
                        <i class="fa fa-random" aria-hidden="true"></i>
                        <span id="epc-cross-search-count">@(_crossRefs.Count + _relatedBrandCross.Count) references</span>
                    </button>
                </div>
                <div class="epc-fitment-panel" id="epc-fitment-panel" aria-live="polite">
                    <div class="epc-fitment-panel__head">
                        <div>
                            <div class="epc-fitment-panel__title">Part Fitment</div>
                            <div class="epc-fitment-panel__hint">Choose the matching brand/number — vehicle fitment loads automatically.</div>
                        </div>
                        <button type="button" class="epc-fitment-panel__close" id="epc-fitment-close" aria-label="Close fitment check">&times;</button>
                    </div>
                    <div class="epc-fitment-panel__body">
                        <div id="epc-fitment-brands" class="epc-fitment-message">Click Fitment check to load matching brands from eparts catalog.</div>
                        <div class="epc-fitment-type-tabs" id="epc-fitment-types" style="display:none;">
                            <button type="button" data-section="PC" class="active">Passenger</button>
                            <button type="button" data-section="CV">Commercial</button>
                            <button type="button" data-section="Motorcycle">Motorbike</button>
                            <button type="button" data-section="ALL">All vehicles</button>
                        </div>
                        <div class="epc-fitment-widget-shell" id="epc-fitment-widget-shell" style="display:none;">
                            <div id="epc-fitment-part" class="epc-fitment-part" style="display:none;" aria-live="polite"></div>
                            <div id="applicability_widget" class="epc-fitment-message">Select a brand/part box to load fitment.</div>
                        </div>
                    </div>
                </div>
                @if (!_pricesVisible)
                {
                    <div class="epc-sf-price-gate" data-access-state="@_accessState">
                        @((MarkupString)_loginCtaHtml)
                    </div>
                }
                <div id="epcSfPollProgress" class="epc-sf-poll-progress" hidden
                     data-article="@_normalized" data-brand="@_brandInput" aria-live="polite">
                    Polling suppliers… <span id="epcSfPollCount">0</span> of <span id="epcSfPollTotal">0</span>
                </div>
                <div class="epc-sf-search-table-wrap">
                    <table class="epc-sf-search-table" id="all_table_products"
                           data-prices-visible="@(_pricesVisible ? "1" : "0")"
                           data-access-state="@_accessState">
                        <thead>
                            <tr>
                                <th class="th_manufacturer">Manufacturer</th>
                                <th class="th_article">Article</th>
                                <th class="th_name">Name</th>
                                <th class="th_exist">Availability</th>
                                <th class="th_time_to_exe">Term</th>
                                <th class="th_price">Price</th>
                                <th class="th_storage">Storage</th>
                                <th class="th_price_list">Price list</th>
                                <th class="th_add_to_cart">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="epcSfOfferBody">
                            @if (string.IsNullOrWhiteSpace(_normalized))
                            {
                                <tr data-empty="1"><td colspan="9">Enter article and brand to load warehouse offers.</td></tr>
                            }
                            else if (_genuineRows.Count == 0 && _aftermarketRows.Count == 0)
                            {
                                <tr data-empty="1">
                                    <td colspan="9">
                                        No warehouse offers yet for <strong>@_brandInput @_normalized</strong> — polling suppliers…
                                        @if (!string.IsNullOrWhiteSpace(_message))
                                        {
                                            <div style="margin-top:.5rem;color:#92400e;background:#fffbeb;border:1px solid #fde68a;border-radius:.4rem;padding:.5rem .7rem;font-size:12px;">
                                                Offer lookup: <strong>@_source</strong> — @_message
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @if (_genuineRows.Count > 0)
                                {
                                    <tr class="epc-part-type-caption" data-section="genuine"><td colspan="9">Genuine (OE) (@_genuineRows.Count)</td></tr>
                                    @foreach (var row in _genuineRows)
                                    {
                                        @OfferRow(row, "genuine")
                                    }
                                }
                                @if (_aftermarketRows.Count > 0)
                                {
                                    <tr class="epc-part-type-caption epc-part-type-caption--aftermarket" data-section="aftermarket"><td colspan="9">Aftermarket (@_aftermarketRows.Count)</td></tr>
                                    @foreach (var row in _aftermarketRows)
                                    {
                                        @OfferRow(row, "aftermarket")
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <p class="epc-sf-search-note">
                    PHP warehouse parity: Genuine / Aftermarket sections, filter panel, Fitment, Cross base,
                    In stock gating, Add to Cart / Add to Quote (PHP write modules; guests see login CTA).
                </p>
            </div>
        </div>
        @if (!_showBrandPicker && !string.IsNullOrWhiteSpace(_normalized) && !string.IsNullOrWhiteSpace(_brandInput))
        {
            <script>
(function () {
  var article = @JsonArticle;
  var brand = @JsonBrand;
  var genuine = @JsonGenuine;
  if (!article || !brand) return;
  var progress = document.getElementById('epcSfPollProgress');
  var countEl = document.getElementById('epcSfPollCount');
  var totalEl = document.getElementById('epcSfPollTotal');
  var body = document.getElementById('epcSfOfferBody');
  if (!body) return;
  var table = document.getElementById('all_table_products');
  var pricesVisible = !table || table.getAttribute('data-prices-visible') === '1';
  var seen = Object.create(null);
  body.querySelectorAll('tr[data-offer-key]').forEach(function (tr) {
    seen[tr.getAttribute('data-offer-key')] = 1;
  });
  function normBrand(b) {
    return String(b || '').trim().toUpperCase();
  }
  function isGenuine(b) {
    return !!genuine[normBrand(b)];
  }
  function offerKey(p) {
    return [normBrand(p.manufacturer), String(p.article || ''), String(p.storage || ''), String(p.price || '')].join('|');
  }
  function ensureSection(kind) {
    var sel = 'tr.epc-part-type-caption[data-section="' + kind + '"]';
    var cap = body.querySelector(sel);
    if (cap) return cap;
    cap = document.createElement('tr');
    cap.className = 'epc-part-type-caption' + (kind === 'aftermarket' ? ' epc-part-type-caption--aftermarket' : '');
    cap.setAttribute('data-section', kind);
    var td = document.createElement('td');
    td.colSpan = 9;
    td.textContent = (kind === 'genuine' ? 'Genuine (OE)' : 'Aftermarket') + ' (0)';
    cap.appendChild(td);
    if (kind === 'genuine') {
      body.insertBefore(cap, body.firstChild);
    } else {
      body.appendChild(cap);
    }
    return cap;
  }
  function bumpCaption(kind) {
    var cap = body.querySelector('tr.epc-part-type-caption[data-section="' + kind + '"]');
    if (!cap) return;
    var n = body.querySelectorAll('tr.epc-part-type-row--' + kind).length;
    cap.firstChild.textContent = (kind === 'genuine' ? 'Genuine (OE)' : 'Aftermarket') + ' (' + n + ')';
  }
  var aidSeq = 1000;
  function actionsHtml(p, exist, show) {
    var aid = aidSeq++;
    var minOrder = Math.max(1, Number(p.minOrder || p.min_order || 1));
    var fit = '<button type="button" class="btn btn-sm epc-btn-fitment">Fitment</button>';
    if (!pricesVisible) {
      return '<div class="epc-product-actions epc-product-actions--guest"><div class="epc-product-actions__tools epc-product-actions__tools--guest">' +
        fit + ' <a href="/storefront/login">Log in</a> or <a href="/storefront/register-app">register</a></div></div>';
    }
    var wa = 'https://wa.me/?text=' + encodeURIComponent((p.manufacturer || '') + ' ' + show + ' ' + (p.name || '') + ' ' + (p.price != null ? p.price : ''));
    var tools = '<div class="epc-product-actions__tools">' + fit +
      ' <a class="epc-wa-share" href="' + wa + '" target="_blank" rel="noopener" title="WhatsApp"><i class="fa fa-whatsapp"></i></a></div>';
    if (exist > 0) {
      return '<div class="epc-product-actions" data-aid="' + aid + '">' + tools +
        '<div class="epc-product-actions__buy"><div class="epc-product-actions__qty">' +
        '<a class="count_need_minus" href="#"><i class="fa fa-minus"></i></a>' +
        '<input class="epc-qty-input" id="count_need_' + aid + '" value="' + minOrder + '" />' +
        '<a class="count_need_plus" href="#"><i class="fa fa-plus"></i></a></div>' +
        '<button type="button" class="btn btn-sm btn-danger epc-btn-cart">Add to Cart</button></div></div>';
    }
    return '<div class="epc-product-actions epc-product-actions--quote-only" data-aid="' + aid + '">' + tools +
      '<button type="button" class="btn btn-sm btn-primary epc-btn-quote">Add to Quote</button></div>';
  }
  function appendProduct(p) {
    var key = offerKey(p);
    if (seen[key]) return;
    seen[key] = 1;
    var empty = body.querySelector('tr[data-empty="1"]');
    if (empty) empty.remove();
    var kind = isGenuine(p.manufacturer) ? 'genuine' : 'aftermarket';
    var cap = ensureSection(kind);
    var tr = document.createElement('tr');
    tr.className = 'epc-part-type-row--' + kind;
    var show = p.articleShow || p.article || '';
    var exist = Number(p.exist || 0);
    var termRaw = p.timeToExe || p.time_to_exe || '0';
    var storageRaw = p.storage || p.priceList || p.price_list || '—';
    var priceRaw = Number(p.price || 0);
    var aid = aidSeq;
    tr.setAttribute('data-offer-key', key);
    tr.setAttribute('data-aid', String(aid));
    tr.setAttribute('data-manufacturer', p.manufacturer || '');
    tr.setAttribute('data-article', p.article || show);
    tr.setAttribute('data-article-show', show);
    tr.setAttribute('data-name', p.name || '');
    tr.setAttribute('data-exist', String(exist));
    tr.setAttribute('data-price', String(priceRaw));
    tr.setAttribute('data-term', String(termRaw));
    tr.setAttribute('data-term-g', String(p.timeToExeGuaranteed || p.time_to_exe_guaranteed || termRaw));
    tr.setAttribute('data-storage', storageRaw);
    tr.setAttribute('data-min-order', String(p.minOrder || p.min_order || 1));
    tr.setAttribute('data-probability', String(p.probability || 100));
    tr.setAttribute('data-office-id', String(p.officeId || p.office_id || 0));
    tr.setAttribute('data-storage-id', String(p.storageId || p.storage_id || 0));
    tr.setAttribute('data-price-purchase', String(p.pricePurchase || p.price_purchase || 0));
    tr.setAttribute('data-markup', String(p.markup || 0));
    tr.setAttribute('data-json-params', p.jsonParams || p.json_params || '');
    tr.setAttribute('data-product-type', String(p.productType || p.product_type || 2));
    tr.setAttribute('data-check-hash', p.checkHash || p.check_hash || '');
    var mask = '**';
