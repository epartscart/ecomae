@page "/storefront/search-app"
@page "/en/shop/part_search"
@page "/en/shop/warehouse-search"
@page "/parts/{PathBrand}/{PathArticle}"
@page "/en/parts/{PathBrand}/{PathArticle}"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject IStorefrontSkuMediaService SkuMedia
@inject IStorefrontPriceAccess PriceAccess
@inject IHttpContextAccessor Http
@inject NavigationManager Navigation

<PageTitle>@PageTitleText</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
@if (_emitChpuSeo)
{
    <meta name="robots" content="@_chpuRobots" />
    <meta name="description" content="@_chpuDescription" />
    <meta name="keywords" content="@_chpuKeywords" />
    <link rel="canonical" href="@_chpuCanonical" />
    <meta property="og:type" content="product" />
    <meta property="og:url" content="@_chpuCanonical" />
    <meta property="og:title" content="@PageTitleText" />
    <meta property="og:description" content="@_chpuDescription" />
    @foreach (var alt in _chpuHreflang)
    {
        <link rel="alternate" hreflang="@alt.Hreflang" href="@alt.Href" />
    }
    @((MarkupString)_chpuHeadExtras)
    @((MarkupString)_chpuJsonLd)
}
<link rel="stylesheet" href="/platform-assets/epc_warehouse_search_parity.css?v=20260812-skumedia" />
<link rel="stylesheet" href="/platform-assets/epc_sku_media.css?v=20260812-skumedia" />
<style>
        /* Keep PHP professional-shell look; only hide inventing ASP.NET chrome on CHPU/picker. */
        .epc-chpu-direct-part-search .epc-sf-search-form,
        .epc-chpu-direct-part-search .epc-sf-page-actions .btn-default,
        .epc-brand-picker-mode .epc-sf-search-kpis,
        .epc-chpu-direct-part-search .epc-sf-search-kpis { display:none !important; }
        /* PHP CHPU hides storages filter block on brand+article warehouse results. */
        .epc-chpu-direct-part-search #storages_blok,
        .epc-chpu-direct-part-search #storages_blok + hr { display:none !important; }
        .epc-sf-search-form { display:flex; gap:.45rem; flex-wrap:wrap; align-items:center; }
        .epc-sf-search-form input {
            flex:1; min-width:140px; padding:.4rem .65rem; border:1px solid #cbd5e1; border-radius:3px; font-size:.9rem; background:#fff; color:#111;
        }
        .epc-sf-poll-progress {
            margin:.65rem 0 12px; padding:.55rem .75rem; border-radius:.45rem;
            background:#eff6ff; border:1px solid #bfdbfe; color:#1e3a8a; font-size:.84rem;
        }
        .epc-sf-poll-progress[data-done="1"] { background:#f0fdf4; border-color:#bbf7d0; color:#14532d; }
        .epc-sf-price-gate {
            margin:0 0 .85rem; padding:.7rem .9rem; border-radius:.5rem; font-size:.86rem; line-height:1.4;
            background:#fff7ed; border:1px solid #fed7aa; color:#9a3412;
        }
        .epc-sf-price-gate a { color:#b91c1c; font-weight:700; }
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

@* Body-stream SEO fallback — live SSR often drops late HeadContent while body chrome survives. *@
@if (_emitChpuSeo)
{
    <meta name="robots" content="@_chpuRobots" />
    <meta name="description" content="@_chpuDescription" />
    <meta name="keywords" content="@_chpuKeywords" />
    <link rel="canonical" href="@_chpuCanonical" />
    <meta property="og:type" content="product" />
    <meta property="og:url" content="@_chpuCanonical" />
    <meta property="og:title" content="@PageTitleText" />
    <meta property="og:description" content="@_chpuDescription" />
    @foreach (var alt in _chpuHreflang)
    {
        <link rel="alternate" hreflang="@alt.Hreflang" href="@alt.Href" />
    }
    @((MarkupString)_chpuHeadExtras)
    @((MarkupString)_chpuJsonLd)
}

<PhpStorefrontDesktopChrome>

    @if (!_showBrandPicker && !_hideInPageSearch)
    {
        <PhpStorefrontPageHeader Title="@_heroTitle" Subtitle="@_heroSubtitle">
            <form class="epc-sf-search-form" method="get" action="@SearchFormAction">
                @if (string.Equals(_mode, "attr", StringComparison.OrdinalIgnoreCase))
                {
                    <input type="hidden" name="mode" value="attr" />
                    <input type="search" name="q" value="@_attrQuery" placeholder="Engine, size, country, cross ref…" aria-label="Warehouse / more info search" />
                }
                else if (string.Equals(_mode, "vin", StringComparison.OrdinalIgnoreCase))
                {
                    <input type="hidden" name="mode" value="vin" />
                    <input type="search" name="identString" value="@_articleInput" placeholder="Enter VIN / Frame" aria-label="VIN" maxlength="32" />
                }
                else if (string.Equals(_mode, "engine", StringComparison.OrdinalIgnoreCase))
                {
                    <input type="hidden" name="mode" value="engine" />
                    <input type="search" name="engine" value="@_articleInput" placeholder="Engine code (e.g. 3L, 12R)" aria-label="Engine code" />
                }
                else
                {
                    <input type="search" name="article" value="@_articleInput" placeholder="Part number / article" aria-label="Part number" required />
                    <input type="search" name="brand" value="@_brandInput" placeholder="Brand (optional)" aria-label="Brand" />
                }
                <button type="submit" class="btn btn-sm btn-primary">Search</button>
            </form>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.WarehouseSearch">Warehouse / more info</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.LaximoVin">VIN search</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.VehicleCatalog">Vehicle catalog</a>
        </PhpStorefrontPageHeader>
    }

    @if (_showBrandPicker)
    {
        <div class="row epc-part-search-layout epc-brand-picker-mode">
            <div class="epc-part-search-main col-md-12">
                <div class="epc-brand-picker-top">
                    <div class="epc-brand-picker-top__head">
                        <span class="epc-brand-picker-top__eyebrow"><i class="fa fa-search" aria-hidden="true"></i> Article</span>
                        <h2 class="epc-brand-picker-top__title">@_normalized</h2>
                        <p class="epc-brand-picker-top__hint">Several manufacturers use this part number. Choose a brand, then open warehouse prices and stock.</p>
                    </div>
                    <div id="work_area" class="epc-brand-picker-work-area" align="center">
                        <div id="processing_indicator" style="display:none;" aria-hidden="true">
                            <img src="/templates/nero/img/ajax-loader.gif" alt="" width="32" height="32" />
                        </div>
                        <div id="products_area" class="epc-part-search-results" role="region" aria-label="Part search results">
                            @if (_brands.Count == 0)
                            {
                                <div class="epc-brand-picker-empty">
                                    No manufacturers found for this article (warehouse + local crosses). Try another part number.
                                    @if (!string.IsNullOrWhiteSpace(_message))
                                    {
                                        <div style="margin-top:.5rem;color:#92400e;">Brand lookup: <strong>@_source</strong> — @_message</div>
                                    }
                                </div>
                            }
                            else
                            {
                                var mask = StorefrontPriceAccess.SensitiveMask;
                                <div id="table-manufacturers" class="table-responsive epc-brand-picker-ssr">
                                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped epc-brand-picker-table">
                                        <thead>
                                            <tr>
                                                <th>Manufacturer</th>
                                                <th>Article</th>
                                                <th>Name</th>
                                                <th class="text-center">Availability</th>
                                                <th>Term</th>
                                                <th class="text-right">Price</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var brand in _brands)
                                            {
                                                var href = BrandArticleHref(_normalized, brand.Brand);
                                                var nameCell = string.IsNullOrWhiteSpace(brand.Name) ? "—" : brand.Name;
                                                var termCell = BrandPickerTerm(brand);
                                                <tr class="epc-brand-picker-row">
                                                    <td><a href="@href" data-enhance-nav="false">@brand.Brand</a></td>
                                                    <td><a href="@href" data-enhance-nav="false">@_normalized</a></td>
                                                    <td><a href="@href" data-enhance-nav="false">@nameCell</a></td>
                                                    @if (!_pricesVisible)
                                                    {
                                                        <td class="text-center"><a href="@href">@mask</a></td>
                                                        <td><a href="@href">@mask</a></td>
                                                        <td class="text-right"><a href="@href">@mask</a></td>
                                                    }
                                                    else if (brand.Exist > 0)
                                                    {
                                                        <td class="text-center"><a href="@href">@brand.Exist.ToString(CultureInfo.InvariantCulture)</a></td>
                                                        <td><a href="@href">@termCell</a></td>
                                                        <td class="text-right">
                                                            <a href="@href">
                                                                @if (brand.MinPrice is decimal mp)
                                                                {
                                                                    <span class="epc-price-value" data-epc-base-price="@mp.ToString("0.00", CultureInfo.InvariantCulture)">@mp.ToString("N2", CultureInfo.InvariantCulture)</span>
                                                                }
                                                                else
                                                                {
                                                                    <text>—</text>
                                                                }
                                                            </a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td class="text-center"><a href="@href">—</a></td>
                                                        <td><a href="@href">Open brand for stock</a></td>
                                                        <td class="text-right"><a href="@href">—</a></td>
                                                    }
                                                    <td class="text-right"><a class="btn btn-ar btn-primary btn-sm" href="@href">Open prices</a></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row epc-part-search-layout epc-chpu-direct-part-search">
            <div id="filter_div" class="col-md-3">
                <div class="panel panel-primary">
                    <div class="panel-heading" style="position:relative;">
                        <a id="filter_div_a_text" href="javascript:void(0);"><i class="fa fa-arrow-circle-up" aria-hidden="true"></i> Hide filter</a>
                    </div>
                    <div id="filter_div_style_body" class="panel-body" data-open="1">
                        <div id="filter_position">
                            <div class="one_property" id="manufacturer_blok" data-epc-filter="manufacturer">
                                <strong>Manufacturer</strong>
                                <div class="list_div" id="epc_filter_manufacturer_options">
                                    <span class="epc-fitment-message">Waiting for offers…</span>
                                </div>
                            </div>
                            <hr />
                            <div class="one_property" id="storages_blok" data-epc-filter="storages">
                                <strong>Storage / warehouse</strong>
                                <div class="list_div" id="epc_filter_storage_options">
                                    <span class="epc-fitment-message">Waiting for offers…</span>
                                </div>
                            </div>
                            <hr />
                            <div class="one_property" id="price_blok" data-epc-filter="price">
                                <strong>Price</strong>
                                <div class="slider_ranges">
                                    <input id="epc_filter_price_min" type="number" min="0" step="0.01" placeholder="Min" aria-label="Min price" class="form-control input-sm" style="width:48%;display:inline-block;" />
                                    <input id="epc_filter_price_max" type="number" min="0" step="0.01" placeholder="Max" aria-label="Max price" class="form-control input-sm" style="width:48%;display:inline-block;float:right;" />
                                </div>
                            </div>
                            <hr />
                            <div class="one_property" id="time_to_exe_blok" data-epc-filter="time_to_exe">
                                <strong>Delivery term (days)</strong>
                                <div class="slider_ranges">
                                    <input id="epc_filter_term_min" type="number" min="0" step="1" placeholder="Min" aria-label="Min term" class="form-control input-sm" style="width:48%;display:inline-block;" />
                                    <input id="epc_filter_term_max" type="number" min="0" step="1" placeholder="Max" aria-label="Max term" class="form-control input-sm" style="width:48%;display:inline-block;float:right;" />
                                </div>
                            </div>
                            <hr />
                            <div class="one_property" id="exist_blok" data-epc-filter="exist">
                                <strong>Availability (qty)</strong>
                                <div class="slider_ranges">
                                    <input id="epc_filter_exist_min" type="number" min="0" step="1" placeholder="Min" aria-label="Min qty" class="form-control input-sm" style="width:48%;display:inline-block;" />
                                    <input id="epc_filter_exist_max" type="number" min="0" step="1" placeholder="Max" aria-label="Max qty" class="form-control input-sm" style="width:48%;display:inline-block;float:right;" />
                                </div>
                                <div class="list_div" style="margin-top:8px;">
                                    <input class="css-checkbox" type="checkbox" id="epc_filter_instock" />
                                    <label class="css-label" for="epc_filter_instock">In stock only</label>
                                </div>
                            </div>
                            <div id="epc_filter_status" class="epc-fitment-message" style="margin-top:10px;">Filter ready</div>
                        </div>
                    </div>
                    <div id="footer_filter_reset">
                        <a href="javascript:void(0);" class="btn btn-ar btn-primary" id="epc_filter_reset">Reset filter</a>
                    </div>
                    <div id="footer-filter"></div>
                </div>
            </div>

            <div class="epc-part-search-main col-md-9">
                <div id="epc-chpu-actions-bar" class="epc-chpu-actions-bar epc-parts-result-tools">
                    <button type="button" class="btn btn-default btn-sm epc-fitment-check-btn" id="epc-fitment-check-btn"
                            data-article="@_normalized" data-brand="@_brandInput">
                        <i class="fa fa-car" aria-hidden="true"></i> Fitment check
                    </button>
                    @if (_skuHasSpecs)
                    {
                        <button type="button" class="btn btn-default btn-sm epc-spec-check-btn" id="epc-spec-check-btn"
                                data-article="@_normalized" data-brand="@_brandInput"
                                title="Open technical specifications">
                            <i class="fa fa-list-alt" aria-hidden="true"></i> Spec
                        </button>
                    }
                    <button type="button" class="btn btn-default btn-sm epc-cross-search-btn" id="epc-cross-search-btn"
                            data-article="@_normalized" title="Open all cross references">
                        <i class="fa fa-random" aria-hidden="true"></i>
                        <span id="epc-cross-search-count">@(_crossRefs.Count + _relatedBrandCross.Count) references</span>
                    </button>
                    <a class="btn btn-default btn-sm" href="@ArticleOnlyHref(_articleInput)">Change manufacturer</a>
                </div>

                <div class="epc-fitment-panel" id="epc-fitment-panel" aria-live="polite">
                    <div class="epc-fitment-panel__head">
                        <div>
                            <div class="epc-fitment-panel__title">Part Fitment</div>
                            <div class="epc-fitment-panel__hint">Choose the matching brand/number — photo, specifications and vehicle fitment load automatically.</div>
                        </div>
                        <button type="button" class="epc-fitment-panel__close" id="epc-fitment-close" aria-label="Close fitment check">&times;</button>
                    </div>
                    <div class="epc-fitment-panel__body">
                        <div id="epc-fitment-brands" class="epc-fitment-message">Click Fitment check to load matching brands from eparts catalog.</div>
                        <div class="epc-fitment-type-tabs" id="epc-fitment-types" style="display:none;">
                            <button type="button" data-section="PC" class="active">Passenger</button>
                            <button type="button" data-section="CV">Commercial</button>
                            <button type="button" data-section="Motorcycle">Motorbike</button>
                            <button type="button" data-section="ALL">All vehicles</button>
                        </div>
                        <div class="epc-fitment-widget-shell" id="epc-fitment-widget-shell" style="display:none;">
                            <div id="epc-fitment-part" class="epc-fitment-part" style="display:none;" aria-live="polite"></div>
                            <div id="applicability_widget" class="epc-fitment-message">Select a brand/part box to load fitment.</div>
                        </div>
                    </div>
                </div>

                @if (_skuHasSpecs)
                {
                    <div class="epc-fitment-panel epc-spec-panel" id="epc-spec-panel" aria-live="polite" role="dialog" aria-modal="true" aria-labelledby="epc-spec-panel-title">
                        <div class="epc-fitment-panel__head">
                            <div>
                                <div class="epc-fitment-panel__title" id="epc-spec-panel-title">Specifications</div>
                                <div class="epc-fitment-panel__hint">@_brandInput.ToUpperInvariant() · @_normalized — technical details, dimensions and notes</div>
                            </div>
                            <button type="button" class="epc-fitment-panel__close" id="epc-spec-close" aria-label="Close specifications">&times;</button>
                        </div>
                        <div class="epc-fitment-panel__body epc-spec-panel__body">
                            <div class="epc-spec-panel__scroll" id="epc-spec-panel-body">
                                @((MarkupString)_skuSpecsHtml)
                            </div>
                        </div>
                    </div>
                }

                @if (_skuHasPhotos)
                {
                    <div class="epc-sku-media-part-page" id="epc-sku-media-part-page" style="margin:12px 0 18px;text-align:left;">
                        <div class="epc-sku-media-part-page__head" style="margin:0 0 10px;">
                            <strong style="font-size:15px;letter-spacing:-0.01em;">Photos</strong>
                            <span style="display:block;color:#64748b;font-size:13px;margin-top:2px;">
                                @_brandInput.ToUpperInvariant() · @_normalized
                                @if (_skuHasSpecs)
                                {
                                    <text> · use <strong>Spec</strong> next to Fitment for full details</text>
                                }
                            </span>
                        </div>
                        @((MarkupString)_skuPhotosHtml)
                    </div>
                }

                @if (!_pricesVisible)
                {
                    <div class="epc-sf-price-gate" data-access-state="@_accessState">
                        @((MarkupString)_loginCtaHtml)
                    </div>
                }

                <div id="epcSfPollProgress" class="epc-sf-poll-progress" hidden
                     data-article="@_normalized" data-brand="@_brandInput" aria-live="polite">
                    Polling suppliers… <span id="epcSfPollCount">0</span> of <span id="epcSfPollTotal">0</span>
                </div>

                <div id="work_area" class="epc-chpu-work-area">
                <div class="epc-ssr-warehouse-banner" role="status">
                    <strong>@_brandInput.ToUpperInvariant() @_normalized</strong>
                    <span> — warehouse prices &amp; stock (Genuine / Aftermarket)</span>
                </div>
                <div id="products_area" class="epc-part-search-results" role="region" aria-label="Part search results">
                    <table id="all_table_products" class="epc-ssr-warehouse-table notranslate"
                           translate="no"
                           data-prices-visible="@(_pricesVisible ? "1" : "0")"
                           data-access-state="@_accessState"
                           data-ssr-offers="@(_genuineRows.Count + _aftermarketRows.Count > 0 ? "1" : "0")">
                        <thead>
                            <tr>
                                <th class="th_photo"></th>
                                <th class="th_manufacturer">Manufacturer</th>
                                <th class="th_article">Article</th>
                                <th class="th_name">Name</th>
                                <th class="th_exist">Availability</th>
                                <th class="th_time_to_exe">Term</th>
                                <th class="th_info">Info</th>
                                <th class="th_price">Price</th>
                                <th class="th_add_to_cart">Actions</th>
                                <th class="th_color"></th>
                            </tr>
                        </thead>
                        <tbody id="epcSfOfferBody">
                            @if (string.IsNullOrWhiteSpace(_normalized))
                            {
                                <tr data-empty="1"><td colspan="10">Enter article and brand to load warehouse offers.</td></tr>
                            }
                            else if (_genuineRows.Count == 0 && _aftermarketRows.Count == 0)
                            {
                                <tr data-empty="1">
                                    <td colspan="10">
                                        No warehouse offers yet for <strong>@_brandInput @_normalized</strong> — polling suppliers…
                                        @if (!string.IsNullOrWhiteSpace(_message))
                                        {
                                            <div style="margin-top:.5rem;color:#92400e;">Offer lookup: <strong>@_source</strong> — @_message</div>
                                        }
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @if (_genuineRows.Count > 0)
                                {
                                    <tr>
                                        <td colspan="10" class="epc-part-type-split epc-part-type-split--genuine" data-section="genuine">
                                            <div class="epc-part-type-split__inner">
                                                <div class="epc-part-type-split__head">
                                                    <span class="epc-part-type-badge epc-part-type-badge--genuine">OE</span>
                                                    <strong class="epc-part-type-split__title">Genuine (OE) <span class="epc-part-type-count">(@_genuineRows.Count)</span></strong>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    @foreach (var item in GroupWarehouseOffers(_genuineRows))
                                    {
                                        @OfferRow(item.Row, "genuine", item.Index, item.Quantity)
                                    }
                                }
                                @if (_aftermarketRows.Count > 0)
                                {
                                    <tr>
                                        <td colspan="10" class="epc-part-type-split epc-part-type-split--aftermarket" data-section="aftermarket">
                                            <div class="epc-part-type-split__inner">
                                                <div class="epc-part-type-split__head">
                                                    <span class="epc-part-type-badge epc-part-type-badge--am">AM</span>
                                                    <strong class="epc-part-type-split__title">Aftermarket <span class="epc-part-type-count">(@_aftermarketRows.Count)</span></strong>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    @foreach (var item in GroupWarehouseOffers(_aftermarketRows))
                                    {
                                        @OfferRow(item.Row, "aftermarket", item.Index, item.Quantity)
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_brandInput))
                {
                    <nav class="epc-seo-cross-refs notranslate" id="epc-cross-base" translate="no"
                         data-article="@_normalized" data-brand="@_brandInput"
                         aria-label="Cross references and OE numbers">
                        <h2>@_brandInput @_normalized — cross references &amp; OE numbers</h2>
                        <p style="margin:0 0 10px;font-size:13px;color:#475569">Part number / article <strong>@_normalized</strong> interchanges with:</p>
                        <p id="epc-cross-loading" class="epc-fitment-message" style="margin:0 0 10px;@(_crossRefs.Count > 0 ? "display:none" : null)">
                            @(_crossRefs.Count > 0 ? "Expanding OE / aftermarket cross network…" : "Loading OE / aftermarket cross network…")
                        </p>
                        <div id="epc-sf-cross-stock" class="epc-sf-cross-stock" hidden></div>
                        <ul id="epc-cross-ref-list">
                            @if (_crossRefs.Count == 0 && _relatedBrandCross.Count == 0)
                            {
                                <li class="epc-cross-placeholder" style="list-style:none;color:#64748b;">Waiting for cross search…</li>
                            }
                            else
                            {
                                @foreach (var cross in _crossRefs)
                                {
                                    var label = string.IsNullOrWhiteSpace(cross.Brand) ? cross.Article : $"{cross.Brand} {cross.Article}";
                                    var src = string.IsNullOrWhiteSpace(cross.Source) ? "cp" : cross.Source;
                                    var isCrossbase = src.Contains("crossbase", StringComparison.OrdinalIgnoreCase);
                                    <li data-cross-key="@($"{cross.Brand}|{cross.Article}")" data-source="@src">
                                        <a href="@BrandArticleHref(cross.Article, cross.Brand)" data-enhance-nav="false">@label</a>
                                        <span style="color:#64748b">(@(isCrossbase ? "crossbase" : $"part number {cross.Article}"))</span>
                                        @if (cross.InStock)
                                        {
                                            <span class="epc-avail-yes">In stock</span>
                                        }
                                        else
                                        {
                                            <span class="epc-avail-no">Not in stock</span>
                                        }
                                    </li>
                                }
                                @foreach (var brand in _relatedBrandCross)
                                {
                                    <li data-related-mfr="1">
                                        <a href="@BrandArticleHref(_normalized, brand)" data-enhance-nav="false">@brand @_normalized</a>
                                        <span style="color:#64748b">(related manufacturer)</span>
                                    </li>
                                }
                            }
                        </ul>
                        <p id="epc-cross-more" class="epc-fitment-message" style="margin:8px 0 0;display:none;"></p>
                    </nav>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_normalized) && !string.IsNullOrWhiteSpace(_brandInput))
        {
            <script>
(function () {
  var article = @JsonArticle;
  var brand = @JsonBrand;
  var genuine = @JsonGenuine;
  if (!article || !brand) return;
  var progress = document.getElementById('epcSfPollProgress');
  var countEl = document.getElementById('epcSfPollCount');
  var totalEl = document.getElementById('epcSfPollTotal');
  var body = document.getElementById('epcSfOfferBody');
  if (!body) return;
  var table = document.getElementById('all_table_products');
  var pricesVisible = !table || table.getAttribute('data-prices-visible') === '1';
  var seen = Object.create(null);
  body.querySelectorAll('tr[data-offer-key]').forEach(function (tr) {
    seen[tr.getAttribute('data-offer-key')] = 1;
  });
  function normBrand(b) { return String(b || '').trim().toUpperCase(); }
  function isGenuine(b) { return !!genuine[normBrand(b)]; }
  function offerKey(p) {
    return [normBrand(p.manufacturer), String(p.article || ''), String(p.storage || ''), String(p.price || '')].join('|');
  }
  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]);
    });
  }
  function ensureSection(kind) {
    var sel = 'td.epc-part-type-split[data-section="' + kind + '"]';
    var cell = body.querySelector(sel);
    if (cell) return cell.closest('tr');
    var tr = document.createElement('tr');
    var title = kind === 'genuine' ? 'Genuine (OE)' : 'Aftermarket';
    var badge = kind === 'genuine'
      ? '<span class="epc-part-type-badge epc-part-type-badge--genuine">OE</span>'
      : '<span class="epc-part-type-badge epc-part-type-badge--am">AM</span>';
    tr.innerHTML = '<td colspan="10" class="epc-part-type-split epc-part-type-split--' + kind + '" data-section="' + kind + '">' +
      '<div class="epc-part-type-split__inner"><div class="epc-part-type-split__head">' + badge +
      '<strong class="epc-part-type-split__title">' + title + ' <span class="epc-part-type-count">(0)</span></strong></div></div></td>';
    if (kind === 'genuine') body.insertBefore(tr, body.firstChild);
    else body.appendChild(tr);
    return tr;
  }
  function bumpCaption(kind) {
    var cell = body.querySelector('td.epc-part-type-split[data-section="' + kind + '"]');
    if (!cell) return;
    var n = body.querySelectorAll('tr.epc-part-type-row--' + kind + ':not([data-filtered-out="1"])').length;
    var count = cell.querySelector('.epc-part-type-count');
    if (count) count.textContent = '(' + n + ')';
    cell.closest('tr').style.display = n === 0 ? 'none' : '';
  }
  var aidSeq = 1000;
  function photoKey(brand, article) {
    return String(brand || '').replace(/[^A-Za-z0-9]/g, '').toUpperCase() + '|' + String(article || '').replace(/[^A-Za-z0-9]/g, '').toUpperCase();
  }
  function formatTerm(termRaw, storageRaw) {
    var t = String(termRaw == null ? '' : termRaw).trim();
    var stor = String(storageRaw == null ? '' : storageRaw).trim();
    if (!t || t === '0' || t === '—') {
      return stor && stor !== '—' ? ('In warehouse · ' + stor) : 'In warehouse';
    }
    if (/^\d+$/.test(t)) return t + (Number(t) === 1 ? ' day' : ' days');
    return t;
  }
  function infoCellHtml(p, show, storageRaw, pricesOn) {
    if (!pricesOn) return '**';
    var mfr = p.manufacturer || '';
    var art = show || p.article || '';
    var gq = 'https://www.google.com/search?tbm=isch&q=' + encodeURIComponent(mfr + ' ' + art);
    var wh = (p.priceList || p.price_list || storageRaw || 'Warehouse');
    if (wh === '—') wh = 'Warehouse';
    return '<div style="margin:3px 0;">' +
      '<span class="info_box">' +
      '<a title="Product photos" href="' + gq + '" target="_blank" rel="noopener"><span><i style="font-size:.8em;" class="fa fa-camera"></i></span></a>' +
      '<a title="Warehouse" href="javascript:void(0);"><span><i class="fa fa-home"></i></span></a>' +
      '<a title="Fitment" href="javascript:void(0);" class="epc-fitment-check-btn epc-fitment-check-btn--row" data-epc-fitment-article="' + esc(art) + '" data-epc-fitment-brand="' + esc(mfr) + '"><span><i style="font-size:.9em;" class="fa fa-car"></i></span></a>' +
      '<br/></span>' +
      '<div class="show_data_class epc-warehouse-label" style="margin:3px 0;white-space:nowrap;max-width:110px;font-size:11px;font-weight:600;" title="Warehouse"><span class="info_box">' + esc(wh) + '</span></div>' +
      '</div>';
  }
  function actionsHtml(p, exist, show) {
    var aid = aidSeq++;
    var minOrder = Math.max(1, Number(p.minOrder || p.min_order || 1));
    var mfr = p.manufacturer || '';
    var isCrossStock = !!(p.fromCrossStock || p.from_cross_stock);
    var fit = '<button type="button" class="btn btn-sm epc-btn-fitment epc-fitment-check-btn epc-fitment-check-btn--row"' +
      ' data-epc-fitment-article="' + esc(show) + '" data-epc-fitment-brand="' + esc(mfr) + '"' +
      ' title="Fitment check"><i class="fa fa-car" aria-hidden="true"></i> Fitment</button>';
    if (!pricesVisible) {
      // Guest: still allow Add to Quote on cross-stock catalog rows (PHP epcAddManualToQuote).
      if (isCrossStock) {
        return '<div class="epc-product-actions epc-product-actions--quote-only" data-aid="' + aid + '">' +
          '<div class="epc-product-actions__tools">' + fit + '</div>' +
          '<button type="button" class="btn btn-sm btn-primary epc-btn-quote">Add to Quote</button></div>';
      }
      return '<div class="epc-product-actions epc-product-actions--guest"><div class="epc-product-actions__tools epc-product-actions__tools--guest">' +
        fit + ' <a href="/storefront/login">Log in</a> or <a href="/storefront/register-app">register</a></div></div>';
    }
    var wa = 'https://wa.me/?text=' + encodeURIComponent(mfr + ' ' + show + ' ' + (p.name || '') + ' ' + (p.price != null ? p.price : ''));
    var tools = '<div class="epc-product-actions__tools">' + fit +
      ' <a class="epc-wa-share-btn" href="' + wa + '" target="_blank" rel="noopener" title="WhatsApp"><i class="fa fa-whatsapp"></i></a></div>';
    var quoteBtn = '<button type="button" class="btn btn-sm btn-primary epc-btn-quote">Add to Quote</button>';
    if (exist > 0) {
      // PHP-parity: cross-stock / interchange rows keep Add to Quote beside Cart.
      return '<div class="epc-product-actions" data-aid="' + aid + '">' + tools +
        '<div class="epc-product-actions__buy"><div class="epc-product-actions__qty">' +
        '<a class="count_need_minus" href="#"><i class="fa fa-minus"></i></a>' +
        '<input class="epc-qty-input" id="count_need_' + aid + '" value="' + minOrder + '" />' +
        '<a class="count_need_plus" href="#"><i class="fa fa-plus"></i></a></div>' +
        '<button type="button" class="btn btn-sm btn-danger epc-btn-cart">Add to Cart</button>' +
        (isCrossStock ? (' ' + quoteBtn) : '') +
        '</div></div>';
    }
    return '<div class="epc-product-actions epc-product-actions--quote-only" data-aid="' + aid + '">' + tools +
      quoteBtn + '</div>';
  }
  function brandArticleGroupKey(mfr, art) {
    return String(mfr || '').replace(/[^A-Za-z0-9]/g, '').toUpperCase() + '|' +
      String(art || '').replace(/[^A-Za-z0-9]/g, '').toUpperCase();
  }
  function warehouseCaption(p, storageRaw) {
    var wh = (p && (p.priceList || p.price_list)) || storageRaw || 'Warehouse';
    if (wh === '—') wh = 'Warehouse';
    return wh;
  }
  function paintOfferCells(tr, p, kind, index, quantity) {
    var show = p.articleShow || p.article || '';
    var exist = Number(p.exist || 0);
    var termRaw = p.timeToExe || p.time_to_exe || '0';
    var storageRaw = p.storage || '—';
    var priceRaw = Number(p.price || 0);
    var href = '/en/parts/' + encodeURIComponent(String(p.manufacturer || '').toUpperCase()) + '/' + encodeURIComponent(show || article);
    var pk = photoKey(p.manufacturer, show || p.article);
    var isSub = index > 0 && quantity > 1;
    var mask = '**';
    var avail = pricesVisible ? String(exist) : mask;
    var term = pricesVisible ? esc(formatTerm(termRaw, storageRaw)) : mask;
    var price = pricesVisible ? priceRaw.toFixed(2) : mask;
    var wh = warehouseCaption(p, storageRaw);
    var photoHtml = isSub
      ? '<td class="td_photo epc-search-row-photo--subrow"></td>'
      : ('<td class="td_photo" data-epc-row-photo="' + esc(pk) + '">' +
        '<button type="button" class="epc-search-row-photo__btn epc-search-row-photo__btn--load" ' +
        'data-epc-photo-brand="' + esc(p.manufacturer || '') + '" data-epc-photo-article="' + esc(show || p.article || '') + '" ' +
        'title="Click to load product photo" aria-label="Load product photo"><i class="fa fa-image"></i></button></td>');
    var mfrHtml = isSub
      ? ('<td class="td_manufacturer"><span>' + esc(p.manufacturer || '') + '</span>' +
        '<div class="epc-warehouse-subrow__label" title="Warehouse offer"><i class="fa fa-level-up fa-rotate-90" aria-hidden="true"></i> ' +
        esc(wh) + '</div></td>')
      : ('<td class="td_manufacturer"><strong>' + esc(p.manufacturer || '') + '</strong>' +
        (quantity > 1 ? '<div class="epc-warehouse-group-hint" title="Multiple warehouse offers">' + quantity + ' warehouses</div>' : '') +
        '</td>');
    var artHtml = isSub
      ? '<td class="td_article"></td>'
      : ('<td class="td_article"><a class="bread_crumbs_a" href="' + href + '" data-enhance-nav="false">' + esc(show) + '</a></td>');
    var nameHtml = isSub ? '<td class="td_name"></td>' : ('<td class="td_name">' + esc(p.name || '—') + '</td>');
    tr.className = 'epc-part-type-row epc-part-type-row--' + kind + ' epc-ssr-warehouse-row' + (isSub ? ' epc-warehouse-subrow' : '');
    tr.setAttribute('data-group-index', String(index));
    tr.setAttribute('data-group-qty', String(quantity));
    tr.removeAttribute('data-actions-wired');
    tr.innerHTML =
      photoHtml + mfrHtml + artHtml + nameHtml +
      '<td class="td_exist ' + (pricesVisible && exist > 0 ? 'epc-stock-ok' : 'epc-stock-out') + '">' + avail + '</td>' +
      '<td class="td_time_to_exe"><span class="epc-warehouse-term">' + term + '</span></td>' +
      '<td class="td_info">' + (isSub ? '' : infoCellHtml(p, show, storageRaw, pricesVisible)) + '</td>' +
      '<td class="td_price product_price">' + (pricesVisible ? ('<span class="epc-price-value" data-epc-base-price="' + price + '">' + price + '</span>') : price) + '</td>' +
      '<td class="td_add_to_cart">' + actionsHtml(p, exist, show) + '</td>' +
      '<td class="td_color"></td>';
  }
  function productFromTr(tr) {
    return {
      manufacturer: tr.getAttribute('data-manufacturer') || '',
      article: tr.getAttribute('data-article') || '',
      articleShow: tr.getAttribute('data-article-show') || '',
      name: tr.getAttribute('data-name') || '',
      exist: Number(tr.getAttribute('data-exist') || 0),
      price: Number(tr.getAttribute('data-price') || 0),
      timeToExe: tr.getAttribute('data-term') || '0',
      timeToExeGuaranteed: tr.getAttribute('data-term-g') || '',
      storage: tr.getAttribute('data-storage') || '—',
      minOrder: Number(tr.getAttribute('data-min-order') || 1),
      probability: Number(tr.getAttribute('data-probability') || 100),
      officeId: Number(tr.getAttribute('data-office-id') || 0),
      storageId: Number(tr.getAttribute('data-storage-id') || 0),
      pricePurchase: Number(tr.getAttribute('data-price-purchase') || 0),
      markup: Number(tr.getAttribute('data-markup') || 0),
      jsonParams: tr.getAttribute('data-json-params') || '',
      productType: Number(tr.getAttribute('data-product-type') || 2),
      checkHash: tr.getAttribute('data-check-hash') || '',
      priceList: tr.getAttribute('data-storage') || '',
      fromCrossStock: tr.getAttribute('data-cross-stock') === '1'
    };
  }
  function normalizeWarehouseGroups(kind) {
    var rows = Array.prototype.slice.call(body.querySelectorAll('tr.epc-part-type-row--' + kind + '[data-offer-key]'));
    if (!rows.length) return;
    var groups = Object.create(null);
    var order = [];
    rows.forEach(function (tr) {
      var gk = tr.getAttribute('data-group-key') || brandArticleGroupKey(
        tr.getAttribute('data-manufacturer'),
        tr.getAttribute('data-article-show') || tr.getAttribute('data-article'));
      tr.setAttribute('data-group-key', gk);
      if (!groups[gk]) { groups[gk] = []; order.push(gk); }
      groups[gk].push(tr);
    });
    var anchor = rows[0].previousSibling;
    order.forEach(function (gk) {
      var list = groups[gk].slice().sort(function (a, b) {
        var pa = parseFloat(a.getAttribute('data-price') || '0');
        var pb = parseFloat(b.getAttribute('data-price') || '0');
        if (pa !== pb) return pa - pb;
        return parseFloat(a.getAttribute('data-term') || '0') - parseFloat(b.getAttribute('data-term') || '0');
      });
      list.forEach(function (tr, i) {
        paintOfferCells(tr, productFromTr(tr), kind, i, list.length);
        if (anchor && anchor.parentNode === body) body.insertBefore(tr, anchor.nextSibling);
        else body.appendChild(tr);
        anchor = tr;
      });
    });
  }
  function appendProduct(p) {
    var key = offerKey(p);
    if (seen[key]) return;
    seen[key] = 1;
    var empty = body.querySelector('tr[data-empty="1"]');
    if (empty) empty.remove();
    var kind = isGenuine(p.manufacturer) ? 'genuine' : 'aftermarket';
    var cap = ensureSection(kind);
    var tr = document.createElement('tr');
    var show = p.articleShow || p.article || '';
    var exist = Number(p.exist || 0);
    var termRaw = p.timeToExe || p.time_to_exe || '0';
    var storageRaw = p.storage || '—';
    var priceRaw = Number(p.price || 0);
    var aid = aidSeq;
    var gk = brandArticleGroupKey(p.manufacturer, show || p.article);
    tr.setAttribute('data-offer-key', key);
    tr.setAttribute('data-group-key', gk);
    tr.setAttribute('data-aid', String(aid));
    tr.setAttribute('data-manufacturer', p.manufacturer || '');
    tr.setAttribute('data-article', p.article || show);
    tr.setAttribute('data-article-show', show);
    tr.setAttribute('data-name', p.name || '');
    tr.setAttribute('data-exist', String(exist));
    tr.setAttribute('data-price', String(priceRaw));
    tr.setAttribute('data-term', String(termRaw));
    tr.setAttribute('data-term-g', String(p.timeToExeGuaranteed || p.time_to_exe_guaranteed || termRaw));
    tr.setAttribute('data-storage', storageRaw);
    tr.setAttribute('data-min-order', String(p.minOrder || p.min_order || 1));
    tr.setAttribute('data-probability', String(p.probability || 100));
    tr.setAttribute('data-office-id', String(p.officeId || p.office_id || 0));
    tr.setAttribute('data-storage-id', String(p.storageId || p.storage_id || 0));
    tr.setAttribute('data-price-purchase', String(p.pricePurchase || p.price_purchase || 0));
    tr.setAttribute('data-markup', String(p.markup || 0));
    tr.setAttribute('data-json-params', p.jsonParams || p.json_params || '');
    tr.setAttribute('data-product-type', String(p.productType || p.product_type || 2));
    tr.setAttribute('data-check-hash', p.checkHash || p.check_hash || '');
    if (p.fromCrossStock || p.from_cross_stock) {
      tr.setAttribute('data-cross-stock', '1');
    }
    var peers = body.querySelectorAll('tr.epc-part-type-row--' + kind + '[data-group-key="' + gk.replace(/"/g, '') + '"]');
    if (peers.length) body.insertBefore(tr, peers[peers.length - 1].nextSibling);
    else {
      var rows = body.querySelectorAll('tr.epc-part-type-row--' + kind);
      if (rows.length) body.insertBefore(tr, rows[rows.length - 1].nextSibling);
      else body.insertBefore(tr, cap.nextSibling);
    }
    normalizeWarehouseGroups(kind);
    bumpCaption(kind);
    if (typeof window.epcBindSearchRowPhotoLoaders === 'function') window.epcBindSearchRowPhotoLoaders(body);
    // Per-row filter refresh hides cross-stock under a mid-merge price range (ACDELCO/19114114).
    if (!p.skipFilterRefresh
      && typeof window.epcWarehouseParity === 'object'
      && typeof window.epcWarehouseParity.rebuildFilterOptions === 'function') {
      window.epcWarehouseParity.rebuildFilterOptions();
      window.epcWarehouseParity.applyFilters();
    }
  }
  function refreshOfferFilters() {
    if (typeof window.epcWarehouseParity === 'object'
      && typeof window.epcWarehouseParity.rebuildFilterOptions === 'function') {
      window.epcWarehouseParity.rebuildFilterOptions();
      window.epcWarehouseParity.applyFilters();
    }
    ['genuine', 'aftermarket'].forEach(bumpCaption);
  }
  function buildQuery(bunch) {
    var q = { article: article, searsch_str: article, manufacturer: brand, manufacturers: [], analogs: [] };
    if (Number(bunch.protocolVersion || bunch.protocol_version || 0) === 3) {
      q.office_storage_bunches = (bunch.nestedBunches || bunch.nested_bunches || []).map(function (n) {
        return { office_id: n.officeId || n.office_id || 0, storage_id: n.storageId || n.storage_id || 0 };
      });
    }
    return JSON.stringify(q);
  }
  function pollOne(bunch) {
    var fd = new FormData();
    fd.append('article', article);
    fd.append('brand', brand);
    fd.append('office_id', String(bunch.officeId != null ? bunch.officeId : bunch.office_id || 0));
    fd.append('storage_id', String(bunch.storageId != null ? bunch.storageId : bunch.storage_id || 0));
    fd.append('query', buildQuery(bunch));
    var opts = { method: 'POST', body: fd, credentials: 'same-origin' };
    // Hard 3s wall clock — warehouse rows must paint inside the 1–3s budget.
    if (typeof AbortSignal !== 'undefined' && typeof AbortSignal.timeout === 'function') {
      opts.signal = AbortSignal.timeout(3000);
    }
    return fetch('/storefront/products-of-bunch', opts)
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data && data.prices_visible === false) {
          pricesVisible = false;
          if (table) table.setAttribute('data-prices-visible', '0');
        } else if (data && data.prices_visible === true) {
          // Login / session restore: unlatch guest mask so redacted ** SSR rows can be replaced.
          // Never delete PHP-style cross-stock rows — ACDELCO/19114114 has zero direct warehouse
          // hits; wiping them left the green banner with an empty table.
          var wasMasked = !pricesVisible || (table && table.getAttribute('data-prices-visible') === '0');
          pricesVisible = true;
          if (table) table.setAttribute('data-prices-visible', '1');
          if (wasMasked) {
            body.querySelectorAll('tr.epc-part-type-row--genuine, tr.epc-part-type-row--aftermarket').forEach(function (tr) {
              if (tr.getAttribute('data-cross-stock') === '1') return;
              var k = tr.getAttribute('data-offer-key');
              if (k) delete seen[k];
              tr.remove();
            });
            ['genuine', 'aftermarket'].forEach(bumpCaption);
          }
        }
        var products = (data && data.products) || [];
        products.forEach(function (p) { appendProduct(p); });
        // Empty typed-brand poll must not leave a wiped table — restore cross stock (PHP epcBindCrossStockProducts).
        if (products.length === 0) {
          mergeCrossStockIntoOffers(window.__epcPendingCrossStock);
        } else {
          refreshOfferFilters();
        }
        // If we just unmasked but this payload had no offers, fire one more poll for unredacted rows.
        if (data && data.prices_visible === true && products.length === 0 &&
            table && table.getAttribute('data-prices-visible') === '1' && !window.__epcPriceUnmaskRepoll) {
          window.__epcPriceUnmaskRepoll = 1;
          return pollOne(bunch);
        }
      })
      .catch(function () {});
  }
  function ensureNoDirectStockNotice() {
    // PHP urlBrandNotice when typed brand has no warehouse row but crosses do.
    if (!body || body.querySelector('tr[data-offer-key]:not([data-cross-stock="1"])')) return;
    if (!body.querySelector('tr[data-cross-stock="1"]')) return;
    if (document.getElementById('epc-cross-brand-notice')) return;
    var tr = document.createElement('tr');
    tr.id = 'epc-cross-brand-notice';
    tr.innerHTML = '<td colspan="10" style="padding:12px 10px;background:#fff8e6;border-bottom:1px solid #f0e4b5;">' +
      '<div class="epc-brand-notice"><div class="epc-brand-notice__text"><i class="fa fa-info-circle"></i> No stock for <strong>' +
      esc(brand) + '</strong> on this article. Showing available brands from UAE price lists.</div></div></td>';
    var firstSplit = body.querySelector('tr td.epc-part-type-split');
    if (firstSplit && firstSplit.parentNode) body.insertBefore(tr, firstSplit.parentNode);
    else body.insertBefore(tr, body.firstChild);
  }
  function mergeCrossStockIntoOffers(stockItems) {
    // PHP epcBindCrossStockProducts / epcTryMergePendingCrossStock — paint UAE stock
    // for interchangeable numbers alongside the typed article's warehouse rows.
    stockItems = stockItems || window.__epcPendingCrossStock || [];
    if (!stockItems.length || !body) return 0;
    window.epcMergeCrossStockIntoOffers = mergeCrossStockIntoOffers;
    var added = 0;
    stockItems.forEach(function (item) {
      var mfr = item.brand || item.manufacturer || '';
      var art = item.article || item.article_norm || '';
      if (!mfr || !art) return;
      var before = Object.keys(seen).length;
      appendProduct({
        manufacturer: mfr,
        article: art,
        articleShow: item.article || art,
        name: item.name || '',
        // Guest redaction may zero qty — still treat as in-stock catalog for merge paint.
        exist: item.qty != null ? item.qty : (item.exist != null ? item.exist : 1),
        price: item.price != null ? item.price : 0,
        timeToExe: item.delivery != null ? item.delivery : (item.time_to_exe || '0'),
        storage: item.warehouse || 'Cross stock',
        storageId: item.storage_id || 0,
        officeId: item.office_id || 1,
        minOrder: 1,
        probability: 100,
        productType: 2,
        pricePurchase: item.price_purchase || 0,
        markup: item.markup || 0,
        jsonParams: '',
        checkHash: '',
        fromCrossStock: true,
        skipFilterRefresh: true
      });
      if (Object.keys(seen).length > before) added++;
    });
    if (added > 0) {
      body.querySelectorAll('tr[data-empty="1"]').forEach(function (tr) { tr.remove(); });
      ensureNoDirectStockNotice();
      refreshOfferFilters();
      if (progress) {
        progress.hidden = true;
        progress.setAttribute('data-done', '1');
      }
