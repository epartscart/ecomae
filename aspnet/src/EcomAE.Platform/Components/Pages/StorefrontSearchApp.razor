    private void ApplyChpuSeo()
    {
        if (string.IsNullOrWhiteSpace(_brandInput) || string.IsNullOrWhiteSpace(_normalized))
        {
            _emitChpuSeo = false;
            return;
        }

        var req = Http.HttpContext?.Request;
        if (req is null)
        {
            _emitChpuSeo = false;
            return;
        }

        var inStock = _rows.Any(static r => r.Exist > 0) || _chpuSeoInStock;
        var productName = _rows.Select(static r => r.Name).FirstOrDefault(static n => !string.IsNullOrWhiteSpace(n))
            ?? (_chpuSeoProductName.Length > 0 ? _chpuSeoProductName : null);
        var minPrice = _rows.Where(static r => r.Price > 0m).Select(static r => r.Price).DefaultIfEmpty(0m).Min();
        if (minPrice <= 0m && _chpuSeoMinPrice > 0m)
        {
            minPrice = _chpuSeoMinPrice;
        }

        _chpuCanonical = StorefrontPublicSeo.CanonicalForPartsChpu(req, _brandInput, _normalized);
        _chpuDescription = StorefrontPublicSeo.PartsChpuDescription(_brandInput, _normalized, productName, inStock);
        _chpuKeywords = StorefrontPublicSeo.PartsChpuKeywords(_brandInput, _normalized);
        _chpuRobots = StorefrontPublicSeo.PartsChpuRobots(inStock);
        _chpuHreflang = StorefrontPublicSeo.HreflangAlternatesForParts(req, _brandInput, _normalized);
        _chpuHeadExtras = StorefrontPublicSeo.HeadExtrasHtml(req);
        var crossPairs = _crossRefs
            .Select(c => (c.Brand, c.Article))
            .Take(25)
            .ToList();
        _chpuJsonLd = StorefrontPublicSeo.ProductJsonLdBlock(
            req,
            _brandInput,
            _normalized,
            productName,
            _pricesVisible ? minPrice : 0m,
            inStock,
            "AED",
            crossPairs);
        _emitChpuSeo = true;
    }

    private void SplitOfferRows(IReadOnlyList<StorefrontPartOfferDigest> rows)
    {
        var genuine = new List<StorefrontPartOfferDigest>();
        var aftermarket = new List<StorefrontPartOfferDigest>();
        foreach (var row in rows)
        {
            if (IsGenuineManufacturer(row.Manufacturer))
            {
                genuine.Add(row);
            }
            else
            {
                aftermarket.Add(row);
            }
        }

        _genuineRows = genuine;
        _aftermarketRows = aftermarket;
    }

    private bool IsGenuineManufacturer(string? brand)
    {
        if (string.IsNullOrWhiteSpace(brand) || _genuineKeys.Count == 0)
        {
            return false;
        }

        return _genuineKeys.Contains(brand.Trim().ToUpperInvariant());
    }

    private static string BrandPickerTerm(StorefrontArticleBrandDigest brand)
    {
        if (brand.Exist <= 0)
        {
            return "Open brand for stock";
        }

        var wh = (brand.Warehouse ?? string.Empty).Trim();
        return string.IsNullOrWhiteSpace(wh) ? "In warehouse" : $"In warehouse · {wh}";
    }

    private static string FormatWarehouseTerm(string? timeToExe, string? storage)
    {
        var t = (timeToExe ?? string.Empty).Trim();
        var stor = (storage ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(t) || t is "0" or "—")
        {
            return string.IsNullOrWhiteSpace(stor) || stor == "—"
                ? "In warehouse"
                : $"In warehouse · {stor}";
        }

        if (int.TryParse(t, NumberStyles.Integer, CultureInfo.InvariantCulture, out var days))
        {
            return days == 1 ? "1 day" : $"{days} days";
        }

        return t;
    }

    private static string PhotoRowKey(string? brand, string? article)
    {
        static string Compact(string? s)
        {
            if (string.IsNullOrEmpty(s))
            {
                return string.Empty;
            }

            var sb = new System.Text.StringBuilder(s.Length);
            foreach (var ch in s)
            {
                if (char.IsLetterOrDigit(ch))
                {
                    sb.Append(char.ToUpperInvariant(ch));
                }
            }

            return sb.ToString();
        }

        return Compact(brand) + "|" + Compact(article);
    }

    /// <summary>PHP part_search mode-1: same brand+article → one lead row + warehouse sub-rows.</summary>
    private static IEnumerable<(StorefrontPartOfferDigest Row, int Index, int Quantity)> GroupWarehouseOffers(
        IReadOnlyList<StorefrontPartOfferDigest> rows)
    {
        var groups = rows
            .GroupBy(r => BrandArticleGroupKey(r.Manufacturer, string.IsNullOrWhiteSpace(r.ArticleShow) ? r.Article : r.ArticleShow))
            .Select(g => g
                .OrderBy(x => x.Price)
                .ThenBy(x => ParseTermSort(x.TimeToExe))
                .ThenBy(x => x.Storage ?? "", StringComparer.OrdinalIgnoreCase)
                .ToList())
            .ToList();
        foreach (var group in groups)
        {
            for (var i = 0; i < group.Count; i++)
            {
                yield return (group[i], i, group.Count);
            }
        }
    }

    private static string BrandArticleGroupKey(string? brand, string? article)
    {
        static string Compact(string? s)
        {
            if (string.IsNullOrEmpty(s))
            {
                return string.Empty;
            }

            var sb = new System.Text.StringBuilder(s.Length);
            foreach (var ch in s)
            {
                if (char.IsLetterOrDigit(ch))
                {
                    sb.Append(char.ToUpperInvariant(ch));
                }
            }

            return sb.ToString();
        }

        return Compact(brand) + "|" + Compact(article);
    }

    private static int ParseTermSort(string? term)
        => int.TryParse(term, NumberStyles.Integer, CultureInfo.InvariantCulture, out var n) ? n : int.MaxValue;

