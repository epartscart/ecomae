@code {
    private string _articleInput = "";
    private string _attrQuery = "";
    private string _brandInput = "";
    private string _mode = "";
    private string _heroTitle = "Part search";
    private string _heroSubtitle = "Search by article, choose a brand, then open warehouse prices.";
    private string _normalized = "";
    private bool _showBrandPicker;
    private IReadOnlyList<StorefrontArticleBrandDigest> _brands = [];
    private IReadOnlyList<StorefrontPartOfferDigest> _rows = [];
    private IReadOnlyList<StorefrontPartOfferDigest> _genuineRows = [];
    private IReadOnlyList<StorefrontPartOfferDigest> _aftermarketRows = [];
    private HashSet<string> _genuineKeys = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<StorefrontCrossRefDigest> _crossRefs = [];
    private IReadOnlyList<StorefrontCrossRefDigest> _crossStockRefs = [];
    private IReadOnlyList<string> _relatedBrandCross = [];
    private int _offerAidSeq = 1;
    private string _source = "n/a";
    private string _message = "";
    private bool _pricesVisible = true;
    private string _accessState = "ok";
    private string _loginCtaHtml = string.Empty;

    private Microsoft.AspNetCore.Components.MarkupString JsonArticle =>
        (Microsoft.AspNetCore.Components.MarkupString)System.Text.Json.JsonSerializer.Serialize(_normalized);
    private Microsoft.AspNetCore.Components.MarkupString JsonBrand =>
        (Microsoft.AspNetCore.Components.MarkupString)System.Text.Json.JsonSerializer.Serialize(_brandInput);
    private Microsoft.AspNetCore.Components.MarkupString JsonGenuine
    {
        get
        {
            var map = _genuineKeys.ToDictionary(k => k, _ => true, StringComparer.OrdinalIgnoreCase);
            return (Microsoft.AspNetCore.Components.MarkupString)System.Text.Json.JsonSerializer.Serialize(map);
        }
    }

    /// <summary>PHP <c>$initial_position_search = 0</c> on CHPU brand/warehouse results — header search only.</summary>
    private bool _hideInPageSearch =>
        !string.IsNullOrWhiteSpace(_articleInput)
        && !string.IsNullOrWhiteSpace(_brandInput)
        && _mode is not ("attr" or "vin" or "engine" or "car");

    /// <summary>PHP nero title: <c>Pricing and availability for {BRAND} {ARTICLE} - eParts Cart</c>.</summary>
    private string PageTitleText
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_brandInput) && !string.IsNullOrWhiteSpace(_normalized))
            {
                return $"Pricing and availability for {_brandInput.ToUpperInvariant()} {_normalized} - eParts Cart (Autoparts)";
            }

            if (!string.IsNullOrWhiteSpace(_normalized))
            {
                return $"Part search {_normalized} · eParts Cart";
            }

            return "Part search · eParts Cart";
        }
    }

    private string SearchFormAction => _mode switch
    {
        "attr" => StorefrontSurfaceLinks.WarehouseSearch,
        "vin" => StorefrontSurfaceLinks.LaximoVin,
        "engine" or "car" => StorefrontSurfaceLinks.VehicleCatalog,
        _ => StorefrontSurfaceLinks.PartSearch
    };

    [Parameter]
    public string? PathBrand { get; set; }

    [Parameter]
    public string? PathArticle { get; set; }

    [SupplyParameterFromQuery(Name = "article")]
    public string? ArticleQuery { get; set; }

    /// <summary>Preferred ASP.NET query param (user-facing brand/article format).</summary>
    [SupplyParameterFromQuery(Name = "brand")]
    public string? BrandQuery { get; set; }

    /// <summary>PHP legacy typo param — still accepted for parity with part_search.</summary>
    [SupplyParameterFromQuery(Name = "brend")]
    public string? BrendQuery { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? AttrQuery { get; set; }

    [SupplyParameterFromQuery(Name = "mode")]
    public string? ModeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "identString")]
    public string? VinQuery { get; set; }

    [SupplyParameterFromQuery(Name = "engine")]
    public string? EngineQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Http.HttpContext is not null)
        {
            var access = await PriceAccess.ResolveAsync(Http.HttpContext);
            _pricesVisible = access.PricesVisible;
            _accessState = access.StateToken;
            _loginCtaHtml = access.LoginCtaHtml;
        }

        if (Navigation.Uri.Contains("warehouse-search", StringComparison.OrdinalIgnoreCase))
        {
            _mode = "attr";
        }

        _mode = string.IsNullOrWhiteSpace(_mode)
            ? (ModeQuery ?? "").Trim().ToLowerInvariant()
            : _mode;
        _attrQuery = AttrQuery?.Trim() ?? "";

        // CHPU /parts/{brand}/{article} → brand+article result (PHP prices_by_article_and_manufacturer).
        var pathBrand = DecodePathSegment(PathBrand);
        var pathArticle = DecodePathSegment(PathArticle);
        if (!string.IsNullOrWhiteSpace(pathArticle)
            && !string.Equals(pathBrand, "brands", StringComparison.OrdinalIgnoreCase))
        {
            _articleInput = pathArticle;
            _brandInput = pathBrand;
        }
        else
        {
            _articleInput = ArticleQuery?.Trim() ?? "";
            // Prefer brand=; fall back to PHP brend=.
            _brandInput = FirstNonEmpty(BrandQuery, BrendQuery);
            if (string.Equals(pathBrand, "brands", StringComparison.OrdinalIgnoreCase)
                && !string.IsNullOrWhiteSpace(pathArticle)
                && string.IsNullOrWhiteSpace(_articleInput))
            {
                _articleInput = pathArticle;
            }
        }

        if (string.IsNullOrWhiteSpace(_articleInput) && !string.IsNullOrWhiteSpace(VinQuery))
        {
            _articleInput = VinQuery.Trim();
        }
        else if (string.IsNullOrWhiteSpace(_articleInput) && !string.IsNullOrWhiteSpace(_attrQuery))
        {
            _articleInput = _attrQuery;
        }
        else if (string.IsNullOrWhiteSpace(_articleInput) && !string.IsNullOrWhiteSpace(EngineQuery))
        {
            _articleInput = EngineQuery.Trim();
        }

        _heroTitle = _mode switch
        {
            "attr" => "Warehouse / more info",
            "vin" => "VIN / Frame search",
            "engine" => "Engine code search",
            "car" => "Vehicle catalog",
            "name" => "Search by name",
            _ => string.IsNullOrWhiteSpace(_brandInput) ? "Part search" : $"{_brandInput.ToUpperInvariant()} {_articleInput.ToUpperInvariant()}"
        };
        _heroSubtitle = _mode switch
        {
            "attr" => "Search product attributes across warehouse offers (engine, size, country, cross ref).",
            "vin" => "Look up parts by VIN / Frame — open the dedicated VIN app for Laximo decode trees.",
            "engine" => "Look up parts by engine code across warehouse offers.",
            "car" => "Browse by vehicle — open the vehicle catalog app for year/make/model.",
            _ => string.IsNullOrWhiteSpace(_brandInput)
                ? "Select a manufacturer after searching by article (PHP brand picker parity)."
                : "Warehouse offers and cross references for the selected brand + article."
        };

        // Dedicated apps own VIN / vehicle-tree UX when PreferAspNetApps is on.
        if (_mode is "vin")
        {
            var vin = FirstNonEmpty(VinQuery, _articleInput);
            Navigation.NavigateTo(StorefrontSurfaceLinks.ForVin(vin), replace: true);
            return;
        }

        if (_mode is "car" or "engine")
        {
            Navigation.NavigateTo(StorefrontSurfaceLinks.VehicleCatalog, replace: true);
            return;
        }

        if (string.IsNullOrWhiteSpace(_articleInput))
        {
            return;
        }

        // PHP canonical result URL is CHPU /en/parts/{BRAND}/{ARTICLE}.
        // Keep that sticky: query-param search-app remaps into CHPU; CHPU loads digests in place
        // (never bounce CHPU → search-app — that made two different live results).
        var onChpuBrandArticle = !string.IsNullOrWhiteSpace(PathArticle)
            && !string.IsNullOrWhiteSpace(PathBrand)
            && !string.Equals(PathBrand, "brands", StringComparison.OrdinalIgnoreCase);
        if (!onChpuBrandArticle
            && !string.IsNullOrWhiteSpace(_articleInput)
            && !string.IsNullOrWhiteSpace(_brandInput)
            && _mode is not ("attr" or "vin" or "engine" or "car"))
        {
            Navigation.NavigateTo(BrandArticleHref(_articleInput, _brandInput), replace: true);
            return;
        }

        if (string.IsNullOrWhiteSpace(_brandInput))
        {
            var brandsResult = await Dashboards.ListStorefrontArticleBrandsAsync(_articleInput, 100);
            _normalized = brandsResult.Article;
            _brands = brandsResult.Brands;
            _showBrandPicker = true;
            _source = brandsResult.Source;
            _message = brandsResult.Message;

            // PHP: single manufacturer → open prices directly (SQL or php-chpu bridge).
            if (_brands.Count == 1
                && (_source is "database" or "php-chpu"))
            {
                Navigation.NavigateTo(BrandArticleHref(_normalized, _brands[0].Brand), forceLoad: true);
            }

            return;
        }

        var genuine = await Dashboards.ListStorefrontGenuineBrandsAsync();
        _genuineKeys = new HashSet<string>(genuine.Brands, StringComparer.OrdinalIgnoreCase);

        var result = await Dashboards.SearchStorefrontPartsAsync(_articleInput, _brandInput, 100);
        _normalized = result.Article;
        _rows = _pricesVisible ? result.Rows : PriceAccess.RedactOffers(result.Rows);
        _source = result.Source;
        _message = result.Message;
        _showBrandPicker = false;
        SplitOfferRows(_rows);

        var crossResult = await Dashboards.ListStorefrontCrossRefsAsync(_articleInput, _brandInput, 80);
        _crossRefs = crossResult.Rows;
        _crossStockRefs = crossResult.Rows.Where(static r => r.InStock).ToList();
        if (_crossRefs.Count == 0)
        {
            // Broader article-level crosses (no brand filter), then manufacturer picker siblings.
            var anyBrand = await Dashboards.ListStorefrontCrossRefsAsync(_articleInput, brand: null, 80);
            _crossRefs = anyBrand.Rows;
            _crossStockRefs = anyBrand.Rows.Where(static r => r.InStock).ToList();
        }

        var brandSiblings = await Dashboards.ListStorefrontArticleBrandsAsync(_articleInput, 40);
        _relatedBrandCross = brandSiblings.Brands
            .Select(b => b.Brand)
            .Where(b => !string.Equals(b, _brandInput, StringComparison.OrdinalIgnoreCase))
            .Take(24)
            .ToList();
    }

    private void SplitOfferRows(IReadOnlyList<StorefrontPartOfferDigest> rows)
    {
        var genuine = new List<StorefrontPartOfferDigest>();
        var aftermarket = new List<StorefrontPartOfferDigest>();
        foreach (var row in rows)
        {
            if (IsGenuineManufacturer(row.Manufacturer))
            {
                genuine.Add(row);
            }
            else
            {
                aftermarket.Add(row);
            }
        }

        _genuineRows = genuine;
        _aftermarketRows = aftermarket;
    }

    private bool IsGenuineManufacturer(string? brand)
    {
        if (string.IsNullOrWhiteSpace(brand) || _genuineKeys.Count == 0)
        {
            return false;
        }

        return _genuineKeys.Contains(brand.Trim().ToUpperInvariant());
    }

    private RenderFragment OfferRow(StorefrontPartOfferDigest row, string kind) => __builder =>
    {
        var show = string.IsNullOrWhiteSpace(row.ArticleShow) ? row.Article : row.ArticleShow;
        var term = string.IsNullOrWhiteSpace(row.TimeToExe) ? "—" : row.TimeToExe;
        var storage = string.IsNullOrWhiteSpace(row.Storage) ? "—" : row.Storage;
        var key = string.Join('|',
            (row.Manufacturer ?? "").Trim().ToUpperInvariant(),
            row.Article ?? "",
            row.Storage ?? "",
            row.Price.ToString(CultureInfo.InvariantCulture));
        var mask = StorefrontPriceAccess.SensitiveMask;
        var aid = _offerAidSeq++;
        var minOrder = row.MinOrder > 0 ? row.MinOrder : 1;
        var waText = Uri.EscapeDataString($"{row.Manufacturer} {show} {row.Name} {row.Price}");
        <tr class="@($"epc-part-type-row--{kind}")"
            data-offer-key="@key"
            data-aid="@aid"
            data-manufacturer="@row.Manufacturer"
            data-article="@row.Article"
            data-article-show="@show"
            data-name="@row.Name"
            data-exist="@row.Exist"
            data-price="@row.Price.ToString(CultureInfo.InvariantCulture)"
            data-term="@row.TimeToExe"
            data-term-g="@row.TimeToExeGuaranteed"
            data-storage="@storage"
            data-min-order="@minOrder"
            data-probability="@row.Probability"
            data-office-id="@row.OfficeId"
            data-storage-id="@row.StorageId"
            data-price-purchase="@row.PricePurchase.ToString(CultureInfo.InvariantCulture)"
            data-markup="@row.Markup"
            data-json-params="@row.JsonParams"
            data-product-type="@row.ProductType"
            data-check-hash="@row.CheckHash">
            <td class="td_manufacturer"><strong>@row.Manufacturer</strong></td>
            <td class="td_article">@show</td>
            <td class="td_name">@(string.IsNullOrWhiteSpace(row.Name) ? "—" : row.Name)</td>
            @if (_pricesVisible)
            {
                <td class="td_exist @(row.Exist > 0 ? "epc-stock-ok" : "epc-stock-out")">
                    @(row.Exist > 0 ? row.Exist.ToString(CultureInfo.InvariantCulture) : "0")
                    @if (row.Exist > 0)
                    {
                        <span class="epc-instock-badge">In stock</span>
                    }
                </td>
                <td class="td_time_to_exe">@term</td>
                <td class="td_price">@row.Price.ToString("N2", CultureInfo.InvariantCulture)</td>
                <td class="td_storage">@storage</td>
                <td class="td_price_list">@(string.IsNullOrWhiteSpace(row.PriceList) ? "—" : row.PriceList)</td>
            }
            else
            {
                <td class="td_exist epc-sf-price-mask">@mask</td>
                <td class="td_time_to_exe epc-sf-price-mask">@mask</td>
                <td class="td_price epc-sf-price-mask">@mask</td>
                <td class="td_storage epc-sf-price-mask">@mask</td>
                <td class="td_price_list epc-sf-price-mask">@mask</td>
            }
            <td class="td_add_to_cart">
                @if (!_pricesVisible)
                {
                    <div class="epc-product-actions epc-product-actions--guest">
                        <div class="epc-product-actions__tools epc-product-actions__tools--guest">
                            <button type="button" class="btn btn-sm epc-btn-fitment">Fitment</button>
                            @((MarkupString)_loginCtaHtml)
                        </div>
                    </div>
                }
                else if (row.Exist > 0)
                {
                    <div class="epc-product-actions">
                        <div class="epc-product-actions__tools">
                            <button type="button" class="btn btn-sm epc-btn-fitment">Fitment</button>
                            <a class="epc-wa-share" href="@($"https://wa.me/?text={waText}")" target="_blank" rel="noopener" title="WhatsApp"><i class="fa fa-whatsapp"></i></a>
                        </div>
                        <div class="epc-product-actions__buy">
                            <div class="epc-product-actions__qty">
                                <a class="count_need_minus" href="#"><i class="fa fa-minus"></i></a>
                                <input class="epc-qty-input" id="@($"count_need_{aid}")" value="@minOrder" />
                                <a class="count_need_plus" href="#"><i class="fa fa-plus"></i></a>
                            </div>
                            <button type="button" class="btn btn-sm btn-danger epc-btn-cart">Add to Cart</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="epc-product-actions epc-product-actions--quote-only">
                        <div class="epc-product-actions__tools">
                            <button type="button" class="btn btn-sm epc-btn-fitment">Fitment</button>
                            <a class="epc-wa-share" href="@($"https://wa.me/?text={waText}")" target="_blank" rel="noopener" title="WhatsApp"><i class="fa fa-whatsapp"></i></a>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary epc-btn-quote">Add to Quote</button>
                    </div>
                }
            </td>
        </tr>
    };

    /// <summary>PHP CHPU <c>/en/parts/{BRAND}/{ARTICLE}</c> — ASP.NET owns the same URL.</summary>
    private static string BrandArticleHref(string article, string? brand)
    {
        var art = (article ?? string.Empty).Trim();
        var br = (brand ?? string.Empty).Trim();
        if (br.Length > 0 && art.Length > 0)
        {
            return "/en/parts/"
                   + Uri.EscapeDataString(br.ToUpperInvariant())
                   + "/"
                   + Uri.EscapeDataString(art);
        }

        return ArticleOnlyHref(art);
    }

    /// <summary>PHP brand picker <c>/en/parts/brands/{ARTICLE}</c>.</summary>
    private static string ArticleOnlyHref(string article)
    {
        var art = (article ?? string.Empty).Trim();
        if (art.Length == 0)
        {
            return "/storefront/search-app";
        }

        return "/en/parts/brands/" + Uri.EscapeDataString(art);
    }

    private static string FirstNonEmpty(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value.Trim();
            }
        }

        return string.Empty;
    }

    private static string DecodePathSegment(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        try
        {
            return Uri.UnescapeDataString(value.Replace('+', ' ')).Trim();
        }
        catch (UriFormatException)
        {
            return value.Trim();
        }
    }
}
