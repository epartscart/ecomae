@page "/storefront/search-app"
@page "/en/shop/part_search"
@page "/en/shop/warehouse-search"
@page "/parts/{PathBrand}/{PathArticle}"
@page "/en/parts/{PathBrand}/{PathArticle}"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject IStorefrontPriceAccess PriceAccess
@inject IHttpContextAccessor Http
@inject NavigationManager Navigation

<PageTitle>@PageTitleText</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        
        .epc-sf-search-form { display:flex; gap:.45rem; flex-wrap:wrap; align-items:center; }
        .epc-sf-search-form input {
            flex:1; min-width:140px; padding:.4rem .65rem; border:1px solid #cbd5e1; border-radius:3px; font-size:.9rem; background:#fff; color:#111;
        }
        /* PHP site_professional_shell: CHPU results keep header search only. */
        .epc-chpu-direct-part-search .epc-sf-search-form,
        .epc-chpu-direct-part-search .epc-sf-page-actions .btn-default { display:none !important; }
        .epc-sf-search-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-sf-search-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-sf-search-kpi strong { display:block; font-size:1.35rem; font-variant-numeric:tabular-nums; }
        .epc-sf-search-kpi span { color:#64748b; font-size:.78rem; }
        .epc-sf-search-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-sf-search-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-sf-search-table th, .epc-sf-search-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-sf-search-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-sf-search-table a { color:#b91c1c; font-weight:700; text-decoration:none; }
        .epc-sf-search-note { margin-top:1rem; padding:.75rem .9rem; background:#fff8e8; border:1px solid #f1d49a; border-radius:.45rem; color:#7a4e00; font-size:.86rem; }
        .epc-sf-brand-picker { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:1rem 1.1rem; margin-bottom:1rem; }
        .epc-sf-brand-picker h2 { margin:0 0 .65rem; font-size:1.05rem; color:#0f172a; }
        .epc-sf-brand-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); gap:.45rem; }
        .epc-sf-brand-grid a {
            display:block; padding:.55rem .7rem; border:1px solid #e2e8f0; border-radius:.45rem; text-decoration:none;
            color:#b91c1c; font-weight:700; font-size:.84rem; background:#f8fafc;
        }
        .epc-sf-result-head { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:.5rem; margin:0 0 .65rem; }
        .epc-sf-result-head h2 { margin:0; font-size:1.1rem; color:#0f172a; }
        .epc-sf-result-head a { color:#b91c1c; font-weight:700; font-size:.82rem; text-decoration:none; }
        .epc-sf-cross-refs {
            max-width:1100px; margin:1rem 0; padding:14px 18px; border:1px solid #e2e8f0; border-radius:10px; background:#f8fafc;
        }
        .epc-sf-cross-refs h2 { margin:0 0 8px; font-size:18px; color:#0f172a; }
        .epc-sf-cross-refs ul { margin:0; padding-left:18px; columns:2; column-gap:24px; font-size:13px; line-height:1.55; }
        .epc-sf-cross-stock { margin-top:.75rem; }
        .epc-sf-cross-stock strong { display:block; margin-bottom:.35rem; font-size:.82rem; color:#0f172a; }
        .epc-avail-yes { color:#15803d; font-weight:700; font-size:.75rem; }
        .epc-avail-no { color:#64748b; font-size:.75rem; }
        .epc-stock-ok { color:#15803d; font-weight:700; }
        .epc-stock-out { color:#94a3b8; }
        .epc-part-type-caption td {
            background:#0f172a; color:#f8fafc; font-weight:800; font-size:.78rem;
            text-transform:uppercase; letter-spacing:.04em; padding:.65rem .7rem;
        }
        .epc-part-type-caption--aftermarket td { background:#334155; }
        .epc-part-type-row--genuine { background:#f0fdf4; }
        .epc-part-type-row--aftermarket { background:#fff; }
        .epc-sf-poll-progress {
            margin:.65rem 0 0; padding:.55rem .75rem; border-radius:.45rem;
            background:#eff6ff; border:1px solid #bfdbfe; color:#1e3a8a; font-size:.84rem;
        }
        .epc-sf-poll-progress[data-done="1"] { background:#f0fdf4; border-color:#bbf7d0; color:#14532d; }
        .epc-sf-price-gate {
            margin:0 0 .85rem; padding:.7rem .9rem; border-radius:.5rem; font-size:.86rem; line-height:1.4;
            background:#fff7ed; border:1px solid #fed7aa; color:#9a3412;
        }
        .epc-sf-price-gate a { color:#b91c1c; font-weight:700; }
        .epc-sf-price-mask { color:#64748b; font-weight:700; letter-spacing:.04em; }
        @@media (max-width:900px){ .epc-sf-search-kpis{grid-template-columns:1fr;} .epc-sf-cross-refs ul{columns:1;} }
    
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<PhpStorefrontDesktopChrome>

    <div class="@(_hideInPageSearch ? "epc-chpu-direct-part-search" : null)">
        <PhpStorefrontPageHeader Title="@_heroTitle" Subtitle="@_heroSubtitle">
            @if (!_hideInPageSearch)
            {
                <form class="epc-sf-search-form" method="get" action="@SearchFormAction">
                    @if (string.Equals(_mode, "attr", StringComparison.OrdinalIgnoreCase))
                    {
                        <input type="hidden" name="mode" value="attr" />
                        <input type="search" name="q" value="@_attrQuery" placeholder="Engine, size, country, cross ref…" aria-label="Warehouse / more info search" />
                    }
                    else if (string.Equals(_mode, "vin", StringComparison.OrdinalIgnoreCase))
                    {
                        <input type="hidden" name="mode" value="vin" />
                        <input type="search" name="identString" value="@_articleInput" placeholder="Enter VIN / Frame" aria-label="VIN" maxlength="32" />
                    }
                    else if (string.Equals(_mode, "engine", StringComparison.OrdinalIgnoreCase))
                    {
                        <input type="hidden" name="mode" value="engine" />
                        <input type="search" name="engine" value="@_articleInput" placeholder="Engine code (e.g. 3L, 12R)" aria-label="Engine code" />
                    }
                    else
                    {
                        <input type="search" name="article" value="@_articleInput" placeholder="Part number / article" aria-label="Part number" required />
                        <input type="search" name="brand" value="@_brandInput" placeholder="Brand (optional)" aria-label="Brand" />
                    }
                    <button type="submit" class="btn btn-sm btn-primary">Search</button>
                </form>
                <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.WarehouseSearch">Warehouse / more info</a>
                <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.LaximoVin">VIN search</a>
                <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.VehicleCatalog">Vehicle catalog</a>
            }
        </PhpStorefrontPageHeader>
    </div>

    <div class="epc-sf-search-kpis" aria-label="Search KPIs">
        <div class="epc-sf-search-kpi"><strong>@(_normalized.Length == 0 ? "—" : _normalized)</strong><span>Article</span></div>
        <div class="epc-sf-search-kpi"><strong>@(_showBrandPicker ? _brands.Count : _rows.Count)</strong><span>@(_showBrandPicker ? "Brands found" : "Warehouse offers")</span></div>
        <div class="epc-sf-search-kpi"><strong>@(_brandInput.Length == 0 ? "—" : _brandInput)</strong><span>Brand</span></div>
    </div>

    @if (_showBrandPicker)
    {
        <section class="epc-sf-brand-picker" aria-label="Manufacturer picker">
            <h2>Select manufacturer for <strong>@_normalized</strong></h2>
            <p style="margin:0 0 .75rem;color:#64748b;font-size:.86rem;">
                PHP part_search flow: article → brand → warehouse prices + cross references.
            </p>
            @if (_brands.Count == 0)
            {
                <p>No manufacturers found for this article (warehouse + local crosses). Try another part number or open warehouse / more info search.</p>
                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div style="margin-top:.5rem;color:#92400e;background:#fffbeb;border:1px solid #fde68a;border-radius:.4rem;padding:.5rem .7rem;font-size:12px;">
                        Brand lookup: <strong>@_source</strong> — @_message
                    </div>
                }
            }
            else
            {
                <div class="epc-sf-brand-grid">
                    @foreach (var brand in _brands)
                    {
                        <a href="@BrandArticleHref(_articleInput, brand.Brand)">@brand.Brand</a>
                    }
                </div>
            }
        </section>
    }
    else
    {
        <div class="epc-sf-result-head">
            <h2>@_brandInput @_normalized — warehouse offers</h2>
            <a href="@ArticleOnlyHref(_articleInput)">Change manufacturer</a>
        </div>
        @if (!_pricesVisible)
        {
            <div class="epc-sf-price-gate" data-access-state="@_accessState">
                @((MarkupString)_loginCtaHtml)
            </div>
        }
        <div id="epcSfPollProgress" class="epc-sf-poll-progress" hidden
             data-article="@_normalized" data-brand="@_brandInput" aria-live="polite">
            Polling suppliers… <span id="epcSfPollCount">0</span> of <span id="epcSfPollTotal">0</span>
        </div>
        <div class="epc-sf-search-table-wrap">
            <table class="epc-sf-search-table" id="all_table_products"
                   data-prices-visible="@(_pricesVisible ? "1" : "0")"
                   data-access-state="@_accessState">
                <thead>
                    <tr>
                        <th>Manufacturer</th>
                        <th>Article</th>
                        <th>Name</th>
                        <th>Availability</th>
                        <th>Term</th>
                        <th>Price</th>
                        <th>Storage</th>
                        <th>Price list</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="epcSfOfferBody">
                    @if (string.IsNullOrWhiteSpace(_normalized))
                    {
                        <tr data-empty="1"><td colspan="9">Enter article and brand to load warehouse offers.</td></tr>
                    }
                    else if (_genuineRows.Count == 0 && _aftermarketRows.Count == 0)
                    {
                        <tr data-empty="1">
                            <td colspan="9">
                                No warehouse offers yet for <strong>@_brandInput @_normalized</strong> — polling suppliers…
                                @if (!string.IsNullOrWhiteSpace(_message))
                                {
                                    <div style="margin-top:.5rem;color:#92400e;background:#fffbeb;border:1px solid #fde68a;border-radius:.4rem;padding:.5rem .7rem;font-size:12px;">
                                        Offer lookup: <strong>@_source</strong> — @_message
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    else
                    {
                        @if (_genuineRows.Count > 0)
                        {
                            <tr class="epc-part-type-caption" data-section="genuine"><td colspan="9">Genuine (OE) (@_genuineRows.Count)</td></tr>
                            @foreach (var row in _genuineRows)
                            {
                                @OfferRow(row, "genuine")
                            }
                        }
                        @if (_aftermarketRows.Count > 0)
                        {
                            <tr class="epc-part-type-caption epc-part-type-caption--aftermarket" data-section="aftermarket"><td colspan="9">Aftermarket (@_aftermarketRows.Count)</td></tr>
                            @foreach (var row in _aftermarketRows)
                            {
                                @OfferRow(row, "aftermarket")
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
        <p class="epc-sf-search-note">
            Warehouse rows load first; progressive supplier poll merges live <code>ajax_getProductsOfBunch</code>
            results into Genuine (OE) / Aftermarket sections. Cart / quote writes stay on classic PHP modules.
        </p>
        @if (!_showBrandPicker && !string.IsNullOrWhiteSpace(_normalized) && !string.IsNullOrWhiteSpace(_brandInput))
        {
            <script>
(function () {
  var article = @JsonArticle;
  var brand = @JsonBrand;
  var genuine = @JsonGenuine;
  if (!article || !brand) return;
  var progress = document.getElementById('epcSfPollProgress');
  var countEl = document.getElementById('epcSfPollCount');
  var totalEl = document.getElementById('epcSfPollTotal');
  var body = document.getElementById('epcSfOfferBody');
  if (!body) return;
  var table = document.getElementById('all_table_products');
  var pricesVisible = !table || table.getAttribute('data-prices-visible') === '1';
  var seen = Object.create(null);
  body.querySelectorAll('tr[data-offer-key]').forEach(function (tr) {
    seen[tr.getAttribute('data-offer-key')] = 1;
  });
  function normBrand(b) {
    return String(b || '').trim().toUpperCase();
  }
  function isGenuine(b) {
    return !!genuine[normBrand(b)];
  }
  function offerKey(p) {
    return [normBrand(p.manufacturer), String(p.article || ''), String(p.storage || ''), String(p.price || '')].join('|');
  }
  function ensureSection(kind) {
    var sel = 'tr.epc-part-type-caption[data-section="' + kind + '"]';
    var cap = body.querySelector(sel);
    if (cap) return cap;
    cap = document.createElement('tr');
    cap.className = 'epc-part-type-caption' + (kind === 'aftermarket' ? ' epc-part-type-caption--aftermarket' : '');
    cap.setAttribute('data-section', kind);
    var td = document.createElement('td');
    td.colSpan = 9;
    td.textContent = (kind === 'genuine' ? 'Genuine (OE)' : 'Aftermarket') + ' (0)';
    cap.appendChild(td);
    if (kind === 'genuine') {
      body.insertBefore(cap, body.firstChild);
    } else {
      body.appendChild(cap);
    }
    return cap;
  }
  function bumpCaption(kind) {
    var cap = body.querySelector('tr.epc-part-type-caption[data-section="' + kind + '"]');
    if (!cap) return;
    var n = body.querySelectorAll('tr.epc-part-type-row--' + kind).length;
    cap.firstChild.textContent = (kind === 'genuine' ? 'Genuine (OE)' : 'Aftermarket') + ' (' + n + ')';
  }
  function appendProduct(p) {
    var key = offerKey(p);
    if (seen[key]) return;
    seen[key] = 1;
    var empty = body.querySelector('tr[data-empty="1"]');
    if (empty) empty.remove();
    var kind = isGenuine(p.manufacturer) ? 'genuine' : 'aftermarket';
    var cap = ensureSection(kind);
    var tr = document.createElement('tr');
    tr.className = 'epc-part-type-row--' + kind;
    tr.setAttribute('data-offer-key', key);
    var show = p.articleShow || p.article || '';
    var search = '/storefront/search-app?article=' + encodeURIComponent(show) + '&brand=' + encodeURIComponent(p.manufacturer || '');
    var exist = Number(p.exist || 0);
    var mask = '**';
    var avail = pricesVisible ? String(exist) : mask;
    var term = pricesVisible ? esc(p.timeToExe || p.time_to_exe || '—') : mask;
    var price = pricesVisible ? Number(p.price || 0).toFixed(2) : mask;
    var storage = pricesVisible ? esc(p.storage || '—') : mask;
    var plist = pricesVisible ? esc(p.priceList || p.price_list || '—') : mask;
    tr.innerHTML =
      '<td><strong>' + esc(p.manufacturer || '') + '</strong></td>' +
      '<td>' + esc(show) + '</td>' +
      '<td>' + esc(p.name || '—') + '</td>' +
      '<td class="' + (pricesVisible && exist > 0 ? 'epc-stock-ok' : 'epc-stock-out') + '">' + avail + '</td>' +
      '<td>' + term + '</td>' +
      '<td class="' + (pricesVisible ? '' : 'epc-sf-price-mask') + '">' + price + '</td>' +
      '<td>' + storage + '</td>' +
      '<td>' + plist + '</td>' +
      '<td><a href="' + search + '">Open</a> · <a href="/storefront/quotes-app">Quote</a> · <a href="/storefront/cart-app">Cart</a></td>';
    var insertBefore = null;
    var rows = body.querySelectorAll('tr.epc-part-type-row--' + kind);
    if (rows.length) {
      insertBefore = rows[rows.length - 1].nextSibling;
      body.insertBefore(tr, insertBefore);
    } else {
      body.insertBefore(tr, cap.nextSibling);
    }
    bumpCaption(kind);
  }
  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]);
    });
  }
  function buildQuery(bunch) {
    var q = {
      article: article,
      searsch_str: article,
      manufacturer: brand,
      manufacturers: [],
      analogs: []
    };
    if (Number(bunch.protocolVersion || bunch.protocol_version || 0) === 3) {
      q.office_storage_bunches = (bunch.nestedBunches || bunch.nested_bunches || []).map(function (n) {
        return { office_id: n.officeId || n.office_id || 0, storage_id: n.storageId || n.storage_id || 0 };
      });
    }
    return JSON.stringify(q);
  }
  function pollOne(bunch) {
    var fd = new FormData();
    fd.append('article', article);
    fd.append('brand', brand);
    fd.append('office_id', String(bunch.officeId != null ? bunch.officeId : bunch.office_id || 0));
    fd.append('storage_id', String(bunch.storageId != null ? bunch.storageId : bunch.storage_id || 0));
    fd.append('query', buildQuery(bunch));
    return fetch('/storefront/products-of-bunch', { method: 'POST', body: fd, credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data && data.prices_visible === false) {
          pricesVisible = false;
          if (table) table.setAttribute('data-prices-visible', '0');
        }
        var products = (data && data.products) || [];
        products.forEach(appendProduct);
      })
      .catch(function () { /* keep warehouse rows */ });
  }
  function finishPoll(total) {
    if (progress) {
      progress.hidden = false;
      progress.setAttribute('data-done', '1');
      if (!body.querySelector('tr.epc-part-type-row--genuine, tr.epc-part-type-row--aftermarket')) {
        var empty = body.querySelector('tr[data-empty="1"]');
        if (empty) {
          empty.querySelector('td').innerHTML =
            'No warehouse offers for <strong>' + esc(brand) + ' ' + esc(article) +
            '</strong> after polling ' + total + ' supplier bunch(es). Try another brand or article.';
        }
      }
    }
  }
  fetch('/storefront/search-bunches?article=' + encodeURIComponent(article) + '&brand=' + encodeURIComponent(brand), { credentials: 'same-origin' })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      var bunches = (data && data.bunches) || [];
      // PHP part_search always polls protocol-3 price aggregate even when maps are thin.
      if (!bunches.length) {
        bunches = [{ officeId: 0, storageId: 0, protocolVersion: 3, nestedBunches: [] }];
      }
      if (progress) { progress.hidden = false; }
      if (totalEl) totalEl.textContent = String(bunches.length);
      var done = 0;
      var chain = Promise.resolve();
      bunches.forEach(function (bunch) {
        chain = chain.then(function () {
          return pollOne(bunch).finally(function () {
            done += 1;
            if (countEl) countEl.textContent = String(done);
            if (done >= bunches.length) finishPoll(bunches.length);
          });
        });
      });
      return chain;
    })
    .catch(function () {
      // Last resort: direct protocol-3 poll (PHP ajax_getProductsOfBunch via ASP.NET).
      if (progress) { progress.hidden = false; }
      if (totalEl) totalEl.textContent = '1';
      return pollOne({ officeId: 0, storageId: 0, protocolVersion: 3, nestedBunches: [] })
        .finally(function () {
          if (countEl) countEl.textContent = '1';
          finishPoll(1);
        });
    });
})();
            </script>
        }
    }

    @if (!string.IsNullOrWhiteSpace(_brandInput) && (_crossRefs.Count > 0 || !_showBrandPicker))
    {
        <nav class="epc-sf-cross-refs" aria-label="Cross references and OE numbers">
            <h2>@_brandInput @_normalized — cross references &amp; OE numbers</h2>
            <p style="margin:0 0 10px;font-size:13px;color:#475569">Part number / article <strong>@_normalized</strong> interchanges with:</p>
            @if (_crossRefs.Count == 0)
            {
                <p style="margin:0;font-size:13px;color:#64748b;">No local cross references for this brand + article.</p>
            }
            else
            {
                <ul>
                    @foreach (var cross in _crossRefs)
                    {
                        var label = string.IsNullOrWhiteSpace(cross.Brand) ? cross.Article : $"{cross.Brand} {cross.Article}";
                        <li>
                            <a href="@BrandArticleHref(cross.Article, cross.Brand)">@label</a>
                            <span style="color:#64748b">(part number @cross.Article)</span>
                            @if (cross.InStock)
                            {
                                <span class="epc-avail-yes">In stock</span>
                            }
                            else
                            {
                                <span class="epc-avail-no">Not in stock</span>
                            }
                        </li>
                    }
                </ul>
            }
            @if (_crossStockRefs.Count > 0)
            {
                <div class="epc-sf-cross-stock">
                    <strong>In stock on warehouse price lists (@_crossStockRefs.Count)</strong>
                    <ul>
                        @foreach (var cross in _crossStockRefs)
                        {
                            <li>
                                <a href="@BrandArticleHref(cross.Article, cross.Brand)">@cross.Brand @cross.Article</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </nav>
    }

</PhpStorefrontDesktopChrome>

@code {
    private string _articleInput = "";
    private string _attrQuery = "";
    private string _brandInput = "";
    private string _mode = "";
    private string _heroTitle = "Part search";
    private string _heroSubtitle = "Search by article, choose a brand, then open warehouse prices.";
    private string _normalized = "";
    private bool _showBrandPicker;
    private IReadOnlyList<StorefrontArticleBrandDigest> _brands = [];
    private IReadOnlyList<StorefrontPartOfferDigest> _rows = [];
    private IReadOnlyList<StorefrontPartOfferDigest> _genuineRows = [];
    private IReadOnlyList<StorefrontPartOfferDigest> _aftermarketRows = [];
    private HashSet<string> _genuineKeys = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<StorefrontCrossRefDigest> _crossRefs = [];
    private IReadOnlyList<StorefrontCrossRefDigest> _crossStockRefs = [];
    private string _source = "n/a";
    private string _message = "";
    private bool _pricesVisible = true;
    private string _accessState = "ok";
    private string _loginCtaHtml = string.Empty;

    private Microsoft.AspNetCore.Components.MarkupString JsonArticle =>
        (Microsoft.AspNetCore.Components.MarkupString)System.Text.Json.JsonSerializer.Serialize(_normalized);
    private Microsoft.AspNetCore.Components.MarkupString JsonBrand =>
        (Microsoft.AspNetCore.Components.MarkupString)System.Text.Json.JsonSerializer.Serialize(_brandInput);
    private Microsoft.AspNetCore.Components.MarkupString JsonGenuine
    {
        get
        {
            var map = _genuineKeys.ToDictionary(k => k, _ => true, StringComparer.OrdinalIgnoreCase);
            return (Microsoft.AspNetCore.Components.MarkupString)System.Text.Json.JsonSerializer.Serialize(map);
        }
    }

    /// <summary>PHP <c>$initial_position_search = 0</c> on CHPU brand/warehouse results — header search only.</summary>
    private bool _hideInPageSearch =>
        !string.IsNullOrWhiteSpace(_articleInput)
        && !string.IsNullOrWhiteSpace(_brandInput)
        && _mode is not ("attr" or "vin" or "engine" or "car");

    /// <summary>PHP nero title: <c>Pricing and availability for {BRAND} {ARTICLE} - eParts Cart</c>.</summary>
    private string PageTitleText
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_brandInput) && !string.IsNullOrWhiteSpace(_normalized))
            {
                return $"Pricing and availability for {_brandInput.ToUpperInvariant()} {_normalized} - eParts Cart (Autoparts)";
            }

            if (!string.IsNullOrWhiteSpace(_normalized))
            {
                return $"Part search {_normalized} · eParts Cart";
            }

            return "Part search · eParts Cart";
        }
    }

    private string SearchFormAction => _mode switch
    {
        "attr" => StorefrontSurfaceLinks.WarehouseSearch,
        "vin" => StorefrontSurfaceLinks.LaximoVin,
        "engine" or "car" => StorefrontSurfaceLinks.VehicleCatalog,
        _ => StorefrontSurfaceLinks.PartSearch
    };

    [Parameter]
    public string? PathBrand { get; set; }

    [Parameter]
    public string? PathArticle { get; set; }

    [SupplyParameterFromQuery(Name = "article")]
    public string? ArticleQuery { get; set; }

    /// <summary>Preferred ASP.NET query param (user-facing brand/article format).</summary>
    [SupplyParameterFromQuery(Name = "brand")]
    public string? BrandQuery { get; set; }

    /// <summary>PHP legacy typo param — still accepted for parity with part_search.</summary>
    [SupplyParameterFromQuery(Name = "brend")]
    public string? BrendQuery { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? AttrQuery { get; set; }

    [SupplyParameterFromQuery(Name = "mode")]
    public string? ModeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "identString")]
    public string? VinQuery { get; set; }

    [SupplyParameterFromQuery(Name = "engine")]
    public string? EngineQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Http.HttpContext is not null)
        {
            var access = await PriceAccess.ResolveAsync(Http.HttpContext);
            _pricesVisible = access.PricesVisible;
            _accessState = access.StateToken;
            _loginCtaHtml = access.LoginCtaHtml;
        }

        if (Navigation.Uri.Contains("warehouse-search", StringComparison.OrdinalIgnoreCase))
        {
            _mode = "attr";
        }

        _mode = string.IsNullOrWhiteSpace(_mode)
            ? (ModeQuery ?? "").Trim().ToLowerInvariant()
            : _mode;
        _attrQuery = AttrQuery?.Trim() ?? "";

        // CHPU /parts/{brand}/{article} → brand+article result (PHP prices_by_article_and_manufacturer).
        var pathBrand = DecodePathSegment(PathBrand);
        var pathArticle = DecodePathSegment(PathArticle);
        if (!string.IsNullOrWhiteSpace(pathArticle)
            && !string.Equals(pathBrand, "brands", StringComparison.OrdinalIgnoreCase))
        {
            _articleInput = pathArticle;
            _brandInput = pathBrand;
        }
        else
        {
            _articleInput = ArticleQuery?.Trim() ?? "";
            // Prefer brand=; fall back to PHP brend=.
            _brandInput = FirstNonEmpty(BrandQuery, BrendQuery);
            if (string.Equals(pathBrand, "brands", StringComparison.OrdinalIgnoreCase)
                && !string.IsNullOrWhiteSpace(pathArticle)
                && string.IsNullOrWhiteSpace(_articleInput))
            {
                _articleInput = pathArticle;
            }
        }

        if (string.IsNullOrWhiteSpace(_articleInput) && !string.IsNullOrWhiteSpace(VinQuery))
        {
            _articleInput = VinQuery.Trim();
        }
        else if (string.IsNullOrWhiteSpace(_articleInput) && !string.IsNullOrWhiteSpace(_attrQuery))
        {
            _articleInput = _attrQuery;
        }
        else if (string.IsNullOrWhiteSpace(_articleInput) && !string.IsNullOrWhiteSpace(EngineQuery))
        {
            _articleInput = EngineQuery.Trim();
        }

        _heroTitle = _mode switch
        {
            "attr" => "Warehouse / more info",
            "vin" => "VIN / Frame search",
            "engine" => "Engine code search",
            "car" => "Vehicle catalog",
            "name" => "Search by name",
            _ => string.IsNullOrWhiteSpace(_brandInput) ? "Part search" : $"{_brandInput.ToUpperInvariant()} {_articleInput.ToUpperInvariant()}"
        };
        _heroSubtitle = _mode switch
        {
            "attr" => "Search product attributes across warehouse offers (engine, size, country, cross ref).",
            "vin" => "Look up parts by VIN / Frame — open the dedicated VIN app for Laximo decode trees.",
            "engine" => "Look up parts by engine code across warehouse offers.",
            "car" => "Browse by vehicle — open the vehicle catalog app for year/make/model.",
            _ => string.IsNullOrWhiteSpace(_brandInput)
                ? "Select a manufacturer after searching by article (PHP brand picker parity)."
                : "Warehouse offers and cross references for the selected brand + article."
        };

        // Dedicated apps own VIN / vehicle-tree UX when PreferAspNetApps is on.
        if (_mode is "vin")
        {
            var vin = FirstNonEmpty(VinQuery, _articleInput);
            Navigation.NavigateTo(StorefrontSurfaceLinks.ForVin(vin), replace: true);
            return;
        }

        if (_mode is "car" or "engine")
        {
            Navigation.NavigateTo(StorefrontSurfaceLinks.VehicleCatalog, replace: true);
            return;
        }

        if (string.IsNullOrWhiteSpace(_articleInput))
        {
            return;
        }

        // PHP canonical result URL is CHPU /en/parts/{BRAND}/{ARTICLE}.
        // Keep that sticky: query-param search-app remaps into CHPU; CHPU loads digests in place
        // (never bounce CHPU → search-app — that made two different live results).
        var onChpuBrandArticle = !string.IsNullOrWhiteSpace(PathArticle)
            && !string.IsNullOrWhiteSpace(PathBrand)
            && !string.Equals(PathBrand, "brands", StringComparison.OrdinalIgnoreCase);
        if (!onChpuBrandArticle
            && !string.IsNullOrWhiteSpace(_articleInput)
            && !string.IsNullOrWhiteSpace(_brandInput)
            && _mode is not ("attr" or "vin" or "engine" or "car"))
        {
            Navigation.NavigateTo(BrandArticleHref(_articleInput, _brandInput), replace: true);
            return;
        }

        if (string.IsNullOrWhiteSpace(_brandInput))
        {
            var brandsResult = await Dashboards.ListStorefrontArticleBrandsAsync(_articleInput, 100);
            _normalized = brandsResult.Article;
            _brands = brandsResult.Brands;
            _showBrandPicker = true;
            _source = brandsResult.Source;
            _message = brandsResult.Message;

            // PHP: single manufacturer → open prices directly (SQL or php-chpu bridge).
            if (_brands.Count == 1
                && (_source is "database" or "php-chpu"))
            {
                Navigation.NavigateTo(BrandArticleHref(_normalized, _brands[0].Brand), forceLoad: true);
            }

            return;
        }

        var genuine = await Dashboards.ListStorefrontGenuineBrandsAsync();
        _genuineKeys = new HashSet<string>(genuine.Brands, StringComparer.OrdinalIgnoreCase);

        var result = await Dashboards.SearchStorefrontPartsAsync(_articleInput, _brandInput, 100);
        _normalized = result.Article;
        _rows = _pricesVisible ? result.Rows : PriceAccess.RedactOffers(result.Rows);
        _source = result.Source;
        _message = result.Message;
        _showBrandPicker = false;
        SplitOfferRows(_rows);

        var crossResult = await Dashboards.ListStorefrontCrossRefsAsync(_articleInput, _brandInput, 80);
        _crossRefs = crossResult.Rows;
        _crossStockRefs = crossResult.Rows.Where(static r => r.InStock).ToList();
    }

    private void SplitOfferRows(IReadOnlyList<StorefrontPartOfferDigest> rows)
    {
        var genuine = new List<StorefrontPartOfferDigest>();
        var aftermarket = new List<StorefrontPartOfferDigest>();
        foreach (var row in rows)
        {
            if (IsGenuineManufacturer(row.Manufacturer))
            {
                genuine.Add(row);
            }
            else
            {
                aftermarket.Add(row);
            }
        }

        _genuineRows = genuine;
        _aftermarketRows = aftermarket;
    }

    private bool IsGenuineManufacturer(string? brand)
    {
        if (string.IsNullOrWhiteSpace(brand) || _genuineKeys.Count == 0)
        {
            return false;
        }

        return _genuineKeys.Contains(brand.Trim().ToUpperInvariant());
    }

    private RenderFragment OfferRow(StorefrontPartOfferDigest row, string kind) => __builder =>
    {
        var show = string.IsNullOrWhiteSpace(row.ArticleShow) ? row.Article : row.ArticleShow;
        var term = string.IsNullOrWhiteSpace(row.TimeToExe) ? "—" : row.TimeToExe;
        var openHref = BrandArticleHref(show, row.Manufacturer);
        var key = string.Join('|',
            (row.Manufacturer ?? "").Trim().ToUpperInvariant(),
            row.Article ?? "",
            row.Storage ?? "",
            row.Price.ToString(CultureInfo.InvariantCulture));
        var mask = StorefrontPriceAccess.SensitiveMask;
        <tr class="@($"epc-part-type-row--{kind}")" data-offer-key="@key">
            <td><strong>@row.Manufacturer</strong></td>
            <td>@show</td>
            <td>@(string.IsNullOrWhiteSpace(row.Name) ? "—" : row.Name)</td>
            @if (_pricesVisible)
            {
                <td class="@(row.Exist > 0 ? "epc-stock-ok" : "epc-stock-out")">@(row.Exist > 0 ? row.Exist.ToString(CultureInfo.InvariantCulture) : "0")</td>
                <td>@term</td>
                <td>@row.Price.ToString("N2", CultureInfo.InvariantCulture)</td>
                <td>@(string.IsNullOrWhiteSpace(row.Storage) ? "—" : row.Storage)</td>
                <td>@(string.IsNullOrWhiteSpace(row.PriceList) ? "—" : row.PriceList)</td>
            }
            else
            {
                <td class="epc-sf-price-mask">@mask</td>
                <td class="epc-sf-price-mask">@mask</td>
                <td class="epc-sf-price-mask">@mask</td>
                <td class="epc-sf-price-mask">@mask</td>
                <td class="epc-sf-price-mask">@mask</td>
            }
            <td>
                <a href="@openHref" title="ASP.NET search">Open</a>
                ·
                <a href="@StorefrontSurfaceLinks.Quotes" title="Quotes app">Quote</a>
                ·
                <a href="@StorefrontSurfaceLinks.Cart" title="Cart app">Cart</a>
            </td>
        </tr>
    };

    /// <summary>PHP CHPU <c>/en/parts/{BRAND}/{ARTICLE}</c> — ASP.NET owns the same URL.</summary>
    private static string BrandArticleHref(string article, string? brand)
    {
        var art = (article ?? string.Empty).Trim();
        var br = (brand ?? string.Empty).Trim();
        if (br.Length > 0 && art.Length > 0)
        {
            return "/en/parts/"
                   + Uri.EscapeDataString(br.ToUpperInvariant())
                   + "/"
                   + Uri.EscapeDataString(art);
        }

        return ArticleOnlyHref(art);
    }

    /// <summary>PHP brand picker <c>/en/parts/brands/{ARTICLE}</c>.</summary>
    private static string ArticleOnlyHref(string article)
    {
        var art = (article ?? string.Empty).Trim();
        if (art.Length == 0)
        {
            return "/storefront/search-app";
        }

        return "/en/parts/brands/" + Uri.EscapeDataString(art);
    }

    private static string FirstNonEmpty(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value.Trim();
            }
        }

        return string.Empty;
    }

    private static string DecodePathSegment(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        try
        {
            return Uri.UnescapeDataString(value.Replace('+', ' ')).Trim();
        }
        catch (UriFormatException)
        {
            return value.Trim();
        }
    }
}
