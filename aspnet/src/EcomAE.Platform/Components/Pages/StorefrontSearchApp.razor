            // Client loadAspNetCrossSearch fills the badge / list.
        }

        // PHP part_search: Spec splash + Photos gallery from CP sku_media (UMAPI article fallback).
        try
        {
            using var mediaCts = new CancellationTokenSource(TimeSpan.FromMilliseconds(1800));
            var media = await SkuMedia.LookupAsync(_brandInput, _normalized, mediaCts.Token);
            ApplySkuMedia(media);
        }
        catch (OperationCanceledException)
        {
            // Client can still fetch /storefront/sku-media.
        }

        ApplyChpuSeo();
    }

    private void ApplySkuMedia(StorefrontSkuMediaLookupResult media)
    {
        _skuHasPhotos = media.Photos.Count > 0;
        _skuHasSpecs = media.Specs.Count > 0;
        _skuPhotosHtml = _skuHasPhotos ? RenderSkuPhotosHtml(media) : "";
        _skuSpecsHtml = _skuHasSpecs ? RenderSkuSpecsHtml(media.Specs) : "";
    }

    private static string RenderSkuSpecsHtml(IReadOnlyList<StorefrontSkuMediaSpecGroup> groups)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<div class=\"epc-sku-storefront__specs\">");
        foreach (var g in groups)
        {
            sb.Append("<section class=\"epc-sku-storefront__group\">");
            sb.Append("<h3><i class=\"fa ").Append(System.Net.WebUtility.HtmlEncode(g.Icon)).Append("\"></i> ")
                .Append(System.Net.WebUtility.HtmlEncode(g.Name)).Append("</h3><table><tbody>");
            foreach (var row in g.Rows)
            {
                sb.Append("<tr><th scope=\"row\">").Append(System.Net.WebUtility.HtmlEncode(row.Label))
                    .Append("</th><td>").Append(System.Net.WebUtility.HtmlEncode(row.Value)).Append("</td></tr>");
            }

            sb.Append("</tbody></table></section>");
        }

        sb.Append("</div>");
        return sb.ToString();
    }

