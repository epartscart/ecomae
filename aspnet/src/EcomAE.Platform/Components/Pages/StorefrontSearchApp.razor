    /// <summary>PHP CHPU <c>/en/parts/{BRAND}/{ARTICLE}</c> — ASP.NET owns the same URL.</summary>
    private static string BrandArticleHref(string article, string? brand)
    {
        var art = (article ?? string.Empty).Trim();
        var br = (brand ?? string.Empty).Trim();
        if (br.Length > 0 && art.Length > 0)
        {
            return "/en/parts/"
                   + Uri.EscapeDataString(br.ToUpperInvariant())
                   + "/"
                   + Uri.EscapeDataString(art);
        }

        return ArticleOnlyHref(art);
    }

    /// <summary>PHP brand picker <c>/en/parts/brands/{ARTICLE}</c>.</summary>
    private static string ArticleOnlyHref(string article)
    {
        var art = (article ?? string.Empty).Trim();
        if (art.Length == 0)
        {
            return "/storefront/search-app";
        }

        return "/en/parts/brands/" + Uri.EscapeDataString(art);
    }

    private static string FirstNonEmpty(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value.Trim();
            }
        }

        return string.Empty;
    }

    private static string DecodePathSegment(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        try
        {
            return Uri.UnescapeDataString(value.Replace('+', ' ')).Trim();
        }
        catch (UriFormatException)
        {
            return value.Trim();
        }
    }
}
