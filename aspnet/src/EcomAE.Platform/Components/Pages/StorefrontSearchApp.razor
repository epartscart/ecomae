@page "/storefront/search-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards

<PageTitle>Part search · eParts Cart</PageTitle>
<PhpChromeStyles Surface="storefront" />
<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<PhpStorefrontDesktopChrome>
    <style>
        .epc-sf-search-hero {
            margin-bottom:1rem; padding:1.15rem 1.25rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#111 0%,#3f0d0d 55%,#7f1d1d 100%);
        }
        .epc-sf-search-hero h1 { margin:.2rem 0 .35rem; font-size:clamp(1.4rem,3vw,1.95rem); }
        .epc-sf-search-hero p { margin:0; color:#fecaca; max-width:38rem; font-size:.92rem; line-height:1.45; }
        .epc-sf-search-form { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.9rem; }
        .epc-sf-search-form input {
            flex:1; min-width:180px; padding:.6rem .75rem; border:0; border-radius:.4rem; font-size:.95rem;
        }
        .epc-sf-search-form button {
            padding:.6rem .95rem; border:0; border-radius:.4rem; background:#dc2626; color:#fff; font-weight:700; cursor:pointer;
        }
        .epc-sf-search-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.75rem; }
        .epc-sf-search-cta a {
            display:inline-flex; padding:.45rem .75rem; border-radius:.4rem; font-weight:700; font-size:.8rem;
            text-decoration:none; color:#fff; border:1px solid rgba(255,255,255,.35);
        }
        .epc-sf-search-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-sf-search-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-sf-search-kpi strong { display:block; font-size:1.35rem; font-variant-numeric:tabular-nums; }
        .epc-sf-search-kpi span { color:#64748b; font-size:.78rem; }
        .epc-sf-search-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-sf-search-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-sf-search-table th, .epc-sf-search-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-sf-search-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-sf-search-table a { color:#b91c1c; font-weight:700; text-decoration:none; }
        .epc-sf-search-note { margin-top:1rem; padding:.75rem .9rem; background:#fff8e8; border:1px solid #f1d49a; border-radius:.45rem; color:#7a4e00; font-size:.86rem; }
        @@media (max-width:900px){ .epc-sf-search-kpis{grid-template-columns:1fr;} }
    </style>

    <section class="epc-sf-search-hero">
        <img src="@LegacyPresentationAssets.EpartsCartMarkUrl" alt="eparts" style="height:28px;filter:brightness(1.1)" />
        <h1>Part search</h1>
        <p>Batch 4 read-only warehouse offers under modex chrome. Full PHP part_search tabs, VIN, CHPU product pages, and cart/checkout stay on epartscart.com.</p>
        <form class="epc-sf-search-form" method="get" action="/storefront/search-app">
            <input type="search" name="article" value="@_articleInput" placeholder="Part number or OE code" aria-label="Part number" />
            <button type="submit">Search</button>
        </form>
        <div class="epc-sf-search-cta">
            <a href="@PhpPartSearchHref(_normalized)">Open full PHP search</a>
            <a href="/storefront/app">Storefront preview</a>
            <a href="https://epartscart.com/">Live storefront</a>
        </div>
    </section>

    <div class="epc-sf-search-kpis" aria-label="Search KPIs">
        <div class="epc-sf-search-kpi"><strong>@(_normalized.Length == 0 ? "—" : _normalized)</strong><span>Normalized article</span></div>
        <div class="epc-sf-search-kpi"><strong>@_rows.Count</strong><span>Offers shown</span></div>
        <div class="epc-sf-search-kpi"><strong>@_source</strong><span>Source</span></div>
    </div>

    <div class="epc-sf-search-table-wrap">
        <table class="epc-sf-search-table">
            <thead>
                <tr>
                    <th>Brand</th>
                    <th>Article</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Storage</th>
                    <th>Price list</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (string.IsNullOrWhiteSpace(_normalized))
                {
                    <tr><td colspan="8">Enter a part number above to load warehouse offers.</td></tr>
                }
                else if (_rows.Count == 0)
                {
                    <tr><td colspan="8">No offers for <strong>@_normalized</strong> (@_source). @_message Open PHP search for full supplier tabs.</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        var show = string.IsNullOrWhiteSpace(row.ArticleShow) ? row.Article : row.ArticleShow;
                        var phpHref = PhpPartSearchHref(_normalized, row.Manufacturer);
                        <tr>
                            <td><strong>@row.Manufacturer</strong></td>
                            <td>@show</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Name) ? "—" : row.Name)</td>
                            <td>@row.Price.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@row.Exist</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Storage) ? "—" : row.Storage)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.PriceList) ? "—" : row.PriceList)</td>
                            <td><a href="@phpHref">Open in PHP</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-sf-search-note">
        Read-only preview · SQL mirrors pyapi <code>/pyapi/v1/search</code>.
        Live commerce UX remains <a href="https://epartscart.com/shop/part_search">epartscart.com/shop/part_search</a>.
        Not a broad storefront or <code>/</code> cutover.
    </div>
</PhpStorefrontDesktopChrome>

@code {
    private string _articleInput = "";
    private string _normalized = "";
    private IReadOnlyList<StorefrontPartOfferDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    [SupplyParameterFromQuery(Name = "article")]
    public string? ArticleQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _articleInput = ArticleQuery?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(_articleInput))
        {
            return;
        }

        var result = await Dashboards.SearchStorefrontPartsAsync(_articleInput, 100);
        _normalized = result.Article;
        _rows = result.Rows;
        _source = result.Source;
        _message = result.Message;
    }

    private static string PhpPartSearchHref(string article, string? brand = null)
    {
        var href = "https://epartscart.com/shop/part_search";
        if (string.IsNullOrWhiteSpace(article))
        {
            return href;
        }

        href += "?article=" + Uri.EscapeDataString(article);
        if (!string.IsNullOrWhiteSpace(brand))
        {
            href += "&brend=" + Uri.EscapeDataString(brand);
        }

        return href;
    }
}
