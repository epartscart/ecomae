    bumpCaption(kind);
  }
  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]);
    });
  }
  function buildQuery(bunch) {
    var q = {
      article: article,
      searsch_str: article,
      manufacturer: brand,
      manufacturers: [],
      analogs: []
    };
    if (Number(bunch.protocolVersion || bunch.protocol_version || 0) === 3) {
      q.office_storage_bunches = (bunch.nestedBunches || bunch.nested_bunches || []).map(function (n) {
        return { office_id: n.officeId || n.office_id || 0, storage_id: n.storageId || n.storage_id || 0 };
      });
