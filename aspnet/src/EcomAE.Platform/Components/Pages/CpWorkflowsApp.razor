@page "/cp/workflows-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Workflows · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-wf-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-wf-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-wf-hero p { margin:0; color:rgba(255,255,255,.85); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-wf-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-wf-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#312e81; background:#a5b4fc;
        }
        .epc-wf-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-wf-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-wf-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-wf-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-wf-kpi span { color:#64748b; font-size:.78rem; }
        .epc-wf-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-wf-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-wf-table th, .epc-wf-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-wf-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-wf-note { margin-top:1rem; padding:.75rem .9rem; background:#eef2ff; border:1px solid #a5b4fc; border-radius:.45rem; color:#312e81; font-size:.86rem; }
        @@media (max-width:900px){ .epc-wf-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-wf-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Workflows</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-wf-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
        </div>
    </section>

    <div class="epc-wf-kpis" aria-label="Workflows stats">
        <div class="epc-wf-kpi"><strong>@_summary.WorkflowCount.ToString(CultureInfo.InvariantCulture)</strong><span>Workflows</span></div>
        <div class="epc-wf-kpi"><strong>@_summary.ActiveWorkflows.ToString(CultureInfo.InvariantCulture)</strong><span>Active</span></div>
        <div class="epc-wf-kpi"><strong>@_summary.RunCount.ToString(CultureInfo.InvariantCulture)</strong><span>Runs</span></div>
        <div class="epc-wf-kpi"><strong>@_summary.FailedRuns.ToString(CultureInfo.InvariantCulture)</strong><span>Failed runs</span></div>
    </div>

    <div class="epc-wf-table-wrap">
        <table class="epc-wf-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Site</th>
                    <th>Name</th>
                    <th>Trigger</th>
                    <th>Active</th>
                    <th>Version</th>
                    <th>Runs</th>
                    <th>Last status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_workflows.Count == 0)
                {
                    <tr><td colspan="9">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _workflows)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.SiteKey) ? row.SiteKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.TriggerType) ? row.TriggerType : "—")</td>
                            <td>@(row.Active ? "yes" : "no")</td>
                            <td>@row.Version.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.RunCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.LastRunStatus) ? row.LastRunStatus : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=setup&tab=workflow_automation&epc_erp_shell=1";
    private bool _isAdmin;
    private CpWorkflowsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpWorkflowDigest> _workflows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpWorkflowsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _workflows = result.Workflows;
        _source = result.Source;
        _message = result.Message;
    }
}
