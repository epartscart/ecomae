@page "/cp/workflows-app"
@page "/erp/workflows-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Workflows · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Workflows
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Disable a named automation here. Workflow editor stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/workflows-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_summary.WorkflowCount.ToString(CultureInfo.InvariantCulture) workflows · @_summary.ActiveWorkflows.ToString(CultureInfo.InvariantCulture) active · @_summary.RunCount.ToString(CultureInfo.InvariantCulture) runs · @_summary.FailedRuns.ToString(CultureInfo.InvariantCulture) failed runs.</p>

    <div class="table-responsive">
        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Site</th>
                    <th>Name</th>
                    <th>Trigger</th>
                    <th>Active</th>
                    <th>Version</th>
                    <th>Runs</th>
                    <th>Last status</th>
                </tr>
            </thead>
            <tbody>
                @if (_workflows.Count == 0)
                {
                    <tr><td colspan="8">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _workflows)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.SiteKey) ? row.SiteKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.TriggerType) ? row.TriggerType : "—")</td>
                            <td>@(row.Active ? "yes" : "no")</td>
                            <td>@row.Version.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.RunCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.LastRunStatus) ? row.LastRunStatus : "—")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

<form method="post" action="/erp/automation/deactivate" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/workflows-app" />
            <label>Automation
                <select name="id">
                    <option value="order_to_erp">order_to_erp</option>
                    <option value="period_close">period_close</option>
                    <option value="year_end_close">year_end_close</option>
                    <option value="bank_recon">bank_recon</option>
                    <option value="collections_dunning">collections_dunning</option>
                    <option value="report_scheduler">report_scheduler</option>
                    <option value="vat_reminder">vat_reminder</option>
                    <option value="gl_auto_post">gl_auto_post</option>
                    <option value="payment_reminder">payment_reminder</option>
                    <option value="depreciation_run">depreciation_run</option>
                    <option value="po_approval">po_approval</option>
                    <option value="invoice_autosend">invoice_autosend</option>
                    <option value="low_stock_alert">low_stock_alert</option>
                    <option value="employee_onboarding">employee_onboarding</option>
                    <option value="daily_sales_summary">daily_sales_summary</option>
                    <option value="aml_alert">aml_alert</option>
                    <option value="process_flow_routing">process_flow_routing</option>
                    <option value="three_way_match">three_way_match</option>
                    <option value="subscription_billing">subscription_billing</option>
                    <option value="rma_warranty">rma_warranty</option>
                    <option value="credit_check">credit_check</option>
                    <option value="goods_receipt_notify">goods_receipt_notify</option>
                </select>
            </label>
            <button type="submit">Disable automation</button>
        </form>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=setup&tab=workflow_automation&epc_erp_shell=1";
    private bool _isAdmin;
    private CpWorkflowsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpWorkflowDigest> _workflows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpWorkflowsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _workflows = result.Workflows;
        _source = result.Source;
        _message = result.Message;
    }
}
