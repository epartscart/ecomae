@page "/erp/workflows-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
<PageTitle>@(_isErpHost ? "Automation Centre · ERP" : "Workflows · Control Panel") · eParts Cart</PageTitle>
<PhpChromeStyles Surface="@(_isErpHost ? "erp" : "cp")" />
<HeadContent>
<style>
.epc-auto-hero{background:linear-gradient(135deg,#0b3d4a 0%,#0e7490 48%,#22d3ee 100%);color:#fff;border-radius:14px;padding:22px 24px;margin-bottom:16px;position:relative;overflow:hidden}
.epc-auto-hero::after{content:"";position:absolute;right:-40px;top:-40px;width:220px;height:220px;border-radius:50%;background:rgba(255,255,255,.08)}
.epc-auto-hero h3{margin:0 0 6px;font-size:20px;font-weight:800;color:#fff}
.epc-auto-hero p{margin:0;max-width:720px;opacity:.95}
.epc-auto-kpis{display:flex;flex-wrap:wrap;gap:10px;margin:14px 0 18px}
.epc-auto-kpis .kpi{flex:1 1 120px;background:#fff;border:1px solid #dbeafe;border-radius:12px;padding:12px 14px;box-shadow:0 1px 3px rgba(14,116,144,.08)}
.epc-auto-kpis .kpi .lbl{font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:#64748b;font-weight:700}
.epc-auto-kpis .kpi .val{font-size:22px;font-weight:800;color:#0f172a;margin-top:2px}
.epc-auto-tabs{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px}
.epc-auto-tabs a{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;border:1px solid #e2e8f0;background:#fff;color:#334155;font-weight:600;font-size:12px;text-decoration:none}
.epc-auto-tabs a.active{background:linear-gradient(135deg,#0e7490,#22d3ee);color:#fff;border-color:transparent}
.epc-auto-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;margin-bottom:18px}
.epc-auto-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:14px 16px;display:flex;flex-direction:column;gap:8px;min-height:180px}
.epc-auto-card__head{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.epc-auto-card__title{margin:0;font-size:14px;font-weight:800;color:#0f172a}
.epc-auto-card__title i{color:#0e7490;margin-right:6px}
.epc-auto-card__desc{margin:0;font-size:12px;color:#64748b;line-height:1.45;flex:1}
.epc-auto-card__actions{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px}
.epc-auto-pipeline{display:flex;flex-wrap:wrap;align-items:center;gap:4px;margin:4px 0}
.epc-auto-pipeline__step{display:flex;align-items:center;gap:6px;background:linear-gradient(180deg,#f8fafc,#f1f5f9);border:1px solid #e2e8f0;border-left:3px solid var(--epc-step,#0ea5e9);border-radius:8px;padding:6px 8px;min-width:72px}
.epc-auto-pipeline__num{width:18px;height:18px;border-radius:50%;background:var(--epc-step,#0ea5e9);color:#fff;font-size:10px;font-weight:800;display:inline-flex;align-items:center;justify-content:center}
.epc-auto-pipeline__label{font-size:10px;font-weight:700;color:#334155;line-height:1.2}
.epc-auto-pipeline__arrow{color:#94a3b8;font-size:10px;padding:0 2px}
.epc-auto-canvas{background:#0b1220;border-radius:14px;padding:18px;margin-bottom:16px;overflow-x:auto}
.epc-auto-flow{display:flex;align-items:stretch;gap:0;min-width:max-content;padding:8px 4px}
.epc-auto-node{width:160px;background:#111827;border:1px solid #334155;border-radius:12px;padding:12px;color:#e2e8f0;box-shadow:0 8px 24px rgba(0,0,0,.35)}
.epc-auto-node--trigger{border-color:#22d3ee;background:linear-gradient(180deg,#083344,#0f172a)}
.epc-auto-node--action{border-color:#34d399}
.epc-auto-node__kind{font-size:9px;text-transform:uppercase;letter-spacing:.08em;opacity:.7;margin-bottom:4px}
.epc-auto-node__title{font-size:13px;font-weight:700;margin:0 0 4px}
.epc-auto-node__meta{font-size:11px;opacity:.75}
.epc-auto-connector{width:36px;display:flex;align-items:center;justify-content:center;color:#22d3ee;position:relative}
.epc-auto-connector::before{content:"";position:absolute;left:0;right:0;height:2px;background:linear-gradient(90deg,#22d3ee,#34d399);top:50%}
.epc-auto-connector i{position:relative;z-index:1;background:#0b1220;padding:2px}
.epc-auto-map{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;margin:12px 0}
.epc-auto-map__item{background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:10px 12px}
.epc-auto-map__item h5{margin:0 0 6px;font-size:12px;font-weight:800}
.epc-wf-table-wrap{background:#fff;border:1px solid #e2e8f0;border-radius:.55rem;overflow:auto}
.epc-wf-table{width:100%;border-collapse:collapse;font-size:.86rem}
.epc-wf-table th,.epc-wf-table td{padding:.55rem .7rem;border-bottom:1px solid #f1f5f9;text-align:left;white-space:nowrap}
.epc-wf-table th{background:#f8fafc;color:#475569;font-size:.75rem;text-transform:uppercase;letter-spacing:.03em}
.epc-auto-guide{margin:0 0 14px;padding:12px 14px;border:1px solid #dbe4ea;background:#fff;border-radius:12px}
.epc-auto-guide h3{margin:0 0 4px;font-size:15px;color:#0f172a}
.epc-auto-guide__lead{margin:0 0 10px;color:#475569}
.epc-auto-guide__steps{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0;padding:0}
.epc-auto-guide__steps li{flex:1 1 160px;border:1px solid #dbe4ea;border-top:3px solid #0e7490;background:#f8fafc;padding:8px 10px}
.epc-auto-guide__n{display:inline-block;width:18px;height:18px;border-radius:50%;background:#0e7490;color:#fff;font-size:11px;font-weight:700;line-height:18px;text-align:center;margin-right:4px}
.epc-auto-guide__steps strong{color:#0f172a}
.epc-auto-guide__steps p{margin:4px 0 0;font-size:12px;color:#475569}
.epc-auto-chain{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:12px 14px;margin:0 0 12px}
.epc-auto-chain h4{margin:0 0 4px;font-size:14px;color:#0f172a}
.epc-auto-chain>p{margin:0 0 8px;color:#475569;font-size:12px}
.epc-auto-off{margin-top:14px}
.epc-auto-off form[data-epc-inline="1"]{display:flex !important;flex-wrap:wrap;gap:8px;align-items:flex-end;width:auto !important;margin:0 !important;padding:0 !important;border:0 !important;background:transparent !important;box-shadow:none !important}
.epc-auto-off label{display:flex;flex-direction:column;gap:2px;margin:0;font-size:11px;font-weight:700;color:#475569}
</style>
</HeadContent>

<PhpErpDesktopChrome IsAdmin="_isAdmin">

    <div class="epc-auto-hero">
        <h3><i class="fa fa-magic"></i> Accounting &amp; Business Process Automation</h3>
        <p>This is the automation centre. It runs a chain when a document is saved or posted. The department workflow board is the human task list, and it stays on its own page.</p>
    </div>
    <section class="epc-auto-guide" aria-label="How automation runs">
        <h3>How a chain runs</h3>
        <p class="epc-auto-guide__lead">An event starts the chain. The centre checks the rule. The actions run in order. The last step opens the module that owns the document.</p>
        <ol class="epc-auto-guide__steps">
            <li><span class="epc-auto-guide__n">1</span><strong>Event</strong><p>An order, a receipt, a due date, or the end of a period.</p></li>
            <li><span class="epc-auto-guide__n">2</span><strong>Check</strong><p>Credit, amount, match, or the calendar.</p></li>
            <li><span class="epc-auto-guide__n">3</span><strong>Act</strong><p>Post, notify, hold, or route to the next person.</p></li>
            <li><span class="epc-auto-guide__n">4</span><strong>Open</strong><p>The module behind the last step shows the document.</p></li>
        </ol>
    </section>
    <section aria-label="Full system chains">
        @foreach (var chain in ErpAutomationCatalogue.SystemChains)
        {
            <div class="epc-auto-chain">
                <h4>@chain.Name</h4>
                <p>@chain.Purpose</p>
                <div class="epc-auto-pipeline" role="list">
                    @{ var steps = ChainItems(chain); }
                    @for (var i = 0; i < steps.Count; i++)
                    {
                        var item = steps[i];
                        if (i > 0)
                        {
                            <div class="epc-auto-pipeline__arrow" aria-hidden="true"><i class="fa fa-chevron-right"></i></div>
                        }
                        <a class="epc-auto-pipeline__step" role="listitem" href="@WithCompany(ErpAutomationCatalogue.OpenHref(item))" style="--epc-step:#0e7490;text-decoration:none">
                            <span class="epc-auto-pipeline__num">@((i + 1).ToString(CultureInfo.InvariantCulture))</span>
                            <span class="epc-auto-pipeline__label">@item.Name</span>
                        </a>
                    }
                </div>
            </div>
        }
    </section>
    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }

    <div class="epc-auto-kpis">
        <div class="kpi"><div class="lbl">Total</div><div class="val">@ErpAutomationCatalogue.All.Count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val" style="color:#059669">@_activeDefault.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Available</div><div class="val" style="color:#d97706">@_availableDefault.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Accounting</div><div class="val">@ErpAutomationCatalogue.Accounting.Count().ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Processes</div><div class="val">@ErpAutomationCatalogue.Processes.Count().ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Workflows</div><div class="val">@_summary.ActiveWorkflows.ToString(CultureInfo.InvariantCulture)/@_summary.WorkflowCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <nav class="epc-auto-tabs" aria-label="Automation views">
        <a class="@TabClass("hub")" href="@AutoHref("hub")"><i class="fa fa-th-large"></i> Hub</a>
        <a class="@TabClass("accounting")" href="@AutoHref("accounting")"><i class="fa fa-university"></i> Accounting</a>
        <a class="@TabClass("processes")" href="@AutoHref("processes")"><i class="fa fa-sitemap"></i> Business processes</a>
        <a class="@TabClass("builder")" href="@AutoHref("builder")"><i class="fa fa-cogs"></i> Workflow builder</a>
        <a class="@TabClass("runs")" href="@AutoHref("runs")"><i class="fa fa-history"></i> Run history</a>
    </nav>

    @if (_view is "hub" or "accounting")
    {
        <div class="ef-window">
            <div class="ef-title"><i class="fa fa-university"></i> Accounting automation</div>
            <div class="ef-body">
                <p class="text-muted" style="margin-top:0">Order-to-cash, period close, bank recon, collections, report schedules and GL posting — each with a visual pipeline.</p>
                <div class="epc-auto-grid">
                    @foreach (var autoItem in ErpAutomationCatalogue.Accounting)
                    {
                        @Card(autoItem, "blue")
                    }
                </div>
            </div>
        </div>
    }

    @if (_view is "hub" or "processes")
    {
        <div class="ef-window">
            <div class="ef-title"><i class="fa fa-sitemap"></i> Business process automation</div>
            <div class="ef-body">
                <p class="text-muted" style="margin-top:0">Approvals, inventory alerts, onboarding, AML, 3-way match, subscriptions, RMA.</p>
                <div class="epc-auto-grid">
                    @foreach (var autoItem in ErpAutomationCatalogue.Processes)
                    {
                        @Card(autoItem, "teal")
                    }
                </div>
            </div>
        </div>
        <div class="ef-window">
            <div class="ef-title"><i class="fa fa-magic"></i> Installable workflow templates</div>
            <div class="ef-body">
                <div class="epc-auto-map">
                    @foreach (var tplRow in ErpAutomationCatalogue.Templates)
                    {
                        <div class="epc-auto-map__item">
                            <h5>@tplRow.Name</h5>
                            <p class="text-muted" style="font-size:12px;margin:0 0 8px">@tplRow.Description</p>
                            <span class="label label-info">@tplRow.TriggerType</span>
                            <span class="label label-default">@tplRow.StepCount.ToString(CultureInfo.InvariantCulture) steps</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (_view == "builder")
    {
        <div class="ef-window">
            <div class="ef-title"><i class="fa fa-cogs"></i> Workflow — graphical builder</div>
            <div class="ef-body">
                <p class="text-muted">Each installed chain is a trigger followed by its actions. Open a node to work in that module.</p>
                <div class="epc-auto-canvas">
                    @foreach (var chain in ErpAutomationCatalogue.SystemChains)
                    {
                        <div class="epc-auto-flow" aria-label="@chain.Name">
                            @{ var steps = ChainItems(chain); }
                            @for (var i = 0; i < steps.Count; i++)
                            {
                                var item = steps[i];
                                if (i > 0)
                                {
                                    <div class="epc-auto-connector"><i class="fa fa-arrow-right"></i></div>
                                }
                                <a class="epc-auto-node @(i == 0 ? "epc-auto-node--trigger" : "epc-auto-node--action")" href="@WithCompany(ErpAutomationCatalogue.OpenHref(item))" style="text-decoration:none;color:inherit">
                                    <div class="epc-auto-node__kind">@(i == 0 ? "Trigger" : "Action")</div>
                                    <div class="epc-auto-node__title">@item.Name</div>
                                    <div class="epc-auto-node__meta">@chain.Name</div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (_opened is not null)
    {
        <div class="ef-window" style="margin-bottom:16px">
            <div class="ef-title">@OpenedCaption <a class="btn btn-xs btn-default" href="@_listHref">Close</a></div>
            <div class="ef-body">
                <dl class="epc-erp-facts">
                    <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                    <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Name) ? "—" : _opened.Name)</dd>
                    <dt>Site</dt><dd>@(string.IsNullOrWhiteSpace(_opened.SiteKey) ? "—" : _opened.SiteKey)</dd>
                    <dt>Trigger</dt><dd>@(string.IsNullOrWhiteSpace(_opened.TriggerType) ? "—" : _opened.TriggerType)</dd>
                    <dt>Active</dt><dd>@(_opened.Active ? "yes" : "no")</dd>
                    <dt>Version</dt><dd>@_opened.Version.ToString(CultureInfo.InvariantCulture)</dd>
                    <dt>Runs</dt><dd>@_opened.RunCount.ToString(CultureInfo.InvariantCulture)</dd>
                    <dt>Last status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.LastRunStatus) ? "—" : _opened.LastRunStatus)</dd>
                </dl>
                <p class="text-muted" style="margin:.85rem 0 0">trigger_config omitted. Tick / execute are not available on this page. This page does not invent a send.</p>
                @if (_isAdmin)
                {
                    <form method="post" action="/cp/workflows/write" class="well" style="margin:.85rem 0 0">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@ReturnHref" />
                        <input type="hidden" name="action" value="toggle" />
                        <input type="hidden" name="id" value="@_opened.Id.ToString(CultureInfo.InvariantCulture)" />
                        @if (_opened.Active)
                        {
                            <input type="hidden" name="active" value="0" />
                            <button type="submit" class="btn btn-default">Disable workflow</button>
                        }
                        else
                        {
                            <input type="hidden" name="active" value="1" />
                            <button type="submit" class="btn btn-default">Enable workflow</button>
                        }
                    </form>
                    <p class="help-block" style="margin:.75rem 0 0">Schema-ensure is not available on this page.</p>
                }
                @if (!string.IsNullOrWhiteSpace(_opened.DescriptionExcerpt))
                {
                    <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:.85rem 0 0">@_opened.DescriptionExcerpt</pre>
                    @if (_opened.DescriptionLen > _opened.DescriptionExcerpt.Length)
                    {
                        <p class="text-muted">Excerpt only (@_opened.DescriptionExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.DescriptionLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                    }
                }
                else
                {
                    <p class="text-muted" style="margin:.85rem 0 0">No description excerpt yet.</p>
                }
                @if (_openedSiblings.Count > 0)
                {
                    <p class="text-muted" style="margin:1rem 0 .4rem">Same-trigger siblings</p>
                    <div class="epc-wf-table-wrap">
                        <table class="epc-wf-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Trigger</th>
                                    <th>Active</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sib in _openedSiblings)
                                {
                                    <tr>
                                        <td>@(string.IsNullOrWhiteSpace(sib.Name) ? "—" : sib.Name)</td>
                                        <td>@(string.IsNullOrWhiteSpace(sib.TriggerType) ? "—" : sib.TriggerType)</td>
                                        <td>@(sib.Active ? "yes" : "no")</td>
                                        <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "workflow_id", sib.Id)">Open</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No same-trigger siblings yet.</p>
                }
            </div>
        </div>
    }

    @if (_view == "runs" || _view == "hub")
    {
        <div class="ef-window">
            <div class="ef-title"><i class="fa fa-history"></i> Workflows</div>
            <div class="ef-body">
                <div class="epc-wf-table-wrap">
                    <table class="epc-wf-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Site</th>
                                <th>Name</th>
                                <th>Trigger</th>
                                <th>Active</th>
                                <th>Version</th>
                                <th>Runs</th>
                                <th>Last status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_workflows.Count == 0)
                            {
                                <tr><td colspan="9">No records yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var row in _workflows)
                                {
                                    <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                        <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.SiteKey) ? row.SiteKey : "—")</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.TriggerType) ? row.TriggerType : "—")</td>
                                        <td>@(row.Active ? "yes" : "no")</td>
                                        <td>@row.Version.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@row.RunCount.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.LastRunStatus) ? row.LastRunStatus : "—")</td>
                                        <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "workflow_id", row.Id)">Open</a></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <section class="epc-auto-chain epc-auto-off">
        <h4>Turn an automation off</h4>
        <p>The chain stays in the catalogue. Turning it off stops it from running for this company.</p>
        <form method="post" action="/erp/automation/deactivate" data-epc-inline="1">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@ReturnHref" />
            <label>Automation
                <select name="id">
                    <option value="order_to_erp">order_to_erp</option>
                    <option value="period_close">period_close</option>
                    <option value="year_end_close">year_end_close</option>
                    <option value="bank_recon">bank_recon</option>
                    <option value="collections_dunning">collections_dunning</option>
                    <option value="report_scheduler">report_scheduler</option>
                    <option value="vat_reminder">vat_reminder</option>
                    <option value="gl_auto_post">gl_auto_post</option>
                    <option value="payment_reminder">payment_reminder</option>
                    <option value="depreciation_run">depreciation_run</option>
                    <option value="po_approval">po_approval</option>
                    <option value="invoice_autosend">invoice_autosend</option>
                    <option value="low_stock_alert">low_stock_alert</option>
                    <option value="employee_onboarding">employee_onboarding</option>
                    <option value="daily_sales_summary">daily_sales_summary</option>
                    <option value="aml_alert">aml_alert</option>
                    <option value="process_flow_routing">process_flow_routing</option>
                    <option value="three_way_match">three_way_match</option>
                    <option value="subscription_billing">subscription_billing</option>
                    <option value="rma_warranty">rma_warranty</option>
                    <option value="credit_check">credit_check</option>
                    <option value="goods_receipt_notify">goods_receipt_notify</option>
                </select>
            </label>
            <button type="submit" class="btn btn-sm btn-default">Disable automation</button>
        </form>
    </section>

</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private bool _isErpHost;
    private string _view = "hub";
    private string _basePath = "/erp/workflows-app";
    private CpWorkflowsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpWorkflowDigest> _workflows = [];
    private string _flashOk = "";
    private string _flashErr = "";
    private int _activeDefault;
    private int _availableDefault;
    private string _listHref = "/erp/workflows-app";
    private int _companyId;
    private long _openedId;
    private CpWorkflowDetail? _opened;
    private IReadOnlyList<CpWorkflowDigest> _openedSiblings = [];

    private string OpenedCaption =>
        !string.IsNullOrWhiteSpace(_opened?.Name)
            ? _opened.Name
            : (_openedId > 0 ? ("Workflow #" + _openedId.ToString(CultureInfo.InvariantCulture)) : "");

    private string ReturnHref =>
        _openedId > 0
            ? _listHref + "?workflow_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
            : _basePath;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var path = ctx.Request.Path.Value ?? "";
        _isErpHost = path.StartsWith("/erp", StringComparison.OrdinalIgnoreCase);
        _basePath = _isErpHost ? "/erp/workflows-app" : "/erp/workflows-app";
        _listHref = _basePath;
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "workflow_id");
        _companyId = ErpHostContext.ActiveCompanyIdFromQuery(ctx.Request) ?? 0;
        _view = (ctx.Request.Query["auto_view"].ToString() ?? "hub").Trim().ToLowerInvariant();
        if (_view is not ("hub" or "accounting" or "processes" or "builder" or "runs"))
        {
            _view = "hub";
        }
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _activeDefault = ErpAutomationCatalogue.All.Count(i => i.DefaultOn);
        _availableDefault = ErpAutomationCatalogue.All.Count - _activeDefault;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin) return;

        var result = await Dashboards.BuildCpWorkflowsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _workflows = result.Workflows;
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpWorkflowDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Workflow;
            _openedSiblings = detail.Siblings;
        }
    }

    private string AutoHref(string view) => WithCompany(_basePath + "?auto_view=" + Uri.EscapeDataString(view));

    private string WithCompany(string href)
    {
        if (_companyId <= 0 || href.Contains("company=", StringComparison.OrdinalIgnoreCase))
        {
            return href;
        }

        return href + (href.Contains('?', StringComparison.Ordinal) ? "&" : "?") + "company=" + _companyId.ToString(CultureInfo.InvariantCulture);
    }
    private string TabClass(string view) => string.Equals(_view, view, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    private static IReadOnlyList<ErpAutomationCatalogue.Item> ChainItems(ErpAutomationCatalogue.Chain chain)
    {
        var steps = new List<ErpAutomationCatalogue.Item>();
        foreach (var id in chain.ItemIds)
        {
            var item = ErpAutomationCatalogue.Find(id);
            if (item is not null)
            {
                steps.Add(item);
            }
        }

        return steps;
    }

    private RenderFragment Card(ErpAutomationCatalogue.Item autoItem, string tone) => __builder =>
    {
        var colors = tone == "teal" ? new[] { "#134e4a", "#0f766e", "#14b8a6" } : new[] { "#0c4a6e", "#0369a1", "#0ea5e9" };
        var status = autoItem.DefaultOn ? "active" : "available";
        var badge = autoItem.DefaultOn ? "success" : "warning";
        <div class="epc-auto-card" data-auto-id="@autoItem.Id">
            <div class="epc-auto-card__head">
                <h4 class="epc-auto-card__title"><i class="fa @autoItem.Icon"></i>@autoItem.Name</h4>
                <span class="label label-@badge">@status</span>
            </div>
            <p class="epc-auto-card__desc">@autoItem.Description</p>
            <div class="epc-auto-pipeline" role="list">
                @for (var i = 0; i < autoItem.Pipeline.Count; i++)
                {
                    var stepColor = colors[i % 3];
                    <div class="epc-auto-pipeline__step" role="listitem" style="--epc-step:@stepColor">
                        <span class="epc-auto-pipeline__num">@((i + 1).ToString(CultureInfo.InvariantCulture))</span>
                        <span class="epc-auto-pipeline__label">@autoItem.Pipeline[i]</span>
                    </div>
                    @if (i < autoItem.Pipeline.Count - 1)
                    {
                        <div class="epc-auto-pipeline__arrow" aria-hidden="true"><i class="fa fa-chevron-right"></i></div>
                    }
                }
            </div>
            <div class="epc-auto-card__actions">
                <a class="btn btn-default btn-xs" href="@WithCompany(ErpAutomationCatalogue.OpenHref(autoItem))"><i class="fa fa-external-link"></i> Open</a>
            </div>
        </div>
    };
}
