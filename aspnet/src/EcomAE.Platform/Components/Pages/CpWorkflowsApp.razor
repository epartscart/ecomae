@code {
    private bool _isAdmin;
    private bool _isErpHost;
    private string _view = "hub";
    private string _basePath = "/erp/workflows-app";
    private CpWorkflowsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpWorkflowDigest> _workflows = [];
    private string _flashOk = "";
    private string _flashErr = "";
    private int _activeDefault;
    private int _availableDefault;
    private string _listHref = "/erp/workflows-app";
    private int _companyId;
    private long _openedId;
    private CpWorkflowDetail? _opened;
    private IReadOnlyList<CpWorkflowDigest> _openedSiblings = [];

    private string OpenedCaption =>
        !string.IsNullOrWhiteSpace(_opened?.Name)
            ? _opened.Name
            : (_openedId > 0 ? ("Workflow #" + _openedId.ToString(CultureInfo.InvariantCulture)) : "");

    private string ReturnHref =>
        _openedId > 0
            ? _listHref + "?workflow_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
            : _basePath;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var path = ctx.Request.Path.Value ?? "";
        _isErpHost = path.StartsWith("/erp", StringComparison.OrdinalIgnoreCase);
        _basePath = _isErpHost ? "/erp/workflows-app" : "/erp/workflows-app";
        _listHref = _basePath;
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "workflow_id");
        _companyId = ErpHostContext.ActiveCompanyIdFromQuery(ctx.Request) ?? 0;
        _view = (ctx.Request.Query["auto_view"].ToString() ?? "hub").Trim().ToLowerInvariant();
        if (_view is not ("hub" or "accounting" or "processes" or "builder" or "runs"))
        {
            _view = "hub";
        }
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _activeDefault = ErpAutomationCatalogue.All.Count(i => i.DefaultOn);
        _availableDefault = ErpAutomationCatalogue.All.Count - _activeDefault;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin) return;

        var result = await Dashboards.BuildCpWorkflowsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _workflows = result.Workflows;
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpWorkflowDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Workflow;
            _openedSiblings = detail.Siblings;
        }
    }

    private string AutoHref(string view) => WithCompany(_basePath + "?auto_view=" + Uri.EscapeDataString(view));

    private string WithCompany(string href)
    {
        if (_companyId <= 0 || href.Contains("company=", StringComparison.OrdinalIgnoreCase))
        {
            return href;
        }

        return href + (href.Contains('?', StringComparison.Ordinal) ? "&" : "?") + "company=" + _companyId.ToString(CultureInfo.InvariantCulture);
    }
    private string TabClass(string view) => string.Equals(_view, view, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    private static IReadOnlyList<ErpAutomationCatalogue.Item> ChainItems(ErpAutomationCatalogue.Chain chain)
    {
        var steps = new List<ErpAutomationCatalogue.Item>();
        foreach (var id in chain.ItemIds)
        {
            var item = ErpAutomationCatalogue.Find(id);
            if (item is not null)
            {
                steps.Add(item);
            }
        }

        return steps;
    }

    private RenderFragment Card(ErpAutomationCatalogue.Item autoItem, string tone) => __builder =>
    {
        var colors = tone == "teal" ? new[] { "#134e4a", "#0f766e", "#14b8a6" } : new[] { "#0c4a6e", "#0369a1", "#0ea5e9" };
        var status = autoItem.DefaultOn ? "active" : "available";
        var badge = autoItem.DefaultOn ? "success" : "warning";
        <div class="epc-auto-card" data-auto-id="@autoItem.Id">
            <div class="epc-auto-card__head">
                <h4 class="epc-auto-card__title"><i class="fa @autoItem.Icon"></i>@autoItem.Name</h4>
                <span class="label label-@badge">@status</span>
            </div>
            <p class="epc-auto-card__desc">@autoItem.Description</p>
            <div class="epc-auto-pipeline" role="list">
                @for (var i = 0; i < autoItem.Pipeline.Count; i++)
                {
                    var stepColor = colors[i % 3];
                    <div class="epc-auto-pipeline__step" role="listitem" style="--epc-step:@stepColor">
                        <span class="epc-auto-pipeline__num">@((i + 1).ToString(CultureInfo.InvariantCulture))</span>
                        <span class="epc-auto-pipeline__label">@autoItem.Pipeline[i]</span>
                    </div>
                    @if (i < autoItem.Pipeline.Count - 1)
                    {
                        <div class="epc-auto-pipeline__arrow" aria-hidden="true"><i class="fa fa-chevron-right"></i></div>
                    }
                }
            </div>
            <div class="epc-auto-card__actions">
                <a class="btn btn-default btn-xs" href="@WithCompany(ErpAutomationCatalogue.OpenHref(autoItem))"><i class="fa fa-external-link"></i> Open</a>
            </div>
        </div>
    };
}
