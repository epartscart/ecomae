@page "/cp/price-configs-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ICpPriceConfigsWriteService Writes
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Price configs · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

@if (_allowed)
{
    <PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12 epc-scp-panel epc-scp-price-configs">
        <div class="epc-scp-panel__hero">
            <div>
                <span class="epc-scp-dashboard__badge">Super CP</span>
                <h2 class="epc-scp-dashboard__title">Price generation configs</h2>
                <p class="epc-scp-dashboard__sub">Define markup rules for built-in catalogue, price lists, and API integrations — platform-wide or per tenant.</p>
            </div>
            <div class="epc-scp-dashboard__hero-actions">
                <a class="btn btn-sm btn-default" href="/cp/price-lists-app"><i class="fa fa-tags"></i> Price lists</a>
                <a class="btn btn-sm btn-primary" href="/cp/guides-app"><i class="fa fa-book"></i> Operator guide</a>
                <a class="btn btn-sm btn-default ghost" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" target="_blank" rel="noopener"><i class="fa fa-code"></i> Classic twin</a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_flashOk))
        {
            <div class="alert alert-success">@_flashOk</div>
        }
        @if (!string.IsNullOrWhiteSpace(_flashErr))
        {
            <div class="alert alert-danger">@_flashErr</div>
        }
        @if (!_isAdmin)
        {
            <div class="alert alert-warning">Sign in with a staff session to manage price configs.</div>
        }

        <div class="row">
            <div class="col-md-5">
                <div class="epc-scp-form-card">
                    <h4><i class="fa fa-@(_opened is not null ? "edit" : "plus")"></i> @(_opened is not null ? "Edit config" : "New config")</h4>
                    <form method="post" action="/cp/price-configs/write" class="form-horizontal">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@_listHref" />
                        <input type="hidden" name="action" value="save_price_config" />
                        <input type="hidden" name="id" value="@FormId.ToString(CultureInfo.InvariantCulture)" />
                        <div class="form-group"><label class="col-sm-4 control-label">Name</label><div class="col-sm-8"><input class="form-control input-sm" name="name" required value="@OpenedName" /></div></div>
                        <div class="form-group"><label class="col-sm-4 control-label">Scope</label><div class="col-sm-8">
                            <select class="form-control input-sm" name="scope">
                                <option value="platform" selected="@(OpenedScope == "platform")">Platform default</option>
                                <option value="tenant" selected="@(OpenedScope == "tenant")">Tenant override</option>
                            </select>
                        </div></div>
                        <div class="form-group"><label class="col-sm-4 control-label">Tenant</label><div class="col-sm-8">
                            <select class="form-control input-sm" name="site_key">
                                <option value="">—</option>
                                @foreach (var t in _tenants)
                                {
                                    <option value="@t.SiteKey" selected="@(OpenedSiteKey == t.SiteKey)">@t.Label</option>
                                }
                            </select>
                        </div></div>
                        <div class="form-group"><label class="col-sm-4 control-label">Client type</label><div class="col-sm-8">
                            <select class="form-control input-sm" name="client_type">
                                @foreach (var client in CpPriceConfigsWriteService.ClientTypes)
                                {
                                    <option value="@client.Key" selected="@(OpenedClientType == client.Key)">@client.Value</option>
                                }
                            </select>
                        </div></div>
                        <div class="form-group"><label class="col-sm-4 control-label">Client ref</label><div class="col-sm-8"><input class="form-control input-sm" name="client_ref" placeholder="price list id, channel id…" value="@OpenedClientRef" /></div></div>
                        <div class="form-group"><label class="col-sm-4 control-label">Markup %</label><div class="col-sm-8"><input class="form-control input-sm" type="number" step="0.01" name="markup_percent" value="@OpenedMarkupPercent.ToString(CultureInfo.InvariantCulture)" /></div></div>
                        <div class="form-group"><label class="col-sm-4 control-label">Fixed markup</label><div class="col-sm-8"><input class="form-control input-sm" type="number" step="0.0001" name="markup_fixed" value="@OpenedMarkupFixed.ToString(CultureInfo.InvariantCulture)" /></div></div>
                        <div class="form-group"><label class="col-sm-4 control-label">Currency</label><div class="col-sm-8"><input class="form-control input-sm" name="currency" maxlength="8" value="@OpenedCurrency" /></div></div>
                        <div class="form-group"><label class="col-sm-4 control-label">Priority</label><div class="col-sm-8"><input class="form-control input-sm" type="number" name="priority" value="@OpenedPriority.ToString(CultureInfo.InvariantCulture)" /></div></div>
                        <div class="form-group"><label class="col-sm-4 control-label">Notes</label><div class="col-sm-8"><textarea class="form-control input-sm" name="notes" rows="2">@OpenedNotes</textarea></div></div>
                        <div class="form-group"><div class="col-sm-8 col-sm-offset-4">
                            <label class="checkbox-inline"><input type="checkbox" name="active" value="1" checked="@OpenedActive"> Active</label>
                        </div></div>
                        <div class="form-group"><div class="col-sm-8 col-sm-offset-4">
                            <button type="submit" class="btn btn-primary btn-sm" disabled="@(!_isAdmin)"><i class="fa fa-save"></i> Save</button>
                            @if (_opened is not null)
                            {
                                <a class="btn btn-default btn-sm" href="@_listHref">Cancel</a>
                            }
                        </div></div>
                    </form>
                </div>
            </div>
            <div class="col-md-7">
                <div class="epc-scp-table-card">
                    <h4><i class="fa fa-list"></i> Active rules (@_rows.Count.ToString(CultureInfo.InvariantCulture))</h4>
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-condensed epc-scp-data-table">
                            <thead><tr><th>Name</th><th>Scope</th><th>Client</th><th>Markup</th><th>Priority</th><th></th></tr></thead>
                            <tbody>
                            @if (_rows.Count == 0)
                            {
                                <tr><td colspan="6" class="epc-scp-empty-cell">
                                    <div class="epc-scp-empty">
                                        <h4>No price configs yet</h4>
                                        <p>Add a platform default markup rule, then tenant overrides where clients need different margins.</p>
                                        <a class="btn btn-sm btn-default" href="/cp/price-lists-app"><i class="fa fa-tags"></i> Shop prices</a>
                                        <a class="btn btn-sm btn-primary" href="/cp/guides-app"><i class="fa fa-book"></i> Operator guide</a>
                                    </div>
                                </td></tr>
                            }
                            @foreach (var row in _rows)
                            {
                                <tr class="@(row.Active ? "" : "text-muted")">
                                    <td><strong>@row.Name</strong>@if (!row.Active) { <text> </text><span class="label label-default">off</span> }</td>
                                    <td>@row.Scope@if (!string.IsNullOrWhiteSpace(row.SiteKey)) { <br /><code>@row.SiteKey</code> }</td>
                                    <td>@(CpPriceConfigsWriteService.ClientTypes.TryGetValue(row.ClientType, out var label) ? label : row.ClientType)@if (!string.IsNullOrWhiteSpace(row.ClientRef)) { <br /><code>@row.ClientRef</code> }</td>
                                    <td>@row.MarkupPercent.ToString(CultureInfo.InvariantCulture)% + @row.MarkupFixed.ToString(CultureInfo.InvariantCulture) @row.Currency</td>
                                    <td>@row.Priority.ToString(CultureInfo.InvariantCulture)</td>
                                    <td class="epc-scp-actions-cell">
                                        <a class="btn btn-xs btn-default" href="@OpenHref(row.Id)" title="Edit"><i class="fa fa-edit"></i></a>
                                        <form method="post" action="/cp/price-configs/write" style="display:inline" onsubmit="return confirm('Delete this config?');">
                                            <input type="hidden" name="confirmWrites" value="true" />
                                            <input type="hidden" name="returnUrl" value="@_listHref" />
                                            <input type="hidden" name="action" value="delete_price_config" />
                                            <input type="hidden" name="id" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                            <button type="submit" class="btn btn-xs btn-danger" disabled="@(!_isAdmin)"><i class="fa fa-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>This control is available on the platform Super CP host only.</p>
        <p><a href="/cp">Open Control Panel</a></p>
    </div>
}

@code {
    private bool _allowed;
    private const string _phpTab = "/CP/control/portal/epc_super_cp_price_configs";
    private const string _listHref = "/cp/price-configs-app";
    private static readonly string[] _scopes = ["platform", "tenant"];
    private bool _isAdmin;
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private IReadOnlyList<CpPriceConfigRow> _rows = [];
    private IReadOnlyList<CpPriceConfigTenantOption> _tenants = [];
    private CpPriceConfigRow? _opened;

    private long FormId => _opened?.Id ?? 0;
    private string OpenedName => _opened?.Name ?? "";
    private string OpenedScope => CpPriceConfigsWriteService.NormalizeScope(_opened?.Scope);
    private string OpenedSiteKey => _opened?.SiteKey ?? "";
    private string OpenedClientType => CpPriceConfigsWriteService.NormalizeClientType(_opened?.ClientType);
    private string OpenedClientRef => _opened?.ClientRef ?? "";
    private decimal OpenedMarkupPercent => _opened?.MarkupPercent ?? 0m;
    private decimal OpenedMarkupFixed => _opened?.MarkupFixed ?? 0m;
    private string OpenedCurrency => string.IsNullOrWhiteSpace(_opened?.Currency) ? "AED" : _opened!.Currency;
    private int OpenedPriority => _opened?.Priority > 0 ? _opened.Priority : 100;
    private string OpenedNotes => _opened?.Notes ?? "";
    private bool OpenedActive => _opened is null || _opened.Active;

    private static string OpenHref(long id)
        => _listHref + "?config_id=" + id.ToString(CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        if (!long.TryParse(ctx.Request.Query["config_id"].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out _openedId)
            && !long.TryParse(ctx.Request.Query["edit"].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out _openedId))
        {
            _openedId = 0;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        _rows = await Writes.ListAsync(ctx.RequestAborted);
        _tenants = await Writes.ListTenantOptionsAsync(ctx.RequestAborted);
        if (_openedId > 0)
        {
            _opened = _rows.FirstOrDefault(r => r.Id == _openedId);
        }
    }
}
