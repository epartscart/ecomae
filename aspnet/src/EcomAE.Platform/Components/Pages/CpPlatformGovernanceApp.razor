@page "/cp/platform-governance-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Platform governance · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-pg-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-pg-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-pg-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-pg-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-pg-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#422006; background:#e0f2fe;
        }
        .epc-pg-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-pg-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-pg-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-pg-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-pg-kpi span { color:#64748b; font-size:.78rem; }
        .epc-pg-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-pg-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-pg-table th, .epc-pg-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-pg-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-pg-note { margin-top:1rem; padding:.75rem .9rem; background:#fffbeb; border:1px solid #fcd34d; border-radius:.45rem; color:#78350f; font-size:.86rem; }
        @@media (max-width:900px){ .epc-pg-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-pg-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Platform governance</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-pg-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
        </div>
    </section>

    <div class="epc-pg-kpis" aria-label="Platform governance stats">
        <div class="epc-pg-kpi"><strong>@_summary.RuleCount.ToString(CultureInfo.InvariantCulture)</strong><span>Rules</span></div>
        <div class="epc-pg-kpi"><strong>@_summary.ActiveCount.ToString(CultureInfo.InvariantCulture)</strong><span>Active</span></div>
        <div class="epc-pg-kpi"><strong>@_summary.RequiredCount.ToString(CultureInfo.InvariantCulture)</strong><span>Required</span></div>
        <div class="epc-pg-kpi"><strong>@_summary.CategoryCount.ToString(CultureInfo.InvariantCulture)</strong><span>Categories</span></div>
    </div>

    <div class="epc-pg-table-wrap">
        <table class="epc-pg-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Key</th>
                    <th>Category</th>
                    <th>Title</th>
                    <th>Enforcement</th>
                    <th>Scope</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rules.Count == 0)
                {
                    <tr><td colspan="8">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _rules)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.RuleKey) ? row.RuleKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Category) ? row.Category : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Enforcement) ? row.Enforcement : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Scope) ? row.Scope : "—")</td>
                            <td>@(row.Active ? "yes" : "no")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_platform_governance";
    private bool _isAdmin;
    private CpPlatformGovernanceSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPlatformGovernanceRuleDigest> _rules = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpPlatformGovernanceDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rules = result.Rules;
        _source = result.Source;
        _message = result.Message;
    }
}
