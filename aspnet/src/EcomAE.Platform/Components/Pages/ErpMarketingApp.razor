@page "/erp/marketing-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IErpMarketingCreateDryRun MarketingCreate
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Marketing · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Marketing" BreadcrumbArea="Sales" BreadcrumbTab="Marketing">

    <PhpErpModulePageHeader Title="Marketing campaigns" Subtitle="Channel, budget and leads from the shop campaign register. Creates stay dry-run." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Marketing KPIs">
        <div class="kpi"><div class="lbl">Campaigns</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Budget</div><div class="val">@_budget.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Leads</div><div class="val">@_leads.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <form @onsubmit="OnCreate" @onsubmit:preventDefault="true" style="margin:12px 0;padding:10px;border:1px solid #c5d4de;background:#fff;">
            <strong>New campaign (dry-run)</strong>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;align-items:end;">
                <label>Name <input class="form-control" @bind="_formName" /></label>
                <button type="submit" class="btn btn-primary">Validate create</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_formResult))
            {
                <p style="margin:8px 0 0;font-size:12px;">@_formResult</p>
            }
        </form>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Channel</th>
                    <th>Status</th>
                    <th class="text-right">Budget</th>
                    <th class="text-right">Spent</th>
                    <th class="text-right">Leads</th>
                    <th>Start</th>
                    <th>End</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_campaigns.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No campaigns yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _campaigns)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Name) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Name)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Channel) ? "—" : row.Channel)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td class="text-right">@row.Budget.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.Spent.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.Leads.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@FormatDate(row.TimeStart)</td>
                            <td>@FormatDate(row.TimeEnd)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Dry-run: <code>marketing_create</code> — writes=0.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=sales&tab=marketing";
    private bool _isAdmin;
    private IReadOnlyList<ErpMarketingCampaignDigest> _campaigns = [];
    private int _count;
    private int _active;
    private decimal _budget;
    private int _leads;
    private string _source = "n/a";
    private string _message = "";
    private string _formName = "";
    private string _formResult = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpMarketingCampaignsAsync(200, ctx.RequestAborted);
        _campaigns = result.Campaigns;
        _count = result.Count;
        _active = result.ActiveCount;
        _budget = result.BudgetTotal;
        _leads = result.LeadTotal;
        _source = result.Source;
        _message = result.Message;
    }

    private void OnCreate()
    {
        var result = MarketingCreate.Evaluate(new ErpMarketingCreateRequest(_formName, false));
        _formResult = $"{result.Status}: {result.Detail} (writes={result.Writes.ToString(CultureInfo.InvariantCulture)})";
    }

    private static string FormatDate(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
