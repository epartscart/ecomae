@page "/erp/marketing-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Marketing · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Marketing" BreadcrumbArea="Sales" BreadcrumbTab="Marketing">

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Marketing campaigns" Subtitle="Open a row for the 280-character notes excerpt. Create writes here. Schema seed stays on the Classic twin." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    @if (!string.IsNullOrWhiteSpace(_flash))
    {
        <div class="alert @(_flashOk ? "alert-success" : "alert-warning")" style="margin:0 0 12px">@_flash</div>
    }

    @if (_isAdmin)
    {
        <form method="post" action="/erp/marketing/create" class="form-inline" style="margin:0 0 12px;padding:10px;border:1px solid #c5d4de;background:#fff">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(_openedId > 0 ? OpenedReturnHref : _listHref)" />
            <label style="margin-right:8px">Name <input name="name" class="form-control input-sm" maxlength="255" placeholder="Campaign name" /></label>
            <label style="margin-right:8px">Channel <input name="channel" class="form-control input-sm" value="digital" maxlength="64" /></label>
            <label style="margin-right:8px">Budget <input type="number" name="budget" class="form-control input-sm" step="0.01" min="0" style="width:7rem" /></label>
            <label style="margin-right:8px">Status
                <select name="status" class="form-control input-sm">
                    <option value="active" selected>Active</option>
                    <option value="draft">Draft</option>
                    <option value="paused">Paused</option>
                    <option value="completed">Completed</option>
                </select>
            </label>
            <label style="margin-right:8px">Start <input type="date" name="time_start" class="form-control input-sm" value="@_today" /></label>
            <label style="margin-right:8px">End <input type="date" name="time_end" class="form-control input-sm" value="@_plus30" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Create campaign</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Marketing KPIs">
        <div class="kpi"><div class="lbl">Campaigns</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Budget</div><div class="val">@_budget.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Leads</div><div class="val">@_leads.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Name) ? "—" : _opened.Name)</dd>
                <dt>Channel</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Channel) ? "—" : _opened.Channel)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Status) ? "—" : _opened.Status)</dd>
                <dt>Budget</dt><dd>@_opened.Budget.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Spent</dt><dd>@_opened.Spent.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Leads</dt><dd>@_opened.Leads.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Start</dt><dd>@FormatDate(_opened.TimeStart)</dd>
                <dt>End</dt><dd>@FormatDate(_opened.TimeEnd)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Create writes here. Schema seed stays on the Classic twin.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.NotesExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">notes excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.NotesExcerpt</pre>
                @if (_opened.NotesLen > _opened.NotesExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.NotesExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NotesLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No notes excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Channel</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Name) ? "—" : sib.Name)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Channel) ? "—" : sib.Channel)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "campaign_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Channel</th>
                    <th>Status</th>
                    <th class="text-right">Budget</th>
                    <th class="text-right">Spent</th>
                    <th class="text-right">Leads</th>
                    <th>Start</th>
                    <th>End</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_campaigns.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No campaigns yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _campaigns)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Name) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Name)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Channel) ? "—" : row.Channel)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td class="text-right">@row.Budget.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.Spent.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.Leads.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@FormatDate(row.TimeStart)</td>
                            <td>@FormatDate(row.TimeEnd)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "campaign_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=sales&tab=marketing";
    private const string _listHref = "/erp/marketing-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpMarketingCampaignDigest> _campaigns = [];
    private int _count;
    private int _active;
    private decimal _budget;
    private int _leads;
    private string _message = "";
    private string _flash = "";
    private bool _flashOk;
    private string _today = DateTime.UtcNow.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private string _plus30 = DateTime.UtcNow.AddDays(30).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private long _openedId;
    private ErpMarketingCampaignDetail? _opened;
    private IReadOnlyList<ErpMarketingCampaignDigest> _openedSiblings = [];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.Name)
            ? _opened.Name
            : ("Campaign #" + _opened.Id.ToString(CultureInfo.InvariantCulture)));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?campaign_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "campaign_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        var ok = ctx.Request.Query["ok"].ToString();
        var err = ctx.Request.Query["err"].ToString();
        if (!string.IsNullOrWhiteSpace(ok)) { _flash = ok; _flashOk = true; }
        else if (!string.IsNullOrWhiteSpace(err)) { _flash = err; _flashOk = false; }
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpMarketingCampaignsAsync(200, ctx.RequestAborted);
        _campaigns = result.Campaigns;
        _count = result.Count;
        _active = result.ActiveCount;
        _budget = result.BudgetTotal;
        _leads = result.LeadTotal;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpMarketingCampaignDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Campaign;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _campaigns.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _campaigns = new[] { openedList }.Concat(_campaigns.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }

    private static string FormatDate(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
