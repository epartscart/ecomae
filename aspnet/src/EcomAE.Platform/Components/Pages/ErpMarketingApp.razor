@page "/erp/marketing-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Marketing · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Marketing" BreadcrumbArea="Sales" BreadcrumbTab="Marketing">

    <PhpErpModulePageHeader Title="Marketing campaigns" Subtitle="Campaign create writes here. Staff schema seed stays on the Classic twin." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    @if (!string.IsNullOrWhiteSpace(_flash))
    {
        <div class="alert @(_flashOk ? "alert-success" : "alert-warning")" style="margin:0 0 12px">@_flash</div>
    }

    @if (_isAdmin)
    {
        <form method="post" action="/erp/marketing/create" class="form-inline" style="margin:0 0 12px;padding:10px;border:1px solid #c5d4de;background:#fff">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/marketing-app" />
            <label style="margin-right:8px">Name <input name="name" class="form-control input-sm" maxlength="255" placeholder="Campaign name" /></label>
            <label style="margin-right:8px">Channel <input name="channel" class="form-control input-sm" value="digital" maxlength="64" /></label>
            <label style="margin-right:8px">Budget <input type="number" name="budget" class="form-control input-sm" step="0.01" min="0" style="width:7rem" /></label>
            <label style="margin-right:8px">Status
                <select name="status" class="form-control input-sm">
                    <option value="active" selected>Active</option>
                    <option value="draft">Draft</option>
                    <option value="paused">Paused</option>
                    <option value="completed">Completed</option>
                </select>
            </label>
            <label style="margin-right:8px">Start <input type="date" name="time_start" class="form-control input-sm" value="@_today" /></label>
            <label style="margin-right:8px">End <input type="date" name="time_end" class="form-control input-sm" value="@_plus30" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Create campaign</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Marketing KPIs">
        <div class="kpi"><div class="lbl">Campaigns</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Budget</div><div class="val">@_budget.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Leads</div><div class="val">@_leads.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Channel</th>
                    <th>Status</th>
                    <th class="text-right">Budget</th>
                    <th class="text-right">Spent</th>
                    <th class="text-right">Leads</th>
                    <th>Start</th>
                    <th>End</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_campaigns.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No campaigns yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _campaigns)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Name) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Name)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Channel) ? "—" : row.Channel)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td class="text-right">@row.Budget.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.Spent.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.Leads.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@FormatDate(row.TimeStart)</td>
                            <td>@FormatDate(row.TimeEnd)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=sales&tab=marketing";
    private bool _isAdmin;
    private IReadOnlyList<ErpMarketingCampaignDigest> _campaigns = [];
    private int _count;
    private int _active;
    private decimal _budget;
    private int _leads;
    private string _message = "";
    private string _flash = "";
    private bool _flashOk;
    private string _today = DateTime.UtcNow.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private string _plus30 = DateTime.UtcNow.AddDays(30).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        var ok = ctx.Request.Query["ok"].ToString();
        var err = ctx.Request.Query["err"].ToString();
        if (!string.IsNullOrWhiteSpace(ok)) { _flash = ok; _flashOk = true; }
        else if (!string.IsNullOrWhiteSpace(err)) { _flash = err; _flashOk = false; }
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpMarketingCampaignsAsync(200, ctx.RequestAborted);
        _campaigns = result.Campaigns;
        _count = result.Count;
        _active = result.ActiveCount;
        _budget = result.BudgetTotal;
        _leads = result.LeadTotal;
        _message = result.Message;
    }

    private static string FormatDate(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
