@page "/marketing/terms"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>ECOM AE — Terms (PHP parity preview)</PageTitle>
<PhpChromeStyles Surface="marketing" />

<PhpEcomaeMarketingChrome ActiveKey="terms">
    <PhpHybridWorkspaceFrame PhpHref="@_phpHref" ClearHref="/marketing/terms" />

    @if (string.IsNullOrWhiteSpace(_phpHref))
    {
        <PhpEcomaeLegalAliasOverview
            Title="Terms of use"
            Badge="Terms"
            Icon="fa-file-text-o"
            GradientStart="#1e3a5f"
            GradientMid="#2563eb"
            PhpSlug="terms"
            AspNetRoute="/marketing/terms"
            Lead="Commercial terms for the ECOM AE Blockchain BOS Enterprise System. Full policy text remains on live PHP until dual-sample."
            CardOne="Buyer, tenant, and operator terms that govern hosted commerce and ERP access." />
    }
</PhpEcomaeMarketingChrome>

@code {
    private string? _phpHref;

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        if (ctx?.Request.Query.TryGetValue("php", out var php) == true && !string.IsNullOrWhiteSpace(php))
        {
            _phpHref = php.ToString();
        }
    }
}
