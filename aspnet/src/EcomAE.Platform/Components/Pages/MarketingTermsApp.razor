@page "/marketing/terms"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation

<PageTitle>ECOM AE — Terms</PageTitle>
<PhpChromeStyles Surface="marketing" />

<PhpEcomaeMarketingChrome ActiveKey="terms">
    <PhpEcomaeLegalAliasOverview
            Title="Terms of use"
            Badge="Terms"
            Icon="fa-file-text-o"
            GradientStart="#1e3a5f"
            GradientMid="#2563eb"
            PhpSlug="terms"
            AspNetRoute="/marketing/terms"
            Lead="Commercial terms for the ECOM AE Blockchain BOS Enterprise System. Full policy text is available from the linked policy page."
            CardOne="Buyer, tenant, and operator terms that govern hosted commerce and ERP access." />
    <p style="max-width:var(--epm-max-w,1440px);margin:0 auto;padding:0 var(--epm-pad-x,20px) 2rem;font-size:.82rem;color:#94a3b8;">
        PHP compare: <a href="/php-reference/home">/php-reference/home</a>
    </p>
</PhpEcomaeMarketingChrome>
