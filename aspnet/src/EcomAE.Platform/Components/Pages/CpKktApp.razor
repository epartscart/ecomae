@page "/cp/kkt-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>KKT · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <PhpParityModuleBody AppPath="/cp/kkt-app" IsAdmin="_isAdmin" />


    <PhpCpModulePageHeader Title="Online cashiers (KKT)"
                           Subtitle="PHP onlajn-kassy / devices.php parity — registered cashiers, wired interfaces, and fiscal check counts. Writes stay PHP."
                           PhpTabHref="@_phpTab">
        <a class="ghost" href="/cp/pos-overview-app">POS overview</a>
        <a class="ghost" href="/cp/orders">Orders</a>
        <a class="ghost" href="/cp/payment-gateways-app">Payments</a>
    </PhpCpModulePageHeader>

    @if (!_isAdmin)
    {
        <div class="alert alert-info" role="status">Sign in with a Control Panel admin session to load live tenant data. Guest browse shows the PHP-parity shell.</div>
    }

    <div class="epc-scp-kpi" aria-label="KKT stats">
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Devices</div>
            <div class="epc-scp-kpi__val">@_summary.DeviceCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Wired interfaces</div>
            <div class="epc-scp-kpi__val">@_summary.WiredDeviceCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Checks</div>
            <div class="epc-scp-kpi__val">@_summary.CheckCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Sent to device</div>
            <div class="epc-scp-kpi__val">@_summary.SentCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
    </div>

    <div class="epc-scp-tool-grid" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;margin-bottom:1rem;">
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">devices.php</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">register cashiers</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref("/CP/shop/onlajn-kassy")">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">default settings</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">fiscal defaults</p>
        </a>
        <a class="epc-scp-table-card" style="padding:1rem;text-decoration:none;color:inherit;" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref("/CP/shop/onlajn-kassy/checks")">
            <h3 style="margin:0 0 .35rem;font-size:1rem;">checks.php</h3>
            <p style="margin:0;color:#475569;font-size:.86rem;">fiscal receipts</p>
        </a>
    </div>

    <div class="epc-scp-table-card">
        <div class="epc-scp-table-card__head">
            <div>
                <h3>Connected devices</h3>
                <p class="epc-users-hint">PHP devices.php — id, name, interface description</p>
            </div>
            <a class="btn btn-primary btn-xs" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Open PHP module</a>
        </div>
        <table class="epc-scp-data-table table table-epc-pro">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Handler</th>
                    <th>Interface</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_devices.Count == 0)
                {
                    <tr><td colspan="5">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _devices)
                    {
                        <tr>
                            <td><strong>@row.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Name) ? "—" : row.Name)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Handler) ? "—" : row.Handler)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.InterfaceDescription) ? "Real cashier not wired" : row.InterfaceDescription)</td>
                            <td><a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/kkt";
    private bool _isAdmin;
    private CpKktSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpKktDeviceDigest> _devices = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpKktDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _devices = result.Devices;
    }
}
