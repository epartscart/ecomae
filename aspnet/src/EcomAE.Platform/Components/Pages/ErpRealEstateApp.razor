@page "/erp/real-estate-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject IErpRealEstateReadService RealEstate

<PageTitle>Real estate · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Real estate" BreadcrumbArea="Industry" BreadcrumbTab="@_tabLabel">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/real-estate-app" IsAdmin="_isAdmin" />
    <PhpErpModulePageHeader
        Title="Investment, development and construction"
        Subtitle="Property master, pipeline, leases, cheques, development, BOQ, escrow, off-plan instalments and contractor certificates — linked to legal entities, GL, VAT and existing finance. Posted rows cannot be edited; void (keep on file) or delete them. Reverse remains available. Opportunities stay off both statements. Completed acquisitions, deposits, cheques, escrow and certificates hit the balance sheet; rent, fair-value moves (IAS 40 through P&L, not OCI) and recognized unit sales (IFRS 15) hit the income statement. Off-plan collections stay a contract liability until sold."
        PhpTabHref="/erp/real-estate-app" />
    <ErpPhpFlash Ok="@_flashOk" Err="@_flashErr" />

    <div class="re-board-dock" aria-label="Download investment report from any tab">
        <div>
            <strong>Investment report</strong>
            <span class="text-muted"> — portfolio presentation with photographs (fair value, yield, leases). Download PDF or Word from this tab or any other.</span>
        </div>
        <div class="re-board-dock__actions">
            <a class="btn btn-sm re-board-btn" href="@ReportHref("html")" target="_blank" rel="noopener">Open presentation</a>
            <a class="btn btn-sm re-board-btn" href="@ReportHref("pdf")">Download PDF</a>
            <a class="btn btn-sm re-board-btn" href="@ReportHref("docx")">Download Word</a>
            <a class="btn btn-sm re-board-btn" href="@LandlordHref">Year book</a>
        </div>
    </div>
    <style>
        .re-board-dock { position: sticky; top: 0; z-index: 40; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; margin: 0 0 14px; padding: 10px 14px; background: linear-gradient(90deg, #0b1f3a, #163a6b); color: #f6f1e7; border-bottom: 3px solid #c4a35a; border-radius: 6px; box-shadow: 0 8px 24px rgba(11,31,58,.22); }
        .re-board-dock strong { color: #c4a35a; }
        .re-board-dock .text-muted { color: #e2e8f0 !important; }
        .re-board-btn { background: #c4a35a !important; color: #0b1f3a !important; border: 0 !important; font-weight: 600; }
        .re-meters { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; margin: 0 0 14px; }
        .re-meter { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px 10px; }
        .re-meter strong { display: block; font-size: 12px; color: #0f172a; }
        .re-meter i { display: block; height: 8px; margin-top: 6px; background: #e2e8f0; border-radius: 99px; overflow: hidden; }
        .re-meter i b { display: block; height: 100%; background: #163a6b; }
        .re-filter { display: flex; flex-wrap: wrap; gap: 8px; align-items: end; margin: 0 0 12px; }
        .re-filter label { font-size: 12px; color: #334155; }
    </style>

    <nav class="epc-org-tabs" aria-label="Real estate workspaces">
        @foreach (var tab in Tabs)
        {
            <a class="@TabClass(tab.Key)" href="@OrgHref(tab.Key)"><i class="fa @tab.Icon"></i> @tab.Label</a>
        }
    </nav>

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Real estate KPIs">
        <div class="kpi"><div class="lbl">Opportunities</div><div class="val">@_snap.Kpis.Opportunities.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Owned properties</div><div class="val">@_snap.Kpis.OwnedProperties.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active leases</div><div class="val">@_snap.Kpis.ActiveLeases.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Portfolio cost</div><div class="val">@_snap.Kpis.PortfolioCost.ToString("N0", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Fair value</div><div class="val">@_snap.Kpis.PortfolioFair.ToString("N0", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Gross yield</div><div class="val">@((_snap.Kpis.GrossYield * 100).ToString("0.00", CultureInfo.InvariantCulture))%</div></div>
        <div class="kpi"><div class="lbl">Occupancy</div><div class="val">@((_snap.Kpis.Occupancy * 100).ToString("0.0", CultureInfo.InvariantCulture))%</div></div>
        <div class="kpi"><div class="lbl">Cost to complete</div><div class="val">@_snap.Kpis.CostToComplete.ToString("N0", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Escrow held</div><div class="val">@_snap.Kpis.EscrowBalance.ToString("N0", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Vacant units</div><div class="val">@_snap.Kpis.VacantUnits.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Recognized rent</div><div class="val">@_snap.Kpis.RecognizedRent.ToString("N0", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Rent collected</div><div class="val">@_snap.Kpis.RentCollected.ToString("N0", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Outstanding</div><div class="val">@_snap.Kpis.OutstandingRent.ToString("N0", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">PDCs in hand</div><div class="val">@_snap.Kpis.PdcInHand.ToString("N0", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Cheques due</div><div class="val">@_snap.Kpis.ChequesDue.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">NOI</div><div class="val">@_snap.Kpis.Noi.ToString("N0", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Net cash flow</div><div class="val">@_snap.Kpis.NetCashFlow.ToString("N0", CultureInfo.InvariantCulture)</div></div>
    </div>
    <div class="re-meters" aria-label="Landlord position">
        <div class="re-meter"><strong>Occupancy @((_snap.Kpis.Occupancy * 100).ToString("0.0", CultureInfo.InvariantCulture))%</strong><i><b style="width:@Meter(_snap.Kpis.Occupancy, 1m)%"></b></i></div>
        <div class="re-meter"><strong>Collected vs recognized</strong><i><b style="width:@Meter(_snap.Kpis.RentCollected, _snap.Kpis.RecognizedRent)%"></b></i></div>
        <div class="re-meter"><strong>Collection efficiency @((_snap.Kpis.Collection * 100).ToString("0.0", CultureInfo.InvariantCulture))%</strong><i><b style="width:@Meter(_snap.Kpis.Collection, 1m)%"></b></i></div>
        @if (_snap.YearBook is { Year: > 0 } book)
        {
            <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Year book on the dashboard">
                <div class="kpi"><div class="lbl">@book.Year income</div><div class="val">@book.YearIncome.ToString("N2", CultureInfo.InvariantCulture)</div></div>
                <div class="kpi"><div class="lbl">@book.Year expenses</div><div class="val">@book.YearExpense.ToString("N2", CultureInfo.InvariantCulture)</div></div>
                <div class="kpi"><div class="lbl">@book.Year return</div><div class="val">@book.YearReturn.ToString("N2", CultureInfo.InvariantCulture)</div></div>
                <div class="kpi"><div class="lbl">All years income</div><div class="val">@book.AllIncome.ToString("N2", CultureInfo.InvariantCulture)</div></div>
                <div class="kpi"><div class="lbl">All years expenses</div><div class="val">@book.AllExpense.ToString("N2", CultureInfo.InvariantCulture)</div></div>
                <div class="kpi"><div class="lbl">All years return</div><div class="val">@book.AllReturn.ToString("N2", CultureInfo.InvariantCulture)</div></div>
            </div>
            <p class="text-muted">These figures are the year book. Rent and expense cards above use them until a lease or a posted supplier bill exists. Assets, income and expenses link to the chart of accounts. <a href="@LandlordHref">Open the year book</a> · <a href="@CoaHref">Chart of accounts</a></p>
        }
    </div>

    <p class="text-muted">Finance links: legal entity, invoices, cash/bank, ageing, GL and VAT stay on the existing ERP modules. Cheques in hand are not cash until bank clearance. Recognized rent is spread over the lease; receiving a cheque does not book the whole year as income. NOI is recognized rent minus posted operating expenses. Capital improvements, financing, depreciation and tax stay out of NOI. Landlord cards follow the emirate and property filter. Investment cards stay on the whole portfolio. Posted documents cannot be edited. Use Void to keep the original row, or Delete to remove it. Reverse is also available on posted rows.</p>

    @if (!string.IsNullOrWhiteSpace(_snap.Message))
    {
        <p class="text-muted">@_snap.Message</p>
    }

    @if (_isAdmin && (_tab == "dashboard" || _tab.Length == 0))
    {
        <form method="get" class="re-filter" action="@AppHref">
            <input type="hidden" name="tab" value="dashboard" />
            <label>Emirate <input class="form-control input-sm" name="emirate" value="@_emirate" placeholder="Dubai" /></label>
            <label>Property id <input class="form-control input-sm" type="number" name="propertyId" value="@(_propertyId > 0 ? _propertyId.ToString(CultureInfo.InvariantCulture) : "")" /></label>
            <button type="submit" class="btn btn-primary btn-sm">Apply filter</button>
            <a class="btn btn-default btn-sm" href="@OrgHref("dashboard")">Whole portfolio</a>
        </form>
        <ErpPhpCreateWell Title="Start with an empty portfolio">
            <p class="text-muted">Removes properties, units, leases, projects, construction rows and their journals so this company can enter live data. Users, chart of accounts and tax settings stay.</p>
            <form method="post" action="@SaveAction">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@OrgHref("dashboard")" />
                <input type="hidden" name="action" value="reset_portfolio" />
                <input type="hidden" name="note" value="FRESH" />
                <button type="submit" class="btn btn-warning btn-sm">Empty portfolio for new entry</button>
            </form>
        </ErpPhpCreateWell>
    }

    @if (_isAdmin)
    {
        @if (_tab == "opportunities")
        {
            <ErpPhpCreateWell Title="Investment opportunity (not an owned asset)">
                <form method="post" action="@SaveAction">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@OrgHref("opportunities")" />
                    <input type="hidden" name="action" value="save_opportunity" />
                    <label>Code <input class="form-control input-sm" name="code" required maxlength="40" placeholder="OPP-DXB-01" /></label>
                    <label>Name <input class="form-control input-sm" name="name" required maxlength="190" /></label>
                    <label>Stage <input class="form-control input-sm" name="status" value="screening" /></label>
                    <label>Seller <input class="form-control input-sm" name="counterparty" /></label>
                    <label>Emirate <input class="form-control input-sm" name="emirate" placeholder="Dubai" /></label>
                    <label>City <input class="form-control input-sm" name="city" /></label>
                    <label>Asking AED <input class="form-control input-sm" type="number" step="0.01" name="amount" /></label>
                    <label>Offer AED <input class="form-control input-sm" type="number" step="0.01" name="amount2" /></label>
                    <label>Indicative value <input class="form-control input-sm" type="number" step="0.01" name="amount3" /></label>
                    <label>Expected rent <input class="form-control input-sm" type="number" step="0.01" name="percent" /></label>
                    <div class="form-actions"><button type="submit" class="btn btn-primary btn-sm">Save opportunity</button></div>
                </form>
            </ErpPhpCreateWell>
            <ErpPhpCreateWell Title="Purchase opportunity into an owned property">
                <form method="post" action="@SaveAction">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@OrgHref("properties")" />
                    <input type="hidden" name="action" value="convert_opportunity" />
                    <label>Opportunity id <input class="form-control input-sm" type="number" name="opportunityId" required min="1" /></label>
                    <label>Category <input class="form-control input-sm" name="category" value="residential" /></label>
                    <label>Eligible costs <input class="form-control input-sm" type="number" step="0.01" name="amount" value="0" /></label>
                    <div class="form-actions"><button type="submit" class="btn btn-primary btn-sm">Complete purchase</button></div>
                </form>
            </ErpPhpCreateWell>
        }
        else if (_tab == "properties")
        {
            <ErpPhpCreateWell Title="Property register">
                <form method="post" action="@SaveAction">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@OrgHref("properties")" />
                    <input type="hidden" name="action" value="save_property" />
                    <label>Code <input class="form-control input-sm" name="code" required maxlength="40" /></label>
                    <label>Name <input class="form-control input-sm" name="name" required maxlength="190" /></label>
                    <label>Category <input class="form-control input-sm" name="category" placeholder="residential / commercial / land" /></label>
                    <label>Emirate <input class="form-control input-sm" name="emirate" /></label>
                    <label>City <input class="form-control input-sm" name="city" /></label>
                    <label>Address <input class="form-control input-sm" name="address" /></label>
                    <label>Title deed <input class="form-control input-sm" name="titleDeed" /></label>
                    <label>Tenure <input class="form-control input-sm" name="tenure" value="freehold" /></label>
                    <label>Area sqm <input class="form-control input-sm" type="number" step="0.01" name="area" /></label>
                    <label>Community <input class="form-control input-sm" name="frequency" placeholder="Business Bay" /></label>
                    <label>Portfolio id <input class="form-control input-sm" type="number" name="relatedId" value="0" /></label>
                    <label>Parent property id <input class="form-control input-sm" type="number" name="opportunityId" value="0" /></label>
                    <label>Legal entity id <input class="form-control input-sm" type="number" name="legalEntityId" value="0" /></label>
                    <div class="form-actions"><button type="submit" class="btn btn-primary btn-sm">Save property</button></div>
                </form>
            </ErpPhpCreateWell>
            <ErpPhpCreateWell Title="Unit / floor space">
                <form method="post" action="@SaveAction">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@OrgHref("properties")" />
                    <input type="hidden" name="action" value="save_unit" />
                    <ErpMasterPicker Kind="property" FieldName="propertyId" Label="Property" Required="true" Min="1" />
                    <label>Unit code <input class="form-control input-sm" name="code" required /></label>
                    <label>Name <input class="form-control input-sm" name="name" /></label>
                    <label>Type <input class="form-control input-sm" name="category" value="apartment" /></label>
                    <label>Area <input class="form-control input-sm" type="number" step="0.01" name="area" /></label>
                    <label>Asking <input class="form-control input-sm" type="number" step="0.01" name="amount" /></label>
                    <div class="form-actions"><button type="submit" class="btn btn-primary btn-sm">Save unit</button></div>
                </form>
            </ErpPhpCreateWell>
            <ErpPhpCreateWell Title="Portfolio, community and floor">
                <form method="post" action="@SaveAction" style="margin-bottom:1rem">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@OrgHref("properties")" />
                    <input type="hidden" name="action" value="save_portfolio" />
                    <label>Portfolio code <input class="form-control input-sm" name="code" required /></label>
                    <label>Name <input class="form-control input-sm" name="name" required /></label>
                    <label>Owner <input class="form-control input-sm" name="counterparty" /></label>
                    <button type="submit" class="btn btn-primary btn-sm">Save portfolio</button>
                </form>
                <form method="post" action="@SaveAction" style="margin-bottom:1rem">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@OrgHref("properties")" />
                    <input type="hidden" name="action" value="save_community" />
                    <label>Community code <input class="form-control input-sm" name="code" required /></label>
                    <label>Name <input class="form-control input-sm" name="name" required /></label>
                    <label>Portfolio id <input class="form-control input-sm" type="number" name="relatedId" value="0" /></label>
                    <label>Emirate <input class="form-control input-sm" name="emirate" /></label>
                    <label>City <input class="form-control input-sm" name="city" /></label>
                    <button type="submit" class="btn btn-primary btn-sm">Save community</button>
                </form>
                <form method="post" action="@SaveAction">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@OrgHref("properties")" />
                    <input type="hidden" name="action" value="save_floor" />
                    <ErpMasterPicker Kind="property" FieldName="propertyId" Label="Building" Required="true" Min="1" />
                    <label>Floor code <input class="form-control input-sm" name="code" required /></label>
                    <label>Name <input class="form-control input-sm" name="name" /></label>
                    <label>Floor no <input class="form-control input-sm" name="note" /></label>
                    <button type="submit" class="btn btn-primary btn-sm">Save floor</button>
                </form>
            </ErpPhpCreateWell>
            <ErpPhpCreateWell Title="Generate units from a building">
                <form method="post" action="@SaveAction">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@OrgHref("properties")" />
                    <input type="hidden" name="action" value="bulk_units" />
                    <ErpMasterPicker Kind="property" FieldName="propertyId" Label="Building" Required="true" Min="1" />
                    <label>Code prefix <input class="form-control input-sm" name="code" required placeholder="A" /></label>
                    <label>How many <input class="form-control input-sm" type="number" name="count" min="1" max="500" value="4" required /></label>
                    <label>First number <input class="form-control input-sm" type="number" name="relatedId" value="101" /></label>
                    <label>Type <input class="form-control input-sm" name="category" value="apartment" /></label>
                    <label>Area each <input class="form-control input-sm" type="number" step="0.01" name="area" /></label>
                    <label>Floor label <input class="form-control input-sm" name="note" placeholder="1" /></label>
                    <div class="form-actions"><button type="submit" class="btn btn-primary btn-sm">Generate units</button></div>
                </form>
            </ErpPhpCreateWell>
        }
        else if (_tab == "acquisitions")
        {
            <ErpPhpCreateWell Title="Acquisition (does not overwrite later valuations)">
                <form method="post" action="@SaveAction">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@OrgHref("acquisitions")" />
                    <input type="hidden" name="action" value="save_acquisition" />
                    <label>Code <input class="form-control input-sm" name="code" required /></label>
                    <ErpMasterPicker Kind="property" FieldName="propertyId" Label="Property" Required="true" Min="1" />
                    <label>Legal entity id <input class="form-control input-sm" type="number" name="legalEntityId" value="0" /></label>
                    <label>Seller <input class="form-control input-sm" name="counterparty" /></label>
                    <label>Purchase price <input class="form-control input-sm" type="number" step="0.01" name="amount" required /></label>
                    <label>Eligible costs <input class="form-control input-sm" type="number" step="0.01" name="amount2" /></label>
                    <label>Agreement date <input class="form-control input-sm" type="date" name="date1" /></label>
                    <div class="form-actions"><button type="submit" class="btn btn-primary btn-sm">Save acquisition</button></div>
                </form>
            </ErpPhpCreateWell>
            <ErpPhpCreateWell Title="Complete acquisition / dispose">
                <form method="post" action="@SaveAction" style="margin-bottom:1rem">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@OrgHref("acquisitions")" />
                    <input type="hidden" name="action" value="complete_acquisition" />
                    <label>Acquisition id <input class="form-control input-sm" type="number" name="id" required min="1" /></label>
                    <button type="submit" class="btn btn-primary btn-sm">Complete for legal entity</button>
                </form>
                <form method="post" action="@SaveAction">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@OrgHref("acquisitions")" />
                    <input type="hidden" name="action" value="save_disposal" />
                    <label>Code <input class="form-control input-sm" name="code" required /></label>
                    <ErpMasterPicker Kind="property" FieldName="propertyId" Label="Property" Required="true" Min="1" />
                    <label>Buyer <input class="form-control input-sm" name="counterparty" /></label>
                    <label>Sale price <input class="form-control input-sm" type="number" step="0.01" name="amount" required /></label>
                    <label>Disposal costs <input class="form-control input-sm" type="number" step="0.01" name="amount2" /></label>
                    <label>Mortgage settlement <input class="form-control input-sm" type="number" step="0.01" name="amount3" /></label>
                    <div class="form-actions"><button type="submit" class="btn btn-primary btn-sm">Record disposal</button></div>
                </form>
            </ErpPhpCreateWell>
        }
        else if (_tab == "valuations")
        {
            <ErpPhpCreateWell Title="Valuation history (acquisition cost stays intact)">
                <form method="post" action="@SaveAction">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@OrgHref("valuations")" />
                    <input type="hidden" name="action" value="save_valuation" />
                    <label>Code <input class="form-control input-sm" name="code" required /></label>
                    <ErpMasterPicker Kind="property" FieldName="propertyId" Label="Property" Required="true" Min="1" />
                    <label>Date <input class="form-control input-sm" type="date" name="date1" /></label>
                    <label>Estimated <input class="form-control input-sm" type="number" step="0.01" name="amount" /></label>
                    <label>Appraised <input class="form-control input-sm" type="number" step="0.01" name="amount2" /></label>
                    <label>Approved fair value <input class="form-control input-sm" type="number" step="0.01" name="amount3" /></label>
                    <label>Valuer <input class="form-control input-sm" name="counterparty" /></label>
                    <div class="form-actions"><button type="submit" class="btn btn-primary btn-sm">Save valuation</button></div>
                </form>
            </ErpPhpCreateWell>
            <div class="epc-erp-table-wrap">
                <h4>Valuation timeline</h4>
                <table class="table table-condensed table-bordered table-epc">
                    <thead><tr><th>Id</th><th>Code</th><th>Approved</th><th>Estimated</th><th>Change</th><th>When</th></tr></thead>
                    <tbody>
                    @if (_valuationTimeline.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted">No valuations yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var point in _valuationTimeline)
                        {
                            <tr>
                                <td>@point.Row.Id</td>
                                <td>@point.Row.Code</td>
                                <td>@point.Row.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@point.Row.Amount2.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@((point.Change * 100).ToString("0.00", CultureInfo.InvariantCulture))%</td>
                                <td>@point.Row.Detail</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        }
        else if (_tab == "leases")
        {
            <ErpPhpCreateWell Title="Tenant">
                <form method="post" action="@SaveAction">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@OrgHref("leases")" />
                    <input type="hidden" name="action" value="save_tenant" />
                    <label>Code <input class="form-control input-sm" name="code" required /></label>
                    <label>Name <input class="form-control input-sm" name="name" required /></label>
