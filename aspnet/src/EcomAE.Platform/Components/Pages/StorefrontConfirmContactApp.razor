@page "/storefront/confirm-contact-app"
@page "/en/users/confirm"
@page "/users/confirm"
@page "/en/users/confirm_contact"
@page "/users/confirm_contact"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>Confirm contact · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" LoginChrome="true" />

<StorefrontTenantChrome>
    <section style="padding:2rem 0 3rem">
        <div class="container" style="max-width:36rem">
            <p style="margin:0 0 .35rem;color:#64748b;font-size:.85rem"><a href="@StorefrontSurfaceLinks.Login">Customer login</a></p>
            <h1 style="margin:.1rem 0 .4rem">Confirm email or phone</h1>
            <p style="color:#475569">Enter the code from registration or a contact change. This page does not invent a send.</p>
            @if (!string.IsNullOrWhiteSpace(_flashOk))
            {
                <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
            }
            @if (!string.IsNullOrWhiteSpace(_flashErr))
            {
                <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
            }
            <form method="post" action="@PhpVendorPortal.ConfirmWriteHref" class="panel panel-primary">
                <div class="panel-body">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="u_id" value="@_userId" />
                    <input type="hidden" name="type" value="@_type" />
                    <label for="code">Confirmation code</label>
                    <div class="input-group">
                        <input id="code" value="@_code" type="text" class="form-control" placeholder="Confirmation code" name="code" required maxlength="32" />
                        <span class="input-group-btn">
                            <button class="btn btn-ar btn-primary" type="submit">Confirm contact</button>
                        </span>
                    </div>
                </div>
            </form>
            <p style="margin-top:1rem"><a href="@StorefrontSurfaceLinks.Login">Back to login</a></p>
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private string _userId = "";
    private string _type = "email";
    private string _code = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        _flashOk = ctx?.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx?.Request.Query["err"].ToString() ?? "";
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx?.Request.Host.Host);
        _userId = ctx?.Request.Query["u_id"].ToString() ?? "";
        _type = string.IsNullOrWhiteSpace(ctx?.Request.Query["type"]) ? "email" : ctx!.Request.Query["type"].ToString();
        _code = ctx?.Request.Query["code"].ToString() ?? "";
    }
}
