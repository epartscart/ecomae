@page "/erp/payroll-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Payroll · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Payroll" BreadcrumbArea="People" BreadcrumbTab="Payroll">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/payroll-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Payroll runs" Subtitle="Open a row for the 280-character note excerpt. Generate, approve, line-days, and pay stay on this page." />
    <PhpErpD365ActionPane RefreshHref="/erp/payroll-app" />

    @if (!string.IsNullOrWhiteSpace(_flash))
    {
        <div class="alert @(_flashOk ? "alert-success" : "alert-warning")" style="margin:0 0 12px">@_flash</div>
    }

    @if (_isAdmin)
    {
        <form method="post" action="/erp/payroll/generate" class="form-inline" style="margin:0 0 12px;padding:10px;border:1px solid #c5d4de;background:#fff">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/payroll-app" />
            <label>Period <input name="period_label" placeholder="YYYY-MM" maxlength="7" required style="width:7rem;margin:0 8px" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Generate payroll</button>
        </form>
        <form method="post" action="/erp/ajax/payroll-approve" class="form-inline" style="margin:0 0 12px;padding:10px;border:1px solid #c5d4de;background:#fff">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/payroll-app" />
            <label>Run id <input type="number" name="id" min="1" required style="width:6rem;margin:0 8px" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Approve run</button>
        </form>
        <form method="post" action="/erp/ajax/hr-update-days" class="form-inline" style="margin:0 0 12px;padding:10px;border:1px solid #c5d4de;background:#fff">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/payroll-app" />
            <label>Staff profile id <input type="number" name="staffProfileId" min="1" required style="width:6rem;margin:0 8px" /></label>
            <label>Days worked <input type="text" name="daysWorked" required style="width:5rem;margin:0 8px" /></label>
            <button type="submit" class="btn btn-sm btn-default">Save days</button>
        </form>
        <form method="post" action="/erp/payroll/update-days" class="form-inline" style="margin:0 0 12px;padding:10px;border:1px solid #c5d4de;background:#fff">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/payroll-app" />
            <label>Line id <input type="number" name="line_id" min="1" required style="width:6rem;margin:0 8px" /></label>
            <label>Days worked <input type="text" name="days_worked" required style="width:5rem;margin:0 8px" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save line days</button>
        </form>
        <form method="post" action="/erp/payroll/pay" class="form-inline" style="margin:0 0 12px;padding:10px;border:1px solid #c5d4de;background:#fff">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/payroll-app" />
            <label>Run id <input type="number" name="run_id" min="1" required style="width:6rem;margin:0 8px" /></label>
            <label>Cash account id <input type="number" name="cash_account_id" min="0" style="width:6rem;margin:0 8px" /></label>
            <button type="submit" class="btn btn-sm btn-success">Pay salaries</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Payroll KPIs">
        <div class="kpi"><div class="lbl">Runs</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Paid</div><div class="val">@_paid.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Gross</div><div class="val">@_gross.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Net</div><div class="val">@_net.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Run id</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Period</dt><dd>@(string.IsNullOrWhiteSpace(_opened.PeriodLabel) ? "—" : _opened.PeriodLabel)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Status) ? "—" : _opened.Status)</dd>
                <dt>Start</dt><dd>@FormatDate(_opened.PeriodStart)</dd>
                <dt>End</dt><dd>@FormatDate(_opened.PeriodEnd)</dd>
                <dt>Employees</dt><dd>@_opened.EmployeeCount.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Gross</dt><dd>@_opened.TotalGross.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Deductions</dt><dd>@_opened.TotalDeductions.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Net</dt><dd>@_opened.TotalNet.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Cash account</dt><dd>@(_opened.CashAccountId > 0 ? _opened.CashAccountId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Cash entry</dt><dd>@(_opened.CashEntryId > 0 ? _opened.CashEntryId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Paid</dt><dd>@FormatDate(_opened.PaidAt)</dd>
                <dt>Created by</dt><dd>@(_opened.CreatedBy > 0 ? _opened.CreatedBy.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Created</dt><dd>@FormatDate(_opened.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Bank details stay off this pane. Generate, approve, line-days, and pay stay on this page.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.NoteExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">note excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.NoteExcerpt</pre>
                @if (_opened.NoteLen > _opened.NoteExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.NoteExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NoteLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No note excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Period</th>
                            <th>Net</th>
                            <th>Employees</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.PeriodLabel) ? "—" : sib.PeriodLabel)</td>
                                <td>@sib.TotalNet.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@sib.EmployeeCount.ToString(CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "payroll_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Period</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Status</th>
                    <th class="text-right">Employees</th>
                    <th class="text-right">Gross</th>
                    <th class="text-right">Deductions</th>
                    <th class="text-right">Net</th>
                    <th>Paid</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_runs.Count == 0)
                {
                    <tr><td colspan="10">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No payroll runs yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _runs)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(row.PeriodLabel) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.PeriodLabel)</strong></td>
                            <td>@FormatDate(row.PeriodStart)</td>
                            <td>@FormatDate(row.PeriodEnd)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td class="text-right">@row.EmployeeCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.TotalGross.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.TotalDeductions.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.TotalNet.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@FormatDate(row.PaidAt)</td>
                            <td>
                                <a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "payroll_id", row.Id)">Open</a>
                                @if (!string.Equals(row.Status, "paid", StringComparison.OrdinalIgnoreCase))
                                {
                                    <form method="post" action="/erp/ajax/payroll-approve" style="margin:0;display:inline">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="/erp/payroll-app" />
                                        <input type="hidden" name="id" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                        <button type="submit" class="btn btn-xs btn-default">Approve</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Staff directory stays on <a href="/erp/staff-app">staff</a>. Generate, approve, line-days, and pay write here.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _listHref = "/erp/payroll-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpPayrollRunDigest> _runs = [];
    private int _count;
    private int _paid;
    private decimal _gross;
    private decimal _net;
    private string _source = "n/a";
    private string _message = "";
    private string _flash = "";
    private bool _flashOk;
    private long _openedId;
    private ErpPayrollRunDetail? _opened;
    private IReadOnlyList<ErpPayrollRunDigest> _openedSiblings = [];

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?payroll_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedCaption => _opened is null
        ? ""
        : (string.IsNullOrWhiteSpace(_opened.PeriodLabel)
            ? ("Run #" + _opened.Id.ToString(CultureInfo.InvariantCulture))
            : _opened.PeriodLabel)
            + (string.IsNullOrWhiteSpace(_opened.Status) ? "" : (" · " + _opened.Status));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "payroll_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        ReadFlash(ctx);
        var result = await Dashboards.ListErpPayrollRunsAsync(200, ctx.RequestAborted);
        _runs = result.Runs;
        _count = result.Count;
        _paid = result.PaidCount;
        _gross = result.GrossTotal;
        _net = result.NetTotal;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpPayrollRunDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Run;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _runs.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _runs = new[] { openedList }.Concat(_runs.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }

    private void ReadFlash(HttpContext ctx)
    {
        var ok = ctx.Request.Query["ok"].ToString();
        var err = ctx.Request.Query["err"].ToString();
        if (!string.IsNullOrWhiteSpace(ok)) { _flash = ok; _flashOk = true; }
        else if (!string.IsNullOrWhiteSpace(err)) { _flash = err; _flashOk = false; }
    }

    private static string FormatDate(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
