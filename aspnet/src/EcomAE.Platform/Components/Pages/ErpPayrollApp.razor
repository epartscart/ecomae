@page "/erp/payroll-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Payroll · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Payroll" BreadcrumbArea="People" BreadcrumbTab="Payroll">

    <PhpErpModulePageHeader Title="Payroll runs" Subtitle="Period totals from the shop payroll register. Approve writes on ASP.NET." />
    <PhpErpD365ActionPane RefreshHref="/erp/payroll-app" />

    @if (!string.IsNullOrWhiteSpace(_flash))
    {
        <div class="alert @(_flashOk ? "alert-success" : "alert-warning")" style="margin:0 0 12px">@_flash</div>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Payroll KPIs">
        <div class="kpi"><div class="lbl">Runs</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Paid</div><div class="val">@_paid.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Gross</div><div class="val">@_gross.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Net</div><div class="val">@_net.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Period</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Status</th>
                    <th class="text-right">Employees</th>
                    <th class="text-right">Gross</th>
                    <th class="text-right">Deductions</th>
                    <th class="text-right">Net</th>
                    <th>Paid</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_runs.Count == 0)
                {
                    <tr><td colspan="10">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No payroll runs yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _runs)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.PeriodLabel) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.PeriodLabel)</strong></td>
                            <td>@FormatDate(row.PeriodStart)</td>
                            <td>@FormatDate(row.PeriodEnd)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td class="text-right">@row.EmployeeCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.TotalGross.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.TotalDeductions.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.TotalNet.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@FormatDate(row.PaidAt)</td>
                            <td>
                                @if (!string.Equals(row.Status, "paid", StringComparison.OrdinalIgnoreCase))
                                {
                                    <form method="post" action="/erp/ajax/payroll-approve" style="margin:0">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="/erp/payroll-app" />
                                        <input type="hidden" name="id" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                        <button type="submit" class="btn btn-xs btn-primary">Approve</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Staff directory stays on <a href="/erp/staff-app">staff</a>. Approve is live on <code>/erp/ajax/payroll-approve</code>.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private IReadOnlyList<ErpPayrollRunDigest> _runs = [];
    private int _count;
    private int _paid;
    private decimal _gross;
    private decimal _net;
    private string _source = "n/a";
    private string _message = "";
    private string _flash = "";
    private bool _flashOk;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        ReadFlash(ctx);
        var result = await Dashboards.ListErpPayrollRunsAsync(200, ctx.RequestAborted);
        _runs = result.Runs;
        _count = result.Count;
        _paid = result.PaidCount;
        _gross = result.GrossTotal;
        _net = result.NetTotal;
        _source = result.Source;
        _message = result.Message;
    }

    private void ReadFlash(HttpContext ctx)
    {
        var ok = ctx.Request.Query["ok"].ToString();
        var err = ctx.Request.Query["err"].ToString();
        if (!string.IsNullOrWhiteSpace(ok)) { _flash = ok; _flashOk = true; }
        else if (!string.IsNullOrWhiteSpace(err)) { _flash = err; _flashOk = false; }
    }

    private static string FormatDate(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
