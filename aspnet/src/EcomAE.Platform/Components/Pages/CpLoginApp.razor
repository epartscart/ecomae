@page "/cp/login"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject NavigationManager Nav
@inject IHttpContextAccessor Http

<PageTitle>@_content.HeroTitle — Control Panel</PageTitle>
@* Tenant hosts: industry CP copy only. Super host: platform fleet messaging. *@
<PhpSurfaceHead Surface="cp" IncludeLoginCss="true" />
<PhpChromeBodyClass Surface="cp" LoginChrome="true" />

@* Markers: epc-cp-login-hero, #epcCpParticles *@

@* Body <style> duplicates HeadContent — live SSR drops HeadOutlet on /cp/login. *@
<HeadContent>
<style>
    html:has(.bos-login),
    body:has(.bos-login),
    body.bos-body--login {
        background: linear-gradient(135deg, #020617 0%, #0c1222 30%, #091428 60%, #050d1a 100%) !important;
        color: #e2e8f0 !important;
        min-height: 100vh;
        overflow-x: hidden;
    }
    .epc-login-bos.bos-login {
        width: 100%;
        min-height: 100vh;
        display: flex;
        position: relative;
        background: transparent;
        color: #e2e8f0;
    }
    .bos-login__error.is-visible {
        display: flex;
        align-items: center;
        gap: .4rem;
    }
</style>
</HeadContent>
<style>
    html:has(.bos-login),
    body:has(.bos-login),
    body.bos-body--login {
        background: linear-gradient(135deg, #020617 0%, #0c1222 30%, #091428 60%, #050d1a 100%) !important;
        color: #e2e8f0 !important;
        min-height: 100vh;
        overflow-x: hidden;
    }
    .epc-login-bos.bos-login {
        width: 100%;
        min-height: 100vh;
        display: flex;
        position: relative;
        background: transparent;
        color: #e2e8f0;
    }
    .bos-login__error.is-visible {
        display: flex;
        align-items: center;
        gap: .4rem;
    }
</style>

<div class="epc-login-bos bos-login @_brand.RootModifierClass epc-cp-login-hero"
     data-login-industry="@_content.IndustryCode"
     data-login-tenant="@_brand.SiteKey">
    <PhpBosLoginAtmosphere ParticlesId="epcCpParticles"
                           Theme="@_brand.AtmosphereTheme"
                           Industry="@_content.IndustryCode"
                           ParticleColors="@_brand.ParticleColors" />

    <div class="bos-login__hero">
        <div class="bos-login__hero-content">
            <div class="bos-login__brand-mark">
                @if (_brand.LogoKind != LoginHostBrand.Kind.Platform)
                {
                    <PhpLoginHostBrand Brand="@_brand" />
                    <h1 class="bos-login__brand-title">@_content.HeroTitle</h1>
                    <p class="bos-login__brand-tagline">@_content.HeroTagline</p>
                }
                else
                {
                    <div class="bos-login__brand-icon">
                        <div class="bos-login__brand-icon-inner">
                            <i class="fa fa-cogs"></i>
                        </div>
                        <div class="bos-login__brand-ring"></div>
                        <div class="bos-login__brand-ring bos-login__brand-ring--2"></div>
                    </div>
                    <h1 class="bos-login__brand-title">@_content.HeroTitle</h1>
                    <p class="bos-login__brand-tagline">@_content.HeroTagline</p>
                }
            </div>

            <div class="bos-login__capabilities">
                @{ var i = 0; }
                @foreach (var cap in _content.Capabilities)
                {
                    i++;
                    var iconTone = CapIconTone(i);
                    <div class="bos-login__cap-item bos-login__cap-item--@i">
                        <div class="bos-login__cap-icon bos-login__cap-icon--@iconTone bos-login__cap-icon--tone-@i"><i class="fa @cap.Icon"></i></div>
                        <div class="bos-login__cap-text">
                            <strong>@cap.Title</strong>
                            <span>@cap.Detail</span>
                        </div>
                    </div>
                }
            </div>

            <div class="bos-login__stats-bar">
                @for (var s = 0; s < _content.Stats.Count; s++)
                {
                    var stat = _content.Stats[s];
                    if (s > 0)
                    {
                        <div class="bos-login__stat-divider"></div>
                    }
                    <div class="bos-login__stat">
                        <span class="bos-login__stat-num" data-count="@stat.Value">0</span>
                        <span class="bos-login__stat-label">@stat.Label</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="bos-login__panel">
        <div class="bos-login__panel-inner">
            <div class="bos-login__form-wrap bos-login__form-wrap--active">
                <div class="bos-login__form-header">
                    <h2>@_content.FormTitle</h2>
                    <p>@_content.FormLead</p>
                </div>
                <PhpOAuthLoginButtons Context="cp" ReturnUrl="/cp" Tone="dark"
                                      Heading="Continue with Google — credentials stay private"
                                      TenantKey="@_brand.SiteKey" />
                <LoginAntiAutofill />
                <form class="bos-login__form" id="cpLoginForm" method="post" action="@EcomAeRoutes.ControlPanelLogin"
                      autocomplete="off" data-lpignore="true" data-1p-ignore="true" data-form-type="other">
                    <input type="hidden" name="surface" value="cp" />
                    <input type="hidden" name="redirect" value="/cp" />
                    <input type="hidden" name="contact_type" value="email" />
                    <div aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;">
                        <input type="text" name="epc_autofill_decoy_user" tabindex="-1" autocomplete="username" value="" />
                        <input type="password" name="epc_autofill_decoy_pass" tabindex="-1" autocomplete="current-password" value="" />
                    </div>
                    <div class="bos-login__field">
                        <label for="cpEmail"><i class="fa fa-envelope-o"></i> Email</label>
                        <input type="email" id="cpEmail" name="contact" required autocomplete="off"
                               autocapitalize="none" spellcheck="false"
                               data-lpignore="true" data-1p-ignore="true" data-bwignore="true"
                               data-epc-anti-autofill="1" readonly="readonly"
                               placeholder="operator@example.com" />
                        <div class="bos-login__field-line"></div>
                    </div>
                    <div class="bos-login__field">
                        <label for="cpPassword"><i class="fa fa-lock"></i> Password</label>
                        <input type="password" id="cpPassword" name="password" required autocomplete="new-password"
                               data-lpignore="true" data-1p-ignore="true" data-bwignore="true"
                               data-epc-anti-autofill="1" readonly="readonly"
                               placeholder="Enter secure password" />
                        <div class="bos-login__field-line"></div>
                    </div>
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="bos-login__error is-visible" id="cpLoginError">
                            <i class="fa fa-exclamation-circle"></i> @_error
                        </div>
                    }
                    else
                    {
                        <div class="bos-login__error" id="cpLoginError"></div>
                    }
                    <button type="submit" class="bos-login__btn">
                        <span class="bos-login__btn-text"><i class="fa fa-sign-in"></i> @_content.SubmitLabel</span>
                        <span class="bos-login__btn-loading"><i class="fa fa-circle-o-notch fa-spin"></i> Authenticating...</span>
                    </button>
                </form>
                <div class="bos-login__erp-features">
                    @foreach (var feat in _content.PanelFeatures)
                    {
                        <div class="bos-login__erp-feat"><i class="fa fa-check-circle"></i> @feat</div>
                    }
                </div>
                <div class="bos-login__secure-badge">
                    <i class="fa fa-lock"></i> @_content.SecureBadge
                </div>
            </div>

            <div class="bos-login__footer">
                <div class="bos-login__footer-brand">
                    <span class="bos-login__footer-logo">@_brand.Label</span>
                    <span class="bos-login__footer-sep">&middot;</span>
                    <span>@_content.IndustryCode.Replace('_', ' ') CP</span>
                    <span class="bos-login__footer-sep">&middot;</span>
                    <a href="/erp/login">ERP</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? _error;
    private LoginHostBrand.Brand _brand = LoginHostBrand.Resolve(null, "cp");
    private LoginIndustryContent.Content _content = LoginIndustryContent.For(LoginHostBrand.Resolve(null, "cp"), "cp");

    private static string CapIconTone(int index) => (index % 4) switch
    {
        1 => "erp",
        2 => "ecom",
        3 => "compliance",
        _ => "ai",
    };

    protected override void OnInitialized()
    {
        _error = LoginErrorHelper.FromUri(Nav.Uri);
        var host = Http.HttpContext?.Request.Host.Host;
        _brand = LoginHostBrand.Resolve(host, "cp");
        _content = LoginIndustryContent.For(_brand, "cp");
    }
}
