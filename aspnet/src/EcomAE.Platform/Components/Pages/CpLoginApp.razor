@page "/cp/login"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@inject NavigationManager Nav

<PageTitle>BOS Control — ECOM AE</PageTitle>
<PhpSurfaceHead Surface="cp" IncludeLoginCss="true" />
<PhpChromeBodyClass Surface="cp" LoginChrome="true" />
<link rel="stylesheet" href="/platform-assets/eparts-animated-logo.css" />
<link rel="stylesheet" href="/content/general_pages/epc_enterprise_login_3d.css?v=20260806a" />

@*
  Premium enterprise 3D login for Super CP / BOS Control.
  Keeps presentation markers: epc-cp-login-hero, #epcCpParticles, .ech-hub
*@

<div class="splash"> <div class="color-line"></div><div class="splash-title"><h1>BOS — Business Operation System</h1><p>Loading…</p><div class="spinner"> <div class="rect1"></div> <div class="rect2"></div> <div class="rect3"></div> <div class="rect4"></div> <div class="rect5"></div> </div> </div> </div>
<script>(function(){function epcHideCpSplash(){var s=document.querySelector('.splash');if(s){s.style.display='none';}}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',epcHideCpSplash);}else{epcHideCpSplash();}window.addEventListener('load',epcHideCpSplash);setTimeout(epcHideCpSplash,3500);})();</script>

<div class="eel-root eel-root--cp blank epc-cp epc-cp-login epc-cp-login-hero epc-cp-shell epc-cp-login--super">
    <EnterpriseLogin3dScene ParticlesId="epcCpParticles"
                            ParticlesExtraClass="epc-cp-particles"
                            ParticleCount="40"
                            ParticleColors="@(new[] { "rgba(244,63,94,.55)", "rgba(255,255,255,.3)", "rgba(14,165,233,.42)" })" />

    <div class="eel-stage">
        <aside class="eel-brand">
            <div class="eel-brand__mark">
                <img class="eel-brand__logo" src="@LegacyPresentationAssets.BrandMarkUrl" alt="" width="48" height="48" />
                <div class="eel-brand__wordmark">ECOM <span>AE</span></div>
            </div>
            <span class="eel-brand__badge">BOS · Control</span>
            <h1 class="eel-brand__title">Business Operation System</h1>
            <p class="eel-brand__sub">One secure login for fleet operators — command every tenant workspace from a single control plane.</p>
            <div class="eel-brand__visual">
                <PhpEcomaeHubLogo Variant="login-panel" AriaLabel="ECOM AE hub" OrbitDuration="28s" />
            </div>
            <div class="eel-brand__caps" aria-hidden="true">
                <div class="eel-brand__cap">
                    <i class="fa fa-globe" aria-hidden="true"></i>
                    <div>
                        <strong>Fleet command</strong>
                        <span>Commerce, ERP-only &amp; demo tenants</span>
                    </div>
                </div>
                <div class="eel-brand__cap">
                    <i class="fa fa-shield" aria-hidden="true"></i>
                    <div>
                        <strong>Platform governance</strong>
                        <span>Health, failover &amp; operator isolation</span>
                    </div>
                </div>
            </div>
        </aside>

        <section class="eel-panel" aria-label="Control panel sign-in">
            <div class="eel-panel__card">
                <div class="eel-panel__head">
                    <p class="eel-panel__eyebrow">Secure access</p>
                    <h2 class="eel-panel__title">Sign in to Control</h2>
                    <p class="eel-panel__lead">Operators control the whole fleet. Tenants see only their own area.</p>
                </div>

                <div class="login-container">
                    <div class="hpanel">
                        <div class="panel-body">
                            <LegacyAdminLoginForm Surface="LegacyLoginSurface.ControlPanel"
                                                  SurfaceLabel="CP"
                                                  PhpLoginHref="/php-reference/cp"
                                                  ErrorMessage="@_error"
                                                  SubmitLabel="Enter Control Panel"
                                                  Accent="blue" />
                            <ul class="eel-features epc-cp-login-features epc-cp-login-features--card">
                                <li><i class="fa fa-rocket" aria-hidden="true"></i><span>Tenant onboarding, templates &amp; module packs</span></li>
                                <li><i class="fa fa-th-large" aria-hidden="true"></i><span>@PhpModuleCatalog.CpBrochureFeatureCount CP features catalogued</span></li>
                                <li><i class="fa fa-lock" aria-hidden="true"></i><span>Role-scoped sessions · audit-ready</span></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="eel-footer login-footer">
                ECOM AE · BOS authentication ·
                <a href="/erp/login">ERP Finance</a>
            </div>
        </section>
    </div>
</div>

@code {
    private string? _error;
    protected override void OnInitialized() => _error = LoginErrorHelper.FromUri(Nav.Uri);
}
