@page "/cp/login"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject NavigationManager Nav
@inject IHttpContextAccessor Http

<PageTitle>@_brand.Label — Control Panel</PageTitle>
@* BOS login shell; tenant hosts show animated/catalog logo; atmosphere theme per tenant. *@
<PhpSurfaceHead Surface="cp" IncludeLoginCss="true" />
<PhpChromeBodyClass Surface="cp" LoginChrome="true" />

<style>
    html:has(.bos-login),
    body:has(.bos-login),
    body.bos-body--login {
        background: linear-gradient(135deg, #020617 0%, #0c1222 30%, #091428 60%, #050d1a 100%) !important;
        color: #e2e8f0 !important;
        min-height: 100vh;
        overflow-x: hidden;
    }
    .epc-login-bos.bos-login {
        width: 100%;
        min-height: 100vh;
        display: flex;
        position: relative;
        background: transparent;
        color: #e2e8f0;
    }
    .bos-login__error.is-visible {
        display: flex;
        align-items: center;
        gap: .4rem;
    }
</style>

@* Markers: epc-cp-login-hero, #epcCpParticles *@
<div class="epc-login-bos bos-login @_brand.RootModifierClass epc-cp-login-hero">
    <PhpBosLoginAtmosphere ParticlesId="epcCpParticles"
                           Theme="@_brand.AtmosphereTheme"
                           ParticleColors="@_brand.ParticleColors" />

    <div class="bos-login__hero">
        <div class="bos-login__hero-content">
            <div class="bos-login__brand-mark">
                @if (_brand.LogoKind != LoginHostBrand.Kind.Platform)
                {
                    <PhpLoginHostBrand Brand="@_brand" />
                    <h1 class="bos-login__brand-title">@_brand.Label</h1>
                    <p class="bos-login__brand-tagline">Control Panel · @_brand.Tagline</p>
                }
                else
                {
                    <div class="bos-login__brand-icon">
                        <div class="bos-login__brand-icon-inner">
                            <i class="fa fa-cogs"></i>
                        </div>
                        <div class="bos-login__brand-ring"></div>
                        <div class="bos-login__brand-ring bos-login__brand-ring--2"></div>
                    </div>
                    <h1 class="bos-login__brand-title">@_brand.Label</h1>
                    <p class="bos-login__brand-tagline">@_brand.Tagline</p>
                }
            </div>

            <div class="bos-login__capabilities">
                <div class="bos-login__cap-item bos-login__cap-item--1">
                    <div class="bos-login__cap-icon bos-login__cap-icon--erp"><i class="fa fa-globe"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>@(_isTenant ? "Store operations" : "Fleet command")</strong>
                        <span>@(_isTenant ? "Catalog, orders &amp; customers" : "Commerce, ERP-only &amp; demo tenants")</span>
                    </div>
                </div>
                <div class="bos-login__cap-item bos-login__cap-item--2">
                    <div class="bos-login__cap-icon bos-login__cap-icon--ecom"><i class="fa fa-rocket"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>@(_isTenant ? "ERP workspace" : "Tenant onboarding")</strong>
                        <span>@(_isTenant ? "Finance, stock &amp; fulfilment" : "Templates, packs &amp; provisioning")</span>
                    </div>
                </div>
                <div class="bos-login__cap-item bos-login__cap-item--3">
                    <div class="bos-login__cap-icon bos-login__cap-icon--compliance"><i class="fa fa-shield"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>Secure sessions</strong>
                        <span>Role-scoped · audit-ready · isolated</span>
                    </div>
                </div>
                <div class="bos-login__cap-item bos-login__cap-item--4">
                    <div class="bos-login__cap-icon bos-login__cap-icon--ai"><i class="fa fa-th-large"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>@PhpModuleCatalog.CpBrochureFeatureCount CP features</strong>
                        <span>Operator modules catalogue</span>
                    </div>
                </div>
            </div>

            <div class="bos-login__stats-bar">
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="225">0</span>
                    <span class="bos-login__stat-label">Tenants</span>
                </div>
                <div class="bos-login__stat-divider"></div>
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="11">0</span>
                    <span class="bos-login__stat-label">Industries</span>
                </div>
                <div class="bos-login__stat-divider"></div>
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="95">0</span>
                    <span class="bos-login__stat-label">ERP Modules</span>
                </div>
                <div class="bos-login__stat-divider"></div>
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="15">0</span>
                    <span class="bos-login__stat-label">Countries</span>
                </div>
            </div>
        </div>
    </div>

    <div class="bos-login__panel">
        <div class="bos-login__panel-inner">
            <div class="bos-login__form-wrap bos-login__form-wrap--active">
                <div class="bos-login__form-header">
                    <h2>Operator Access</h2>
                    <p>Sign in to @_brand.Label control panel</p>
                </div>
                <form class="bos-login__form" id="cpLoginForm" method="post" action="@EcomAeRoutes.ControlPanelLogin">
                    <input type="hidden" name="surface" value="cp" />
                    <input type="hidden" name="redirect" value="/cp" />
                    <input type="hidden" name="contact_type" value="email" />
                    <div class="bos-login__field">
                        <label for="cpEmail"><i class="fa fa-envelope-o"></i> Email</label>
                        <input type="email" id="cpEmail" name="contact" required autocomplete="username" placeholder="operator@example.com" />
                        <div class="bos-login__field-line"></div>
                    </div>
                    <div class="bos-login__field">
                        <label for="cpPassword"><i class="fa fa-lock"></i> Password</label>
                        <input type="password" id="cpPassword" name="password" required autocomplete="current-password" placeholder="Enter secure password" />
                        <div class="bos-login__field-line"></div>
                    </div>
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="bos-login__error is-visible" id="cpLoginError">
                            <i class="fa fa-exclamation-circle"></i> @_error
                        </div>
                    }
                    else
                    {
                        <div class="bos-login__error" id="cpLoginError"></div>
                    }
                    <button type="submit" class="bos-login__btn">
                        <span class="bos-login__btn-text"><i class="fa fa-sign-in"></i> Sign In to Control Panel</span>
                        <span class="bos-login__btn-loading"><i class="fa fa-circle-o-notch fa-spin"></i> Authenticating...</span>
                    </button>
                </form>
                <div class="bos-login__secure-badge">
                    <i class="fa fa-lock"></i> 256-bit encrypted &middot; Session isolated &middot; Audit logged
                </div>
            </div>

            <div class="bos-login__footer">
                <div class="bos-login__footer-brand">
                    <span class="bos-login__footer-logo">ECOM<span>AE</span></span>
                    <span class="bos-login__footer-sep">&middot;</span>
                    <span>@_brand.Label CP</span>
                    <span class="bos-login__footer-sep">&middot;</span>
                    <a href="/erp/login">ERP</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? _error;
    private LoginHostBrand.Brand _brand = LoginHostBrand.Resolve(null, "cp");
    private bool _isTenant;

    protected override void OnInitialized()
    {
        _error = LoginErrorHelper.FromUri(Nav.Uri);
        var host = Http.HttpContext?.Request.Host.Host;
        _brand = LoginHostBrand.Resolve(host, "cp");
        _isTenant = _brand.LogoKind != LoginHostBrand.Kind.Platform;
    }
}
