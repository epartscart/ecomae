@page "/storefront/tur-catalog-app"
@page "/en/catalog-tur"
@page "/catalog-tur"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation

<PageTitle>auto247-Tur Catalog · eParts Cart</PageTitle>
<PhpChromeStyles Surface="storefront" />
<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontCatalogWidgetBody Title="auto247-Tur"
                            Subtitle="Aftermarket brand catalog — manufacturer tiles and article drill-down."
                            AnchorId="epc-tur"
                            Html="@_html">
    <a class="btn btn-sm btn-primary" href="@StorefrontSurfaceLinks.PartSearch">Part search</a>
    <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.ProductFamily">Product family</a>
    <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.VehicleCatalog">Vehicle catalog</a>
</StorefrontCatalogWidgetBody>

@code {
    private string _html = "";

    protected override void OnInitialized()
    {
        _html = PhpHomeWidgetHtml.RenderStatic("content/general_pages/epc_rendered_widgets/catalog_tur.html");
        if (string.IsNullOrWhiteSpace(_html))
        {
            _html = "<p style=\"margin:0;color:#64748b\">Catalog widget is unavailable in this environment. "
                  + "<a href=\"" + StorefrontSurfaceLinks.PartSearch + "\">Open part search</a>.</p>";
        }
    }
}
