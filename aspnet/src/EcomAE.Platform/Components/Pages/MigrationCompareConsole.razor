@page "/migration/compare"
@layout Layout.MigrationConsoleLayout

@{
    // Honest live probe (2026-08-04 post-shadow install): digests 127/127, presentation apps 142/144.
    // Product chrome on tenants remains PHP; ASP.NET compare is www.ecomae.com hybrid only.
}

<style>
    h1 {
        margin: 0 0 0.65rem;
        font-size: clamp(1.35rem, 3vw, 1.85rem);
        font-weight: 600;
        letter-spacing: -0.02em;
    }
    .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.1rem 0 1.75rem; }
    .cta {
        display: inline-flex;
        align-items: center;
        padding: 0.65rem 1rem;
        border-radius: 0.55rem;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.92rem;
        transition: transform 0.2s ease, background 0.2s ease;
    }
    .cta:hover { transform: translateY(-2px); }
    .cta-primary { background: var(--accent); color: #062016; }
    .cta-ghost { background: var(--panel); color: var(--ink); border: 1px solid var(--line); }
    .banner {
        margin: 0 0 1.5rem;
        padding: 0.85rem 1rem;
        border: 1px solid rgba(230,179,92,0.45);
        border-radius: 0.55rem;
        background: rgba(230,179,92,0.08);
        color: #f0d9a8;
        font-size: 0.9rem;
        line-height: 1.5;
        animation: rise 0.55s ease both;
    }
    .meter {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 0.75rem;
        margin: 0 0 1.75rem;
    }
    .metric {
        padding: 0.9rem 1rem;
        border: 1px solid var(--line);
        border-radius: 0.65rem;
        background: var(--panel);
        animation: rise 0.7s ease both;
    }
    .metric:nth-child(2) { animation-delay: 0.06s; }
    .metric:nth-child(3) { animation-delay: 0.12s; }
    .metric:nth-child(4) { animation-delay: 0.18s; }
    .metric strong {
        display: block;
        font-size: 1.35rem;
        font-family: "IBM Plex Mono", monospace;
        margin-bottom: 0.15rem;
    }
    .metric span { color: var(--muted); font-size: 0.82rem; }
    .section { margin: 0 0 2rem; }
    .section h2 {
        margin: 0 0 0.4rem;
        font-size: 1.08rem;
        font-weight: 600;
    }
    .section p { color: var(--muted); margin: 0 0 0.85rem; line-height: 1.5; font-size: 0.92rem; }
    table.compare {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
        animation: rise 0.65s ease both;
    }
    table.compare th, table.compare td {
        border-bottom: 1px solid var(--line);
        padding: 0.65rem 0.55rem;
        text-align: left;
        vertical-align: top;
    }
    table.compare th {
        color: var(--muted);
        font-weight: 600;
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    table.compare a { color: #9fd7ff; text-decoration: none; }
    table.compare a:hover { text-decoration: underline; }
    .stack {
        display: inline-block;
        padding: 0.12rem 0.4rem;
        border-radius: 0.3rem;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.72rem;
        border: 1px solid var(--line);
    }
    .stack.php { color: #9fd7ff; }
    .stack.aspnet { color: var(--accent); }
    .stack.safe { color: var(--warn); }
    code { font-family: "IBM Plex Mono", monospace; font-size: 0.84em; color: #d5ebe8; }
    ul.check {
        margin: 0;
        padding-left: 1.1rem;
        color: var(--muted);
        line-height: 1.55;
        font-size: 0.9rem;
    }
    ul.check li { margin-bottom: 0.35rem; }
</style>

<p class="lede">
    Side-by-side links so you can compare Super CP and tenant ePartsCart in PHP vs ASP.NET hybrid previews.
    Product chrome stays PHP-authoritative; ASP.NET is exact-route shadow / hybrid only.
