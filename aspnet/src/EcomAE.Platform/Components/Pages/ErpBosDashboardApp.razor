@page "/erp/app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Ecom BOS Dashboard · ERP</PageTitle>
<PhpChromeStyles Surface="erp" />

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Dashboard" BreadcrumbArea="Home" BreadcrumbTab="Dashboard">
    <PhpHybridWorkspaceFrame PhpHref="@_phpHref" ClearHref="/erp/app" />

    @if (string.IsNullOrWhiteSpace(_phpHref))
    {
        <style>
            .epc-erp-grid { display:grid; grid-template-columns:1.2fr 1fr; gap:.85rem; margin-bottom:1rem; }
            .epc-erp-card { background:#fff; border:1px solid #e2e8f0; border-radius:.65rem; padding:1rem 1.1rem; }
            .epc-erp-metrics { display:grid; grid-template-columns:1fr 1fr; gap:.55rem; }
            .epc-erp-metric strong { display:block; font-size:1.2rem; font-variant-numeric:tabular-nums; }
            .epc-erp-metric span { color:#64748b; font-size:.75rem; }
            .epc-erp-banners { display:grid; gap:.55rem; margin:1rem 0; }
            .epc-erp-banner { border-radius:.65rem; padding:1rem 1.15rem; color:#fff; font-weight:700; display:flex; justify-content:space-between; align-items:center; text-decoration:none; }
            .epc-erp-kpis { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:.55rem; }
            .epc-erp-note { margin-top:1rem; padding:.75rem .9rem; background:#eff6ff; border:1px solid #bfdbfe; border-radius:.45rem; color:#1e3a8a; font-size:.86rem; }
            @@media (max-width:900px){ .epc-erp-grid,.epc-erp-kpis{grid-template-columns:1fr 1fr;} }
        </style>

        <div class="epc-erp-grid">
            <section class="epc-erp-card">
                <h2 style="margin:.1rem 0 .4rem;font-size:1.05rem">ADMINISTRATION CENTRE — Operations</h2>
                <p style="margin:0;color:#64748b;font-size:.9rem">Batch 2: <code>epc-erp-topbar</code> + <code>epc-erp-topnav</code> mega panels (erp_desktop / erp_main). Tab bodies stay PHP.</p>
            </section>
            <section class="epc-erp-metrics">
                <div class="epc-erp-card epc-erp-metric"><strong>@_cash.ToString("N2")</strong><span>CASH &amp; BANK</span></div>
                <div class="epc-erp-card epc-erp-metric"><strong>@_purchases</strong><span>ACTIVE PURCHASES</span></div>
                <div class="epc-erp-card epc-erp-metric"><strong>@_suppliers</strong><span>ACTIVE SUPPLIERS</span></div>
                <div class="epc-erp-card epc-erp-metric"><strong>@_accounts</strong><span>CASH ACCOUNTS</span></div>
            </section>
        </div>

        <div class="epc-erp-banners">
            <a class="epc-erp-banner" style="background:linear-gradient(90deg,#ea580c,#f97316)" href="@PhpModuleCatalog.HybridWorkspaceHref("/erp/app", "/ERP/?epc_erp_shell=1&area=finance")">Income Statement</a>
            <a class="epc-erp-banner" style="background:linear-gradient(90deg,#1e3a8a,#2563eb)" href="@PhpModuleCatalog.HybridWorkspaceHref("/erp/app", "/ERP/?epc_erp_shell=1&area=finance")">Balance Sheet</a>
            <a class="epc-erp-banner" style="background:linear-gradient(90deg,#115e59,#0d9488)" href="@PhpModuleCatalog.HybridWorkspaceHref("/erp/app", "/ERP/?epc_erp_shell=1&area=finance")">General Journal</a>
            <a class="epc-erp-banner" style="background:linear-gradient(90deg,#1d4ed8,#3b82f6)" href="@PhpModuleCatalog.HybridWorkspaceHref("/erp/app", "/ERP/?epc_erp_shell=1&area=sales")">New Sales Order</a>
        </div>

        <section>
            <h2 style="font-size:1.05rem">Operational KPIs — @_source</h2>
            <div class="epc-erp-kpis">
                <div class="epc-erp-card epc-erp-metric"><strong>@_cash.ToString("N2")</strong><span>Cash position</span></div>
                <div class="epc-erp-card epc-erp-metric"><strong>@_credit.ToString("N2")</strong><span>Supplier credit</span></div>
                <div class="epc-erp-card epc-erp-metric"><strong>@_debit.ToString("N2")</strong><span>Supplier debit</span></div>
                <div class="epc-erp-card epc-erp-metric"><strong>@_net.ToString("N2")</strong><span>Supplier net</span></div>
                <div class="epc-erp-card epc-erp-metric"><strong>TOPNAV</strong><span>epc-erp-topnav</span></div>
            </div>
        </section>

        <PhpHybridModuleDirectory
            Title="Complete ERP area directory"
            Subtitle="@($"{PhpModuleCatalog.ErpAreaCount} areas · {PhpModuleCatalog.ErpTabCount} tabs from PHP erp_nav_areas.php")"
            Links="@PhpModuleCatalog.ErpAreas"
            PhpWorkspaceBase="/erp/app" />

        <PhpHybridModuleDirectory
            Title="Complete ERP tab directory"
            Subtitle="Every tab deeplinks to live PHP ERP shell"
            Links="@PhpModuleCatalog.ErpTabs"
            PhpWorkspaceBase="/erp/app" />

        <div class="epc-erp-note">
            @_note Live PHP ERP UI remains at <a href="/ERP/">/ERP/</a>. Desktop chrome classes match erp_desktop.php / erp_main.php.
        </div>
    }
</PhpErpDesktopChrome>

@code {
    private decimal _cash;
    private decimal _credit;
    private decimal _debit;
    private decimal _net;
    private int _accounts;
    private int _suppliers;
    private int _purchases;
    private string _source = "n/a";
    private string _note = "Admin session required for digest KPIs. ";
    private bool _isAdmin;
    private string? _phpHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        if (ctx.Request.Query.TryGetValue("php", out var php) && !string.IsNullOrWhiteSpace(php))
        {
            _phpHref = php.ToString();
        }
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin)
        {
            Nav.NavigateTo("/erp/login", forceLoad: true);
            return;
        }
        _isAdmin = true;
        var summary = await Dashboards.BuildErpAsync(ctx.RequestAborted);
        _cash = summary.CashPosition;
        _credit = summary.SupplierCredit;
        _debit = summary.SupplierDebit;
        _net = summary.SupplierNet;
        _accounts = summary.CashAccounts;
        _suppliers = summary.ActiveSuppliers;
        _purchases = summary.ActivePurchases;
        _source = summary.Source;
        _note = "Admin session detected — KPIs from ASP.NET ERP digest reporter. ";
    }
}
