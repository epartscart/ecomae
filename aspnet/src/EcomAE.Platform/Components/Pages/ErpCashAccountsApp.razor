@page "/erp/cash-accounts-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Cash &amp; Bank · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Cash & Bank" BreadcrumbArea="Cash & Treasury" BreadcrumbTab="Cash & bank">

    
    <PhpErpModulePageHeader Title="@_title" Subtitle="@_subtitle" PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="/erp/cash-accounts-app" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin && _view == "cash_bank")
    {
        <form method="post" action="/erp/offices-cash/add" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/cash-accounts-app" />
            <label>Office id <input type="number" name="officeId" min="1" required style="width:6rem" /></label>
            <label>Income
                <select name="income">
                    <option value="1">In</option>
                    <option value="0">Out</option>
                </select>
            </label>
            <label>Amount <input type="text" name="amount" required style="width:6rem" /></label>
            <label>Code id <input type="number" name="name" min="1" required style="width:6rem" /></label>
            <label>Comment <input type="text" name="comment" /></label>
            <button type="submit">Add office cash</button>
        </form>
        <form method="post" action="/erp/offices-cash/codes/add" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/cash-accounts-app" />
            <label>Office id <input type="number" name="officeId" min="1" required style="width:6rem" /></label>
            <label>Income
                <select name="income">
                    <option value="1">In</option>
                    <option value="0">Out</option>
                </select>
            </label>
            <label>Name <input type="text" name="name" required maxlength="255" /></label>
            <button type="submit">Add cash code</button>
        </form>
        <form method="post" action="/erp/offices-cash/codes/delete" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/cash-accounts-app" />
            <label>Office id <input type="number" name="officeId" min="1" required style="width:6rem" /></label>
            <label>Code id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <button type="submit">Delete cash code</button>
        </form>
    }

    <p class="text-muted" style="margin:8px 0 12px;">
        <a href="/erp/cash-accounts-app">Cash &amp; bank</a>
        · <a href="/erp/cash-accounts-app?tab=bank_setup">Bank setup</a>
        · <a href="/erp/cash-accounts-app?tab=petty_cash">Petty cash</a>
        · <a href="/erp/cash-accounts-app?tab=jw_petty_cash">Jewellery petty cash</a>
        · <a href="/erp/cash-accounts-app?tab=cash_forecast">Cash forecast</a>
    </p>

    @if (_view == "petty_cash")
    {
        @if (_isAdmin)
        {
            <form method="post" action="@EcomAeRoutes.ErpJewelleryPettyCashSaveForm" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/erp/cash-accounts-app?tab=jw_petty_cash" />
                <label>Paid to <input type="text" name="paid_to" required maxlength="120" /></label>
                <label>Account <input type="text" name="account_code" maxlength="20" placeholder="PETTY-CASH" /></label>
                <label>Amount <input type="number" name="total" step="0.01" value="0" style="width:6rem" /></label>
                <label>Narration <input type="text" name="narration" maxlength="200" /></label>
                <button type="submit">Save petty cash</button>
            </form>
        }
        <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Petty cash KPIs">
            <div class="kpi"><div class="lbl">Active floats</div><div class="val">@_floats.Count.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Float total</div><div class="val">@_floats.Sum(f => f.FloatAmount).ToString("N2", CultureInfo.InvariantCulture)</div></div>
        </div>
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th class="text-right">Float</th>
                        <th>Account</th>
                        <th class="text-right">Account opening</th>
                        <th>Custodian</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_floats.Count == 0)
                    {
                        <tr><td colspan="5">@(_isAdmin ? (string.IsNullOrWhiteSpace(_accountsMessage) ? "No petty cash floats configured." : _accountsMessage) : "Sign in with ERP capability for live rows.")</td></tr>
                    }
                    else
                    {
                        @foreach (var f in _floats)
                        {
                            <tr>
                                <td><strong>@f.Name</strong></td>
                                <td class="text-right">@f.FloatAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@(string.IsNullOrWhiteSpace(f.AccountName) ? (f.AccountId > 0 ? $"#{f.AccountId}" : "—") : f.AccountName)</td>
                                <td class="text-right">@f.AccountBalance.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@(f.CustodianUserId > 0 ? f.CustodianUserId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <ErpPhpCreateWell Title="Add forecast line">
<form method="post" action="/erp/cash-forecast/lines/add" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                    <input type="hidden" name="returnUrl" value="/erp/cash-accounts-app?tab=cash_forecast" />
                    <input type="hidden" name="confirmWrites" value="true" />
                    <label>Forecast id <input class="form-control input-sm" type="number" name="forecast_id" min="1" required style="width:80px;" /></label>
                    <label>Due date <input class="form-control input-sm" type="date" name="due_date" required /></label>
                    <label>Direction
                        <select class="form-control input-sm" name="direction">
                            <option value="in">Inflow</option>
                            <option value="out">Outflow</option>
                        </select>
                    </label>
                    <label>Amount <input class="form-control input-sm" type="number" step="0.01" name="amount" required style="width:90px;" /></label>
                    <label>Category <input class="form-control input-sm" name="category" placeholder="AR / AP / Payroll" style="width:140px;" /></label>
                    <label>Source <input class="form-control input-sm" name="source" style="width:120px;" /></label>
                    <button type="submit" class="btn btn-success btn-sm">Add line</button>
                </form>
</ErpPhpCreateWell>
        <ErpPhpCreateWell Title="New forecast">
<form method="post" action="@EcomAeRoutes.ErpCashForecastSave" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                    <input type="hidden" name="returnUrl" value="/erp/cash-accounts-app?tab=cash_forecast" />
                    <input type="hidden" name="confirmWrites" value="true" />
                    <label>Name <input class="form-control input-sm" name="name" placeholder="Name" style="width:180px;" required /></label>
                    <label>Opening <input class="form-control input-sm" name="opening_balance" value="0" style="width:90px;" /></label>
                    <label>Currency <input class="form-control input-sm" name="currency" placeholder="AED" style="width:70px;" /></label>
                    <label>Notes <input class="form-control input-sm" name="notes" placeholder="Notes" style="width:180px;" /></label>
                    <button type="submit" class="btn btn-primary btn-sm">Save</button>
                </form>
</ErpPhpCreateWell>
    }
    else if (_view == "cash_forecast")
    {
        <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Cash forecast KPIs">
            <div class="kpi"><div class="lbl">Forecasts</div><div class="val">@_forecast.ForecastCount.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Opening</div><div class="val">@_forecast.Opening.ToString("N2", CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Total in</div><div class="val">@_forecast.TotalIn.ToString("N2", CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Total out</div><div class="val">@_forecast.TotalOut.ToString("N2", CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Closing</div><div class="val">@_forecast.Closing.ToString("N2", CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Min balance</div><div class="val">@_forecast.MinBalance.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        </div>
        <h2 style="font-size:16px;">Forecasts</h2>
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th class="text-right">Opening</th>
                        <th>Currency</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_forecasts.Count == 0)
                    {
                        <tr><td colspan="3">@(_isAdmin ? (string.IsNullOrWhiteSpace(_accountsMessage) ? "No cash-flow forecasts yet." : _accountsMessage) : "Sign in with ERP capability for live rows.")</td></tr>
                    }
                    else
                    {
                        @foreach (var f in _forecasts)
                        {
                            <tr>
                                <td><strong>@f.Name</strong></td>
                                <td class="text-right">@f.OpeningBalance.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@(string.IsNullOrWhiteSpace(f.Currency) ? "—" : f.Currency)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <h2 style="font-size:16px;margin-top:16px;">Projection lines</h2>
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Source</th>
                        <th class="text-right">In</th>
                        <th class="text-right">Out</th>
                        <th class="text-right">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_forecastLines.Count == 0)
                    {
                        <tr><td colspan="6">No forecast lines on the selected forecast.</td></tr>
                    }
                    else
                    {
                        @foreach (var line in _forecastLines)
                        {
                            var inflow = string.Equals(line.Direction, "out", StringComparison.OrdinalIgnoreCase) ? 0m : line.Amount;
                            var outflow = string.Equals(line.Direction, "out", StringComparison.OrdinalIgnoreCase) ? line.Amount : 0m;
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(line.DueDate) ? "—" : line.DueDate)</td>
                                <td>@(string.IsNullOrWhiteSpace(line.Category) ? "—" : line.Category)</td>
                                <td>@(string.IsNullOrWhiteSpace(line.Source) ? "—" : line.Source)</td>
                                <td class="text-right">@(inflow == 0m ? "—" : inflow.ToString("N2", CultureInfo.InvariantCulture))</td>
                                <td class="text-right">@(outflow == 0m ? "—" : outflow.ToString("N2", CultureInfo.InvariantCulture))</td>
                                <td class="text-right">@line.RunningBalance.ToString("N2", CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Cash KPIs">
        <div class="kpi"><div class="lbl">Accounts (limit @_limit)</div><div class="val">@_accounts.Count</div></div>
        <div class="kpi"><div class="lbl">Sum of balances</div><div class="val">@_totalBalance.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Recent entries shown</div><div class="val">@_entries.Count</div></div>
    </div>

    @if (_openedDetail is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="/erp/cash-accounts-app">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Account id</dt><dd>@_openedDetail.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.Name) ? "—" : _openedDetail.Name)</dd>
                <dt>Type</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.AccountType) ? "—" : _openedDetail.AccountType)</dd>
                <dt>Currency</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.CurrencyCode) ? "—" : _openedDetail.CurrencyCode)</dd>
                <dt>Opening</dt><dd>@_openedDetail.OpeningBalance.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Office</dt><dd>@(_openedDetail.OfficeId > 0 ? _openedDetail.OfficeId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Created</dt><dd>@FormatTime(_openedDetail.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Office cash, petty cash, and forecast write here. Writes stay Classic for account create.</p>
            @if (!string.IsNullOrWhiteSpace(_openedDetail.BankNameExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">bank-name excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedDetail.BankNameExcerpt</pre>
                @if (_openedDetail.BankNameLen > _openedDetail.BankNameExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_openedDetail.BankNameExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedDetail.BankNameLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No bank-name excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-type siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Account</th><th>Currency</th><th class="text-right">Opening</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Name) ? "—" : sib.Name)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.CurrencyCode) ? "—" : sib.CurrencyCode)</td>
                                <td class="text-right">@sib.OpeningBalance.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href("/erp/cash-accounts-app", "account_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-type siblings yet.</p>
            }
        </div>
    }

    <div class="epc-cash-section">
        <h2>Cash accounts</h2>
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead>
                    <tr>
                        <th>Account</th>
                        <th>Type</th>
                        <th>Currency</th>
                        <th>Opening</th>
                        <th>Balance</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_accounts.Count == 0)
                    {
                        <tr><td colspan="6">No cash accounts yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var a in _accounts)
                        {
                            <tr id="erp-row-@a.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(a.Id, _openedId)">
                                <td><strong>@(string.IsNullOrWhiteSpace(a.Name) ? $"#{a.Id}" : a.Name)</strong></td>
                                <td><span class="label label-default">@a.AccountType</span></td>
                                <td>@(string.IsNullOrWhiteSpace(a.CurrencyCode) ? "—" : a.CurrencyCode)</td>
                                <td>@a.OpeningBalance.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@a.Balance.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href("/erp/cash-accounts-app", "account_id", a.Id)">Open</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="epc-cash-section">
        <h2>Recent cash entries</h2>
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Account</th>
                        <th>Direction</th>
                        <th>Amount</th>
                        <th>Reference</th>
                        <th>Note</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_entries.Count == 0)
                    {
                        <tr><td colspan="7">No cash entries yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var e in _entries)
                        {
                            <tr id="erp-row-@e.Id.ToString(CultureInfo.InvariantCulture)">
                                <td>@FormatTime(e.TimeUnix)</td>
                                <td>@(string.IsNullOrWhiteSpace(e.AccountName) ? $"#{e.AccountId}" : e.AccountName)</td>
                                <td><span class="label label-default">@FormatDirection(e.Direction)</span></td>
                                <td>@e.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@(string.IsNullOrWhiteSpace(e.Reference) ? "—" : e.Reference)</td>
                                <td>@(string.IsNullOrWhiteSpace(e.Note) ? "—" : e.Note)</td>
                                <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href("/erp/cash-entries-app", "entry_id", e.Id)">Open</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    }

</PhpErpDesktopChrome>

@code {
    private string _phpTab = "/ERP/?epc_erp_shell=1&area=banking&tab=cash_bank";
    private string _title = "Cash & Bank";
    private string _subtitle = "Cash and bank accounts with recent ledger entries.";
    private string _view = "cash_bank";
    private bool _isAdmin;
    private IReadOnlyList<ErpCashAccountDigest> _accounts = [];
    private IReadOnlyList<ErpCashEntryDigest> _entries = [];
    private IReadOnlyList<ErpPettyCashDigest> _floats = [];
    private ErpCashForecastSummary _forecast = new(0, 0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<ErpCashForecastDigest> _forecasts = [];
    private IReadOnlyList<ErpCashForecastLineDigest> _forecastLines = [];
    private decimal _totalBalance;
    private int _limit = 100;
    private string _accountsSource = "n/a";
    private string _accountsMessage = "";
    private string _entriesSource = "n/a";
    private string _entriesMessage = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private ErpCashAccountDigest? _openedAccount;
    private ErpCashAccountDetail? _openedDetail;
    private IReadOnlyList<ErpCashAccountDigest> _openedSiblings = [];

    private bool OpenedFound => _openedDetail is not null || _openedAccount is not null;

    private string OpenedReturnHref => _openedId > 0
        ? "/erp/cash-accounts-app?account_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : "/erp/cash-accounts-app";

    private string OpenedCaption => _openedDetail is not null
        ? (string.IsNullOrWhiteSpace(_openedDetail.Name) ? ("Account #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.Name)
            + (string.IsNullOrWhiteSpace(_openedDetail.AccountType) ? "" : (" · " + _openedDetail.AccountType))
        : _openedAccount is null
            ? ""
            : (string.IsNullOrWhiteSpace(_openedAccount.Name) ? $"Account #{_openedAccount.Id}" : _openedAccount.Name);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "account_id");

        var tab = (ctx.Request.Query["tab"].ToString() ?? "").Trim().ToLowerInvariant();
        _view = tab is "petty_cash" or "jw_petty_cash" ? "petty_cash"
            : tab == "cash_forecast" ? "cash_forecast"
            : tab == "bank_setup" ? "bank_setup"
            : "cash_bank";
        _phpTab = _view switch
        {
            "petty_cash" => "/ERP/?epc_erp_shell=1&area=banking&tab=petty_cash",
            "cash_forecast" => "/ERP/?epc_erp_shell=1&area=banking&tab=cash_forecast",
            "bank_setup" => "/ERP/?epc_erp_shell=1&area=banking&tab=bank_setup",
            _ => "/ERP/?epc_erp_shell=1&area=banking&tab=cash_bank"
        };
        _title = _view switch
        {
            "petty_cash" => "Petty cash",
            "cash_forecast" => "Cash flow forecast",
            "bank_setup" => "Bank setup",
            _ => "Cash & Bank"
        };
        _subtitle = _view switch
        {
            "petty_cash" => "Small cash floats with custodian and linked cash account.",
            "cash_forecast" => "Opening balance plus dated inflows and outflows.",
            "bank_setup" => "Bank account names, currencies and opening balances.",
            _ => "Open a cash account for the bank-name excerpt and office. Office cash, petty cash, and forecast write here. Writes stay Classic for account create."
        };

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        if (_view == "petty_cash")
        {
            var floats = await Dashboards.ListErpPettyCashAsync(_limit, ctx.RequestAborted);
            _floats = floats.Floats;
            _accountsSource = floats.Source;
            _accountsMessage = floats.Message;
            return;
        }

        if (_view == "cash_forecast")
        {
            var fc = await Dashboards.BuildErpCashForecastDigestAsync(_limit, forecastId: null, ctx.RequestAborted);
            _forecast = fc.Summary;
            _forecasts = fc.Forecasts;
            _forecastLines = fc.Lines;
            _accountsSource = fc.Source;
            _accountsMessage = fc.Message;
            return;
        }

        // bank_setup uses the same cash-account master as cash_bank.

        var accounts = await Dashboards.ListErpCashAccountsAsync(_limit, ctx.RequestAborted);
        _accounts = accounts.Accounts;
        _openedAccount = _openedId > 0 ? _accounts.FirstOrDefault(a => a.Id == _openedId) : null;
        if (_openedAccount is not null)
        {
            _accounts = new[] { _openedAccount }.Concat(_accounts.Where(a => a.Id != _openedId)).ToList();
        }
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpCashAccountDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Account;
            _openedSiblings = detail.Siblings;
            if (_openedDetail is null && !string.IsNullOrWhiteSpace(detail.Message))
            {
                _accountsMessage = detail.Message;
            }
        }
        _totalBalance = _accounts.Sum(a => a.Balance);
        _accountsSource = accounts.Source;
        _accountsMessage = accounts.Message;

        int? filterAccount = _openedId > 0 && _openedId <= int.MaxValue ? (int)_openedId : null;
        var entries = await Dashboards.ListErpCashEntriesAsync(filterAccount, _limit, ctx.RequestAborted);
        _entriesSource = entries.Source;
        _entriesMessage = entries.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }

    private static string FormatDirection(int direction) => direction == 1 ? "in" : "out";
}
