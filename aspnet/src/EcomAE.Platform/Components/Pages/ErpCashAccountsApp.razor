@page "/erp/cash-accounts-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Cash &amp; Bank · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Cash & Bank" BreadcrumbArea="Cash & Treasury" BreadcrumbTab="Cash & bank">
    <style>
        .epc-cash-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#052e16 0%,#14532d 45%,#854d0e 100%);
        }
        .epc-cash-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-cash-hero p { margin:0; color:#fde68a; max-width:42rem; font-size:.92rem; line-height:1.45; }
        .epc-cash-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-cash-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#fff; background:#ca8a04;
        }
        .epc-cash-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); }
        .epc-cash-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-cash-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-cash-kpi strong { display:block; font-size:1.45rem; font-variant-numeric:tabular-nums; }
        .epc-cash-kpi span { color:#64748b; font-size:.78rem; }
        .epc-cash-section { margin-bottom:1rem; }
        .epc-cash-section h2 { margin:0 0 .55rem; font-size:1rem; color:#14532d; }
        .epc-cash-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-cash-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-cash-table th, .epc-cash-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-cash-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-cash-table a { color:#854d0e; font-weight:700; text-decoration:none; }
        .epc-cash-badge { display:inline-flex; padding:.15rem .45rem; border-radius:.3rem; font-size:.72rem; font-weight:700; background:#fef3c7; color:#713f12; }
        .epc-cash-note { margin-top:1rem; padding:.75rem .9rem; background:#f7fee7; border:1px solid #bef264; border-radius:.45rem; color:#365314; font-size:.86rem; }
        @@media (max-width:900px){ .epc-cash-kpis{grid-template-columns:1fr;} }
    </style>

    <section class="epc-cash-hero">
        <img src="@LegacyPresentationAssets.EpartsCartMarkUrl" alt="ECOM AE" style="height:28px;filter:brightness(1.1)" />
        <h1>Cash &amp; Bank</h1>
        <p>Read-only cash accounts from <code>/erp/cash-accounts</code> (and recent entries from <code>/erp/cash-entries</code>) under PHP ERP desktop chrome. Full tab UI (<code>erp_tabs_cash_bank.php</code>), transfers, and writes stay on live PHP — same-to-same for tenants.</p>
        <div class="epc-cash-cta">
            <a href="@_phpTab">Open PHP cash &amp; bank</a>
            <a class="ghost" href="@PhpModuleCatalog.HybridWorkspaceHref("/erp/app", _phpTab)">Hybrid workspace</a>
            <a class="ghost" href="/erp/invoices-app">Invoices</a>
            <a class="ghost" href="/erp/sales-orders-app">Sales orders</a>
            <a class="ghost" href="/erp/app">ERP dashboard</a>
        </div>
    </section>

    <div class="epc-cash-kpis" aria-label="Cash KPIs">
        <div class="epc-cash-kpi"><strong>@_accounts.Count</strong><span>Accounts (limit @_limit)</span></div>
        <div class="epc-cash-kpi"><strong>@_totalBalance.ToString("N2", CultureInfo.InvariantCulture)</strong><span>Sum of balances</span></div>
        <div class="epc-cash-kpi"><strong>@_entries.Count</strong><span>Recent entries shown</span></div>
    </div>

    <div class="epc-cash-section">
        <h2>Cash accounts</h2>
        <div class="epc-cash-table-wrap">
            <table class="epc-cash-table">
                <thead>
                    <tr>
                        <th>Account</th>
                        <th>Type</th>
                        <th>Currency</th>
                        <th>Opening</th>
                        <th>Balance</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_accounts.Count == 0)
                    {
                        <tr><td colspan="6">No cash accounts in digest (@_accountsSource). @_accountsMessage</td></tr>
                    }
                    else
                    {
                        @foreach (var a in _accounts)
                        {
                            var phpHref = $"{_phpTab}&account_id={a.Id.ToString(CultureInfo.InvariantCulture)}";
                            <tr>
                                <td><strong>@(string.IsNullOrWhiteSpace(a.Name) ? $"#{a.Id}" : a.Name)</strong></td>
                                <td><span class="epc-cash-badge">@a.AccountType</span></td>
                                <td>@(string.IsNullOrWhiteSpace(a.CurrencyCode) ? "—" : a.CurrencyCode)</td>
                                <td>@a.OpeningBalance.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@a.Balance.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a href="@phpHref">Open in PHP</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="epc-cash-section">
        <h2>Recent cash entries</h2>
        <div class="epc-cash-table-wrap">
            <table class="epc-cash-table">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Account</th>
                        <th>Direction</th>
                        <th>Amount</th>
                        <th>Reference</th>
                        <th>Note</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_entries.Count == 0)
                    {
                        <tr><td colspan="7">No cash entries in digest (@_entriesSource). @_entriesMessage</td></tr>
                    }
                    else
                    {
                        @foreach (var e in _entries)
                        {
                            var phpHref = $"{_phpTab}&account_id={e.AccountId.ToString(CultureInfo.InvariantCulture)}";
                            <tr>
                                <td>@FormatTime(e.TimeUnix)</td>
                                <td>@(string.IsNullOrWhiteSpace(e.AccountName) ? $"#{e.AccountId}" : e.AccountName)</td>
                                <td><span class="epc-cash-badge">@FormatDirection(e.Direction)</span></td>
                                <td>@e.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@(string.IsNullOrWhiteSpace(e.Reference) ? "—" : e.Reference)</td>
                                <td>@(string.IsNullOrWhiteSpace(e.Note) ? "—" : e.Note)</td>
                                <td><a href="@phpHref">Open in PHP</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="epc-cash-note">
        Read-only preview · JSON digests <a href="/erp/cash-accounts?limit=200">/erp/cash-accounts</a>
        · <a href="/erp/cash-entries?limit=100">/erp/cash-entries</a>.
        PHP tab <code>erp_tabs_cash_bank.php</code> remains authoritative for transfers/reconcile/post.
        Not a broad /erp cutover · tenant product chrome stays PHP (same-to-same).
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=banking&tab=cash_bank";
    private bool _isAdmin;
    private IReadOnlyList<ErpCashAccountDigest> _accounts = [];
    private IReadOnlyList<ErpCashEntryDigest> _entries = [];
    private decimal _totalBalance;
    private int _limit = 100;
    private string _accountsSource = "n/a";
    private string _accountsMessage = "";
    private string _entriesSource = "n/a";
    private string _entriesMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("erp"))
        {
            Nav.NavigateTo("/erp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var accounts = await Dashboards.ListErpCashAccountsAsync(_limit, ctx.RequestAborted);
        _accounts = accounts.Accounts;
        _totalBalance = _accounts.Sum(a => a.Balance);
        _accountsSource = accounts.Source;
        _accountsMessage = accounts.Message;

        var entries = await Dashboards.ListErpCashEntriesAsync(accountId: null, _limit, ctx.RequestAborted);
        _entries = entries.Entries;
        _entriesSource = entries.Source;
        _entriesMessage = entries.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }

    private static string FormatDirection(int direction) => direction == 1 ? "in" : "out";
}
