@page "/cp/purchase-requests-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Purchase requests · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-prq-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-prq-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-prq-hero p { margin:0; color:rgba(255,255,255,.85); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-prq-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-prq-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#7c2d12; background:#ffedd5;
        }
        .epc-prq-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-prq-kpis { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-prq-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-prq-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-prq-kpi span { color:#64748b; font-size:.78rem; }
        .epc-prq-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-prq-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-prq-table th, .epc-prq-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-prq-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-prq-note { margin-top:1rem; padding:.75rem .9rem; background:#fff7ed; border:1px solid #fdba74; border-radius:.45rem; color:#7c2d12; font-size:.86rem; }
        @@media (max-width:900px){ .epc-prq-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-prq-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Purchase requests</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-prq-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
        </div>
    </section>

    <div class="epc-prq-kpis" aria-label="Purchase requests stats">
        <div class="epc-prq-kpi"><strong>@_summary.ReqCount.ToString(CultureInfo.InvariantCulture)</strong><span>Requests</span></div>
        <div class="epc-prq-kpi"><strong>@_summary.DraftCount.ToString(CultureInfo.InvariantCulture)</strong><span>Draft</span></div>
        <div class="epc-prq-kpi"><strong>@_summary.PendingApproval.ToString(CultureInfo.InvariantCulture)</strong><span>Pending approval</span></div>
        <div class="epc-prq-kpi"><strong>@_summary.LineCount.ToString(CultureInfo.InvariantCulture)</strong><span>Lines</span></div>
        <div class="epc-prq-kpi"><strong>@_summary.CategoryCount.ToString(CultureInfo.InvariantCulture)</strong><span>Categories</span></div>
    </div>

    <div class="epc-prq-table-wrap">
        <table class="epc-prq-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Req #</th>
                    <th>Requester</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Approval</th>
                    <th>PO ref</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_requests.Count == 0)
                {
                    <tr><td colspan="8">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _requests)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ReqNumber) ? row.ReqNumber : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Requester) ? row.Requester : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@row.Total.ToString("0.00", CultureInfo.InvariantCulture)</td>
                            <td>@(row.RequiresApproval ? "yes" : "no")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PoRef) ? row.PoRef : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=purchasing&tab=purchase_requisitions&epc_erp_shell=1";
    private bool _isAdmin;
    private CpPurchaseRequestsSummary _summary = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPurchaseRequestDigest> _requests = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpPurchaseRequestsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _requests = result.Requests;
        _source = result.Source;
        _message = result.Message;
    }
}
