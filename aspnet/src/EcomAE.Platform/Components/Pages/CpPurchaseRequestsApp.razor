@page "/erp/purchase-requests-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Components.Shared.Desktop
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Middleware
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav
@inject ICpCsrfGuard Csrf

<PageTitle>Purchase requests · ERP · eParts Cart</PageTitle>
<HeadContent>
    <style>
        .epc-pr-create{margin:0 0 14px;padding:16px 18px;border:1px solid #bfdbfe;border-radius:14px;background:#f8fbff;box-shadow:0 10px 24px rgba(15,23,42,.06);}
        .epc-pr-create h2{margin:0 0 6px;color:#1e3a8a;font-size:18px;font-weight:800;}
        .epc-pr-create p{margin:0 0 12px;max-width:52rem;color:#475569;font-size:13px;line-height:1.5;}
        .epc-pr-create form{display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0;}
        .epc-pr-empty{margin:0 0 14px;padding:28px 18px;border:1px dashed #93c5fd;border-radius:14px;background:#f8fbff;text-align:center;}
        .epc-pr-empty h3{margin:0 0 6px;color:#1e3a8a;font-size:16px;font-weight:800;}
        .epc-pr-empty p{margin:0 0 12px;color:#475569;font-size:13px;}
        .epc-pr-chip{display:inline-flex;align-items:center;padding:4px 9px;border:1px solid #cbd5e1;border-radius:999px;background:#fff;color:#1d4ed8;font-size:11px;font-weight:700;}
    </style>
</HeadContent>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin">

    @if (_isErpRoute)
    {
        <PhpErpModulePageHeader
            Title="Purchase requisitions"
            Subtitle="Capture internal demand, route policy approval, and convert approved requests to purchase orders with persisted header and lines."
            PhpTabHref="@_phpTab" />
        <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
        @if (_companyId > 0)
        {
            <p style="margin:0 0 12px"><span class="epc-pr-chip">Company @_companyId.ToString(CultureInfo.InvariantCulture)</span></p>
        }
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Purchase requests
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/erp/purchase-requests-app")</p>
                <p>Save a requisition, add a line, submit, decide, or convert here. Open a row to see lines and status actions.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/erp/purchase-requests-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedDetail is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Purchase request KPIs">
        <div class="kpi"><div class="lbl">Requests</div><div class="val">@_summary.ReqCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Draft</div><div class="val">@_summary.DraftCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Pending approval</div><div class="val">@_summary.PendingApproval.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Lines</div><div class="val">@_summary.LineCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Categories</div><div class="val">@_summary.CategoryCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <section class="epc-pr-create" aria-labelledby="epc-pr-create-title">
            <h2 id="epc-pr-create-title">New purchase requisition</h2>
            <p>Save a header for this company, add lines, then submit for policy approval and convert an approved request to a purchase order.</p>
        <form id="erp-module-new" method="post" action="@Href("/erp/procurement/requisitions/save")" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnListHref" />
            <input type="hidden" name="csrf_guard_key" value="@_csrf" />
            <input type="hidden" name="company_id" value="@EffectiveCompanyId.ToString(CultureInfo.InvariantCulture)" />
            <ErpVoucherHeaderFields DateLabel="Request date" DateFieldName="voc_date" NumberLabel="Requisition no" NumberPreview="Auto" />
            <label>Requester <input type="text" name="requester" maxlength="160" required /></label>
            <label>Justification <input type="text" name="justification" maxlength="4000" style="width:16rem" /></label>
            <button type="submit" class="btn btn-primary btn-sm">Save requisition</button>
        </form>
        </section>
        <form method="post" action="@Href("/erp/procurement/requisitions/add-line")" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <input type="hidden" name="csrf_guard_key" value="@_csrf" />
            <label>Req id <input type="number" name="id" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
            <label>Category <input type="number" name="category_id" min="0" style="width:6rem" /></label>
            <label>Item <input type="text" name="item_code" maxlength="80" style="width:8rem" /></label>
            <label>Description <input type="text" name="description" maxlength="255" style="width:12rem" /></label>
            <label>Qty <input type="number" step="0.0001" name="qty" style="width:6rem" /></label>
            <label>Unit price <input type="number" step="0.01" name="unit_price" style="width:6rem" /></label>
            <label>Vendor <input type="text" name="preferred_vendor" maxlength="160" style="width:10rem" /></label>
            <button type="submit">Add line</button>
        </form>
        <form method="post" action="@Href("/erp/procurement/requisitions/submit")" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <input type="hidden" name="csrf_guard_key" value="@_csrf" />
            <label>Req id <input type="number" name="id" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
            <button type="submit">Submit requisition</button>
        </form>
        <form method="post" action="@Href("/erp/procurement/requisitions/decision")" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <input type="hidden" name="csrf_guard_key" value="@_csrf" />
            <label>Req id <input type="number" name="id" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
            <label>Decision
                <select name="approve">
                    <option value="1">Approve</option>
                    <option value="0">Reject</option>
                </select>
            </label>
            <label>Note <input type="text" name="note" maxlength="255" style="width:14rem" /></label>
            <button type="submit">Record decision</button>
        </form>
        <form method="post" action="@Href("/erp/ajax/proc-req-convert")" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <input type="hidden" name="csrf_guard_key" value="@_csrf" />
            <label>Req id <input type="number" name="id" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
            <button type="submit">Convert to PO</button>
        </form>
    }

    @if (_openedDetail is not null && _isErpRoute)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <ErpDocumentWorkspace
                DocumentKind="Purchase requisition"
                Title="@(_openedDetail.ReqNumber is { Length: > 0 } ? _openedDetail.ReqNumber : $"Requisition #{_openedDetail.Id}")"
                DocumentNumber="@_openedDetail.Id.ToString(CultureInfo.InvariantCulture)"
                PartyLabel="Requester"
                Party="@_openedDetail.Requester"
                ReferenceLabel="Business unit"
                Reference="@_openedDetail.BusinessUnitId.ToString(CultureInfo.InvariantCulture)"
                Status="@(_openedDetail.Status ?? "draft")"
                ApprovalState="@(_openedDetail.RequiresApproval ? "Approval required" : "Within policy")"
                CompanyContext="@($"Company {_openedDetail.CompanyId}")"
                Currency="AED"
                Subtotal="@_openedDetail.Total"
                Total="@_openedDetail.Total"
                BalanceDue="0"
                Fields="@RequisitionWorkspaceFields"
                Lines="@RequisitionWorkspaceLines"
                Tabs="@RequisitionWorkspaceTabs" />
            <p class="text-muted" style="margin:.85rem 0 0">The action pane above follows the requisition lifecycle: draft → submit → policy approval → convert to PO.</p>
        </div>
    }

    @if (_openedDetail is not null && !_isErpRoute)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedDetail.ReqNumber) ? _openedDetail.ReqNumber : ("#" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedDetail.Status) ? _openedDetail.Status : "—")</span>
                </div>
                <div class="panel-body">
                    <p>Requester: <strong>@(!string.IsNullOrWhiteSpace(_openedDetail.Requester) ? _openedDetail.Requester : "—")</strong></p>
                    <p>Total: <strong>@_openedDetail.Total.ToString("0.00", CultureInfo.InvariantCulture)</strong>
                        @if (_openedDetail.RequiresApproval)
                        {
                            <span class="label label-warning">needs approval</span>
                        }
                        else
                        {
                            <span class="label label-success">within policy</span>
                        }
                    </p>
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.Justification))
                    {
                        <p class="text-muted">@_openedDetail.Justification</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.DecidedBy))
                    {
                        <p>Decision by @_openedDetail.DecidedBy: @(!string.IsNullOrWhiteSpace(_openedDetail.DecisionNote) ? _openedDetail.DecisionNote : "—")</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.PoRef))
                    {
                        <p>Converted to <strong>@_openedDetail.PoRef</strong></p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Lines</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Item</th>
                                    <th>Description</th>
                                    <th class="text-right">Qty</th>
                                    <th class="text-right">Price</th>
                                    <th class="text-right">Total</th>
                                    <th>Vendor</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedLines.Count == 0)
                                {
                                    <tr><td colspan="7">No lines yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var line in _openedLines)
                                    {
                                        <tr>
                                            <td>@(!string.IsNullOrWhiteSpace(line.CategoryCode) ? line.CategoryCode : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(line.ItemCode) ? line.ItemCode : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(line.Description) ? line.Description : "—")</td>
                                            <td class="text-right">@line.Qty.ToString("0.####", CultureInfo.InvariantCulture)</td>
                                            <td class="text-right">@line.UnitPrice.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                            <td class="text-right"><strong>@line.LineTotal.ToString("0.00", CultureInfo.InvariantCulture)</strong></td>
                                            <td>@(!string.IsNullOrWhiteSpace(line.PreferredVendor) ? line.PreferredVendor : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_isAdmin && _requests.Count == 0)
    {
        <section class="epc-pr-empty" aria-labelledby="epc-pr-empty-title">
            <h3 id="epc-pr-empty-title">No purchase requisitions yet</h3>
            <p>Use the form above to save the first requisition for this company. Add lines, submit, then convert an approved request to a purchase order.</p>
            <a class="btn btn-primary btn-sm" href="#erp-module-new">Create requisition</a>
        </section>
    }

    <p class="help-block">@_summary.ReqCount.ToString(CultureInfo.InvariantCulture) Requests · @_summary.DraftCount.ToString(CultureInfo.InvariantCulture) Draft · @_summary.PendingApproval.ToString(CultureInfo.InvariantCulture) Pending approval · @_summary.LineCount.ToString(CultureInfo.InvariantCulture) Lines · @_summary.CategoryCount.ToString(CultureInfo.InvariantCulture) Categories.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Req #</th>
                    <th>Requester</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Approval</th>
                    <th>PO ref</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_requests.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? "No records yet." : "Sign in with a staff session for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _requests)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ReqNumber) ? row.ReqNumber : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Requester) ? row.Requester : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@row.Total.ToString("0.00", CultureInfo.InvariantCulture)</td>
                            <td>@(row.RequiresApproval ? "yes" : "no")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PoRef) ? row.PoRef : "—")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "req_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=purchasing&tab=purchase_requisitions&epc_erp_shell=1";
    private bool _isAdmin;
    private CpPurchaseRequestsSummary _summary = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPurchaseRequestDigest> _requests = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private CpPurchaseRequestDetail? _openedDetail;
    private IReadOnlyList<CpPurchaseRequestLineDigest> _openedLines = [];
    private string _listHref = "/erp/purchase-requests-app";
    private string _returnListHref = "/erp/purchase-requests-app";
    private string _returnHref = "/erp/purchase-requests-app";
    private bool _isErpRoute;
    private long _companyId;
    private string _csrf = "";
    private IReadOnlyList<string> RequisitionWorkspaceTabs => ["General", "Lines", "Approval", "Procurement"];
    private IReadOnlyList<ErpDocumentWorkspaceField> RequisitionWorkspaceFields => _openedDetail is null
        ? []
        : [
            new("Requester", _openedDetail.Requester, "General"),
            new("Business unit", _openedDetail.BusinessUnitId.ToString(CultureInfo.InvariantCulture), "General"),
            new("Justification", string.IsNullOrWhiteSpace(_openedDetail.Justification) ? "—" : _openedDetail.Justification, "General"),
            new("Requires approval", _openedDetail.RequiresApproval ? "Yes" : "No", "Approval"),
            new("Decided by", string.IsNullOrWhiteSpace(_openedDetail.DecidedBy) ? "—" : _openedDetail.DecidedBy, "Approval"),
            new("Decision note", string.IsNullOrWhiteSpace(_openedDetail.DecisionNote) ? "—" : _openedDetail.DecisionNote, "Approval"),
            new("Purchase order", string.IsNullOrWhiteSpace(_openedDetail.PoRef) ? "Not converted" : _openedDetail.PoRef, "Procurement"),
            new("Created", DateTimeOffset.FromUnixTimeSeconds(Math.Max(0, _openedDetail.TimeCreated)).ToString("u", CultureInfo.InvariantCulture), "Audit")
        ];
    private IReadOnlyList<ErpDocumentWorkspaceLine> RequisitionWorkspaceLines => _openedLines
        .Select(line => new ErpDocumentWorkspaceLine(
            line.Id.ToString(CultureInfo.InvariantCulture),
            string.IsNullOrWhiteSpace(line.Description) ? line.ItemCode : line.Description,
            line.Qty,
            "requisition",
            line.CategoryCode,
            line.ItemCode,
            line.UnitPrice,
            0,
            0,
            line.LineTotal,
            line.LineTotal,
            string.IsNullOrWhiteSpace(line.PreferredVendor) ? "Vendor not assigned" : line.PreferredVendor))
        .ToArray();

    private string OpenedCaption => _openedDetail is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedDetail.ReqNumber) ? ("Requisition #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.ReqNumber)
            + " · " + (string.IsNullOrWhiteSpace(_openedDetail.Status) ? "open" : _openedDetail.Status);

    private string OpenedIdValue => _openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "";
    private long EffectiveCompanyId => _companyId > 0 ? _companyId : 1;
    private string Href(string path) => ClientErpPath.PrefixIfBound(Http.HttpContext, path);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var path = ctx.Request.Path.Value;
        _isErpRoute = string.Equals(path, "/erp/purchase-requests-app", StringComparison.OrdinalIgnoreCase)
            || (path ?? string.Empty).Contains("purchase-requests-app", StringComparison.OrdinalIgnoreCase);
        _listHref = "/erp/purchase-requests-app";
        if (ctx.Items.TryGetValue(ClientErpPathRewriteMiddleware.OriginalPathItem, out var original)
            && original is string originalPath
            && originalPath.Contains("purchase-requests-app", StringComparison.OrdinalIgnoreCase))
        {
            _listHref = originalPath.Split('?', 2)[0];
        }
        else
        {
            _listHref = Href("/erp/purchase-requests-app");
        }

        long.TryParse(
            ctx.Request.Query["company"].FirstOrDefault()
            ?? ctx.Request.Query["company_id"].FirstOrDefault()
            ?? ctx.Request.Query["companyId"].FirstOrDefault(),
            NumberStyles.Integer,
            CultureInfo.InvariantCulture,
            out _companyId);
        if (_companyId < 0)
        {
            _companyId = 0;
        }

        _returnListHref = _companyId > 0
            ? _listHref + "?company=" + _companyId.ToString(CultureInfo.InvariantCulture)
            : _listHref;
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "req_id", "rq");
        _returnHref = _openedId > 0
            ? ErpRecordOpen.Href(_returnListHref, "req_id", _openedId).Split('#')[0]
            : _returnListHref;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        _csrf = _isAdmin ? await Csrf.KeyForAsync(ctx, session, ctx.RequestAborted) : "";
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpPurchaseRequestsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _requests = result.Requests;
        _source = result.Source;
        _message = result.Message;
        if (_companyId > 0)
        {
            _requests = _requests.Where(row => row.CompanyId == _companyId).ToList();
            _summary = _summary with
            {
                ReqCount = _requests.Count,
                DraftCount = _requests.Count(row => string.Equals(row.Status, "draft", StringComparison.OrdinalIgnoreCase)),
                PendingApproval = _requests.Count(row => row.RequiresApproval
                    && !string.Equals(row.Status, "approved", StringComparison.OrdinalIgnoreCase)
                    && !string.Equals(row.Status, "rejected", StringComparison.OrdinalIgnoreCase)
                    && !string.Equals(row.Status, "converted", StringComparison.OrdinalIgnoreCase))
            };
        }

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpPurchaseRequestDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Request;
            _openedLines = detail.Lines;
            if (_openedDetail is not null)
            {
                var openedList = _requests.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _requests = new[] { openedList }.Concat(_requests.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
