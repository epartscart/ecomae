@page "/cp/purchase-requests-app"
@page "/erp/purchase-requests-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Purchase requests · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Purchase requests
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/purchase-requests-app")</p>
                <p>Save a requisition, add a line, submit, decide, or convert here.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/purchase-requests-app" IsAdmin="_isAdmin" />


    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/procurement/requisitions/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/purchase-requests-app" />
            <label>Requester <input type="text" name="requester" maxlength="160" required /></label>
            <label>Business unit <input type="number" name="business_unit_id" min="0" style="width:6rem" /></label>
            <label>Justification <input type="text" name="justification" maxlength="4000" style="width:16rem" /></label>
            <button type="submit">Save requisition</button>
        </form>
        <form method="post" action="/erp/procurement/requisitions/add-line" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/cp/purchase-requests-app")" />
            <label>Req id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <label>Category <input type="number" name="category_id" min="0" style="width:6rem" /></label>
            <label>Item <input type="text" name="item_code" maxlength="80" style="width:8rem" /></label>
            <label>Description <input type="text" name="description" maxlength="255" style="width:12rem" /></label>
            <label>Qty <input type="number" step="0.0001" name="qty" style="width:6rem" /></label>
            <label>Unit price <input type="number" step="0.01" name="unit_price" style="width:6rem" /></label>
            <label>Vendor <input type="text" name="preferred_vendor" maxlength="160" style="width:10rem" /></label>
            <button type="submit">Add line</button>
        </form>
        <form method="post" action="/erp/procurement/requisitions/submit" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/cp/purchase-requests-app")" />
            <label>Req id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <button type="submit">Submit requisition</button>
        </form>
        <form method="post" action="/erp/procurement/requisitions/decision" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/cp/purchase-requests-app")" />
            <label>Req id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <label>Decision
                <select name="approve">
                    <option value="1">Approve</option>
                    <option value="0">Reject</option>
                </select>
            </label>
            <label>Note <input type="text" name="note" maxlength="255" style="width:14rem" /></label>
            <button type="submit">Record decision</button>
        </form>
        <form method="post" action="/erp/ajax/proc-req-convert" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/cp/purchase-requests-app")" />
            <label>Req id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <button type="submit">Convert to PO</button>
        </form>
    }

    <p class="help-block">@_summary.ReqCount.ToString(CultureInfo.InvariantCulture) Requests · @_summary.DraftCount.ToString(CultureInfo.InvariantCulture) Draft · @_summary.PendingApproval.ToString(CultureInfo.InvariantCulture) Pending approval · @_summary.LineCount.ToString(CultureInfo.InvariantCulture) Lines · @_summary.CategoryCount.ToString(CultureInfo.InvariantCulture) Categories.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Req #</th>
                    <th>Requester</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Approval</th>
                    <th>PO ref</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_requests.Count == 0)
                {
                    <tr><td colspan="8">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _requests)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ReqNumber) ? row.ReqNumber : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Requester) ? row.Requester : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@row.Total.ToString("0.00", CultureInfo.InvariantCulture)</td>
                            <td>@(row.RequiresApproval ? "yes" : "no")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PoRef) ? row.PoRef : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp?area=purchasing&tab=purchase_requisitions&epc_erp_shell=1";
    private bool _isAdmin;
    private CpPurchaseRequestsSummary _summary = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPurchaseRequestDigest> _requests = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpPurchaseRequestsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _requests = result.Requests;
        _source = result.Source;
        _message = result.Message;
    }
}
