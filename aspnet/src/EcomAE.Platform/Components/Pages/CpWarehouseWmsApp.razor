@page "/cp/warehouse-wms-app"
@page "/erp/warehouse-wms-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Warehouse WMS · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Warehouse WMS
                <a class="btn btn-xs btn-default pull-right" href="/erp">ERP overview</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" style="margin-right:.4rem">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Open a work row for from/to location and license-plate ids. Save or delete a bin location, receive stock, complete work, and create or release a pick wave here. Schema ensure stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/warehouse-wms-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedWork is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/wms/receive" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/erp/warehouse-wms-app")" />
            <label>Item / SKU <input type="text" name="item" required /></label>
            <label>Quantity <input type="number" step="0.001" name="qty" required /></label>
            <label>Receiving location <input type="number" name="receive_location_id" min="0" style="width:6rem" /></label>
            <label>Put-away destination <input type="number" name="putaway_location_id" min="0" style="width:6rem" /></label>
            <label>Reference <input type="text" name="reference" placeholder="PO / ASN" /></label>
            <label>License plate <input type="text" name="lp_code" placeholder="blank = auto" /></label>
            <button type="submit">Receive &amp; raise put-away</button>
        </form>
        <form method="post" action="/erp/wms/locations/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/erp/warehouse-wms-app")" />
            <label>Code <input name="code" required maxlength="64" style="width:7rem" /></label>
            <label>Name <input name="name" maxlength="120" style="width:10rem" /></label>
            <label>Warehouse <input type="number" name="warehouse_id" min="0" style="width:5rem" /></label>
            <label>Zone <input name="zone" maxlength="40" style="width:5rem" /></label>
            <label>Aisle <input name="aisle" maxlength="40" style="width:5rem" /></label>
            <label>Rack <input name="rack" maxlength="40" style="width:5rem" /></label>
            <label>Bin <input name="bin" maxlength="40" style="width:5rem" /></label>
            <button type="submit">Save location</button>
        </form>
        <form method="post" action="/erp/wms/waves/create" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/warehouse-wms-app" />
            <label>Item <input name="item" required maxlength="120" style="width:8rem" /></label>
            <label>Qty <input type="number" name="qty" min="0.001" step="0.001" required style="width:5rem" /></label>
            <label>Reference <input name="reference" maxlength="120" style="width:8rem" /></label>
            <button type="submit">Create wave</button>
        </form>
        <form method="post" action="/erp/wms/locations/delete" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/erp/warehouse-wms-app")" />
            <label>Location id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <button type="submit">Delete location</button>
        </form>
        <form method="post" action="/erp/wms/waves/release" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/erp/warehouse-wms-app")" />
            <label>Wave id <input type="number" name="id" min="1" required style="width:6rem" value="@(_openedWork is not null && _openedWork.WaveId > 0 ? _openedWork.WaveId.ToString(CultureInfo.InvariantCulture) : "")" /></label>
            <button type="submit">Release wave</button>
        </form>
        <form method="post" action="/erp/wms/work/complete" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/erp/warehouse-wms-app")" />
            <label>Work id <input type="number" name="id" min="1" required style="width:6rem" value="@(_openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "")" /></label>
            <button type="submit">Complete work</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="WMS KPIs">
        <div class="kpi"><div class="lbl">Locations</div><div class="val">@_summary.LocationCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">License plates</div><div class="val">@_summary.LpCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Waves</div><div class="val">@_summary.WaveCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open work</div><div class="val">@_summary.OpenWorkCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedWork is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @OpenedCaption
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedWork.Status) ? _openedWork.Status : "—")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedWork.WorkType) ? _openedWork.WorkType : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedWork.Item) ? _openedWork.Item : "—")
                        · qty @_openedWork.Qty.ToString(CultureInfo.InvariantCulture)
                        · ref @(!string.IsNullOrWhiteSpace(_openedWork.Reference) ? _openedWork.Reference : "—")
                        · wave @_openedWork.WaveId.ToString(CultureInfo.InvariantCulture)
                        · assigned @(!string.IsNullOrWhiteSpace(_openedWork.AssignedTo) ? _openedWork.AssignedTo : "—")</p>
                    <p>From location @_openedWork.FromLocationId.ToString(CultureInfo.InvariantCulture)
                        · to location @_openedWork.ToLocationId.ToString(CultureInfo.InvariantCulture)
                        · LP @_openedWork.LpId.ToString(CultureInfo.InvariantCulture)
                        · created @_openedWork.TimeCreated.ToString(CultureInfo.InvariantCulture)
                        · updated @_openedWork.TimeUpdated.ToString(CultureInfo.InvariantCulture)</p>
                    @if (!string.Equals(_openedWork.Status, "closed", StringComparison.OrdinalIgnoreCase))
                    {
                        <form method="post" action="/erp/wms/work/complete" style="display:inline;margin:0">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@_openedReturnUrl" />
                            <input type="hidden" name="id" value="@_openedWork.Id.ToString(CultureInfo.InvariantCulture)" />
                            <button type="submit">Complete</button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Same-wave siblings</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Type</th>
                                    <th>Item</th>
                                    <th>Qty</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="6">No same-wave siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.WorkType) ? sib.WorkType : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Item) ? sib.Item : "—")</td>
                                            <td>@sib.Qty.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Status) ? sib.Status : "—")</td>
                                            <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "work_id", sib.Id)">Open</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Work</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Type</th>
                                <th>Reference</th>
                                <th>Item</th>
                                <th>Qty</th>
                                <th>Status</th>
                                <th>Assigned</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!_isAdmin)
                        {
                            <tr><td colspan="8">Sign in for live data.</td></tr>
                        }
                        else if (_rows.Count == 0)
                        {
                            <tr><td colspan="8">@(!string.IsNullOrWhiteSpace(_message) ? _message : "No records yet.")</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.WorkType) ? row.WorkType : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Reference) ? row.Reference : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Item) ? row.Item : "—")</td>
                                    <td>@row.Qty.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.AssignedTo) ? row.AssignedTo : "—")</td>
                                    <td>
                                        <a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "work_id", row.Id)">Open</a>
                                        @if (!string.Equals(row.Status, "closed", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <form method="post" action="/erp/wms/work/complete" style="display:inline;margin:0 0 0 .3rem">
                                                <input type="hidden" name="confirmWrites" value="true" />
                                                <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/erp/warehouse-wms-app")" />
                                                <input type="hidden" name="id" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                                <button type="submit">Complete</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=warehouse&tab=wms";
    private bool _isAdmin;
    private CpWarehouseWmsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpWarehouseWmsWorkDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private string _listHref = "/cp/warehouse-wms-app";
    private long _openedId;
    private CpWarehouseWmsWorkDetail? _openedWork;
    private IReadOnlyList<CpWarehouseWmsWorkDigest> _openedSiblings = [];

    private string OpenedCaption => _openedWork is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_openedWork.Item)
            ? _openedWork.Item
            : (!string.IsNullOrWhiteSpace(_openedWork.Reference)
                ? _openedWork.Reference
                : ("Work #" + _openedWork.Id.ToString(CultureInfo.InvariantCulture))));

    private string _openedReturnUrl => _openedId > 0
        ? (_listHref + "?work_id=" + _openedId.ToString(CultureInfo.InvariantCulture))
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var path = ctx.Request.Path.Value;
        _listHref = string.Equals(path, "/erp/warehouse-wms-app", StringComparison.OrdinalIgnoreCase)
            ? "/erp/warehouse-wms-app"
            : "/cp/warehouse-wms-app";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "work_id");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpWarehouseWmsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Work;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpWarehouseWmsDetailAsync(_openedId, ctx.RequestAborted);
            _openedWork = detail.Work;
            _openedSiblings = detail.Siblings;
            if (_openedWork is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
