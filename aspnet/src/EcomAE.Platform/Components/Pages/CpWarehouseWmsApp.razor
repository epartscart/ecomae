@page "/cp/warehouse-wms-app"
@using EcomAE.Platform.PhpParity
@using EcomAE.Platform.Services
@inject IHttpContextAccessor HttpContextAccessor
@inject ErpWarehouseWmsWriteService WmsWrites
@inject ErpWmsWaveWriteService WaveWrites

<PhpParityPageShell Title="Warehouse WMS" Surface="cp">
    <PhpCpDesktopChrome Title="Warehouse WMS" Surface="cp" ActiveTab="wms">
        <div class="php-parity-prose">
            <p>Live on this page: save or delete a bin location, and create or release a pick wave. Receiving and work-complete stay on Classic ERP until those helpers persist here.</p>
            <p><a class="php-parity-btn" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref("/php-reference/erp/wms")">Open Classic WMS twin</a></p>
        </div>
        @if (!string.IsNullOrWhiteSpace(ok))
        {
            <p class="php-parity-note">Saved. Code @ok.</p>
        }
        @if (saveError is not null)
        {
            <p class="php-parity-note">@saveError</p>
        }
        <div class="php-parity-panel" style="margin-top:12px">
            <h3>Save location</h3>
            <form method="post" action="/erp/wms/locations/save" class="php-parity-form">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <label>Code <input name="code" value="BIN-A1" /></label>
                <label>Name <input name="name" value="Aisle A bin 1" /></label>
                <label>Warehouse <input name="warehouse_id" value="1" /></label>
                <label>Zone <input name="zone" value="A" /></label>
                <label>Aisle <input name="aisle" value="1" /></label>
                <label>Rack <input name="rack" value="R1" /></label>
                <label>Bin <input name="bin" value="B1" /></label>
                <button type="submit" class="php-parity-btn">Save location</button>
            </form>
        </div>
        <div class="php-parity-panel" style="margin-top:12px">
            <h3>Delete location</h3>
            <form method="post" action="/erp/wms/locations/delete" class="php-parity-form">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <label>Location id <input name="id" value="" /></label>
                <button type="submit" class="php-parity-btn">Delete location</button>
            </form>
        </div>
        <div class="php-parity-panel" style="margin-top:12px">
            <h3>Create wave</h3>
            <form method="post" action="/erp/wms/waves/create" class="php-parity-form">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <label>Code <input name="code" value="WAVE-1" /></label>
                <label>Warehouse <input name="warehouse_id" value="1" /></label>
                <label>Strategy <input name="strategy" value="fifo" /></label>
                <button type="submit" class="php-parity-btn">Create wave</button>
            </form>
        </div>
        <div class="php-parity-panel" style="margin-top:12px">
            <h3>Release wave</h3>
            <form method="post" action="/erp/wms/waves/release" class="php-parity-form">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <label>Wave id <input name="id" value="" /></label>
                <button type="submit" class="php-parity-btn">Release wave</button>
            </form>
        </div>
    </PhpCpDesktopChrome>
</PhpParityPageShell>

@code {
    [SupplyParameterFromQuery]
    public string? ok { get; set; }

    private string? saveError;
    private string ReturnUrl => HttpContextAccessor.HttpContext?.Request.Path.Value ?? "/cp/warehouse-wms-app";

    protected override void OnInitialized()
    {
        if (WmsWrites.IsLiveWriteUnavailable)
            saveError = WmsWrites.LiveWriteUnavailableReason;
        else if (WaveWrites.IsLiveWriteUnavailable)
            saveError = WaveWrites.LiveWriteUnavailableReason;
    }
}
