@page "/cp/api-clients-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ICpApiClientsDeskService Desk
@inject ICpApiClientKeyVault Keys
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>API Clients · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

<style>
    .epc-acm-hero { background:linear-gradient(135deg,#0f172a,#1d4ed8); color:#fff; border-radius:10px; padding:18px 20px; margin-bottom:16px }
    .epc-acm-hero h3 { margin:0 0 6px; font-weight:600 }
    .epc-acm-key { font-family:Menlo,Consolas,monospace; font-size:15px; background:#0f172a; color:#e2e8f0; padding:10px 12px; border-radius:6px; margin:8px 0; word-break:break-all }
    .epc-acm-actions-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:4px 12px; font-weight:normal; font-size:12px }
    .epc-acm-actions-grid label { font-weight:normal; margin:0 }
    .epc-acm-curl { background:#0f172a; color:#e2e8f0; padding:12px; border-radius:8px; font-size:12px; overflow-x:auto }
</style>

<div class="col-lg-12">
    <div class="epc-portal-settings">
        <div class="hpanel">
            <div class="panel-body">
                <div class="epc-acm-hero">
                    <h3><i class="fa fa-key"></i> Catalog &amp; Price PRO API clients</h3>
                    <p style="margin:0;opacity:.92">
                        Issue <code>X-API-Key</code> credentials for external integrations. Catalog keys authenticate via
                        <code>/api/v1/catalog.php</code>; Price PRO via <code>/api/v1/price/lookup.php</code>.
                        Keys are SHA-256 hashed — plain text shown once at create/rotate.
                    </p>
                </div>

                @if (!_isAdmin)
                {
                    <div class="alert alert-warning">Please <a href="/cp/login?returnUrl=/cp/api-clients-app">log in to Super CP</a>.</div>
                }
                else
                {
                    <div class="row" style="margin-bottom:16px">
                        <div class="col-sm-3"><div class="well well-sm text-center"><div class="text-muted small">Active clients</div><strong>@_active.ToString(CultureInfo.InvariantCulture)</strong></div></div>
                        <div class="col-sm-3"><div class="well well-sm text-center"><div class="text-muted small">Total rows</div><strong>@_clients.Count.ToString(CultureInfo.InvariantCulture)</strong></div></div>
                        <div class="col-sm-6"><div class="well well-sm"><div class="text-muted small">Marketing docs</div><a href="https://www.ecomae.com/platform/api-services" target="_blank" rel="noopener">/platform/api-services</a></div></div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_flashOk))
                    {
                        <div class="alert alert-success">
                            @_flashOk
                            @if (!string.IsNullOrWhiteSpace(_newKeyPlain))
                            {
                                <div class="epc-acm-key">@_newKeyPlain</div>
                                <p class="text-muted" style="margin:0;font-size:12px">Store in a password manager. Never paste into tickets or marketing HTML.</p>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_flashErr))
                    {
                        <div class="alert alert-danger">@_flashErr</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_message))
                    {
                        <div class="alert alert-danger">@_message</div>
                    }

                    <p>
                        <a class="btn btn-default btn-sm" href="/cp/guides-app?g=api-docs"><i class="fa fa-code"></i> Tenant ERP API guide</a>
                        <a class="btn btn-default btn-sm" href="https://www.ecomae.com/platform/api-services" target="_blank" rel="noopener"><i class="fa fa-flask"></i> API services overview</a>
                    </p>

                    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedClient is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

                    <div class="hpanel">
                        <div class="panel-heading"><h4>Create client</h4></div>
                        <div class="panel-body">
                            <form method="post" action="/cp/api-clients/write" class="form-horizontal">
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="action" value="create" />
                                <div class="form-group">
                                    <label class="col-sm-2 control-label">Product</label>
                                    <div class="col-sm-4">
                                        <select name="product" class="form-control">
                                            <option value="catalog">Catalog API</option>
                                            <option value="price_pro">Price PRO</option>
                                            <option value="both">Both (catalog + price)</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-2 control-label">Label</label>
                                    <div class="col-sm-6"><input type="text" name="label" class="form-control" required placeholder="Acme Garage Portal" /></div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-2 control-label">Contact email</label>
                                    <div class="col-sm-6"><input type="email" name="contact_email" class="form-control" placeholder="dev@partner.com" /></div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-2 control-label">Daily limit</label>
                                    <div class="col-sm-3"><input type="number" name="daily_limit" class="form-control" value="1000" min="1" max="1000000" /></div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-2 control-label">Catalog scopes</label>
                                    <div class="col-sm-10">
                                        <p class="text-muted" style="font-size:12px;margin-bottom:8px">Leave all unchecked for full catalog access. Price PRO ignores action scopes.</p>
                                        <div class="epc-acm-actions-grid">
                                            @foreach (var act in CpApiClientsDeskService.CatalogActions)
                                            {
                                                <label><input type="checkbox" name="allowed_actions" value="@act" /> @act</label>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-sm-offset-2 col-sm-10">
                                        <button type="submit" class="btn btn-primary"><i class="fa fa-plus"></i> Create &amp; show key</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-epc">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Label</th>
                                    <th>Product</th>
                                    <th>Key prefix</th>
                                    <th>Quota</th>
                                    <th>Scopes</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_clients.Count == 0)
                                {
                                    <tr><td colspan="8" class="text-muted">No API clients yet. Create one above or run the sandbox setup script.</td></tr>
                                }
                                else
                                {
                                    @foreach (var c in _clients)
                                    {
                                        <tr id="erp-row-@c.Id.ToString(CultureInfo.InvariantCulture)" class="@(c.Active ? "" : "text-muted") @ErpRecordOpen.RowClass(c.Id, _openedId)">
                                            <td>@c.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>
                                                <strong>@c.Label</strong>
                                                @if (!string.IsNullOrWhiteSpace(c.ContactEmail))
                                                {
                                                    <br />
                                                    <small><a href="mailto:@c.ContactEmail">@c.ContactEmail</a></small>
                                                }
                                            </td>
                                            <td><code>@c.Product</code></td>
                                            <td><code>@c.KeyPrefix…</code></td>
                                            <td>@c.Quota</td>
                                            <td style="font-size:11px;max-width:180px">@c.ScopeLabel</td>
                                            <td>
                                                @if (c.Active)
                                                {
                                                    <span class="label label-success">active</span>
                                                }
                                                else
                                                {
                                                    <span class="label label-default">revoked</span>
                                                }
                                            </td>
                                            <td style="white-space:nowrap">
                                                <a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "api_client_id", c.Id)">Edit</a>
                                                <form method="post" action="/cp/api-clients/write" style="display:inline" onsubmit="return confirm('Rotate key? Old key stops working immediately.')">
                                                    <input type="hidden" name="confirmWrites" value="true" />
                                                    <input type="hidden" name="action" value="rotate" />
                                                    <input type="hidden" name="client_id" value="@c.Id" />
                                                    <button type="submit" class="btn btn-xs btn-warning">Rotate</button>
                                                </form>
                                                <form method="post" action="/cp/api-clients/write" style="display:inline">
                                                    <input type="hidden" name="confirmWrites" value="true" />
                                                    <input type="hidden" name="returnUrl" value="@_returnHref" />
                                                    <input type="hidden" name="action" value="reset_quota" />
                                                    <input type="hidden" name="client_id" value="@c.Id" />
                                                    <button type="submit" class="btn btn-xs btn-default">Reset quota</button>
                                                </form>
                                                @if (c.Active)
                                                {
                                                    <form method="post" action="/cp/api-clients/toggle" style="display:inline" onsubmit="return confirm('Revoke this client?')">
                                                        <input type="hidden" name="confirmWrites" value="true" />
                                                        <input type="hidden" name="returnUrl" value="@_returnHref" />
                                                        <input type="hidden" name="action" value="revoke" />
                                                        <input type="hidden" name="clientId" value="@c.Id" />
                                                        <button type="submit" class="btn btn-xs btn-danger">Revoke</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <form method="post" action="/cp/api-clients/toggle" style="display:inline">
                                                        <input type="hidden" name="confirmWrites" value="true" />
                                                        <input type="hidden" name="returnUrl" value="@_returnHref" />
                                                        <input type="hidden" name="action" value="activate" />
                                                        <input type="hidden" name="clientId" value="@c.Id" />
                                                        <button type="submit" class="btn btn-xs btn-success">Activate</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                        @if (_openedId == c.Id)
                                        {
                                            <tr>
                                                <td colspan="8" style="background:#f8fafc">
                                                    <form method="post" action="/cp/api-clients/write" class="form-inline" style="padding:10px">
                                                        <input type="hidden" name="confirmWrites" value="true" />
                                                        <input type="hidden" name="returnUrl" value="@_returnHref" />
                                                        <input type="hidden" name="action" value="update" />
                                                        <input type="hidden" name="client_id" value="@c.Id" />
                                                        <input type="text" name="label" class="form-control input-sm" value="@c.Label" placeholder="Label" style="width:160px" />
                                                        <input type="email" name="contact_email" class="form-control input-sm" value="@c.ContactEmail" placeholder="Email" style="width:180px" />
                                                        <select name="product" class="form-control input-sm">
                                                            @foreach (var product in CpApiClientsDeskService.Products)
                                                            {
                                                                <option value="@product" selected="@(c.Product == product)">@product</option>
                                                            }
                                                        </select>
                                                        <input type="number" name="daily_limit" class="form-control input-sm" value="@c.DailyLimit" min="1" style="width:90px" title="Daily limit" />
                                                        @foreach (var act in CpApiClientsDeskService.CatalogActions)
                                                        {
                                                            <label style="font-weight:normal;margin:0 8px 0 0;font-size:11px">
                                                                <input type="checkbox" name="allowed_actions" value="@act" checked="@c.AllowedActions.Contains(act)" /> @act
                                                            </label>
                                                        }
                                                        <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                                    </form>
                                                    @if (c.AllowedActions.Count == 0)
                                                    {
                                                        <p class="text-muted" style="padding:0 10px 10px;margin:0">No allowed actions yet. — full catalog access.</p>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="hpanel">
                        <div class="panel-heading"><h4>Test with curl</h4></div>
                        <div class="panel-body">
<pre class="epc-acm-curl"># Catalog — manufacturers
curl -s -H "X-API-Key: epc_catalog_YOUR_KEY" \
  "https://www.ecomae.com/api/v1/catalog.php?action=manufacturers&amp;section=passenger"

# Price PRO — article lookup
curl -s -H "X-API-Key: epc_pricepro_YOUR_KEY" \
  "https://www.ecomae.com/api/v1/price/lookup.php?brand=BOSCH&amp;article=0986424590"

# Without key (expect 401)
curl -s "https://www.ecomae.com/api/v1/catalog.php?action=status"</pre>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<PhpParityModuleBody AppPath="/cp/api-clients-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

</PhpCpDesktopChrome>

@code {
    private const string _listHref = "/cp/api-clients-app";
    private bool _isAdmin;
    private IReadOnlyList<CpApiClientRow> _clients = [];
    private int _active;
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private string _newKeyPlain = "";
    private long _openedId;
    private string _returnHref = "/cp/api-clients-app";
    private CpApiClientRow? _openedClient;

    private string OpenedCaption => _openedClient is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedClient.Label)
            ? ("Client #" + _openedClient.Id.ToString(CultureInfo.InvariantCulture))
            : _openedClient.Label)
            + (string.IsNullOrWhiteSpace(_openedClient.KeyPrefix) ? "" : (" · " + _openedClient.KeyPrefix));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "api_client_id");
        _returnHref = _openedId > 0
            ? ErpRecordOpen.Href(_listHref, "api_client_id", _openedId).Split('#')[0]
            : _listHref;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        _newKeyPlain = Keys.Take(ctx.Request.Query["key_token"].ToString() ?? "");

        var view = await Desk.LoadAsync(ctx.RequestAborted);
        _clients = view.Clients;
        _active = view.ActiveCount;
        _message = view.Error;
        _openedClient = _openedId > 0 ? _clients.FirstOrDefault(c => c.Id == _openedId) : null;
    }
}
