@page "/cp/page-builder-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Page builder · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Page builder
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/page-builder-app")</p>
                <p>Open a layout to see layout JSON and brand JSON. The visual editor stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/page-builder-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedLayout is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Page builder KPIs">
        <div class="kpi"><div class="lbl">Layouts</div><div class="val">@_summary.LayoutCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Published</div><div class="val">@_summary.PublishedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Drafts</div><div class="val">@_summary.DraftCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Sites</div><div class="val">@_summary.SiteCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedLayout is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedLayout.PageKey) ? _openedLayout.PageKey : ("Layout #" + _openedLayout.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(_openedLayout.IsPublished ? "published" : "draft")</span>
                </div>
                <div class="panel-body">
                    <p>Site: <strong>@(!string.IsNullOrWhiteSpace(_openedLayout.SiteKey) ? _openedLayout.SiteKey : "—")</strong>
                        · Updated @_openedLayout.UpdatedAt.ToString(CultureInfo.InvariantCulture)
                        · Published at @_openedLayout.PublishedAt.ToString(CultureInfo.InvariantCulture)</p>
                    <p><strong>Brand JSON</strong></p>
                    @if (string.IsNullOrWhiteSpace(_openedLayout.BrandJson))
                    {
                        <p class="text-muted">No brand JSON yet.</p>
                    }
                    else
                    {
                        <pre style="max-height:16rem;overflow:auto;white-space:pre-wrap;margin:0 0 1rem">@_openedLayout.BrandJson</pre>
                    }
                    <p><strong>Layout JSON</strong></p>
                    @if (string.IsNullOrWhiteSpace(_openedLayout.LayoutJson))
                    {
                        <p class="text-muted">No layout JSON yet.</p>
                    }
                    else
                    {
                        <pre style="max-height:16rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedLayout.LayoutJson</pre>
                    }
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_summary.LayoutCount.ToString(CultureInfo.InvariantCulture) Layouts · @_summary.PublishedCount.ToString(CultureInfo.InvariantCulture) Published · @_summary.DraftCount.ToString(CultureInfo.InvariantCulture) Drafts · @_summary.SiteCount.ToString(CultureInfo.InvariantCulture) Sites.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Site</th>
                    <th>Page</th>
                    <th>Published</th>
                    <th>Updated</th>
                    <th>Published at</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_layouts.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _layouts)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.SiteKey) ? row.SiteKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PageKey) ? row.PageKey : "—")</td>
                            <td>@(row.IsPublished ? "yes" : "no")</td>
                            <td>@row.UpdatedAt.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.PublishedAt.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "layout_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_visual_page_editor";
    private const string _listHref = "/cp/page-builder-app";
    private bool _isAdmin;
    private CpPageBuilderSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPageBuilderLayoutDigest> _layouts = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private CpPageBuilderLayoutDetail? _openedLayout;

    private string OpenedCaption => _openedLayout is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedLayout.PageKey) ? ("Layout #" + _openedLayout.Id.ToString(CultureInfo.InvariantCulture)) : _openedLayout.PageKey)
            + (string.IsNullOrWhiteSpace(_openedLayout.SiteKey) ? "" : (" · " + _openedLayout.SiteKey));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "layout_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpPageBuilderDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _layouts = result.Layouts;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpPageBuilderLayoutDetailAsync(_openedId, ctx.RequestAborted);
            _openedLayout = detail.Layout;
            if (_openedLayout is not null)
            {
                var openedList = _layouts.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _layouts = new[] { openedList }.Concat(_layouts.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
