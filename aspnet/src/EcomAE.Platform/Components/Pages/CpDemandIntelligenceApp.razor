@page "/cp/demand-intelligence-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Demand intelligence · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Demand intelligence
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/demand-intelligence-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/demand-intelligence-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_summary.CountryCount.ToString(CultureInfo.InvariantCulture) Countries · @_summary.ArticleDemandCount.ToString(CultureInfo.InvariantCulture) Articles · @_summary.PriceListDemandCount.ToString(CultureInfo.InvariantCulture) Price lists · @_summary.UserDemandCount.ToString(CultureInfo.InvariantCulture) Users.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Sort</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="4">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@(!string.IsNullOrWhiteSpace(row.Code) ? row.Code : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                            <td>@row.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/demand_countries";
    private bool _isAdmin;
    private CpDemandIntelligenceSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpDemandIntelligenceCountryDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpDemandIntelligenceDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Countries;
        _source = result.Source;
        _message = result.Message;
    }
}
