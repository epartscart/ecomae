@page "/cp/auto-price-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Auto Price · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-ap-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#134e4a 0%,#0f766e 50%,#14b8a6 100%);
        }
        .epc-ap-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-ap-hero p { margin:0; color:#ccfbf1; max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-ap-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-ap-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#134e4a; background:#99f6e4;
        }
        .epc-ap-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-ap-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-ap-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-ap-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-ap-kpi span { color:#64748b; font-size:.78rem; }
        .epc-ap-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-ap-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-ap-table th, .epc-ap-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-ap-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-ap-note { margin-top:1rem; padding:.75rem .9rem; background:#f0fdfa; border:1px solid #99f6e4; border-radius:.45rem; color:#115e59; font-size:.86rem; }
        @@media (max-width:900px){ .epc-ap-kpis{grid-template-columns:1fr;} }
    </style>

    <section class="epc-ap-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Auto Price</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-ap-cta">
            <a href="@_phpTab">Open module</a>
            <a class="ghost" href="/cp/price-lists-app">Price lists</a>
        </div>
    </section>

    <div class="epc-ap-kpis" aria-label="Auto-price stats">
        <div class="epc-ap-kpi"><strong>@_summary.ActiveRules.ToString(CultureInfo.InvariantCulture)</strong><span>Active rules</span></div>
        <div class="epc-ap-kpi"><strong>@_summary.ActiveSources.ToString(CultureInfo.InvariantCulture)</strong><span>Active sources</span></div>
        <div class="epc-ap-kpi"><strong>@_summary.CompareRuns.ToString(CultureInfo.InvariantCulture)</strong><span>Compare runs</span></div>
    </div>

    <div class="epc-ap-table-wrap">
        <table class="epc-ap-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Site</th>
                    <th>Rule</th>
                    <th>Min margin %</th>
                    <th>Auto update</th>
                    <th>Schedule h</th>
                    <th>Active</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rules.Count == 0)
                {
                    <tr><td colspan="9">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var r in _rules)
                    {
                        <tr>
                            <td><strong>@r.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(r.SiteKey) ? "—" : r.SiteKey)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.RuleKey) ? "—" : r.RuleKey)</td>
                            <td>@r.MinMarginPercent.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(r.AutoUpdatePrices ? "yes" : "no")</td>
                            <td>@r.ScheduleHours.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(r.Active ? "yes" : "no")</td>
                            <td>@(r.UpdatedAt > 0 ? r.UpdatedAt.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><a href="@_phpTab">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_auto_price_engine";
    private bool _isAdmin;
    private CpAutoPriceSummary _summary = new(0, 0, 0, "n/a", "");
    private IReadOnlyList<CpAutoPriceRuleDigest> _rules = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpAutoPriceDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rules = result.Rules;
        _source = result.Source;
        _message = result.Message;
    }
}
