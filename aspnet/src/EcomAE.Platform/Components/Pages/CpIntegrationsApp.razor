@page "/cp/integrations-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Integrations · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-int-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#134e4a 0%,#0f766e 50%,#2dd4bf 100%);
        }
        .epc-int-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-int-hero p { margin:0; color:rgba(255,255,255,.85); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-int-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-int-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#134e4a; background:#ccfbf1;
        }
        .epc-int-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-int-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-int-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-int-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-int-kpi span { color:#64748b; font-size:.78rem; }
        .epc-int-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-int-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-int-table th, .epc-int-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-int-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-int-note { margin-top:1rem; padding:.75rem .9rem; background:#f0fdfa; border:1px solid #5eead4; border-radius:.45rem; color:#115e59; font-size:.86rem; }
        @@media (max-width:900px){ .epc-int-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-int-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Integrations</h1>
        <p>Read-only webhook KPIs + endpoints from <code>/cp/integrations</code>. Secrets and delivery payloads stay off this digest.</p>
        <div class="epc-int-cta">
            <a href="@_phpTab">Open PHP</a>
            <a class="ghost" href="@PhpModuleCatalog.HybridWorkspaceHref("/cp/app", _phpTab)">Hybrid workspace</a>
            <a class="ghost" href="/cp/app">Command centre</a>
        </div>
    </section>

    <div class="epc-int-kpis" aria-label="Integrations stats">
        <div class="epc-int-kpi"><strong>@_summary.WebhookCount.ToString(CultureInfo.InvariantCulture)</strong><span>Webhooks</span></div>
        <div class="epc-int-kpi"><strong>@_summary.ActiveWebhooks.ToString(CultureInfo.InvariantCulture)</strong><span>Active</span></div>
        <div class="epc-int-kpi"><strong>@_summary.DeliveryCount.ToString(CultureInfo.InvariantCulture)</strong><span>Deliveries</span></div>
        <div class="epc-int-kpi"><strong>@_summary.FailedDeliveries.ToString(CultureInfo.InvariantCulture)</strong><span>Failed / DLQ</span></div>
    </div>

    <div class="epc-int-table-wrap">
        <table class="epc-int-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Tenant</th>
                    <th>URL</th>
                    <th>Description</th>
                    <th>Active</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_integrations.Count == 0)
                {
                    <tr><td colspan="7">No rows in digest (@_source). @_message</td></tr>
                }
                else
                {
                    @foreach (var row in _integrations)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.TenantKey) ? row.TenantKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Url) ? row.Url : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Description) ? row.Description : "—")</td>
                            <td>@(row.Active ? "yes" : "no")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CreatedAt) ? row.CreatedAt : "—")</td>
                            <td><a href="@_phpTab">Open in PHP</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-int-note">
        Read-only preview · JSON digest <a href="/cp/integrations?limit=200">/cp/integrations</a>. PHP epc_integrations_hub remains authoritative. secret_hash/secret_encrypted/events omitted · Not a broad /cp cutover · tenant product chrome stays PHP.
        Source: <code>@_source</code>.
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_integrations_hub";
    private bool _isAdmin;
    private CpIntegrationsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpIntegrationDigest> _integrations = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpIntegrationsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _integrations = result.Integrations;
        _source = result.Source;
        _message = result.Message;
    }
}
