@page "/cp/integrations-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Integrations · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-int-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-int-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-int-hero p { margin:0; color:rgba(255,255,255,.85); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-int-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-int-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0c4a6e; background:#e0f2fe;
        }
        .epc-int-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-int-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-int-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-int-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-int-kpi span { color:#64748b; font-size:.78rem; }
        .epc-int-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-int-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-int-table th, .epc-int-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-int-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        @@media (max-width:900px){ .epc-int-kpis{grid-template-columns:1fr 1fr;} }
    
</style>
</HeadContent>


<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-int-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Integrations</h1>
        <p>Payments, couriers, Amazon and marketplace channels, messaging, and data connectors — one hub for every partner rail.</p>
        <div class="epc-int-cta">
            <a href="@_hubHref">Open hub</a>
            <a class="ghost" href="@_guideHref">Guides</a>
        </div>
    </section>

    <div class="epc-int-kpis" aria-label="Integrations stats">
        <div class="epc-int-kpi"><strong>@_summary.CatalogCount.ToString(CultureInfo.InvariantCulture)</strong><span>Integrations</span></div>
        <div class="epc-int-kpi"><strong>@_summary.ActiveCount.ToString(CultureInfo.InvariantCulture)</strong><span>Active</span></div>
        <div class="epc-int-kpi"><strong>@_summary.CategoryCount.ToString(CultureInfo.InvariantCulture)</strong><span>Categories</span></div>
        <div class="epc-int-kpi"><strong>@_summary.GuideCount.ToString(CultureInfo.InvariantCulture)</strong><span>Guides</span></div>
    </div>

    <div class="epc-int-table-wrap">
        <table class="epc-int-table">
            <thead>
                <tr>
                    <th>Integration</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>About</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_integrations.Count == 0)
                {
                    <tr><td colspan="5">No integrations in the hub catalog.</td></tr>
                }
                else
                {
                    @foreach (var row in _integrations)
                    {
                        <tr>
                            <td>@(!string.IsNullOrWhiteSpace(row.Label) ? row.Label : row.Key)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Category) ? row.Category : "—")</td>
                            <td>@(row.Active ? "active" : "off")</td>
                            <td style="white-space:normal;max-width:28rem">@(!string.IsNullOrWhiteSpace(row.Blurb) ? row.Blurb : "—")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(row.ConfigureUrl))
                                {
                                    <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(row.ConfigureUrl)">Configure</a>
                                }
                                else
                                {
                                    <a href="@_hubHref">Open hub</a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _hubHref = "/cp/integrations-app";
    private const string _guideHref = "/cp/ops-guides-app";
    private bool _isAdmin;
    private CpIntegrationsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpIntegrationDigest> _integrations = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpIntegrationsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _integrations = result.Integrations;
    }
}
