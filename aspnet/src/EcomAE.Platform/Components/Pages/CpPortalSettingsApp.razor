@page "/cp/portal-settings-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Portal settings · Super CP · ECOM AE</PageTitle>
<PhpChromeStyles Surface="cp" />

@if (_allowed)
{
    <PhpCpDesktopChrome IsAdmin="_isAdmin">

        <PhpCpModulePageHeader Title="Portal settings"
                               Subtitle="Super CP multi-site fleet inventory (hosts, industries, access modes, deploy targets). Tenant CPs never see this console — each tenant manages its own settings independently."
                               PhpTabHref="@_phpTab"
                               ExtraPanelClass="epc-scp-panel--portal-settings">
            <a class="ghost" href="/cp/tenants-app">Tenants</a>
            <a class="ghost" href="/cp/industry-packs-app">Industry packs</a>
            <a class="ghost" href="/bos/app">BOS fleet</a>
        </PhpCpModulePageHeader>

        <div class="epc-scp-kpi" aria-label="Portal settings stats">
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">Sites</div>
                <div class="epc-scp-kpi__val">@_summary.SiteCount.ToString(CultureInfo.InvariantCulture)</div>
            </div>
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">Industries</div>
                <div class="epc-scp-kpi__val">@_summary.IndustryCount.ToString(CultureInfo.InvariantCulture)</div>
            </div>
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">Access modes</div>
                <div class="epc-scp-kpi__val">@_summary.AccessModeCount.ToString(CultureInfo.InvariantCulture)</div>
            </div>
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">Deploy targets</div>
                <div class="epc-scp-kpi__val">@_summary.DeployTargetCount.ToString(CultureInfo.InvariantCulture)</div>
            </div>
        </div>

        <div class="epc-scp-table-card">
            <table class="epc-scp-data-table table table-epc-pro">
                <thead>
                    <tr>
                        <th>Host</th>
                        <th>Industry</th>
                        <th>System</th>
                        <th>Hub</th>
                        <th>Theme</th>
                        <th>Access</th>
                        <th>Lang</th>
                        <th>Country</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_rows.Count == 0)
                    {
                        <tr><td colspan="9">Nothing to show yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in _rows)
                        {
                            <tr>
                                <td>@(!string.IsNullOrWhiteSpace(row.Host) ? row.Host : "—")</td>
                                <td>@(!string.IsNullOrWhiteSpace(row.IndustryCode) ? row.IndustryCode : "—")</td>
                                <td>@(!string.IsNullOrWhiteSpace(row.SystemName) ? row.SystemName : "—")</td>
                                <td>@(!string.IsNullOrWhiteSpace(row.HubName) ? row.HubName : "—")</td>
                                <td>@(!string.IsNullOrWhiteSpace(row.ThemeTemplate) ? row.ThemeTemplate : "—")</td>
                                <td>@(!string.IsNullOrWhiteSpace(row.AccessMode) ? row.AccessMode : "—")</td>
                                <td>@(!string.IsNullOrWhiteSpace(row.CpDefaultLang) ? row.CpDefaultLang : "—")</td>
                                <td>@(!string.IsNullOrWhiteSpace(row.CountryCode) ? row.CountryCode : "—")</td>
                                <td class="epc-scp-actions-cell"><a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Open</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <p class="text-muted small" style="margin-top:12px">
            Super CP only. Tenant hosts (e.g. epartscart.com) receive a not-found gate — no fleet inventory, deploy targets, or platform credentials.
            Writes remain PHP industry/portal settings authoritative.
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <span> · @_message (@_source)</span>
            }
        </p>

    </PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>Portal fleet settings are available on the platform Super CP host only. This tenant Control Panel is independent — it does not show Super CP site inventory or deploy secrets.</p>
        <p>
            <a href="/cp">Open Control Panel</a>
            · <a href="/cp/config-items-app">Tenant config</a>
            · <a href="/cp/tenant-email-app">Tenant email / SMTP</a>
            · <a href="/cp/industry-packs-app">Industry packs</a>
        </p>
    </div>
}

@code {
    private const string _phpTab = "/CP/control/portal/industry_settings";
    private bool _allowed;
    private bool _isAdmin;
    private CpPortalSettingsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPortalSettingsRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpPortalSettingsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Sites;
        _source = result.Source;
        _message = result.Message;
    }
}
