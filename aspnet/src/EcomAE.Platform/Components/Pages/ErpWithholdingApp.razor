@page "/erp/withholding-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Withholding · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Withholding" BreadcrumbArea="Tax" BreadcrumbTab="Withholding">

    <PhpErpModulePageHeader Title="Withholding tax" Subtitle="Save a withholding code, apply it on a payment, issue a certificate, or settle an accrued transaction here. Open a row for company, certificate, and settle." />
    <PhpErpD365ActionPane RefreshHref="@Nav.Uri" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedDetail is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/withholding/codes/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_listHref" />
            <input type="hidden" name="id" value="0" />
            <label>Code <input type="text" name="code" required maxlength="40" style="width:7rem" /></label>
            <label>Name <input type="text" name="name" required maxlength="160" style="width:12rem" /></label>
            <label>Rate % <input type="number" name="rate" step="0.01" min="0" max="100" required style="width:6rem" /></label>
            <label>GL account <input type="text" name="account" maxlength="60" style="width:8rem" /></label>
            <label>Active
                <select name="active">
                    <option value="1" selected>active</option>
                    <option value="0">inactive</option>
                </select>
            </label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit">Save code</button>
        </form>
        <form method="post" action="/erp/withholding/txns/record" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_listHref" />
            <label>Code id <input type="number" name="code_id" min="1" required style="width:6rem" /></label>
            <label>Vendor <input type="text" name="vendor" maxlength="180" style="width:10rem" /></label>
            <label>Doc ref <input type="text" name="doc_ref" maxlength="80" style="width:8rem" /></label>
            <label>Date <input type="date" name="txn_date" style="width:10rem" /></label>
            <label>Base amount <input type="number" name="base_amount" step="0.01" min="0.01" required style="width:8rem" /></label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit">Apply withholding</button>
        </form>
        <form method="post" action="/erp/withholding/txns/certificate" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Transaction id <input type="number" name="id" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
            <label>Certificate no <input type="text" name="certificate_no" maxlength="60" placeholder="auto" style="width:10rem" /></label>
            <button type="submit">Issue certificate</button>
        </form>
        <form method="post" action="/erp/ajax/wht-settle" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Transaction id <input type="number" name="id" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
            <button type="submit">Settle withholding</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Withholding KPIs">
        <div class="kpi"><div class="lbl">Codes</div><div class="val">@_summary.CodeCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Transactions</div><div class="val">@_summary.TxnCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Accrued</div><div class="val">@_summary.Accrued.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Settled</div><div class="val">@_summary.Settled.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Total withheld</div><div class="val">@_summary.TotalWithheld.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    <h2 style="font-size:16px;margin-top:8px;">Codes</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th class="text-right">Rate %</th>
                    <th>GL account</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                @if (_codes.Count == 0)
                {
                    <tr><td colspan="5">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No codes yet." : _message) : "Sign in with ERP capability for live tax rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _codes)
                    {
                        <tr>
                            <td><strong>@row.Code</strong></td>
                            <td>@row.Name</td>
                            <td class="text-right">@row.Rate.ToString("0.00", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Account) ? "—" : row.Account)</td>
                            <td>@(row.Active ? "active" : "inactive")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (_openedDetail is not null)
    {
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                @(!string.IsNullOrWhiteSpace(_openedDetail.Vendor) ? _openedDetail.Vendor : ("Txn #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)))
                <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedDetail.Status) ? _openedDetail.Status : "—")</span>
            </div>
            <div class="panel-body">
                <p>Company @_openedDetail.CompanyId.ToString(CultureInfo.InvariantCulture)
                    · Code @(!string.IsNullOrWhiteSpace(_openedDetail.Code) ? _openedDetail.Code : "—")
                    · Rate @_openedDetail.Rate.ToString("0.00", CultureInfo.InvariantCulture)%</p>
                <p>Doc @(!string.IsNullOrWhiteSpace(_openedDetail.DocRef) ? _openedDetail.DocRef : "—")
                    · @_openedDetail.TxnDate</p>
                <p>Base @_openedDetail.BaseAmount.ToString("N2", CultureInfo.InvariantCulture)
                    · Withheld @_openedDetail.WhtAmount.ToString("N2", CultureInfo.InvariantCulture)</p>
                <p>Certificate @(!string.IsNullOrWhiteSpace(_openedDetail.CertificateNo) ? _openedDetail.CertificateNo : "none yet.")</p>
            </div>
        </div>
    }

    <h2 style="font-size:16px;margin-top:16px;">Transactions</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Vendor</th>
                    <th>Code</th>
                    <th>Doc</th>
                    <th>Date</th>
                    <th class="text-right">Base</th>
                    <th class="text-right">Withheld</th>
                    <th>Certificate</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_txns.Count == 0)
                {
                    <tr><td colspan="10">@(_isAdmin ? "No withholding transactions yet." : "Sign in with ERP capability for live tax rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _txns)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Vendor) ? "—" : row.Vendor)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Code) ? "—" : row.Code)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.DocRef) ? "—" : row.DocRef)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.TxnDate) ? "—" : row.TxnDate)</td>
                            <td class="text-right">@row.BaseAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.WhtAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.CertificateNo) ? "—" : row.CertificateNo)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "txn_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Settle, code save, record, and certificate write here.
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private ErpWithholdingSummary _summary = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<ErpWithholdingCodeDigest> _codes = [];
    private IReadOnlyList<ErpWithholdingTxnDigest> _txns = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private ErpWithholdingTxnDetail? _openedDetail;
    private const string _listHref = "/erp/withholding-app";
    private string _returnHref = "/erp/withholding-app";

    private string OpenedCaption => _openedDetail is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedDetail.Vendor) ? ("Txn #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.Vendor)
            + " · " + (string.IsNullOrWhiteSpace(_openedDetail.Status) ? "accrued" : _openedDetail.Status);

    private string OpenedIdValue => _openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "txn_id");
        _returnHref = _openedId > 0
            ? ErpRecordOpen.Href(_listHref, "txn_id", _openedId).Split('#')[0]
            : _listHref;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.BuildErpWithholdingDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _codes = result.Codes;
        _txns = result.Txns;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpWithholdingTxnDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Txn;
            if (_openedDetail is not null)
            {
                var openedList = _txns.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _txns = new[] { openedList }.Concat(_txns.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
