@page "/erp/product-info-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Product information · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Product information" BreadcrumbArea="PIM" BreadcrumbTab="Product information">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/product-info-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Product information" Subtitle="Open an item for track-expiry and same-type siblings. Field Open loads the 280-character options excerpt. Variant Open loads the 280-character combo excerpt. Create item writes here. Dimension-link save stays Classic." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    <ErpPhpFlash Ok="@_ok" Err="@_err" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Product information KPIs">
        <div class="kpi"><div class="lbl">Items</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Fields</div><div class="val">@_fieldCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <ErpPhpViewTabs QueryName="pm_view" Active="@_view" BaseHref="/erp/product-info-app" Tabs="@_views" />

    @if (_isAdmin && _view is "all" or "devkit" or "released")
    {
        <ErpPhpCreateWell Title="New item">
            <form method="post" action="/erp/ajax/inv-create-item" style="display:flex;gap:8px;flex-wrap:wrap;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/erp/product-info-app?pm_view=@_view" />
                <label>SKU <input class="form-control input-sm" name="sku" placeholder="SKU" required /></label>
                <label>Name <input class="form-control input-sm" name="name" placeholder="Name" required /></label>
                <button type="submit" class="btn btn-primary btn-sm">Create item</button>
            </form>
        </ErpPhpCreateWell>
    }

    @if (_openedItem is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedItemCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedItemReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Item id</dt><dd>@_openedItem.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>SKU</dt><dd>@(string.IsNullOrWhiteSpace(_openedItem.Sku) ? "—" : _openedItem.Sku)</dd>
                <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_openedItem.Name) ? "—" : _openedItem.Name)</dd>
                <dt>Type</dt><dd>@(string.IsNullOrWhiteSpace(_openedItem.ItemType) ? "—" : _openedItem.ItemType)</dd>
                <dt>Unit</dt><dd>@(string.IsNullOrWhiteSpace(_openedItem.Unit) ? "—" : _openedItem.Unit)</dd>
                <dt>Sales price</dt><dd>@_openedItem.SalesPrice.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Product id</dt><dd>@(_openedItem.ProductId > 0 ? _openedItem.ProductId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Track expiry</dt><dd>@(_openedItem.TrackExpiry ? "yes" : "no")</dd>
                <dt>Status</dt><dd>@(_openedItem.Active ? "active" : "inactive")</dd>
                <dt>Created</dt><dd>@FormatTime(_openedItem.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Create item writes here. Dimension-link save stays Classic.</p>
            @if (_openedItemSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-type siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>SKU</th><th>Name</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedItemSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Sku) ? "—" : sib.Sku)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Name) ? "—" : sib.Name)</td>
                                <td>@(sib.Active ? "active" : "inactive")</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "pm_item_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-type siblings yet.</p>
            }
        </div>
    }

    @if (_openedField is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedFieldCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedFieldReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Field id</dt><dd>@_openedField.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Key</dt><dd>@(string.IsNullOrWhiteSpace(_openedField.FieldKey) ? "—" : _openedField.FieldKey)</dd>
                <dt>Label</dt><dd>@(string.IsNullOrWhiteSpace(_openedField.Label) ? "—" : _openedField.Label)</dd>
                <dt>Type</dt><dd>@(string.IsNullOrWhiteSpace(_openedField.FieldType) ? "—" : _openedField.FieldType)</dd>
                <dt>Role</dt><dd>@(string.IsNullOrWhiteSpace(_openedField.FieldRole) ? "—" : _openedField.FieldRole)</dd>
                <dt>Status</dt><dd>@(_openedField.Active ? "active" : "inactive")</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Create item writes here. Dimension-link save stays Classic.</p>
            @if (!string.IsNullOrWhiteSpace(_openedField.OptionsExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">options excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedField.OptionsExcerpt</pre>
                @if (_openedField.OptionsLen > _openedField.OptionsExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_openedField.OptionsExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedField.OptionsLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No options excerpt yet.</p>
            }
            @if (_openedFieldSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-type siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Key</th><th>Label</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedFieldSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.FieldKey) ? "—" : sib.FieldKey)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Label) ? "—" : sib.Label)</td>
                                <td>@(sib.Active ? "active" : "inactive")</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "pm_field_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-type siblings yet.</p>
            }
        </div>
    }

    @if (_openedVariant is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedVariantCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedVariantReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Variant id</dt><dd>@_openedVariant.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Variant SKU</dt><dd>@(string.IsNullOrWhiteSpace(_openedVariant.VariantSku) ? "—" : _openedVariant.VariantSku)</dd>
                <dt>Base</dt><dd>@(string.IsNullOrWhiteSpace(_openedVariant.BaseSku) ? "—" : _openedVariant.BaseSku)</dd>
                <dt>Label</dt><dd>@(string.IsNullOrWhiteSpace(_openedVariant.VariantLabel) ? "—" : _openedVariant.VariantLabel)</dd>
                <dt>Item id</dt><dd>@(_openedVariant.ItemId > 0 ? _openedVariant.ItemId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Status</dt><dd>@(_openedVariant.Active ? "active" : "inactive")</dd>
                <dt>Created</dt><dd>@FormatTime(_openedVariant.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Create item writes here. Dimension-link save stays Classic.</p>
            @if (!string.IsNullOrWhiteSpace(_openedVariant.ComboExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">combo excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedVariant.ComboExcerpt</pre>
                @if (_openedVariant.ComboLen > _openedVariant.ComboExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_openedVariant.ComboExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedVariant.ComboLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No combo excerpt yet.</p>
            }
            @if (_openedVariantSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-item siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Variant SKU</th><th>Label</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedVariantSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.VariantSku) ? "—" : sib.VariantSku)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.VariantLabel) ? "—" : sib.VariantLabel)</td>
                                <td>@(sib.Active ? "active" : "inactive")</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "pm_variant_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-item siblings yet.</p>
            }
        </div>
    }

    @if (_view == "fields")
    {
        <h2 style="font-size:16px;">Field setup</h2>
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead><tr><th>Key</th><th>Label</th><th>Type</th><th>Role</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @if (_fields.Count == 0) { <tr><td colspan="6">No field definitions yet.</td></tr> }
                    else
                    {
                        @foreach (var row in _fields)
                        {
                            <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedFieldId)">
                                <td>@row.FieldKey</td>
                                <td><strong>@row.Label</strong></td>
                                <td>@row.FieldType</td>
                                <td>@row.FieldRole</td>
                                <td><span class="label label-default">@(row.Active ? "active" : "inactive")</span></td>
                                <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "pm_field_id", row.Id)">Open</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_view == "dimensions")
    {
        <h2 style="font-size:16px;">Dimensions &amp; variants</h2>
        <p class="text-muted">Product / storage / tracking dimensions drive variant generation (Size, Colour, Style, Configuration, Version).</p>
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead><tr><th>Variant SKU</th><th>Base</th><th>Label</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @if (_variants.Count == 0) { <tr><td colspan="5">No variants yet.</td></tr> }
                    else
                    {
                        @foreach (var row in _variants)
                        {
                            <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedVariantId)">
                                <td><strong>@(string.IsNullOrWhiteSpace(row.VariantSku) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.VariantSku)</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(row.BaseSku) ? "—" : row.BaseSku)</td>
                                <td>@(string.IsNullOrWhiteSpace(row.VariantLabel) ? "—" : row.VariantLabel)</td>
                                <td><span class="label label-default">@(row.Active ? "active" : "inactive")</span></td>
                                <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "pm_variant_id", row.Id)">Open</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <h2 style="font-size:16px;">@(_view == "devkit" ? "Product dev kit" : _view == "released" ? "Release product" : "All products")</h2>
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead><tr><th>SKU</th><th>Name</th><th>Type</th><th>Unit</th><th class="text-right">Sales price</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @if (_shownItems.Count == 0)
                    {
                        <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No product items yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                    }
                    else
                    {
                        @foreach (var row in _shownItems)
                        {
                            <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedItemId)">
                                <td>@(string.IsNullOrWhiteSpace(row.Sku) ? "—" : row.Sku)</td>
                                <td><strong>@(string.IsNullOrWhiteSpace(row.Name) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Name)</strong></td>
                                <td>@row.ItemType</td>
                                <td>@row.Unit</td>
                                <td class="text-right">@row.SalesPrice.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><span class="label label-default">@(row.Active ? "active" : "inactive")</span></td>
                                <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "pm_item_id", row.Id)">Open</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Create item writes <code>epc_erp_inv_items</code> when confirmWrites is set. Dimension-link save stays Classic.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=pim&tab=product_info";
    private const string _listHref = "/erp/product-info-app";
    private static readonly IReadOnlyList<(string Key, string Label)> _views =
        [("devkit", "Product dev kit"), ("all", "All products"), ("released", "Release product"), ("dimensions", "Dimensions & variants"), ("fields", "Field setup")];
    private bool _isAdmin;
    private string _view = "all";
    private IReadOnlyList<ErpProductInfoItemDigest> _items = [];
    private IReadOnlyList<ErpProductInfoItemDigest> _shownItems = [];
    private IReadOnlyList<ErpProductInfoFieldDigest> _fields = [];
    private IReadOnlyList<ErpProductInfoVariantDigest> _variants = [];
    private int _count, _active, _fieldCount;
    private string _source = "n/a";
    private string _message = "";
    private string _ok = "";
    private string _err = "";
    private long _openedItemId;
    private long _openedFieldId;
    private long _openedVariantId;
    private ErpProductInfoItemDetail? _openedItem;
    private ErpProductInfoFieldDetail? _openedField;
    private ErpProductInfoVariantDetail? _openedVariant;
    private IReadOnlyList<ErpProductInfoItemDigest> _openedItemSiblings = [];
    private IReadOnlyList<ErpProductInfoFieldDigest> _openedFieldSiblings = [];
    private IReadOnlyList<ErpProductInfoVariantDigest> _openedVariantSiblings = [];

    private long _openedId => _openedItemId > 0 ? _openedItemId : (_openedFieldId > 0 ? _openedFieldId : _openedVariantId);

    private bool OpenedFound => _openedItem is not null || _openedField is not null || _openedVariant is not null;

    private string OpenedItemReturnHref => _openedItemId > 0
        ? _listHref + "?pm_item_id=" + _openedItemId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedFieldReturnHref => _openedFieldId > 0
        ? _listHref + "?pm_field_id=" + _openedFieldId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedVariantReturnHref => _openedVariantId > 0
        ? _listHref + "?pm_variant_id=" + _openedVariantId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedItemCaption => _openedItem is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedItem.Name)
            ? ("Item #" + _openedItem.Id.ToString(CultureInfo.InvariantCulture))
            : _openedItem.Name)
            + (string.IsNullOrWhiteSpace(_openedItem.Sku) ? "" : (" · " + _openedItem.Sku));

    private string OpenedFieldCaption => _openedField is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedField.Label)
            ? ("Field #" + _openedField.Id.ToString(CultureInfo.InvariantCulture))
            : _openedField.Label)
            + (string.IsNullOrWhiteSpace(_openedField.FieldKey) ? "" : (" · " + _openedField.FieldKey));

    private string OpenedVariantCaption => _openedVariant is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedVariant.VariantSku)
            ? ("Variant #" + _openedVariant.Id.ToString(CultureInfo.InvariantCulture))
            : _openedVariant.VariantSku);

    private string OpenedCaption => _openedItem is not null
        ? OpenedItemCaption
        : (_openedField is not null ? OpenedFieldCaption : OpenedVariantCaption);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var v = ctx.Request.Query["pm_view"].ToString();
        _view = v is "devkit" or "released" or "dimensions" or "fields" or "all" ? v : "all";
        _ok = ctx.Request.Query["ok"].ToString();
        _err = ctx.Request.Query["err"].ToString();
        _openedItemId = ErpRecordOpen.ReadId(ctx.Request, "pm_item_id");
        _openedFieldId = ErpRecordOpen.ReadId(ctx.Request, "pm_field_id");
        _openedVariantId = ErpRecordOpen.ReadId(ctx.Request, "pm_variant_id");
        if (string.IsNullOrWhiteSpace(v))
        {
            if (_openedFieldId > 0) _view = "fields";
            else if (_openedVariantId > 0) _view = "dimensions";
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpProductInfoDigestAsync(200, ctx.RequestAborted);
        _items = result.Items;
        _fields = result.FieldDefs;
        _variants = result.Variants;
        _count = result.Count;
        _active = result.ActiveCount;
        _fieldCount = result.FieldCount;
        _source = result.Source;
        _message = result.Message;
        _shownItems = _view switch
        {
            "released" => _items.Where(i => i.Active).ToList(),
            "devkit" => _items.Where(i => !i.Active).ToList(),
            _ => _items,
        };

        if (_openedItemId > 0)
        {
            var detail = await Dashboards.BuildErpProductInfoItemDetailAsync(_openedItemId, ctx.RequestAborted);
            _openedItem = detail.Item;
            _openedItemSiblings = detail.Siblings;
            if (_openedItem is not null)
            {
                var openedList = _shownItems.FirstOrDefault(i => i.Id == _openedItemId)
                    ?? _items.FirstOrDefault(i => i.Id == _openedItemId);
                if (openedList is not null)
                {
                    _shownItems = new[] { openedList }.Concat(_shownItems.Where(i => i.Id != _openedItemId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }

        if (_openedFieldId > 0)
        {
            var detail = await Dashboards.BuildErpProductInfoFieldDetailAsync(_openedFieldId, ctx.RequestAborted);
            _openedField = detail.Field;
            _openedFieldSiblings = detail.Siblings;
            if (_openedField is not null)
            {
                var openedList = _fields.FirstOrDefault(f => f.Id == _openedFieldId);
                if (openedList is not null)
                {
                    _fields = new[] { openedList }.Concat(_fields.Where(f => f.Id != _openedFieldId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message) && _openedItem is null)
            {
                _message = detail.Message;
            }
        }

        if (_openedVariantId > 0)
        {
            var detail = await Dashboards.BuildErpProductInfoVariantDetailAsync(_openedVariantId, ctx.RequestAborted);
            _openedVariant = detail.Variant;
            _openedVariantSiblings = detail.Siblings;
            if (_openedVariant is not null)
            {
                var openedList = _variants.FirstOrDefault(x => x.Id == _openedVariantId);
                if (openedList is not null)
                {
                    _variants = new[] { openedList }.Concat(_variants.Where(x => x.Id != _openedVariantId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message) && _openedItem is null && _openedField is null)
            {
                _message = detail.Message;
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
