@page "/erp/product-info-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IErpInvCreateItemDryRun ItemSave
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Product information · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Product information" BreadcrumbArea="PIM" BreadcrumbTab="Product information">
    <PhpErpModulePageHeader Title="Product information" Subtitle="Item master, field roles and variants. Saves stay dry-run." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Product information KPIs">
        <div class="kpi"><div class="lbl">Items</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Fields</div><div class="val">@_fieldCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <form @onsubmit="OnSave" @onsubmit:preventDefault="true" style="margin:12px 0;padding:10px;border:1px solid #c5d4de;background:#fff;">
            <strong>New item (dry-run)</strong>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;align-items:end;">
                <label>SKU <input class="form-control" @bind="_formCode" /></label>
                <button type="submit" class="btn btn-primary">Validate save</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_formResult)) { <p style="margin:8px 0 0;font-size:12px;">@_formResult</p> }
        </form>
    }

    <h2 style="font-size:16px;">Items</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>SKU</th><th>Name</th><th>Type</th><th>Unit</th><th class="text-right">Sales price</th><th>Status</th></tr></thead>
            <tbody>
                @if (_items.Count == 0)
                {
                    <tr><td colspan="6">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No product items yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _items)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(row.Sku) ? "—" : row.Sku)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Name) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Name)</strong></td>
                            <td>@row.ItemType</td>
                            <td>@row.Unit</td>
                            <td class="text-right">@row.SalesPrice.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><span class="label label-default">@(row.Active ? "active" : "inactive")</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="font-size:16px;">Field setup</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Key</th><th>Label</th><th>Type</th><th>Role</th><th>Status</th></tr></thead>
            <tbody>
                @if (_fields.Count == 0) { <tr><td colspan="5">No field definitions yet.</td></tr> }
                else
                {
                    @foreach (var row in _fields)
                    {
                        <tr>
                            <td>@row.FieldKey</td>
                            <td><strong>@row.Label</strong></td>
                            <td>@row.FieldType</td>
                            <td>@row.FieldRole</td>
                            <td><span class="label label-default">@(row.Active ? "active" : "inactive")</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="font-size:16px;">Variants</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Variant SKU</th><th>Base</th><th>Label</th><th>Status</th></tr></thead>
            <tbody>
                @if (_variants.Count == 0) { <tr><td colspan="4">No variants yet.</td></tr> }
                else
                {
                    @foreach (var row in _variants)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.VariantSku) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.VariantSku)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.BaseSku) ? "—" : row.BaseSku)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.VariantLabel) ? "—" : row.VariantLabel)</td>
                            <td><span class="label label-default">@(row.Active ? "active" : "inactive")</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Dry-run: <code>inv_create_item</code> — writes=0.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=pim&tab=product_info";
    private bool _isAdmin;
    private IReadOnlyList<ErpProductInfoItemDigest> _items = [];
    private IReadOnlyList<ErpProductInfoFieldDigest> _fields = [];
    private IReadOnlyList<ErpProductInfoVariantDigest> _variants = [];
    private int _count, _active, _fieldCount;
    private string _source = "n/a";
    private string _message = "";
    private string _formCode = "";
    private string _formResult = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpProductInfoDigestAsync(200, ctx.RequestAborted);
        _items = result.Items;
        _fields = result.FieldDefs;
        _variants = result.Variants;
        _count = result.Count;
        _active = result.ActiveCount;
        _fieldCount = result.FieldCount;
        _source = result.Source;
        _message = result.Message;
    }

    private void OnSave()
    {
        var result = ItemSave.Evaluate(new ErpInvCreateItemRequest(0, _formCode, false));
        _formResult = $"{result.Status}: {result.Detail} (writes={result.Writes.ToString(CultureInfo.InvariantCulture)})";
    }
}
