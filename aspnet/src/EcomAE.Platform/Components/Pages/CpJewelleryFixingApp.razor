@page "/erp/jewellery-fixing-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject IErpJwPurchaseHistoryReadService Purchases
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Jewellery fixing · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="@_spec.Title" BreadcrumbArea="Jewellery" BreadcrumbTab="@_spec.Label">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="@_appPath" IsAdmin="_isAdmin" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />
    <PhpErpModulePageHeader Title="@_spec.Title" Subtitle="@_spec.Subtitle" />
    <ErpPhpFlash Ok="@_ok" Err="@_err" />
    <ErpJewelleryReportsMenu />
    @if (_opened is not null)
    {
        <ErpRecordDetailView Caption="@OpenedCaption" Status="@_opened.Status" ListHref="@_listHref" PrintHref="@($"/erp/jewellery/voucher-print?id={_openedId}&kind=fixing")" DesignKind="jw_fixing">
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong> <a class="btn btn-xs btn-default" href="@_listHref">Close</a></p>
            <dl class="epc-erp-facts">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Fix no</dt><dd>@_opened.FixNo.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Date</dt><dd>@(string.IsNullOrWhiteSpace(_opened.FixDate) ? "—" : _opened.FixDate)</dd>
                <dt>Type</dt><dd>@(string.IsNullOrWhiteSpace(_opened.FixType) ? "—" : _opened.FixType)</dd>
                <dt>Party</dt><dd>@(string.IsNullOrWhiteSpace(_opened.PartyName) ? (string.IsNullOrWhiteSpace(_opened.PartyCode) ? "—" : _opened.PartyCode) : _opened.PartyName)</dd>
                <dt>Party code</dt><dd>@(string.IsNullOrWhiteSpace(_opened.PartyCode) ? "—" : _opened.PartyCode)</dd>
                <dt>Metal</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Metal) ? "—" : _opened.Metal)</dd>
                <dt>Karat</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Karat) ? "—" : _opened.Karat)</dd>
                <dt>Rate type</dt><dd>@(string.IsNullOrWhiteSpace(_opened.RateType) ? "—" : _opened.RateType)</dd>
                <dt>Fix rate</dt><dd>@_opened.FixRate.ToString("N5", CultureInfo.InvariantCulture)</dd>
                <dt>Qty g</dt><dd>@_opened.FixQtyGms.ToString("N3", CultureInfo.InvariantCulture)</dd>
                <dt>Amount</dt><dd>@_opened.FixAmount.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Unfixed qty</dt><dd>@_opened.UnfixedQty.ToString("N3", CultureInfo.InvariantCulture)</dd>
                <dt>Ref voc</dt><dd>@(string.IsNullOrWhiteSpace(_opened.ReferenceVoc) ? "—" : _opened.ReferenceVoc)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Status) ? "—" : _opened.Status)</dd>
                <dt>Business unit</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Branch) ? "—" : _opened.Branch)</dd>
                <dt>Created by</dt><dd>@(string.IsNullOrWhiteSpace(_opened.CreatedBy) ? "—" : _opened.CreatedBy)</dd>
            </dl>
            @if (!string.IsNullOrWhiteSpace(_opened.RemarksExcerpt))
            {
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:.85rem 0 0">@_opened.RemarksExcerpt</pre>
                @if (_opened.RemarksLen > _opened.RemarksExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.RemarksExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.RemarksLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No remarks excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Fix no</th>
                            <th>Party</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@sib.FixNo.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.PartyName) ? (string.IsNullOrWhiteSpace(sib.PartyCode) ? "—" : sib.PartyCode) : sib.PartyName)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "fixing_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
            </ErpRecordDetailView>
    }
    else
    {

    @if (_tab is not ("jw_metal_purchase" or "jw_diamond_purchase"))
    {
    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Jewellery fixing stats">
        <div class="kpi"><div class="lbl">Fixings</div><div class="val">@_summary.FixingCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open</div><div class="val">@_summary.OpenFixingCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Purchases</div><div class="val">@_summary.PurchaseFixCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Settlements</div><div class="val">@_summary.SettlementCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Petty cash</div><div class="val">@_summary.PettyCashCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>
    }


    <ErpPhpViewTabs QueryName="tab" Active="@_tab" BaseHref="@_tabBase" Tabs="@ErpJewelleryModuleChrome.FixingTabs" />

    @if (_isAdmin && _tab == "jw_metal_purchase")
    {
        @if (_savedId > 0)
        {
            <div class="jw-saved" role="status" data-jw-saved="@_savedId.ToString(CultureInfo.InvariantCulture)">
                <i class="fa fa-check-circle" aria-hidden="true"></i>
                <span>Voucher saved and posted to the general ledger.</span>
                <a class="btn btn-sm btn-primary" href="/erp/purchase-print?jwId=@_savedId.ToString(CultureInfo.InvariantCulture)" target="_blank" rel="noopener"><i class="fa fa-print" aria-hidden="true"></i> Invoice print preview</a>
                <a class="btn btn-sm btn-default" href="@ErpRecordOpen.Href("/erp/jewellery-retail-app", "voc_id", _savedId)">Open voucher</a>
                <a class="btn btn-sm btn-default" href="@_returnHere">New entry</a>
            </div>
        }
        <ErpJwEntryStyles />
        <ErpPhpCreateWell Title="Metal Purchase (FIXING GOLD)">
            <form method="post" action="@WriteAction(EcomAeRoutes.ErpJewelleryVoucherSaveForm)" class="epc-jw-bm-form jw-mp" data-epc-jw-purchase="1" data-jw-draft="jw-metal-purchase" autocomplete="off">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <input type="hidden" name="action" value="jw_metal_purchase_save" />
                <input type="hidden" name="voc_type" value="RMP" />
                <input type="hidden" name="after_save" value="" data-jw-after-save />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <div class="jw-mp-wrap" style="grid-column:1 / -1;display:block;width:100%;min-width:0">
                <section class="jw-mp-card">
                    <h4>Invoice details</h4>
                    <div class="jw-mp-grid">
                        <ErpMasterPicker Kind="business_unit" FieldName="branch" Label="Business unit" ValueMode="code" SelectedCode="HQ" InputId="jw-mp-bu" />
                        <label>Voc Type <input class="form-control input-sm" name="voc_type_label" value="PUR" readonly /></label>
                        <label>Voc Date <input class="form-control input-sm" name="voc_date" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" required /></label>
                        <label>Voc No <input class="form-control input-sm" value="Auto" readonly /></label>
                        <ErpMasterPicker Kind="supplier" FieldName="party_code" Label="Party Code" ValueMode="code" NameFieldName="party_name" Required="true" InputId="jw-party" />
                        <label>Party Name <input class="form-control input-sm" name="party_name" required maxlength="120" /></label>
                        <ErpMasterPicker Kind="jw-currency" FieldName="currency" Label="Party Curr" ValueMode="code" SelectedCode="AED" InputId="jw-party-curr" />
                        <label>Party Curr rate <input class="form-control input-sm" name="currency_rate" type="number" step="0.000001" value="1" /></label>
                        <ErpMasterPicker Kind="jw-currency" FieldName="item_curr" Label="Item Curr" ValueMode="code" SelectedCode="AED" InputId="jw-item-curr" />
                        <label>Item Curr rate <input class="form-control input-sm" name="item_curr_rate" type="number" step="0.000001" value="1" /></label>
                        <label>Metal Rate / g (pure) <input class="form-control input-sm" name="metal_rate" type="number" step="0.00001" min="0" value="0" required /></label>
                        <label class="jw-mp-check"><input type="checkbox" name="is_fixed" value="true" checked /> Fixed metal rate (GMS)</label>
                        <label>Cr. Days <input class="form-control input-sm" name="cr_days" type="number" min="0" value="0" /></label>
                        <ErpMasterPicker Kind="jw-salesman" FieldName="salesman" Label="Salesman" ValueMode="code" InputId="jw-salesman" AllowNew="true" />
                        <label>Supp. Inv No <input class="form-control input-sm" name="supp_inv_no" maxlength="30" /></label>
                        <label>Supp. Inv Date <input class="form-control input-sm" name="supp_inv_date" type="date" /></label>
                    </div>
                </section>

                <section class="jw-mp-card">
                    <div class="jw-mp-tabs epc-jw-panel-nav" role="tablist" aria-label="Metal purchase panels">
                        <button type="button" class="is-active" data-jw-panel-btn="lines">1. Line Items</button>
                        <button type="button" data-jw-panel-btn="addins">2. Other Amounts</button>
                        <button type="button" data-jw-panel-btn="attach">3. Attachments</button>
                    </div>
                    <div class="jw-mp-panel epc-jw-panel jw-mp-lines" data-jw-panel="lines">
                        <table>
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Stock Code</th>
                                    <th>PCS</th>
                                    <th>Gr. Wt</th>
                                    <th>Stone Wt</th>
                                    <th>Net Wt</th>
                                    <th>Purity</th>
                                    <th>Pure Wt</th>
                                    <th>Wstg %</th>
                                    <th>Wstg Qty</th>
                                    <th>Metal Rate</th>
                                    <th>Metal Amount</th>
                                    <th>Mkg. Rate</th>
                                    <th>Mkg. Amount</th>
                                    <th>St. Amount</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody data-jw-lines>
                                <tr data-jw-line>
                                    <td data-jw-line-no>1</td>
                                    <td class="jw-stock">
                                        <ErpMasterPicker Kind="jw-metal-stock" FieldName="line_stock_code" Label="Metal stock" ValueMode="code" InputId="jw-stock" />
                                        <input type="hidden" name="line_description" value="" />
                                        <input type="hidden" name="line_division" value="G" />
                                        <input type="hidden" name="line_karat" value="" />
                                    </td>
                                    <td><input class="form-control input-sm" name="line_pcs" type="number" min="0" value="0" /></td>
                                    <td><input class="form-control input-sm" name="line_gr_wt" type="number" step="0.0001" min="0" value="0" /></td>
                                    <td><input class="form-control input-sm" name="line_stone_wt" type="number" step="0.0001" min="0" value="0" /></td>
                                    <td><input class="form-control input-sm" data-jw-net-wt type="number" value="0.0000" readonly tabindex="-1" /></td>
                                    <td><input class="form-control input-sm" name="line_purity" type="number" step="0.000001" min="0" max="1" value="0.999000" /></td>
                                    <td><input class="form-control input-sm" name="line_pure_wt" type="number" step="0.0001" value="0.0000" readonly tabindex="-1" /></td>
                                    <td><input class="form-control input-sm" name="line_wastage_pct" type="number" step="0.0001" min="0" value="0" /></td>
                                    <td><input class="form-control input-sm" name="line_wastage_qty" type="number" step="0.0001" value="0.0000" readonly tabindex="-1" /></td>
                                    <td><input class="form-control input-sm" name="line_metal_rate" type="number" step="0.00001" value="0" readonly tabindex="-1" /></td>
                                    <td><input class="form-control input-sm" name="line_metal_amount" type="number" step="0.01" value="0.00" readonly tabindex="-1" /></td>
                                    <td><input class="form-control input-sm" name="line_mkg_rate" type="number" step="0.0001" min="0" value="0" /></td>
                                    <td><input class="form-control input-sm" name="line_mkg_amount" type="number" step="0.01" value="0.00" readonly tabindex="-1" /></td>
                                    <td><input class="form-control input-sm" name="line_stone_amount" type="number" step="0.01" min="0" value="0" /></td>
                                    <td><input class="form-control input-sm" data-jw-item-total type="number" value="0.00" readonly tabindex="-1" /></td>
                                    <td><button type="button" class="btn btn-xs btn-default" data-jw-line-remove title="Remove line"><i class="fa fa-trash" aria-hidden="true"></i></button></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="2"><button type="button" class="btn btn-xs btn-primary" data-jw-line-add><i class="fa fa-plus" aria-hidden="true"></i> Add line</button></td>
                                    <td data-jw-sum="pcs">0</td>
                                    <td data-jw-sum="gr">0.0000</td>
                                    <td data-jw-sum="stone">0.0000</td>
                                    <td data-jw-sum="net">0.0000</td>
                                    <td></td>
                                    <td data-jw-sum="pure">0.0000</td>
                                    <td></td>
                                    <td data-jw-sum="wstg">0.0000</td>
                                    <td></td>
                                    <td data-jw-sum="metal">0.00</td>
                                    <td></td>
                                    <td data-jw-sum="mkg">0.00</td>
                                    <td data-jw-sum="st">0.00</td>
                                    <td data-jw-sum="total">0.00</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="jw-mp-panel epc-jw-panel jw-mp-lines" data-jw-panel="addins" hidden>
                        <table style="min-width:60rem">
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Addin Code</th>
                                    <th>Description</th>
                                    <th>Debit A/c</th>
                                    <th>Credit A/c</th>
                                    <th>%</th>
                                    <th>Amount</th>
                                    <th>Narration</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>1</td>
                                    <td class="jw-stock"><ErpMasterPicker Kind="jw-addin" FieldName="addin_code" Label="Addin" ValueMode="code" NameFieldName="addin_description" InputId="jw-addin" /></td>
                                    <td><input class="form-control input-sm" name="addin_description" maxlength="120" style="text-align:left" /></td>
                                    <td class="jw-stock"><ErpMasterPicker Kind="coa" FieldName="addin_debit_ac" Label="Debit" ValueMode="code" InputId="jw-addin-dr" /></td>
                                    <td class="jw-stock"><ErpMasterPicker Kind="coa" FieldName="addin_credit_ac" Label="Credit" ValueMode="code" InputId="jw-addin-cr" /></td>
                                    <td><input class="form-control input-sm" name="addin_pct" type="number" step="0.0001" min="0" value="0" /></td>
                                    <td><input class="form-control input-sm" name="addin_amount" type="number" step="0.01" min="0" value="0" /></td>
                                    <td><input class="form-control input-sm" name="addin_narration" maxlength="200" style="text-align:left" /></td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="jw-mp-note">When % is entered, Amount is calculated from the line total (metal + making + stone).</p>
                    </div>
                    <div class="jw-mp-panel epc-jw-panel" data-jw-panel="attach" hidden>
                        <p class="jw-mp-note">Save the voucher first, then attach the supplier invoice / packing list from the opened voucher.</p>
                    </div>
                </section>

                <div class="jw-mp-bottom">
                    <section class="jw-mp-card">
                        <h4>Shipment &amp; notes</h4>
                        <div class="jw-mp-grid">
                            <label>Place of Supply <input class="form-control input-sm" name="place_of_supply" maxlength="80" /></label>
                            <label>Shipment company <input class="form-control input-sm" name="shipment_company" maxlength="80" /></label>
                            <label>Port / company <input class="form-control input-sm" name="port_company" maxlength="80" /></label>
                            <label>VAT basis
                                <select class="form-control input-sm" name="vat_basis" data-jw-vat-basis>
                                    <option value="mkg" selected>Making + stone + other (metal under RCM)</option>
                                    <option value="full">Full invoice value</option>
                                    <option value="none">Zero-rated / no VAT</option>
                                </select>
                            </label>
                            <label style="grid-column:1/-1">Narration <textarea class="form-control input-sm" name="narration" rows="2" maxlength="200" style="height:auto"></textarea></label>
                        </div>
                    </section>
                    <section class="jw-mp-card">
                        <h4>Invoice summary (@("AED"))</h4>
                        <div class="jw-mp-sum">
                            <table>
                                <tr><td>Metal value</td><td><input class="form-control input-sm" data-jw-tot="metal" value="0.00" readonly tabindex="-1" /></td></tr>
                                <tr><td>Making charges</td><td><input class="form-control input-sm" data-jw-tot="mkg" value="0.00" readonly tabindex="-1" /></td></tr>
                                <tr><td>Stone amount</td><td><input class="form-control input-sm" data-jw-tot="st" value="0.00" readonly tabindex="-1" /></td></tr>
                                <tr><td>Net amount</td><td><input class="form-control input-sm" name="net_amount" value="0.00" readonly tabindex="-1" /></td></tr>
                                <tr><td>Other amounts</td><td><input class="form-control input-sm" name="other_amount" value="0.00" readonly tabindex="-1" /></td></tr>
                                <tr><td>Taxable value <em class="jw-mp-note" data-jw-basis-note>(excl. metal)</em></td><td><input class="form-control input-sm" data-jw-tot="taxable" value="0.00" readonly tabindex="-1" /></td></tr>
                                <tr><td>VAT %</td><td><input class="form-control input-sm" name="vat_pct" type="number" step="0.01" min="0" value="5" /></td></tr>
                                <tr><td>Input VAT</td><td><input class="form-control input-sm" name="vat_amount" value="0.00" readonly tabindex="-1" /></td></tr>
                                <tr><td>RCM VAT on metal <em class="jw-mp-note">(self-accounted, not paid to supplier)</em></td><td><input class="form-control input-sm" name="rcm_vat" value="0.00" readonly tabindex="-1" /></td></tr>
                                <tr><td>Round off</td><td><input class="form-control input-sm" name="round_off" type="number" step="0.01" value="0" /></td></tr>
                                <tr class="jw-mp-grand"><td>Gross total payable</td><td><input class="form-control input-sm" name="gross_total" value="0.00" readonly tabindex="-1" /></td></tr>
                            </table>
                        </div>
                    </section>
                </div>

                <div class="jw-mp-actions">
                    <button type="submit" class="btn btn-primary btn-sm" data-jw-submit><i class="fa fa-save" aria-hidden="true"></i> Save voucher</button>
                    <button type="submit" class="btn btn-success btn-sm" data-jw-submit data-jw-submit-print><i class="fa fa-print" aria-hidden="true"></i> Save &amp; print preview</button>
                    <button type="button" class="btn btn-default btn-sm" data-jw-clear><i class="fa fa-eraser" aria-hidden="true"></i> Clear</button>
                    <span class="jw-mp-status" data-jw-status>Draft is kept automatically until you save.</span>
                </div>
                </div>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "jw_diamond_purchase")
    {
        <ErpPhpCreateWell Title="@("New " + _spec.Label)">
            <form method="post" action="@WriteAction(EcomAeRoutes.ErpJewelleryVoucherSaveForm)" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <input type="hidden" name="action" value="jw_diamond_purchase_save" />
                <input type="hidden" name="voc_type" value="RDP" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <ErpVoucherHeaderFields NumberPreview="Auto" />
                <ErpMasterPicker Kind="supplier" FieldName="party_code" Label="Party Code" ValueMode="code" NameFieldName="party_name" InputId="jw-d-party" />
                <label>Party Name <input class="form-control input-sm" name="party_name" required /></label>
                <ErpMasterPicker Kind="jw-currency" FieldName="currency" Label="Currency" ValueMode="code" SelectedCode="AED" InputId="jw-d-curr" />
                <label>Currency rate <input class="form-control input-sm" name="currency_rate" type="number" step="0.000001" value="1" /></label>
                <ErpMasterPicker Kind="jw-metal-stock" FieldName="line_stock_code" Label="Stock code" ValueMode="code" InputId="jw-fixing-324" Required="true" />
                <label>Description <input class="form-control input-sm" name="line_description" required /></label>
                <label>Division
                    <select class="form-control input-sm" name="line_division">
                        <option value="D">Diamond</option>
                        <option value="G">Gold</option>
                        <option value="S">Silver</option>
                        <option value="P">Pearl</option>
                    </select>
                </label>
                <label>Pcs <input class="form-control input-sm" name="line_pcs" type="number" min="0" value="1" /></label>
                <label>Gross wt <input class="form-control input-sm" name="line_gr_wt" type="number" step="0.0001" value="0" /></label>
                <label>Purity <input class="form-control input-sm" name="line_purity" type="number" step="0.000001" value="0.917" /></label>
                <label>Pure wt <input class="form-control input-sm" name="line_pure_wt" type="number" step="0.0001" value="0" /></label>
                <label>Wastage % <input class="form-control input-sm" name="line_wastage_pct" type="number" step="0.0001" value="0" /></label>
                <label>Wastage qty <input class="form-control input-sm" name="line_wastage_qty" type="number" step="0.0001" value="0" /></label>
                <label>Metal rate <input class="form-control input-sm" name="line_metal_rate" type="number" step="0.00001" value="0" /></label>
                <label>Making rate <input class="form-control input-sm" name="line_mkg_rate" type="number" step="0.0001" value="0" /></label>
                <label>Stone amount <input class="form-control input-sm" name="line_stone_amount" type="number" step="0.01" value="0" /></label>
                <label>Discount <input class="form-control input-sm" name="line_disc_amount" type="number" step="0.01" value="0" /></label>
                <label>Supplier invoice <input class="form-control input-sm" name="supp_inv_no" maxlength="30" /></label>
                <label>Credit days <input class="form-control input-sm" name="cr_days" type="number" min="0" value="0" /></label>
                <label>Narration <input class="form-control input-sm" name="narration" maxlength="200" /></label>
                <label>Net Amt <input class="form-control input-sm" name="net_amount" type="number" step="0.01" value="0" /></label>
                <label>VAT <input class="form-control input-sm" name="vat_amount" type="number" step="0.01" value="0" /></label>
                <label>Gross total <input class="form-control input-sm" name="gross_total" type="number" step="0.01" value="0" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save voucher</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "fix_unfix")
    {
        <ErpPhpCreateWell Title="Create fix / unfix">
            <form method="post" action="@WriteAction(EcomAeRoutes.ErpJewelleryFixUnfixCreateForm)" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <ErpVoucherHeaderFields DateFieldName="voc_date" NumberPreview="Auto" />
                <ErpMasterPicker Kind="supplier" FieldName="supplier_name" InputId="jw-fix-supplier" Label="Supplier" ValueMode="name" Required="true" />
                <label>Structure
                    <select class="form-control input-sm" name="structure_type">
                        <option value="fix">Fix</option>
                        <option value="unfix">Unfix</option>
                    </select>
                </label>
                <label>Metal <input class="form-control input-sm" name="metal_type" value="gold" /></label>
                <ErpMasterPicker Kind="jw-karat" FieldName="karat" Label="Karat" ValueMode="code" InputId="jw-fixing-373" SelectedCode="24" />
                <label>Weight g <input class="form-control input-sm" name="weight_grams" type="number" step="0.001" value="0" /></label>
                <label>Fix rate <input class="form-control input-sm" name="fix_rate" type="number" step="0.0001" value="0" /></label>
                <label>Unfix est. rate <input class="form-control input-sm" name="unfix_estimated_rate" type="number" step="0.0001" value="0" /></label>
                <label>Making <input class="form-control input-sm" name="making_charges" type="number" step="0.01" value="0" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Create fix / unfix</button>
            </form>
        </ErpPhpCreateWell>
        <ErpPhpCreateWell Title="Settle unfix">
            <form method="post" action="@WriteAction(EcomAeRoutes.ErpJewelleryFixUnfixSettleForm)" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <label>Purchase id <input class="form-control input-sm" name="id" type="number" min="1" required /></label>
                <label>Settle rate <input class="form-control input-sm" name="settle_rate" type="number" step="0.0001" value="0" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Settle unfix</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin)
    {
        <ErpPhpCreateWell Title="New Fixing">
            <form method="post" action="@WriteAction(EcomAeRoutes.ErpJewelleryFixingSaveForm)" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <input type="hidden" name="fix_type" value="@(_tab == "jw_sales_fixing" ? "SF" : "PF")" />
                @if (_company > 0)
                {
                    <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
                }
                <label>Fix No <input class="form-control input-sm" name="fix_no" placeholder="Auto" /></label>
                <label>Ref Voc <input class="form-control input-sm" name="code" /></label>
                <ErpMasterPicker Kind="supplier" FieldName="party_code" Label="Party Code" ValueMode="code" InputId="jw-fixing-408" Required="true" />
                <label>Metal
                    <select class="form-control input-sm" name="metal">
                        <option value="G">G Gold</option>
                        <option value="S">S Silver</option>
                        <option value="T">T Platinum</option>
                    </select>
                </label>
                <ErpMasterPicker Kind="jw-karat" FieldName="karat" Label="Karat" ValueMode="code" InputId="jw-fixing-416" />
                <label>Fixed Rate <input class="form-control input-sm" name="fixed_rate" type="number" step="0.00001" value="0" /></label>
                <label>Net Wt <input class="form-control input-sm" name="net_wt" type="number" step="0.001" value="0" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save fixing</button>
            </form>
        </ErpPhpCreateWell>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    @foreach (var col in _spec.Columns)
                    {
                        <th>@col</th>
                    }
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_purchaseRows.Count > 0)
                {
                    @foreach (var row in _purchaseRows)
                    {
                        <tr>
                            <td>@row.VoucherType</td>
                            <td><strong>@row.VoucherNumber.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.VoucherDate) ? "—" : row.VoucherDate)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.PartyName) ? (string.IsNullOrWhiteSpace(row.PartyCode) ? "—" : row.PartyCode) : row.PartyName)</td>
                            <td>—</td>
                            <td>—</td>
                            <td>—</td>
                            <td class="text-right">@row.NetAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Status) ? "—" : row.Status)</td>
                            <td>
                                <a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href("/erp/jewellery-retail-app", "voc_id", row.Id)">Open</a>
                                <a class="btn btn-xs btn-default" href="/erp/purchase-print?jwId=@row.Id.ToString(CultureInfo.InvariantCulture)" target="_blank" rel="noopener">@(ErpPurchaseDocumentPrint.IsOfficialJewellery(row.Status, row.Authorized) ? "Print" : "Preview")</a>
                            </td>
                        </tr>
                    }
                }
                else if (_display.Count == 0)
                {
                    <tr><td colspan="@(_spec.Columns.Count + 1)" class="text-muted">@(_isAdmin ? _spec.EmptyCopy : "Sign in with ERP or Control Panel capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _display)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.No</td>
                            <td><strong>@row.FixNo</strong></td>
                            <td>@row.FixDate</td>
                            <td>@row.RefVoc</td>
                            <td>@row.Party</td>
                            <td>@row.Metal</td>
                            <td class="text-right">@row.Rate</td>
                            <td class="text-right">@row.Qty</td>
                            <td class="text-right">@row.Amount</td>
                            <td>@row.Status</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "fixing_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Fixings bind from <code>epc_jewel_fixing</code>. Fixing save, purchase voucher save, and fix/unfix create/settle are live when confirmed.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
    }
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private int _company;
    private string _tab = "jw_purchase_fixing";
    private string _appPath = "/erp/jewellery-fixing-app";
    private string _tabBase = "/erp/jewellery-fixing-app";
    private string _returnHere = "/erp/jewellery-fixing-app?tab=jw_purchase_fixing";
    private ErpJewelleryModuleChrome.TabSpec _spec = ErpJewelleryModuleChrome.FixingSpec("jw_purchase_fixing");
    private CpJewelleryFixingSummary _summary = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<FixRow> _display = [];
    private IReadOnlyList<ErpJwPurchaseHistoryRow> _purchaseRows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _ok = "";
    private string _err = "";
    private string _listHref = "/erp/jewellery-fixing-app";
    private string _panel = "lines";
    private long _savedId;
    private long _openedId;
    private CpJewelleryFixingDetail? _opened;
    private IReadOnlyList<CpJewelleryFixingRowDigest> _openedSiblings = [];

    private sealed record FixRow(long Id, string No, string FixNo, string FixDate, string RefVoc, string Party, string Metal, string Rate, string Qty, string Amount, string Status);

    private string OpenedCaption =>
        _opened is null
            ? ""
            : ("Fixing #" + _opened.FixNo.ToString(CultureInfo.InvariantCulture));

    private string WriteAction(string path) => ErpJewelleryModuleChrome.AppHref(path, _company);

    private string PanelHref(string panel)
        => ErpJewelleryModuleChrome.AppHref(_appPath, _company, ("tab", _tab), ("panel", panel));

    private string ReturnHref =>
        _openedId > 0
            ? _listHref + "?fixing_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
            : _returnHere;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var path = ctx.Request.Path.Value ?? "/erp/jewellery-fixing-app";
        _appPath = path.StartsWith("/erp/", StringComparison.OrdinalIgnoreCase)
            ? "/erp/jewellery-fixing-app"
            : "/erp/jewellery-fixing-app";
        _listHref = _appPath;
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "fixing_id");
        _company = ErpJewelleryModuleChrome.CompanyFromQuery(ctx.Request.Query["company"].ToString());
        _tab = ErpJewelleryModuleChrome.NormalizeTab(ctx.Request.Query["tab"].ToString(), ErpJewelleryModuleChrome.FixingTabs, "jw_purchase_fixing");
        var panelRaw = (ctx.Request.Query["panel"].ToString() ?? "").Trim().ToLowerInvariant();
        _panel = panelRaw is "addins" or "attach" ? panelRaw : "lines";
        _ok = ctx.Request.Query["ok"].ToString();
        _savedId = ErpRecordOpen.ReadId(ctx.Request, "saved_id");
        _err = ctx.Request.Query["err"].ToString();
        _spec = ErpJewelleryModuleChrome.FixingSpec(_tab);
        _tabBase = ErpJewelleryModuleChrome.AppHref(_appPath, _company);
        _returnHere = ErpJewelleryModuleChrome.AppHref(_appPath, _company, ("tab", _tab));

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = ErpJewelleryModuleChrome.HasJewelleryStaffAccess(session);
        if (!_isAdmin)
        {
            _message = "Sign in with ERP or Control Panel capability for live rows.";
            return;
        }

        var result = await Dashboards.BuildCpJewelleryFixingDigestAsync(200, _company, ctx.RequestAborted);
        _summary = result.Summary;
        _source = result.Source;
        _message = result.Message;
        var showFixings = _tab is "jw_purchase_fixing" or "jw_sales_fixing" or "fix_unfix" or "jw_purchase_window";
        var wantedType = _tab switch
        {
            "jw_purchase_fixing" or "jw_purchase_window" => "PF",
            "jw_sales_fixing" => "SF",
            _ => null,
        };
        _display = showFixings
            ? result.Fixings
                .Where(r => wantedType is null || string.Equals(r.FixType, wantedType, StringComparison.OrdinalIgnoreCase))
                .Where(r => _tab != "jw_purchase_window" || r.UnfixedQty > 0)
                .Select((r, i) => new FixRow(
            r.Id,
            (i + 1).ToString(CultureInfo.InvariantCulture),
            r.FixNo.ToString(CultureInfo.InvariantCulture),
            string.IsNullOrWhiteSpace(r.FixDate) ? "—" : r.FixDate,
            string.IsNullOrWhiteSpace(r.ReferenceVoc) ? "—" : r.ReferenceVoc,
            !string.IsNullOrWhiteSpace(r.PartyName) ? r.PartyName : (string.IsNullOrWhiteSpace(r.PartyCode) ? "—" : r.PartyCode),
            string.IsNullOrWhiteSpace(r.Metal) ? "—" : r.Metal,
            r.FixRate == 0 && r.FixQtyGms == 0 ? "0.00000" : r.FixRate.ToString("N5", CultureInfo.InvariantCulture),
            r.FixQtyGms.ToString("N3", CultureInfo.InvariantCulture),
            r.FixAmount.ToString("N2", CultureInfo.InvariantCulture),
            string.IsNullOrWhiteSpace(r.Status) ? "—" : r.Status)).ToList()
            : [];
        if (_tab is "jw_metal_purchase" or "jw_diamond_purchase" && _company > 0)
        {
            var history = await Purchases.ReadAsync(
                _company,
                _tab == "jw_diamond_purchase" ? "DIAMOND" : "METAL",
                100,
                ctx.RequestAborted);
            _purchaseRows = history.Rows;
            if (!string.IsNullOrWhiteSpace(history.Message))
            {
                _message = history.Message;
            }
        }
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpJewelleryFixingDetailAsync(_openedId, _company, ctx.RequestAborted);
            _opened = detail.Fixing;
            _openedSiblings = detail.Siblings;
        }
    }
}
