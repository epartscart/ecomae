@page "/cp/jewellery-fixing-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Jewellery fixing · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-w18-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-w18-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-w18-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-w18-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-w18-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f172a; background:#fff;
        }
        .epc-w18-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-w18-kpis { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-w18-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-w18-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-w18-kpi span { color:#64748b; font-size:.78rem; }
        .epc-w18-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-w18-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-w18-table th, .epc-w18-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-w18-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-w18-note { margin-top:1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:.45rem; color:#334155; font-size:.86rem; }
        @@media (max-width:900px){ .epc-w18-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-w18-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Jewellery fixing</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-w18-cta">
            <a href="@_phpTab">Open module</a>
        </div>
    </section>

    <div class="epc-w18-kpis" aria-label="Jewellery fixing stats">
        <div class="epc-w18-kpi"><strong>@_summary.FixingCount.ToString(CultureInfo.InvariantCulture)</strong><span>Fixings</span></div>
        <div class="epc-w18-kpi"><strong>@_summary.OpenFixingCount.ToString(CultureInfo.InvariantCulture)</strong><span>Open</span></div>
        <div class="epc-w18-kpi"><strong>@_summary.PurchaseFixCount.ToString(CultureInfo.InvariantCulture)</strong><span>Purchases</span></div>
        <div class="epc-w18-kpi"><strong>@_summary.SettlementCount.ToString(CultureInfo.InvariantCulture)</strong><span>Settlements</span></div>
        <div class="epc-w18-kpi"><strong>@_summary.PettyCashCount.ToString(CultureInfo.InvariantCulture)</strong><span>Petty cash</span></div>
    </div>

    <div class="epc-w18-table-wrap">
    <table class="epc-w18-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Co</th>
                    <th>Branch</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>No</th>
                    <th>Party</th>
                    <th>Name</th>
                    <th>Metal</th>
                    <th>Karat</th>
                    <th>Qty gms</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>By</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="15">Nothing to show yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CompanyId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Branch) ? row.Branch : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.FixType) ? row.FixType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.FixDate) ? row.FixDate : "—")</td>
                            <td>@row.FixNo.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PartyCode) ? row.PartyCode : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PartyName) ? row.PartyName : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Metal) ? row.Metal : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Karat) ? row.Karat : "—")</td>
                            <td>@row.FixQtyGms.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.FixAmount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CreatedBy) ? row.CreatedBy : "—")</td>
                            <td><a href="@_phpTab">Open</a></td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=purchasing&tab=jw_purchase_fixing";
    private bool _isAdmin;
    private CpJewelleryFixingSummary _summary = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpJewelleryFixingRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpJewelleryFixingDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Fixings;
        _source = result.Source;
        _message = result.Message;
    }
}
