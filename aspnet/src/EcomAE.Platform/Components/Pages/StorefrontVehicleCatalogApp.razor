@page "/storefront/vehicle-catalog-app"
@page "/en/vehicle-catalog"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation

<PageTitle>Vehicle parts catalog · eParts Cart</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        
        .epc-sf-vc-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.8rem; }
        .epc-sf-vc-cta a {
            display:inline-flex; padding:.48rem .8rem; border-radius:.4rem; font-weight:700; font-size:.8rem;
            text-decoration:none; color:#fff; background:#dc2626;
        }
        .epc-sf-vc-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); }
        .epc-sf-vc-body { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.75rem .85rem 1rem; }
        .epc-sf-vc-note { margin-top:.85rem; color:#64748b; font-size:.84rem; }
    
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontTenantChrome>

    <PhpStorefrontPageHeader Title="Vehicle parts catalog"
                            Subtitle="Year → make → model → engine tree for vehicle-based part selection.">
        <a class="btn btn-sm btn-primary" href="@StorefrontSurfaceLinks.PartSearch">Part search</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.LaximoVin">VIN / Frame</a>
    </PhpStorefrontPageHeader>

    <div class="epc-sf-vc-body" id="epc-vehicle-catalog" aria-label="Vehicle catalog tree">
        @((MarkupString)_html)
    </div>
    <p class="epc-sf-vc-note">
        Choose year, make, model, and engine, then continue into part search.
    </p>
</StorefrontTenantChrome>

@code {
    private string _html = "";

    protected override void OnInitialized()
    {
        _html = PhpHomeWidgetHtml.VehicleCatalog();
        if (string.IsNullOrWhiteSpace(_html))
        {
            _html = "<p style=\"margin:0;color:#64748b\">Vehicle catalog widget is unavailable in this environment. "
                  + "<a href=\"" + StorefrontPhpCanonical.VehicleCatalog + "\">Open classic vehicle catalog</a>.</p>";
        }
    }
}
