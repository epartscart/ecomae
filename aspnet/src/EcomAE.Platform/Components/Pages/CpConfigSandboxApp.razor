@page "/cp/config-sandbox-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Config sandbox · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Config sandbox
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/config-sandbox-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/config-sandbox-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_summary.SnapshotCount.ToString(CultureInfo.InvariantCulture) Snapshots · @_summary.ActiveSnapshotCount.ToString(CultureInfo.InvariantCulture) Active · @_summary.PromotedSnapshotCount.ToString(CultureInfo.InvariantCulture) Promoted · @_summary.ChangeCount.ToString(CultureInfo.InvariantCulture) Changes.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Site key</th>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Created by</th>
                    <th>Created</th>
                    <th>Promoted</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="8">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.SiteKey) ? row.SiteKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.SnapshotName) ? row.SnapshotName : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@row.CreatedBy.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CreatedAt) ? row.CreatedAt : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PromotedAt) ? row.PromotedAt : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_config_sandbox";
    private bool _isAdmin;
    private CpConfigSandboxSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpConfigSandboxRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpConfigSandboxDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Snapshots;
        _source = result.Source;
        _message = result.Message;
    }
}
