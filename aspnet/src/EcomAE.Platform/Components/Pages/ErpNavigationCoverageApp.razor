@page "/erp/navigation-coverage-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>ERP navigation coverage · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="ERP navigation coverage" BreadcrumbArea="Governance" BreadcrumbTab="Navigation matrix">
    <PhpErpModulePageHeader Title="ERP navigation coverage"
                            Subtitle="Reference menu areas mapped to live routes, visibility rules, and dedicated pages." />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="ERP navigation coverage">
        <div class="kpi"><div class="lbl">Reference areas</div><div class="val">@_areas</div></div>
        <div class="kpi"><div class="lbl">Reference tabs</div><div class="val">@_rows.Count</div></div>
        <div class="kpi"><div class="lbl">Mapped routes</div><div class="val">@_mapped</div></div>
        <div class="kpi"><div class="lbl">Unmapped</div><div class="val">@(_rows.Count - _mapped)</div></div>
    </div>

    @if (!_isAdmin)
    {
        <div class="alert alert-info">Sign in with ERP capability to inspect the tenant-aware matrix.</div>
    }
    else
    {
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead>
                    <tr>
                        <th>Area</th>
                        <th>Tab</th>
                        <th>Reference label</th>
                        <th>Visibility</th>
                        <th>Live route</th>
                        <th>Decision</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        var route = ErpPhpTabRouteMap.TryMapTab(row.TabKey, out var mapped)
                            ? mapped
                            : ErpPhpTabRouteMap.ModuleAppPath + "?tab=" + Uri.EscapeDataString(row.TabKey);
                        <tr>
                            <td>@row.AreaId</td>
                            <td><code>@row.TabKey</code></td>
                            <td>@row.Label</td>
                            <td>@(row.Visible ? "visible" : "hidden")</td>
                            <td><a href="@route">@route</a></td>
                            <td>@row.Code — @row.Detail</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private int _areas;
    private int _mapped;
    private IReadOnlyList<ErpIndustryNav.NavInspectionRow> _rows = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var host = ctx.Request.Host.Host;
        var hostContext = ErpHostContext.Resolve(host);
        var audience = new ErpIndustryNav.ErpNavAudience(
            "current",
            hostContext.IndustryCode,
            null,
            PlatformHostPolicy.IsSuperCpHost(host));

        _areas = PhpModuleCatalog.ErpAreaCount;
        _rows = ErpIndustryNav.Inspect(audience);
        _mapped = _rows.Count(row => ErpPhpTabRouteMap.TryMapTab(row.TabKey, out _));
    }
}
