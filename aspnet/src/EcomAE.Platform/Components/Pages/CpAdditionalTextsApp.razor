@page "/cp/additional-texts-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Additional texts · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Additional texts
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>SEO and extra copy for storefront URLs. Open a row for a content excerpt. Save or delete here.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/additional-texts-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedText is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/additional-texts/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/additional-texts-app" />
            <label>URL <input type="text" name="url" required placeholder="/shop/demo" value="@(_openedText is not null ? _openedText.Url : "")" /></label>
            <label>Title <input type="text" name="titleTag" value="@(_openedText is not null ? _openedText.TitleTag : "")" /></label>
            <label>Description <input type="text" name="descriptionTag" /></label>
            <label>Keywords <input type="text" name="keywordsTag" value="@(_openedText is not null ? _openedText.KeywordsTag : "")" /></label>
            <label>Before main
                <select name="beforeMain">
                    <option value="0">No</option>
                    <option value="1">Yes</option>
                </select>
            </label>
            <label>Body <input type="text" name="content" placeholder="HTML or text" style="width:16rem" /></label>
            <button type="submit">Save text</button>
        </form>
        <form method="post" action="/cp/additional-texts/delete" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/additional-texts-app" />
            <label>Ids <input type="text" name="ids" required placeholder="[1] or 1,2" value="@(_openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "")" /></label>
            <button type="submit">Delete texts</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Additional text KPIs">
        <div class="kpi"><div class="lbl">Texts</div><div class="val">@_summary.TextCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Before main</div><div class="val">@_summary.BeforeMainCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">With title</div><div class="val">@_summary.WithTitleCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Placement siblings</div><div class="val">@_openedSiblings.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedText is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedText.TitleTag) ? _openedText.TitleTag : (!string.IsNullOrWhiteSpace(_openedText.Url) ? _openedText.Url : ("Text #" + _openedText.Id.ToString(CultureInfo.InvariantCulture))))
                    <span class="label label-default pull-right">@(_openedText.BeforeMain != 0 ? "before main" : "after")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedText.Url) ? _openedText.Url : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedText.KeywordsTag) ? _openedText.KeywordsTag : "—")</p>
                    @if (!string.IsNullOrWhiteSpace(_openedText.DescriptionExcerpt))
                    {
                        <p>@_openedText.DescriptionExcerpt
                            @if (_openedText.DescriptionLen > _openedText.DescriptionExcerpt.Length)
                            {
                                <span class="text-muted"> (excerpt)</span>
                            }
                        </p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedText.ContentExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedText.ContentExcerpt</pre>
                        @if (_openedText.ContentLen > _openedText.ContentExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_openedText.ContentExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedText.ContentLen.ToString(CultureInfo.InvariantCulture) chars). Full HTML stays on the Classic twin.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No content excerpt yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Placement siblings</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>URL</th>
                                    <th>Before</th>
                                    <th>Title</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="4">No placement siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Url) ? sib.Url : "—")</td>
                                            <td>@sib.BeforeMain.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.TitleTag) ? sib.TitleTag : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Texts</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>URL</th>
                                <th>Before</th>
                                <th>Title</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!_isAdmin)
                        {
                            <tr><td colspan="5">Sign in for live data.</td></tr>
                        }
                        else if (_rows.Count == 0)
                        {
                            <tr><td colspan="5">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Url) ? row.Url : "—")</td>
                                    <td>@row.BeforeMain.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.TitleTag) ? row.TitleTag : "—")</td>
                                    <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "text_id", row.Id)">Open</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/content/dopolnitelnye-teksty";
    private const string _listHref = "/cp/additional-texts-app";
    private bool _isAdmin;
    private CpAdditionalTextsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpAdditionalTextsRowDigest> _rows = [];
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private CpAdditionalTextsDetail? _openedText;
    private IReadOnlyList<CpAdditionalTextsRowDigest> _openedSiblings = [];

    private string OpenedCaption => _openedText is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedText.TitleTag)
            ? (string.IsNullOrWhiteSpace(_openedText.Url)
                ? ("Text #" + _openedText.Id.ToString(CultureInfo.InvariantCulture))
                : _openedText.Url)
            : _openedText.TitleTag);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "text_id");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpAdditionalTextsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Texts;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpAdditionalTextsDetailAsync(_openedId, ctx.RequestAborted);
            _openedText = detail.Text;
            _openedSiblings = detail.Siblings;
            if (_openedText is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }
}
