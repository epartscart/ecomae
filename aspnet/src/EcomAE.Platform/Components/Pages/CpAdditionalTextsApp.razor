@page "/cp/additional-texts-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Additional texts · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Additional texts
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>SEO and extra copy for storefront URLs. Save or delete here.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/additional-texts-app" IsAdmin="_isAdmin" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/additional-texts/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/additional-texts-app" />
            <label>URL <input type="text" name="url" required placeholder="/shop/demo" /></label>
            <label>Title <input type="text" name="titleTag" /></label>
            <label>Description <input type="text" name="descriptionTag" /></label>
            <label>Keywords <input type="text" name="keywordsTag" /></label>
            <label>Before main
                <select name="beforeMain">
                    <option value="0">No</option>
                    <option value="1">Yes</option>
                </select>
            </label>
            <label>Body <input type="text" name="content" placeholder="HTML or text" style="width:16rem" /></label>
            <button type="submit">Save text</button>
        </form>
        <form method="post" action="/cp/additional-texts/delete" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/additional-texts-app" />
            <label>Ids <input type="text" name="ids" required placeholder="[1] or 1,2" /></label>
            <button type="submit">Delete texts</button>
        </form>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Texts</div>
            <div class="panel-body">
                <p class="help-block">@_summary.TextCount.ToString(CultureInfo.InvariantCulture) texts · before main @_summary.BeforeMainCount.ToString(CultureInfo.InvariantCulture) · with title @_summary.WithTitleCount.ToString(CultureInfo.InvariantCulture) · with description @_summary.WithDescriptionCount.ToString(CultureInfo.InvariantCulture).</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>URL</th>
                                <th>Before</th>
                                <th>Title</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_rows.Count == 0)
                        {
                            <tr><td colspan="4">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr>
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Url) ? row.Url : "—")</td>
                                    <td>@row.BeforeMain.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.TitleTag) ? row.TitleTag : "—")</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/content/dopolnitelnye-teksty";
    private bool _isAdmin;
    private CpAdditionalTextsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpAdditionalTextsRowDigest> _rows = [];
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpAdditionalTextsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Texts;
    }
}
