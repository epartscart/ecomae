@page "/marketing/trademark"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>ECOM AE — Trademark</PageTitle>
<PhpChromeStyles Surface="marketing" />

<PhpEcomaeMarketingChrome ActiveKey="trademark">
    <PhpHybridWorkspaceFrame PhpHref="@_phpHref" ClearHref="/marketing/trademark" />

    @if (string.IsNullOrWhiteSpace(_phpHref))
    {
        <PhpEcomaeLegalAliasOverview
            Title="Trademark"
            Badge="Trademark"
            Icon="fa-registered"
            GradientStart="#7c2d12"
            GradientMid="#ea580c"
            PhpSlug="trademark"
            AspNetRoute="/marketing/trademark"
            Lead="Trademark notices for ECOM AE and related marks. Full policy text is available from the linked policy page."
            CardOne="Brand and mark usage rules for partners and resellers." />
    }
</PhpEcomaeMarketingChrome>

@code {
    private string? _phpHref;

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        if (ctx?.Request.Query.TryGetValue("php", out var php) == true && !string.IsNullOrWhiteSpace(php))
        {
            _phpHref = php.ToString();
        }
    }
}
