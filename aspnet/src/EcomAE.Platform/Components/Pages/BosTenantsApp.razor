@page "/bos/tenants-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Fleet Tenants · Super BOS · eParts Cart</PageTitle>
<PhpChromeStyles Surface="bos" />
<HeadContent>
<style>
        .epc-bt-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#000000 0%,#0c4a6e 55%,#0ea5e9 100%);
        }
        .epc-bt-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-bt-hero p { margin:0; color:#99f6e4; max-width:42rem; font-size:.92rem; line-height:1.45; }
        .epc-bt-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-bt-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#042f2e; background:#e0f2fe;
        }
        .epc-bt-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-bt-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-bt-kpi { background:#fff; border:1px solid #e4e4e7; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-bt-kpi strong { display:block; font-size:1.45rem; font-variant-numeric:tabular-nums; }
        .epc-bt-kpi span { color:#71717a; font-size:.78rem; }
        .epc-bt-table-wrap { background:#fff; border:1px solid #e4e4e7; border-radius:.55rem; overflow:auto; }
        .epc-bt-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-bt-table th, .epc-bt-table td { padding:.55rem .7rem; border-bottom:1px solid #f4f4f5; text-align:left; white-space:nowrap; }
        .epc-bt-table th { background:#fafafa; color:#52525b; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-bt-table a { color:#0f766e; font-weight:700; text-decoration:none; }
        .epc-bt-badge { display:inline-flex; padding:.15rem .45rem; border-radius:.3rem; font-size:.72rem; font-weight:700; }
        .epc-bt-badge--ok { background:#e0f2fe; color:#115e59; }
        .epc-bt-badge--off { background:#fee2e2; color:#991b1b; }
        .epc-bt-badge--info { background:#e2e8f0; color:#334155; }
        .epc-bt-note { margin-top:1rem; padding:.75rem .9rem; background:#f0fdfa; border:1px solid #99f6e4; border-radius:.45rem; color:#134e4a; font-size:.86rem; }
        @@media (max-width:1100px){ .epc-bt-kpis{grid-template-columns:1fr 1fr;} }
        @@media (max-width:700px){ .epc-bt-kpis{grid-template-columns:1fr;} }
    
</style>
</HeadContent>


<PhpBosDesktopChrome IsAdmin="_isAdmin" Title="Fleet Tenants">

    <section class="epc-bt-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Fleet Tenants</h1>
        <p>Platform fleet overview across tenants, sessions, and health.</p>
        <div class="epc-bt-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/bos/audit-log-app">Audit log</a>
            <a class="ghost" href="/cp/tenants-app">CP tenants</a>
        </div>
    </section>
    <PhpParityModuleBody AppPath="/bos/tenants-app" IsAdmin="_isAdmin" />


    <div class="epc-bt-kpis" aria-label="BOS tenants KPIs">
        <div class="epc-bt-kpi"><strong>@_tenants.Count</strong><span>Shown (limit @_limit)</span></div>
        <div class="epc-bt-kpi"><strong>@_active</strong><span>Active</span></div>
        <div class="epc-bt-kpi"><strong>@_withDb</strong><span>With database</span></div>
        <div class="epc-bt-kpi"><strong>@_erpOnly</strong><span>ERP-only</span></div>
    </div>

    <div class="epc-bt-table-wrap">
        <table class="epc-bt-table">
            <thead>
                <tr>
                    <th>Site key</th>
                    <th>Hostname</th>
                    <th>Trade name</th>
                    <th>Industry</th>
                    <th>Status</th>
                    <th>Hub</th>
                    <th>Hosted</th>
                    <th>Active</th>
                    <th>DB</th>
                    <th>ERP-only</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_tenants.Count == 0)
                {
                    <tr><td colspan="11">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var t in _tenants)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(t.SiteKey) ? "—" : t.SiteKey)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(t.Hostname) ? "—" : t.Hostname)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.TradeName) ? "—" : t.TradeName)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.IndustryCode) ? "—" : t.IndustryCode)</td>
                            <td><span class="epc-bt-badge epc-bt-badge--info">@(string.IsNullOrWhiteSpace(t.Status) ? "—" : t.Status)</span></td>
                            <td>@(string.IsNullOrWhiteSpace(t.HubName) ? "—" : t.HubName)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.HostedOn) ? "—" : t.HostedOn)</td>
                            <td><span class="epc-bt-badge @(t.IsActive ? "epc-bt-badge--ok" : "epc-bt-badge--off")">@(t.IsActive ? "yes" : "no")</span></td>
                            <td><span class="epc-bt-badge @(t.HasDb ? "epc-bt-badge--ok" : "epc-bt-badge--off")">@(t.HasDb ? "yes" : "no")</span></td>
                            <td><span class="epc-bt-badge epc-bt-badge--info">@(t.ErpOnly ? "yes" : "no")</span></td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpBosDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_tenant_control_center";
    private bool _isAdmin;
    private IReadOnlyList<PortalTenantDigest> _tenants = [];
    private int _active;
    private int _withDb;
    private int _erpOnly;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin;
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListPortalTenantsAsync(_limit, ctx.RequestAborted);
        _tenants = result.Tenants;
        _active = _tenants.Count(t => t.IsActive);
        _withDb = _tenants.Count(t => t.HasDb);
        _erpOnly = _tenants.Count(t => t.ErpOnly);
        _source = result.Source;
        _message = result.Message;
    }
}
