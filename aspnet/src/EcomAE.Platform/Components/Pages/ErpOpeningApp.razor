@page "/erp/opening-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Opening balances · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Opening balances" BreadcrumbArea="Finance" BreadcrumbTab="Opening">

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Opening balance batches" Subtitle="Open a row for posted time and the 280-character note excerpt. Line JSON omitted. Create and add-line write here." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Opening KPIs">
        <div class="kpi"><div class="lbl">Batches</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Posted</div><div class="val">@_posted.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Debit</div><div class="val">@_debit.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Credit</div><div class="val">@_credit.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>As of</dt><dd>@(string.IsNullOrWhiteSpace(_opened.AsOfDate) ? "—" : _opened.AsOfDate)</dd>
                <dt>Module</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Module) ? "—" : _opened.Module)</dd>
                <dt>Reference</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Reference) ? "—" : _opened.Reference)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Status) ? "—" : _opened.Status)</dd>
                <dt>Lines</dt><dd>@_opened.LineCount.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Debit</dt><dd>@_opened.DebitTotal.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Credit</dt><dd>@_opened.CreditTotal.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Created</dt><dd>@FormatTime(_opened.TimeCreated)</dd>
                <dt>Posted</dt><dd>@FormatTime(_opened.TimePosted)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Line JSON omitted. Create and add-line write here.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.NoteExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">note excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.NoteExcerpt</pre>
                @if (_opened.NoteLen > _opened.NoteExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.NoteExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NoteLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No note excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Module</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Reference) ? "—" : sib.Reference)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Module) ? "—" : sib.Module)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "batch_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>As of</th>
                    <th>Module</th>
                    <th>Reference</th>
                    <th>Status</th>
                    <th class="text-right">Lines</th>
                    <th class="text-right">Debit</th>
                    <th class="text-right">Credit</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_batches.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No opening batches yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _batches)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@(string.IsNullOrWhiteSpace(row.AsOfDate) ? "—" : row.AsOfDate)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Module) ? "—" : row.Module)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Reference) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Reference)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td class="text-right">@row.LineCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.DebitTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.CreditTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "batch_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Period close stays on <a href="/erp/period-close-app">year end</a>.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

<form method="post" action="/erp/opening/add-inv-line" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
            <label>Batch id <input type="number" name="batch_id" style="width:6rem" /></label>
            <label>Item id <input type="number" name="item_id" style="width:6rem" /></label>
            <label>Qty <input type="number" name="qty" step="0.001" style="width:6rem" /></label>
            <label>Unit cost <input type="number" name="unit_cost" step="0.0001" style="width:7rem" /></label>
            <label>Warehouse id <input type="number" name="warehouse_id" style="width:6rem" /></label>
            <label>Batch no <input name="batch_no" /></label>
            <label>Expiry <input type="date" name="expiry_date" /></label>
            <button type="submit">Add inventory line</button>
        </form>

<form method="post" action="/erp/opening/add-coa-line" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
            <label>Batch id <input type="number" name="batch_id" style="width:6rem" /></label>
            <label>Account id <input type="number" name="entity_id" style="width:6rem" /></label>
            <label>Debit <input type="number" name="debit" step="0.01" style="width:7rem" /></label>
            <label>Credit <input type="number" name="credit" step="0.01" style="width:7rem" /></label>
            <button type="submit">Add COA line</button>
        </form>

<form method="post" action="/erp/opening/create-batch" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
            <label>Module
                <select name="module">
                    <option value="combined">combined</option>
                    <option value="coa">coa</option>
                    <option value="cash_bank">cash_bank</option>
                    <option value="inventory">inventory</option>
                    <option value="fixed_assets">fixed_assets</option>
                </select>
            </label>
            <label>As of <input type="date" name="as_of_date" /></label>
            <label>Reference <input name="reference" maxlength="128" /></label>
            <label>Note <input name="note" /></label>
            <button type="submit">Create draft batch</button>
        </form>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=finance&tab=opening";
    private const string _listHref = "/erp/opening-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpOpeningBatchDigest> _batches = [];
    private int _count;
    private int _posted;
    private decimal _debit;
    private decimal _credit;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpOpeningBatchDetail? _opened;
    private IReadOnlyList<ErpOpeningBatchDigest> _openedSiblings = [];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.Reference)
            ? _opened.Reference
            : ("Batch #" + _opened.Id.ToString(CultureInfo.InvariantCulture)));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?batch_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "batch_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpOpeningBatchesAsync(200, ctx.RequestAborted);
        _batches = result.Batches;
        _count = result.Count;
        _posted = result.PostedCount;
        _debit = result.DebitTotal;
        _credit = result.CreditTotal;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpOpeningBatchDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Batch;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _batches.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _batches = new[] { openedList }.Concat(_batches.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
