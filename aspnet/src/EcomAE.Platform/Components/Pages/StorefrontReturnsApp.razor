@page "/storefront/returns-app"
@page "/en/shop/returns"
@page "/shop/returns"
@page "/en/shop/returns/return"
@page "/shop/returns/return"
@page "/en/shop/returns/add"
@page "/shop/returns/add"
@page "/en/shop/returns/add_return"
@page "/shop/returns/add_return"
@page "/en/shop/returns/returns_list"
@page "/shop/returns/returns_list"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject EcomAE.Platform.Data.ITenantDbConnectionFactory Connections
@inject Microsoft.Extensions.Options.IOptions<EcomAE.Platform.Configuration.PhpReferenceOptions> PhpReference

<PageTitle>Returns · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" />

<StorefrontTenantChrome>
    <section style="padding:2rem 0 3rem">
        <div class="container">
            @if (!string.IsNullOrWhiteSpace(_flashOk))
            {
                <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
            }
            @if (!string.IsNullOrWhiteSpace(_flashErr))
            {
                <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
            }
            <script src="/lib/jQuery/jQuery.js"></script>
            @((MarkupString)_html)
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private string _html = "";
    private string _flashOk = "";
    private string _flashErr = "";

    [SupplyParameterFromQuery(Name = "return_id")]
    public string? ReturnId { get; set; }

    [SupplyParameterFromQuery(Name = "items")]
    public string? Items { get; set; }

    [SupplyParameterFromQuery(Name = "read")]
    public string? Read { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _flashOk = ctx.Request.Query["ok"].ToString();
        _flashErr = ctx.Request.Query["err"].ToString();
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);
        var session = await Sessions.ValidateCustomerAsync(ctx, ctx.RequestAborted);
        long userId = session.Kind == LegacySessionKind.Customer && session.UserId > 0 ? session.UserId : 0;
        var path = (ctx.Items.TryGetValue(EcomAE.Platform.Middleware.IndustryStorefrontSlugMiddleware.OriginalPathItem, out var original) && original is string originalPath
            ? originalPath
            : ctx.Request.Path.Value ?? "").TrimEnd('/');
        var config = new Dictionary<string, string>(EcomAE.Platform.Cp.PriceImport.CpPhpConfig.Read(PhpReference.Value), StringComparer.Ordinal)
        {
            ["domain_path"] = ctx.Request.Scheme + "://" + ctx.Request.Host.Value + "/",
        };

        try
        {
            await using var connection = await Connections.OpenAsync(null, ctx.RequestAborted);
            var translator = new StorefrontPhpTranslator(connection, "en");
            var csrf = await StorefrontReturnsPages.SessionCsrfKeyAsync(connection, ctx.Request.Cookies["session"], userId, ctx.RequestAborted);
            if (path.EndsWith("/add_return", StringComparison.Ordinal) || path.EndsWith("/add", StringComparison.Ordinal))
            {
                var formKey = StorefrontReturnsPages.FormKey(config.TryGetValue("tech_key", out var techKey) ? techKey : "", csrf);
                _html = await StorefrontReturnsPages.AddReturnAsync(connection, translator, userId, Items, csrf, formKey, config, ctx.RequestAborted);
            }
            else if (path.EndsWith("/return", StringComparison.Ordinal) || (path == "/storefront/returns-app" && !string.IsNullOrEmpty(ReturnId)))
            {
                _html = await StorefrontReturnsPages.ReturnAsync(connection, translator, userId, ReturnId, csrf, config, PhpReference.Value.PhpDocRoot, ctx.RequestAborted);
            }
            else
            {
                _html = await StorefrontReturnsPages.ListAsync(connection, translator, userId, Read, config, ctx.RequestAborted);
            }
        }
        catch (System.Data.Common.DbException)
        {
            _html = "<p>Returns are unavailable right now.</p>";
        }
        catch (InvalidOperationException)
        {
            _html = "<p>Returns are unavailable right now.</p>";
        }
    }
}
