@page "/storefront/returns-app"
@page "/en/shop/returns"
@page "/shop/returns"
@page "/en/shop/returns/return"
@page "/shop/returns/return"
@page "/en/shop/returns/add"
@page "/shop/returns/add"
@page "/en/shop/returns/returns_list"
@page "/shop/returns/returns_list"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Returns · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" />

<StorefrontTenantChrome>
    <section style="padding:2rem 0 3rem">
        <div class="container" style="max-width:46rem">
            <p style="margin:0 0 .35rem;color:#64748b;font-size:.85rem"><a href="@StorefrontSurfaceLinks.Orders">My orders</a> · Returns</p>
            <h1 style="margin:.1rem 0 .4rem">Returns</h1>
            <p class="lead">Open a return from a paid order. The store reviews the request before a credit is issued.</p>
            @if (!string.IsNullOrWhiteSpace(_flashOk))
            {
                <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
            }
            @if (!string.IsNullOrWhiteSpace(_flashErr))
            {
                <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
            }
            @if (!_isCustomer)
            {
                <div class="panel panel-primary">
                    <div class="panel-body">
                        <p style="margin:0 0 .75rem">Sign in to see your return requests.</p>
                        <a class="btn btn-ar btn-primary" href="@StorefrontSurfaceLinks.Login">Sign in</a>
                    </div>
                </div>
            }
            else
            {
                <input class="form-control" type="text" placeholder="Search returns" id="search-text" />
                <div class="hr-line-dashed col-lg-12"></div>
                <table cellpadding="1" cellspacing="1" id="orders_returns_table" class="table table-condensed table-striped" style="border-collapse: separate; border-spacing: 0 5px;">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Status</th>
                            <th>Order</th>
                            <th>Items</th>
                            <th class="hidden"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_returns.Count == 0)
                        {
                            <tr>
                                <td colspan="5">@(string.IsNullOrWhiteSpace(_listMessage) ? "No return requests yet." : _listMessage)</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in _returns)
                            {
                                <tr>
                                    <td>
                                        <a href="@(StorefrontAspNetCanonical.CustomerReturns + "?return_id=" + row.Id.ToString(CultureInfo.InvariantCulture))">@row.Id.ToString(CultureInfo.InvariantCulture)</a>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(row.Status) ? "Open" : row.Status)</td>
                                    <td>
                                        @if (row.OrderId > 0)
                                        {
                                            <a href="@StorefrontSurfaceLinks.ForOrder(row.OrderId)">@row.OrderId.ToString(CultureInfo.InvariantCulture)</a>
                                        }
                                        else
                                        {
                                            <text>—</text>
                                        }
                                    </td>
                                    <td>—</td>
                                    <td class="hidden"></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                @if (_detail is not null)
                {
                    <h3><label>Return #@_detail.Id.ToString(CultureInfo.InvariantCulture)</label></h3>
                    <label>Status: </label>@(string.IsNullOrWhiteSpace(_detail.Status) ? "Open" : _detail.Status)
                    @if (_detail.OrderId > 0)
                    {
                        <p><a href="@StorefrontSurfaceLinks.ForOrder(_detail.OrderId)">Order #@_detail.OrderId.ToString(CultureInfo.InvariantCulture)</a></p>
                    }
                    <p class="lead" style="border-bottom: 2px solid; padding-bottom: 10px;"><strong>Return items</strong></p>
                    <div style="overflow: hidden; overflow-x: auto;">
                        <table class="table">
                            <tr>
                                <th style="vertical-align: middle; white-space: nowrap;">Brand</th>
                                <th style="vertical-align: middle; white-space: nowrap;">Article</th>
                                <th style="vertical-align: middle;">Name</th>
                                <th style="vertical-align: middle; white-space: nowrap;">Qty</th>
                                <th style="vertical-align: middle; white-space: nowrap;">Reason</th>
                            </tr>
                            @if (_items.Count == 0)
                            {
                                <tr><td colspan="5">No items on this return.</td></tr>
                            }
                            else
                            {
                                @foreach (var line in _items)
                                {
                                    <tr>
                                        <td style="vertical-align: middle; white-space: nowrap;">@(string.IsNullOrWhiteSpace(line.Brand) ? "—" : line.Brand)</td>
                                        <td style="vertical-align: middle; white-space: nowrap;">@(string.IsNullOrWhiteSpace(line.Article) ? "—" : line.Article)</td>
                                        <td style="vertical-align: middle;">@(string.IsNullOrWhiteSpace(line.Name) ? "—" : line.Name)</td>
                                        <td style="vertical-align: middle; white-space: nowrap; text-align:center;">@line.CountNeed.ToString("0.##", CultureInfo.InvariantCulture)</td>
                                        <td style="vertical-align: middle; white-space: nowrap;">@(string.IsNullOrWhiteSpace(line.Reason) ? "—" : line.Reason)</td>
                                    </tr>
                                }
                            }
                        </table>
                    </div>
                    <p class="lead">Messages</p>
                    <div>
                        <div class="chat_block" id="chat_block">
                            @if (_messages.Count == 0)
                            {
                                <div align="center">No messages yet.</div>
                            }
                            else
                            {
                                @foreach (var msg in _messages)
                                {
                                    <div class="@(msg.IsCustomer != 0 ? "bubble" : "bubble2")">
                                        @(msg.IsCustomer != 0 ? "You" : "Store")<br />@msg.Text
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }

                <p style="margin:1rem 0 .85rem"><a class="btn btn-ar btn-default" href="@StorefrontSurfaceLinks.Orders">Choose an order</a></p>
                <p class="lead">New return</p>
                <div class="return_options">
                    <form class="return_options_data" method="post" action="@PhpCustomerWrites.ReturnsCreateHref">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="/storefront/returns-app" />
                        <div class="col-lg-6 col-sm-6 col-md-12" style="margin-top: 10px;">
                            <label for="order_id">Order number</label>
                            <input id="order_id" class="form-control" type="number" name="order_id" required min="1" value="@OrderId" />
                        </div>
                        <div class="col-lg-6 col-sm-6 col-md-12" style="margin-top: 10px;">
                            <label for="item_id">Order item id</label>
                            <input id="item_id" class="form-control" type="number" name="item_id" required min="1" />
                        </div>
                        <div class="col-lg-6 col-sm-6 col-md-12" style="margin-top: 10px;">
                            <label for="reason_id">Reason id</label>
                            <input id="reason_id" class="form-control" type="number" name="reason_id" required min="1" />
                        </div>
                        <div class="col-lg-6 col-sm-6 col-md-12" style="margin-top: 10px;">
                            <label for="count">Quantity (full line only)</label>
                            <input id="count" class="form-control" type="number" name="count" required min="1" value="1" />
                        </div>
                        <div class="col-lg-12 col-sm-6 col-md-12" style="margin-top: 10px;">
                            <label for="comment">Comment</label>
                            <textarea name="comment" id="comment" class="form-control" rows="6" placeholder="Comment"></textarea>
                        </div>
                        <p>
                            <button type="submit" id="btn_confirm_return" class="btn btn-ar btn-primary">Submit return request</button>
                        </p>
                    </form>
                </div>
                @if (ReturnId is > 0)
                {
                    <form method="post" action="@PhpCustomerWrites.ReturnsMessageHref" style="margin-top:1rem">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@("/storefront/returns-app?return_id=" + ReturnId.Value.ToString(CultureInfo.InvariantCulture))" />
                        <input type="hidden" name="return_id" value="@ReturnId.Value.ToString(CultureInfo.InvariantCulture)" />
                        <label for="new_message_area">Message on return #@ReturnId</label>
                        <textarea id="new_message_area" name="text" rows="3" required class="form-control"></textarea>
                        <button type="submit" class="btn btn-ar btn-primary" style="margin-top:.75rem">Send message</button>
                    </form>
                }
            }
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private bool _isCustomer;
    private IReadOnlyList<StorefrontReturnDigest> _returns = [];
    private StorefrontReturnDigest? _detail;
    private IReadOnlyList<StorefrontReturnItemDigest> _items = [];
    private IReadOnlyList<StorefrontOrderMessageDigest> _messages = [];
    private string _listMessage = "";
    private string _flashOk = "";
    private string _flashErr = "";

    [SupplyParameterFromQuery(Name = "order_id")]
    public string? OrderId { get; set; }

    [SupplyParameterFromQuery(Name = "return_id")]
    public int? ReturnId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);
        var session = await Sessions.ValidateCustomerAsync(ctx, ctx.RequestAborted);
        _isCustomer = session.Kind == LegacySessionKind.Customer && session.UserId > 0;
        if (_isCustomer && session.UserId > 0)
        {
            var list = await Dashboards.ListStorefrontReturnsAsync(session.UserId, 40, ctx.RequestAborted);
            _returns = list.Returns;
            _listMessage = list.Count == 0
                ? (string.IsNullOrWhiteSpace(list.Message) ? "No return requests yet." : list.Message)
                : string.Empty;
            if (ReturnId is > 0)
            {
                var detail = await Dashboards.GetStorefrontReturnAsync(session.UserId, ReturnId.Value, ctx.RequestAborted);
                _detail = detail.Return;
                _items = detail.Items;
                _messages = detail.Messages;
            }
        }
    }
}
