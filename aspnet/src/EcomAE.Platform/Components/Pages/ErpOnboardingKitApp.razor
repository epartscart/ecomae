@page "/erp/onboarding-kit-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using System.Text
@using System.Text.Encodings.Web
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Middleware
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

@* Tenant Onboarding Kit — printable handover book for a new client (ERP-only or full tenant).
   ?print=1 renders the book without chrome so it saves cleanly as PDF via the browser. *@

@if (!_print)
{
    <PageTitle>Onboarding kit · ERP · eParts Cart</PageTitle>
    <PhpChromeStyles Surface="erp" />
    <PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Onboarding kit" BreadcrumbArea="Setup" BreadcrumbTab="Onboarding kit">

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    <span class="label label-primary">@TenantTypeLabel</span>
                    Tenant onboarding kit — printable handover book
                </div>
                <div class="panel-body">
                    <p>A complete handover book for this tenant: access &amp; admin credentials, how ecom is organized, the full module map, the customization map, and the go-live checklist. Open the print view and use your browser's <em>Save as PDF</em> to produce the PDF kit.</p>
                    <p>
                        <a class="btn btn-primary" href="/erp/onboarding-kit-app?print=1" target="_blank" rel="noopener"><i class="fa fa-print"></i> Open print view (Save as PDF)</a>
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel"><div class="panel-body">
                @BookBody()
            </div></div>
        </div>

    </PhpErpDesktopChrome>
}
else
{
    <PageTitle>@TenantTypeLabel onboarding kit · @_host</PageTitle>
    <style>
        @@page { size: A4; margin: 14mm; }
        body { font-family: "Segoe UI", Arial, sans-serif; color:#1c2b39; }
        .okb-printbar { position:sticky; top:0; padding:8px 12px; background:#12324f; color:#fff; text-align:center; z-index:10; }
        .okb-printbar button { background:#14b8a6; color:#fff; border:0; border-radius:6px; padding:6px 16px; font-weight:700; cursor:pointer; }
        @@media print { .okb-printbar { display:none !important; } }
        @@media screen { .okb { max-width: 190mm; margin: 0 auto; } }
    </style>
    <div class="okb-printbar no-print">
        <button type="button" onclick="window.print()">Print / Save as PDF</button>
    </div>
    @BookBody()
}

@code {
    private RenderFragment BookBody() => @<div class="okb">
        <style>
            .okb { font-size: 12.5px; line-height: 1.5; }
            .okb h1 { font-size: 30px; margin: 0 0 4px; color:#0f2f4d; }
            .okb h2 { font-size: 17px; margin: 0 0 8px; color:#0f766e; border-bottom: 2px solid #14b8a6; padding-bottom: 4px; }
            .okb h3 { font-size: 13px; margin: 12px 0 6px; color:#12324f; }
            .okb p { margin: 0 0 8px; }
            .okb .cover { text-align:center; padding: 60px 20px 50px; page-break-after: always;
                border: 3px solid #0f766e; border-radius: 14px; margin-bottom: 18px;
                background: linear-gradient(160deg, #f0fdfa 0%, #ffffff 55%, #eff6ff 100%); }
            .okb .cover .brand { font-size: 44px; font-weight: 800; color:#0f766e; letter-spacing:.06em; }
            .okb .cover .sub { font-size: 15px; color:#3d4f66; margin-top: 8px; }
            .okb .cover .type { display:inline-block; margin-top: 18px; padding: 8px 22px; border-radius:999px;
                background: linear-gradient(160deg,#14b8a6,#0f766e); color:#fff; font-weight:700; font-size: 14px; }
            .okb .cover .meta { margin-top: 26px; font-size: 12px; color:#55677d; }
            .okb section { page-break-inside: avoid; margin: 0 0 18px; padding: 14px 16px; border:1px solid #d5e3f2; border-radius: 12px; }
            .okb section.brk { page-break-before: always; }
            .okb table { width:100%; border-collapse: collapse; font-size: 11.5px; }
            .okb th, .okb td { border:1px solid #dde7f0; padding: 5px 8px; text-align:left; }
            .okb th { background:#f1f7fb; color:#12324f; }
            .okb .cred { border:1.5px dashed #0f766e; border-radius:10px; padding:10px 12px; margin:8px 0; background:#f6fefc; }
            .okb .cred label { display:block; font-size:10px; text-transform:uppercase; letter-spacing:.05em; color:#0f766e; font-weight:800; margin-bottom:2px; }
            .okb .cred input { width:100%; border:0; border-bottom:1px solid #94b8b0; background:transparent; font-size:13px; padding:4px 2px; }
            .okb .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
            .okb ol li, .okb ul li { margin: 3px 0; }
            .okb .tag { display:inline-block; padding:1px 8px; border-radius:999px; font-size:10px; font-weight:700; margin-right:4px; }
            .okb .tag.erp { background:#e0f2f1; color:#0f766e; }
            .okb .tag.cp { background:#e8f0fe; color:#1d4ed8; }
            .okb .tag.sf { background:#fef3e2; color:#b45309; }
            .okb .sign { display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-top:14px; }
            .okb .sign .line { border-top:1px solid #33465c; padding-top:4px; font-size:11px; color:#55677d; }
            .okb .note { font-size:11px; color:#6b7d90; }
            .okb .toc td { border:0; border-bottom:1px dotted #c8d6e2; padding:4px 2px; }
            .okb .cover .c-logos { display:flex; align-items:center; justify-content:center; gap:26px; margin-bottom:30px; }
            .okb .cover .c-logos img { height:56px; object-fit:contain; }
            .okb .cover .c-x { font-size:22px; color:#94a3b8; font-weight:300; }
            .okb .cover .c-tenant { font-size:34px; font-weight:800; color:#12324f; }
            .okb .cover .c-rule { height:3px; width:120px; margin:14px auto; border-radius:99px; background:linear-gradient(90deg,#14b8a6,#0ea5e9); }
            .okb .lane { margin:10px 0 14px; border:1px solid #d5e3f2; border-radius:10px; overflow:hidden; }
            .okb .lane-h { padding:7px 12px; font-weight:800; color:#fff; font-size:12.5px;
                background:linear-gradient(160deg,#0f766e,#12324f); }
            .okb .lane-h i { margin-right:6px; }
            .okb .steps { display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); }
            .okb .step { padding:8px 10px; border-right:1px solid #eef3f8; border-bottom:1px solid #eef3f8; }
            .okb .step .n { display:inline-block; min-width:22px; height:22px; line-height:22px; text-align:center;
                border-radius:999px; background:#14b8a6; color:#fff; font-weight:800; font-size:11px; margin-right:6px; }
            .okb .step .t { font-weight:700; color:#12324f; font-size:11.5px; }
            .okb .step .d { display:block; margin-top:3px; color:#5b6b7c; font-size:10.5px; }
            .okb .step a { color:#0f766e; font-size:10.5px; }
            .okb .gcard { margin:0 0 14px; border:1px solid #d5e3f2; border-radius:10px; overflow:hidden; page-break-inside:avoid; }
            .okb .gcard-h { display:flex; align-items:center; gap:8px; padding:8px 12px;
                background:linear-gradient(160deg,#12324f,#0f766e); color:#fff; font-weight:800; font-size:12.5px; }
            .okb .gcard-h i { font-size:14px; }
            .okb .gcard .glead { padding:6px 12px; color:#5b6b7c; font-size:11px; background:#f6fafd; }
            .okb .gcard .ch { padding:8px 12px 4px; }
            .okb .gcard .ch h4 { margin:0 0 4px; font-size:11.5px; color:#0f766e; }
            .okb .gcard .ch ol { margin:0 0 6px 18px; padding:0; font-size:11px; }
            .okb .gcard .ch .lead { font-size:10.5px; color:#6b7d90; }
            .okb .tier { display:flex; gap:8px; margin:10px 0; }
            .okb .tier div { flex:1; text-align:center; padding:8px 6px; border-radius:8px; font-size:10.5px; font-weight:700; }
        </style>

        <div class="cover">
            <div class="c-logos">
                <img src="@ErpAppAssets.PlatformLogoUrl" alt="ecom" />
                <span class="c-x">&#215;</span>
                @if (!string.IsNullOrEmpty(_tenantLogoUrl))
                {
                    <img src="@_tenantLogoUrl" alt="@_tenantName" />
                }
                else
                {
                    <span class="c-tenant">@_tenantName</span>
                }
            </div>
            <h1>@_tenantName</h1>
            <div class="c-rule"></div>
            <div class="sub">Enterprise ERP &amp; Business Operating System — Client Handover Book</div>
            <div class="type">@TenantTypeLabel — Onboarding Kit</div>
            <p class="sub" style="margin-top:22px">The complete operating book for this tenant: access &amp; admin credentials, how ecom is organized and who controls what, the full module map, your industry workspace guide, every admin &amp; operations guide in the system, the customization map and the go-live checklist.</p>
            <div class="meta">
                Tenant: <strong>@_host</strong> &nbsp;·&nbsp; Industry: <strong>@IndustryLabel</strong><br/>
                Prepared: @DateTime.UtcNow.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) UTC · Kit v2.0 · Confidential — tenant internal use only
            </div>
        </div>

        <section>
            <h2>Contents</h2>
            <table class="toc">
                <tr><td>1 · Access &amp; admin credentials</td></tr>
                <tr><td>2 · How ecom is organized &amp; your admin authority</td></tr>
                <tr><td>3 · ERP module map</td></tr>
                <tr><td>4 · @IndustryLabel workspace — guide &amp; process</td></tr>
                <tr><td>5 · Admin &amp; customization guides (step-by-step)</td></tr>
                <tr><td>6 · Operations guides (module by module)</td></tr>
                <tr><td>7 · Customization map</td></tr>
                <tr><td>8 · Go-live checklist</td></tr>
                <tr><td>9 · House rules</td></tr>
                <tr><td>10 · Handover sign-off</td></tr>
            </table>
        </section>

        <section class="brk">
            <h2>1 · Access &amp; admin credentials</h2>
            <h3>Sign-in URLs</h3>
            <table>
                <tr><th>Area</th><th>URL</th></tr>
                <tr><td><span class="tag erp">ERP</span> ERP sign-in</td><td>https://@_host/erp/login</td></tr>
                @if (_canCp)
                {
                    <tr><td><span class="tag cp">CP</span> Control Panel sign-in</td><td>https://@_host/cp/login</td></tr>
                    <tr><td><span class="tag sf">SF</span> Storefront</td><td>https://@_host/storefront/app</td></tr>
                }
                <tr><td><span class="tag erp">ERP</span> ERP home</td><td>https://@_host/erp</td></tr>
            </table>

            <h3>Issued admin credentials (fill at handover)</h3>
            <div class="cred">
                <div class="grid2">
                    <div><label>Admin login</label><input type="text" autocomplete="off" /></div>
                    <div><label>Temporary password</label><input type="password" autocomplete="new-password" /></div>
                    <div><label>Issued by</label><input type="text" autocomplete="off" /></div>
                    <div><label>Date issued</label><input type="text" autocomplete="off" /></div>
                </div>
                <p class="note" style="margin-top:6px">Passwords are never stored in this kit — write them here only at the moment of handover, then advise the admin to change the password at first sign-in (ERP → Setup → Security (MFA / 2FA) for two-factor enrollment).</p>
            </div>

            <h3>ERP staff accounts (@_staffCount)</h3>
            @if (_staff.Count == 0)
            {
                <p class="note">No staff accounts yet — create them in ERP → Setup → Users &amp; credentials, then assign roles in ERP → Setup → Tenant config &amp; security.</p>
            }
            else
            {
                <table>
                    <tr><th>Name</th><th>Email</th><th>Job title</th><th>Department</th><th>Status</th></tr>
                    @foreach (var s in _staff)
                    {
                        <tr>
                            <td>@s.DisplayName</td><td>@s.Email</td><td>@s.JobTitle</td><td>@s.DepartmentCode</td>
                            <td>@(s.Active ? "Active" : "Inactive")</td>
                        </tr>
                    }
                </table>
            }

            @if (_canCp)
            {
                <h3>Storefront / portal user accounts (@_cpUserCount)</h3>
                <p class="note">These are storefront &amp; portal user accounts (customers and portal users) — admin access is granted through the ERP staff table above plus CP admin roles, not through this list.</p>
                @if (_cpUsers.Count == 0)
                {
                    <p class="note">No CP users returned.</p>
                }
                else
                {
                    <table>
                        <tr><th>Name</th><th>Email</th><th>Phone</th><th>Status</th></tr>
                        @foreach (var u in _cpUsers)
                        {
                            <tr>
                                <td>@u.DisplayName</td><td>@u.Email</td><td>@u.Phone</td>
                                <td>@(u.Unlocked != 0 ? "Unlocked" : "Locked")</td>
                            </tr>
                        }
                    </table>
                }
            }
        </section>

        <section class="brk">
            <h2>2 · How ecom is organized</h2>
            <p>ecom runs as layered customization: <strong>Super platform → Industry pack → Tenant</strong>. Industry and super defaults cascade down; anything the tenant sets always wins. Your admin team controls the tenant layer — nothing at super level is required for daily work.</p>
            <table>
                <tr><th>Layer</th><th>What it covers</th><th>Who controls it</th></tr>
                <tr><td><span class="tag erp">ERP</span> ERP</td><td>Finance, GL/COA, sales, purchasing, inventory, projects, HR, reports</td><td>Tenant ERP admin (this kit)</td></tr>
                @if (_canCp)
                {
                    <tr><td><span class="tag cp">CP</span> Control Panel</td><td>Storefront catalog, menus, branding, portal settings, orders</td><td>Tenant CP admin</td></tr>
                    <tr><td><span class="tag sf">SF</span> Storefront</td><td>Customer-facing shop, account, checkout</td><td>Driven by CP + design tokens</td></tr>
                }
            </table>
            <p class="note">Workspace documents (invoices, vouchers, work orders, claims) post to the General Ledger automatically — there is no month-end posting step. Dashboards, P&amp;L, Balance Sheet and reports always read live workspace data.</p>
            <h3>Your authority over users (tenant admin)</h3>
            <p>As tenant admin you control every user's reach — per module, per page, per field — without asking the platform:</p>
            <div class="tier">
                <div style="background:#e0f2f1;color:#0f766e">1 · Role<br/><span style="font-weight:400">the job function</span></div>
                <div style="background:#e8f0fe;color:#1d4ed8">2 · Duties &amp; privileges<br/><span style="font-weight:400">what the role can open &amp; do</span></div>
                <div style="background:#fef3e2;color:#b45309">3 · Field rules<br/><span style="font-weight:400">hide / read-only per field</span></div>
                <div style="background:#fde8ef;color:#be185d">4 · Dashboard<br/><span style="font-weight:400">widgets per user / group</span></div>
            </div>
            <p class="note">All of it lives in ERP → Setup → Tenant config &amp; security (/erp/tenant-config-app → Security roles) and Dashboards (/erp/dashboard-app). Changes apply instantly to that user's next page load.</p>
        </section>

        <section class="brk">
            <h2>3 · ERP module map</h2>
            <p>Every area below is in the ERP top menu (Setup → under the matching area). Open ERP → <a href="https://@_host/erp/tenant-guide">Tenant guide</a> for the live org map.</p>
            <table>
                <tr><th>Area</th><th>What it does</th></tr>
                @foreach (var c in PhpModuleCatalog.ErpCategories)
                {
                    <tr><td>@c.Label</td><td>@c.Description</td></tr>
                }
            </table>
            <h3>Key admin destinations</h3>
            <table>
                <tr><th>Destination</th><th>Path</th></tr>
                <tr><td>Tenant config &amp; security (roles → duties → privileges → field rules)</td><td>/erp/tenant-config-app</td></tr>
                <tr><td>Users &amp; credentials</td><td>/erp/users-app</td></tr>
                <tr><td>Tenant guide (live org map)</td><td>/erp/tenant-guide</td></tr>
                <tr><td>Mobile apps (ERP app under ERP admin)</td><td>/erp/mobile-apps-app</td></tr>
                <tr><td>Dashboards (per-user &amp; group personalize)</td><td>/erp/dashboard-app</td></tr>
                <tr><td>This onboarding kit</td><td>/erp/onboarding-kit-app</td></tr>
            </table>
        </section>

        <section class="brk">
            <h2>4 · @IndustryLabel workspace — guide &amp; process</h2>
            <p>Your tenant runs the <strong>@IndustryLabel</strong> workspace — the same graphical process track you see at the top of the workspace page (<a href="https://@(_host + IndustryWorkspaceHref)">@IndustryWorkspaceHref</a>), printed here for handover.@(_canCp ? " Industry packs are enabled in Industry settings (/cp/industry-settings-app)." : "")</p>
            @IndustryLanes()
        </section>

        <section class="brk">
            <h2>5 · Admin &amp; customization guides</h2>
            <p>Every customization page in ecom opens with a step-by-step graphical guide — collected here in full so the book stands alone. @( _canCp ? "" : "CP-level areas (branding, menus, industry pack, custom fields) are applied by the platform team for ERP-only tenants and are omitted.")</p>
            @foreach (var (slug, label, href, icon) in TenantCustomizationGuide.RelatedLinks)
            {
                if (!AreaVisible(slug)) { continue; }
                var area = TenantCustomizationGuide.Areas[slug];
                <div class="gcard">
                    <div class="gcard-h"><i class="fa @icon"></i> @label <span style="margin-left:auto;font-weight:400;font-size:10.5px">@href</span></div>
                    <div class="glead">@area.Intro</div>
                    <div class="steps">
                        @foreach (var st in area.Steps)
                        {
                            <div class="step"><span class="n">@st.Number</span> <i class="fa @st.Icon"></i> <span class="t">@st.Label</span><span class="d">@st.Detail</span>@if (!string.IsNullOrEmpty(st.Href)) { <a href="https://@(_host + st.Href)">@st.Href</a> }</div>
                        }
                    </div>
                </div>
            }
        </section>

        <section class="brk">
            <h2>6 · Operations guides — module by module</h2>
            @if (_canCp)
            {
                <p>The in-app operator guides (CP → Guides) reproduced as print chapters — follow each numbered chapter end-to-end for that module's daily process.</p>
            }
            else
            {
                <p>Module operation guides for your tenant are embedded in each workspace page (section 4 covers your industry process end-to-end). CP operator guides apply to full tenants only.</p>
            }
            @foreach (var g in OperatorGuidesCatalog.All)
            {
                if (!_canCp) { break; }
                if (string.Equals(g.Surface, "super", StringComparison.Ordinal)) { continue; }
                <div class="gcard">
                    <div class="gcard-h"><i class="fa @g.Icon"></i> @g.Title <span style="margin-left:auto;font-weight:400;font-size:10.5px">@g.Href</span></div>
                    <div class="glead">@g.Summary</div>
                    @foreach (var ch in g.Chapters)
                    {
                        <div class="ch">
                            <h4>@ch.Title</h4>
                            <div class="lead">@ch.Lead</div>
                            <ol>
                                @foreach (var st in ch.Steps)
                                {
                                    <li>@st</li>
                                }
                            </ol>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="brk">
            <h2>7 · Customization map</h2>
            <p>Everything a tenant admin can customize, and where:</p>
            <table>
                <tr><th>What</th><th>Where</th><th>Scope</th></tr>
                @if (_canCp)
                {
                    <tr><td>Branding, colors, logo, theme</td><td>/cp/design-tokens-app</td><td>Tenant (overrides industry &amp; super)</td></tr>
                    <tr><td>Menus</td><td>/cp/menus-app</td><td>Tenant</td></tr>
                    <tr><td>Industry pack &amp; terminology</td><td>/cp/industry-settings-app</td><td>Tenant</td></tr>
                    <tr><td>Custom fields</td><td>/cp/vin-fields-app</td><td>Tenant</td></tr>
                }
                else
                {
                    <tr><td>Tenant branding, menus, industry pack, custom fields</td><td>Managed by the platform team for ERP-only tenants</td><td>Platform</td></tr>
                }
                <tr><td>Dashboard widgets per user / group</td><td>/erp/dashboard-app</td><td>Per user + tenant defaults</td></tr>
                <tr><td>Field-level security (hide / read-only)</td><td>/erp/tenant-config-app → Security roles</td><td>Per user + per group</td></tr>
                <tr><td>Roles, duties, privileges</td><td>/erp/tenant-config-app</td><td>Tenant</td></tr>
                <tr><td>Mobile apps</td><td>/erp/mobile-apps-app (ERP)@(_canCp ? " · /cp/mobile-apps-app (CP)" : "")</td><td>Tenant</td></tr>
                <tr><td>Print / document design</td><td>/erp/print-designer-app</td><td>Tenant</td></tr>
            </table>
            <p class="note">Every customization page opens with a step-by-step graphical guide and a preview of where the change lands.</p>
        </section>

        <section class="brk">
            <h2>8 · Go-live checklist</h2>
            <ol>
                <li><strong>Sign in</strong> at /erp/login with the issued admin credential; change the temporary password and enroll 2FA (ERP → Setup → Security MFA).</li>
                <li><strong>Review the org map</strong> — ERP → Setup → Tenant guide shows legal entities, business units, warehouses.</li>
                <li><strong>Create users</strong> — ERP → Setup → Users &amp; credentials; assign each a department.</li>
                <li><strong>Define security</strong> — ERP → Setup → Tenant config &amp; security → Security roles: create roles, attach duties and privileges, add field rules (hide/read-only) where needed.</li>
                <li><strong>Set up finance</strong> — Chart of accounts, fiscal calendar, currencies and exchange rates under Record to Report.</li>
                <li><strong>Load master data</strong> — customers, vendors, products, warehouses via CSV import (ecom studio) or the module forms.</li>
                @if (_canCp)
                {
                    <li><strong>Brand the platform</strong> — design tokens (colors/logo), menus, dashboard defaults.</li>
                    <li><strong>Industry pack</strong> — enable the vertical pack in Industry settings so workspaces and terminology match your business.</li>
                }
                else
                {
                    <li><strong>Branding &amp; industry pack</strong> — applied by the platform team for ERP-only tenants; confirm the vertical pack on the dashboard.</li>
                }
                <li><strong>Mobile app</strong> — configure the ERP app under Setup → Mobile apps@( _canCp ? " (and the CP app under CP → Mobile apps)" : "").</li>
                <li><strong>Verify reports</strong> — Trial Balance, P&amp;L, Balance Sheet read live workspace data; run a test document end-to-end.</li>
                <li><strong>Handover</strong> — print this kit, fill the credential box, collect signatures below.</li>
            </ol>
        </section>

        <section>
            <h2>9 · House rules</h2>
            <ul>
                <li><strong>Sandbox vs operations:</strong> demo/sample data runs only on sandbox tenants — it is blocked on operation tenants by design.</li>
                <li><strong>No month-end posting:</strong> documents post to GL/COA automatically when saved/approved.</li>
                <li><strong>Field security is real:</strong> hidden fields keep stored values; read-only fields reject changed values server-side.</li>
                <li><strong>Writes are gated:</strong> admin saves require confirmWrites — nothing mutates silently.</li>
                <li><strong>Guides everywhere:</strong> each admin/customization page carries a step-by-step graphical guide at the top.</li>
            </ul>
        </section>

        <section>
            <h2>10 · Handover sign-off</h2>
            <p class="note">Signatures confirm the tenant admin received this kit, the credentials listed in section 1, and a walkthrough of sections 2–6.</p>
            <div class="sign">
                <div class="line">Delivered by (name, role, date)</div>
                <div class="line">Received by — tenant admin (name, date)</div>
            </div>
        </section>
    </div>;

    private bool _print;
    private bool _isAdmin;
    private bool _canErp;
    private bool _canCp;
    private string _host = "";
    private string _industryCode = "";
    private string _tenantName = "";
    private string _tenantLogoUrl = "";
    private LoginHostBrand.Brand _brand = null!;
    private IReadOnlyList<ErpStaffProfileDigest> _staff = [];
    private IReadOnlyList<CpUserDigest> _cpUsers = [];
    private int _staffCount;
    private int _cpUserCount;

    private string TenantTypeLabel => _canCp ? "Full tenant (ERP + CP + storefront)" : "ERP tenant";

    private string IndustryLabel => _industryCode switch
    {
        "auto_parts" => "Auto parts",
        "jewellery" => "Jewellery",
        "real_estate" => "Real estate",
        "fit_out" => "Fit-out / contracting",
        _ => "Industry",
    };

    private string IndustryWorkspaceHref => _industryCode switch
    {
        "auto_parts" => "/erp/autoparts/workspace",
        "jewellery" => "/erp/jewellery/workspace",
        "real_estate" => "/erp/real-estate-app",
        "fit_out" => "/erp/fitout/workspace",
        _ => "/erp",
    };

    private static string Html(string? value) => HtmlEncoder.Default.Encode(value ?? "");

    /// <summary>CP-surface customization areas are only shown to full tenants.</summary>
    private bool AreaVisible(string slug) => slug switch
    {
        "design-tokens" or "menus" or "industry-settings" or "custom-fields" => _canCp,
        _ => true,
    };

    /// <summary>Renders only this tenant's industry pack lanes as graphical step tracks.</summary>
    private MarkupString IndustryLanes()
    {
        var sb = new StringBuilder();
        void Lane(string title, string icon, IEnumerable<(int Number, string Icon, string Label, string Detail, string? Href)> steps)
        {
            sb.Append("<div class=\"lane\"><div class=\"lane-h\"><i class=\"fa ").Append(Html(icon))
                .Append("\" aria-hidden=\"true\"></i> ").Append(Html(title)).Append("</div><div class=\"steps\">");
            foreach (var st in steps)
            {
                sb.Append("<div class=\"step\"><span class=\"n\">").Append(st.Number)
                    .Append("</span> <i class=\"fa ").Append(Html(st.Icon)).Append("\" aria-hidden=\"true\"></i> ")
                    .Append("<span class=\"t\">").Append(Html(st.Label)).Append("</span>");
                if (!string.IsNullOrWhiteSpace(st.Detail))
                    sb.Append("<span class=\"d\">").Append(Html(st.Detail)).Append("</span>");
                if (!string.IsNullOrWhiteSpace(st.Href))
                    sb.Append("<a href=\"https://").Append(Html(_host)).Append(Html(st.Href)).Append("\">").Append(Html(st.Href)).Append("</a>");
                sb.Append("</div>");
            }
            sb.Append("</div></div>");
        }

        var codes = _industryCode is "auto_parts" or "jewellery" or "real_estate" or "fit_out"
            ? new[] { _industryCode }
            : new[] { "auto_parts", "jewellery", "real_estate", "fit_out" };
        foreach (var code in codes)
        {
            switch (code)
            {
                case "auto_parts":
                    foreach (var l in ErpAutoPartsGuide.Lanes)
                        Lane(l.Title, l.Icon, l.Steps.Select(x => (x.Number, x.Icon, x.Label, x.Detail, (string?)x.Href)));
                    break;
                case "jewellery":
                    foreach (var l in ErpJewelleryGuide.Lanes)
                        Lane(l.Title, l.Icon, l.Steps.Select(x => (x.Number, x.Icon, x.Label, x.Detail, (string?)x.Href)));
                    break;
                case "real_estate":
                    foreach (var l in ErpRealEstateGuide.Lanes)
                        Lane(l.Title, l.Icon, l.Steps.Select(x => (x.Number, x.Icon, x.Label, "", (string?)x.Href)));
                    break;
                case "fit_out":
                    foreach (var l in ErpFitOutGuide.Lanes)
                        Lane(l.Title, l.Icon, l.Steps.Select(x => (x.Number, x.Icon, x.Label, x.Detail, (string?)x.Href)));
                    break;
            }
        }
        return new MarkupString(sb.ToString());
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _print = string.Equals(ctx.Request.Query["print"], "1", StringComparison.Ordinal);
        _host = PlatformHostPolicy.NormalizeHost(ctx.Request.Host.Host);
        _brand = LoginHostBrand.Resolve(_host, "erp");
        var tenant = ctx.Items[TenantResolutionMiddleware.HttpContextItemKey] as TenantContext;
        _industryCode = tenant?.IndustryCode ?? "";
        _tenantName = _brand.Label;
        _tenantLogoUrl = _brand.LogoUrl ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _canErp = session.Capabilities?.Contains("erp") ?? false;
        _canCp = session.Capabilities?.Contains("cp") ?? false;
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session) && (_canErp || _canCp);
        if (!_isAdmin)
        {
            return;
        }

        var staff = await Dashboards.ListErpStaffAsync(50, ctx.RequestAborted);
        _staff = staff.Staff;
        _staffCount = staff.Count;

        if (_canCp)
        {
            var users = await Dashboards.ListCpUsersAsync(50, ctx.RequestAborted);
            _cpUsers = users.Users;
            _cpUserCount = users.Count;
        }
    }
}
