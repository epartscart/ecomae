@page "/erp/delivery-notes-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Components.Shared.Desktop
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Erp
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav
@inject IErpDimensionCatalogReadService DimensionCatalog

<PageTitle>Delivery Notes · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Delivery Notes" BreadcrumbArea="Order to Cash" BreadcrumbTab="Delivery Notes">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/delivery-notes-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Delivery Notes" Subtitle="Create PHP-compatible shipment notes with optional carrier, tracking, and shipped status." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Delivery Notes KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_notes.Count</div></div>
        <div class="kpi"><div class="lbl">Digest source</div><div class="val">@_source</div></div>
        <div class="kpi"><div class="lbl">Session</div><div class="val">@(_isAdmin ? "live" : "guest")</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <ErpDocumentWorkspace
                DocumentKind="Delivery note"
                Title="@(_opened.NoteNo is { Length: > 0 } ? _opened.NoteNo : $"Delivery note #{_opened.Id}")"
                DocumentNumber="@_opened.Id.ToString(CultureInfo.InvariantCulture)"
                PartyLabel="Source order"
                Party="@FormatId(_opened.OrderId)"
                ReferenceLabel="Tracking"
                Reference="@(_opened.TrackingNo is { Length: > 0 } ? _opened.TrackingNo : "—")"
                Status="@(_opened.Status is { Length: > 0 } ? _opened.Status : "created")"
                ApprovalState="@(_opened.ShippedAt > 0 ? "Shipped" : "Not shipped")"
                CompanyContext="Tenant / company"
                Currency="—"
                Fields="@DeliveryWorkspaceFields"
                Tabs="@DeliveryWorkspaceTabs"
                HeaderActions="@DeliveryHeaderActions" />
            <p class="text-muted" style="margin:.85rem 0 0">This delivery-note read model exposes shipment header and tracking data; no line body is invented. The guarded document route remains available when a PDF has been generated.</p>
            <p class="text-muted" style="margin:.85rem 0 0">
                @if (!string.IsNullOrWhiteSpace(_opened.PdfPath))
                {
                    <a href="@($"/erp/delivery-note-document?id={_opened.Id}")">Open delivery-note document</a>
                }
                else
                {
                    <span>Delivery-note document is not generated yet.</span>
                }
                The document is rendered by the guarded delivery-note route; note creation uses the PHP-compatible live write path.
            </p>
            @if (!string.IsNullOrWhiteSpace(_opened.NotesExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">notes excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.NotesExcerpt</pre>
                @if (_opened.NotesLen > _opened.NotesExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.NotesExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NotesLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No notes excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Note #</th>
                            <th>Order</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.NoteNo) ? "—" : sib.NoteNo)</td>
                                <td>@(sib.OrderId > 0 ? sib.OrderId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "delivery_note_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Note #</th>
                    <th>Order</th>
                    <th>Carrier</th>
                    <th>Tracking</th>
                    <th>Status</th>
                    <th>Shipped</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_notes.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _notes)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(row.NoteNo) ? $"#{row.Id}" : row.NoteNo)</strong></td>
                            <td>@(row.OrderId > 0 ? row.OrderId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Carrier) ? "—" : row.Carrier)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.TrackingNo) ? "—" : row.TrackingNo)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td>@FormatTime(row.ShippedAt)</td>
                            <td>
                                <a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "delivery_note_id", row.Id)">Open</a>
                                @if (!string.IsNullOrWhiteSpace(row.PdfPath))
                                {
                                    <a class="btn btn-xs btn-default" href="@row.PdfPath">PDF</a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">@_message</div>
    }

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=sales&tab=delivery_notes";
    private const string _listHref = "/erp/delivery-notes-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpDeliveryNoteDigest> _notes = [];
    private IReadOnlyList<ErpDimensionCatalog> _dimensionCatalog = [];
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpDeliveryNoteDetail? _opened;
    private IReadOnlyList<ErpDeliveryNoteDigest> _openedSiblings = [];

    private IReadOnlyList<string> DeliveryWorkspaceTabs =>
        ["General", "Delivery", "Tracking", "Lines", "Financial"];

    private IReadOnlyList<ErpDocumentWorkspaceField> DeliveryWorkspaceFields => _opened is null
        ? []
        : [
            new("Note id", _opened.Id.ToString(CultureInfo.InvariantCulture), "General"),
            new("Note number", string.IsNullOrWhiteSpace(_opened.NoteNo) ? "—" : _opened.NoteNo, "General"),
            new("Source order", FormatId(_opened.OrderId), "Operational"),
            new("Carrier", string.IsNullOrWhiteSpace(_opened.Carrier) ? "—" : _opened.Carrier, "Delivery"),
            new("Tracking", string.IsNullOrWhiteSpace(_opened.TrackingNo) ? "—" : _opened.TrackingNo, "Delivery"),
            new("Shipped", FormatTime(_opened.ShippedAt), "Delivery"),
            new("Delivered", FormatTime(_opened.DeliveredAt), "Delivery"),
            new("Document", string.IsNullOrWhiteSpace(_opened.PdfPath) ? "Not generated" : "Available", "Financial")
        ];

    private RenderFragment? DeliveryHeaderActions => _isAdmin
        ? @<div>
            <strong>Delivery-note lifecycle</strong>
            <form method="post" action="/erp/ajax/delivery-note-create">
                <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
                <label>Order <input type="number" name="order_id" min="1" required /></label>
                <label>Carrier <input type="text" name="carrier" maxlength="128" /></label>
                <label>Tracking <input type="text" name="tracking_no" maxlength="128" /></label>
                <label>Notes <input type="text" name="notes" maxlength="4000" /></label>
                @foreach (var dimension in _dimensionCatalog)
                {
                    <label>@dimension.Label
                        <select name="dim[@dimension.Key]" style="min-width:10rem">
                            <option value="0">— none —</option>
                            @foreach (var option in dimension.Options)
                            {
                                <option value="@option.Id">@option.Code · @option.Name</option>
                            }
                        </select>
                    </label>
                }
                <label><input type="checkbox" name="mark_shipped" value="true" /> Mark shipped</label>
                <button type="submit" name="confirmWrites" value="false" class="btn btn-xs btn-default">Validate</button>
                <button type="submit" name="confirmWrites" value="true" class="btn btn-xs btn-primary">Create note</button>
            </form>
        </div>
        : null;

    private static string FormatId(long id) => id > 0
        ? id.ToString(CultureInfo.InvariantCulture)
        : "—";

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.NoteNo)
            ? _opened.NoteNo
            : ("Delivery note #" + _opened.Id.ToString(CultureInfo.InvariantCulture)));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?delivery_note_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "delivery_note_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpDeliveryNotesAsync(_limit, ctx.RequestAborted);
        _notes = result.Notes;
        _source = result.Source;
        _message = result.Message;
        _dimensionCatalog = await DimensionCatalog.LoadAsync(100, ctx.RequestAborted);

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpDeliveryNoteDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Note;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _notes.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _notes = new[] { openedList }.Concat(_notes.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
