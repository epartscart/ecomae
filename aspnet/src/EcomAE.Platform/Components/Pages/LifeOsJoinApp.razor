@page "/lifeos/join"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.LifeOs.Clients
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ILifeOsClientDirectory Directory

<PageTitle>LifeOS™ · Join & install companion</PageTitle>
<PhpSurfaceHead Surface="lifeos" />
<PhpChromeBodyClass Surface="lifeos" />
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<link rel="manifest" href="@EcomAeRoutes.LifeOsManifest" />
<meta name="theme-color" content="#2563eb" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<style>@((MarkupString)_css)</style>
<HeadContent>
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<link rel="manifest" href="@EcomAeRoutes.LifeOsManifest" />
<meta name="theme-color" content="#2563eb" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="ecomae-chrome-surface" content="lifeos-join" />
<style>@((MarkupString)_css)</style>
</HeadContent>

<div class="lojoin" id="lifeos-join-root"
     data-test-id="@Directory.TestClient.ClientId"
     data-test-token="@Directory.TestClient.JoinToken">
  <header class="lojoin-top">
    <div class="brand">Life<em>OS</em>™</div>
    <nav>
      <a href="@EcomAeRoutes.LifeOs">Home</a>
      <a class="is-active" href="@EcomAeRoutes.LifeOsJoin">Join</a>
      <a href="@EcomAeRoutes.LifeOsMobile">Mobile</a>
      <a href="@EcomAeRoutes.LifeOsResults">My results</a>
      <a href="@EcomAeRoutes.ControlPanelLifeOsClientsApp">CP clients</a>
    </nav>
  </header>

  <main class="lojoin-main">
    <p class="lojoin-kicker">No login required · mobile ready</p>
    <h1>Join LifeOS and install the tracking companion</h1>
    <p class="lojoin-lede">
      Create a client profile. Your AI clone uses the <strong>same name</strong> as you.
      Country and device details are captured for Control Panel. You can open
      <strong>My results</strong> anytime (discussions + tracking) with your join link — no login.
    </p>

    <form id="lojoin-form" class="lojoin-form" action="@EcomAeRoutes.LifeOsJoin" method="post">
      <h2>Create your client</h2>
      <label>
        <span>Your name (clone uses the same name) *</span>
        <input id="lojoin-name" name="displayName" maxlength="64" required placeholder="e.g. Amina" autocomplete="name" />
      </label>
      <label>
        <span>Email (optional)</span>
        <input id="lojoin-email" name="email" type="email" placeholder="you@company.com" autocomplete="email" />
      </label>
      <label>
        <span>Country *</span>
        <select id="lojoin-country" name="country" required>
          <option value="">Select country</option>
          <option value="United Arab Emirates|AE">United Arab Emirates</option>
          <option value="Saudi Arabia|SA">Saudi Arabia</option>
          <option value="India|IN">India</option>
          <option value="Pakistan|PK">Pakistan</option>
          <option value="Egypt|EG">Egypt</option>
          <option value="Qatar|QA">Qatar</option>
          <option value="Kuwait|KW">Kuwait</option>
          <option value="Bahrain|BH">Bahrain</option>
          <option value="Oman|OM">Oman</option>
          <option value="United States|US">United States</option>
          <option value="United Kingdom|GB">United Kingdom</option>
          <option value="Germany|DE">Germany</option>
          <option value="France|FR">France</option>
          <option value="Other|XX">Other</option>
        </select>
      </label>
      <label>
        <span>City (optional)</span>
        <input id="lojoin-city" name="city" maxlength="80" placeholder="e.g. Dubai" autocomplete="address-level2" />
      </label>
      <div class="lojoin-actions">
        <button type="submit" class="primary" id="lojoin-submit">Join LifeOS</button>
        <button type="button" class="ghost" id="lojoin-test">Use test client (Amina)</button>
      </div>
      <p class="lojoin-error" id="lojoin-error" hidden role="alert"></p>
      <p class="muted" id="lojoin-status"></p>
    </form>

    <aside class="lojoin-test">
      <h2>Seeded test client</h2>
      <p><strong>@Directory.TestClient.DisplayName</strong> ↔ clone <strong>@Directory.TestClient.CloneName</strong></p>
      <p class="muted">Country: @Directory.TestClient.Country (@Directory.TestClient.CountryCode)</p>
      <a class="primary" href="/lifeos/mobile?clientId=@Directory.TestClient.ClientId&amp;token=@Directory.TestClient.JoinToken">Open test companion →</a>
      <a class="ghost" href="/lifeos/results?clientId=@Directory.TestClient.ClientId&amp;token=@Directory.TestClient.JoinToken">View test results →</a>
    </aside>

    <section class="lojoin-result" id="lojoin-result" hidden aria-live="polite">
      <h2>You're in</h2>
      <p id="lojoin-message"></p>
      <ul id="lojoin-details"></ul>
      <div class="lojoin-actions">
        <a class="primary" id="lojoin-open-companion" href="#">Open mobile companion</a>
        <a class="ghost" id="lojoin-open-results" href="#">My results</a>
        <button type="button" class="ghost" id="lojoin-install-btn">Install app</button>
      </div>
      <ol id="lojoin-next"></ol>
    </section>
  </main>
</div>

<script>
(() => {
  const KEY = 'lifeos-client-session';
  const $ = (id) => document.getElementById(id);
  const showErr = (msg) => {
    const el = $('lojoin-error');
    if (!el) return;
    el.hidden = !msg;
    el.textContent = msg || '';
  };
  const saveSession = (client) => {
    try {
      localStorage.setItem(KEY, JSON.stringify({
        clientId: client.clientId,
        token: client.joinToken,
        displayName: client.displayName,
        at: new Date().toISOString()
      }));
    } catch (_) {}
  };
  const detect = () => {
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
    const locale = navigator.language || '';
    const platform = navigator.userAgentData?.platform || navigator.platform || '';
    const source = window.matchMedia('(display-mode: standalone)').matches ? 'mobile-pwa' : ( /Mobi|Android/i.test(navigator.userAgent) ? 'mobile-web' : 'web');
    return { timeZone: tz, locale, platform, joinSource: source, userAgent: navigator.userAgent || '', referrer: document.referrer || '' };
  };
  const paintResult = (data) => {
    const box = $('lojoin-result');
    if (!box || !data || !data.ok) return;
    box.hidden = false;
    $('lojoin-message').textContent = data.message || 'Joined.';
    const c = data.client || {};
    $('lojoin-details').innerHTML =
      '<li>Client: <strong>' + (c.displayName||'') + '</strong> · clone <strong>' + (c.cloneName||'') + '</strong></li>' +
      '<li>Id: <code>' + (c.clientId||'') + '</code></li>' +
      '<li>Country: <strong>' + (c.country||c.countryCode||'—') + '</strong>' + (c.city ? ' · ' + c.city : '') + '</li>' +
      '<li>Timezone: ' + (c.timeZone||'—') + ' · Source: ' + (c.joinSource||'—') + '</li>' +
      '<li>Token saved on this device (no login required)</li>';
    $('lojoin-open-companion').href = data.companionUrl || '#';
    $('lojoin-open-results').href = data.resultsUrl || '#';
    const ol = $('lojoin-next');
    ol.innerHTML = '';
    (data.nextSteps || []).forEach((s) => {
      const li = document.createElement('li');
      li.textContent = s;
      ol.appendChild(li);
    });
    saveSession(c);
    box.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
  const join = async (payload) => {
    showErr('');
    $('lojoin-status').textContent = 'Joining…';
    $('lojoin-submit').disabled = true;
    try {
      const res = await fetch('/lifeos/join', {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'accept': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.message || data.error || ('Join failed (' + res.status + ')'));
      $('lojoin-status').textContent = 'Joined successfully.';
      paintResult(data);
    } catch (e) {
      showErr(e.message || String(e));
      $('lojoin-status').textContent = '';
    } finally {
      $('lojoin-submit').disabled = false;
    }
  };

  const bind = () => {
    const form = $('lojoin-form');
    if (!form) return;
    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const name = ($('lojoin-name').value || '').trim();
      if (!name) { showErr('Please enter your name.'); return; }
      const countryRaw = $('lojoin-country').value || '';
      if (!countryRaw) { showErr('Please select your country.'); return; }
      const [country, countryCode] = countryRaw.split('|');
      const d = detect();
      join({
        displayName: name,
        email: ($('lojoin-email').value || '').trim() || null,
        country,
        countryCode,
        city: ($('lojoin-city').value || '').trim() || null,
        timeZone: d.timeZone,
        locale: d.locale,
        platform: d.platform,
        userAgent: d.userAgent,
        referrer: d.referrer,
        joinSource: d.joinSource,
        useTestClient: false
      });
    });

    $('lojoin-test')?.addEventListener('click', () => {
      const d = detect();
      join({ useTestClient: true, timeZone: d.timeZone, locale: d.locale, platform: d.platform, userAgent: d.userAgent, joinSource: 'test' });
    });

    let deferred;
    window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); deferred = e; });
    $('lojoin-install-btn')?.addEventListener('click', async () => {
      if (deferred) { deferred.prompt(); await deferred.userChoice.catch(() => {}); deferred = null; return; }
      alert('On iPhone: Share → Add to Home Screen. On Android Chrome: menu → Install app.');
    });
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/lifeos/sw.js', { scope: '/lifeos/' }).catch(() => {});
    }
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
  else bind();
})();
</script>

@code {
    private const string _css = """
.lojoin {
  --ink:#e8eef8; --mute:#9fb0c6; --bg:#05070c; --blue:#2563eb; --cyan:#38bdf8;
  min-height:100vh; background:radial-gradient(900px 480px at 10% -10%,rgba(37,99,235,.35),transparent 55%),#05070c;
  color:var(--ink); font-family:"Sora","Segoe UI",sans-serif;
}
.lojoin-top { display:flex; justify-content:space-between; align-items:center; padding:1rem 1.25rem; border-bottom:1px solid rgba(255,255,255,.08); flex-wrap:wrap; gap:.75rem; }
.lojoin-top .brand { font-size:1.35rem; font-weight:700; }
.lojoin-top .brand em { font-style:normal; color:var(--cyan); }
.lojoin-top nav { display:flex; gap:.85rem; flex-wrap:wrap; }
.lojoin-top a { color:var(--mute); text-decoration:none; font-size:.88rem; }
.lojoin-top a.is-active, .lojoin-top a:hover { color:#fff; }
.lojoin-main { max-width:720px; margin:0 auto; padding:1.25rem 1.1rem 3rem; }
.lojoin-kicker { text-transform:uppercase; letter-spacing:.16em; font-size:.68rem; color:var(--cyan); margin:0 0 .4rem; }
.lojoin-main h1 { margin:0 0 .6rem; font-size:clamp(1.45rem,4vw,2.1rem); letter-spacing:-.02em; }
.lojoin-lede { color:var(--mute); line-height:1.55; margin:0 0 1.25rem; }
.lojoin-form, .lojoin-test, .lojoin-result {
  border:1px solid rgba(255,255,255,.1); background:rgba(255,255,255,.03); padding:1.1rem 1.15rem; border-radius:8px; margin-bottom:1rem;
}
.lojoin-form h2, .lojoin-test h2, .lojoin-result h2 { margin:0 0 .85rem; font-size:1.05rem; }
.lojoin-form label { display:block; margin-bottom:.85rem; }
.lojoin-form label span { display:block; font-size:.78rem; color:var(--mute); margin-bottom:.35rem; }
.lojoin-form input, .lojoin-form select {
  width:100%; box-sizing:border-box; padding:.8rem .85rem; border-radius:6px; border:1px solid rgba(255,255,255,.15);
  background:#0b1220; color:#fff; font:inherit; font-size:16px;
}
.lojoin-actions { display:flex; flex-wrap:wrap; gap:.55rem; margin:.5rem 0 0; }
.lojoin-actions .primary, a.primary, button.primary {
  appearance:none; border:0; background:var(--blue); color:#fff; padding:.8rem 1rem; border-radius:6px;
  font-weight:700; text-decoration:none; cursor:pointer; display:inline-flex; align-items:center;
}
.lojoin-actions .ghost, a.ghost, button.ghost {
  appearance:none; border:1px solid rgba(255,255,255,.35); background:transparent; color:#fff;
  padding:.75rem 1rem; border-radius:6px; font-weight:700; cursor:pointer; text-decoration:none; display:inline-flex; align-items:center;
}
.muted { color:var(--mute); font-size:.88rem; line-height:1.45; }
.lojoin-error { color:#fda4af; margin:.75rem 0 0; }
.lojoin-result ul, .lojoin-result ol { color:var(--mute); line-height:1.55; }
code { color:var(--cyan); font-size:.85em; word-break:break-all; }
""";
}
