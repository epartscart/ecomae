@page "/erp/coa-accounts-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav
@inject IErpDimensionLinkReadService DimensionLinks

<PageTitle>Chart of Accounts · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Chart of Accounts" BreadcrumbArea="Record to Report" BreadcrumbTab="Chart of accounts">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/coa-accounts-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Chart of Accounts" Subtitle="Create an account here. Open a row for the 280-character description excerpt, system flag, and created time." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    <ErpPhpFlash Ok="@_flashOk" Err="@_flashErr" />
    @if (_isAdmin)
    {
        <form method="post" action="@EcomAeRoutes.ErpCoaAccountsCreate" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/coa-accounts-app" />
            <label>Code <input type="text" name="code" required maxlength="32" style="width:8rem" /></label>
            <label>Name <input type="text" name="name" required maxlength="128" style="min-width:12rem" /></label>
            <label>Type
                <select name="accountType">
                    <option value="asset">Asset</option>
                    <option value="liability">Liability</option>
                    <option value="equity">Equity</option>
                    <option value="revenue">Revenue</option>
                    <option value="expense" selected>Expense</option>
                </select>
            </label>
            <label>Opening <input type="text" name="openingBalance" value="0" style="width:6rem" /></label>
            <label>Description <input type="text" name="description" maxlength="255" /></label>
            <button type="submit" class="btn btn-primary">Create account</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="COA KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_accounts.Count</div></div>
        <div class="kpi"><div class="lbl">Active in page</div><div class="val">@_active</div></div>
        <div class="kpi"><div class="lbl">Distinct account types</div><div class="val">@_types</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Code</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Code) ? "—" : _opened.Code)</dd>
                <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Name) ? "—" : _opened.Name)</dd>
                <dt>Type</dt><dd>@(string.IsNullOrWhiteSpace(_opened.AccountType) ? "—" : _opened.AccountType)</dd>
                <dt>Normal</dt><dd>@(string.IsNullOrWhiteSpace(_opened.NormalSide) ? "—" : _opened.NormalSide)</dd>
                <dt>Parent</dt><dd>@AccountLabel(_opened.ParentId)</dd>
                <dt>Opening</dt><dd>@_opened.OpeningBalance.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>System</dt><dd>@(_opened.SystemFlag ? "yes" : "no")</dd>
                <dt>Active</dt><dd>@(_opened.Active ? "yes" : "no")</dd>
                <dt>Created</dt><dd>@FormatTime(_opened.TimeCreated)</dd>
            </dl>
            <ErpDimensionLinksPanel Links="_openedDimensionLinks" />
            <p class="text-muted" style="margin:.85rem 0 0">Create a new account on this page.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.DescriptionExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">description excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.DescriptionExcerpt</pre>
                @if (_opened.DescriptionLen > _opened.DescriptionExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.DescriptionExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.DescriptionLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No description excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-type siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Type</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Code) ? "—" : sib.Code)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Name) ? "—" : sib.Name)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.AccountType) ? "—" : sib.AccountType)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "account_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-type siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Normal</th>
                    <th>Parent</th>
                    <th>Opening</th>
                    <th>Balance</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_accounts.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var a in _accounts)
                    {
                        <tr id="erp-row-@a.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(a.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(a.Code) ? $"#{a.Id}" : a.Code)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(a.Name) ? "—" : a.Name)</td>
                            <td><span class="label label-default">@a.AccountType</span></td>
                            <td>@(string.IsNullOrWhiteSpace(a.NormalSide) ? "—" : a.NormalSide)</td>
                            <td>@AccountLabel(a.ParentId)</td>
                            <td>@a.OpeningBalance.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@a.Balance.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(a.Active ? "yes" : "no")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "account_id", a.Id)">Open</a></td>
                        </tr>
                    }
                    <tr style="font-weight:600;background:#f2f6fa">
                        <td>Total</td>
                        <td colspan="4"></td>
                        <td>@_accounts.Sum(a => a.OpeningBalance).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td>@_accounts.Sum(a => a.Balance).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td colspan="2" class="text-muted">@_accounts.Count accounts</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=finance&tab=coa";
    private const string _listHref = "/erp/coa-accounts-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpCoaAccountDigest> _accounts = [];
    private int _active;
    private int _types;
    private int _limit = 200;
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private ErpCoaAccountDetail? _opened;
    private IReadOnlyList<ErpCoaAccountDigest> _openedSiblings = [];
    private IReadOnlyList<ErpDimensionLink> _openedDimensionLinks = [];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.Code)
            ? _opened.Code
            : (!string.IsNullOrWhiteSpace(_opened.Name)
                ? _opened.Name
                : ("Account #" + _opened.Id.ToString(CultureInfo.InvariantCulture))));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?account_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "account_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListErpCoaAccountsAsync(_limit, ctx.RequestAborted);
        _accounts = result.Accounts;
        _active = _accounts.Count(a => a.Active);
        _types = _accounts.Select(a => a.AccountType).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpCoaAccountDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Account;
            _openedSiblings = detail.Siblings;
            _openedDimensionLinks = await DimensionLinks.LoadAsync(
                "coa_account",
                _openedId,
                ctx.RequestAborted);
            if (_opened is not null)
            {
                var openedList = _accounts.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _accounts = new[] { openedList }.Concat(_accounts.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }

    private string AccountLabel(long accountId)
    {
        if (accountId <= 0) return "—";
        var acc = _accounts.FirstOrDefault(a => a.Id == accountId);
        if (acc is null) return accountId.ToString(CultureInfo.InvariantCulture);
        return string.IsNullOrWhiteSpace(acc.Code) ? acc.Name : $"{acc.Code} — {acc.Name}";
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
