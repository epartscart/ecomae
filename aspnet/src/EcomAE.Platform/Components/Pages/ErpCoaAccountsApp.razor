@page "/erp/coa-accounts-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Chart of Accounts · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Chart of Accounts" BreadcrumbArea="Record to Report" BreadcrumbTab="Chart of accounts">
    <style>
        .epc-coa-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#1c1917 0%,#292524 40%,#44403c 100%);
        }
        .epc-coa-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-coa-hero p { margin:0; color:#d6d3d1; max-width:42rem; font-size:.92rem; line-height:1.45; }
        .epc-coa-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-coa-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#1c1917; background:#e7e5e4;
        }
        .epc-coa-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-coa-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-coa-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-coa-kpi strong { display:block; font-size:1.45rem; font-variant-numeric:tabular-nums; }
        .epc-coa-kpi span { color:#64748b; font-size:.78rem; }
        .epc-coa-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-coa-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-coa-table th, .epc-coa-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-coa-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-coa-table a { color:#44403c; font-weight:700; text-decoration:none; }
        .epc-coa-badge { display:inline-flex; padding:.15rem .45rem; border-radius:.3rem; font-size:.72rem; font-weight:700; background:#e7e5e4; color:#292524; }
        .epc-coa-note { margin-top:1rem; padding:.75rem .9rem; background:#fafaf9; border:1px solid #d6d3d1; border-radius:.45rem; color:#44403c; font-size:.86rem; }
        @@media (max-width:900px){ .epc-coa-kpis{grid-template-columns:1fr;} }
    </style>

    <section class="epc-coa-hero">
        <img src="@LegacyPresentationAssets.EpartsCartMarkUrl" alt="ECOM AE" style="height:28px;filter:brightness(1.1)" />
        <h1>Chart of Accounts</h1>
        <p>Operational finance, inventory, and approvals for this company.</p>
        <div class="epc-coa-cta">
            <a href="@_phpTab">Open module</a>
            <a class="ghost" href="/erp/cash-accounts-app">Cash &amp; bank</a>
            <a class="ghost" href="/erp/invoices-app">Invoices</a>
            <a class="ghost" href="/erp/app">ERP dashboard</a>
        </div>
    </section>

    <div class="epc-coa-kpis" aria-label="COA KPIs">
        <div class="epc-coa-kpi"><strong>@_accounts.Count</strong><span>Shown (limit @_limit)</span></div>
        <div class="epc-coa-kpi"><strong>@_active</strong><span>Active in page</span></div>
        <div class="epc-coa-kpi"><strong>@_types</strong><span>Distinct account types</span></div>
    </div>

    <div class="epc-coa-table-wrap">
        <table class="epc-coa-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Normal</th>
                    <th>Parent</th>
                    <th>Opening</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_accounts.Count == 0)
                {
                    <tr><td colspan="8">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var a in _accounts)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(a.Code) ? $"#{a.Id}" : a.Code)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(a.Name) ? "—" : a.Name)</td>
                            <td><span class="epc-coa-badge">@a.AccountType</span></td>
                            <td>@(string.IsNullOrWhiteSpace(a.NormalSide) ? "—" : a.NormalSide)</td>
                            <td>@(a.ParentId > 0 ? a.ParentId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@a.OpeningBalance.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(a.Active ? "yes" : "no")</td>
                            <td><a href="@_phpTab">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=finance&tab=coa";
    private bool _isAdmin;
    private IReadOnlyList<ErpCoaAccountDigest> _accounts = [];
    private int _active;
    private int _types;
    private int _limit = 200;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("erp"))
        {
            Nav.NavigateTo("/erp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.ListErpCoaAccountsAsync(_limit, ctx.RequestAborted);
        _accounts = result.Accounts;
        _active = _accounts.Count(a => a.Active);
        _types = _accounts.Select(a => a.AccountType).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
        _source = result.Source;
        _message = result.Message;
    }
}
