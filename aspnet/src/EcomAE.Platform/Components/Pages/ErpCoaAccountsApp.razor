@page "/erp/coa-accounts-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Chart of Accounts · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Chart of Accounts" BreadcrumbArea="Record to Report" BreadcrumbTab="Chart of accounts">
    <PhpParityModuleBody AppPath="/erp/coa-accounts-app" IsAdmin="_isAdmin" />


    
    <PhpErpModulePageHeader Title="Chart of Accounts" Subtitle="Live shop digest. Writes stay on ERP ajax." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />


    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="COA KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_accounts.Count</div></div>
        <div class="kpi"><div class="lbl">Active in page</div><div class="val">@_active</div></div>
        <div class="kpi"><div class="lbl">Distinct account types</div><div class="val">@_types</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Normal</th>
                    <th>Parent</th>
                    <th>Opening</th>
                    <th>Balance</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_accounts.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var a in _accounts)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(a.Code) ? $"#{a.Id}" : a.Code)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(a.Name) ? "—" : a.Name)</td>
                            <td><span class="label label-default">@a.AccountType</span></td>
                            <td>@(string.IsNullOrWhiteSpace(a.NormalSide) ? "—" : a.NormalSide)</td>
                            <td>@(a.ParentId > 0 ? a.ParentId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@a.OpeningBalance.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@a.Balance.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(a.Active ? "yes" : "no")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=finance&tab=coa";
    private bool _isAdmin;
    private IReadOnlyList<ErpCoaAccountDigest> _accounts = [];
    private int _active;
    private int _types;
    private int _limit = 200;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListErpCoaAccountsAsync(_limit, ctx.RequestAborted);
        _accounts = result.Accounts;
        _active = _accounts.Count(a => a.Active);
        _types = _accounts.Select(a => a.AccountType).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
        _source = result.Source;
        _message = result.Message;
    }
}
