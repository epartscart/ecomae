@page "/cp/returns-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ICpReturnsDeskService Desk
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Returns · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<style>
    .epc-ret-actions .panel_a { display:inline-block; text-align:center; text-decoration:none; color:#333; margin-right:14px; vertical-align:top; }
    .epc-ret-actions .panel_a_img { width:48px; height:48px; margin:0 auto 4px; border-radius:8px; background:#f1f3f6; display:flex; align-items:center; justify-content:center; font-size:22px; color:#3498db; }
    .epc-ret-actions .panel_a_caption { font-size:12px; }
    .epc-ret-list .form-inline label { margin-right:4px; }
    .epc-ret-list .form-inline .form-control { display:inline-block; width:auto; vertical-align:middle; }
    .epc-ret-swatch { display:inline-block; width:14px; height:14px; margin-right:6px; vertical-align:middle; }
</style>

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Returns</div>
            <div class="panel-body epc-ret-actions">
                <a class="panel_a" href="@ListHref"><div class="panel_a_img"><i class="fa fa-search"></i></div><div class="panel_a_caption">Returns manager</div></a>
                <a class="panel_a" href="@SetupHref"><div class="panel_a_img"><i class="fa fa-exclamation-triangle"></i></div><div class="panel_a_caption">Reasons &amp; statuses</div></a>
                <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
            </div>
        </div>
    </div>

    @if (!_isAdmin)
    {
        <div class="col-lg-12"><div class="alert alert-info" role="status">Sign in with a Control Panel admin session to manage returns.</div></div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div> }

        @if (_page == "reasons_statuses")
        {
            @if (_setup is null || !_setup.Available)
            {
                <div class="col-lg-12"><div class="alert alert-warning">Returns tables unavailable: @(_setup?.Error ?? "No database")</div></div>
            }
            else
            {
                <div class="col-lg-12">
                    <div class="hpanel">
                        <div class="panel-heading hbuilt">Return process &amp; automation</div>
                        <div class="panel-body">
                            <p class="text-muted">
                                Workflow: customer requests return on <strong>Issued</strong> order lines → item moves to <strong>Request for refund</strong> → staff approves/denies against the order → item moves to Return approved / Return rejected → return request closed.
                            </p>
                            <table class="table table-condensed table-bordered" style="max-width:900px;">
                                <thead>
                                    <tr><th>Item status</th><th>Can request return</th><th>In return</th><th>Approved</th><th>Rejected</th></tr>
                                </thead>
                                <tbody>
                                @foreach (var st in _setup.ItemFlags.Where(f => f.Show))
                                {
                                    <tr>
                                        <td>@st.Label <span class="text-muted">#@st.Id</span></td>
                                        <td>@(st.CheckForReturn ? "✓" : "—")</td>
                                        <td>@(st.ForReturn ? "✓" : "—")</td>
                                        <td>@(st.CompleteReturn ? "✓" : "—")</td>
                                        <td>@(st.RejectReturn ? "✓" : "—")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                            @if (_setup.AutomationReport.Count > 0)
                            {
                                <div class="alert alert-success">@string.Join(" · ", _setup.AutomationReport)</div>
                            }
                            else
                            {
                                <div class="alert alert-info">Automation flags are already set.</div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="hpanel">
                        <div class="panel-heading hbuilt">Reasons</div>
                        <div class="panel-body">
                            <ul class="list-group">
                                @foreach (var r in _setup.Reasons)
                                {
                                    <li class="list-group-item">#@r.Id — @r.Label</li>
                                }
                            </ul>
                            <form method="post" action="@EcomAeRoutes.CpReturnAction">
                                <input type="hidden" name="action" value="add_reason" />
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="@SetupHref" />
                                <div class="form-group">
                                    <label>New reason</label>
                                    <input type="text" name="caption" class="form-control" required />
                                </div>
                                <button type="submit" class="btn btn-primary">Add reason</button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="hpanel">
                        <div class="panel-heading hbuilt">Return request statuses</div>
                        <div class="panel-body">
                            <ul class="list-group">
                                @foreach (var s in _setup.Statuses)
                                {
                                    <li class="list-group-item">
                                        <span class="epc-ret-swatch" style="background:@s.Color;"></span>
                                        #@s.Id — @s.Label
                                    </li>
                                }
                            </ul>
                            <form method="post" action="@EcomAeRoutes.CpReturnAction">
                                <input type="hidden" name="action" value="add_status" />
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="@SetupHref" />
                                <div class="form-group">
                                    <label>New status</label>
                                    <input type="text" name="caption" class="form-control" required />
                                </div>
                                <div class="form-group">
                                    <label>Color</label>
                                    <input type="color" name="color" class="form-control" value="#f5f3cc" style="max-width:120px;" />
                                </div>
                                <button type="submit" class="btn btn-primary">Add status</button>
                            </form>
                        </div>
                    </div>
                </div>
                <p class="col-lg-12"><a href="@ListHref">Back to returns list</a></p>
            }
        }
        else if (_page == "detail")
        {
            @if (_returnId < 1)
            {
                <div class="col-lg-12"><div class="alert alert-warning">Missing return_id.</div></div>
            }
            else if (_detail is null)
            {
                <div class="col-lg-12"><div class="alert alert-warning">Return #@_returnId not found.</div></div>
            }
            else
            {
                var d = _detail;
                <div class="col-lg-12">
                    <div class="hpanel">
                        <div class="panel-heading hbuilt">
                            Return #@d.Id
                            @if (d.PrimaryOrderId > 0)
                            {
                                <text> — against Order #@d.PrimaryOrderId</text>
                            }
                        </div>
                        <div class="panel-body">
                            <p><a href="@ListHref">&larr; Back to list</a></p>

                            <div class="well" style="margin-bottom:18px;">
                                <table class="table table-condensed" style="margin:0; max-width:820px;">
                                    <tbody>
                                        <tr>
                                            <th style="width:180px;">Against order</th>
                                            <td>
                                                @if (d.OrderIds.Count == 0)
                                                {
                                                    <span class="text-danger">No order linked — line items may be missing.</span>
                                                }
                                                else
                                                {
                                                    @foreach (var oid in d.OrderIds)
                                                    {
                                                        <a class="btn btn-sm btn-default" style="margin-right:6px;" href="@OrderHref(oid)" target="_blank"><i class="fa fa-file-text-o"></i> Order #@oid</a>
                                                    }
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <th>Customer</th>
                                            <td>
                                                <a href="@UserHref(d.UserId)" target="_blank">
                                                    ID @d.UserId
                                                    @if (!string.IsNullOrWhiteSpace(d.CustomerEmail)) { <text> · @d.CustomerEmail</text> }
                                                    @if (!string.IsNullOrWhiteSpace(d.CustomerPhone)) { <text> · @d.CustomerPhone</text> }
                                                </a>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th>Status</th>
                                            <td>
                                                <span class="label" style="background:@d.StatusColor; color:#222;">@d.StatusLabel</span>
                                                @if (d.ReturnComplete)
                                                {
                                                    <span class="label label-success">Complete</span>
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <th>Declared sum</th>
                                            <td>@Money(d.Sum)</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <form method="post" action="@EcomAeRoutes.CpReturnAction" id="epc-return-status-form" class="form-inline" style="margin-bottom:18px;">
                                <input type="hidden" name="action" value="set_return_status" />
                                <input type="hidden" name="return_id" value="@d.Id" />
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="@DetailHref(d.Id)" />
                                <label>Set return status</label>
                                <select name="status_id" class="form-control">
                                    @foreach (var st in d.Statuses)
                                    {
                                        <option value="@st.Id" selected="@(st.Id == d.StatusId)">@st.Label</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-primary">Update status</button>
                            </form>

                            <div class="table-responsive">
                                <table class="table table-bordered table-condensed">
                                    <thead>
                                        <tr><th>Line</th><th>Order</th><th>Part</th><th>Qty</th><th>Price</th><th>Reason</th><th>Decision</th><th>Actions</th></tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var ln in d.Lines)
                                    {
                                        <tr>
                                            <td>#@ln.Id<div class="text-muted" style="font-size:11px;">item @ln.ItemId</div></td>
                                            <td>
                                                @if (ln.OrderId > 0)
                                                {
                                                    <a href="@OrderHref(ln.OrderId)" target="_blank">#@ln.OrderId</a>
                                                }
                                                else
                                                {
                                                    <span class="text-danger">—</span>
                                                }
                                            </td>
                                            <td>@ln.Part</td>
                                            <td>@ln.Qty</td>
                                            <td>@Money(ln.Price * Math.Max(1, ln.Qty))</td>
                                            <td>
                                                @ln.ReasonLabel
                                                @if (!string.IsNullOrWhiteSpace(ln.Comment))
                                                {
                                                    <div class="text-muted" style="font-size:12px; white-space:pre-line;">@ln.Comment</div>
                                                }
                                            </td>
                                            <td><strong>@ln.Decision</strong></td>
                                            <td style="white-space:nowrap;">
                                                <form method="post" action="@EcomAeRoutes.CpReturnAction" style="display:inline;">
                                                    <input type="hidden" name="action" value="decide_line" />
                                                    <input type="hidden" name="return_id" value="@d.Id" />
                                                    <input type="hidden" name="line_id" value="@ln.Id" />
                                                    <input type="hidden" name="decide" value="1" />
                                                    <input type="hidden" name="confirmWrites" value="true" />
                                                    <input type="hidden" name="returnUrl" value="@DetailHref(d.Id)" />
                                                    <button type="submit" class="btn btn-xs btn-success epc-ret-decide" data-line="@ln.Id" data-decide="1" disabled="@(ln.ReturnSuccess == "1")">Approve</button>
                                                </form>
                                                <form method="post" action="@EcomAeRoutes.CpReturnAction" style="display:inline;">
                                                    <input type="hidden" name="action" value="decide_line" />
                                                    <input type="hidden" name="return_id" value="@d.Id" />
                                                    <input type="hidden" name="line_id" value="@ln.Id" />
                                                    <input type="hidden" name="decide" value="0" />
                                                    <input type="hidden" name="confirmWrites" value="true" />
                                                    <input type="hidden" name="returnUrl" value="@DetailHref(d.Id)" />
                                                    <button type="submit" class="btn btn-xs btn-danger epc-ret-decide" data-line="@ln.Id" data-decide="0" disabled="@(ln.ReturnSuccess == "0")">Deny</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>

                            <form method="post" action="@EcomAeRoutes.CpReturnAction" id="epc-ret-finalize-form" onsubmit="return confirm('Close this return? Approved lines move to Return approved; denied lines to Return rejected.');">
                                <input type="hidden" name="action" value="finalize_return" />
                                <input type="hidden" name="return_id" value="@d.Id" />
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="@DetailHref(d.Id)" />
                                <button type="submit" class="btn btn-success" id="epc-ret-finalize">Close return (all lines decided)</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            @if (_list is null || !_list.Available)
            {
                <div class="col-lg-12"><div class="alert alert-warning">Returns tables unavailable: @(_list?.Error ?? "No database")</div></div>
            }
            else
            {
                <div class="col-lg-12 epc-ret-list">
                    <div class="hpanel">
                        <div class="panel-heading hbuilt">Returns / refund requests</div>
                        <div class="panel-body">
                            @if (_list.AutomationReport.Count > 0)
                            {
                                <div class="alert alert-info" style="margin-bottom:12px;">
                                    <strong>Return process ready.</strong>
                                    @string.Join(" · ", _list.AutomationReport)
                                </div>
                            }
                            <p class="text-muted" style="margin-bottom:14px;">
                                Each return is tied to one or more <strong>orders</strong> through the returned line items. Open a return to approve or deny lines against that order.
                            </p>
                            <form method="get" class="form-inline" style="margin-bottom:14px;">
                                <input type="hidden" name="page" value="list" />
                                <label>Status</label>
                                <select name="status_id" class="form-control" onchange="this.form.submit()">
                                    <option value="0">All</option>
                                    @foreach (var st in _list.Statuses)
                                    {
                                        <option value="@st.Id" selected="@(st.Id == _filter.StatusId)">@st.Label</option>
                                    }
                                </select>
                                <label style="margin-left:10px;">Order ID</label>
                                <input type="number" name="order_id" class="form-control" value="@(_filter.OrderId > 0 ? _filter.OrderId.ToString(CultureInfo.InvariantCulture) : "")" placeholder="Order #" style="width:110px;" />
                                <label style="margin-left:10px;">Customer ID</label>
                                <input type="number" name="user_id" class="form-control" value="@(_filter.UserId > 0 ? _filter.UserId.ToString(CultureInfo.InvariantCulture) : "")" placeholder="User #" style="width:110px;" />
                                <button type="submit" class="btn btn-primary" style="margin-left:8px;"><i class="fa fa-filter"></i> Filter</button>
                                <a class="btn btn-default" href="@ListHref">Reset</a>
                            </form>

                            <div class="table-responsive">
                                <table class="table table-striped table-condensed">
                                    <thead>
                                        <tr><th>Return</th><th>Against order</th><th>Customer</th><th>Status</th><th>Lines</th><th>Sum</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                    @if (_list.Rows.Count == 0)
                                    {
                                        <tr><td colspan="7" class="text-muted">No return requests yet. Customers create returns from issued order lines on the storefront.</td></tr>
                                    }
                                    @foreach (var r in _list.Rows)
                                    {
                                        <tr style="background:@r.StatusColor;">
                                            <td>
                                                <strong>#@r.Id</strong>
                                                @if (r.UnreadMessages > 0)
                                                {
                                                    <span class="label label-danger" title="Unread customer messages">@r.UnreadMessages</span>
                                                }
                                            </td>
                                            <td>
                                                @if (r.OrderIds.Count == 0)
                                                {
                                                    <span class="text-danger">No order linked</span>
                                                }
                                                else
                                                {
                                                    @foreach (var oid in r.OrderIds)
                                                    {
                                                        <a href="@OrderHref(oid)" target="_blank" style="font-weight:700; margin-right:8px;">Order #@oid</a>
                                                    }
                                                }
                                            </td>
                                            <td>
                                                <a href="@UserHref(r.UserId)" target="_blank">@r.CustomerLabel</a>
                                                <div class="text-muted" style="font-size:12px;">ID @r.UserId</div>
                                            </td>
                                            <td>@r.StatusLabel</td>
                                            <td>@r.LinesCount</td>
                                            <td>@Money(r.Sum)</td>
                                            <td><a class="btn btn-xs btn-primary" href="@DetailHref(r.Id)">Open</a></td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
</PhpCpDesktopChrome>

@code {
    private const string ListHref = "/cp/returns-app";
    private const string SetupHref = "/cp/returns-app?page=reasons_statuses&action=select";

    private bool _isAdmin;
    private string _page = "list";
    private long _returnId;
    private CpReturnsFilter _filter = new(0, 0, 0, false);
    private CpReturnsList? _list;
    private CpReturnDetail? _detail;
    private CpReturnsSetup? _setup;
    private string _flashOk = "";
    private string _flashErr = "";

    private static string DetailHref(long id) => "/cp/returns-app?page=detail&return_id=" + id.ToString(CultureInfo.InvariantCulture);

    private static string OrderHref(long orderId) => "/cp/orders?order_id=" + orderId.ToString(CultureInfo.InvariantCulture);

    private static string UserHref(long userId) => "/cp/users-app?user_id=" + userId.ToString(CultureInfo.InvariantCulture);

    /// <summary>PHP <c>number_format($v, 2, '.', ' ')</c>.</summary>
    private static string Money(decimal value)
    {
        var nfi = (NumberFormatInfo)CultureInfo.InvariantCulture.NumberFormat.Clone();
        nfi.NumberGroupSeparator = " ";
        return value.ToString("#,##0.00", nfi);
    }

    private static long Long(string raw) =>
        long.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var v) && v > 0 ? v : 0;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var q = ctx.Request.Query;
        _flashOk = q["ok"].ToString() ?? "";
        _flashErr = q["err"].ToString() ?? "";
        _returnId = Long(q["return_id"].ToString());
        var page = q["page"].ToString();
        _page = page is "detail" or "reasons_statuses" ? page : "list";
        if (_returnId > 0 && _page == "list")
        {
            _page = "detail";
        }

        _filter = new CpReturnsFilter(
            (int)Long(q["status_id"].ToString()),
            Long(q["order_id"].ToString()),
            Long(q["user_id"].ToString()),
            q["read"].ToString() == "0");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        switch (_page)
        {
            case "detail":
                _detail = await Desk.DetailAsync(_returnId, ctx.RequestAborted);
                break;
            case "reasons_statuses":
                _setup = await Desk.SetupAsync(ctx.RequestAborted);
                break;
            default:
                _list = await Desk.ListAsync(_filter, ctx.RequestAborted);
                break;
        }
    }
}
