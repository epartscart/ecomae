@page "/cp/document-control-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Document Control · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Document Control
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/document-control-app")</p>
                <p>Save the company profile here. Logo upload, templates, and attachments stay Classic. This page does not invent a send.</p>
            </div>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div>
    }
    <PhpParityModuleBody AppPath="/cp/document-control-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />


    <p class="help-block">@(string.IsNullOrWhiteSpace(_summary.CompanyName) ? "—" : _summary.CompanyName) Company · @_summary.TemplateCount.ToString(CultureInfo.InvariantCulture) Templates · @_summary.AttachmentCount.ToString(CultureInfo.InvariantCulture) Attachments.</p>

    @if (_isAdmin)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Company profile</div>
                <div class="panel-body">
                    <form method="post" action="/cp/document-control/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="/cp/document-control-app" />
                        <input type="hidden" name="action" value="save_company" />
                        <input type="hidden" name="expected_version" value="0" />
                        <label>Legal name <input type="text" name="legal_name" maxlength="255" value="@_summary.CompanyName" /></label>
                        <label>Trade name <input type="text" name="trade_name" maxlength="255" /></label>
                        <label>Address <input type="text" name="address_line1" maxlength="255" /></label>
                        <label>Address 2 <input type="text" name="address_line2" maxlength="255" /></label>
                        <label>City <input type="text" name="city" maxlength="120" /></label>
                        <label>Country <input type="text" name="country" maxlength="80" value="United Arab Emirates" /></label>
                        <label>TRN <input type="text" name="trn" maxlength="32" /></label>
                        <label>Phone <input type="text" name="phone" maxlength="64" /></label>
                        <label>Email <input type="text" name="email" maxlength="120" /></label>
                        <label>Website <input type="text" name="website" maxlength="120" /></label>
                        <label>Bank <input type="text" name="bank_name" maxlength="120" /></label>
                        <label>IBAN <input type="text" name="bank_iban" maxlength="64" /></label>
                        <label>Footer <input type="text" name="legal_footer" /></label>
                        <button type="submit" class="btn btn-primary btn-sm">Save company</button>
                    </form>
                    <p class="help-block" style="margin:.75rem 0 0">Logo upload stays Classic.</p>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Code</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Active</th>
                    <th>Sort</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_templates.Count == 0)
                {
                    <tr><td colspan="7">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var t in _templates)
                    {
                        <tr>
                            <td><strong>@t.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(t.Code) ? "—" : t.Code)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.Title) ? "—" : t.Title)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.Category) ? "—" : t.Category)</td>
                            <td>@(t.Active ? "yes" : "no")</td>
                            <td>@t.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/document_control/document_control";
    private bool _isAdmin;
    private CpDocumentControlSummary _summary = new("", 0, 0, "n/a", "");
    private IReadOnlyList<CpDocumentTemplateDigest> _templates = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpDocumentControlDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _templates = result.Templates;
        _source = result.Source;
        _message = result.Message;
    }
}
