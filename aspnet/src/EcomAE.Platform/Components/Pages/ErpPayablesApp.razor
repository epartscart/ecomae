@page "/erp/payables-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Payables · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Payables" BreadcrumbArea="Accounts payable" BreadcrumbTab="Payables">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/payables-app" IsAdmin="_isAdmin" />


    <PhpErpModulePageHeader Title="Payables"
                            Subtitle="Supplier balances, ledger settlement, TRN excerpt, and currency. Sensitive contact and bank details stay omitted."
                            PhpTabHref="@_phpTab">
        <a class="btn btn-sm btn-default" href="/erp/purchases-app">Purchases</a>
        <a class="btn btn-sm btn-default" href="/erp/suppliers-app">Suppliers</a>
        <a class="btn btn-sm btn-default" href="/erp/payment-batches-app">Payment batches</a>
    </PhpErpModulePageHeader>
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="/erp/payables-app" />

    @if (_isAdmin)
    {
        <form method="post" action="@EcomAeRoutes.ErpSupplierSettlement" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="returnUrl" value="/erp/payables-app" />
            <label>Supplier ID <input type="number" name="supplier_id" min="1" required style="width:6rem" value="@(_openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : null)" /></label>
            <label>Amount <input type="text" name="amount" required placeholder="0.00" /></label>
            <label>Direction
                <select name="direction">
                    <option value="decrease">decrease payable</option>
                    <option value="increase">increase payable</option>
                </select>
            </label>
            <label>Kind
                <select name="entry_kind">
                    <option value="settlement">settlement</option>
                    <option value="adjustment">adjustment</option>
                    <option value="write_off">write-off</option>
                </select>
            </label>
            <label>Reference <input type="text" name="reference" maxlength="120" /></label>
            <label>Note <input type="text" name="note" maxlength="255" /></label>
            <button type="submit" name="confirmWrites" value="false" class="btn btn-sm btn-default">Validate settlement</button>
            <button type="submit" name="confirmWrites" value="true" class="btn btn-sm btn-primary">Post supplier settlement</button>
        </form>
    }

    @if (_openedDetail is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="/erp/payables-app">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Supplier id</dt><dd>@_openedDetail.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.Name) ? "—" : _openedDetail.Name)</dd>
                <dt>Storage</dt><dd>@(_openedDetail.StorageId > 0 ? _openedDetail.StorageId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Currency</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.CurrencyCode) ? "—" : _openedDetail.CurrencyCode)</dd>
                <dt>Created</dt><dd>@FormatTime(_openedDetail.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Email, phone, and bank details stay omitted from this operational view.</p>
            <p class="text-muted">Settlement validates first, then posts a tenant-scoped supplier ledger entry when confirmed.</p>
            @if (!string.IsNullOrWhiteSpace(_openedDetail.TrnExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">TRN excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedDetail.TrnExcerpt</pre>
                @if (_openedDetail.TrnLen > _openedDetail.TrnExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_openedDetail.TrnExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedDetail.TrnLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No TRN excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-currency siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Supplier</th><th class="text-right">Balance</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Name) ? "—" : sib.Name)</td>
                                <td class="text-right">@sib.Balance.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href("/erp/payables-app", "supplier_id", sib.Id)">Ledger</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-currency siblings yet.</p>
            }
            @if (_openedPurchases.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Recent supplier bills</p>
                <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Date</th><th>Invoice</th><th>Status</th><th class="text-right">Total</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var bill in _openedPurchases)
                        {
                            <tr>
                                <td>@FormatTime(bill.PurchaseDate)</td>
                                <td>@(string.IsNullOrWhiteSpace(bill.InvoiceNumber) ? "—" : bill.InvoiceNumber)</td>
                                <td>@(string.IsNullOrWhiteSpace(bill.Status) ? "—" : bill.Status)</td>
                                <td class="text-right">@bill.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href("/erp/purchases-app", "purchase_id", bill.Id)">Open bill</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted" style="margin:1rem 0 0">No recent bills found for this supplier.</p>
            }
            @if (_openedPayments.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Recent supplier payments</p>
                <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Date</th><th>Voucher</th><th>Reference</th><th>Status</th><th class="text-right">Amount</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var payment in _openedPayments)
                        {
                            <tr>
                                <td>@FormatTime(payment.TimeUnix)</td>
                                <td>@(string.IsNullOrWhiteSpace(payment.VoucherNumber) ? "—" : payment.VoucherNumber)</td>
                                <td>@(string.IsNullOrWhiteSpace(payment.Reference) ? "—" : payment.Reference)</td>
                                <td>@(payment.IsAdvance ? "Advance" : payment.AllocationCount > 0 ? $"{payment.AllocationCount} bill(s) allocated" : "On account")</td>
                                <td class="text-right">@payment.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href("/erp/cash-entries-app", "entry_id", payment.Id)">Open payment</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted" style="margin:1rem 0 0">No recent supplier payments found.</p>
            }
            @if (_openedLedger.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Supplier statement</p>
                <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Date</th><th>Direction</th><th class="text-right">Amount</th><th>Kind</th><th>Reference</th><th>Purchase</th><th>Cash entry</th></tr></thead>
                    <tbody>
                        @foreach (var entry in _openedLedger)
                        {
                            <tr>
                                <td>@FormatTime(entry.TimeUnix)</td>
                                <td>@(entry.IsCredit ? "Credit" : "Debit")</td>
                                <td class="text-right">@entry.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@(string.IsNullOrWhiteSpace(entry.EntryKind) ? "—" : entry.EntryKind)</td>
                                <td>@(string.IsNullOrWhiteSpace(entry.Reference) ? "—" : entry.Reference)</td>
                                <td>@(entry.PurchaseId > 0 ? entry.PurchaseId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                                <td>@(entry.CashEntryId > 0 ? entry.CashEntryId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="text-muted" style="margin:.7rem 0 0">Source: PHP <code>epc_erp_supplier_accounting</code>; inactive rows are excluded.</p>
            }
            else
            {
                <p class="text-muted" style="margin:1rem 0 0">No active supplier ledger entries found.</p>
            }
        </div>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Payables KPIs">
        <div class="kpi"><div class="lbl">Suppliers shown</div><div class="val">@_suppliers.Count</div></div>
        <div class="kpi"><div class="lbl">With open balance</div><div class="val">@_openBalance</div></div>
        <div class="kpi"><div class="lbl">Payable total</div><div class="val">@_totalBalance.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Supplier</th>
                    <th>Storage ID</th>
                    <th>Payable balance</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_suppliers.Count == 0)
                {
                    <tr><td colspan="4">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var s in _suppliers)
                    {
                        <tr id="erp-row-@s.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(s.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(s.Name) ? $"#{s.Id}" : s.Name)</strong></td>
                            <td>@(s.StorageId > 0 ? s.StorageId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><span class="label label-default">@s.Balance.ToString("N2", CultureInfo.InvariantCulture)</span></td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href("/erp/payables-app", "supplier_id", s.Id)">Ledger</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-note alert alert-info" style="margin-top:12px;">
        Matches ERP menu <strong>Payables</strong> (Accounts payable). Source: @_source.
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=ap&tab=payables";
    private bool _isAdmin;
    private IReadOnlyList<ErpSupplierDigest> _suppliers = [];
    private int _openBalance;
    private decimal _totalBalance;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpSupplierDigest? _openedSupplier;
    private ErpSupplierDetail? _openedDetail;
    private IReadOnlyList<ErpSupplierDigest> _openedSiblings = [];
    private IReadOnlyList<ErpPurchaseDigest> _openedPurchases = [];
    private IReadOnlyList<ErpSupplierPaymentDigest> _openedPayments = [];
    private IReadOnlyList<ErpSupplierLedgerEntry> _openedLedger = [];

    private bool OpenedFound => _openedDetail is not null || _openedSupplier is not null;

    private string OpenedReturnHref => _openedId > 0
        ? "/erp/payables-app?supplier_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : "/erp/payables-app";

    private string OpenedCaption => _openedDetail is not null
        ? (string.IsNullOrWhiteSpace(_openedDetail.Name) ? ("Supplier #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.Name)
            + (string.IsNullOrWhiteSpace(_openedDetail.CurrencyCode) ? "" : (" · " + _openedDetail.CurrencyCode))
        : _openedSupplier is null
            ? ""
            : (string.IsNullOrWhiteSpace(_openedSupplier.Name) ? $"Supplier #{_openedSupplier.Id}" : _openedSupplier.Name);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "supplier_id");
        var result = await Dashboards.ListErpSuppliersAsync(_limit, ctx.RequestAborted);
        _suppliers = result.Suppliers;
        _openedSupplier = _openedId > 0 ? _suppliers.FirstOrDefault(s => s.Id == _openedId) : null;
        if (_openedSupplier is not null)
        {
            _suppliers = new[] { _openedSupplier }.Concat(_suppliers.Where(s => s.Id != _openedId)).ToList();
        }
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpSupplierDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Supplier;
            _openedSiblings = detail.Siblings;
            _openedPurchases = detail.Purchases;
            _openedPayments = detail.Payments;
            _openedLedger = detail.Ledger;
            if (_openedDetail is null && !string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
        _openBalance = _suppliers.Count(s => s.Balance != 0m);
        _totalBalance = _suppliers.Sum(s => s.Balance);
        _source = result.Source;
        if (string.IsNullOrWhiteSpace(_message))
        {
            _message = result.Message;
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
