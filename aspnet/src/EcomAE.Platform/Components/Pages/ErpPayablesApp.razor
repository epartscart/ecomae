@page "/erp/payables-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Payables · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Payables" BreadcrumbArea="Accounts payable" BreadcrumbTab="Payables">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/payables-app" IsAdmin="_isAdmin" />


    <PhpErpModulePageHeader Title="Payables"
                            Subtitle="Supplier payable balances — vendor invoices owed for this company workspace."
                            PhpTabHref="@_phpTab">
        <a class="btn btn-sm btn-default" href="/erp/purchases-app">Purchases</a>
        <a class="btn btn-sm btn-default" href="/erp/suppliers-app">Suppliers</a>
        <a class="btn btn-sm btn-default" href="/erp/payment-batches-app">Payment batches</a>
    </PhpErpModulePageHeader>
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedSupplier is not null)" Caption="@OpenedCaption" ListHref="/erp/payables-app" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Payables KPIs">
        <div class="kpi"><div class="lbl">Suppliers shown</div><div class="val">@_suppliers.Count</div></div>
        <div class="kpi"><div class="lbl">With open balance</div><div class="val">@_openBalance</div></div>
        <div class="kpi"><div class="lbl">Payable total</div><div class="val">@_totalBalance.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Supplier</th>
                    <th>Storage ID</th>
                    <th>Payable balance</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_suppliers.Count == 0)
                {
                    <tr><td colspan="4">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var s in _suppliers)
                    {
                        <tr id="erp-row-@s.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(s.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(s.Name) ? $"#{s.Id}" : s.Name)</strong></td>
                            <td>@(s.StorageId > 0 ? s.StorageId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><span class="label label-default">@s.Balance.ToString("N2", CultureInfo.InvariantCulture)</span></td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href("/erp/payables-app", "supplier_id", s.Id)">Ledger</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-note alert alert-info" style="margin-top:12px;">
        Matches ERP menu <strong>Payables</strong> (Accounts payable). Source: @_source.
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=ap&tab=payables";
    private bool _isAdmin;
    private IReadOnlyList<ErpSupplierDigest> _suppliers = [];
    private int _openBalance;
    private decimal _totalBalance;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpSupplierDigest? _openedSupplier;
    private string OpenedCaption => _openedSupplier is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedSupplier.Name) ? $"Supplier #{_openedSupplier.Id}" : _openedSupplier.Name);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "supplier_id");
        var result = await Dashboards.ListErpSuppliersAsync(_limit, ctx.RequestAborted);
        _suppliers = result.Suppliers;
        _openedSupplier = _openedId > 0 ? _suppliers.FirstOrDefault(s => s.Id == _openedId) : null;
        if (_openedSupplier is not null)
        {
            _suppliers = new[] { _openedSupplier }.Concat(_suppliers.Where(s => s.Id != _openedId)).ToList();
        }
        _openBalance = _suppliers.Count(s => s.Balance != 0m);
        _totalBalance = _suppliers.Sum(s => s.Balance);
        _source = result.Source;
        _message = result.Message;
    }
}
