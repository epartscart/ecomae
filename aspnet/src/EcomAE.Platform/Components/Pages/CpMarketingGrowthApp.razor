@page "/cp/marketing-growth-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Marketing growth · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-mg-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-mg-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-mg-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-mg-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-mg-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#14532d; background:#dcfce7;
        }
        .epc-mg-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-mg-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-mg-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-mg-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-mg-kpi span { color:#64748b; font-size:.78rem; }
        .epc-mg-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-mg-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-mg-table th, .epc-mg-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-mg-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-mg-note { margin-top:1rem; padding:.75rem .9rem; background:#f0fdf4; border:1px solid #86efac; border-radius:.45rem; color:#14532d; font-size:.86rem; }
        @@media (max-width:900px){ .epc-mg-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-mg-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Marketing growth</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-mg-cta">
            <a href="@_phpTab">Open module</a>
        </div>
    </section>

    <div class="epc-mg-kpis" aria-label="Marketing growth stats">
        <div class="epc-mg-kpi"><strong>@_summary.TaskCount.ToString(CultureInfo.InvariantCulture)</strong><span>Tasks</span></div>
        <div class="epc-mg-kpi"><strong>@_summary.TasksDone.ToString(CultureInfo.InvariantCulture)</strong><span>Done</span></div>
        <div class="epc-mg-kpi"><strong>@_summary.KpiLogCount.ToString(CultureInfo.InvariantCulture)</strong><span>KPI logs</span></div>
        <div class="epc-mg-kpi"><strong>@_summary.ReviewCount.ToString(CultureInfo.InvariantCulture)</strong><span>Reviews</span></div>
    </div>

    <div class="epc-mg-table-wrap">
        <table class="epc-mg-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Strategy</th>
                    <th>Type</th>
                    <th>Score</th>
                    <th>By</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="7">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.StrategyKey) ? row.StrategyKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ReviewType) ? row.ReviewType : "—")</td>
                            <td>@row.Score.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CreatedBy.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CreatedAt.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@_phpTab">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/marketing/marketing";
    private bool _isAdmin;
    private CpMarketingGrowthSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpMarketingGrowthReviewDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpMarketingGrowthDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Reviews;
        _source = result.Source;
        _message = result.Message;
    }
}
