@page "/cp/marketing-growth-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Marketing growth · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Marketing growth
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/marketing-growth-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/marketing-growth-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_summary.TaskCount.ToString(CultureInfo.InvariantCulture) Tasks · @_summary.TasksDone.ToString(CultureInfo.InvariantCulture) Done · @_summary.KpiLogCount.ToString(CultureInfo.InvariantCulture) KPI logs · @_summary.ReviewCount.ToString(CultureInfo.InvariantCulture) Reviews.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Strategy</th>
                    <th>Type</th>
                    <th>Score</th>
                    <th>By</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="7">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.StrategyKey) ? row.StrategyKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ReviewType) ? row.ReviewType : "—")</td>
                            <td>@row.Score.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CreatedBy.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CreatedAt.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/marketing/marketing";
    private bool _isAdmin;
    private CpMarketingGrowthSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpMarketingGrowthReviewDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpMarketingGrowthDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Reviews;
        _source = result.Source;
        _message = result.Message;
    }
}
