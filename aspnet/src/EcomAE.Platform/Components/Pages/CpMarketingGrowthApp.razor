@page "/cp/marketing-growth-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Marketing growth · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Marketing growth
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/marketing-growth-app")</p>
                <p>Open a review for a short notes excerpt and other reviews on the same strategy. Task and KPI writes stay on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/marketing-growth-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedReview is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Marketing growth KPIs">
        <div class="kpi"><div class="lbl">Reviews</div><div class="val">@_summary.ReviewCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Tasks</div><div class="val">@_summary.TaskCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Done</div><div class="val">@_summary.TasksDone.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Opened siblings</div><div class="val">@_openedSiblings.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedReview is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedReview.StrategyKey) ? _openedReview.StrategyKey : ("Review #" + _openedReview.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedReview.ReviewType) ? _openedReview.ReviewType : "—")</span>
                </div>
                <div class="panel-body">
                    <p>Score @_openedReview.Score.ToString(CultureInfo.InvariantCulture)
                        · by @_openedReview.CreatedBy.ToString(CultureInfo.InvariantCulture)
                        · @_openedReview.CreatedAt.ToString(CultureInfo.InvariantCulture)</p>
                    @if (!string.IsNullOrWhiteSpace(_openedReview.NotesExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedReview.NotesExcerpt</pre>
                        @if (_openedReview.NotesLen > _openedReview.NotesExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_openedReview.NotesExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedReview.NotesLen.ToString(CultureInfo.InvariantCulture) chars). Full notes stay on the Classic twin.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No notes excerpt yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Strategy siblings</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Type</th>
                                    <th>Score</th>
                                    <th>By</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="5">No strategy siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.ReviewType) ? sib.ReviewType : "—")</td>
                                            <td>@sib.Score.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@sib.CreatedBy.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@sib.CreatedAt.ToString(CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Strategy</th>
                    <th>Type</th>
                    <th>Score</th>
                    <th>By</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.StrategyKey) ? row.StrategyKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ReviewType) ? row.ReviewType : "—")</td>
                            <td>@row.Score.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CreatedBy.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CreatedAt.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "review_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/marketing/marketing";
    private const string _listHref = "/cp/marketing-growth-app";
    private bool _isAdmin;
    private CpMarketingGrowthSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpMarketingGrowthReviewDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private CpMarketingGrowthReviewDetail? _openedReview;
    private IReadOnlyList<CpMarketingGrowthReviewDigest> _openedSiblings = [];

    private string OpenedCaption => _openedReview is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedReview.StrategyKey)
            ? ("Review #" + _openedReview.Id.ToString(CultureInfo.InvariantCulture))
            : _openedReview.StrategyKey)
            + (string.IsNullOrWhiteSpace(_openedReview.ReviewType) ? "" : (" · " + _openedReview.ReviewType));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "review_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpMarketingGrowthDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Reviews;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpMarketingGrowthReviewDetailAsync(_openedId, ctx.RequestAborted);
            _openedReview = detail.Review;
            _openedSiblings = detail.Siblings;
            if (_openedReview is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
