@page "/storefront/quotes-app"
@page "/en/shop/quotes"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>My quotes · eParts Cart</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        
        .epc-sf-q-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-sf-q-cta a {
            display:inline-flex; padding:.5rem .85rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#fff; background:#dc2626;
        }
        .epc-sf-q-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); }
        .epc-sf-q-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-sf-q-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-sf-q-table th, .epc-sf-q-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; }
        .epc-sf-q-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; }
        .epc-sf-q-table a { color:#b91c1c; font-weight:700; text-decoration:none; }
        .epc-sf-q-gate { padding:1.25rem; background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; }
        .epc-sf-q-note { margin-top:1rem; padding:.75rem .9rem; background:#fff8e8; border:1px solid #f1d49a; border-radius:.45rem; color:#7a4e00; font-size:.86rem; }
    
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<PhpStorefrontDesktopChrome>

    <PhpStorefrontPageHeader Title="My quotes"
                            Subtitle="Customer quote requests — submit and accept remain on the classic quotes module.">
        <a class="btn btn-sm btn-primary" href="@StorefrontPhpCanonical.Quotes">Open classic quotes</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Cart">Cart</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.PartSearch">Search parts</a>
    </PhpStorefrontPageHeader>

    @if (!_isCustomer)
    {
        <div class="epc-sf-q-gate">
            <p style="margin:0 0 .75rem;color:#334155">Sign in with your customer account to view quote requests.</p>
            <a href="/storefront/login" style="display:inline-flex;padding:.55rem .9rem;border-radius:.4rem;background:#dc2626;color:#fff;font-weight:700;text-decoration:none">Sign in</a>
        </div>
    }
    else
    {
        <div class="epc-sf-q-table-wrap">
            <table class="epc-sf-q-table">
                <thead>
                    <tr>
                        <th>Quote</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Updated</th>
                        <th>Items</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_rows.Count == 0)
                    {
                        <tr><td colspan="6">No quote requests yet. Add lines from part search, then open classic quotes to submit.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in _rows)
                        {
                            <tr>
                                <td><strong>#@row.Id</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(row.Status) ? "—" : row.Status)</td>
                                <td>@FormatUnix(row.TimeCreated)</td>
                                <td>@FormatUnix(row.TimeUpdated)</td>
                                <td>@row.ItemCount</td>
                                <td>
                                    <a href="@StorefrontSurfaceLinks.ForQuote(row.Id)">ASP.NET</a>
                                    ·
                                    <a href="@(StorefrontPhpCanonical.Quotes + "?id=" + row.Id.ToString(CultureInfo.InvariantCulture))">PHP detail</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_detail is not null)
        {
            <h2 style="margin:1.1rem 0 .55rem;font-size:1.05rem">Quote #@_detail.Id — lines</h2>
            <div class="epc-sf-q-table-wrap">
                <table class="epc-sf-q-table">
                    <thead>
                        <tr>
                            <th>Brand</th>
                            <th>Article</th>
                            <th>Name</th>
                            <th>Qty</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_detail.Items.Count == 0)
                        {
                            <tr><td colspan="5">No lines on this quote.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in _detail.Items)
                            {
                                <tr>
                                    <td>@(string.IsNullOrWhiteSpace(item.Manufacturer) ? "—" : item.Manufacturer)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Article) ? "—" : item.Article)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Name) ? "—" : item.Name)</td>
                                    <td>@item.CountNeed.ToString("0.###", CultureInfo.InvariantCulture)</td>
                                    <td>@item.Price.ToString("N2", CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="epc-sf-q-cta" style="margin-top:.75rem">
                <a href="@(StorefrontPhpCanonical.Quotes + "?id=" + _detail.Id.ToString(CultureInfo.InvariantCulture))">Submit / accept on classic module</a>
            </div>
        }

        <p class="epc-sf-q-note">
            Read-only digest (<code>@_source</code>). Submit/accept/add-item writes stay PHP-authoritative
            (<code>ajax_quote_submit</code> / <code>ajax_quote_accept</code> / dry-run gates on ASP.NET).
        </p>
    }
</PhpStorefrontDesktopChrome>

@code {
    private bool _isCustomer;
    private IReadOnlyList<StorefrontQuoteDigest> _rows = [];
    private StorefrontQuoteDetailDigest? _detail;
    private string _source = "n/a";

    [SupplyParameterFromQuery(Name = "id")]
    public int? QuoteId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Customer || session.UserId <= 0)
        {
            _isCustomer = false;
            return;
        }

        _isCustomer = true;
        var list = await Dashboards.ListStorefrontQuotesAsync(session.UserId, 100, ctx.RequestAborted);
        _rows = list.Rows;
        _source = list.Source;

        if (QuoteId is > 0)
        {
            _detail = await Dashboards.GetStorefrontQuoteAsync(session.UserId, QuoteId.Value, ctx.RequestAborted);
        }
    }

    private static string FormatUnix(long unix)
    {
        if (unix <= 0)
        {
            return "—";
        }

        return DateTimeOffset.FromUnixTimeSeconds(unix).UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC";
    }
}
