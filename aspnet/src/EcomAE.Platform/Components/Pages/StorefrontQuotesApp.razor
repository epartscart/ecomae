@page "/storefront/quotes-app"
@page "/en/shop/quotes"
@page "/shop/quotes"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject IHttpContextAccessor Http
@inject EcomAE.Platform.Data.ITenantDbConnectionFactory Connections
@inject Microsoft.Extensions.Options.IOptions<EcomAE.Platform.Configuration.PhpReferenceOptions> PhpReference
@inject IWebHostEnvironment Env
@*
  PHP twin: content/shop/order_process/my_quotes.php (StorefrontMyQuotes). Submit and accept post to the ported
  ajax_quote_submit.php / ajax_quote_accept.php endpoints.
*@

<PageTitle>My quotes · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" />

<StorefrontTenantChrome>
    <section style="padding:2rem 0 3rem">
        <div class="container">
            <script>window.jQuery || document.write('<script src="/lib/jQuery/jQuery.js"><\/script>');</script>
            @((MarkupString)_html)
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private string _html = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);
        var tenant = ctx.Items[EcomAE.Platform.Middleware.TenantResolutionMiddleware.HttpContextItemKey] as EcomAE.Platform.Services.TenantContext;
        var config = EcomAE.Platform.Cp.PriceImport.CpPhpConfig.Read(PhpReference.Value);
        var cookies = ctx.Request.Cookies;
        var lang = StorefrontPhpHomeLinks.LangHref(ctx);
        try
        {
            await using var connection = await Connections.OpenForTenantAsync(tenant, ctx.RequestAborted);
            var access = new ErpUserAccess.Cookies(cookies["session"], cookies["u_id"], cookies["admin_session"], cookies["admin_u_id"]);
            var userId = await ErpUserAccess.UserIdAsync(connection, access, ctx.RequestAborted);
            var adminId = await ErpUserAccess.AdminIdAsync(connection, access, ctx.RequestAborted);
            var loginForm = string.Empty;
            Func<int, string> t = _ => string.Empty;
            if (userId <= 0 && adminId <= 0)
            {
                (loginForm, t) = await StorefrontLoginFormLoader.RenderGeneralAsync(
                    ctx,
                    connection,
                    Connections,
                    PhpReference.Value,
                    Env,
                    new StorefrontLoginFormLoader.Request(0, lang, cookies["session"], cookies["u_id"], cookies["epc_oauth_last_google_email"], config),
                    StorefrontMyQuotes.LoginFormPostfix,
                    null,
                    [StorefrontMyQuotes.LoginTextStringId],
                    ctx.RequestAborted);
            }

            var input = new StorefrontMyQuotes.Input(
                userId,
                adminId,
                ctx.Request.Query.TryGetValue("id", out var id) ? UmapiImageProxy.PhpIntCast(id.ToString()) : 0,
                lang,
                config.TryGetValue("backend_dir", out var backend) ? backend : "cp",
                config.TryGetValue("currency_show_mode", out var mode) ? mode : "sign_before",
                config.TryGetValue("shop_currency", out var shop) ? shop : null,
                cookies["epc_currency"],
                cookies["epc_country"],
                loginForm);
            _html = await StorefrontMyQuotes.RenderAsync(connection, input, t, StorefrontMyQuotes.PhpDate, ctx.RequestAborted);
        }
        catch (System.Data.Common.DbException)
        {
            _html = "<p>Quotes are unavailable right now.</p>";
        }
        catch (InvalidOperationException)
        {
            _html = "<p>Quotes are unavailable right now.</p>";
        }
    }
}
