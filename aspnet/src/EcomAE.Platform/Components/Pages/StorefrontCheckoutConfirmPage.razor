@page "/en/shop/checkout/confirm"
@page "/shop/checkout/confirm"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject IHttpContextAccessor Http
@inject ILegacySessionValidator Sessions
@inject IStorefrontGuestSessionService Guests
@inject EcomAE.Platform.Data.ITenantDbConnectionFactory Connections
@inject Microsoft.Extensions.Options.IOptions<EcomAE.Platform.Configuration.PhpReferenceOptions> PhpReference
@inject IWebHostEnvironment Env
@inject NavigationManager Nav
@inject ILogger<StorefrontCheckoutConfirmPage> Log

<PageTitle>Confirm order · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" />

<StorefrontTenantChrome>
    <section style="padding:2rem 0 3rem">
        <div class="container">
            <script>window.jQuery || document.write('<script src="/lib/jQuery/jQuery.js"><\/script>');</script>
            @((MarkupString)_html)
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private string _html = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);
        var tenant = ctx.Items[EcomAE.Platform.Middleware.TenantResolutionMiddleware.HttpContextItemKey] as EcomAE.Platform.Services.TenantContext;
        var config = EcomAE.Platform.Cp.PriceImport.CpPhpConfig.Read(PhpReference.Value);
        var langHref = StorefrontPhpHomeLinks.LangHref(ctx);
        try
        {
            var session = await Sessions.ValidateCustomerAsync(ctx, ctx.RequestAborted);
            var shopper = session.Kind == LegacySessionKind.Customer && session.UserId > 0
                ? new StorefrontShopper(session.UserId, 0, session.SessionId ?? "", false)
                : await Guests.ResolveAsync(ctx, createIfMissing: false, ctx.RequestAborted);
            await using var connection = await Connections.OpenForTenantAsync(tenant, ctx.RequestAborted);
            var translator = new StorefrontPhpTranslator(connection, langHref.TrimStart('/'));
            var csrf = await CsrfAsync(connection, shopper.SessionToken, ctx.RequestAborted);
            var tradeMessage = shopper.IsSignedIn
                ? await EpcCustomerTrade.CheckoutBlockMessageAsync(connection, null, shopper.UserId, ctx.RequestAborted)
                : string.Empty;
            ctx.Request.Cookies.TryGetValue("how_get", out var howGetCookie);
            var root = PhpReference.Value.PhpDocRoot;
            if (string.IsNullOrWhiteSpace(root))
            {
                root = Env.ContentRootPath;
            }

            string C(string key, string fallback) =>
                config.TryGetValue(key, out var value) && !string.IsNullOrEmpty(value) ? value : fallback;
            bool HandlerExists(string handler) =>
                File.Exists(Path.Combine(root!, "content", "shop", "obtaining_modes", handler, "show_details.php"));

            var input = new StorefrontCheckoutConfirm.Input(
                shopper.UserId,
                shopper.SessionRecordId,
                csrf,
                langHref,
                C("shop_currency", ""),
                C("currency_show_mode", "no"),
                EpcObtainModes.UnescapeCookie(howGetCookie ?? ""),
                tradeMessage.Length > 0,
                tradeMessage);
            var result = await StorefrontCheckoutConfirm.RenderAsync(
                connection,
                input,
                key => translator.TextAsync(key, ctx.RequestAborted),
                HandlerExists,
                (handler, caption, preparedJson) => StorefrontObtainModeViews.ShowDetailsAsync(
                    connection,
                    translator,
                    handler,
                    caption,
                    preparedJson,
                    langHref.TrimStart('/'),
                    ctx.RequestAborted),
                () => StorefrontCheckoutConfirm.RenderComplementaryPartsAsync(
                    connection,
                    shopper.UserId,
                    shopper.UserId > 0 ? 0 : shopper.SessionRecordId,
                    langHref,
                    ctx.RequestAborted),
                ctx.RequestAborted);
            if (result.RedirectLocation is not null)
            {
                Nav.NavigateTo(result.RedirectLocation, forceLoad: true);
                return;
            }

            if (result.IsJson)
            {
                ctx.Response.ContentType = "application/json; charset=utf-8";
            }
            _html = result.Html;
        }
        catch (System.Data.Common.DbException ex)
        {
            Log.LogWarning(ex, "Checkout confirm page query failed");
            _html = "<p>Checkout confirmation is unavailable right now.</p>";
        }
        catch (InvalidOperationException ex)
        {
            Log.LogWarning(ex, "Checkout confirm page render failed");
            _html = "<p>Checkout confirmation is unavailable right now.</p>";
        }
    }

    private static async Task<string> CsrfAsync(System.Data.Common.DbConnection connection, string token, CancellationToken cancellationToken)
    {
        if (string.IsNullOrEmpty(token))
        {
            return string.Empty;
        }
        try
        {
            return await ErpDb.StringAsync(
                connection,
                null,
                ErpDb.Positional("SELECT IFNULL(`csrf_guard_key`,'') FROM `sessions` WHERE `session` = ? LIMIT 1"),
                cancellationToken,
                token).ConfigureAwait(false) ?? string.Empty;
        }
        catch (System.Data.Common.DbException)
        {
            return string.Empty;
        }
    }
}
