@page "/cp/prices-upload-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Prices upload · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
    .epc-cpmod-hero {
        margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
        background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
    }
    .epc-cpmod-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
    .epc-cpmod-hero p { margin:0; color:rgba(255,255,255,.9); max-width:46rem; font-size:.92rem; line-height:1.45; }
    .epc-cpmod-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
    .epc-cpmod-cta a {
        display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
        text-decoration:none; color:#0f172a; background:#fff;
    }
    .epc-cpmod-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
    .epc-cpmod-note { margin-top:1rem; padding:.75rem .9rem; background:#eff6ff; border:1px solid #93c5fd; border-radius:.45rem; color:#1e3a8a; font-size:.86rem; }
</style>
</HeadContent>

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-cpmod-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Prices upload</h1>
        <p>Mark a price list session complete here (last updated + row count). File extract, CSV import, and sitemap refresh stay on the compare twin.</p>
        <div class="epc-cpmod-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/cp/prices-edit-app">Prices edit</a>
            <a class="ghost" href="/cp/price-lists-app">Price lists</a>
            <a class="ghost" href="/cp/bulk-upload-app">Bulk upload</a>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/prices/complete-session" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/prices-upload-app" />
            <label>Price list id <input type="number" name="priceId" min="1" required style="width:7rem" /></label>
            <button type="submit">Complete session</button>
        </form>
    }

    <div class="epc-cpmod-note">
        Prepare, extract, convert, and CSV import stay on the compare twin. This page only stamps last_updated and records_count.
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/prices_upload";
    private bool _isAdmin;
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
    }
}
