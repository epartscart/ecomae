@page "/cp/prices-upload-app"
@page "/cp/shop/prices"
@page "/cp/shop/prices_upload"
@page "/cp/shop/prices/upload"
@page "/cp/shop/prices/multivendor"
@page "/cp/shop/prices/review"
@page "/cp/shop/prices/price"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Cp.PriceImport
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ILegacySessionValidator Sessions
@inject ICpCsrfGuard Csrf
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject IErpWriteConnectionFactory TenantDb
@inject IHttpContextAccessor Http

<PageTitle>Price lists · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
    <link rel="stylesheet" href="/epc-static.php?f=cp/content/shop/prices_upload/epc_prices_cp.css&amp;v=20260904ways" />
    <style>
        .epc-prices-page { --epc-p-ink:#0f172a; --epc-p-muted:#64748b; --epc-p-line:#e2e8f0; --epc-p-soft:#f8fafc; }
        .epc-prices-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-prices-kpi { background:#fff; border:1px solid var(--epc-p-line); border-radius:.55rem; padding:.85rem .9rem; }
        .epc-prices-kpi strong { display:block; font-size:1.2rem; }
        .epc-prices-kpi span { color:var(--epc-p-muted); font-size:.78rem; }
        .epc-prices-ways { display:grid; grid-template-columns:repeat(auto-fill,minmax(15rem,1fr)); gap:.65rem; margin:0 0 1rem; }
        .epc-price-way { display:block; text-decoration:none; background:#fff; border:1px solid var(--epc-p-line); border-radius:.55rem; padding:.75rem .85rem; color:inherit; }
        .epc-price-way:hover { border-color:#93c5fd; box-shadow:0 4px 14px rgba(37,99,235,.12); }
        .epc-price-way.is-active { border-color:#2563eb; box-shadow:0 0 0 2px rgba(37,99,235,.15); }
        .epc-price-way i { color:#2563eb; margin-right:.35rem; }
        .epc-price-way strong { display:block; margin:.2rem 0 .25rem; }
        .epc-price-way p { margin:0; color:var(--epc-p-muted); font-size:.8rem; line-height:1.4; }
        .epc-prices-toolbar { display:flex; flex-wrap:wrap; gap:.5rem; margin:0 0 1rem; }
        .epc-prices-toolbar a { display:inline-flex; align-items:center; gap:.4rem; padding:.5rem .75rem; border-radius:.45rem; background:#fff; border:1px solid var(--epc-p-line); text-decoration:none; color:#0f172a; font-weight:700; font-size:.82rem; }
        .epc-prices-table-wrap { background:#fff; border:1px solid var(--epc-p-line); border-radius:.55rem; overflow:auto; }
        .epc-prices-table { width:100%; border-collapse:collapse; font-size:.84rem; }
        .epc-prices-table th, .epc-prices-table td { padding:.5rem .65rem; border-bottom:1px solid #f1f5f9; text-align:left; vertical-align:top; }
        .epc-prices-table th { background:#f8fafc; color:#475569; font-size:.72rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-prices-dl { display:grid; grid-template-columns:10rem 1fr; gap:.4rem .75rem; background:#fff; border:1px solid var(--epc-p-line); border-radius:.55rem; padding:1rem; }
        .epc-prices-dl dt { color:#64748b; font-size:.78rem; }
        .epc-prices-dl dd { margin:0; font-weight:600; }
        .epc-prices-note { margin-top:1rem; padding:.75rem .9rem; background:#eff6ff; border:1px solid #93c5fd; border-radius:.45rem; color:#1e3a8a; font-size:.86rem; }
        .epc-price-hist-cell { min-width:9rem; }
        .epc-price-hist-meta { display:block; margin-top:.2rem; font-size:.72rem; color:#64748b; max-width:11rem; word-break:break-all; }
        .epc-price-hist-link { display:inline-block; margin-top:.25rem; font-size:.75rem; font-weight:700; }
        .epc-hist-row-active { background:#ecfdf5; }
        .epc-prices-empty { padding:1.1rem; color:#64748b; }
        .epc-price-wh-empty { color:#94a3b8; font-style:italic; }
        .epc-prices-flash-ok { margin:0 0 1rem; padding:.7rem .9rem; border-radius:.4rem; background:#ecfdf5; color:#065f46; }
        .epc-prices-flash-err { margin:0 0 1rem; padding:.7rem .9rem; border-radius:.4rem; background:#fef2f2; color:#991b1b; }
        .epc-prices-complete { display:flex; flex-wrap:wrap; gap:.4rem; align-items:end; margin:0 0 1rem; }
        @@media (max-width:900px){ .epc-prices-kpis{grid-template-columns:1fr;} .epc-prices-dl{grid-template-columns:1fr;} }
    </style>
</HeadContent>

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="epc-prices-page" data-epc-prices-ssr="1">
        <div class="epc-prices-toolbar" role="navigation" aria-label="Price list tools">
            <a href="/cp/shop/prices"><i class="fa fa-list"></i> Price lists</a>
            <a href="/cp/shop/prices/price"><i class="fa fa-plus"></i> Add list</a>
            <a href="/cp/prices-edit-app"><i class="fa fa-pencil"></i> Prices edit</a>
            <a href="/cp/shop/prices/multivendor"><i class="fa fa-sitemap"></i> Multi-vendor</a>
            <a href="/cp/shop/prices/guide"><i class="fa fa-book"></i> Upload guide</a>
            <a href="/cp/prices-upload-app#epc-upload-history"><i class="fa fa-history"></i> Upload history</a>
            <a href="/cp/price-lists-app"><i class="fa fa-tags"></i> Commerce lists</a>
            <a href="/cp">Command centre</a>
        </div>

        @if (!string.IsNullOrWhiteSpace(_flashOk))
        {
            <div class="epc-prices-flash-ok" role="status">@_flashOk</div>
        }
        @if (!string.IsNullOrWhiteSpace(_flashErr))
        {
            <div class="epc-prices-flash-err" role="status">@_flashErr</div>
        }

        <div class="epc-prices-kpis" aria-label="Price upload stats">
            <div class="epc-prices-kpi"><strong>@_summary.ActiveLists.ToString(CultureInfo.InvariantCulture)</strong><span>Docpart price lists</span></div>
            <div class="epc-prices-kpi"><strong>@_summary.PriceRows.ToString(CultureInfo.InvariantCulture)</strong><span>Warehouse offer rows</span></div>
            <div class="epc-prices-kpi"><strong>@_summary.UploadCount.ToString(CultureInfo.InvariantCulture)</strong><span>Upload history</span></div>
        </div>

        @if (_isAdmin)
        {
            <form method="post" action="/cp/prices/complete-session" class="epc-prices-complete">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/prices-upload-app" />
                <label>Price list id <input type="number" name="priceId" min="1" required style="width:7rem" /></label>
                <button type="submit">Complete session</button>
            </form>
        }

        @if (_view != "price")
        {
            <h2 style="margin:0 0 .55rem;font-size:1.05rem;">Upload ways</h2>
            <div class="epc-prices-ways" aria-label="All price upload ways">
                @foreach (var way in CpPricesUploadWaysCatalog.All)
                {
                    <a class="epc-price-way @(_way == way.Key ? "is-active" : null)" href="@way.Href">
                        <i class="fa @way.Icon" aria-hidden="true"></i>
                        <strong>@way.Label</strong>
                        <p>@way.Hint</p>
                    </a>
                }
            </div>
        }

        @if (_isAdmin && _view == "wizard")
        {
            <h2 style="margin:0 0 .55rem;font-size:1.05rem;">Column-mapping wizard</h2>
            <form method="post" action="@EcomAeRoutes.CpPricesUploadFile" enctype="multipart/form-data" class="epc-prices-complete">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                <input type="hidden" name="channel" value="wizard" />
                <input type="hidden" name="returnUrl" value="@WizardReturn" />
                <label>Price list id <input type="number" name="price_id" min="1" required value="@(_detail?.Id.ToString(CultureInfo.InvariantCulture) ?? "")" style="width:7rem" /></label>
                <label>Skip rows <input type="number" name="strings_to_left" min="0" value="1" style="width:5rem" /></label>
                <label>Brand col <input type="number" name="manufacturer_col" min="0" value="1" style="width:4rem" /></label>
                <label>Article col <input type="number" name="article_col" min="1" value="2" style="width:4rem" /></label>
                <label>Name col <input type="number" name="name_col" min="0" value="3" style="width:4rem" /></label>
                <label>Qty col <input type="number" name="exist_col" min="0" value="4" style="width:4rem" /></label>
                <label>Price col <input type="number" name="price_col" min="1" value="5" style="width:4rem" /></label>
                <label>Days col <input type="number" name="time_to_exe_col" min="0" value="6" style="width:4rem" /></label>
                <label>Encoding <input type="text" name="encoding" value="auto" style="width:6rem" /></label>
                <label>Separator <input type="text" name="separator" value=";" maxlength="8" style="width:4rem" /></label>
                <label>File name contains <input type="text" name="file_name_substring" value="@(_detail?.FileNameSubstring ?? "")" style="width:8rem" /></label>
                <label class="epc-price-action epc-price-action--pc">Price file
                    <input type="file" name="price_file" accept=".csv,.txt,.xls,.xlsx" required />
                </label>
                <button type="submit">Import with this column map</button>
            </form>
            <p class="help-block">Same column numbers as PHP ajax_5: 1-based file columns saved on the list, then the file is imported. Header rows are skipped.</p>
        }

        @if (_isAdmin && _way == "cron")
        {
            <h2 style="margin:0 0 .55rem;font-size:1.05rem;">Scheduled update</h2>
            <form method="post" action="@EcomAeRoutes.CpPricesCronTasks" class="epc-prices-complete">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                <input type="hidden" name="action" value="save" />
                <input type="hidden" name="returnUrl" value="/cp/prices-upload-app?way=cron" />
                <label>Price list ids <input type="text" name="prices" required placeholder="9104,9106" style="width:10rem" /></label>
                <label>Active
                    <select name="active"><option value="1" selected>yes</option><option value="0">no</option></select>
                </label>
                <label>Days <input type="text" name="days" value="1,2,3,4,5,6,7" style="width:10rem" /></label>
                <label>Time <input type="text" name="time" value="08:15" placeholder="HH:MM" style="width:6rem" /></label>
                <button type="submit">Save schedule</button>
            </form>
            <p class="help-block">The minute job is GET /cp/prices/cron-tick?key=tech_key&amp;wait=1. It imports every linked FTP, e-mail or URL list that is due.</p>
        }

        @if (_view == "guide")
        {
            <div class="epc-prices-note">
                Upload guide: <a href="/cp/guides-app?g=prices-upload">/cp/guides-app?g=prices-upload</a>.
                PC and the column wizard post to <code>/cp/prices/upload-file</code>.
                FTP, e-mail and URL post to <code>/cp/prices/update-now</code>.
                Schedules post to <code>/cp/prices/cron-tasks</code>; the minute tick is <code>/cp/prices/cron-tick?key=</code>.
                Deploy API is <code>POST /api/prices/deploy-upload</code> (tech_key + price_file).
            </div>
        }
        else if (_view == "multivendor")
        {
            <div class="epc-prices-note">
                Multi-vendor ingest is PHP <code>ajax_epc_multivendor_ingest</code>
                (<code>cp/content/shop/prices_upload/for_multivendor/form.php</code>).
                Drop a combined Excel/CSV there. File ingest stay Classic.
            </div>
            @if (_isAdmin)
            {
                <form method="post" action="/cp/multivendor/min-price-acl/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="/cp/shop/prices/multivendor" />
                    <label>Restrict min prices
                        <select name="restrict">
                            <option value="1" selected>yes</option>
                            <option value="0">no</option>
                        </select>
                    </label>
                    <label>Group ids <input type="text" name="group_ids" placeholder="2,5" style="width:10rem" /></label>
                    <label>User ids <input type="text" name="user_ids" placeholder="12,18" style="width:10rem" /></label>
                    <button type="submit">Save min-price access</button>
                </form>
                <form method="post" action="/cp/multivendor/vendor-code/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="/cp/shop/prices/multivendor" />
                    <label>Warehouse id <input type="number" name="storage_id" min="1" required style="width:7rem" /></label>
                    <label>Vendor code <input type="text" name="vendor_code" maxlength="64" required /></label>
                    <label>Vendor name <input type="text" name="vendor_full" maxlength="255" /></label>
                    <button type="submit">Save vendor code</button>
                </form>
                <p class="help-block" style="margin:0 0 1rem">File ingest stay Classic. This page does not invent a send.</p>
            }
        }
        else if (_view == "price")
        {
            <h2 style="margin:0 0 .55rem;font-size:1.05rem;">@( _detail is null ? "Add price list" : ("Edit list · " + _detail.Name) )</h2>
            @if (_detail is null)
            {
                <div class="epc-prices-note">
                    Creating a list writes to <code>shop_docpart_prices</code> via PHP <code>price.php</code>.
                    This console is read-only. Use the live PHP manager to add FTP / e-mail / URL credentials.
                </div>
            }
            else
            {
                <dl class="epc-prices-dl" data-epc-price-detail="@_detail.Id.ToString(CultureInfo.InvariantCulture)">
                    <dt>ID</dt><dd>@_detail.Id.ToString(CultureInfo.InvariantCulture)</dd>
                    <dt>Name</dt><dd>@_detail.Name</dd>
                    <dt>Mode</dt><dd>@_detail.LoadModeLabel</dd>
                    <dt>Warehouse</dt><dd>@_detail.Warehouses</dd>
                    <dt>Updated</dt><dd>@(string.IsNullOrWhiteSpace(_detail.LastUpdated) ? "—" : _detail.LastUpdated)</dd>
                    <dt>Rows</dt><dd>@_detail.RecordsCount.ToString(CultureInfo.InvariantCulture)</dd>
                    <dt>FTP host</dt><dd>@(string.IsNullOrWhiteSpace(_detail.FtpHost) ? "—" : _detail.FtpHost)</dd>
                    <dt>FTP user</dt><dd>@(string.IsNullOrWhiteSpace(_detail.FtpUser) ? "—" : _detail.FtpUser)</dd>
                    <dt>FTP folder</dt><dd>@(string.IsNullOrWhiteSpace(_detail.FtpFolder) ? "—" : _detail.FtpFolder)</dd>
                    <dt>Sender e-mail</dt><dd>@(string.IsNullOrWhiteSpace(_detail.SenderEmail) ? "—" : _detail.SenderEmail)</dd>
                    <dt>Subject contains</dt><dd>@(string.IsNullOrWhiteSpace(_detail.MessageHeaderSubstring) ? "—" : _detail.MessageHeaderSubstring)</dd>
                    <dt>Filename contains</dt><dd>@(string.IsNullOrWhiteSpace(_detail.FileNameSubstring) ? "—" : _detail.FileNameSubstring)</dd>
                    <dt>URL</dt><dd>@(string.IsNullOrWhiteSpace(_detail.Link) ? "—" : _detail.Link)</dd>
                    <dt>Encoding / separator</dt><dd>@(string.IsNullOrWhiteSpace(_detail.Encoding) ? "UTF-8" : _detail.Encoding) / @(string.IsNullOrWhiteSpace(_detail.Separator) ? ";" : _detail.Separator)</dd>
                </dl>
                <div class="epc-price-actions" style="margin-top:.75rem;">
                    <form method="post" action="@EcomAeRoutes.CpPricesUploadFile" enctype="multipart/form-data">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                        <input type="hidden" name="channel" value="pc" />
                        <input type="hidden" name="returnUrl" value="/cp/prices-upload-app" />
                        <input type="hidden" name="price_id" value="@_detail.Id.ToString(CultureInfo.InvariantCulture)" />
                        <label class="epc-price-action epc-price-action--pc">
                            <i class="fa fa-desktop"></i> PC file
                            <input type="file" name="@($"file_{_detail.Id}")" accept=".csv,.txt,.xls,.xlsx,.zip,.rar,.7z,.tar" style="display:none" onchange="this.form.submit()" />
                        </label>
                    </form>
                    <form method="post" action="/cp/prices/complete-session" style="display:inline">
                        <input type="hidden" name="priceId" value="@_detail.Id.ToString(CultureInfo.InvariantCulture)" />
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="/cp/prices-upload-app" />
                        <button type="submit" class="epc-price-action">Complete</button>
                    </form>
                    <form method="post" action="@EcomAeRoutes.CpPricesUpdateNow" style="display:inline">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                        <input type="hidden" name="price_id" value="@_detail.Id.ToString(CultureInfo.InvariantCulture)" />
                        <input type="hidden" name="returnUrl" value="/cp/prices-upload-app" />
                        <button type="submit" class="epc-price-action epc-price-action--ftp">FTP</button>
                        <button type="submit" class="epc-price-action epc-price-action--email">E-mail</button>
                        <button type="submit" class="epc-price-action epc-price-action--url">URL</button>
                    </form>
                    <a class="epc-price-action" href="@CpPricesUploadWaysCatalog.WizardHref(_detail.Id)">Wizard</a>
                    <a class="epc-price-action" href="@CpPricesUploadWaysCatalog.ReviewHref(_detail.Id)">Review</a>
                </div>
                <div class="epc-prices-note">
                    PC upload and Update now write warehouse rows here. FTP host, mailbox and URL are the values saved on this list.
                </div>
            }
        }

        @if (_isAdmin && _view != "guide")
        {
            <form method="post" action="/cp/prices/storefront-storage/toggle" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/prices-upload-app" />
                <label>Entity
                    <select name="entity_type">
                        <option value="storage" selected>warehouse</option>
                        <option value="price_list">price list</option>
                    </select>
                </label>
                <label>Id <input type="number" name="entity_id" min="1" required style="width:7rem" /></label>
                <label>Storefront
                    <select name="storefront_enabled">
                        <option value="1" selected>on</option>
                        <option value="0">off</option>
                    </select>
                </label>
                <button type="submit">Save storefront visibility</button>
            </form>
            <p class="help-block" style="margin:0 0 1rem">File import, scheduled update and storefront visibility save on this page.</p>
        }

        @if (_view != "price")
        {
            <h2 style="margin:1rem 0 .55rem;font-size:1.05rem;">Price lists</h2>
            <div class="epc-prices-table-wrap">
                <table class="epc-prices-table footable table table-hover" id="prices_table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Warehouse</th>
                            <th>Updated</th>
                            <th>Rows</th>
                            <th class="text-left">Update file / history</th>
                            <th class="text-left">Manual update</th>
                            <th class="text-left">Auto-update</th>
                            <th class="text-left">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!_isAdmin)
                        {
                            <tr><td colspan="9" class="epc-prices-empty">Sign in with a Control Panel admin session to load live price lists.</td></tr>
                        }
                        else if (_lists.Count == 0)
                        {
                            <tr><td colspan="9" class="epc-prices-empty">No Docpart price lists in this shop digest. Add a list, then upload via PC / FTP / e-mail / URL. Source: @_source</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _lists)
                            {
                                var editHref = CpPricesUploadWaysCatalog.EditListHref(row.Id);
                                <tr data-epc-price-id="@row.Id.ToString(CultureInfo.InvariantCulture)">
                                    <td><a href="@editHref">@row.Id.ToString(CultureInfo.InvariantCulture)</a></td>
                                    <td><a href="@editHref">@row.Name</a></td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(row.Warehouses) || row.Warehouses == "—")
                                        {
                                            <a href="@editHref"><span class="epc-price-wh-empty">Not linked</span></a>
                                        }
                                        else
                                        {
                                            <a href="@editHref">@row.Warehouses</a>
                                        }
                                    </td>
                                    <td><a id="@($"last_updated_{row.Id}")" href="@editHref">@(string.IsNullOrWhiteSpace(row.LastUpdated) ? "—" : row.LastUpdated)</a></td>
                                    <td><a id="@($"records_count_{row.Id}")" href="@editHref">@row.RecordsCount.ToString(CultureInfo.InvariantCulture)</a></td>
                                    <td class="text-left epc-price-hist-cell">
                                        @{
                                            var latest = LatestFor(row.Id);
                                        }
                                        @if (latest is null)
                                        {
                                            <a class="epc-price-action" href="@HistoryHref("export_db", row.Id, 0)" title="Export current DB prices">DB export</a>
                                            <span class="epc-price-hist-meta">No archive yet</span>
                                        }
                                        else if (latest.HasFile)
                                        {
                                            <a class="epc-price-action" href="@HistoryHref("download_latest", row.Id, 0)" title="Download active upload file">Download</a>
                                            <span class="epc-price-hist-meta">@latest.File<br />@latest.Created</span>
                                        }
                                        else
                                        {
                                            <a class="epc-price-action" href="@HistoryHref("export_db", row.Id, 0)" title="Archive missing — export current DB">DB export</a>
                                            <span class="epc-price-hist-meta">@latest.File<br />archive missing</span>
                                        }
                                        <a class="epc-price-hist-link" href="@("/cp/prices-upload-app?hist=" + row.Id.ToString(CultureInfo.InvariantCulture) + "#epc-upload-history")">Upload history</a>
                                    </td>
                                    <td class="text-left">
                                        <div class="epc-price-actions">
                                            <form method="post" action="@EcomAeRoutes.CpPricesUploadFile" enctype="multipart/form-data" style="display:inline;">
                                                <input type="hidden" name="confirmWrites" value="true" />
                                                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                                                <input type="hidden" name="channel" value="pc" />
                                                <input type="hidden" name="returnUrl" value="/cp/prices-upload-app" />
                                                <input type="hidden" name="price_id" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                                <label class="epc-price-action epc-price-action--pc" title="Upload from PC">
                                                    <i class="fa fa-desktop"></i> PC
                                                    <input type="file" name="@($"file_{row.Id}")" accept=".csv,.txt,.xls,.xlsx,.zip,.rar,.7z,.tar" style="display:none" onchange="this.form.submit()" />
                                                </label>
                                            </form>
                                            <form method="post" action="@EcomAeRoutes.CpPricesUpdateNow" style="display:inline">
                                                <input type="hidden" name="confirmWrites" value="true" />
                                                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                                                <input type="hidden" name="price_id" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                                <input type="hidden" name="returnUrl" value="/cp/prices-upload-app" />
                                                <button type="submit" class="epc-price-action epc-price-action--ftp">FTP</button>
                                                <button type="submit" class="epc-price-action epc-price-action--email">E-mail</button>
                                                <button type="submit" class="epc-price-action epc-price-action--url">URL</button>
                                            </form>
                                        </div>
                                    </td>
                                    <td class="text-left">
                                        <a class="epc-price-action" href="/cp/prices-upload-app?way=cron">@row.LoadModeLabel cron</a>
                                    </td>
                                    <td class="text-left">
                                        <div class="epc-price-actions">
                                            <form method="post" action="/cp/prices/complete-session" style="display:inline">
                                                <input type="hidden" name="priceId" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                                <input type="hidden" name="confirmWrites" value="true" />
                                                <input type="hidden" name="returnUrl" value="/cp/prices-upload-app" />
                                                <button type="submit" class="epc-price-action">Complete</button>
                                            </form>
                                            <a class="epc-price-action" href="@CpPricesUploadWaysCatalog.WizardHref(row.Id)">Wizard</a>
                                            <a class="epc-price-action" href="@CpPricesUploadWaysCatalog.ReviewHref(row.Id)">Review</a>
                                            <a class="epc-price-action" href="@editHref">Edit</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_isAdmin)
        {
            <h2 id="epc-upload-history" style="margin:1.25rem 0 .55rem;font-size:1.05rem;">Upload history</h2>
            @if (!string.IsNullOrWhiteSpace(_historyMessage))
            {
                <div class="epc-prices-flash-err" role="status">@_historyMessage</div>
            }
            <p class="help-block" style="margin:0 0 .55rem;">
                Archived source files from <code>/cp/prices/upload-file</code>, <code>/cp/prices/update-now</code>, cron and <code>/api/prices/deploy-upload</code>.
                Downloads use <code>/cp/prices/upload-history</code>.
                @if (_historyPriceId > 0)
                {
                    <a href="/cp/prices-upload-app#epc-upload-history">Show every list</a>
                }
            </p>
            <div class="epc-prices-table-wrap">
                <table class="epc-prices-table" id="epc_price_upload_history">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Price list</th>
                            <th>Source</th>
                            <th>File</th>
                            <th>Imported</th>
                            <th>Skipped</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_history.Count == 0)
                        {
                            <tr><td colspan="9" class="epc-prices-empty">No upload history yet. Upload a CSV on a list to archive it here.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in _history)
                            {
                                <tr class="@(item.Active ? "epc-hist-row-active" : null)">
                                    <td>@item.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@item.Created</td>
                                    <td>@item.PriceName (#@item.PriceId.ToString(CultureInfo.InvariantCulture))</td>
                                    <td>@SourceLabel(item.Source)</td>
                                    <td>
                                        @item.File
                                        @if (item.Active)
                                        {
                                            <span class="epc-price-hist-meta">ACTIVE</span>
                                        }
                                    </td>
                                    <td>@item.Imported.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@item.Skipped.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@item.Status</td>
                                    <td>
                                        @if (item.HasFile)
                                        {
                                            <a href="@HistoryHref("download", 0, item.Id)">Download</a>
                                        }
                                        else
                                        {
                                            <a href="@HistoryHref("export_db", item.PriceId, 0)">DB export</a>
                                        }
                                        @if (item.Skipped > 0 || item.Status is "partial" or "failed")
                                        {
                                            <a href="@HistoryHref("download_skipped", 0, item.Id)">Skipped</a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="epc-prices-note">
            Uploaded amounts are supplier purchase. Storefront customer price = purchase + group markup
            (<code>shop_offices_storages_map</code>). Staff with <code>for_percentage</code> see purchase under the sell price.
            PC, wizard, FTP, e-mail, URL and cron write here. Complete session and storefront toggle save here.
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private bool _isAdmin;
    private string _csrf = "";
    private string _way = "";
    private string _view = "";
    private string _source = "migration";
    private string _flashOk = "";
    private string _flashErr = "";
    private CpPriceListsSummary _summary = new(0, 0, 0, "migration", "");
    private IReadOnlyList<CpDocpartPriceListDigest> _lists = [];
    private CpDocpartPriceListDetail? _detail;
    private IReadOnlyList<UploadHistoryRow> _history = [];
    private Dictionary<long, UploadHistoryRow> _latestByList = [];
    private string _historyMessage = "";
    private long _historyPriceId;

    private string HistoryHref(string action, long priceId, long historyId)
    {
        var csrf = Uri.EscapeDataString(_csrf);
        if (action == "download" || action == "download_skipped")
        {
            return "/cp/prices/upload-history?action=" + action
                   + "&history_id=" + historyId.ToString(CultureInfo.InvariantCulture)
                   + "&csrf_guard_key=" + csrf;
        }

        return "/cp/prices/upload-history?action=" + action
               + "&price_id=" + priceId.ToString(CultureInfo.InvariantCulture)
               + "&csrf_guard_key=" + csrf;
    }

    private UploadHistoryRow? LatestFor(long priceId)
        => _latestByList.TryGetValue(priceId, out var row) ? row : null;

    private static string SourceLabel(string source) => source switch
    {
        "cp_wizard" => "CP wizard",
        "pyprices_upload" => "PC upload",
        "pyprices_ftp" => "FTP",
        "pyprices_email" => "E-mail",
        "pyprices_url" => "URL",
        "deploy_api" => "Deploy API",
        "deploy_reupload" => "Deploy reupload",
        _ => string.IsNullOrWhiteSpace(source) ? "—" : source,
    };

    private string WizardReturn
        => _detail is null
            ? "/cp/shop/prices/upload"
            : "/cp/shop/prices/upload?price_id=" + _detail.Id.ToString(CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (_isAdmin)
        {
            _csrf = await Csrf.KeyForAsync(ctx, session, ctx.RequestAborted);
        }

        var path = ctx.Request.Path.Value ?? "";
        if (path.Contains("/multivendor", StringComparison.OrdinalIgnoreCase))
        {
            _view = "multivendor";
            _way = "multivendor";
        }
        else if (path.Contains("/guide", StringComparison.OrdinalIgnoreCase))
        {
            _view = "guide";
        }
        else if (path.Contains("/prices/upload", StringComparison.OrdinalIgnoreCase))
        {
            _view = "wizard";
            _way = "wizard";
        }
        else if (path.Contains("/review", StringComparison.OrdinalIgnoreCase))
        {
            _view = "review";
            _way = "review";
        }
        else if (path.EndsWith("/price", StringComparison.OrdinalIgnoreCase)
                 || path.Contains("/prices/price", StringComparison.OrdinalIgnoreCase))
        {
            _view = "price";
            _way = "edit";
        }

        var qWay = ctx.Request.Query["way"].ToString();
        if (!string.IsNullOrWhiteSpace(qWay))
        {
            _way = qWay;
        }

        if (long.TryParse(ctx.Request.Query["hist"].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var histId) && histId > 0)
        {
            _historyPriceId = histId;
        }

        if (!_isAdmin)
        {
            return;
        }

        await LoadUploadHistoryAsync(ctx.RequestAborted);

        var digest = await Dashboards.BuildCpDocpartPriceListsDigestAsync(200, ctx.RequestAborted);
        _summary = digest.Summary;
        _lists = digest.Lists;
        _source = digest.Source;

        if ((_view is "price" or "wizard")
            && long.TryParse(ctx.Request.Query["price_id"].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var priceId)
            && priceId > 0)
        {
            _detail = await Dashboards.BuildCpDocpartPriceListDetailAsync(priceId, ctx.RequestAborted);
        }
    }

    private async Task LoadUploadHistoryAsync(CancellationToken cancellationToken)
    {
        if (!TenantDb.IsConfigured)
        {
            _historyMessage = "Upload history needs the tenant shop database.";
            return;
        }

        try
        {
            await using var connection = await TenantDb.OpenAsync(cancellationToken);
            await CpPriceUploadHistory.EnsureSchemaAsync(connection, cancellationToken);
            var rows = await CpPriceUploadHistory.ListAsync(connection, _historyPriceId, 40, cancellationToken);
            var latest = await CpPriceUploadHistory.LatestPerListAsync(connection, cancellationToken);
            _history = rows.Select(MapHistory).ToList();
            _latestByList = latest
                .Select(MapHistory)
                .GroupBy(row => row.PriceId)
                .ToDictionary(group => group.Key, group => group.First());
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _historyMessage = "Upload history could not be loaded.";
        }
    }

    private static UploadHistoryRow MapHistory(IReadOnlyDictionary<string, object?> row)
    {
        static long LongOf(IReadOnlyDictionary<string, object?> source, string key)
            => long.TryParse(CpPriceUploadHistory.Text(source, key), NumberStyles.Integer, CultureInfo.InvariantCulture, out var value) ? value : 0;

        static int IntOf(IReadOnlyDictionary<string, object?> source, string key)
            => int.TryParse(CpPriceUploadHistory.Text(source, key), NumberStyles.Integer, CultureInfo.InvariantCulture, out var value) ? value : 0;

        var activeText = CpPriceUploadHistory.Text(row, "is_active");
        return new UploadHistoryRow(
            LongOf(row, "id"),
            LongOf(row, "price_id"),
            CpPriceUploadHistory.Text(row, "price_name"),
            CpPriceUploadHistory.Text(row, "upload_source"),
            CpPriceUploadHistory.Text(row, "original_filename"),
            CpPriceUploadHistory.Text(row, "created_at"),
            IntOf(row, "rows_imported"),
            IntOf(row, "rows_skipped"),
            CpPriceUploadHistory.Text(row, "status"),
            CpPriceUploadHistory.Text(row, "stored_relpath").Trim().Length > 0,
            activeText is "1" or "True" or "true");
    }

    private sealed record UploadHistoryRow(
        long Id,
        long PriceId,
        string PriceName,
        string Source,
        string File,
        string Created,
        int Imported,
        int Skipped,
        string Status,
        bool HasFile,
        bool Active);
}
