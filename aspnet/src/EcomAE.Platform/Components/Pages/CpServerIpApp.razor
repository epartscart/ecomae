@page "/cp/server-ip-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Server IP · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Server IP
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/server-ip-app")</p>
                <p>Local NIC addresses for this host.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/server-ip-app" IsAdmin="_isAdmin" />

    <p class="help-block">@_summary.AddressCount.ToString(CultureInfo.InvariantCulture) Addresses · @_summary.HasIpv4.ToString(CultureInfo.InvariantCulture) IPv4 · @_summary.HasIpv6.ToString(CultureInfo.InvariantCulture) IPv6 · @_summary.LoopbackOnly.ToString(CultureInfo.InvariantCulture) Loopback only.</p>
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead><tr><th>Address</th><th>Family</th><th>Loopback</th><th></th></tr></thead>
        <tbody>
        @if (_rows.Count==0) { <tr><td colspan="4">No records yet.</td></tr> }
        else { @foreach (var row in _rows) { <tr><td>@row.Address</td><td>@row.AddressFamily</td><td>@row.IsLoopback</td><td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td></tr> } }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>
@code {
    private const string _phpTab = "/content/usefull/ip.php";
    private bool _isAdmin;
    private CpServerIpSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpServerIpRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpServerIpDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Addresses;
        _source = result.Source;
        _message = result.Message;
    }
}
