@page "/erp/vat-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>VAT · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<HeadContent>
<style>
    .epc-vat-hero {
        margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
        background:linear-gradient(135deg,#0c4a6e 0%,#b45309 55%,#f59e0b 100%);
    }
    .epc-vat-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
    .epc-vat-hero p { margin:0; color:#fef3c7; max-width:44rem; font-size:.92rem; line-height:1.45; }
    .epc-vat-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
    .epc-vat-cta a {
        display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
        text-decoration:none; color:#0f172a; background:#fff;
    }
    .epc-vat-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.4); color:#fff; }
    .epc-vat-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
    .epc-vat-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
    .epc-vat-kpi strong { display:block; font-size:1.2rem; }
    .epc-vat-kpi span { color:#64748b; font-size:.78rem; }
    .epc-vat-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
    .epc-vat-table { width:100%; border-collapse:collapse; font-size:.86rem; }
    .epc-vat-table th, .epc-vat-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
    .epc-vat-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; }
    .epc-vat-note { margin-top:1rem; padding:.75rem .9rem; background:#fffbeb; border:1px solid #fcd34d; border-radius:.45rem; color:#92400e; font-size:.86rem; }
    @@media (max-width:900px){ .epc-vat-kpis{grid-template-columns:1fr 1fr;} }
</style>
</HeadContent>

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="VAT" BreadcrumbArea="Tax" BreadcrumbTab="VAT">

    <section class="epc-vat-hero">
        <h1>VAT return</h1>
        <p>ERP VAT surface over the UAE tax compliance digest. Interactive FTA filing and adjustments remain on the PHP reference tab.</p>
        <div class="epc-vat-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open PHP VAT tab</a>
            <a class="ghost" href="/erp/withholding-app">Withholding</a>
            <a class="ghost" href="/cp/uae-tax-compliance-app">UAE tax hub</a>
            <a class="ghost" href="/cp/einvoice-documents-app">E-invoice</a>
        </div>
    </section>

    <div class="epc-vat-kpis" aria-label="VAT KPIs">
        <div class="epc-vat-kpi"><strong>@_summary.LegislationCount.ToString(CultureInfo.InvariantCulture)</strong><span>Legislation</span></div>
        <div class="epc-vat-kpi"><strong>@_summary.VatAdvanceRows.ToString(CultureInfo.InvariantCulture)</strong><span>VAT advance</span></div>
        <div class="epc-vat-kpi"><strong>@_summary.VatRefundRows.ToString(CultureInfo.InvariantCulture)</strong><span>VAT refund</span></div>
        <div class="epc-vat-kpi"><strong>@_source</strong><span>Digest source</span></div>
    </div>

    <div class="epc-vat-table-wrap">
        <table class="epc-vat-table">
            <thead>
                <tr>
                    <th>Slug</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Tax</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_items.Count == 0)
                {
                    <tr><td colspan="5">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "Nothing to show yet." : _message) : "Sign in with ERP capability for live tax rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _items)
                    {
                        <tr>
                            <td><strong>@row.Slug</strong></td>
                            <td>@row.Title</td>
                            <td>@row.Category</td>
                            <td>@row.TaxCategory</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-vat-note">
        PHP authoritative for returns/refunds. Dry-runs remain under <code>/erp/ajax/*</code> with writes=0.
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=tax&tab=vat";
    private bool _isAdmin;
    private CpUaeTaxComplianceSummary _summary = new(0, 0, 0, "n/a", "");
    private IReadOnlyList<CpUaeTaxItemDigest> _items = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.BuildCpUaeTaxComplianceDigestAsync(100, ctx.RequestAborted);
        _summary = result.Summary;
        _items = result.Items;
        _source = result.Source;
        _message = result.Message;
    }
}
