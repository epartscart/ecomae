@page "/erp/vat-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>VAT · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="VAT" BreadcrumbArea="Tax" BreadcrumbTab="VAT">

    
    <PhpErpModulePageHeader Title="VAT return" Subtitle="ASP.NET Core digest — PHP compare only under /php-reference/*." PhpTabHref="@_phpTab" />


    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="VAT KPIs">
        <div class="kpi"><div class="lbl">Legislation</div><div class="val">@_summary.LegislationCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">VAT advance</div><div class="val">@_summary.VatAdvanceRows.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">VAT refund</div><div class="val">@_summary.VatRefundRows.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Digest source</div><div class="val">@_source</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Slug</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Tax</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_items.Count == 0)
                {
                    <tr><td colspan="5">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "Nothing to show yet." : _message) : "Sign in with ERP capability for live tax rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _items)
                    {
                        <tr>
                            <td><strong>@row.Slug</strong></td>
                            <td>@row.Title</td>
                            <td>@row.Category</td>
                            <td>@row.TaxCategory</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        PHP authoritative for returns/refunds. Dry-runs remain under <code>/erp/ajax/*</code> with writes=0.
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=tax&tab=vat";
    private bool _isAdmin;
    private CpUaeTaxComplianceSummary _summary = new(0, 0, 0, "n/a", "");
    private IReadOnlyList<CpUaeTaxItemDigest> _items = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.BuildCpUaeTaxComplianceDigestAsync(100, ctx.RequestAborted);
        _summary = result.Summary;
        _items = result.Items;
        _source = result.Source;
        _message = result.Message;
    }
}
