@page "/erp/vat-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>VAT · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="VAT" BreadcrumbArea="Tax" BreadcrumbTab="@_tabLabel">
    <style>
        .epc-vat-actionbar{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;margin:0 0 14px;padding:10px;background:#f8fbff;border:1px solid #d8e3ef;border-radius:10px;}
        .epc-vat-actionbar__label{width:100%;color:#64748b;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;}
        .epc-vat-actionbar form{display:flex;flex-wrap:wrap;gap:6px;align-items:flex-end;margin:0;padding:8px;border:1px solid #e2e8f0;border-radius:8px;background:#fff;}
        .epc-vat-actionbar form label{margin:0;font-size:11px;font-weight:700;color:#334155;}
        .epc-vat-actionbar form button{white-space:nowrap;}
        .epc-vat-position{display:grid;gap:8px;margin:0 0 14px;padding:12px 14px;border:1px solid #d8e3ef;border-radius:10px;background:#f8fbff;}
        .epc-vat-position__head{display:flex;justify-content:space-between;gap:12px;color:#334155;font-size:12px;font-weight:700;}
        .epc-vat-position__value{color:#1d4ed8;font-size:14px;}
        .epc-vat-position__track{height:9px;overflow:hidden;border-radius:999px;background:#e2e8f0;}
        .epc-vat-position__bar{height:100%;min-width:8px;border-radius:999px;background:#2563eb;}
        .epc-vat-position__note{color:#64748b;font-size:11px;}
        .epc-vat-board{display:grid;grid-template-columns:1.4fr .8fr;gap:12px;margin:0 0 14px;}
        .epc-vat-form{border:1px solid #d5dde6;border-radius:8px;overflow:hidden;background:#fff;}
        .epc-vat-form h3{margin:0;padding:10px 12px;background:#1d2740;color:#fff;font-size:14px;}
        .epc-vat-row{display:grid;grid-template-columns:72px 1fr 120px 110px auto;gap:8px;align-items:center;padding:8px 10px;border-top:1px solid #e6eaf1;font-size:12px;}
        .epc-vat-row strong{color:#1d2740;}
        .epc-vat-row.is-total{background:#f4f7fb;font-weight:700;}
        .epc-vat-row.is-net{background:#eef6ff;}
        .epc-vat-bars{padding:12px;border:1px solid #d5dde6;border-radius:8px;background:#fff;}
        .epc-vat-bar{display:grid;grid-template-columns:92px 1fr 88px;gap:8px;align-items:center;margin:6px 0;font-size:12px;}
        .epc-vat-bar i{display:block;height:12px;border-radius:6px;background:#e8eef6;}
        .epc-vat-bar i span{display:block;height:12px;border-radius:6px;}
        .epc-vat-guide{margin:0 0 14px;border:1px solid #cfe0f5;background:#f5f9ff;border-radius:8px;padding:8px 12px;}
        .epc-vat-guide summary{cursor:pointer;font-weight:700;color:#1d4e89;}
        @@media (max-width:900px){.epc-vat-board{grid-template-columns:1fr;}.epc-vat-row{grid-template-columns:1fr 1fr;}.epc-vat-actionbar form{width:100%;}}
    </style>

    <PhpErpModulePageHeader Title="@_title" Subtitle="@_subtitle" ContextItems="@_headerContextItems" />
    <PhpErpD365ActionPane RefreshHref="@Nav.Uri" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <div class="epc-vat-actionbar" aria-label="VAT operations">
            <div class="epc-vat-actionbar__label">VAT operations</div>
        <form method="post" action="/erp/ajax/bos-vat-refund-save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/vat-app?tab=vat_refund" />
            <label>Tax-free tag / ref <input type="text" name="tag_ref" placeholder="Planet tag no." /></label>
            <label>Invoice ref <input type="text" name="invoice_ref" placeholder="SI-..." /></label>
            <label>Sale date <input type="text" name="sale_date" placeholder="yyyy-MM-dd" /></label>
            <label>Tourist name <input type="text" name="customer_name" placeholder="Customer name" /></label>
            <label>Sale amount (ex VAT) <input type="number" step="0.01" name="sale_amount" value="0" /></label>
            <label>VAT amount <input type="number" step="0.01" name="vat_amount" placeholder="auto" /></label>
            <button type="submit">Save record</button>
        </form>
        <form method="post" action="/erp/ajax/bos-vat-refund-status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/vat-app?tab=vat_refund" />
            <label>Refund id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <label>Status
                <select name="status">
                    <option value="recorded">recorded</option>
                    <option value="validated">validated</option>
                    <option value="exported">exported</option>
                    <option value="refunded">refunded</option>
                    <option value="void">void</option>
                </select>
            </label>
            <button type="submit">Set refund status</button>
        </form>
        @if (_tabLabel == "Tourist refund")
        {
            <form method="post" action="/erp/tourist-refund/create" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/erp/vat-app?tab=tourist_refund" />
                <label>Tourist name <input name="tourist_name" required /></label>
                <label>Passport <input name="passport_no" /></label>
                <label>Nationality <input name="nationality" /></label>
                <label>Invoice <input name="invoice_no" /></label>
                <label>Total <input type="number" name="total_amount" step="0.01" min="0" /></label>
                <label>VAT <input type="number" name="vat_amount" step="0.01" min="0" /></label>
                <label>Refund % <input type="number" name="refund_pct" step="0.01" value="85" /></label>
                <button type="submit">Create tourist refund</button>
            </form>
            <form method="post" action="/erp/tourist-refund/validate" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/erp/vat-app?tab=tourist_refund" />
                <label>Barcode <input name="barcode" required maxlength="100" /></label>
                <button type="submit">Validate tourist refund</button>
            </form>
        }
        </div>
    }

    <p class="text-muted" style="margin:8px 0 12px;">
        <a href="/erp/vat-app">VAT</a>
        · <a href="/erp/vat-app?tab=vat_return">VAT return</a>
        · <a href="/erp/vat-app?tab=vat_refund">VAT refund</a>
        · <a href="/erp/vat-app?tab=tourist_refund">Tourist refund</a>
    </p>

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="VAT return KPIs">
        <div class="kpi"><div class="lbl">Rate</div><div class="val">@_vat.VatRatePercent.ToString("0.00", CultureInfo.InvariantCulture)%</div></div>
        <div class="kpi"><div class="lbl">Sales ex VAT</div><div class="val">@_vat.SalesExVat.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Output VAT</div><div class="val">@_vat.OutputVat.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Input VAT</div><div class="val">@_vat.InputVat.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Net (@_netLabel)</div><div class="val">@_vat.NetVatPayable.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>
    <div class="epc-vat-position" aria-label="VAT position">
        <div class="epc-vat-position__head">
            <span>VAT position</span>
            <span class="epc-vat-position__value">@_netLabel · @_vat.NetVatPayable.ToString("N2", CultureInfo.InvariantCulture)</span>
        </div>
        <div class="epc-vat-position__track" role="img" aria-label="Relative VAT position indicator">
            <div class="epc-vat-position__bar" style="width:@NetPositionWidth"></div>
        </div>
        <div class="epc-vat-position__note">Output VAT @_vat.OutputVat.ToString("N2", CultureInfo.InvariantCulture) versus input VAT @_vat.InputVat.ToString("N2", CultureInfo.InvariantCulture) for the current ERP period.</div>
    </div>

    <details class="epc-vat-guide" open>
        <summary>Visual guide — FTA VAT 201</summary>
        <p>Federal Decree-Law No. 8 of 2017. The return is form VAT 201. Output VAT on standard-rated supplies is netted against recoverable input VAT. Box 14 is what is payable to, or recoverable from, the Federal Tax Authority. For a person on the electronic invoicing system, Article 65(5) makes the electronic invoice the tax invoice. The VAT 201 is still the return. Boxes 1a to 1g split standard-rated supplies by the Emirate of supply. This screen keeps the posted total in Box 1 until each invoice carries that Emirate. Use Drill down to open the invoices or the bills.</p>
    </details>

    <div class="epc-vat-board" aria-label="FTA VAT 201">
        <section class="epc-vat-form">
            <h3>@_vat.Form</h3>
            @VatRow("1", "Standard-rated supplies", _vat.SalesExVat, _vat.OutputVat, "/erp/invoices-app", false)
            @VatRow("2", "Tax refunds to tourists", 0m, 0m, "/erp/vat-app?tab=tourist_refund", false)
            @VatRow("3", "Reverse-charge supplies", 0m, 0m, "/erp/invoices-app", false)
            @VatRow("4", "Zero-rated supplies", 0m, 0m, "/erp/invoices-app", false)
            @VatRow("5", "Exempt supplies", 0m, 0m, "/erp/invoices-app", false)
            @VatRow("6", "Goods imported into the UAE", 0m, 0m, "/erp/purchases-app", false)
            @VatRow("7", "Adjustments to imports", 0m, 0m, "/erp/purchases-app", false)
            @VatRow("8", "Totals — outputs", _vat.SalesExVat, _vat.OutputVat, "/erp/invoices-app", true)
            @VatRow("9", "Standard-rated expenses", _vat.PurchaseExVat, _vat.InputVat, "/erp/purchases-app", false)
            @VatRow("10", "Reverse charge recoverable", 0m, 0m, "/erp/purchases-app", false)
            @VatRow("11", "Totals — inputs", _vat.PurchaseExVat, _vat.InputVat, "/erp/purchases-app", true)
            @VatRow("12", "Due tax for the period", _vat.OutputVat, _vat.OutputVat, "/erp/invoices-app", true)
            @VatRow("13", "Recoverable tax for the period", _vat.InputVat, _vat.InputVat, "/erp/purchases-app", true)
            <div class="epc-vat-row is-net">
                <strong>14</strong>
                <span>@_netLabel <span class="text-muted">(@_vat.Form)</span></span>
                <strong>@Money(_vat.NetVatPayable)</strong>
                <span></span>
                <a class="btn btn-xs btn-primary" href="/erp/tax-external-reporting-app?cat=tax&amp;rep=tax__vat_return&amp;fetch=1">Drill down</a>
            </div>
        </section>
        <aside class="epc-vat-bars" aria-label="VAT composition">
            <strong>Output, input, and net</strong>
            @Bar("Output", _vat.OutputVat, "#2b6cb0")
            @Bar("Input", _vat.InputVat, "#2f855a")
            @Bar("Net", _vat.NetVatPayable, "#c53030")
            <p class="epc-vat-position__note">Sales incl. VAT @Money(_vat.SalesInclVat). Purchases incl. VAT @Money(_vat.PurchaseInclVat).</p>
            <p><a class="btn btn-primary btn-sm" href="/erp/tax-external-reporting-app?cat=tax&amp;rep=tax__vat_return&amp;fetch=1">Fetch &amp; build</a></p>
        </aside>
    </div>

    @if (_showFetch)
    {
        <h2 style="font-size:16px;margin-top:18px;">Tax legislation</h2>
        @if (_isAdmin)
        {
            <form method="post" action="@ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/uae-tax/fta-fetch")" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin:0 0 1rem;">
                <input type="hidden" name="returnUrl" value="@ClientErpPath.PrefixIfBound(Http.HttpContext, _fetchReturn)" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label><input type="checkbox" name="force" value="1" /> Force refetch</label>
                <button type="submit" class="btn btn-primary btn-sm">Fetch FTA legislation</button>
            </form>
        }
        <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Legislation KPIs">
            <div class="kpi"><div class="lbl">Legislation</div><div class="val">@_tax.LegislationCount.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">VAT advance</div><div class="val">@_tax.VatAdvanceRows.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">VAT refund</div><div class="val">@_tax.VatRefundRows.ToString(CultureInfo.InvariantCulture)</div></div>
        </div>
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead>
                    <tr>
                        <th>Slug</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Tax</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_items.Count == 0)
                    {
                        <tr><td colspan="4">@(_isAdmin ? (string.IsNullOrWhiteSpace(_taxMessage) ? "No legislation rows." : _taxMessage) : "Sign in with ERP capability for live tax rows.")</td></tr>
                    }
                    else
                    {
                        @foreach (var row in _items)
                        {
                            <tr>
                                <td><strong>@row.Slug</strong></td>
                                <td>@row.Title</td>
                                <td>@row.Category</td>
                                <td>@row.TaxCategory</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Period: @FormatDate(_vat.DateFromUnix) — @FormatDate(_vat.DateToUnix). Source: @_source. FTA filing / EmaraTax submit stay on ERP ajax. Dry-runs remain under <code>/erp/ajax/*</code> with writes=0.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private bool _showLegislation = true;
    private bool _showFetch = true;
    private string _tabLabel = "VAT";
    private string _title = "VAT return";
    private string _subtitle = "Operational output − input for the selected period. File on the tax authority portal.";
    private ErpVatReturnSummary _vat = new(0, 0, 5, 0, 0, 0, 0, 0, 0, 0, "payable_to_fta", "FTA VAT 201", "n/a", "");
    private CpUaeTaxComplianceSummary _tax = new(0, 0, 0, "n/a", "");
    private IReadOnlyList<CpUaeTaxItemDigest> _items = [];
    private string _source = "n/a";
    private string _message = "";
    private string _taxMessage = "";
    private string _netLabel = "Payable";
    private string _fetchReturn = "/erp/vat-app";
    private string _flashOk = "";
    private string _flashErr = "";
    private IReadOnlyList<string> _headerContextItems = [];
    private string NetPositionWidth
    {
        get
        {
            var total = Math.Abs(_vat.OutputVat) + Math.Abs(_vat.InputVat);
            if (total <= 0) return "0%";
            var ratio = Math.Clamp(Math.Abs(_vat.NetVatPayable) / total * 100m, 8m, 100m);
            return ratio.ToString("0.##", CultureInfo.InvariantCulture) + "%";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var tab = (ctx.Request.Query["tab"].ToString() ?? "").Trim().ToLowerInvariant();
        _showLegislation = tab is "" or "vat";
        _showFetch = tab is "" or "vat" or "vat_return";
        _tabLabel = tab switch
        {
            "vat_refund" => "VAT refund",
            "tourist_refund" => "Tourist refund",
            "vat_return" => "VAT return",
            _ => "VAT"
        };
        _title = _tabLabel == "VAT" ? "VAT return" : _tabLabel;
        _subtitle = tab switch
        {
            "vat_refund" => "Refundable VAT from the operational return. Authority filing stays on ERP ajax.",
            "tourist_refund" => "Tourist refund overlay on the operational VAT return. Filing stays on ERP ajax.",
            _ => "Operational output − input for the selected period. File on the tax authority portal."
        };
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var vat = await Dashboards.BuildErpVatReturnDigestAsync(cancellationToken: ctx.RequestAborted);
        _vat = vat.Summary;
        _source = vat.Source;
        _message = vat.Message;
        _netLabel = string.Equals(_vat.NetStatus, "recoverable_from_fta", StringComparison.OrdinalIgnoreCase)
            ? "Recoverable"
            : "Payable";
        _headerContextItems =
        [
            "UAE registered country",
            $"{FormatDate(_vat.DateFromUnix)} — {FormatDate(_vat.DateToUnix)}",
            $"{_vat.VatRatePercent.ToString("0.##", CultureInfo.InvariantCulture)}% VAT",
            _netLabel,
            string.IsNullOrWhiteSpace(_source) ? "ERP data" : _source,
        ];

        _fetchReturn = tab == "vat_return" ? "/erp/vat-app?tab=vat_return" : "/erp/vat-app";
        if (_showFetch)
        {
            var result = await Dashboards.BuildCpUaeTaxComplianceDigestAsync(100, ctx.RequestAborted);
            _tax = result.Summary;
            _items = result.Items;
            _taxMessage = result.Message;
        }
    }

    private RenderFragment VatRow(string box, string label, decimal amount, decimal vat, string href, bool total) => __builder =>
    {
        <div class="epc-vat-row @(total ? "is-total" : "")">
            <strong>@box</strong>
            <span>@label</span>
            <span>@Money(amount)</span>
            <span>@Money(vat)</span>
            <a class="btn btn-xs btn-primary" href="@href">Drill down</a>
        </div>
    };

    private RenderFragment Bar(string label, decimal amount, string color) => __builder =>
    {
        <div class="epc-vat-bar">
            <span>@label</span>
            <i><span style="width:@Width(amount);background:@color"></span></i>
            <strong>@Money(amount)</strong>
        </div>
    };

    private string Money(decimal amount) => amount.ToString("N2", CultureInfo.InvariantCulture);

    private string Width(decimal amount)
    {
        var max = Math.Max(Math.Abs(_vat.OutputVat), Math.Max(Math.Abs(_vat.InputVat), Math.Abs(_vat.NetVatPayable)));
        if (max <= 0) return "0%";
        var pct = Math.Clamp(Math.Abs(amount) / max * 100m, 8m, 100m);
        return pct.ToString("0.#", CultureInfo.InvariantCulture) + "%";
    }

    private static string FormatDate(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
