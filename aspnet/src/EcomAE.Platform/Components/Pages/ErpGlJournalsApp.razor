@page "/erp/gl-journals-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Components.Shared.Desktop
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@using EcomAE.Platform.Erp
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav
@inject IErpDimensionLinkReadService DimensionLinks

<PageTitle>General Ledger · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="General Ledger" BreadcrumbArea="Record to Report" BreadcrumbTab="General ledger">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/gl-journals-app" IsAdmin="_isAdmin" />


    
    <PhpErpModulePageHeader Title="General Ledger Journals" Subtitle="Create, inspect, and reverse posted journals with an auditable correction entry." PhpTabHref="@_phpTab" />

    <ErpManualProcessStrip Keys="gl" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" EntryHref="/erp/gl-journals-app?view=entry" EntryLabel="New journal" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="/erp/gl-journals-app" />
    <ErpPhpFlash Ok="@_flashOk" Err="@_flashErr" />
    @if (_entry && _isAdmin)
    {
        <div class="epc-d365-entry">
            <div class="epc-d365-entry-head">
                <span>Journal entry</span>
                <a class="btn btn-xs btn-default" href="/erp/gl-journals-app">Back to list</a>
            </div>
            <div class="epc-d365-entry-body">
        <section class="epc-erp-form-panel" style="margin:0 0 1rem">
            <div class="epc-erp-form-panel__head">
                <strong>Manual journal entry</strong>
                <span class="text-muted">Validate, balance, then post to the general ledger.</span>
            </div>
            <form method="post" action="@EcomAeRoutes.ErpGlJournalsManual" class="erp-journal-date-form">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/erp/gl-journals-app" />
                <input type="hidden" name="journalDate" value="@JournalDate" data-unix-date />
                <ErpVoucherHeaderFields DateFieldName="voc_date" DateRequired="false" NumberLabel="Journal no" NumberPreview="Auto" />
                <label>Journal date <input type="datetime-local" value="@JournalDateInput" data-date-input required /></label>
                <label>Reference <input type="text" name="reference" required maxlength="80" /></label>
                <label>Description <input type="text" name="description" required maxlength="255" /></label>
                <label>Currency <input type="text" name="currency_code" maxlength="8" placeholder="accounting" style="width:6rem;text-transform:uppercase" /></label>
                <label>Exchange rate <input type="number" name="exchange_rate" min="0" step="0.00000001" value="1" style="width:8rem" /></label>
                <p class="text-muted">Voucher &amp; journal number: <strong>assigned automatically</strong> (GV-…) on posting — shown on the posted voucher and its print. Leave currency blank for the tenant's accounting currency; enter a code (e.g. USD) + rate for a foreign-currency voucher — amounts post converted to accounting currency.</p>
                <p class="text-muted">Put the debit and the credit on different business units or legal entities when the entry crosses them. The books add the intercompany receivable and payable so each unit still tallies. The same TRN is not a tax invoice. A different TRN charges VAT.</p>
                <div class="epc-erp-table-wrap">
                    <table class="table table-bordered table-condensed table-epc epc-erp-table" id="gl-journal-lines">
                        <thead><tr><th>COA account</th><th>Legal entity</th><th>Business unit</th><th style="width:7rem">Debit</th><th style="width:7rem">Credit</th><th>Line note</th><th style="width:2.2rem"></th></tr></thead>
                        <tbody>
                            <tr>
                                <td><ErpMasterPicker Kind="coa" FieldName="lines[0].coaId" InputId="gl-line-0" Label="Account" Required="true" /></td>
                                <td><ErpMasterPicker Kind="legal-entity" FieldName="lines[0].legalEntityId" InputId="gl-line-0-le" Label="Legal entity" /></td>
                                <td><ErpMasterPicker Kind="business-unit" FieldName="lines[0].businessUnitId" InputId="gl-line-0-bu" Label="Business unit" /></td>
                                <td><input type="number" name="lines[0].debit" min="0" step="0.01" value="0" required /></td>
                                <td><input type="number" name="lines[0].credit" min="0" step="0.01" value="0" required /></td>
                                <td><input type="text" name="lines[0].lineNote" maxlength="255" /></td>
                                <td><button type="button" class="btn btn-xs btn-default gl-line-del" title="Remove line">&times;</button></td>
                            </tr>
                            <tr>
                                <td><ErpMasterPicker Kind="coa" FieldName="lines[1].coaId" InputId="gl-line-1" Label="Account" Required="true" /></td>
                                <td><ErpMasterPicker Kind="legal-entity" FieldName="lines[1].legalEntityId" InputId="gl-line-1-le" Label="Legal entity" /></td>
                                <td><ErpMasterPicker Kind="business-unit" FieldName="lines[1].businessUnitId" InputId="gl-line-1-bu" Label="Business unit" /></td>
                                <td><input type="number" name="lines[1].debit" min="0" step="0.01" value="0" required /></td>
                                <td><input type="number" name="lines[1].credit" min="0" step="0.01" value="0" required /></td>
                                <td><input type="text" name="lines[1].lineNote" maxlength="255" /></td>
                                <td><button type="button" class="btn btn-xs btn-default gl-line-del" title="Remove line">&times;</button></td>
                            </tr>
                            <tr>
                                <td><ErpMasterPicker Kind="coa" FieldName="lines[2].coaId" InputId="gl-line-2" Label="Account" /></td>
                                <td><ErpMasterPicker Kind="legal-entity" FieldName="lines[2].legalEntityId" InputId="gl-line-2-le" Label="Legal entity" /></td>
                                <td><ErpMasterPicker Kind="business-unit" FieldName="lines[2].businessUnitId" InputId="gl-line-2-bu" Label="Business unit" /></td>
                                <td><input type="number" name="lines[2].debit" min="0" step="0.01" value="0" /></td>
                                <td><input type="number" name="lines[2].credit" min="0" step="0.01" value="0" /></td>
                                <td><input type="text" name="lines[2].lineNote" maxlength="255" /></td>
                                <td><button type="button" class="btn btn-xs btn-default gl-line-del" title="Remove line">&times;</button></td>
                            </tr>
                            <tr>
                                <td><ErpMasterPicker Kind="coa" FieldName="lines[3].coaId" InputId="gl-line-3" Label="Account" /></td>
                                <td><ErpMasterPicker Kind="legal-entity" FieldName="lines[3].legalEntityId" InputId="gl-line-3-le" Label="Legal entity" /></td>
                                <td><ErpMasterPicker Kind="business-unit" FieldName="lines[3].businessUnitId" InputId="gl-line-3-bu" Label="Business unit" /></td>
                                <td><input type="number" name="lines[3].debit" min="0" step="0.01" value="0" /></td>
                                <td><input type="number" name="lines[3].credit" min="0" step="0.01" value="0" /></td>
                                <td><input type="text" name="lines[3].lineNote" maxlength="255" /></td>
                                <td><button type="button" class="btn btn-xs btn-default gl-line-del" title="Remove line">&times;</button></td>
                            </tr>
                            <tr>
                                <td><ErpMasterPicker Kind="coa" FieldName="lines[4].coaId" InputId="gl-line-4" Label="Account" /></td>
                                <td><ErpMasterPicker Kind="legal-entity" FieldName="lines[4].legalEntityId" InputId="gl-line-4-le" Label="Legal entity" /></td>
                                <td><ErpMasterPicker Kind="business-unit" FieldName="lines[4].businessUnitId" InputId="gl-line-4-bu" Label="Business unit" /></td>
                                <td><input type="number" name="lines[4].debit" min="0" step="0.01" value="0" /></td>
                                <td><input type="number" name="lines[4].credit" min="0" step="0.01" value="0" /></td>
                                <td><input type="text" name="lines[4].lineNote" maxlength="255" /></td>
                                <td><button type="button" class="btn btn-xs btn-default gl-line-del" title="Remove line">&times;</button></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" style="text-align:right;font-weight:700">Totals</td>
                                <td id="gl-tot-dr" style="font-weight:700">0.00</td>
                                <td id="gl-tot-cr" style="font-weight:700">0.00</td>
                                <td id="gl-tot-bal" colspan="2" class="text-muted">difference 0.00</td>
                            </tr>
                        </tfoot>
                    </table>
                    <button type="button" class="btn btn-default btn-sm" id="gl-add-line"><i class="fa fa-plus"></i> Add line</button>
                </div>
                <script>
                (function(){
                    var table=document.getElementById('gl-journal-lines');
                    if(!table)return;
                    var tbody=table.querySelector('tbody');
                    function names(){var n=0;tbody.querySelectorAll('tr').forEach(function(tr){tr.querySelectorAll('[name]').forEach(function(el){el.name=el.name.replace(/lines\[\d+\]/,'lines['+n+']')});n++})}
                    function totals(){var d=0,c=0;tbody.querySelectorAll('tr').forEach(function(tr){var di=tr.querySelector('[name$=".debit"]'),ci=tr.querySelector('[name$=".credit"]');if(di)d+=parseFloat(di.value)||0;if(ci)c+=parseFloat(ci.value)||0});var t=document.getElementById('gl-tot-dr'),u=document.getElementById('gl-tot-cr'),b=document.getElementById('gl-tot-bal');if(t)t.textContent=d.toFixed(2);if(u)u.textContent=c.toFixed(2);if(b){var v=Math.abs(d-c);b.textContent=v<0.005?'balanced':'difference '+v.toFixed(2);b.style.color=v<0.005?'#0f766e':'#b45309'}}
                    tbody.addEventListener('input',totals);
                    tbody.addEventListener('click',function(e){var b=e.target.closest('.gl-line-del');if(!b)return;if(tbody.querySelectorAll('tr').length<=2)return alert('A journal needs at least two lines');b.closest('tr').remove();names();totals()});
                    var add=document.getElementById('gl-add-line');
                    if(add)add.addEventListener('click',function(){var last=tbody.querySelector('tr:last-child');var tr=last.cloneNode(true);tr.querySelectorAll('input').forEach(function(i){i.value=i.type==='number'?'0':''});tr.querySelectorAll('*').forEach(function(el){Array.from(el.attributes).forEach(function(a){if(/^data-erp-.*bound$/.test(a.name))el.removeAttribute(a.name)})});tbody.appendChild(tr);names();totals();if(window.ErpMasterPickerRefresh)window.ErpMasterPickerRefresh()});
                    totals();
                })();
                </script>
                <div class="form-actions"><button type="submit" class="btn btn-primary">Validate and post journal</button></div>
            </form>
        </section>
        <form id="erp-module-new" method="post" action="@EcomAeRoutes.ErpJewelleryVoucherSaveForm">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/gl-journals-app?tab=jw_journal_voucher" />
            <input type="hidden" name="action" value="jw_journal_voucher_save" />
            <input type="hidden" name="voc_type" value="JVL" />
            <ErpVoucherHeaderFields NumberPreview="Auto" />
            <label>Description <input type="text" name="party_name" required /></label>
            <label>Amount <input type="text" name="net_amount" value="0" style="width:6rem" /></label>
            <div class="form-actions"><button type="submit" class="btn btn-primary btn-sm">Save journal voucher</button></div>
        </form>
        <ErpD365ModuleArea Kind="gl" Part="entry" />
            </div>
        </div>
    }
    else
    {
    <ErpD365ModuleArea Kind="gl" Part="grid" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="GL KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_journals.Count</div></div>
        <div class="kpi"><div class="lbl">Posted in page</div><div class="val">@_posted</div></div>
        <div class="kpi"><div class="lbl">Unbalanced in page</div><div class="val">@_unbalanced</div></div>
        <div class="kpi"><div class="lbl">Page total debit</div><div class="val">@_totalDebit.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedDetail is not null && _print)
    {
        <div class="glv-print">
            <div class="glv-head">
                <div>
                    <h1>Journal voucher</h1>
                    <p class="text-muted">Voucher no: <strong>@_openedDetail.JournalNo</strong> &nbsp;·&nbsp; Journal no: <strong>@_openedDetail.JournalNo</strong></p>
                </div>
                <button type="button" class="btn btn-default glv-noprint" onclick="window.print()">Print / Save PDF</button>
            </div>
            <table class="glv-meta">
                <tr><td>Journal date</td><td>@FormatTime(_openedDetail.JournalDate)</td><td>Status</td><td>@_openedDetail.Status</td></tr>
                <tr><td>Reference</td><td>@_openedDetail.Reference</td><td>Source</td><td>@_openedDetail.SourceType</td></tr>
                <tr><td>Currency</td><td>@(string.IsNullOrWhiteSpace(_openedDetail.CurrencyCode) ? "Accounting currency" : _openedDetail.CurrencyCode)</td><td>Exchange rate</td><td>@_openedDetail.ExchangeRate.ToString("0.########", CultureInfo.InvariantCulture)</td></tr>
                <tr><td>Description</td><td colspan="3">@_openedDetail.DescriptionExcerpt</td></tr>
            </table>
            <table class="glv-lines">
                <thead><tr><th>#</th><th>Account</th><th>Account name</th><th>Debit</th><th>Credit</th><th>Note</th></tr></thead>
                <tbody>
                    @{
                        var rn = 0;
                    }
                    @foreach (var line in _openedDetail.Lines)
                    {
                        rn++;
                        <tr><td>@rn</td><td>@line.AccountCode</td><td>@line.AccountName</td><td class="r">@line.Debit</td><td class="r">@line.Credit</td><td>@line.LineNote</td></tr>
                    }
                </tbody>
                <tfoot><tr><td colspan="3">Totals (@(string.IsNullOrWhiteSpace(_openedDetail.CurrencyCode) ? "accounting currency" : _openedDetail.CurrencyCode))</td><td class="r">@_openedDetail.TotalDebit</td><td class="r">@_openedDetail.TotalCredit</td><td></td></tr></tfoot>
            </table>
            <div class="glv-sign"><div>Prepared by</div><div>Checked by</div><div>Approved by</div></div>
            <p class="glv-note">Printed from ecom ERP · @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture)</p>
        </div>
    }
    else if (_openedDetail is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="/erp/gl-journals-app">Close</a>
            </p>
            <ErpFinanceVoucherWorkspace
                DocumentKind="General journal"
                Title="@(_openedDetail.JournalNo ?? $"Journal #{_openedDetail.Id}")"
                Subtitle="General journal voucher with balanced debit and credit lines."
                Status="@_openedDetail.Status"
                Posted="@string.Equals(_openedDetail.Status, "posted", StringComparison.OrdinalIgnoreCase)"
                CompanyContext="Tenant / company"
                Currency="AED"
                Tabs="@GeneralJournalTabs"
                Fields="@GeneralJournalFields"
                Lines="@GeneralJournalLines"
                VoucherDebit="@_openedDetail.TotalDebit"
                VoucherCredit="@_openedDetail.TotalCredit"
                JournalDebit="@_openedDetail.TotalDebit"
                JournalCredit="@_openedDetail.TotalCredit"
                Actions="@GeneralJournalActions"
                HeaderActions="@GeneralJournalHeaderActions" />
            <ErpDimensionLinksPanel Links="_openedDimensionLinks" />
            <p class="text-muted" style="margin:.85rem 0 0">Journal identity, source, status, balanced debit/credit totals, and persisted lines are presented in the shared finance workspace.</p>
            <p style="margin:.5rem 0 0"><a class="btn btn-sm btn-default" href="/erp/gl-journals-app?journal_id=@_openedDetail.Id&print=1" target="_blank" rel="noopener"><i class="fa fa-print"></i> Print voucher</a></p>
            @if (!string.IsNullOrWhiteSpace(_openedDetail.DescriptionExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">note excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedDetail.DescriptionExcerpt</pre>
                @if (_openedDetail.DescriptionLen > _openedDetail.DescriptionExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_openedDetail.DescriptionExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedDetail.DescriptionLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No note excerpt yet.</p>
            }
            <p class="text-muted">Posted journals reverse here with a reason and reversal date.</p>
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-source siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Journal #</th><th>Date</th><th class="text-right">Debit</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.JournalNo) ? "—" : sib.JournalNo)</td>
                                <td>@FormatTime(sib.JournalDate)</td>
                                <td class="text-right">@sib.TotalDebit.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href("/erp/gl-journals-app", "journal_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-source siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Journal #</th>
                    <th>Date</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Total debit</th>
                    <th>Total credit</th>
                    <th>Balance</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_journals.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var j in _journals)
                    {
                        <tr id="erp-row-@j.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(j.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(j.JournalNo) ? $"#{j.Id}" : j.JournalNo)</strong></td>
                            <td>@FormatTime(j.JournalDate)</td>
                            <td>@(string.IsNullOrWhiteSpace(j.SourceType) ? "—" : j.SourceType)@(j.SourceId > 0 ? $" #{j.SourceId}" : "")</td>
                            <td><span class="label label-default">@j.Status</span></td>
                            <td>@j.TotalDebit.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@j.TotalCredit.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td style="@(j.TotalDebit - j.TotalCredit != 0 ? "color:#b3261e;font-weight:600" : "")">@((j.TotalDebit - j.TotalCredit).ToString("N2", CultureInfo.InvariantCulture))</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href("/erp/gl-journals-app", "journal_id", j.Id)">Open</a></td>
                        </tr>
                    }
                    <tr style="font-weight:600;background:#f2f6fa">
                        <td>Total</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td>@_journals.Sum(j => j.TotalDebit).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td>@_journals.Sum(j => j.TotalCredit).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td>@_journals.Sum(j => j.TotalDebit - j.TotalCredit).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }

</PhpErpDesktopChrome>

<script>
    document.querySelectorAll('.erp-journal-date-form').forEach(function (form) {
        var input = form.querySelector('[data-date-input]');
        var target = form.querySelector('[data-unix-date]');
        if (!input || !target) return;
        var sync = function () {
            var milliseconds = Date.parse(input.value);
            if (!Number.isNaN(milliseconds)) target.value = Math.floor(milliseconds / 1000);
        };
        input.addEventListener('change', sync);
        sync();
    });
</script>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=finance&tab=gl";
    private bool _isAdmin;
    private IReadOnlyList<ErpGlJournalDigest> _journals = [];
    private int _posted;
    private int _unbalanced;
    private decimal _totalDebit;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private ErpGlJournalDigest? _openedJournal;
    private ErpGlJournalDetail? _openedDetail;
    private IReadOnlyList<ErpGlJournalDigest> _openedSiblings = [];
    private IReadOnlyList<ErpDimensionLink> _openedDimensionLinks = [];

    private IReadOnlyList<string> GeneralJournalTabs =>
        ["List", "General", "Invoice", "Payment", "Payment fee", "Fixed assets", "Remittance", "History"];
    private IReadOnlyList<ErpFinanceVoucherField> GeneralJournalFields => _openedDetail is null
        ? []
        : [
            new("Journal number", _openedDetail.JournalNo, "General"),
            new("Journal date", FormatTime(_openedDetail.JournalDate), "General"),
            new("Reference", _openedDetail.Reference, "General"),
            new("Description", _openedDetail.DescriptionExcerpt, "General"),
            new("Source", _openedDetail.SourceType, "General"),
            new("Voucher", _openedDetail.JournalNo, "Invoice"),
            new("Approval", _openedDetail.Status, "Payment"),
            new("Budget check", "Not performed", "Payment"),
            new("Dimensions", "Company · site · department", "Fixed assets")
        ];
    private IReadOnlyList<ErpFinanceVoucherLine> GeneralJournalLines => _openedDetail is null
        ? []
        : _openedDetail.Lines.Select(line => new ErpFinanceVoucherLine(
            FormatTime(_openedDetail.JournalDate),
            _openedDetail.JournalNo,
            "Tenant company",
            "Ledger",
            line.AccountCode,
            line.AccountName,
            line.LineNote,
            line.Debit,
            line.Credit,
            "AED",
            "Tenant company",
            "Ledger",
            "",
            "—",
            "Company / site / department")).ToList();
    private IReadOnlyList<ErpFinanceVoucherAction> GeneralJournalActions =>
    [
        new("Save", "fa-save", "Save journal"),
        new("New", "fa-plus", "Create a new general journal"),
        new("Post", "fa-check-circle", "Post journal", _isAdmin),
        new("Post in batch", "fa-tasks", "Post in batch"),
        new("Validate", "fa-check", "Validate journal balance"),
        new("Functions", "fa-cogs", "Journal functions"),
        new("Fixed assets", "fa-building", "Fixed asset distribution"),
        new("Inquiries", "fa-search", "View journal inquiries"),
        new("Print", "fa-print", "Print journal"),
        new("Options", "fa-cog", "Journal options")
    ];
    private RenderFragment? GeneralJournalHeaderActions => _isAdmin && _openedDetail is not null
        ? @<div>
            <strong><i class="fa fa-cog"></i> Journal lifecycle</strong>
            @if (_openedDetail.Status.Equals("posted", StringComparison.OrdinalIgnoreCase))
            {
                <form method="post" action="@EcomAeRoutes.ErpGlJournalsReverse" class="erp-journal-date-form">
                    <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="journalId" value="@_openedDetail.Id" />
                    <input type="hidden" name="reverseDate" value="@JournalDate" data-unix-date />
                    <label>Reversal date <input type="datetime-local" value="@JournalDateInput" data-date-input required /></label>
                    <label>Reason <input type="text" name="note" required maxlength="255" placeholder="Reason for reversal" /></label>
                    <button type="submit" class="btn btn-xs btn-warning">Post reversal journal</button>
                </form>
            }
            else
            {
                <span class="text-muted">Draft journal can be validated and posted from the journal entry form.</span>
            }
        </div>
        : null;

    private static long JournalDate => DateTimeOffset.UtcNow.ToUnixTimeSeconds();
    private static string JournalDateInput => DateTimeOffset.UtcNow.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);

    private bool OpenedFound => _openedDetail is not null || _openedJournal is not null;

    private string OpenedReturnHref => _openedId > 0
        ? "/erp/gl-journals-app?journal_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : "/erp/gl-journals-app";

    private string OpenedCaption => _openedDetail is not null
        ? (string.IsNullOrWhiteSpace(_openedDetail.JournalNo) ? ("Journal #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.JournalNo)
            + (string.IsNullOrWhiteSpace(_openedDetail.Reference) ? "" : (" · " + _openedDetail.Reference))
        : _openedJournal is null
            ? ""
            : (string.IsNullOrWhiteSpace(_openedJournal.JournalNo) ? $"Journal #{_openedJournal.Id}" : _openedJournal.JournalNo) + " · " + _openedJournal.Status;

    private bool _entry => string.Equals(Http.HttpContext?.Request.Query["view"].ToString(), "entry", StringComparison.OrdinalIgnoreCase);

    private bool _print => string.Equals(Http.HttpContext?.Request.Query["print"].ToString(), "1", StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "journal_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListErpGlJournalsAsync(_limit, ctx.RequestAborted);
        _journals = result.Journals;
        _openedJournal = _openedId > 0 ? _journals.FirstOrDefault(j => j.Id == _openedId) : null;
        if (_openedJournal is not null)
        {
            _journals = new[] { _openedJournal }.Concat(_journals.Where(j => j.Id != _openedId)).ToList();
        }
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpGlJournalDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Journal;
            _openedSiblings = detail.Siblings;
            _openedDimensionLinks = await DimensionLinks.LoadAsync(
                "gl_entry",
                _openedId,
                ctx.RequestAborted);
            if (_openedDetail is null && !string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
        _posted = _journals.Count(j => string.Equals(j.Status, "posted", StringComparison.OrdinalIgnoreCase));
        _unbalanced = _journals.Count(j => j.TotalDebit - j.TotalCredit != 0);
        _totalDebit = _journals.Sum(j => j.TotalDebit);
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
