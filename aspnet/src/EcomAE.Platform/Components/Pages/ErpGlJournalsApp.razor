@page "/erp/gl-journals-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>General Ledger · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="General Ledger" BreadcrumbArea="Record to Report" BreadcrumbTab="General ledger">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/gl-journals-app" IsAdmin="_isAdmin" />


    
    <PhpErpModulePageHeader Title="General Ledger Journals" Subtitle="Open a journal for the note excerpt and reference. Jewellery voucher save writes here. Reverse stays Classic." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="/erp/gl-journals-app" />
    <ErpPhpFlash Ok="@_flashOk" Err="@_flashErr" />
    @if (_isAdmin)
    {
        <form id="erp-module-new" method="post" action="@EcomAeRoutes.ErpJewelleryVoucherSaveForm" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/gl-journals-app?tab=jw_journal_voucher" />
            <input type="hidden" name="action" value="jw_journal_voucher_save" />
            <input type="hidden" name="voc_type" value="JVG" />
            <label>Description <input type="text" name="party_name" required /></label>
            <label>Amount <input type="text" name="net_amount" value="0" style="width:6rem" /></label>
            <button type="submit" class="btn btn-xs btn-primary">Save journal voucher</button>
        </form>
    }


    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="GL KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_journals.Count</div></div>
        <div class="kpi"><div class="lbl">Posted in page</div><div class="val">@_posted</div></div>
        <div class="kpi"><div class="lbl">Page total debit</div><div class="val">@_totalDebit.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedDetail is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="/erp/gl-journals-app">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Journal id</dt><dd>@_openedDetail.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Journal #</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.JournalNo) ? "—" : _openedDetail.JournalNo)</dd>
                <dt>Date</dt><dd>@FormatTime(_openedDetail.JournalDate)</dd>
                <dt>Source</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.SourceType) ? "—" : _openedDetail.SourceType)@(_openedDetail.SourceId > 0 ? (" #" + _openedDetail.SourceId.ToString(CultureInfo.InvariantCulture)) : "")</dd>
                <dt>Reference</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.Reference) ? "—" : _openedDetail.Reference)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_openedDetail.Status) ? "—" : _openedDetail.Status)</dd>
                <dt>Debit</dt><dd>@_openedDetail.TotalDebit.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Admin</dt><dd>@(_openedDetail.AdminId > 0 ? _openedDetail.AdminId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Created</dt><dd>@FormatTime(_openedDetail.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Jewellery voucher save writes here. Reverse stays Classic.</p>
            @if (!string.IsNullOrWhiteSpace(_openedDetail.DescriptionExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">note excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedDetail.DescriptionExcerpt</pre>
                @if (_openedDetail.DescriptionLen > _openedDetail.DescriptionExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_openedDetail.DescriptionExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedDetail.DescriptionLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No note excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-source siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Journal #</th><th>Date</th><th class="text-right">Debit</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.JournalNo) ? "—" : sib.JournalNo)</td>
                                <td>@FormatTime(sib.JournalDate)</td>
                                <td class="text-right">@sib.TotalDebit.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href("/erp/gl-journals-app", "journal_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-source siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Journal #</th>
                    <th>Date</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Total debit</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_journals.Count == 0)
                {
                    <tr><td colspan="6">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var j in _journals)
                    {
                        <tr id="erp-row-@j.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(j.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(j.JournalNo) ? $"#{j.Id}" : j.JournalNo)</strong></td>
                            <td>@FormatTime(j.JournalDate)</td>
                            <td>@(string.IsNullOrWhiteSpace(j.SourceType) ? "—" : j.SourceType)@(j.SourceId > 0 ? $" #{j.SourceId}" : "")</td>
                            <td><span class="label label-default">@j.Status</span></td>
                            <td>@j.TotalDebit.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href("/erp/gl-journals-app", "journal_id", j.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=finance&tab=gl";
    private bool _isAdmin;
    private IReadOnlyList<ErpGlJournalDigest> _journals = [];
    private int _posted;
    private decimal _totalDebit;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private ErpGlJournalDigest? _openedJournal;
    private ErpGlJournalDetail? _openedDetail;
    private IReadOnlyList<ErpGlJournalDigest> _openedSiblings = [];

    private bool OpenedFound => _openedDetail is not null || _openedJournal is not null;

    private string OpenedReturnHref => _openedId > 0
        ? "/erp/gl-journals-app?journal_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : "/erp/gl-journals-app";

    private string OpenedCaption => _openedDetail is not null
        ? (string.IsNullOrWhiteSpace(_openedDetail.JournalNo) ? ("Journal #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.JournalNo)
            + (string.IsNullOrWhiteSpace(_openedDetail.Reference) ? "" : (" · " + _openedDetail.Reference))
        : _openedJournal is null
            ? ""
            : (string.IsNullOrWhiteSpace(_openedJournal.JournalNo) ? $"Journal #{_openedJournal.Id}" : _openedJournal.JournalNo) + " · " + _openedJournal.Status;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "journal_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListErpGlJournalsAsync(_limit, ctx.RequestAborted);
        _journals = result.Journals;
        _openedJournal = _openedId > 0 ? _journals.FirstOrDefault(j => j.Id == _openedId) : null;
        if (_openedJournal is not null)
        {
            _journals = new[] { _openedJournal }.Concat(_journals.Where(j => j.Id != _openedId)).ToList();
        }
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpGlJournalDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Journal;
            _openedSiblings = detail.Siblings;
            if (_openedDetail is null && !string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
        _posted = _journals.Count(j => string.Equals(j.Status, "posted", StringComparison.OrdinalIgnoreCase));
        _totalDebit = _journals.Sum(j => j.TotalDebit);
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
