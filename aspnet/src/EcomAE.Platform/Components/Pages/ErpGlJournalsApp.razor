@page "/erp/gl-journals-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>General Ledger · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="General Ledger" BreadcrumbArea="Record to Report" BreadcrumbTab="General ledger">
    <style>
        .epc-gl-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c0a09 0%,#1c1917 40%,#57534e 100%);
        }
        .epc-gl-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-gl-hero p { margin:0; color:#d6d3d1; max-width:42rem; font-size:.92rem; line-height:1.45; }
        .epc-gl-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-gl-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#1c1917; background:#e7e5e4;
        }
        .epc-gl-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-gl-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-gl-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-gl-kpi strong { display:block; font-size:1.45rem; font-variant-numeric:tabular-nums; }
        .epc-gl-kpi span { color:#64748b; font-size:.78rem; }
        .epc-gl-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-gl-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-gl-table th, .epc-gl-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-gl-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-gl-table a { color:#44403c; font-weight:700; text-decoration:none; }
        .epc-gl-badge { display:inline-flex; padding:.15rem .45rem; border-radius:.3rem; font-size:.72rem; font-weight:700; background:#e7e5e4; color:#292524; }
        .epc-gl-note { margin-top:1rem; padding:.75rem .9rem; background:#fafaf9; border:1px solid #d6d3d1; border-radius:.45rem; color:#44403c; font-size:.86rem; }
        @@media (max-width:900px){ .epc-gl-kpis{grid-template-columns:1fr;} }
    </style>

    <section class="epc-gl-hero">
        <img src="@LegacyPresentationAssets.EpartsCartMarkUrl" alt="ECOM AE" style="height:28px;filter:brightness(1.1)" />
        <h1>General Ledger Journals</h1>
        <p>Operational finance, inventory, and approvals for this company.</p>
        <div class="epc-gl-cta">
            <a href="@_phpTab">Open module</a>
            <a class="ghost" href="/erp/coa-accounts-app">Chart of accounts</a>
            <a class="ghost" href="/erp/cash-accounts-app">Cash &amp; bank</a>
            <a class="ghost" href="/erp/app">ERP dashboard</a>
        </div>
    </section>

    <div class="epc-gl-kpis" aria-label="GL KPIs">
        <div class="epc-gl-kpi"><strong>@_journals.Count</strong><span>Shown (limit @_limit)</span></div>
        <div class="epc-gl-kpi"><strong>@_posted</strong><span>Posted in page</span></div>
        <div class="epc-gl-kpi"><strong>@_totalDebit.ToString("N2", CultureInfo.InvariantCulture)</strong><span>Page total debit</span></div>
    </div>

    <div class="epc-gl-table-wrap">
        <table class="epc-gl-table">
            <thead>
                <tr>
                    <th>Journal #</th>
                    <th>Date</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Total debit</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_journals.Count == 0)
                {
                    <tr><td colspan="6">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var j in _journals)
                    {
                        var phpHref = $"{_phpTab}&journal_id={j.Id.ToString(CultureInfo.InvariantCulture)}";
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(j.JournalNo) ? $"#{j.Id}" : j.JournalNo)</strong></td>
                            <td>@FormatTime(j.JournalDate)</td>
                            <td>@(string.IsNullOrWhiteSpace(j.SourceType) ? "—" : j.SourceType)@(j.SourceId > 0 ? $" #{j.SourceId}" : "")</td>
                            <td><span class="epc-gl-badge">@j.Status</span></td>
                            <td>@j.TotalDebit.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a href="@phpHref">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=finance&tab=gl";
    private bool _isAdmin;
    private IReadOnlyList<ErpGlJournalDigest> _journals = [];
    private int _posted;
    private decimal _totalDebit;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("erp"))
        {
            Nav.NavigateTo("/erp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.ListErpGlJournalsAsync(_limit, ctx.RequestAborted);
        _journals = result.Journals;
        _posted = _journals.Count(j => string.Equals(j.Status, "posted", StringComparison.OrdinalIgnoreCase));
        _totalDebit = _journals.Sum(j => j.TotalDebit);
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
