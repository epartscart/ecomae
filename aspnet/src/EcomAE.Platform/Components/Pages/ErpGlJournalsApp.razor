@page "/erp/gl-journals-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>General Ledger · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="General Ledger" BreadcrumbArea="Record to Report" BreadcrumbTab="General ledger">

    
    <PhpErpModulePageHeader Title="General Ledger Journals" Subtitle="Live shop digest. Writes stay on ERP ajax." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />


    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="GL KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_journals.Count</div></div>
        <div class="kpi"><div class="lbl">Posted in page</div><div class="val">@_posted</div></div>
        <div class="kpi"><div class="lbl">Page total debit</div><div class="val">@_totalDebit.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Journal #</th>
                    <th>Date</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Total debit</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_journals.Count == 0)
                {
                    <tr><td colspan="6">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "Nothing to show yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var j in _journals)
                    {
                        var phpHref = $"{_phpTab}&journal_id={j.Id.ToString(CultureInfo.InvariantCulture)}";
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(j.JournalNo) ? $"#{j.Id}" : j.JournalNo)</strong></td>
                            <td>@FormatTime(j.JournalDate)</td>
                            <td>@(string.IsNullOrWhiteSpace(j.SourceType) ? "—" : j.SourceType)@(j.SourceId > 0 ? $" #{j.SourceId}" : "")</td>
                            <td><span class="label label-default">@j.Status</span></td>
                            <td>@j.TotalDebit.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(phpHref)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=finance&tab=gl";
    private bool _isAdmin;
    private IReadOnlyList<ErpGlJournalDigest> _journals = [];
    private int _posted;
    private decimal _totalDebit;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListErpGlJournalsAsync(_limit, ctx.RequestAborted);
        _journals = result.Journals;
        _posted = _journals.Count(j => string.Equals(j.Status, "posted", StringComparison.OrdinalIgnoreCase));
        _totalDebit = _journals.Sum(j => j.TotalDebit);
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
