@page "/storefront/product-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject IHttpContextAccessor Http

<PageTitle>@(_product?.Caption ?? "Product") · eParts Cart</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        
        .epc-sf-pd-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-sf-pd-cta a {
            display:inline-flex; padding:.5rem .85rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#fff; background:#dc2626;
        }
        .epc-sf-pd-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); }
        .epc-sf-pd-grid { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,1fr); gap:1rem; }
        .epc-sf-pd-card { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:1rem; }
        .epc-sf-pd-card h2 { margin:0 0 .55rem; font-size:1rem; }
        .epc-sf-pd-meta { margin:0; padding:0; list-style:none; font-size:.9rem; color:#334155; }
        .epc-sf-pd-meta li { margin:0 0 .35rem; }
        .epc-sf-pd-gallery { display:grid; grid-template-columns:repeat(auto-fill,minmax(110px,1fr)); gap:.55rem; }
        .epc-sf-pd-gallery a {
            display:block; border:1px solid #e2e8f0; border-radius:.45rem; overflow:hidden; background:#f8fafc;
            aspect-ratio:1; text-decoration:none;
        }
        .epc-sf-pd-gallery img { width:100%; height:100%; object-fit:contain; display:block; }
        .epc-sf-pd-specs { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-sf-pd-specs th, .epc-sf-pd-specs td { padding:.45rem .55rem; border-bottom:1px solid #f1f5f9; text-align:left; vertical-align:top; }
        .epc-sf-pd-specs th { width:38%; color:#64748b; font-weight:700; }
        .epc-sf-pd-group { margin:0 0 1rem; }
        .epc-sf-pd-group h3 { margin:0 0 .45rem; font-size:.92rem; color:#0f172a; }
        .epc-sf-pd-empty { padding:1.25rem; background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; }
        .epc-sf-pd-note { margin-top:1rem; padding:.75rem .9rem; background:#fff8e8; border:1px solid #f1d49a; border-radius:.45rem; color:#7a4e00; font-size:.86rem; }
        @@media (max-width:900px){ .epc-sf-pd-grid{grid-template-columns:1fr;} }
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<PhpStorefrontDesktopChrome>

    @if (_product is null)
    {
        <PhpStorefrontPageHeader Title="Product" Subtitle="Catalogue product with media and specifications. Add ?id= for a product row.">
            <a class="btn btn-sm btn-primary" href="@StorefrontSurfaceLinks.PartSearch">Part search</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Wishlist">Bookmarks</a>
        </PhpStorefrontPageHeader>
        <div class="epc-sf-pd-empty">
            @if (ProductId is null or <= 0)
            {
                <span>Provide a product id, e.g. <code>/storefront/product-app?id=123</code>.</span>
            }
            else
            {
                <span>Product #@ProductId not found (<code>@_source</code>). @_message</span>
            }
        </div>
    }
    else
    {
        <PhpStorefrontPageHeader Title="@_product.Caption" Subtitle="@ProductSubtitle">
            <a class="btn btn-sm btn-primary" href="@PhpProductCompareHref" title="Temporary PHP compare only">Compare PHP reference</a>
            <a class="btn btn-sm btn-default" href="@BrandArticleSearchHref">Warehouse search</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Wishlist">Bookmarks</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Cart">Cart</a>
        </PhpStorefrontPageHeader>

        <div class="epc-sf-pd-grid">
            <div class="epc-sf-pd-card">
                <h2>Media</h2>
                @if ((_product.Images?.Count ?? 0) == 0)
                {
                    <p style="margin:0;color:#64748b;font-size:.88rem">No gallery images on this product yet.</p>
                }
                else
                {
                    <div class="epc-sf-pd-gallery" aria-label="Product gallery">
                        @foreach (var img in _product.Images!)
                        {
                            <a href="@img.Url" target="_blank" rel="noopener">
                                <img src="@img.Url" alt="@(string.IsNullOrWhiteSpace(img.Alt) ? _product.Caption : img.Alt)" loading="lazy" />
                            </a>
                        }
                    </div>
                }
            </div>
            <div class="epc-sf-pd-card">
                <h2>Details</h2>
                <ul class="epc-sf-pd-meta">
                    <li><strong>Id:</strong> @_product.Id</li>
                    <li><strong>Alias:</strong> @(string.IsNullOrWhiteSpace(_product.Alias) ? "—" : _product.Alias)</li>
                    <li><strong>Category:</strong> @_product.CategoryId</li>
                    <li><strong>Manufacturer:</strong> @(string.IsNullOrWhiteSpace(_product.Manufacturer) ? "—" : _product.Manufacturer)</li>
                    <li><strong>Article:</strong> @(string.IsNullOrWhiteSpace(_product.Article) ? "—" : _product.Article)</li>
                    <li><strong>Published:</strong> @(_product.Published ? "Yes" : "No")</li>
                </ul>
                @if (!string.IsNullOrWhiteSpace(_product.Description))
                {
                    <p style="margin:.75rem 0 0;color:#334155;font-size:.9rem;line-height:1.45">@_product.Description</p>
                }
            </div>
        </div>

        <div class="epc-sf-pd-card" style="margin-top:1rem">
            <h2>Specifications</h2>
            @if ((_product.Specs?.Count ?? 0) == 0)
            {
                <p style="margin:0;color:#64748b;font-size:.88rem">No SKU specification rows for this product.</p>
            }
            else
            {
                @foreach (var group in _product.Specs!.GroupBy(s => s.GroupName))
                {
                    <div class="epc-sf-pd-group">
                        <h3>@group.Key</h3>
                        <table class="epc-sf-pd-specs">
                            <tbody>
                            @foreach (var spec in group)
                            {
                                <tr>
                                    <th scope="row">@spec.Label</th>
                                    <td>@spec.Value@(string.IsNullOrWhiteSpace(spec.Unit) ? "" : " " + spec.Unit)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>

        <div class="epc-sf-pd-card" style="margin-top:1rem">
            <h2>Actions</h2>
            <p style="margin:0 0 .75rem;color:#64748b;font-size:.88rem">
                Add to cart / bookmark / compare writes stay on PHP (session + cookies).
            </p>
            <div class="epc-sf-pd-cta" style="margin:0">
                <a class="btn btn-sm btn-primary" href="@StorefrontSurfaceLinks.Cart">Cart</a>
                <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Wishlist">Bookmarks</a>
                <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Compare">Compare</a>
            </div>
        </div>
        <p class="epc-sf-pd-note">
            ASP.NET product digest includes catalogue gallery + SKU media/specs (PHP <code>epc_sku_media</code>).
            Cart / bookmark / compare writes remain PHP-authoritative under /php-reference/* until cutover.
        </p>
    }
</PhpStorefrontDesktopChrome>

@code {
    private StorefrontProductDigest? _product;
    private string _source = "n/a";
    private string _message = "";

    [SupplyParameterFromQuery(Name = "id")]
    public int? ProductId { get; set; }

    private string ProductSubtitle
    {
        get
        {
            if (_product is null) return "";
            var mfr = string.IsNullOrWhiteSpace(_product.Manufacturer) ? "" : _product.Manufacturer + " · ";
            var art = string.IsNullOrWhiteSpace(_product.Article) ? ("#" + _product.Id) : _product.Article;
            return mfr + art;
        }
    }

    private string PhpProductCompareHref =>
        "/php-reference" + (
            !string.IsNullOrWhiteSpace(_product?.Alias)
                ? "/" + _product!.Alias.TrimStart('/')
                : StorefrontPhpCanonical.PartSearch);

    private string BrandArticleSearchHref
    {
        get
        {
            if (_product is null || string.IsNullOrWhiteSpace(_product.Article))
            {
                return StorefrontSurfaceLinks.PartSearch;
            }

            var href = "/storefront/search-app?article=" + Uri.EscapeDataString(_product.Article);
            if (!string.IsNullOrWhiteSpace(_product.Manufacturer))
            {
                href += "&brand=" + Uri.EscapeDataString(_product.Manufacturer);
            }

            return href;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (ProductId is null or <= 0)
        {
            return;
        }

        var result = await Dashboards.GetStorefrontProductAsync(ProductId.Value, Http.HttpContext?.RequestAborted ?? default);
        _product = result.Product;
        _source = result.Source;
        _message = result.Message;
    }
}
