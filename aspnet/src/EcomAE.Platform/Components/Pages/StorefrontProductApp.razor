@page "/storefront/product-app"
@page "/en/shop/product"
@page "/shop/product"
@page "/en/shop/catalogue/product"
@page "/shop/catalogue/product"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject IHttpContextAccessor Http

<PageTitle>@(_product?.Caption ?? "Product") · eParts Cart</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        .product_info_wrap { position:relative; padding:10px; margin:0 auto; min-height:280px; }
        .product_galery { width:100%; max-width:450px; }
        .product_genaral_info { margin-top:1rem; }
        .main_image > IMG, #main_image { max-width:400px; max-height:400px; display:block; }
        .product_image_select { padding:4px; border-radius:4px; max-width:45px; max-height:45px; }
        .current_image { cursor:default; border:1px solid #C33; }
        .other_image { cursor:pointer; border:1px solid #DDD; }
        .other_image:hover { border:1px solid #BABABA; }
        .product_div_manufacturer, .product_div_article { font-weight:700; margin:.2rem 0; }
        .product_div_article_button { margin:.35rem 0 .75rem; }
        .product_div_tile { margin:.75rem 0; }
        .product_div_count_need { display:inline-flex; align-items:center; gap:.25rem; }
        .count_need_minus, .count_need_plus { display:inline-block; min-width:1.4rem; text-align:center; border:1px solid #ddd; border-radius:3px; color:#334155; }
        .count_need_input { width:3.5rem; padding:.3rem; text-align:center; }
        .product_div_bookmark, .product_div_compare { display:inline-block; margin:.35rem .5rem .35rem 0; }
        .product_div_bookmark button, .product_div_compare button, .btn_cart_div button {
            padding:.5rem .85rem; border-radius:.4rem; font-weight:800; cursor:pointer;
        }
        @@media (min-width:900px){
            .product_info_wrap { display:grid; grid-template-columns:minmax(0,450px) minmax(0,1fr); gap:1.25rem; align-items:start; }
            .product_galery, .product_genaral_info { position:static; margin-top:0; }
        }
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontTenantChrome>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
    }

    @if (_product is null)
    {
        <PhpStorefrontPageHeader Title="Product" Subtitle="Catalogue product with media and specifications. Add ?id= for a product row.">
            <a class="btn btn-sm btn-primary" href="@StorefrontSurfaceLinks.PartSearch">Part search</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Wishlist">Bookmarks</a>
        </PhpStorefrontPageHeader>
        <div class="product_info_wrap" id="product_info_wrap_div">
            @if (ProductId is null or <= 0)
            {
                <span>Provide a product id, e.g. <code>/storefront/product-app?id=123</code>.</span>
            }
            else
            {
                <span>Product #@ProductId not found (<code>@_source</code>). @_message</span>
            }
        </div>
    }
    else
    {
        <PhpStorefrontPageHeader Title="@_product.Caption" Subtitle="@ProductSubtitle">
            <a class="btn btn-sm btn-primary" href="@BrandArticleSearchHref">Warehouse search</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Wishlist">Bookmarks</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Cart">Cart</a>
        </PhpStorefrontPageHeader>

        <div class="product_info_wrap" id="product_info_wrap_div">
            <div class="product_galery" id="product_galery_div">
                <div class="main_image" id="main_image_div">
                    <img id="main_image" src="@PrimaryImageUrl" alt="@_product.Caption" />
                </div>
                <div class="all_product_images" id="all_product_images_div" aria-label="Product gallery">
                    @if (_product.Images is { Count: > 0 })
                    {
                        @for (var imageIndex = 0; imageIndex < _product.Images.Count; imageIndex++)
                        {
                            var img = _product.Images[imageIndex];
                            var imageKey = img.Id > 0 ? img.Id : imageIndex;
                            var thumbClass = imageIndex == 0 ? "product_image_select current_image" : "product_image_select other_image";
                            <img id="@("product_image_select_" + imageKey.ToString(CultureInfo.InvariantCulture))"
                                 class="@thumbClass"
                                 src="@img.Url"
                                 alt="@(string.IsNullOrWhiteSpace(img.Alt) ? _product.Caption : img.Alt)"
                                 loading="lazy"
                                 data-image-id="@imageKey.ToString(CultureInfo.InvariantCulture)"
                                 data-image-url="@img.Url"
                                 onclick="selectImage(this.getAttribute('data-image-id'), this.getAttribute('data-image-url'))" />
                        }
                    }
                </div>
            </div>

            <div class="product_genaral_info" id="product_genaral_info_div">
                <div class="product_div_manufacturer">@(string.IsNullOrWhiteSpace(_product.Manufacturer) ? "—" : _product.Manufacturer)</div>
                <div class="product_div_article">@(string.IsNullOrWhiteSpace(_product.Article) ? ("#" + _product.Id) : _product.Article)</div>
                <div class="product_div_article_button">
                    <a target="_blank" title="All prices" href="@BrandArticleSearchHref">All prices <i class="fa fa-search"></i></a>
                </div>

                @if ((_product.Specs?.Count ?? 0) > 0)
                {
                    <table>
                        @foreach (var spec in _product.Specs!)
                        {
                            <tr>
                                <td style="vertical-align:top;"><font style="font-weight:bold; margin-right:10px;">@spec.Label</font></td>
                                <td style="vertical-align:top;">@spec.Value@(string.IsNullOrWhiteSpace(spec.Unit) ? "" : " " + spec.Unit)</td>
                            </tr>
                        }
                    </table>
                }

                @if (!string.IsNullOrWhiteSpace(_product.Description))
                {
                    <p style="margin:.75rem 0 0;color:#334155;font-size:.9rem;line-height:1.45">@_product.Description</p>
                }

                <div class="product_div_tile">
                    <div class="btn_cart_div">
                        <div class="btn_cart_div_text">
                            <div class="btn-ar btn-primary cart_btn_purchase_action">
                                <form method="get" action="@StorefrontSurfaceLinks.Cart" style="margin:0">
                                    <input type="hidden" name="product_id" value="@_product.Id.ToString(CultureInfo.InvariantCulture)" />
                                    <table>
                                        <tr>
                                            <td>
                                                <div class="product_div_count_need">
                                                    <a class="count_need_minus" href="javascript:void(0);" onclick="adjustCountNeed(-1);">-</a>
                                                    <input class="count_need_input count_need_product" type="text" name="count_need" value="1" />
                                                    <a class="count_need_plus" href="javascript:void(0);" onclick="adjustCountNeed(1);">+</a>
                                                </div>
                                            </td>
                                            <td>
                                                <button type="submit" style="border:0;background:transparent;color:#fff;font-weight:800;cursor:pointer">Add to cart</button>
                                            </td>
                                        </tr>
                                    </table>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="product_div_bookmark">
                    @if (_inWishlist)
                    {
                        <form method="post" action="@PhpCustomerWrites.WishlistRemoveHref" style="margin:0">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@("/storefront/product-app?id=" + _product.Id.ToString(CultureInfo.InvariantCulture))" />
                            <input type="hidden" name="product_id" value="@_product.Id.ToString(CultureInfo.InvariantCulture)" />
                            <button type="submit" style="border:1px solid #d1d5db;background:#fff">Remove bookmark</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" action="@PhpCustomerWrites.WishlistWriteHref" style="margin:0">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@("/storefront/product-app?id=" + _product.Id.ToString(CultureInfo.InvariantCulture))" />
                            <input type="hidden" name="product_id" value="@_product.Id.ToString(CultureInfo.InvariantCulture)" />
                            <button type="submit" style="border:0;background:#0f766e;color:#fff">Add bookmark</button>
                        </form>
                    }
                </div>
                <div class="product_div_compare">
                    @if (_inCompare)
                    {
                        <form method="post" action="@PhpCustomerWrites.CompareRemoveHref" style="margin:0">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@("/storefront/product-app?id=" + _product.Id.ToString(CultureInfo.InvariantCulture))" />
                            <input type="hidden" name="product_id" value="@_product.Id.ToString(CultureInfo.InvariantCulture)" />
                            <button type="submit" style="border:1px solid #d1d5db;background:#fff">Remove compare</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" action="@PhpCustomerWrites.CompareWriteHref" style="margin:0">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@("/storefront/product-app?id=" + _product.Id.ToString(CultureInfo.InvariantCulture))" />
                            <input type="hidden" name="product_id" value="@_product.Id.ToString(CultureInfo.InvariantCulture)" />
                            <button type="submit" style="border:0;background:#334155;color:#fff">Add to compare</button>
                        </form>
                    }
                </div>

                <div id="evaluations_general_mark_home">
                    @if (_reviews.Count > 0)
                    {
                        <div class="evaluations_mark">
                            @{
                                var avg = (int)Math.Round(_reviews.Average(r => r.Rating));
                            }
                            @for (var star = 1; star <= 5; star++)
                            {
                                <i class="fa @(star <= avg ? "fa-star" : "fa-star-o") em-primary"></i>
                            }
                        </div>
                        <ul style="margin:.65rem 0 0;padding:0;list-style:none">
                            @foreach (var review in _reviews)
                            {
                                <li style="margin:0 0 .75rem;padding:.7rem .8rem;background:#f8fafc;border:1px solid #e2e8f0;border-radius:.45rem">
                                    <strong>@review.Rating / 5</strong>
                                    <span style="color:#64748b;font-size:.82rem"> · @review.Author · @review.Date</span>
                                    <p style="margin:.35rem 0 0;color:#334155">@review.Text</p>
                                </li>
                            }
                        </ul>
                    }
                </div>
                <form method="post" action="@PhpCustomerWrites.EvaluationWriteHref" style="margin:.85rem 0 0">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@("/storefront/product-app?id=" + _product.Id.ToString(CultureInfo.InvariantCulture))" />
                    <input type="hidden" name="product_id" value="@_product.Id.ToString(CultureInfo.InvariantCulture)" />
                    <label style="display:block;margin:.25rem 0">Rating
                        <select name="mark" style="margin-left:.35rem;padding:.35rem">
                            <option value="5">5</option>
                            <option value="4">4</option>
                            <option value="3">3</option>
                            <option value="2">2</option>
                            <option value="1">1</option>
                        </select>
                    </label>
                    <label style="display:block;margin:.65rem 0 .25rem">Review</label>
                    <textarea name="text" rows="3" required style="width:100%;padding:.45rem"></textarea>
                    <button type="submit" style="margin-top:.75rem;padding:.5rem .85rem;border:0;border-radius:.4rem;background:#0f766e;color:#fff;font-weight:800;cursor:pointer">Submit review</button>
                </form>
            </div>
        </div>
        <p class="lead" style="margin-top:1rem;padding:.75rem .9rem;background:#fff8e8;border:1px solid #f1d49a;border-radius:.45rem;color:#7a4e00;font-size:.86rem">
            Gallery and specs stay on this product card. Cart, bookmarks, and compare stay on this storefront.
        </p>
        <script>
        var current_image_id = "@PrimaryImageKey.ToString(CultureInfo.InvariantCulture)";
        function selectImage(id, image_url) {
            id = String(id || "");
            if (String(current_image_id) === id) { return; }
            var prev = document.getElementById("product_image_select_" + current_image_id);
            if (prev) { prev.setAttribute("class", "product_image_select other_image"); }
            var next = document.getElementById("product_image_select_" + id);
            if (next) { next.setAttribute("class", "product_image_select current_image"); }
            current_image_id = id;
            var main = document.getElementById("main_image");
            if (main) { main.setAttribute("src", image_url); }
        }
        function adjustCountNeed(delta) {
            var input = document.querySelector(".count_need_input");
            if (!input) { return; }
            var n = parseInt(input.value || "1", 10);
            if (isNaN(n)) { n = 1; }
            n = Math.max(1, n + delta);
            input.value = n;
        }
        </script>
    }
</StorefrontTenantChrome>

@code {
    private StorefrontProductDigest? _product;
    private string _source = "n/a";
    private string _message = "";
    private IReadOnlyList<PhpProductReviews.Review> _reviews = [];
    private string _flashOk = "";
    private string _flashErr = "";
    private bool _inWishlist;
    private bool _inCompare;

    [SupplyParameterFromQuery(Name = "id")]
    public int? ProductId { get; set; }

    private string ProductSubtitle
    {
        get
        {
            if (_product is null) return "";
            var mfr = string.IsNullOrWhiteSpace(_product.Manufacturer) ? "" : _product.Manufacturer + " · ";
            var art = string.IsNullOrWhiteSpace(_product.Article) ? ("#" + _product.Id) : _product.Article;
            return mfr + art;
        }
    }

    private string PrimaryImageUrl =>
        _product?.Images?.FirstOrDefault(i => i.IsPrimary)?.Url
        ?? _product?.Images?.FirstOrDefault()?.Url
        ?? "/content/files/images/no_image.png";

    private int PrimaryImageKey
    {
        get
        {
            var first = _product?.Images?.FirstOrDefault(i => i.IsPrimary) ?? _product?.Images?.FirstOrDefault();
            if (first is null)
            {
                return 0;
            }

            return first.Id > 0 ? first.Id : 0;
        }
    }

    private string BrandArticleSearchHref
    {
        get
        {
            if (_product is null || string.IsNullOrWhiteSpace(_product.Article))
            {
                return StorefrontSurfaceLinks.PartSearch;
            }

            var href = "/storefront/search-app?article=" + Uri.EscapeDataString(_product.Article);
            if (!string.IsNullOrWhiteSpace(_product.Manufacturer))
            {
                href += "&brand=" + Uri.EscapeDataString(_product.Manufacturer);
            }

            return href;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _flashOk = ctx?.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx?.Request.Query["err"].ToString() ?? "";
        if (ctx is not null && ProductId is > 0)
        {
            _inWishlist = StorefrontIntListCookie.Read(ctx.Request, StorefrontIntListCookie.BookmarksName, StorefrontIntListCookie.BookmarksMax).Contains(ProductId.Value);
            _inCompare = StorefrontIntListCookie.Read(ctx.Request, StorefrontIntListCookie.CompareName, StorefrontIntListCookie.CompareMax).Contains(ProductId.Value);
        }

        if (ProductId is null or <= 0)
        {
            return;
        }

        var result = await Dashboards.GetStorefrontProductAsync(ProductId.Value, ctx?.RequestAborted ?? default);
        _product = result.Product;
        _source = result.Source;
        _message = result.Message;
        _reviews = PhpProductReviews.ForProduct(ProductId.Value);
    }
}
