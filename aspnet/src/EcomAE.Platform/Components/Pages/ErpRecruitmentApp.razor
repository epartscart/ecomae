@page "/erp/recruitment-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Routing
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Recruitment · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Recruitment" BreadcrumbArea="People" BreadcrumbTab="Recruitment">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/recruitment-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Recruitment pipeline" Subtitle="Open a job or applicant for the 280-character notes excerpt. Job save, applicant add, and stage stay on this page." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Recruitment KPIs">
        <div class="kpi"><div class="lbl">Jobs</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open</div><div class="val">@_open.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Applicants</div><div class="val">@_applicantCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {        <ErpPhpCreateWell Title="Move applicant">
<form method="post" action="/erp/recruitment/applicants/stage" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="returnUrl" value="/erp/recruitment-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Applicant
                    <select class="form-control input-sm" name="id">
                        <option value="0">(select)</option>
                        @foreach (var app in _applicants)
                        {
                            <option value="@app.Id.ToString(CultureInfo.InvariantCulture)">@(string.IsNullOrWhiteSpace(app.Name) ? $"#{app.Id.ToString(CultureInfo.InvariantCulture)}" : app.Name)</option>
                        }
                    </select>
                </label>
                <label>Stage
                    <select class="form-control input-sm" name="stage">
                        <option value="applied">applied</option>
                        <option value="screening">screening</option>
                        <option value="interview">interview</option>
                        <option value="offer">offer</option>
                        <option value="hired">hired</option>
                        <option value="rejected">rejected</option>
                    </select>
                </label>
                <button type="submit" class="btn btn-primary btn-sm">Move</button>
            </form>
</ErpPhpCreateWell>
        <ErpPhpCreateWell Title="New applicant">
<form method="post" action="@EcomAeRoutes.ErpRecruitmentApplicantAdd" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="returnUrl" value="/erp/recruitment-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Job
                    <select class="form-control input-sm" name="job_id">
                        <option value="0">(select)</option>
                        @foreach (var job in _jobs)
                        {
                            <option value="@job.Id.ToString(CultureInfo.InvariantCulture)">@(string.IsNullOrWhiteSpace(job.Title) ? $"#{job.Id.ToString(CultureInfo.InvariantCulture)}" : job.Title)</option>
                        }
                    </select>
                </label>
                <label>Name <input class="form-control input-sm" name="name" placeholder="Name" style="width:160px;" required /></label>
                <label>Email <input class="form-control input-sm" name="email" placeholder="Email" style="width:160px;" /></label>
                <label>Phone <input class="form-control input-sm" name="phone" placeholder="Phone" style="width:120px;" /></label>
                <label>Rating <input class="form-control input-sm" name="rating" value="0" style="width:60px;" /></label>
                <label>Notes <input class="form-control input-sm" name="notes" placeholder="Notes" style="width:160px;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Add</button>
            </form>
</ErpPhpCreateWell>
        <ErpPhpCreateWell Title="New job">
        <form method="post" action="@EcomAeRoutes.ErpRecruitmentJobSave" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="returnUrl" value="/erp/recruitment-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Title <input class="form-control input-sm" name="title" placeholder="Title" style="width:180px;" required /></label>
                <label>Department <input class="form-control input-sm" name="department" placeholder="Department" style="width:140px;" /></label>
                <label>Headcount <input class="form-control input-sm" name="headcount" value="1" style="width:70px;" /></label>
                <label>Manager <input class="form-control input-sm" name="hiring_manager" placeholder="Manager" style="width:140px;" /></label>
                <label>Notes <input class="form-control input-sm" name="notes" placeholder="Notes" style="width:180px;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
            </form>
        </ErpPhpCreateWell>
    }

    @if (_openedJob is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedJobCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedJobReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Id</dt><dd>@_openedJob.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Title</dt><dd>@(string.IsNullOrWhiteSpace(_openedJob.Title) ? "—" : _openedJob.Title)</dd>
                <dt>Department</dt><dd>@(string.IsNullOrWhiteSpace(_openedJob.Department) ? "—" : _openedJob.Department)</dd>
                <dt>Headcount</dt><dd>@_openedJob.Headcount.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Hired</dt><dd>@_openedJob.Hired.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Manager</dt><dd>@(string.IsNullOrWhiteSpace(_openedJob.HiringManager) ? "—" : _openedJob.HiringManager)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_openedJob.Status) ? "—" : _openedJob.Status)</dd>
                <dt>Company</dt><dd>@(_openedJob.CompanyId > 0 ? _openedJob.CompanyId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Created</dt><dd>@FormatTime(_openedJob.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Job save, applicant add, and stage stay on this page. Schema-ensure stays Classic.</p>
            @if (!string.IsNullOrWhiteSpace(_openedJob.NotesExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">notes excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedJob.NotesExcerpt</pre>
                @if (_openedJob.NotesLen > _openedJob.NotesExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_openedJob.NotesExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedJob.NotesLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No notes excerpt yet.</p>
            }
            @if (_openedJobSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Department</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedJobSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Title) ? "—" : sib.Title)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Department) ? "—" : sib.Department)</td>
                                <td>@sib.Status</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "hrt_job_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    @if (_openedApplicant is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedApplicantCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedApplicantReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Id</dt><dd>@_openedApplicant.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_openedApplicant.Name) ? "—" : _openedApplicant.Name)</dd>
                <dt>Job</dt><dd>@(_openedApplicant.JobId > 0 ? _openedApplicant.JobId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Stage</dt><dd>@(string.IsNullOrWhiteSpace(_openedApplicant.Stage) ? "—" : _openedApplicant.Stage)</dd>
                <dt>Rating</dt><dd>@_openedApplicant.Rating.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Company</dt><dd>@(_openedApplicant.CompanyId > 0 ? _openedApplicant.CompanyId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Created</dt><dd>@FormatTime(_openedApplicant.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">email/phone stay off this pane. Job save, applicant add, and stage stay on this page.</p>
            @if (!string.IsNullOrWhiteSpace(_openedApplicant.NotesExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">notes excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedApplicant.NotesExcerpt</pre>
                @if (_openedApplicant.NotesLen > _openedApplicant.NotesExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_openedApplicant.NotesExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedApplicant.NotesLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No notes excerpt yet.</p>
            }
            @if (_openedApplicantSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-stage siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Job</th>
                            <th>Stage</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedApplicantSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Name) ? "—" : sib.Name)</td>
                                <td>@(sib.JobId > 0 ? sib.JobId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                                <td>@sib.Stage</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "applicant_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-stage siblings yet.</p>
            }
        </div>
    }

    <h2 style="font-size:16px;">Jobs</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Title</th><th>Department</th><th class="text-right">Headcount</th><th class="text-right">Hired</th><th>Manager</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @if (_jobs.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No job requisitions yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _jobs)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedJobId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Title) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Title)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Department) ? "—" : row.Department)</td>
                            <td class="text-right">@row.Headcount.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.Hired.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.HiringManager) ? "—" : row.HiringManager)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "hrt_job_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="font-size:16px;">Applicants</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Name</th><th>Job</th><th>Email</th><th>Phone</th><th>Stage</th><th class="text-right">Rating</th><th></th></tr></thead>
            <tbody>
                @if (_applicants.Count == 0) { <tr><td colspan="7">No applicants yet.</td></tr> }
                else
                {
                    @foreach (var row in _applicants)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedApplicantId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Name) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Name)</strong></td>
                            <td>@(row.JobId > 0 ? row.JobId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Email) ? "—" : row.Email)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Phone) ? "—" : row.Phone)</td>
                            <td><span class="label label-default">@row.Stage</span></td>
                            <td class="text-right">@row.Rating.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "applicant_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
        Job save, applicant add, and stage are live when confirmed. Schema-ensure stays Classic.
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=hr&tab=recruitment";
    private const string _listHref = "/erp/recruitment-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpRecruitmentJobDigest> _jobs = [];
    private IReadOnlyList<ErpRecruitmentApplicantDigest> _applicants = [];
    private int _count, _open, _applicantCount;
    private string _source = "n/a";
    private string _message = "";
    private long _openedJobId;
    private long _openedApplicantId;
    private ErpRecruitmentJobDetail? _openedJob;
    private ErpRecruitmentApplicantDetail? _openedApplicant;
    private IReadOnlyList<ErpRecruitmentJobDigest> _openedJobSiblings = [];
    private IReadOnlyList<ErpRecruitmentApplicantDigest> _openedApplicantSiblings = [];

    private long _openedId => _openedJobId > 0 ? _openedJobId : _openedApplicantId;

    private bool OpenedFound => _openedJob is not null || _openedApplicant is not null;

    private string OpenedJobReturnHref => _openedJobId > 0
        ? _listHref + "?hrt_job_id=" + _openedJobId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedApplicantReturnHref => _openedApplicantId > 0
        ? _listHref + "?applicant_id=" + _openedApplicantId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedJobCaption => _openedJob is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedJob.Title)
            ? ("Job #" + _openedJob.Id.ToString(CultureInfo.InvariantCulture))
            : _openedJob.Title)
            + (string.IsNullOrWhiteSpace(_openedJob.Status) ? "" : (" · " + _openedJob.Status));

    private string OpenedApplicantCaption => _openedApplicant is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedApplicant.Name)
            ? ("Applicant #" + _openedApplicant.Id.ToString(CultureInfo.InvariantCulture))
            : _openedApplicant.Name)
            + (string.IsNullOrWhiteSpace(_openedApplicant.Stage) ? "" : (" · " + _openedApplicant.Stage));

    private string OpenedCaption => _openedJob is not null ? OpenedJobCaption : OpenedApplicantCaption;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _openedJobId = ErpRecordOpen.ReadId(ctx.Request, "hrt_job_id");
        _openedApplicantId = ErpRecordOpen.ReadId(ctx.Request, "applicant_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpRecruitmentDigestAsync(200, ctx.RequestAborted);
        _jobs = result.Jobs;
        _applicants = result.Applicants;
        _count = result.Count;
        _open = result.OpenJobCount;
        _applicantCount = result.ApplicantCount;
        _source = result.Source;
        _message = result.Message;

        if (_openedJobId > 0)
        {
            var detail = await Dashboards.BuildErpRecruitmentJobDetailAsync(_openedJobId, ctx.RequestAborted);
            _openedJob = detail.Job;
            _openedJobSiblings = detail.Siblings;
            if (_openedJob is not null)
            {
                var openedList = _jobs.FirstOrDefault(j => j.Id == _openedJobId);
                if (openedList is not null)
                {
                    _jobs = new[] { openedList }.Concat(_jobs.Where(j => j.Id != _openedJobId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }

        if (_openedApplicantId > 0)
        {
            var detail = await Dashboards.BuildErpRecruitmentApplicantDetailAsync(_openedApplicantId, ctx.RequestAborted);
            _openedApplicant = detail.Applicant;
            _openedApplicantSiblings = detail.Siblings;
            if (_openedApplicant is not null)
            {
                var openedList = _applicants.FirstOrDefault(a => a.Id == _openedApplicantId);
                if (openedList is not null)
                {
                    _applicants = new[] { openedList }.Concat(_applicants.Where(a => a.Id != _openedApplicantId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message) && _openedJob is null)
            {
                _message = detail.Message;
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
