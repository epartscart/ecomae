@page "/erp/recruitment-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Recruitment · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Recruitment" BreadcrumbArea="People" BreadcrumbTab="Recruitment">
    <PhpErpModulePageHeader Title="Recruitment pipeline" Subtitle="Job requisitions and applicants. Job save is live-gated; applicant add stays Classic." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    <ErpPhpFlash Ok="@_ok" Err="@_err" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Recruitment KPIs">
        <div class="kpi"><div class="lbl">Jobs</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open</div><div class="val">@_open.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Applicants</div><div class="val">@_applicantCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <ErpPhpCreateWell Title="New job">
            <form method="post" action="@EcomAeRoutes.ErpRecruitmentJobSave" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="returnUrl" value="/erp/recruitment-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Title <input class="form-control input-sm" name="title" placeholder="Title" style="width:180px;" required /></label>
                <label>Department <input class="form-control input-sm" name="department" placeholder="Department" style="width:140px;" /></label>
                <label>Headcount <input class="form-control input-sm" name="headcount" value="1" style="width:70px;" /></label>
                <label>Manager <input class="form-control input-sm" name="hiring_manager" placeholder="Manager" style="width:140px;" /></label>
                <label>Notes <input class="form-control input-sm" name="notes" placeholder="Notes" style="width:180px;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
            </form>
        </ErpPhpCreateWell>
    }

    <h2 style="font-size:16px;">Jobs</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Title</th><th>Department</th><th class="text-right">Headcount</th><th class="text-right">Hired</th><th>Manager</th><th>Status</th></tr></thead>
            <tbody>
                @if (_jobs.Count == 0)
                {
                    <tr><td colspan="6">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No job requisitions yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _jobs)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Title) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Title)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Department) ? "—" : row.Department)</td>
                            <td class="text-right">@row.Headcount.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-right">@row.Hired.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.HiringManager) ? "—" : row.HiringManager)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="font-size:16px;">Applicants</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Name</th><th>Job</th><th>Email</th><th>Phone</th><th>Stage</th><th class="text-right">Rating</th></tr></thead>
            <tbody>
                @if (_applicants.Count == 0) { <tr><td colspan="6">No applicants yet.</td></tr> }
                else
                {
                    @foreach (var row in _applicants)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Name) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Name)</strong></td>
                            <td>@(row.JobId > 0 ? row.JobId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Email) ? "—" : row.Email)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Phone) ? "—" : row.Phone)</td>
                            <td><span class="label label-default">@row.Stage</span></td>
                            <td class="text-right">@row.Rating.ToString(CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Job save is live-gated (<code>hrt_job_save</code>). Applicant add stays Classic.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=hr&tab=recruitment";
    private bool _isAdmin;
    private IReadOnlyList<ErpRecruitmentJobDigest> _jobs = [];
    private IReadOnlyList<ErpRecruitmentApplicantDigest> _applicants = [];
    private int _count, _open, _applicantCount;
    private string _source = "n/a";
    private string _message = "";
    private string _ok = "";
    private string _err = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _ok = ctx.Request.Query["ok"].ToString();
        _err = ctx.Request.Query["err"].ToString();
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpRecruitmentDigestAsync(200, ctx.RequestAborted);
        _jobs = result.Jobs;
        _applicants = result.Applicants;
        _count = result.Count;
        _open = result.OpenJobCount;
        _applicantCount = result.ApplicantCount;
        _source = result.Source;
        _message = result.Message;
    }
}
