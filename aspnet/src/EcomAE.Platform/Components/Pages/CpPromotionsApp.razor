@page "/cp/promotions-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Promotions · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Promotions
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/promotions-app")</p>
                <p>Save a promotion here. Apply and loyalty stay Classic. This page does not invent a send.</p>
            </div>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div>
    }
    <PhpParityModuleBody AppPath="/cp/promotions-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedPromo is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Promotion KPIs">
        <div class="kpi"><div class="lbl">Promotions</div><div class="val">@_summary.PromotionCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_summary.ActivePromotions.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Percent type</div><div class="val">@_summary.PercentPromotions.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Loyalty accounts</div><div class="val">@_summary.LoyaltyAccounts.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedPromo is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedPromo.Code) ? _openedPromo.Code : ("Promo #" + _openedPromo.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(_openedPromo.Active ? "active" : "inactive")</span>
                </div>
                <div class="panel-body">
                    <p><strong>@(!string.IsNullOrWhiteSpace(_openedPromo.Name) ? _openedPromo.Name : "—")</strong>
                        · @(!string.IsNullOrWhiteSpace(_openedPromo.Type) ? _openedPromo.Type : "—")
                        · @_openedPromo.Value.ToString(CultureInfo.InvariantCulture)
                        · min spend @_openedPromo.MinSpend.ToString("0.00", CultureInfo.InvariantCulture)</p>
                    <p>Valid from <strong>@_openedPromo.ValidFrom.ToString(CultureInfo.InvariantCulture)</strong>
                        · Valid to <strong>@_openedPromo.ValidTo.ToString(CultureInfo.InvariantCulture)</strong></p>
                    @if (_openedPromo.ValidFrom == 0 && _openedPromo.ValidTo == 0)
                    {
                        <p class="text-muted">No validity window yet.</p>
                    }
                    @if (_isAdmin)
                    {
                        <form method="post" action="/cp/promotions/write" style="margin:1rem 0 0;display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@ErpRecordOpen.Href(_listHref, "promo_id", _openedPromo.Id)" />
                            <input type="hidden" name="id" value="@_openedPromo.Id.ToString(CultureInfo.InvariantCulture)" />
                            <p class="help-block" style="width:100%;margin:0">Code <strong>@(!string.IsNullOrWhiteSpace(_openedPromo.Code) ? _openedPromo.Code : "—")</strong> does not change on save.</p>
                            <label>Name <input type="text" name="name" maxlength="160" value="@_openedPromo.Name" /></label>
                            <label>Type
                                <select name="type">
                                    @if (string.Equals(_openedPromo.Type, "fixed", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="percent">percent</option>
                                        <option value="fixed" selected>fixed</option>
                                    }
                                    else
                                    {
                                        <option value="percent" selected>percent</option>
                                        <option value="fixed">fixed</option>
                                    }
                                </select>
                            </label>
                            <label>Value <input type="text" name="value" inputmode="decimal" value="@_openedPromo.Value.ToString(CultureInfo.InvariantCulture)" /></label>
                            <label>Min spend <input type="text" name="min_spend" inputmode="decimal" value="@_openedPromo.MinSpend.ToString("0.00", CultureInfo.InvariantCulture)" /></label>
                            <label>Valid from <input type="text" name="valid_from" inputmode="numeric" value="@_openedPromo.ValidFrom.ToString(CultureInfo.InvariantCulture)" /></label>
                            <label>Valid to <input type="text" name="valid_to" inputmode="numeric" value="@_openedPromo.ValidTo.ToString(CultureInfo.InvariantCulture)" /></label>
                            <label>Active
                                <select name="active">
                                    @if (_openedPromo.Active)
                                    {
                                        <option value="1" selected>yes</option>
                                        <option value="0">no</option>
                                    }
                                    else
                                    {
                                        <option value="1">yes</option>
                                        <option value="0" selected>no</option>
                                    }
                                </select>
                            </label>
                            <button type="submit" class="btn btn-primary btn-sm">Save promotion</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }

    @if (_isAdmin)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">New promotion</div>
                <div class="panel-body">
                    <form method="post" action="/cp/promotions/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@_listHref" />
                        <input type="hidden" name="id" value="0" />
                        <label>Code <input type="text" name="code" maxlength="40" required /></label>
                        <label>Name <input type="text" name="name" maxlength="160" /></label>
                        <label>Type
                            <select name="type">
                                <option value="percent" selected>percent</option>
                                <option value="fixed">fixed</option>
                            </select>
                        </label>
                        <label>Value <input type="text" name="value" inputmode="decimal" value="0" /></label>
                        <label>Min spend <input type="text" name="min_spend" inputmode="decimal" value="0" /></label>
                        <label>Valid from <input type="text" name="valid_from" inputmode="numeric" value="0" /></label>
                        <label>Valid to <input type="text" name="valid_to" inputmode="numeric" value="0" /></label>
                        <button type="submit" class="btn btn-primary btn-sm">Create promotion</button>
                    </form>
                    <p class="help-block" style="margin:.75rem 0 0">New codes start active. Apply and loyalty stay Classic.</p>
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_summary.PromotionCount.ToString(CultureInfo.InvariantCulture) Promotions · @_summary.ActivePromotions.ToString(CultureInfo.InvariantCulture) Active · @_summary.PercentPromotions.ToString(CultureInfo.InvariantCulture) Percent type · @_summary.LoyaltyAccounts.ToString(CultureInfo.InvariantCulture) Loyalty accounts.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>Min spend</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_promotions.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _promotions)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Code) ? row.Code : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Type) ? row.Type : "—")</td>
                            <td>@row.Value.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.MinSpend.ToString("0.00", CultureInfo.InvariantCulture)</td>
                            <td>@(row.Active ? "yes" : "no")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "promo_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_promotions_engine";
    private const string _listHref = "/cp/promotions-app";
    private bool _isAdmin;
    private CpPromotionsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPromotionDigest> _promotions = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private CpPromotionDetail? _openedPromo;
    private string _flashOk = "";
    private string _flashErr = "";

    private string OpenedCaption => _openedPromo is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedPromo.Code) ? ("Promo #" + _openedPromo.Id.ToString(CultureInfo.InvariantCulture)) : _openedPromo.Code)
            + (string.IsNullOrWhiteSpace(_openedPromo.Type) ? "" : (" · " + _openedPromo.Type));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "promo_id");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpPromotionsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _promotions = result.Promotions;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpPromotionDetailAsync(_openedId, ctx.RequestAborted);
            _openedPromo = detail.Promotion;
            if (_openedPromo is not null)
            {
                var openedList = _promotions.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _promotions = new[] { openedList }.Concat(_promotions.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
