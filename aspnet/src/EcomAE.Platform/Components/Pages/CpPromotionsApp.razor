@page "/cp/promotions-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Promotions · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-prm-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#9a3412 0%,#ea580c 45%,#f59e0b 100%);
        }
        .epc-prm-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-prm-hero p { margin:0; color:rgba(255,255,255,.85); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-prm-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-prm-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#9a3412; background:#fef3c7;
        }
        .epc-prm-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-prm-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-prm-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-prm-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-prm-kpi span { color:#64748b; font-size:.78rem; }
        .epc-prm-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-prm-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-prm-table th, .epc-prm-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-prm-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-prm-note { margin-top:1rem; padding:.75rem .9rem; background:#fffbeb; border:1px solid #fcd34d; border-radius:.45rem; color:#92400e; font-size:.86rem; }
        @@media (max-width:900px){ .epc-prm-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-prm-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Promotions</h1>
        <p>Read-only promo KPIs + codes from <code>/cp/promotions</code>. Campaign writes stay on live PHP promotions engine.</p>
        <div class="epc-prm-cta">
            <a href="@_phpTab">Open PHP</a>
            <a class="ghost" href="@PhpModuleCatalog.HybridWorkspaceHref("/cp/app", _phpTab)">Hybrid workspace</a>
            <a class="ghost" href="/cp/app">Command centre</a>
        </div>
    </section>

    <div class="epc-prm-kpis" aria-label="Promotions stats">
        <div class="epc-prm-kpi"><strong>@_summary.PromotionCount.ToString(CultureInfo.InvariantCulture)</strong><span>Promotions</span></div>
        <div class="epc-prm-kpi"><strong>@_summary.ActivePromotions.ToString(CultureInfo.InvariantCulture)</strong><span>Active</span></div>
        <div class="epc-prm-kpi"><strong>@_summary.PercentPromotions.ToString(CultureInfo.InvariantCulture)</strong><span>Percent type</span></div>
        <div class="epc-prm-kpi"><strong>@_summary.LoyaltyAccounts.ToString(CultureInfo.InvariantCulture)</strong><span>Loyalty accounts</span></div>
    </div>

    <div class="epc-prm-table-wrap">
        <table class="epc-prm-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>Min spend</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_promotions.Count == 0)
                {
                    <tr><td colspan="8">No rows in digest (@_source). @_message</td></tr>
                }
                else
                {
                    @foreach (var row in _promotions)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Code) ? row.Code : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Type) ? row.Type : "—")</td>
                            <td>@row.Value.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.MinSpend.ToString("0.00", CultureInfo.InvariantCulture)</td>
                            <td>@(row.Active ? "yes" : "no")</td>
                            <td><a href="@_phpTab">Open in PHP</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-prm-note">
        Read-only preview · JSON digest <a href="/cp/promotions?limit=200">/cp/promotions</a>. PHP epc_promotions_engine remains authoritative · Not a broad /cp cutover · tenant product chrome stays PHP.
        Source: <code>@_source</code>.
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_promotions_engine";
    private bool _isAdmin;
    private CpPromotionsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPromotionDigest> _promotions = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpPromotionsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _promotions = result.Promotions;
        _source = result.Source;
        _message = result.Message;
    }
}
