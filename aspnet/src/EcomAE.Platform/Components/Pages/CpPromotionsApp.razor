@page "/cp/promotions-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Promotions · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Promotions
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/promotions-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/promotions-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_summary.PromotionCount.ToString(CultureInfo.InvariantCulture) Promotions · @_summary.ActivePromotions.ToString(CultureInfo.InvariantCulture) Active · @_summary.PercentPromotions.ToString(CultureInfo.InvariantCulture) Percent type · @_summary.LoyaltyAccounts.ToString(CultureInfo.InvariantCulture) Loyalty accounts.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>Min spend</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_promotions.Count == 0)
                {
                    <tr><td colspan="8">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _promotions)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Code) ? row.Code : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Type) ? row.Type : "—")</td>
                            <td>@row.Value.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.MinSpend.ToString("0.00", CultureInfo.InvariantCulture)</td>
                            <td>@(row.Active ? "yes" : "no")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_promotions_engine";
    private bool _isAdmin;
    private CpPromotionsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPromotionDigest> _promotions = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpPromotionsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _promotions = result.Promotions;
        _source = result.Source;
        _message = result.Message;
    }
}
