@page "/erp/fixed-assets-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Fixed assets · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Fixed assets" BreadcrumbArea="Fixed assets" BreadcrumbTab="Register">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/fixed-assets-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Fixed assets" Subtitle="Open a row for location, serial, and the 280-character note excerpt. Depreciation run stays on the Classic twin." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Fixed assets stats">
        <div class="kpi"><div class="lbl">Assets</div><div class="val">@_summary.AssetCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_summary.ActiveCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Disposed</div><div class="val">@_summary.DisposedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Cost</div><div class="val">@_summary.CostTotal.ToString("0.00", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Book value</div><div class="val">@_summary.BookValueTotal.ToString("0.00", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Code</dt><dd>@(string.IsNullOrWhiteSpace(_opened.AssetCode) ? "—" : _opened.AssetCode)</dd>
                <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Name) ? "—" : _opened.Name)</dd>
                <dt>Category</dt><dd>@_opened.CategoryId.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Acquired</dt><dd>@(string.IsNullOrWhiteSpace(_opened.AcquisitionDate) ? "—" : _opened.AcquisitionDate)</dd>
                <dt>Location</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Location) ? "—" : _opened.Location)</dd>
                <dt>Tracking</dt><dd>@(string.IsNullOrWhiteSpace(_opened.TrackingId) ? "—" : _opened.TrackingId)</dd>
                <dt>Serial</dt><dd>@(string.IsNullOrWhiteSpace(_opened.SerialNo) ? "—" : _opened.SerialNo)</dd>
                <dt>Cost</dt><dd>@_opened.Cost.ToString("0.00", CultureInfo.InvariantCulture)</dd>
                <dt>Salvage</dt><dd>@_opened.SalvageValue.ToString("0.00", CultureInfo.InvariantCulture)</dd>
                <dt>Life (mo)</dt><dd>@_opened.UsefulLifeMonths.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Method</dt><dd>@(string.IsNullOrWhiteSpace(_opened.DepreciationMethod) ? "—" : _opened.DepreciationMethod)</dd>
                <dt>Accum. dep.</dt><dd>@_opened.AccumulatedDepreciation.ToString("0.00", CultureInfo.InvariantCulture)</dd>
                <dt>Book</dt><dd>@_opened.BookValue.ToString("0.00", CultureInfo.InvariantCulture)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Status) ? "—" : _opened.Status)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Depreciation run stays on the Classic twin.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.NoteExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">note excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.NoteExcerpt</pre>
                @if (_opened.NoteLen > _opened.NoteExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.NoteExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NoteLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No note excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.AssetCode) ? "—" : sib.AssetCode)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Name) ? "—" : sib.Name)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "asset_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Acquired</th>
                    <th>Cost</th>
                    <th>Book</th>
                    <th>Method</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_assets.Count == 0)
                {
                    <tr><td colspan="10">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _assets)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.AssetCode) ? row.AssetCode : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                            <td>@row.CategoryId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.AcquisitionDate) ? row.AcquisitionDate : "—")</td>
                            <td>@row.Cost.ToString("0.00", CultureInfo.InvariantCulture)</td>
                            <td>@row.BookValue.ToString("0.00", CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.DepreciationMethod) ? row.DepreciationMethod : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "asset_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=fixed_assets&tab=fixed_assets";
    private const string _listHref = "/erp/fixed-assets-app";
    private bool _isAdmin;
    private ErpFixedAssetsSummary _summary = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<ErpFixedAssetDigest> _assets = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpFixedAssetDetail? _opened;
    private IReadOnlyList<ErpFixedAssetDigest> _openedSiblings = [];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.AssetCode)
            ? _opened.AssetCode
            : (!string.IsNullOrWhiteSpace(_opened.Name)
                ? _opened.Name
                : ("Asset #" + _opened.Id.ToString(CultureInfo.InvariantCulture))));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?asset_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "asset_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildErpFixedAssetsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _assets = result.Assets;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpFixedAssetDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Asset;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _assets.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _assets = new[] { openedList }.Concat(_assets.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }
}
