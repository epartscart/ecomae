@page "/cp/jewellery-repairs-app"
@page "/erp/jewellery-repairs-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Jewellery repairs · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<HeadContent>
<style>
    .jw-status-row { display:flex; gap:10px; margin-bottom:12px; flex-wrap:wrap; }
    .jw-status-card { flex:1; min-width:120px; padding:10px 14px; background:#f0f4f7; border:1px solid #8faabc; border-radius:3px; text-align:center; }
    .jw-status-card .n { font-size:22px; font-weight:700; }
    .jw-status-card .l { font-size:11px; color:#4a6a7a; font-weight:600; }
    .jw-badge { display:inline-block; padding:1px 8px; border-radius:3px; font-size:10px; font-weight:600; color:#fff; }
</style>
</HeadContent>

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="@_spec.Title" BreadcrumbArea="Jewellery" BreadcrumbTab="@_spec.Label">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="@_appPath" IsAdmin="_isAdmin" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />
    <PhpErpModulePageHeader Title="@_spec.Title" Subtitle="@_spec.Subtitle" />
    <ErpPhpFlash Ok="@_ok" Err="@_err" />

    @if (_isAdmin)
    {
        <form method="post" action="/erp/ajax/jw-repair-update-status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@ReturnHref" />
            <label>ERP repair id <input type="number" name="repairId" min="1" required style="width:6rem" /></label>
            <label>Status
                <select name="newStatus">
                    <option value="received">received</option>
                    <option value="in_progress">in_progress</option>
                    <option value="ready">ready</option>
                    <option value="delivered">delivered</option>
                    <option value="invoiced">invoiced</option>
                </select>
            </label>
            <button type="submit">Save status</button>
        </form>
    }

    <div class="jw-status-row" aria-label="Repair status counts">
        @foreach (var st in ErpJewelleryModuleChrome.RepairStatuses)
        {
            var n = StatusCount(st.Key);
            <div class="jw-status-card" style="border-left:4px solid @st.Color">
                <div class="n" style="color:@st.Color">@n.ToString(CultureInfo.InvariantCulture)</div>
                <div class="l">@st.Label</div>
            </div>
        }
    </div>

    <ErpPhpViewTabs QueryName="tab" Active="@_tab" BaseHref="@_tabBase" Tabs="@ErpJewelleryModuleChrome.RepairTabs" />

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong> <a class="btn btn-xs btn-default" href="@_listHref">Close</a></p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Repair #</dt><dd>@(string.IsNullOrWhiteSpace(_opened.RepairNo) ? "—" : _opened.RepairNo)</dd>
                <dt>Customer</dt><dd>@(string.IsNullOrWhiteSpace(_opened.CustomerName) ? "—" : _opened.CustomerName)</dd>
                <dt>Item</dt><dd>@(string.IsNullOrWhiteSpace(_opened.ItemDescription) ? "—" : _opened.ItemDescription)</dd>
                <dt>Metal</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Metal) ? "—" : _opened.Metal)</dd>
                <dt>Karat</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Karat) ? "—" : _opened.Karat)</dd>
                <dt>Repair type</dt><dd>@(string.IsNullOrWhiteSpace(_opened.RepairType) ? "—" : _opened.RepairType)</dd>
                <dt>Weight in</dt><dd>@_opened.WeightIn.ToString("N3", CultureInfo.InvariantCulture)</dd>
                <dt>Est. cost</dt><dd>@_opened.EstimatedCost.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Status) ? "—" : _opened.Status)</dd>
                <dt>Branch</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Branch) ? "—" : _opened.Branch)</dd>
                <dt>Salesman</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Salesman) ? "—" : _opened.Salesman)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Phone omitted.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.NarrationExcerpt))
            {
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:.85rem 0 0">@_opened.NarrationExcerpt</pre>
                @if (_opened.NarrationLen > _opened.NarrationExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.NarrationExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NarrationLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No narration excerpt yet.</p>
            }
            @if (!string.IsNullOrWhiteSpace(_opened.StoneDetailsExcerpt))
            {
                <pre style="max-height:8rem;overflow:auto;white-space:pre-wrap;margin:.85rem 0 0">@_opened.StoneDetailsExcerpt</pre>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Repair #</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.RepairNo) ? "—" : sib.RepairNo)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.CustomerName) ? "—" : sib.CustomerName)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "repair_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    @if (_isAdmin && _tab == "jw_repairs")
    {
        <ErpPhpCreateWell Title="New Repair Receipt">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryRepairCreateForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <label>Customer Name <input class="form-control input-sm" name="customer_name" required /></label>
                <label>Phone <input class="form-control input-sm" name="customer_phone" /></label>
                <label>Item Description <input class="form-control input-sm" name="item_description" required style="width:200px;" /></label>
                <label>Metal
                    <select class="form-control input-sm" name="metal_type">
                        <option value="Gold">Gold</option>
                        <option value="Silver">Silver</option>
                        <option value="Platinum">Platinum</option>
                    </select>
                </label>
                <label>Karat <input class="form-control input-sm" name="karat" placeholder="22K" style="width:70px;" /></label>
                <label>Gross Wt (g) <input class="form-control input-sm" name="gross_wt_in" type="number" step="0.001" value="0.000" style="width:90px;" /></label>
                <label>Net Wt (g) <input class="form-control input-sm" name="net_wt_in" type="number" step="0.001" value="0.000" style="width:90px;" /></label>
                <label>Repair Type
                    <select class="form-control input-sm" name="repair_type">
                        <option value="Ring Resize">Ring Resize</option>
                        <option value="Clasp Repair">Clasp Repair</option>
                        <option value="Stone Setting">Stone Setting</option>
                        <option value="Polish &amp; Clean">Polish &amp; Clean</option>
                        <option value="Chain Repair">Chain Repair</option>
                        <option value="Engraving">Engraving</option>
                        <option value="Rhodium Plating">Rhodium Plating</option>
                        <option value="Other">Other</option>
                    </select>
                </label>
                <label>Est. Cost (AED) <input class="form-control input-sm" name="estimated_cost" type="number" step="0.01" value="0.00" style="width:90px;" /></label>
                <label>Stone Details <input class="form-control input-sm" name="stone_details" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Create repair</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "jw_repair_receipt")
    {
        <ErpPhpCreateWell Title="New Receipt">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryRepairReceiptSaveForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <label>Customer Name <input class="form-control input-sm" name="customer_name" required /></label>
                <label>Mobile <input class="form-control input-sm" name="mobile" /></label>
                <label>Salesman <input class="form-control input-sm" name="salesman" /></label>
                <label>Est. Cost <input class="form-control input-sm" name="total_est_cost" type="number" step="0.01" value="0" style="width:90px;" /></label>
                <label>Narration <input class="form-control input-sm" name="narration" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save repair receipt</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "jw_repair_sale")
    {
        <ErpPhpCreateWell Title="Invoice repair">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryVoucherSaveForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <input type="hidden" name="voc_type" value="RSL" />
                <label>Repair # <input class="form-control input-sm" name="repair_ref" required /></label>
                <label>Customer <input class="form-control input-sm" name="party_name" /></label>
                <label>Net <input class="form-control input-sm" name="net_amount" type="number" step="0.01" value="0" style="width:90px;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save repair sale</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "jw_repair_transfer")
    {
        <ErpPhpCreateWell Title="Transfer to workshop">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryRepairTransferSaveForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <label>Repair # <input class="form-control input-sm" name="code" required /></label>
                <label>To branch <input class="form-control input-sm" name="to_branch" value="WS1" /></label>
                <label>Narration <input class="form-control input-sm" name="narration" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save transfer</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "jw_workshop_receive")
    {
        <ErpPhpCreateWell Title="Workshop receive">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryWorkshopReceiveSaveForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <label>Transfer / repair # <input class="form-control input-sm" name="code" required /></label>
                <label>From workshop <input class="form-control input-sm" name="from_workshop" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save workshop receive</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "jw_repair_delivery")
    {
        <ErpPhpCreateWell Title="Deliver to customer">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryRepairDeliverySaveForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <label>Repair # <input class="form-control input-sm" name="code" required /></label>
                <label>Customer <input class="form-control input-sm" name="customer_name" /></label>
                <label>Charge <input class="form-control input-sm" name="total_charge" type="number" step="0.01" value="0" style="width:90px;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save delivery</button>
            </form>
        </ErpPhpCreateWell>
    }

    @if (_tab == "jw_repairs" || _tab == "jw_repair_register" || _tab == "jw_repair_search")
    {
        <form method="get" action="@_appPath" class="form-inline" style="margin:8px 0;display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
            @if (_company > 0)
            {
                <input type="hidden" name="company" value="@_company.ToString(CultureInfo.InvariantCulture)" />
            }
            <input type="hidden" name="tab" value="@_tab" />
            <label style="font-size:11px;font-weight:600;color:#4a6a7a;margin:0">Status:</label>
            <select name="repair_status" class="form-control input-sm">
                <option value="">All</option>
                @foreach (var st in ErpJewelleryModuleChrome.RepairStatuses)
                {
                    if (string.Equals(_statusFilter, st.Key, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@st.Key" selected>@st.Label</option>
                    }
                    else
                    {
                        <option value="@st.Key">@st.Label</option>
                    }
                }
            </select>
            @if (_tab == "jw_repair_search")
            {
                <input class="form-control input-sm" name="q" value="@_search" placeholder="Repair #, customer, phone" />
            }
            <button type="submit" class="btn btn-default btn-sm">Filter</button>
        </form>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    @foreach (var col in _spec.Columns)
                    {
                        <th>@col</th>
                    }
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_visible.Count == 0)
                {
                    <tr><td colspan="@(_spec.Columns.Count + 1)" class="text-muted">@(_isAdmin ? _spec.EmptyCopy : "Sign in with ERP or Control Panel capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _visibleDisplay)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            @if (_tab is "jw_repair_receipt" or "jw_repair_delivery")
                            {
                                <td>@row.No</td>
                                <td><strong>@row.RepairNo</strong></td>
                                <td>@row.VocDate</td>
                                <td>@row.Customer</td>
                                <td>@row.Phone</td>
                                <td>@row.Item</td>
                                <td>@row.Delivery</td>
                                <td><span class="jw-badge" style="background:@row.StatusColor">@row.StatusLabel</span></td>
                            }
                            else if (_tab == "jw_repair_sale")
                            {
                                <td><strong>@row.RepairNo</strong></td>
                                <td>@row.Customer</td>
                                <td>@row.Item</td>
                                <td class="text-right">@row.Cost</td>
                                <td>—</td>
                                <td><span class="jw-badge" style="background:@row.StatusColor">@row.StatusLabel</span></td>
                            }
                            else if (_tab is "jw_repair_transfer" or "jw_workshop_receive")
                            {
                                <td><strong>@row.RepairNo</strong></td>
                                <td>@row.Branch</td>
                                <td>@row.Item</td>
                                <td>@row.Metal</td>
                                <td><span class="jw-badge" style="background:@row.StatusColor">@row.StatusLabel</span></td>
                            }
                            else
                            {
                                <td>@row.No</td>
                                <td><strong>@row.RepairNo</strong></td>
                                <td>@row.Customer</td>
                                <td>@row.Phone</td>
                                <td>@row.Item</td>
                                <td>@row.Metal</td>
                                <td>@row.Karat</td>
                                <td class="text-right">@row.Weight</td>
                                <td>@row.RepairType</td>
                                <td class="text-right">@row.Cost</td>
                                <td><span class="jw-badge" style="background:@row.StatusColor">@row.StatusLabel</span></td>
                                <td>@row.CompanyId</td>
                                <td>@row.Branch</td>
                                <td>
                                    @if (_isAdmin && row.NextStatus is not null)
                                    {
                                        <form method="post" action="@EcomAeRoutes.ErpJewelleryRepairStatusForm" style="display:inline">
                                            <input type="hidden" name="confirmWrites" value="true" />
                                            <input type="hidden" name="returnUrl" value="@ReturnHref" />
                                            <input type="hidden" name="repair_id" value="@row.Id" />
                                            <input type="hidden" name="new_status" value="@row.NextStatus" />
                                            <button type="submit" class="btn btn-xs @row.NextCss">@row.NextLabel</button>
                                        </form>
                                    }
                                </td>
                            }
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "repair_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Jobs bind from <code>epc_jewel_repair</code> and <code>epc_erp_jw_repairs</code>. Create, status, receipt, transfer, workshop-receive, and delivery writes are live when confirmed. Sample seed stays Classic.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private int _company;
    private string _tab = "jw_repairs";
    private string _statusFilter = "";
    private string _search = "";
    private string _appPath = "/cp/jewellery-repairs-app";
    private string _tabBase = "/cp/jewellery-repairs-app";
    private string _returnHere = "/cp/jewellery-repairs-app?tab=jw_repairs";
    private ErpJewelleryModuleChrome.TabSpec _spec = ErpJewelleryModuleChrome.RepairSpec("jw_repairs");
    private CpJewelleryRepairsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpJewelleryRepairDigest> _rows = [];
    private IReadOnlyList<CpJewelleryRepairDigest> _visible = [];
    private IReadOnlyList<RepairRow> _visibleDisplay = [];
    private string _source = "n/a";
    private string _message = "";
    private string _ok = "";
    private string _err = "";
    private string _listHref = "/cp/jewellery-repairs-app";
    private long _openedId;
    private CpJewelleryRepairDetail? _opened;
    private IReadOnlyList<CpJewelleryRepairDigest> _openedSiblings = [];

    private sealed record RepairRow(
        long Id, string No, string RepairNo, string Customer, string Phone, string Item,
        string Metal, string Karat, string Weight, string RepairType, string Cost,
        string StatusLabel, string StatusColor, string CompanyId, string Branch,
        string VocDate, string Delivery, string? NextStatus, string NextLabel, string NextCss);

    private string OpenedCaption =>
        !string.IsNullOrWhiteSpace(_opened?.RepairNo)
            ? _opened.RepairNo
            : (_openedId > 0 ? ("Repair #" + _openedId.ToString(CultureInfo.InvariantCulture)) : "");

    private string ReturnHref =>
        _openedId > 0
            ? _listHref + "?repair_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
            : _returnHere;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var path = ctx.Request.Path.Value ?? "/cp/jewellery-repairs-app";
        _appPath = path.StartsWith("/erp/", StringComparison.OrdinalIgnoreCase)
            ? "/erp/jewellery-repairs-app"
            : "/cp/jewellery-repairs-app";
        _listHref = _appPath;
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "repair_id");
        _company = ErpJewelleryModuleChrome.CompanyFromQuery(ctx.Request.Query["company"].ToString());
        _tab = ErpJewelleryModuleChrome.NormalizeTab(ctx.Request.Query["tab"].ToString(), ErpJewelleryModuleChrome.RepairTabs, "jw_repairs");
        _statusFilter = (ctx.Request.Query["repair_status"].ToString() ?? string.Empty).Trim();
        _search = (ctx.Request.Query["q"].ToString() ?? string.Empty).Trim();
        _ok = ctx.Request.Query["ok"].ToString();
        _err = ctx.Request.Query["err"].ToString();
        _spec = ErpJewelleryModuleChrome.RepairSpec(_tab);
        _tabBase = ErpJewelleryModuleChrome.AppHref(_appPath, _company);
        _returnHere = ErpJewelleryModuleChrome.AppHref(_appPath, _company, ("tab", _tab), ("repair_status", _statusFilter));

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = ErpJewelleryModuleChrome.HasJewelleryStaffAccess(session);
        if (!_isAdmin)
        {
            _message = "Sign in with ERP or Control Panel capability for live rows.";
            return;
        }

        var result = await Dashboards.BuildCpJewelleryRepairsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Repairs;
        _source = result.Source;
        _message = result.Message;
        _visible = FilterRows(_rows, _statusFilter, _search);
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpJewelleryRepairDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Repair;
            _openedSiblings = detail.Siblings;
        }
        _visibleDisplay = _visible.Select((row, i) =>
        {
            var next = NextStatus(row.Status);
            var repairNo = string.IsNullOrWhiteSpace(row.RepairNo)
                ? (row.VocNo > 0 ? row.VocNo.ToString(CultureInfo.InvariantCulture) : "#" + row.Id.ToString(CultureInfo.InvariantCulture))
                : row.RepairNo;
            return new RepairRow(
                row.Id,
                (i + 1).ToString(CultureInfo.InvariantCulture),
                repairNo,
                string.IsNullOrWhiteSpace(row.CustomerName) ? "—" : row.CustomerName,
                string.IsNullOrWhiteSpace(row.CustomerPhone) ? "—" : row.CustomerPhone,
                string.IsNullOrWhiteSpace(row.ItemDescription) ? "—" : row.ItemDescription,
                string.IsNullOrWhiteSpace(row.Metal) ? "—" : row.Metal,
                string.IsNullOrWhiteSpace(row.Karat) ? "—" : row.Karat,
                row.WeightIn.ToString("N3", CultureInfo.InvariantCulture),
                string.IsNullOrWhiteSpace(row.RepairType) ? "—" : row.RepairType,
                row.EstimatedCost.ToString("N2", CultureInfo.InvariantCulture),
                ErpJewelleryModuleChrome.StatusLabel(row.Status),
                ErpJewelleryModuleChrome.StatusColor(row.Status),
                row.CompanyId.ToString(CultureInfo.InvariantCulture),
                string.IsNullOrWhiteSpace(row.Branch) ? "—" : row.Branch,
                string.IsNullOrWhiteSpace(row.VocDate) ? "—" : row.VocDate,
                string.IsNullOrWhiteSpace(row.DeliveryDate) ? "—" : row.DeliveryDate,
                next?.Value,
                next?.Label ?? "",
                next?.Css ?? "");
        }).ToList();
    }

    private int StatusCount(string status)
        => _rows.Count(r => string.Equals(r.Status, status, StringComparison.OrdinalIgnoreCase));

    private static IReadOnlyList<CpJewelleryRepairDigest> FilterRows(IReadOnlyList<CpJewelleryRepairDigest> rows, string status, string search)
    {
        IEnumerable<CpJewelleryRepairDigest> q = rows;
        if (!string.IsNullOrWhiteSpace(status))
            q = q.Where(r => string.Equals(r.Status, status, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(search))
        {
            q = q.Where(r =>
                (r.RepairNo ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase)
                || (r.CustomerName ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase)
                || (r.CustomerPhone ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase)
                || (r.ItemDescription ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        return q.ToList();
    }

    private static (string Value, string Label, string Css)? NextStatus(string? status)
        => (status ?? string.Empty).Trim().ToLowerInvariant() switch
        {
            "received" => ("in_progress", "Start", "btn-warning"),
            "in_progress" => ("ready", "Mark ready", "btn-success"),
            "ready" => ("delivered", "Deliver", "btn-primary"),
            _ => null,
        };
}
