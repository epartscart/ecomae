@page "/cp/jewellery-repairs-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Jewellery repairs · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-jr-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-jr-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-jr-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-jr-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-jr-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#3b1f0b; background:#e0f2fe;
        }
        .epc-jr-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-jr-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-jr-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-jr-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-jr-kpi span { color:#64748b; font-size:.78rem; }
        .epc-jr-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-jr-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-jr-table th, .epc-jr-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-jr-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-jr-note { margin-top:1rem; padding:.75rem .9rem; background:#fffbeb; border:1px solid #fcd34d; border-radius:.45rem; color:#78350f; font-size:.86rem; }
        @@media (max-width:900px){ .epc-jr-kpis{grid-template-columns:1fr 1fr;} }
    
</style>
</HeadContent>


<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-jr-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Jewellery repairs</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-jr-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
        </div>
    </section>

    <div class="epc-jr-kpis" aria-label="Jewellery repairs stats">
        <div class="epc-jr-kpi"><strong>@_summary.RepairCount.ToString(CultureInfo.InvariantCulture)</strong><span>Repairs</span></div>
        <div class="epc-jr-kpi"><strong>@_summary.OpenCount.ToString(CultureInfo.InvariantCulture)</strong><span>Open</span></div>
        <div class="epc-jr-kpi"><strong>@_summary.AuthorizedCount.ToString(CultureInfo.InvariantCulture)</strong><span>Authorized</span></div>
        <div class="epc-jr-kpi"><strong>@_summary.ItemCount.ToString(CultureInfo.InvariantCulture)</strong><span>Items</span></div>
    </div>

    <div class="epc-jr-table-wrap">
        <table class="epc-jr-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Company</th>
                    <th>Branch</th>
                    <th>Voc type</th>
                    <th>Voc #</th>
                    <th>Date</th>
                    <th>Delivery</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>CCY</th>
                    <th>Auth</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="13">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CompanyId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Branch) ? row.Branch : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.VocType) ? row.VocType : "—")</td>
                            <td>@row.VocNo.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.VocDate) ? row.VocDate : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.DeliveryDate) ? row.DeliveryDate : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CustomerName) ? row.CustomerName : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Currency) ? row.Currency : "—")</td>
                            <td>@(row.Authorized ? "yes" : "no")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CreatedAt) ? row.CreatedAt : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=service_mgmt&tab=jw_repairs";
    private bool _isAdmin;
    private CpJewelleryRepairsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpJewelleryRepairDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpJewelleryRepairsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Repairs;
        _source = result.Source;
        _message = result.Message;
    }
}
