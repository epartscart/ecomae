@page "/cp/admin-sessions-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Admin Sessions · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Admin Sessions
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/admin-sessions-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/admin-sessions-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_sessions.Count Users shown (limit @_limit) · @_totalSessions Total sessions · @_maxSessions Max per user.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>User ID</th>
                    <th>Email</th>
                    <th>Type</th>
                    <th>Sessions</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_sessions.Count == 0)
                {
                    <tr><td colspan="5">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var s in _sessions)
                    {
                        var phpHref = $"{_phpTab}?user_id={s.UserId.ToString(CultureInfo.InvariantCulture)}";
                        <tr>
                            <td><strong>@s.UserId.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(s.Email) ? "—" : s.Email)</td>
                            <td><span class="epc-as-badge">@s.Type.ToString(CultureInfo.InvariantCulture)</span></td>
                            <td>@s.SessionCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(phpHref)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/users";
    private bool _isAdmin;
    private IReadOnlyList<CpAdminSessionDigest> _sessions = [];
    private int _totalSessions;
    private int _maxSessions;
    private int _limit = 200;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListCpAdminSessionsAsync(_limit, ctx.RequestAborted);
        _sessions = result.Sessions;
        _totalSessions = _sessions.Sum(s => s.SessionCount);
        _maxSessions = _sessions.Count == 0 ? 0 : _sessions.Max(s => s.SessionCount);
        _source = result.Source;
        _message = result.Message;
    }
}
