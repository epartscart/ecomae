                                                    </form>
                                                    <form method="post" action="/cp/orders/refresh-item-cost" style="display:flex;gap:.3rem;align-items:center;margin:.25rem 0 0">
                                                        <input type="hidden" name="confirmWrites" value="true" />
                                                        <input type="hidden" name="returnUrl" value="@OrdersHref(o.Id, detailTab: "items")" />
                                                        <input type="hidden" name="orderId" value="@o.Id.ToString(CultureInfo.InvariantCulture)" />
