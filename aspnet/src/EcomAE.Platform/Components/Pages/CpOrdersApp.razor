@page "/cp/orders"
@page "/cp/orders-app"
@page "/cp/shop/orders/orders"
@page "/cp/shop/orders/order"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ICpOrdersListService Orders
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Orders · OMS · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
@foreach (var href in LegacyPresentationAssets.CpOrdersOmsStylesheets)
{
    <link rel="stylesheet" href="@href" />
}

<PhpCpDesktopChrome IsAdmin="_isAdmin">

<div class="col-lg-12 epc-scp-panel epc-scp-orders-page epc-orders-page" data-epc-oms-ssr="1">
    <div class="epc-orders-page__hero">
        <div>
            <h2><i class="fa fa-shopping-basket"></i> Orders</h2>
            <p>Order processing: filter, sort and open orders; items, fulfillment, payment, documents and messages open in the right pane.</p>
        </div>
        @if (!string.IsNullOrWhiteSpace(_flashOk))
        {
            <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
        }
        @if (!string.IsNullOrWhiteSpace(_flashErr))
        {
            <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
        }
        <div class="epc-orders-page__hero-actions">
            <a class="btn btn-default btn-sm" href="/cp/order-statuses-app"><i class="fa fa-tags"></i> Order statuses</a>
            <a class="btn btn-default btn-sm" href="/cp/fulfillment-queue-app"><i class="fa fa-truck"></i> Fulfilment queue</a>
            <a class="btn btn-default btn-sm" href="/cp/returns-rma-app"><i class="fa fa-undo"></i> Returns</a>
            <a class="btn btn-default btn-sm" href="/cp/carts-app"><i class="fa fa-shopping-cart"></i> Carts</a>
        </div>
    </div>

    <div class="epc-orders-tabs" role="tablist" aria-label="Orders tabs">
        <a class="epc-orders-tab @(_filter.Tab == "open" ? "is-active" : null)" href="@TabHref("open")">Open orders</a>
        <a class="epc-orders-tab is-completed @(_filter.Tab == "completed" ? "is-active" : null)" href="@TabHref("completed")">Completed</a>
        <a class="epc-orders-tab @(_filter.Tab == "all" ? "is-active" : null)" href="@TabHref("all")">All orders</a>
    </div>

    @if (!_isAdmin)
    {
        <div class="alert alert-info" role="status">Sign in with a Control Panel admin session to load orders.</div>
    }
    else
    {
        <div class="epc-scp-table-card epc-orders-filter-card">
            <h4><i class="fa fa-filter"></i> Filter</h4>
            <form method="get" action="/cp/orders" id="orders_filter_form" class="epc-orders-filter">
                <input type="hidden" name="tab" value="@_filter.Tab" />
                <input type="hidden" name="sort" value="@_filter.Sort" />
                <input type="hidden" name="dir" value="@(_filter.Desc ? "desc" : "asc")" />
                <div class="row">
                    <div class="col-md-3 form-group">
                        <label for="time_from_show">Date from</label>
                        <input type="hidden" id="time_from" name="time_from" value="@Unix(_filter.TimeFrom)" />
                        <input type="text" id="time_from_show" class="form-control" value="@FormatTime(_filter.TimeFrom, "")" placeholder="dd.mm.yyyy hh:mm" autocomplete="off" data-epc-unix-target="time_from" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label for="time_to_show">Date to</label>
                        <input type="hidden" id="time_to" name="time_to" value="@Unix(_filter.TimeTo)" />
                        <input type="text" id="time_to_show" class="form-control" value="@FormatTime(_filter.TimeTo, "")" placeholder="dd.mm.yyyy hh:mm" autocomplete="off" data-epc-unix-target="time_to" />
                    </div>
                    <div class="col-md-2 form-group">
                        <label for="order_id_f">Order #</label>
                        <input type="text" id="order_id_f" name="order_id_f" class="form-control" value="@(_filter.OrderId > 0 ? _filter.OrderId.ToString(CultureInfo.InvariantCulture) : "")" />
                    </div>
                    <div class="col-md-2 form-group">
                        <label for="paid">Paid</label>
                        <select multiple="multiple" id="paid" name="paid" class="form-control">
                            <option value="1" selected="@_filter.Paid.Contains(1)">Paid</option>
                            <option value="2" selected="@_filter.Paid.Contains(2)">Partially paid</option>
                            <option value="0" selected="@_filter.Paid.Contains(0)">Not paid</option>
                        </select>
                    </div>
                    <div class="col-md-2 form-group">
                        <label for="paid_type">Payment type</label>
                        <select multiple="multiple" id="paid_type" name="paid_type" class="form-control">
                            <option value="0" selected="@_filter.PaidType.Contains(0)">Not set</option>
                            @foreach (var pt in _list.PaidTypes)
                            {
                                <option value="@pt.Id" selected="@_filter.PaidType.Contains(pt.Id)">@pt.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 form-group">
                        <label for="status">Status</label>
                        <select multiple="multiple" id="status" name="status" class="form-control">
                            @foreach (var s in _list.Statuses)
                            {
                                <option value="@s.Id" selected="@_filter.Status.Contains(s.Id)">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 form-group">
                        <label for="customer_id">Customer ID</label>
                        <input type="text" id="customer_id" name="customer_id" class="form-control" value="@(_filter.CustomerId > 0 ? _filter.CustomerId.ToString(CultureInfo.InvariantCulture) : "")" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label for="customer">Customer <small class="text-muted">(ID, e-mail, phone, profile fields)</small></label>
                        <input type="text" id="customer" name="customer" class="form-control" value="@_filter.Customer" />
                    </div>
                    <div class="col-md-2 form-group">
                        <label for="viewed">Viewed</label>
                        <select id="viewed" name="viewed" class="form-control">
                            <option value="" selected="@(_filter.Viewed < 0)">Any</option>
                            <option value="1" selected="@(_filter.Viewed == 1)">Viewed</option>
                            <option value="0" selected="@(_filter.Viewed == 0)">Not viewed</option>
                        </select>
                    </div>
                    <div class="col-md-2 form-group">
                        <label for="office">Office</label>
                        <select multiple="multiple" id="office" name="office" class="form-control">
                            @foreach (var of in _list.Offices)
                            {
                                <option value="@of.Id" selected="@_filter.Office.Contains((int)of.Id)">@of.Caption</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 form-group">
                        <label for="phone">Phone</label>
                        <input type="text" id="phone" name="phone" class="form-control" value="@_filter.Phone" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label for="article">Article</label>
                        <input type="text" id="article" name="article" class="form-control" value="@_filter.Article" />
                    </div>
                </div>
                <button class="btn btn-success" type="submit"><i class="fa fa-filter"></i> Filter</button>
                <a class="btn btn-primary" href="@TabHref(_filter.Tab)"><i class="fa fa-square"></i> Reset filter</a>
                <a class="btn btn-info" href="@TabHref("open")"><i class="fa fa-toolbox"></i> Orders in process</a>
            </form>
        </div>

        <div class="epc-scp-orders-workspace @(_selectedId > 0 ? "is-oms-active" : null)">
            <div class="epc-scp-orders-workspace__list">
                <div class="epc-scp-table-card">
                    <div class="epc-scp-table-card__head epc-orders-workspace-head">
                        <div>
                            <h3>@ListHeading <small class="text-muted">(@_list.Total)</small></h3>
                            <p class="epc-oms-hint">Click an order number to open it on the right</p>
                        </div>
                        <form method="post" action="/cp/orders/delete" id="orders_bulk_form" onsubmit="return confirm('Delete selected unpaid orders?');">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@PageHref(_list.Page)" />
                            <input type="hidden" name="order_ids" id="orders_bulk_ids" value="" />
                            <button type="submit" class="btn btn-danger btn-xs" onclick="return epcOrdersCollectChecked();"><i class="fa fa-trash"></i> Delete selected</button>
                        </form>
                    </div>
                    <div class="table-responsive">
                        <table id="orders_table" class="footable table table-hover toggle-arrow epc-scp-data-table" data-sort="false">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" id="orders_check_all" onclick="epcOrdersCheckAll(this)" /></th>
                                    <th>@SortLink("id", "Order #")</th>
                                    <th>@SortLink("time", "Created")</th>
                                    <th data-hide="phone">@SortLink("last_modified", "Modified")</th>
                                    <th>@SortLink("count_items", "Items")</th>
                                    <th>@SortLink("price_sum", "Sum")</th>
                                    <th data-hide="phone,tablet">@SortLink("price_purchase", "Purchase")</th>
                                    <th data-hide="phone,tablet">@SortLink("profit", "Margin")</th>
                                    <th data-hide="phone,tablet">@SortLink("paid", "Paid")</th>
                                    <th data-hide="phone,tablet">@SortLink("paid_type", "Payment type")</th>
                                    <th data-hide="phone,tablet">@SortLink("status", "Status")</th>
                                    <th data-hide="phone,tablet">@SortLink("obtain_caption", "Obtaining mode")</th>
                                    <th data-hide="phone,tablet">@SortLink("customer", "Customer")</th>
                                    <th data-hide="phone,tablet">@SortLink("checks_count", "Checks")</th>
                                    <th data-hide="phone,tablet">@SortLink("office_id", "Office")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_list.Rows.Count == 0)
                                {
                                    <tr><td colspan="15">No orders match the filter.</td></tr>
                                }
                                else
                                {
                                    @foreach (var o in _list.Rows)
                                    {
                                        var rowClass = "epc-scp-orders-row"
                                            + (o.ViewedFlag == 0 ? " not_viewed" : "")
                                            + (_selectedId == o.Id ? " is-selected" : "");
                                        var st = _list.Statuses.FirstOrDefault(s => s.Id == o.Status);
                                        var office = _list.Offices.FirstOrDefault(x => x.Id == o.OfficeId);
                                        var paidType = _list.PaidTypes.FirstOrDefault(x => x.Id == o.PaidType);
                                        <tr class="@rowClass" data-order-id="@o.Id">
                                            <td><input type="checkbox" class="orders_check" name="check_order" value="@o.Id.ToString(CultureInfo.InvariantCulture)" /></td>
                                            <td>
                                                <a class="epc-scp-orders-link" href="@OrdersHref(o.Id, detailTab: "manage")"><strong>#@o.Id</strong></a>
                                                @if (o.CountNotViewedMsg > 0)
                                                {
                                                    <span class="badge badge-danger" title="Unread customer messages">@o.CountNotViewedMsg</span>
                                                }
                                            </td>
                                            <td>@FormatTime(o.Time)</td>
                                            <td>@FormatTime(o.LastModified > 0 ? o.LastModified : o.Time)</td>
                                            <td>
                                                @o.CountItems
                                                @if (_list.Items.TryGetValue(o.Id, out var its) && its.Count > 0)
                                                {
                                                    <details class="epc-orders-items-inline"><summary>items</summary>
                                                        <ul>
                                                            @foreach (var it in its)
                                                            {
                                                                <li>@it.Brand @it.Article @it.Name × @it.CountNeed.ToString("0.##", CultureInfo.InvariantCulture) @@ @it.Price.ToString("N2", CultureInfo.InvariantCulture)</li>
                                                            }
                                                        </ul>
                                                    </details>
                                                }
                                            </td>
                                            <td>@o.PriceSum.ToString("N2", CultureInfo.InvariantCulture)</td>
                                            <td>@o.PricePurchase.ToString("N2", CultureInfo.InvariantCulture)</td>
                                            <td>@o.Profit.ToString("N2", CultureInfo.InvariantCulture)</td>
                                            <td>@((MarkupString)PaidBadgeHtml(o.Paid))</td>
                                            <td>@(paidType.Name is { Length: > 0 } ? paidType.Name : "—")</td>
                                            <td><span class="epc-scp-badge" style="@(st is { Color.Length: > 0 } ? "background:" + st.Color : null)">@(st?.Name ?? $"#{o.Status}")</span></td>
                                            <td>@(string.IsNullOrWhiteSpace(o.ObtainCaption) ? "—" : o.ObtainCaption)</td>
                                            <td>@(string.IsNullOrWhiteSpace(o.Customer) ? o.UserId.ToString(CultureInfo.InvariantCulture) : o.Customer)</td>
                                            <td>@o.ChecksCount</td>
                                            <td>@(office.Caption is { Length: > 0 } ? office.Caption : o.OfficeId.ToString(CultureInfo.InvariantCulture))</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_list.Total > _list.PageSize)
                    {
                        var pages = (int)Math.Ceiling(_list.Total / (double)_list.PageSize);
                        <ul class="pagination epc-orders-pagination">
                            @for (var p = Math.Max(1, _list.Page - 5); p <= Math.Min(pages, _list.Page + 5); p++)
                            {
                                <li class="@(p == _list.Page ? "active" : null)"><a href="@PageHref(p)">@p</a></li>
                            }
                        </ul>
                    }
                </div>

                <div class="epc-scp-table-card epc-orders-totals">
                    <h4>Totals for the current filter</h4>
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table">
                            <thead>
                                <tr>
                                    <th style="text-align:center;">Orders</th>
                                    <th style="text-align:center;">Sum</th>
                                    <th style="text-align:center;">Margin</th>
                                    <th style="text-align:center;">Purchase</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="text-align:center;">@_list.Totals.OrdersCount</td>
                                    <td style="text-align:center;">@_list.Totals.PriceSumTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td style="text-align:center;">@_list.Totals.ProfitSumTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td style="text-align:center;">@_list.Totals.PurchaseSumTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        <div class="epc-scp-orders-workspace__detail" id="epc_orders_detail_pane">
            @if (_detail is null && _selectedId <= 0)
            {
                <div class="epc-scp-orders-detail__empty">
                    <i class="fa fa-hand-pointer-o"></i>
                    <p>Select an order to manage</p>
                    <span class="text-muted small">One-window OMS: summary, items, customer, payment, invoices &amp; documents</span>
                </div>
            }
            else if (_detail is null)
            {
                <div class="epc-od epc-od--oms" data-order-id="@_selectedId">
                    <div class="epc-od__head">
                        <div class="epc-od__title-row">
                            <h3 class="epc-od__title">Order #@_selectedId <span class="epc-od__oms-tag">OMS</span></h3>
                            <a class="epc-scp-orders-link" href="@OrdersHref(orderId: 0)" style="margin-left:auto;font-weight:500;">Close</a>
                        </div>
                        <p class="text-muted">Order #@_selectedId is not in this shop digest — shop DB is not configured or this id is not on this tenant.</p>
                    </div>
                </div>
            }
            else
            {
                var d = _detail;
                var o = d.Order;
                <div class="epc-od epc-od--oms" data-order-id="@o.Id">
                    <div class="epc-od__head">
                        <div class="epc-od__title-row">
                            <h3 class="epc-od__title">Order #@o.Id <span class="epc-od__oms-tag">OMS</span></h3>
                            <a class="epc-scp-orders-link" href="@OrdersHref(orderId: 0)" style="margin-left:auto;font-weight:500;">Close</a>
                            <span class="epc-scp-badge @o.StatusBadgeClass">@(string.IsNullOrWhiteSpace(o.StatusName) ? $"#{o.Status}" : o.StatusName)</span>
                        </div>
                        <div class="epc-od__meta">
                            <span><i class="fa fa-clock-o"></i> Created @FormatTime(o.TimeUnix)</span>
                            <span><i class="fa fa-refresh"></i> Modified @FormatTime(o.LastModifiedUnix > 0 ? o.LastModifiedUnix : o.TimeUnix)</span>
                            <span><i class="fa fa-building-o"></i> Office @o.OfficeId</span>
                            <span><i class="fa fa-truck"></i> @(string.IsNullOrWhiteSpace(o.ObtainCaption) ? "—" : o.ObtainCaption)</span>
                        </div>
                        <div class="epc-od__chips">
                            @((MarkupString)PaidBadgeHtml(o.Paid))
                            <span class="epc-scp-badge epc-scp-badge--normal">@d.Items.Count items</span>
                        </div>
                        <div class="epc-od__customer">
                            @if (!string.IsNullOrWhiteSpace(d.CustomerName))
                            {
                                <strong>@d.CustomerName</strong>
                                <text> · </text>
                            }
                            user #@o.UserId
                            @if (!string.IsNullOrWhiteSpace(d.CustomerPhone))
                            {
                                <text> · @d.CustomerPhone</text>
                            }
                        </div>
                        <div class="epc-od__totals epc-od__totals--primary">
                            <div><span>Amount due</span><strong>@d.PriceSum.ToString("N2", CultureInfo.InvariantCulture)</strong></div>
                            <div><span>Paid</span><strong class="is-ok">@d.PaidSum.ToString("N2", CultureInfo.InvariantCulture)</strong></div>
                            <div><span>Balance</span><strong class="@(d.PaidLeft > 0 ? "is-bad" : "is-ok")">@d.PaidLeft.ToString("N2", CultureInfo.InvariantCulture)</strong></div>
                        </div>
                        <div class="epc-od__totals epc-od__totals--secondary">
                            <div><span>Purchase</span><strong>@d.PurchaseSum.ToString("N2", CultureInfo.InvariantCulture)</strong></div>
                            <div><span>Margin</span><strong class="@(d.Margin >= 0 ? "is-ok" : "is-bad")">@d.Margin.ToString("N2", CultureInfo.InvariantCulture)</strong></div>
                        </div>
                    </div>

                    <nav class="epc-od__tabs" role="tablist">
                        @foreach (var tab in DetailTabs)
                        {
                            var key = tab.Key;
                            var label = tab.Label;
                            <a class="@(_detailTab == key ? "is-active" : null)" data-epc-od-tab="@key" href="@OrdersHref(_selectedId, detailTab: key)">@label</a>
                        }
                    </nav>

                    <section class="epc-od__panel @(_detailTab == "manage" ? "is-active" : null)" data-epc-od-panel="manage" style="@(_detailTab == "manage" ? null : "display:none")">
                        <div class="epc-od__edit">
                            <div class="epc-od__edit-title">Update order</div>
                            <p class="text-muted small">Item status, line price/qty/brand, staff message, courier fee, unpaid delete, comment, viewed, and supplier fulfillment write live here. Payment / notify stay Classic.</p>
                            <form method="post" action="/cp/orders/set-courier" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:.5rem 0">
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="@OrdersHref(o.Id, detailTab: "manage")" />
                                <input type="hidden" name="orderId" value="@o.Id.ToString(CultureInfo.InvariantCulture)" />
                                <label>Courier fee <input type="number" step="0.01" min="0" name="deliveryPrice" style="width:6rem" /></label>
                                <label>Country <input type="text" name="country" maxlength="2" style="width:3rem" /></label>
                                <button type="submit" class="btn btn-xs btn-primary">Set courier</button>
                            </form>
                            <form method="post" action="/cp/orders/delete" style="margin:.35rem 0" onsubmit="return confirm('Delete this unpaid order?');">
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="/cp/orders" />
                                <input type="hidden" name="orderId" value="@o.Id.ToString(CultureInfo.InvariantCulture)" />
                                <button type="submit" class="btn btn-xs btn-danger">Delete unpaid order</button>
                            </form>
                            <form method="post" action="/cp/orders/set-viewed" style="margin:.35rem 0">
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="@OrdersHref(o.Id, detailTab: "manage")" />
                                <input type="hidden" name="orderId" value="@o.Id.ToString(CultureInfo.InvariantCulture)" />
                                <input type="hidden" name="viewedFlag" value="1" />
                                <button type="submit" class="btn btn-xs btn-default">Mark viewed</button>
                            </form>
                            <div class="epc-od__actions">
                                <a class="btn btn-primary btn-sm" href="@OrdersHref(_selectedId, detailTab: "fulfillment")"><i class="fa fa-random"></i> Fulfillment</a>
                                <a class="btn btn-default btn-sm" href="@OrdersHref(_selectedId, detailTab: "payment")"><i class="fa fa-credit-card"></i> Payment</a>
                                <a class="btn btn-default btn-sm" href="@OrdersHref(_selectedId, detailTab: "docs")"><i class="fa fa-file-text-o"></i> Invoice / docs</a>
                                <a class="btn btn-default btn-sm" href="@OrdersHref(_selectedId, detailTab: "customer")"><i class="fa fa-user"></i> Customer</a>
                                <a class="btn btn-default btn-sm" href="@ClassicCardHref(o.Id)"><i class="fa fa-external-link"></i> Classic full card</a>
                            </div>
                        </div>
                        <div class="epc-scp-orders-detail__erp-fulfillment">
                            <div class="epc-od__edit-title">ERP document map</div>
                            <ol class="epc-od__erp-chain">
                                <li><strong>Shop order</strong> #@o.Id</li>
                                <li><strong>ERP sales order</strong> — linked via fulfillment</li>
                                <li><strong>Supplier POs / AP bills</strong> — cost side</li>
                                <li><strong>AR tax invoice</strong> — goods + courier + VAT</li>
                            </ol>
                        </div>
                    </section>


                    <section class="epc-od__panel @(_detailTab == "items" ? "is-active" : null)" data-epc-od-panel="items" style="@(_detailTab == "items" ? null : "display:none")">
                        <div class="epc-od__items">
                            @if (d.Items.Count > 0)
                            {
                                var itemIdsCsv = string.Join(",", d.Items.Select(i => i.Id.ToString(CultureInfo.InvariantCulture)));
                                <form method="post" action="/cp/orders/set-items-status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .75rem">
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="@OrdersHref(o.Id, detailTab: "items")" />
                                    <input type="hidden" name="orderId" value="@o.Id.ToString(CultureInfo.InvariantCulture)" />
                                    <input type="hidden" name="itemIds" value="@itemIdsCsv" />
                                    <label>Set all items to status <input type="number" name="status" min="1" value="1" style="width:4rem" /></label>
                                    <button type="submit" class="btn btn-xs btn-primary">Apply</button>
                                </form>
                                <form method="post" action="/cp/orders/update-item" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .75rem">
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="@OrdersHref(o.Id, detailTab: "items")" />
                                    <input type="hidden" name="orderId" value="@o.Id.ToString(CultureInfo.InvariantCulture)" />
                                    <label>Item id <input type="number" name="itemId" min="1" required style="width:5rem" /></label>
                                    <label>Price <input type="number" step="0.01" min="0.01" name="price" style="width:6rem" /></label>
                                    <label>Qty <input type="number" min="1" name="countNeed" style="width:4rem" /></label>
                                    <label>Brand <input type="text" name="manufacturer" maxlength="128" style="width:8rem" /></label>
                                    <label>Article <input type="text" name="article" maxlength="128" style="width:8rem" /></label>
                                    <label>Name <input type="text" name="name" maxlength="255" style="width:10rem" /></label>
