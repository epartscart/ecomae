@page "/cp/orders"
@page "/cp/orders-app"
@page "/cp/shop/orders/orders"
@page "/cp/shop/orders/order"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Orders · OMS · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
@foreach (var href in LegacyPresentationAssets.CpOrdersOmsStylesheets)
{
    <link rel="stylesheet" href="@href" />
}

<PhpCpDesktopChrome IsAdmin="_isAdmin">

<div class="col-lg-12 epc-scp-panel epc-scp-orders-page epc-orders-page" data-epc-oms-ssr="1">
    <div class="epc-orders-page__hero">
        <div>
            <h2><i class="fa fa-shopping-basket"></i> Orders · OMS</h2>
            <p>One-window order management: list on the left, full console on the right — items, fulfillment, payment, documents, and messages. Click KPI cards to filter.</p>
        </div>
        @if (!string.IsNullOrWhiteSpace(_flashOk))
        {
            <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
        }
        @if (!string.IsNullOrWhiteSpace(_flashErr))
        {
            <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
        }
        <div class="epc-orders-page__hero-actions">
            <a class="btn btn-primary btn-sm" href="/cp/fulfillment-queue-app"><i class="fa fa-truck"></i> Fulfilment queue</a>
            <a class="btn btn-default btn-sm" href="/cp/returns-rma-app"><i class="fa fa-undo"></i> Returns</a>
            <a class="btn btn-default btn-sm" href="/cp/sao-app"><i class="fa fa-cogs"></i> SAO</a>
            <a class="btn btn-default btn-sm" href="@OrdersHref(sort: "id")"><i class="fa fa-sort-numeric-desc"></i> By order #</a>
            <a class="btn btn-default btn-sm" href="@OrdersHref(sort: "last_modified")"><i class="fa fa-clock-o"></i> By last modified</a>
        </div>
    </div>

    <div class="epc-scp-kpi epc-scp-orders-kpi" aria-label="OMS KPIs">
        <a class="epc-scp-kpi__card is-clickable" href="@OrdersHref(tab: "open")" title="Show open orders">
            <div class="epc-scp-kpi__label">Open orders</div>
            <div class="epc-scp-kpi__val">@_summary.Open</div>
            <div class="epc-scp-kpi__hint">Click to filter · active pipeline</div>
        </a>
        <a class="epc-scp-kpi__card is-clickable" href="@OrdersHref(tab: "today")" title="Orders created today">
            <div class="epc-scp-kpi__label">Today</div>
            <div class="epc-scp-kpi__val">@_summary.Today</div>
            <div class="epc-scp-kpi__hint">Click to filter · new today</div>
        </a>
        <a class="epc-scp-kpi__card is-clickable" href="@OrdersHref(tab: "pending")" title="Paid orders not finished">
            <div class="epc-scp-kpi__label">Pending ship</div>
            <div class="epc-scp-kpi__val">@_summary.PendingShip</div>
            <div class="epc-scp-kpi__hint">Click to filter · paid, not finished</div>
        </a>
    </div>

    <p class="epc-oms-keys-hint"><i class="fa fa-keyboard-o"></i> Shortcuts: click a row for OMS console · tabs Manage → Messages · item status writes on ASP.NET</p>

    <div class="epc-orders-tabs" role="tablist" aria-label="Orders tabs">
        <a class="epc-orders-tab @(_tab == "open" ? "is-active" : null)" href="@OrdersHref(tab: "open")">Open <span class="epc-tab-count">@_summary.Open</span></a>
        <a class="epc-orders-tab is-completed @(_tab == "completed" ? "is-active" : null)" href="@OrdersHref(tab: "completed")">Completed <span class="epc-tab-count">@_summary.Completed</span></a>
        <a class="epc-orders-tab @(_tab == "all" || _tab == "today" || _tab == "pending" ? "is-active" : null)" href="@OrdersHref(tab: "all")">All</a>
    </div>

    <div class="epc-orders-toolbar">
        <span class="epc-scp-badge epc-scp-badge--high">Paid @_orders.Count(o => o.Paid is 1 or 2)</span>
        <span class="epc-scp-badge epc-scp-badge--urgent">Unpaid @_orders.Count(o => o.Paid == 0)</span>
        <span class="epc-orders-toolbar__hint"><i class="fa fa-columns"></i> Click a row to open OMS on the right</span>
    </div>

    @if (!_isAdmin)
    {
        <div class="alert alert-info" role="status">Sign in with a Control Panel admin session to load live OMS digests. Guest browse shows the PHP-parity shell.</div>
    }

    <div class="epc-scp-orders-workspace @(_selectedId > 0 ? "is-oms-active" : null)">
        <div class="epc-scp-orders-workspace__list">
            <div class="epc-scp-table-card">
                <div class="epc-scp-table-card__head epc-orders-workspace-head">
                    <div>
                        <h3>@ListHeading</h3>
                        <p class="epc-oms-hint">Select a row — OMS console opens on the right</p>
                    </div>
                    <span>
                        <a class="btn btn-default btn-xs" href="/cp/fulfillment-queue-app"><i class="fa fa-truck"></i> Fulfilment</a>
                        <a class="btn btn-default btn-xs" href="/cp/returns-rma-app"><i class="fa fa-undo"></i> Returns</a>
                    </span>
                </div>
                <div class="table-responsive">
                    <table id="orders_table" class="footable table table-hover toggle-arrow epc-scp-data-table" data-sort="false">
                        <thead>
                            <tr>
                                <th></th>
                                <th><a href="@OrdersHref(sort: "id")">Order #</a></th>
                                <th><a href="@OrdersHref(sort: "time")">Created</a></th>
                                <th data-hide="phone"><a href="@OrdersHref(sort: "last_modified")">Modified</a></th>
                                <th>Items</th>
                                <th>Sum</th>
                                <th data-hide="phone,tablet">Purchase</th>
                                <th data-hide="phone,tablet">Margin</th>
                                <th data-hide="phone,tablet">Paid</th>
                                <th data-hide="phone,tablet">Status</th>
                                <th data-hide="phone,tablet">Obtain</th>
                                <th data-hide="phone,tablet">Customer</th>
                                <th data-hide="phone,tablet">Office</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_visibleOrders.Count == 0)
                            {
                                <tr><td colspan="13">Nothing to show yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var o in _visibleOrders)
                                {
                                    var rowClass = "epc-scp-orders-row"
                                        + (o.ViewedFlag == 0 ? " not_viewed" : "")
                                        + (_selectedId == o.Id ? " is-selected" : "");
                                    var margin = o.OrderSum - o.PurchaseSum;
                                    <tr class="@rowClass" data-order-id="@o.Id" onclick="location.href='@OrdersHref(o.Id, detailTab: "manage")'">
                                        <td></td>
                                        <td><a class="epc-scp-orders-link" href="@OrdersHref(o.Id, detailTab: "manage")"><strong>#@o.Id</strong></a></td>
                                        <td>@FormatTime(o.TimeUnix)</td>
                                        <td>@FormatTime(o.LastModifiedUnix > 0 ? o.LastModifiedUnix : o.TimeUnix)</td>
                                        <td>@o.CountItems</td>
                                        <td>@o.OrderSum.ToString("N2", CultureInfo.InvariantCulture)</td>
                                        <td>@o.PurchaseSum.ToString("N2", CultureInfo.InvariantCulture)</td>
                                        <td>@margin.ToString("N2", CultureInfo.InvariantCulture)</td>
                                        <td>@((MarkupString)PaidBadgeHtml(o.Paid))</td>
                                        <td><span class="epc-scp-badge @o.StatusBadgeClass">@(string.IsNullOrWhiteSpace(o.StatusName) ? $"#{o.Status}" : o.StatusName)</span></td>
                                        <td>@(string.IsNullOrWhiteSpace(o.ObtainCaption) ? "—" : o.ObtainCaption)</td>
                                        <td>@(string.IsNullOrWhiteSpace(o.CustomerLabel) ? o.UserId.ToString(CultureInfo.InvariantCulture) : o.CustomerLabel)</td>
                                        <td>@o.OfficeId</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="epc-scp-orders-workspace__detail" id="epc_orders_detail_pane">
            @if (_detail is null && _selectedId <= 0)
            {
                <div class="epc-scp-orders-detail__empty">
                    <i class="fa fa-hand-pointer-o"></i>
                    <p>Select an order to manage</p>
                    <span class="text-muted small">One-window OMS: summary, items, customer, payment, invoices &amp; documents</span>
                </div>
            }
            else if (_detail is null)
            {
                <div class="epc-od epc-od--oms" data-order-id="@_selectedId">
                    <div class="epc-od__head">
                        <div class="epc-od__title-row">
                            <h3 class="epc-od__title">Order #@_selectedId <span class="epc-od__oms-tag">OMS</span></h3>
                            <a class="epc-scp-orders-link" href="@OrdersHref(orderId: 0)" style="margin-left:auto;font-weight:500;">Close</a>
                        </div>
                        <p class="text-muted">Order #@_selectedId is not in this shop digest — shop DB is not configured or this id is not on this tenant.</p>
                    </div>
                </div>
            }
            else
            {
                var d = _detail;
                var o = d.Order;
                <div class="epc-od epc-od--oms" data-order-id="@o.Id">
                    <div class="epc-od__head">
                        <div class="epc-od__title-row">
                            <h3 class="epc-od__title">Order #@o.Id <span class="epc-od__oms-tag">OMS</span></h3>
                            <a class="epc-scp-orders-link" href="@OrdersHref(orderId: 0)" style="margin-left:auto;font-weight:500;">Close</a>
                            <span class="epc-scp-badge @o.StatusBadgeClass">@(string.IsNullOrWhiteSpace(o.StatusName) ? $"#{o.Status}" : o.StatusName)</span>
                        </div>
                        <div class="epc-od__meta">
                            <span><i class="fa fa-clock-o"></i> Created @FormatTime(o.TimeUnix)</span>
                            <span><i class="fa fa-refresh"></i> Modified @FormatTime(o.LastModifiedUnix > 0 ? o.LastModifiedUnix : o.TimeUnix)</span>
                            <span><i class="fa fa-building-o"></i> Office @o.OfficeId</span>
                            <span><i class="fa fa-truck"></i> @(string.IsNullOrWhiteSpace(o.ObtainCaption) ? "—" : o.ObtainCaption)</span>
                        </div>
                        <div class="epc-od__chips">
                            @((MarkupString)PaidBadgeHtml(o.Paid))
                            <span class="epc-scp-badge epc-scp-badge--normal">@d.Items.Count items</span>
                        </div>
                        <div class="epc-od__customer">
                            @if (!string.IsNullOrWhiteSpace(d.CustomerName))
                            {
                                <strong>@d.CustomerName</strong>
                                <text> · </text>
                            }
                            user #@o.UserId
                            @if (!string.IsNullOrWhiteSpace(d.CustomerPhone))
                            {
                                <text> · @d.CustomerPhone</text>
                            }
                        </div>
                        <div class="epc-od__totals epc-od__totals--primary">
                            <div><span>Amount due</span><strong>@d.PriceSum.ToString("N2", CultureInfo.InvariantCulture)</strong></div>
                            <div><span>Paid</span><strong class="is-ok">@d.PaidSum.ToString("N2", CultureInfo.InvariantCulture)</strong></div>
                            <div><span>Balance</span><strong class="@(d.PaidLeft > 0 ? "is-bad" : "is-ok")">@d.PaidLeft.ToString("N2", CultureInfo.InvariantCulture)</strong></div>
                        </div>
                        <div class="epc-od__totals epc-od__totals--secondary">
                            <div><span>Purchase</span><strong>@d.PurchaseSum.ToString("N2", CultureInfo.InvariantCulture)</strong></div>
                            <div><span>Margin</span><strong class="@(d.Margin >= 0 ? "is-ok" : "is-bad")">@d.Margin.ToString("N2", CultureInfo.InvariantCulture)</strong></div>
                        </div>
                    </div>

                    <nav class="epc-od__tabs" role="tablist">
                        @foreach (var tab in DetailTabs)
                        {
                            var key = tab.Key;
                            var label = tab.Label;
                            <a class="@(_detailTab == key ? "is-active" : null)" data-epc-od-tab="@key" href="@OrdersHref(_selectedId, detailTab: key)">@label</a>
                        }
                    </nav>

                    <section class="epc-od__panel @(_detailTab == "manage" ? "is-active" : null)" data-epc-od-panel="manage" style="@(_detailTab == "manage" ? null : "display:none")">
                        <div class="epc-od__edit">
                            <div class="epc-od__edit-title">Update order</div>
                            <p class="text-muted small">Item status, staff message, courier fee, unpaid delete, comment, viewed, and supplier fulfillment write on ASP.NET. Payment / notify stay PHP.</p>
                            <form method="post" action="/cp/orders/set-courier" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:.5rem 0">
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="@OrdersHref(o.Id, detailTab: "manage")" />
                                <input type="hidden" name="orderId" value="@o.Id.ToString(CultureInfo.InvariantCulture)" />
                                <label>Courier fee <input type="number" step="0.01" min="0" name="deliveryPrice" style="width:6rem" /></label>
                                <label>Country <input type="text" name="country" maxlength="2" style="width:3rem" /></label>
                                <button type="submit" class="btn btn-xs btn-primary">Set courier</button>
                            </form>
                            <form method="post" action="/cp/orders/delete" style="margin:.35rem 0" onsubmit="return confirm('Delete this unpaid order?');">
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="/cp/orders" />
                                <input type="hidden" name="orderId" value="@o.Id.ToString(CultureInfo.InvariantCulture)" />
                                <button type="submit" class="btn btn-xs btn-danger">Delete unpaid order</button>
                            </form>
                            <form method="post" action="/cp/orders/set-viewed" style="margin:.35rem 0">
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="@OrdersHref(o.Id, detailTab: "manage")" />
                                <input type="hidden" name="orderId" value="@o.Id.ToString(CultureInfo.InvariantCulture)" />
                                <input type="hidden" name="viewedFlag" value="1" />
                                <button type="submit" class="btn btn-xs btn-default">Mark viewed</button>
                            </form>
                            <div class="epc-od__actions">
                                <a class="btn btn-primary btn-sm" href="@OrdersHref(_selectedId, detailTab: "fulfillment")"><i class="fa fa-random"></i> Fulfillment</a>
                                <a class="btn btn-default btn-sm" href="@OrdersHref(_selectedId, detailTab: "payment")"><i class="fa fa-credit-card"></i> Payment</a>
                                <a class="btn btn-default btn-sm" href="@OrdersHref(_selectedId, detailTab: "docs")"><i class="fa fa-file-text-o"></i> Invoice / docs</a>
                                <a class="btn btn-default btn-sm" href="@OrdersHref(_selectedId, detailTab: "customer")"><i class="fa fa-user"></i> Customer</a>
                                <a class="btn btn-default btn-sm" href="@ClassicCardHref(o.Id)"><i class="fa fa-external-link"></i> Classic full card</a>
                            </div>
                        </div>
                        <div class="epc-scp-orders-detail__erp-fulfillment">
                            <div class="epc-od__edit-title">ERP document map</div>
                            <ol class="epc-od__erp-chain">
                                <li><strong>Shop order</strong> #@o.Id</li>
                                <li><strong>ERP sales order</strong> — linked via fulfillment</li>
                                <li><strong>Supplier POs / AP bills</strong> — cost side</li>
                                <li><strong>AR tax invoice</strong> — goods + courier + VAT</li>
                            </ol>
                        </div>
                    </section>

                    <section class="epc-od__panel @(_detailTab == "items" ? "is-active" : null)" data-epc-od-panel="items" style="@(_detailTab == "items" ? null : "display:none")">
                        <div class="epc-od__items">
                            @if (d.Items.Count > 0)
                            {
                                var itemIdsCsv = string.Join(",", d.Items.Select(i => i.Id.ToString(CultureInfo.InvariantCulture)));
                                <form method="post" action="/cp/orders/set-items-status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .75rem">
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="@OrdersHref(o.Id, detailTab: "items")" />
                                    <input type="hidden" name="orderId" value="@o.Id.ToString(CultureInfo.InvariantCulture)" />
                                    <input type="hidden" name="itemIds" value="@itemIdsCsv" />
                                    <label>Set all items to status <input type="number" name="status" min="1" value="1" style="width:4rem" /></label>
                                    <button type="submit" class="btn btn-xs btn-primary">Apply</button>
                                </form>
                            }
                            <table class="table table-condensed epc-od__lines">
                                <thead>
                                    <tr>
                                        <th>Brand</th>
                                        <th>Article</th>
                                        <th>Name</th>
                                        <th>Qty</th>
                                        <th>Sell</th>
                                        <th>Buy</th>
                                        <th>Margin</th>
                                        <th>Wh</th>
                                        <th>Status</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (d.Items.Count == 0)
                                    {
                                        <tr><td colspan="10">No line items.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var line in d.Items)
                                        {
                                            var lineMargin = (line.Price - line.Purchase) * line.CountNeed;
                                            <tr class="epc-od__line">
                                                <td>@line.Brand</td>
                                                <td>@line.Article</td>
                                                <td>@line.Name</td>
                                                <td>@line.CountNeed.ToString("0.##", CultureInfo.InvariantCulture)</td>
                                                <td>@line.Price.ToString("N2", CultureInfo.InvariantCulture)</td>
                                                <td>@line.Purchase.ToString("N2", CultureInfo.InvariantCulture)</td>
                                                <td>@lineMargin.ToString("N2", CultureInfo.InvariantCulture)</td>
                                                <td>@(string.IsNullOrWhiteSpace(line.StorageLabel) ? "—" : line.StorageLabel)</td>
                                                <td>@(string.IsNullOrWhiteSpace(line.StatusName) ? $"#{line.Status}" : line.StatusName)</td>
                                                <td>
                                                    <form method="post" action="/cp/orders/set-item-status" style="display:flex;gap:.3rem;align-items:center;margin:0">
                                                        <input type="hidden" name="confirmWrites" value="true" />
                                                        <input type="hidden" name="returnUrl" value="@OrdersHref(o.Id, detailTab: "items")" />
                                                        <input type="hidden" name="orderId" value="@o.Id.ToString(CultureInfo.InvariantCulture)" />
                                                        <input type="hidden" name="itemId" value="@line.Id.ToString(CultureInfo.InvariantCulture)" />
                                                        <input type="number" name="status" min="1" value="@line.Status.ToString(CultureInfo.InvariantCulture)" style="width:4rem" />
                                                        <button type="submit" class="btn btn-xs btn-primary">Set</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <section class="epc-od__panel @(_detailTab == "fulfillment" ? "is-active" : null)" data-epc-od-panel="fulfillment" style="@(_detailTab == "fulfillment" ? null : "display:none")">
                        <div class="epc-of-panel">
                            <div class="epc-od__edit-title">Fulfillment</div>
                            <p class="text-muted small">Supplier fulfillment stage writes on ASP.NET. Warehouse pick/pack queue stays on its own board. Bootstrap-from-items stays PHP.</p>
                            <form method="post" action="/cp/orders/fulfillment-set-stage" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:.5rem 0">
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="@OrdersHref(o.Id, detailTab: "fulfillment")" />
                                <input type="hidden" name="orderId" value="@o.Id.ToString(CultureInfo.InvariantCulture)" />
                                <label>Supplier key <input type="text" name="supplierKey" required maxlength="64" placeholder="s12 / w3 / unassigned" style="width:10rem" /></label>
                                <label>Stage
                                    <select name="stage">
                                        @foreach (var stage in FulfillmentStages)
                                        {
                                            <option value="@stage">@stage</option>
                                        }
                                    </select>
                                </label>
                                <button type="submit" class="btn btn-xs btn-primary">Set stage</button>
                            </form>
                            <form method="post" action="/cp/orders/fulfillment-advance" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:.35rem 0">
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="@OrdersHref(o.Id, detailTab: "fulfillment")" />
                                <input type="hidden" name="orderId" value="@o.Id.ToString(CultureInfo.InvariantCulture)" />
                                <label>Supplier key <input type="text" name="supplierKey" required maxlength="64" style="width:10rem" /></label>
                                <button type="submit" class="btn btn-xs btn-default">Advance stage</button>
                            </form>
                            <a class="btn btn-primary btn-sm" href="/cp/fulfillment-queue-app"><i class="fa fa-truck"></i> Open fulfilment queue</a>
                            <div id="epc-order-fulfillment-panel-@o.Id" class="epc-scp-orders-detail__erp-fulfillment" style="margin-top:12px"></div>
                            <div class="epc-od__supplier-fulfillment" style="margin-top:8px"></div>
                        </div>
                    </section>

                    <section class="epc-od__panel @(_detailTab == "customer" ? "is-active" : null)" data-epc-od-panel="customer" style="@(_detailTab == "customer" ? null : "display:none")">
                        <div class="epc-od__edit-title">Customer</div>
                        <p><strong>@(string.IsNullOrWhiteSpace(d.CustomerName) ? "—" : d.CustomerName)</strong></p>
                        <p>User #@o.UserId</p>
                        <p>Email: @(string.IsNullOrWhiteSpace(d.CustomerEmail) ? "—" : d.CustomerEmail)</p>
                        <p>Phone: @(string.IsNullOrWhiteSpace(d.CustomerPhone) ? "—" : d.CustomerPhone)</p>
                    </section>

                    <section class="epc-od__panel @(_detailTab == "payment" ? "is-active" : null)" data-epc-od-panel="payment" style="@(_detailTab == "payment" ? null : "display:none")">
                        <div class="epc-od__edit-title">Payment</div>
                        <div class="epc-od__totals epc-od__totals--primary">
                            <div><span>Amount due</span><strong>@d.PriceSum.ToString("N2", CultureInfo.InvariantCulture)</strong></div>
                            <div><span>Paid</span><strong class="is-ok">@d.PaidSum.ToString("N2", CultureInfo.InvariantCulture)</strong></div>
                            <div><span>Balance</span><strong class="@(d.PaidLeft > 0 ? "is-bad" : "is-ok")">@d.PaidLeft.ToString("N2", CultureInfo.InvariantCulture)</strong></div>
                        </div>
                        <p class="text-muted small">Pay / refund dry-runs: <code>/cp/orders/pay-refund</code>. Live writes remain PHP.</p>
                    </section>

                    <section class="epc-od__panel @(_detailTab == "docs" ? "is-active" : null)" data-epc-od-panel="docs" style="@(_detailTab == "docs" ? null : "display:none")">
                        <div class="epc-od__edit-title">Invoice / docs</div>
                        <div class="epc-od__doc-grid">
                            <a class="epc-od__doc-btn" href="/cp/print-docs-app"><i class="fa fa-file-text-o"></i> Print docs</a>
                            <a class="epc-od__doc-btn" href="@ClassicCardHref(o.Id)"><i class="fa fa-external-link"></i> Classic card docs</a>
                        </div>
                    </section>

                    <section class="epc-od__panel @(_detailTab == "timeline" ? "is-active" : null)" data-epc-od-panel="timeline" style="@(_detailTab == "timeline" ? null : "display:none")">
                        <div class="epc-od__edit-title">Status / time</div>
                        @if (d.Logs.Count == 0)
                        {
                            <p class="text-muted">No status log entries.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled">
                                @foreach (var log in d.Logs)
                                {
                                    <li style="margin-bottom:8px">
                                        <small class="text-muted">@FormatTime(log.TimeUnix)</small>
                                        @if (log.IsRobot == 1) { <span class="epc-scp-badge epc-scp-badge--normal">robot</span> }
                                        else if (log.IsManager == 1) { <span class="epc-scp-badge epc-scp-badge--high">staff</span> }
                                        <div>@log.Text</div>
                                    </li>
                                }
                            </ul>
                        }
                        <form method="post" action="/cp/orders/add-comment" style="margin-top:.65rem">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@OrdersHref(_selectedId, detailTab: "timeline")" />
                            <input type="hidden" name="orderId" value="@_selectedId.ToString(CultureInfo.InvariantCulture)" />
                            <textarea name="text" rows="2" required style="width:100%;margin:0 0 .45rem;padding:.45rem" placeholder="Staff comment on the order log"></textarea>
                            <button type="submit" class="btn btn-sm btn-default">Add comment</button>
                        </form>
                    </section>

                    <section class="epc-od__panel @(_detailTab == "messages" ? "is-active" : null)" data-epc-od-panel="messages" style="@(_detailTab == "messages" ? null : "display:none")">
                        <div class="epc-od__edit-title">Messages (@d.Messages.Count)</div>
                        @if (d.Messages.Count == 0)
                        {
                            <p class="text-muted">No messages.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled">
                                @foreach (var msg in d.Messages)
                                {
                                    <li style="margin-bottom:8px">
                                        <small class="text-muted">@FormatTime(msg.TimeUnix) · @(msg.IsCustomer == 1 ? "customer" : "staff")</small>
                                        <div>@msg.Text</div>
                                    </li>
                                }
                            </ul>
                        }
                        <form method="post" action="/cp/orders/send-message" style="margin-top:.65rem">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@OrdersHref(_selectedId, detailTab: "messages")" />
                            <input type="hidden" name="orderId" value="@_selectedId.ToString(CultureInfo.InvariantCulture)" />
                            <textarea name="text" rows="3" required style="width:100%;margin:0 0 .45rem;padding:.45rem" placeholder="Message to customer"></textarea>
                            <button type="submit" class="btn btn-sm btn-primary">Send message</button>
                        </form>
                    </section>
                </div>
            }
        </div>
    </div>
</div>

</PhpCpDesktopChrome>

@code {
    private bool _isAdmin;
    private CpOrdersSummary _summary = new(0, 0, 0, "n/a", "");
    private IReadOnlyList<CpShopOrderDigest> _orders = [];
    private long _selectedId;
    private CpOrderDetailDigest? _detail;
    private string _tab = "open";
    private string _sort = "id";
    private string _detailTab = "manage";
    private string _flashOk = "";
    private string _flashErr = "";

    private static readonly (string Key, string Label)[] DetailTabs =
    [
        ("manage", "Manage"),
        ("items", "Items"),
        ("fulfillment", "Fulfillment"),
        ("customer", "Customer"),
        ("payment", "Payment"),
        ("docs", "Invoice / docs"),
        ("timeline", "Status / time"),
        ("messages", "Messages"),
    ];

    private static readonly string[] FulfillmentStages =
    [
        "supplier_confirm",
        "supplier_payment_done",
        "supplier_ready_to_delivery",
        "delivered",
        "receipt_in_warehouse",
        "ready_to_customer",
        "packing",
        "dispatch",
        "deliver",
        "complete",
    ];

    private string ListHeading => _tab switch
    {
        "completed" => "Completed orders",
        "all" or "today" or "pending" => "All orders",
        _ => "Open orders",
    };

    private IReadOnlyList<CpShopOrderDigest> _visibleOrders
    {
        get
        {
            IEnumerable<CpShopOrderDigest> q = _orders;
            var todayStart = new DateTimeOffset(DateTime.UtcNow.Date, TimeSpan.Zero).ToUnixTimeSeconds();
            q = _tab switch
            {
                "completed" => q.Where(o => o.StatusBadgeClass.Contains("tenant", StringComparison.Ordinal)),
                "today" => q.Where(o => o.TimeUnix >= todayStart),
                "pending" => q.Where(o => o.Paid is 1 or 2 && !o.StatusBadgeClass.Contains("tenant", StringComparison.Ordinal)),
                "all" => q,
                _ => q.Where(o => !o.StatusBadgeClass.Contains("tenant", StringComparison.Ordinal)
                                  && !o.StatusBadgeClass.Contains("urgent", StringComparison.Ordinal)),
            };
            q = _sort switch
            {
                "time" => q.OrderByDescending(o => o.TimeUnix),
                "last_modified" => q.OrderByDescending(o => o.LastModifiedUnix > 0 ? o.LastModifiedUnix : o.TimeUnix),
                _ => q.OrderByDescending(o => o.Id),
            };
            var list = q.ToList();
            if (_selectedId > 0 && list.All(o => o.Id != _selectedId))
            {
                var extra = _orders.FirstOrDefault(o => o.Id == _selectedId) ?? _detail?.Order;
                if (extra is not null)
                {
                    list.Insert(0, extra);
                }
            }

            return list;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");

        var q = ctx.Request.Query;
        _flashOk = q["ok"].ToString() ?? "";
        _flashErr = q["err"].ToString() ?? "";
        if (long.TryParse(q["order_id"].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var oid) && oid > 0)
        {
            _selectedId = oid;
        }

        var tab = q["tab"].ToString();
        if (tab is "open" or "completed" or "all" or "today" or "pending")
        {
            _tab = tab;
        }

        var sort = q["sort"].ToString();
        if (sort is "id" or "time" or "last_modified")
        {
            _sort = sort;
        }

        var od = q["od"].ToString();
        if (string.IsNullOrWhiteSpace(od))
        {
            od = q["detail_tab"].ToString();
        }

        if (DetailTabs.Any(t => t.Key == od))
        {
            _detailTab = od;
        }

        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.ListCpOrdersAsync(100, ctx.RequestAborted);
        _summary = result.Summary;
        _orders = result.Orders;

        if (_selectedId > 0)
        {
            await LoadOrderDetailAsync(_selectedId, ctx.RequestAborted);
        }
    }

    private async Task LoadOrderDetailAsync(long orderId, CancellationToken cancellationToken)
    {
        _selectedId = orderId;
        if (!_isAdmin)
        {
            _detail = null;
            return;
        }

        _detail = await Dashboards.GetCpOrderDetailAsync(orderId, cancellationToken);
        if (_detail is null)
        {
            var row = _orders.FirstOrDefault(o => o.Id == orderId);
            if (row is not null)
            {
                _detail = new CpOrderDetailDigest(
                    row, row.OrderSum, row.PurchaseSum, 0m, row.OrderSum, row.OrderSum - row.PurchaseSum,
                    row.CustomerLabel, row.CustomerLabel, "", [], [], [], "list", "Detail unavailable — showing list row.");
            }
        }
    }

    private string OrdersHref(long? orderId = null, string? tab = null, string? sort = null, string? detailTab = null)
    {
        var q = new List<string>();
        void Add(string key, string? value)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                q.Add(Uri.EscapeDataString(key) + "=" + Uri.EscapeDataString(value));
            }
        }

        var oid = orderId ?? _selectedId;
        if (oid > 0)
        {
            q.Add("order_id=" + oid.ToString(CultureInfo.InvariantCulture));
        }

        Add("tab", tab ?? _tab);
        Add("sort", sort ?? _sort);
        var od = detailTab ?? (_selectedId > 0 ? _detailTab : null);
        if (!string.IsNullOrWhiteSpace(od) && od != "manage")
        {
            Add("od", od);
        }

        return "/cp/orders" + (q.Count == 0 ? "" : "?" + string.Join("&", q));
    }

    private string ClassicCardHref(long orderId)
        => OrdersHref(orderId);

    private static string PaidBadgeHtml(int paid) => paid switch
    {
        1 => "<span class=\"epc-scp-badge epc-scp-badge--tenant\">Paid</span>",
        2 => "<span class=\"epc-scp-badge epc-scp-badge--high\">Partial</span>",
        _ => "<span class=\"epc-scp-badge epc-scp-badge--urgent\">Unpaid</span>",
    };

    private static string FormatTime(long unix)
    {
        if (unix <= 0)
        {
            return "—";
        }

        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("dd.MM.yyyy HH:mm", CultureInfo.InvariantCulture);
    }
}
