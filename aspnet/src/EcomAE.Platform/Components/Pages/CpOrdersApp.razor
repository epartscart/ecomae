                            <table class="table table-condensed epc-od__lines">
                                <thead>
                                    <tr>
                                        <th>Brand</th>
                                        <th>Article</th>
                                        <th>Name</th>
                                        <th>Qty</th>
                                        <th>Sell</th>
                                        <th>Buy</th>
                                        <th>Margin</th>
                                        <th>Wh</th>
                                        <th>Status</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (d.Items.Count == 0)
                                    {
                                        <tr><td colspan="10">No line items.</td></tr>
