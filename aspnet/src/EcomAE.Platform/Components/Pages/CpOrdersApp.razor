            }
        </div>
        </div>
    }
</div>

<script>
    function epcOrdersCheckAll(src) {
        document.querySelectorAll('#orders_table .orders_check').forEach(function (c) { c.checked = src.checked; });
    }
    function epcOrdersCollectChecked() {
        var ids = [];
        document.querySelectorAll('#orders_table .orders_check:checked').forEach(function (c) { ids.push(c.value); });
        if (ids.length === 0) { alert('Select at least one order.'); return false; }
        document.getElementById('orders_bulk_ids').value = ids.join(',');
        return true;
    }
    document.querySelectorAll('[data-epc-unix-target]').forEach(function (inp) {
        inp.addEventListener('change', function () {
            var m = /^(\d{2})\.(\d{2})\.(\d{4})(?:\s+(\d{2}):(\d{2}))?$/.exec(inp.value.trim());
            var target = document.getElementById(inp.getAttribute('data-epc-unix-target'));
            if (!m) { target.value = ''; return; }
            var d = new Date(+m[3], +m[2] - 1, +m[1], m[4] ? +m[4] : 0, m[5] ? +m[5] : 0, 0);
            target.value = Math.floor(d.getTime() / 1000);
        });
    });
</script>
</PhpCpDesktopChrome>

@code {
    private bool _isAdmin;
    private CpOrdersFilter _filter = new("open", 0, 0, 0, [], [], [], [], "", 0, -1, "", "", "id", true, 1);
    private CpOrdersList _list = new([], 0, 1, PageSize, new(0, 0, 0, 0), [], [], [], new Dictionary<long, IReadOnlyList<CpOrdersItemRow>>(), [], []);
    private long _selectedId;
    private CpOrderDetailDigest? _detail;
    private const int PageSize = 50;
    private string _detailTab = "manage";
    private string _flashOk = "";
    private string _flashErr = "";

    private static readonly (string Key, string Label)[] DetailTabs =
    [
        ("manage", "Manage"),
        ("items", "Items"),
        ("fulfillment", "Fulfillment"),
        ("customer", "Customer"),
        ("payment", "Payment"),
        ("docs", "Invoice / docs"),
        ("timeline", "Status / time"),
        ("messages", "Messages"),
    ];

    private static readonly string[] FulfillmentStages =
    [
        "supplier_confirm",
        "supplier_payment_done",
        "supplier_ready_to_delivery",
        "delivered",
        "receipt_in_warehouse",
        "ready_to_customer",
        "packing",
        "dispatch",
        "deliver",
        "complete",
    ];

    private string ListHeading => _filter.Tab switch
    {
        "completed" => "Completed orders",
        "all" => "All orders",
        _ => "Open orders",
    };

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);

        var q = ctx.Request.Query;
        _flashOk = q["ok"].ToString() ?? "";
        _flashErr = q["err"].ToString() ?? "";
        if (long.TryParse(q["order_id"].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var oid) && oid > 0)
        {
            _selectedId = oid;
        }

        _filter = CpOrdersListService.ReadFilter(ctx.Request);

        var od = q["od"].ToString();
        if (string.IsNullOrWhiteSpace(od))
        {
            od = q["detail_tab"].ToString();
        }

        if (DetailTabs.Any(t => t.Key == od))
        {
            _detailTab = od;
        }

        if (!_isAdmin)
        {
            return;
        }

        _list = await Orders.ListAsync(_filter, session.UserId, PageSize, ctx.RequestAborted);

        if (_selectedId > 0)
        {
            await LoadOrderDetailAsync(_selectedId, ctx.RequestAborted);
        }
    }

    private async Task LoadOrderDetailAsync(long orderId, CancellationToken cancellationToken)
    {
        _selectedId = orderId;
        if (!_isAdmin)
        {
            _detail = null;
            return;
        }

        _detail = await Dashboards.GetCpOrderDetailAsync(orderId, cancellationToken);
        if (_detail is null)
        {
            var row = _list.Rows.FirstOrDefault(o => o.Id == orderId);
            if (row is not null)
            {
                var st = _list.Statuses.FirstOrDefault(x => x.Id == row.Status);
                var digest = new CpShopOrderDigest(row.Id, row.Time, (int)row.UserId, row.Status, row.Paid, row.PaidType, (int)row.OfficeId, 1,
                    row.CountItems, row.PriceSum, row.PricePurchase, row.LastModified, row.ViewedFlag, row.Customer, st?.Name ?? "", "epc-scp-badge--normal", row.ObtainCaption);
                _detail = new CpOrderDetailDigest(
                    digest, row.PriceSum, row.PricePurchase, 0m, row.PriceSum, row.Profit,
                    row.Customer, row.Customer, "", [], [], [], "list", "Detail unavailable — showing list row.");
            }
        }
    }

    private string OrdersHref(long? orderId = null, string? detailTab = null)
    {
        var q = FilterQuery(_filter.Page);
        var oid = orderId ?? _selectedId;
        if (oid > 0)
        {
            q.Add("order_id=" + oid.ToString(CultureInfo.InvariantCulture));
        }

        var od = detailTab ?? (_selectedId > 0 ? _detailTab : null);
        if (!string.IsNullOrWhiteSpace(od) && od != "manage")
        {
            q.Add("od=" + Uri.EscapeDataString(od));
        }

        return "/cp/orders" + (q.Count == 0 ? "" : "?" + string.Join("&", q));
    }

    private string PageHref(int page) => "/cp/orders?" + string.Join("&", FilterQuery(page));

    private static string TabHref(string tab) => "/cp/orders?tab=" + tab;

    private string SortHref(string field)
    {
        var desc = _filter.Sort == field ? !_filter.Desc : true;
        var q = FilterQuery(1, field, desc);
        return "/cp/orders?" + string.Join("&", q);
    }

    private MarkupString SortLink(string field, string label)
    {
        var arrow = _filter.Sort == field ? (_filter.Desc ? " &#9660;" : " &#9650;") : "";
        return new MarkupString("<a href=\"" + SortHref(field) + "\">" + label + arrow + "</a>");
    }

    private List<string> FilterQuery(int page, string? sort = null, bool? desc = null)
    {
        var q = new List<string>();
        void Add(string key, string value)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                q.Add(key + "=" + Uri.EscapeDataString(value));
            }
        }

        Add("tab", _filter.Tab);
        Add("sort", sort ?? _filter.Sort);
        Add("dir", (desc ?? _filter.Desc) ? "desc" : "asc");
        Add("time_from", Unix(_filter.TimeFrom));
        Add("time_to", Unix(_filter.TimeTo));
        Add("order_id_f", Unix(_filter.OrderId));
        Add("status", string.Join(",", _filter.Status));
        Add("paid", string.Join(",", _filter.Paid));
        Add("paid_type", string.Join(",", _filter.PaidType));
        Add("office", string.Join(",", _filter.Office));
        Add("customer", _filter.Customer);
        Add("customer_id", Unix(_filter.CustomerId));
        Add("viewed", _filter.Viewed >= 0 ? _filter.Viewed.ToString(CultureInfo.InvariantCulture) : "");
        Add("phone", _filter.Phone);
        Add("article", _filter.Article);
        if (page > 1)
        {
            Add("page", page.ToString(CultureInfo.InvariantCulture));
        }

        return q;
    }

    private static string Unix(long v) => v > 0 ? v.ToString(CultureInfo.InvariantCulture) : "";

    private string ClassicCardHref(long orderId)
        => OrdersHref(orderId);

    private static string PaidBadgeHtml(int paid) => paid switch
    {
        1 => "<span class=\"epc-scp-badge epc-scp-badge--tenant\">Paid</span>",
        2 => "<span class=\"epc-scp-badge epc-scp-badge--high\">Partial</span>",
        _ => "<span class=\"epc-scp-badge epc-scp-badge--urgent\">Unpaid</span>",
    };

    private static string FormatTime(long unix, string empty = "—")
    {
        if (unix <= 0)
        {
            return empty;
        }

        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("dd.MM.yyyy HH:mm", CultureInfo.InvariantCulture);
    }
}
