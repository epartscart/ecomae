                                    <label><input type="checkbox" name="repriceFromWarehouse" value="true" /> Reprice from warehouse</label>
                                    <button type="submit" class="btn btn-xs btn-primary">Save line</button>
                                </form>
                                <form method="post" action="/cp/orders/refresh-item-cost" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .75rem">
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="@OrdersHref(o.Id, detailTab: "items")" />
                                    <input type="hidden" name="orderId" value="@o.Id.ToString(CultureInfo.InvariantCulture)" />
