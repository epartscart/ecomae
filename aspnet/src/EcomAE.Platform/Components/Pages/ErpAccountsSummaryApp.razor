@page "/erp/accounts-summary-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Accounts Summary · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Accounts Summary" BreadcrumbArea="Banking" BreadcrumbTab="Cash KPIs">

    
    <PhpErpModulePageHeader Title="Accounts Summary" Subtitle="Live shop digest. Writes stay on ERP ajax." />


    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Accounts summary KPIs">
        <div class="kpi"><div class="lbl">Cash position</div><div class="val">@_cashPosition.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Supplier credit</div><div class="val">@_supplierCredit.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Supplier debit</div><div class="val">@_supplierDebit.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Supplier net</div><div class="val">@_supplierNet.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Cash accounts</div><div class="val">@_cashAccounts.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active suppliers</div><div class="val">@_activeSuppliers.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active purchases</div><div class="val">@_activePurchases.ToString(CultureInfo.InvariantCulture)</div></div>
</div>

</PhpErpDesktopChrome>

@code {
    private const string _phpCash = "/ERP/?epc_erp_shell=1&area=banking&tab=cash_bank";
    private bool _isAdmin;
    private decimal _cashPosition;
    private decimal _supplierCredit;
    private decimal _supplierDebit;
    private decimal _supplierNet;
    private int _cashAccounts;
    private int _activeSuppliers;
    private int _activePurchases;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildErpAccountsAsync(ctx.RequestAborted);
        var s = result.Summary;
        _cashPosition = s.CashPosition;
        _supplierCredit = s.SupplierCredit;
        _supplierDebit = s.SupplierDebit;
        _supplierNet = s.SupplierNet;
        _cashAccounts = s.CashAccounts;
        _activeSuppliers = s.ActiveSuppliers;
        _activePurchases = s.ActivePurchases;
        _source = result.Source;
        _message = result.Message;
    }
}
