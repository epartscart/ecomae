@page "/erp/procurement-categories-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Routing
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Procurement categories · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Procurement categories" BreadcrumbArea="Procure to Pay" BreadcrumbTab="Categories">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/procurement-categories-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@OpenedFound" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Procurement categories" Subtitle="Open a category or policy for company id. Category and policy write here." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Procurement category KPIs">
        <div class="kpi"><div class="lbl">Categories</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Policies</div><div class="val">@_policyCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <ErpPhpCreateWell Title="New policy">
            <form method="post" action="@EcomAeRoutes.ErpProcurementPolicySave" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="returnUrl" value="/erp/procurement-categories-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Name <input class="form-control input-sm" name="name" placeholder="Name" style="width:180px;" required /></label>
                <label>Category <input class="form-control input-sm" name="category_id" placeholder="0" style="width:80px;" /></label>
                <label>Threshold <input class="form-control input-sm" name="approval_threshold" placeholder="0" style="width:90px;" /></label>
                <label>Vendor <input class="form-control input-sm" name="preferred_vendor" placeholder="Vendor" style="width:140px;" /></label>
                <label><input type="checkbox" name="active" value="1" checked /> active</label>
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
            </form>
        </ErpPhpCreateWell>
        <ErpPhpCreateWell Title="New category">
            <form method="post" action="@EcomAeRoutes.ErpProcurementCategorySave" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="returnUrl" value="/erp/procurement-categories-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Code <input class="form-control input-sm" name="code" placeholder="Code" style="width:110px;" required /></label>
                <label>Name <input class="form-control input-sm" name="name" placeholder="Name" style="width:180px;" required /></label>
                <label>Parent <input class="form-control input-sm" name="parent_id" placeholder="0" style="width:70px;" /></label>
                <label>Account <input class="form-control input-sm" name="default_account" placeholder="Account" style="width:120px;" /></label>
                <label><input type="checkbox" name="active" value="1" checked /> active</label>
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
            </form>
        </ErpPhpCreateWell>
    }

    @if (_openedCategory is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCategoryCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedCategoryReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Category id</dt><dd>@_openedCategory.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Code</dt><dd>@(string.IsNullOrWhiteSpace(_openedCategory.Code) ? "—" : _openedCategory.Code)</dd>
                <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_openedCategory.Name) ? "—" : _openedCategory.Name)</dd>
                <dt>Parent</dt><dd>@(_openedCategory.ParentId > 0 ? _openedCategory.ParentId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Account</dt><dd>@(string.IsNullOrWhiteSpace(_openedCategory.DefaultAccount) ? "—" : _openedCategory.DefaultAccount)</dd>
                <dt>Company</dt><dd>@(_openedCategory.CompanyId > 0 ? _openedCategory.CompanyId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Status</dt><dd>@(_openedCategory.Active ? "active" : "inactive")</dd>
                <dt>Created</dt><dd>@FormatTime(_openedCategory.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Category and policy write here.</p>
            @if (_openedCategorySiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-parent siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Code</th><th>Name</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedCategorySiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Code) ? "—" : sib.Code)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Name) ? "—" : sib.Name)</td>
                                <td>@(sib.Active ? "active" : "inactive")</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "proc_cat_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-parent siblings yet.</p>
            }
        </div>
    }

    @if (_openedPolicy is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedPolicyCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedPolicyReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>Policy id</dt><dd>@_openedPolicy.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_openedPolicy.Name) ? "—" : _openedPolicy.Name)</dd>
                <dt>Category</dt><dd>@(_openedPolicy.CategoryId > 0 ? _openedPolicy.CategoryId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Threshold</dt><dd>@_openedPolicy.ApprovalThreshold.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Vendor</dt><dd>@(string.IsNullOrWhiteSpace(_openedPolicy.PreferredVendor) ? "—" : _openedPolicy.PreferredVendor)</dd>
                <dt>Company</dt><dd>@(_openedPolicy.CompanyId > 0 ? _openedPolicy.CompanyId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Status</dt><dd>@(_openedPolicy.Active ? "active" : "inactive")</dd>
                <dt>Created</dt><dd>@FormatTime(_openedPolicy.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Category and policy write here.</p>
            @if (_openedPolicySiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-category siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Name</th><th class="text-right">Threshold</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var sib in _openedPolicySiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Name) ? "—" : sib.Name)</td>
                                <td class="text-right">@sib.ApprovalThreshold.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@(sib.Active ? "active" : "inactive")</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "proc_pol_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-category siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Code</th><th>Name</th><th>Parent</th><th>Account</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @if (_cats.Count == 0)
                {
                    <tr><td colspan="6">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No categories yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _cats)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedCategoryId)">
                            <td>@(string.IsNullOrWhiteSpace(row.Code) ? "—" : row.Code)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Name) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Name)</strong></td>
                            <td>@(row.ParentId > 0 ? row.ParentId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.DefaultAccount) ? "—" : row.DefaultAccount)</td>
                            <td><span class="label label-default">@(row.Active ? "active" : "inactive")</span></td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "proc_cat_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="font-size:16px;">Policies</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Name</th><th>Category</th><th class="text-right">Threshold</th><th>Vendor</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @if (_policies.Count == 0)
                {
                    <tr><td colspan="6">No policies yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _policies)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedPolicyId)">
                            <td><strong>@row.Name</strong></td>
                            <td>@(row.CategoryId > 0 ? row.CategoryId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td class="text-right">@row.ApprovalThreshold.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.PreferredVendor) ? "—" : row.PreferredVendor)</td>
                            <td><span class="label label-default">@(row.Active ? "active" : "inactive")</span></td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "proc_pol_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Category and policy write here.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=purchasing&tab=procurement_categories";
    private const string _listHref = "/erp/procurement-categories-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpProcCategoryDigest> _cats = [];
    private IReadOnlyList<ErpProcPolicyDigest> _policies = [];
    private int _count, _active, _policyCount;
    private string _source = "n/a";
    private string _message = "";
    private long _openedCategoryId;
    private long _openedPolicyId;
    private ErpProcCategoryDetail? _openedCategory;
    private ErpProcPolicyDetail? _openedPolicy;
    private IReadOnlyList<ErpProcCategoryDigest> _openedCategorySiblings = [];
    private IReadOnlyList<ErpProcPolicyDigest> _openedPolicySiblings = [];

    private long _openedId => _openedCategoryId > 0 ? _openedCategoryId : _openedPolicyId;

    private bool OpenedFound => _openedCategory is not null || _openedPolicy is not null;

    private string OpenedCategoryReturnHref => _openedCategoryId > 0
        ? _listHref + "?proc_cat_id=" + _openedCategoryId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedPolicyReturnHref => _openedPolicyId > 0
        ? _listHref + "?proc_pol_id=" + _openedPolicyId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedCategoryCaption => _openedCategory is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedCategory.Name)
            ? ("Category #" + _openedCategory.Id.ToString(CultureInfo.InvariantCulture))
            : _openedCategory.Name)
            + (string.IsNullOrWhiteSpace(_openedCategory.Code) ? "" : (" · " + _openedCategory.Code));

    private string OpenedPolicyCaption => _openedPolicy is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedPolicy.Name)
            ? ("Policy #" + _openedPolicy.Id.ToString(CultureInfo.InvariantCulture))
            : _openedPolicy.Name);

    private string OpenedCaption => _openedCategory is not null ? OpenedCategoryCaption : OpenedPolicyCaption;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _openedCategoryId = ErpRecordOpen.ReadId(ctx.Request, "proc_cat_id");
        _openedPolicyId = ErpRecordOpen.ReadId(ctx.Request, "proc_pol_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpProcurementCategoriesDigestAsync(200, ctx.RequestAborted);
        _cats = result.Categories;
        _policies = result.Policies;
        _count = result.Count;
        _active = result.ActiveCount;
        _policyCount = result.PolicyCount;
        _source = result.Source;
        _message = result.Message;

        if (_openedCategoryId > 0)
        {
            var detail = await Dashboards.BuildErpProcCategoryDetailAsync(_openedCategoryId, ctx.RequestAborted);
            _openedCategory = detail.Category;
            _openedCategorySiblings = detail.Siblings;
            if (_openedCategory is not null)
            {
                var openedList = _cats.FirstOrDefault(c => c.Id == _openedCategoryId);
                if (openedList is not null)
                {
                    _cats = new[] { openedList }.Concat(_cats.Where(c => c.Id != _openedCategoryId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }

        if (_openedPolicyId > 0)
        {
            var detail = await Dashboards.BuildErpProcPolicyDetailAsync(_openedPolicyId, ctx.RequestAborted);
            _openedPolicy = detail.Policy;
            _openedPolicySiblings = detail.Siblings;
            if (_openedPolicy is not null)
            {
                var openedList = _policies.FirstOrDefault(p => p.Id == _openedPolicyId);
                if (openedList is not null)
                {
                    _policies = new[] { openedList }.Concat(_policies.Where(p => p.Id != _openedPolicyId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message) && _openedCategory is null)
            {
                _message = detail.Message;
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
