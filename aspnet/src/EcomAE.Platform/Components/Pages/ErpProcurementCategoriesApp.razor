@page "/erp/procurement-categories-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IErpProcCategorySaveDryRun CategorySave
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Procurement categories · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Procurement categories" BreadcrumbArea="Procure to Pay" BreadcrumbTab="Categories">
    <PhpErpModulePageHeader Title="Procurement categories" Subtitle="Category master and approval policies. Saves stay dry-run." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Procurement category KPIs">
        <div class="kpi"><div class="lbl">Categories</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_active.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Policies</div><div class="val">@_policyCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <form @onsubmit="OnSave" @onsubmit:preventDefault="true" style="margin:12px 0;padding:10px;border:1px solid #c5d4de;background:#fff;">
            <strong>New category (dry-run)</strong>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;align-items:end;">
                <label>Code <input class="form-control" @bind="_formCode" /></label>
                <button type="submit" class="btn btn-primary">Validate save</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_formResult)) { <p style="margin:8px 0 0;font-size:12px;">@_formResult</p> }
        </form>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Code</th><th>Name</th><th>Parent</th><th>Account</th><th>Status</th></tr></thead>
            <tbody>
                @if (_cats.Count == 0)
                {
                    <tr><td colspan="5">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No categories yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _cats)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(row.Code) ? "—" : row.Code)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Name) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Name)</strong></td>
                            <td>@(row.ParentId > 0 ? row.ParentId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.DefaultAccount) ? "—" : row.DefaultAccount)</td>
                            <td><span class="label label-default">@(row.Active ? "active" : "inactive")</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="font-size:16px;">Policies</h2>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead><tr><th>Name</th><th>Category</th><th class="text-right">Threshold</th><th>Vendor</th><th>Status</th></tr></thead>
            <tbody>
                @if (_policies.Count == 0)
                {
                    <tr><td colspan="5">No policies yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _policies)
                    {
                        <tr>
                            <td><strong>@row.Name</strong></td>
                            <td>@(row.CategoryId > 0 ? row.CategoryId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td class="text-right">@row.ApprovalThreshold.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.PreferredVendor) ? "—" : row.PreferredVendor)</td>
                            <td><span class="label label-default">@(row.Active ? "active" : "inactive")</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Dry-run: <code>proc_category_save</code> — writes=0.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=purchasing&tab=procurement_categories";
    private bool _isAdmin;
    private IReadOnlyList<ErpProcCategoryDigest> _cats = [];
    private IReadOnlyList<ErpProcPolicyDigest> _policies = [];
    private int _count, _active, _policyCount;
    private string _source = "n/a";
    private string _message = "";
    private string _formCode = "";
    private string _formResult = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin) { _message = "Sign in for live data."; return; }

        var result = await Dashboards.BuildErpProcurementCategoriesDigestAsync(200, ctx.RequestAborted);
        _cats = result.Categories;
        _policies = result.Policies;
        _count = result.Count;
        _active = result.ActiveCount;
        _policyCount = result.PolicyCount;
        _source = result.Source;
        _message = result.Message;
    }

    private void OnSave()
    {
        var result = CategorySave.Evaluate(new ErpProcCategorySaveRequest(0, _formCode, false));
        _formResult = $"{result.Status}: {result.Detail} (writes={result.Writes.ToString(CultureInfo.InvariantCulture)})";
    }
}
