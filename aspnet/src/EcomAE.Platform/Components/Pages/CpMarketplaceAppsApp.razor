@page "/cp/marketplace-apps-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Marketplace apps · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Marketplace apps
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/marketplace-apps-app")</p>
                <p>Open an app for a short description excerpt, installs, and review titles. Install, review, and config writes stay on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/marketplace-apps-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedApp is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Marketplace app KPIs">
        <div class="kpi"><div class="lbl">Apps</div><div class="val">@_summary.AppCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Published</div><div class="val">@_summary.PublishedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Installs</div><div class="val">@_summary.InstallCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active installs</div><div class="val">@_summary.ActiveInstallCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedApp is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedApp.Name) ? _openedApp.Name : ("App #" + _openedApp.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedApp.Status) ? _openedApp.Status : "—")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedApp.AppKey) ? _openedApp.AppKey : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedApp.Category) ? _openedApp.Category : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedApp.Developer) ? _openedApp.Developer : "—")
                        · @_openedApp.Version</p>
                    <p>@_openedApp.Pricing
                        · @_openedApp.PriceMonthly.ToString("0.00", CultureInfo.InvariantCulture)/mo
                        · @_openedApp.AvgRating.ToString("0.0", CultureInfo.InvariantCulture) rating</p>
                    @if (!string.IsNullOrWhiteSpace(_openedApp.DescriptionExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedApp.DescriptionExcerpt</pre>
                        @if (_openedApp.DescriptionLen > _openedApp.DescriptionExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_openedApp.DescriptionExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedApp.DescriptionLen.ToString(CultureInfo.InvariantCulture) chars). Full description and config stay on the Classic twin.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No description excerpt yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Installs</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Site</th>
                                    <th>Version</th>
                                    <th>Status</th>
                                    <th>Installed</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedInstalls.Count == 0)
                                {
                                    <tr><td colspan="5">No installs yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var inst in _openedInstalls)
                                    {
                                        <tr>
                                            <td>@inst.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(inst.SiteKey) ? inst.SiteKey : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(inst.InstalledVersion) ? inst.InstalledVersion : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(inst.Status) ? inst.Status : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(inst.InstalledAt) ? inst.InstalledAt : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Reviews</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Site</th>
                                    <th>Rating</th>
                                    <th>Title</th>
                                    <th>Reviewer</th>
                                    <th>Helpful</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedReviews.Count == 0)
                                {
                                    <tr><td colspan="7">No reviews yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var rev in _openedReviews)
                                    {
                                        <tr>
                                            <td>@rev.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(rev.SiteKey) ? rev.SiteKey : "—")</td>
                                            <td>@rev.Rating.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(rev.Title) ? rev.Title : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(rev.ReviewerName) ? rev.ReviewerName : "—")</td>
                                            <td>@rev.HelpfulCount.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(rev.CreatedAt) ? rev.CreatedAt : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_summary.AppCount.ToString(CultureInfo.InvariantCulture) Apps · @_summary.PublishedCount.ToString(CultureInfo.InvariantCulture) Published · @_summary.InstallCount.ToString(CultureInfo.InvariantCulture) Installs · @_summary.ActiveInstallCount.ToString(CultureInfo.InvariantCulture) Active installs.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Key</th>
                    <th>Name</th>
                    <th>Short desc</th>
                    <th>Category</th>
                    <th>Developer</th>
                    <th>Version</th>
                    <th>Pricing</th>
                    <th>Monthly</th>
                    <th>Downloads</th>
                    <th>Rating</th>
                    <th>Reviews</th>
                    <th>Published</th>
                    <th>Status</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="15">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.AppKey) ? row.AppKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ShortDesc) ? row.ShortDesc : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Category) ? row.Category : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Developer) ? row.Developer : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Version) ? row.Version : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Pricing) ? row.Pricing : "—")</td>
                            <td>@row.PriceMonthly.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.Downloads.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.AvgRating.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.ReviewCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PublishedAt) ? row.PublishedAt : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "app_id", row.Id)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_marketplace";
    private const string _listHref = "/cp/marketplace-apps-app";
    private bool _isAdmin;
    private CpMarketplaceAppsSummary _summary = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpMarketplaceAppsRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private CpMarketplaceAppDetail? _openedApp;
    private IReadOnlyList<CpMarketplaceInstallDigest> _openedInstalls = [];
    private IReadOnlyList<CpMarketplaceReviewDigest> _openedReviews = [];

    private string OpenedCaption => _openedApp is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedApp.Name)
            ? ("App #" + _openedApp.Id.ToString(CultureInfo.InvariantCulture))
            : _openedApp.Name)
            + (string.IsNullOrWhiteSpace(_openedApp.Status) ? "" : (" · " + _openedApp.Status));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "app_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpMarketplaceAppsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Apps;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpMarketplaceAppDetailAsync(_openedId, ctx.RequestAborted);
            _openedApp = detail.App;
            _openedInstalls = detail.Installs;
            _openedReviews = detail.Reviews;
            if (_openedApp is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
