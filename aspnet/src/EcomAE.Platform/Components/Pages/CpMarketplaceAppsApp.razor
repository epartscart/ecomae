@page "/cp/marketplace-apps-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Marketplace apps · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Marketplace apps
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/marketplace-apps-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/marketplace-apps-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_summary.AppCount.ToString(CultureInfo.InvariantCulture) Apps · @_summary.PublishedCount.ToString(CultureInfo.InvariantCulture) Published · @_summary.InstallCount.ToString(CultureInfo.InvariantCulture) Installs · @_summary.ActiveInstallCount.ToString(CultureInfo.InvariantCulture) Active installs.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Key</th>
                    <th>Name</th>
                    <th>Short desc</th>
                    <th>Category</th>
                    <th>Developer</th>
                    <th>Version</th>
                    <th>Pricing</th>
                    <th>Monthly</th>
                    <th>Downloads</th>
                    <th>Rating</th>
                    <th>Reviews</th>
                    <th>Published</th>
                    <th>Status</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="15">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.AppKey) ? row.AppKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ShortDesc) ? row.ShortDesc : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Category) ? row.Category : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Developer) ? row.Developer : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Version) ? row.Version : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Pricing) ? row.Pricing : "—")</td>
                            <td>@row.PriceMonthly.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.Downloads.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.AvgRating.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.ReviewCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PublishedAt) ? row.PublishedAt : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_marketplace";
    private bool _isAdmin;
    private CpMarketplaceAppsSummary _summary = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpMarketplaceAppsRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpMarketplaceAppsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Apps;
        _source = result.Source;
        _message = result.Message;
    }
}
