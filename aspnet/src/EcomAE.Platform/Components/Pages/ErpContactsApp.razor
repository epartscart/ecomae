@page "/erp/contacts-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Contacts · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<HeadContent>
<style>
        .epc-cont-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#1d4ed8 45%,#2563eb 100%);
        }
        .epc-cont-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-cont-hero p { margin:0; color:#bfdbfe; max-width:42rem; font-size:.92rem; line-height:1.45; }
        .epc-cont-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-cont-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#fff; background:#2563eb;
        }
        .epc-cont-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); }
        .epc-cont-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-cont-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-cont-kpi strong { display:block; font-size:1.45rem; font-variant-numeric:tabular-nums; }
        .epc-cont-kpi span { color:#64748b; font-size:.78rem; }
        .epc-cont-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-cont-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-cont-table th, .epc-cont-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-cont-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-cont-table a { color:#1d4ed8; font-weight:700; text-decoration:none; }
        .epc-cont-badge { display:inline-flex; padding:.15rem .45rem; border-radius:.3rem; font-size:.72rem; font-weight:700; background:#dbeafe; color:#1e3a8a; }
        .epc-cont-note { margin-top:1rem; padding:.75rem .9rem; background:#eff6ff; border:1px solid #bfdbfe; border-radius:.45rem; color:#1e3a8a; font-size:.86rem; }
        @@media (max-width:900px){ .epc-cont-kpis{grid-template-columns:1fr;} }
</style>
</HeadContent>

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Contacts" BreadcrumbArea="Master Data" BreadcrumbTab="Contacts">

    <section class="epc-cont-hero">
        <h1>Contacts</h1>
        <p>Unified customers, suppliers, and third parties (PHP epc_erp_contacts).</p>
        <div class="epc-cont-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/erp/suppliers-app">Suppliers</a>
            <a class="ghost" href="/erp/invoices-app">Invoices</a>
            <a class="ghost" href="/erp/app">ERP dashboard</a>
        </div>
    </section>

    <div class="epc-cont-kpis" aria-label="Contacts KPIs">
        <div class="epc-cont-kpi"><strong>@_contacts.Count</strong><span>Shown (limit @_limit)</span></div>
        <div class="epc-cont-kpi"><strong>@_source</strong><span>Digest source</span></div>
        <div class="epc-cont-kpi"><strong>@(_isAdmin ? "live" : "guest")</strong><span>Session</span></div>
    </div>

    <div class="epc-cont-table-wrap">
        <table class="epc-cont-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Company</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>City</th>
                    <th>Country</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_contacts.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "Nothing to show yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _contacts)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Name) ? $"#{row.Id}" : row.Name)</strong></td>
                            <td><span class="epc-cont-badge">@row.PartyType</span></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Company) ? "—" : row.Company)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Email) ? "—" : row.Email)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Phone) ? "—" : row.Phone)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.City) ? "—" : row.City)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.CountryCode) ? "—" : row.CountryCode)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="epc-cont-note">@_message</div>
    }

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=common&tab=contacts";
    private bool _isAdmin;
    private IReadOnlyList<ErpContactDigest> _contacts = [];
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpContactsAsync(_limit, ctx.RequestAborted);
        _contacts = result.Contacts;
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
