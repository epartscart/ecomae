@page "/erp/jewellery/workspace"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Services
@using EcomAE.Platform.Routing
@inject ILegacySessionValidator Sessions
@inject ICpCsrfGuard Csrf
@inject IHttpContextAccessor Http
@inject IErpJewelleryWorkspaceReadService Workspace
@inject IErpJwIndusDataService IndusData
@inject IErpJwIfrsReconciliationReadService Ifrs

<PageTitle>Jewellery workspace · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Jewellery workspace" BreadcrumbArea="Industry" BreadcrumbTab="@_tabLabel">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/jewellery/workspace" IsAdmin="_isAdmin" />
    <PhpErpModulePageHeader
        Title="@(_tab == ErpJewelleryGuide.TabKey ? "Jewellery, step by step" : "Jewellery workspace")"
        Subtitle="Metal stock by karat and gram, purchase and sale vouchers, repairs, UAE tax invoices and the month-end posting into the general ledger. Load the tagged sample data, learn the flow, then remove it before going live."
        PhpTabHref="/erp/jewellery/workspace" />
    <ErpPhpFlash Ok="@_flashOk" Err="@_flashErr" />

    <div class="fo-board-dock" aria-label="Workspace actions and metal filter">
        <div class="fo-board-dock__col">
            <strong>Jewellery workspace</strong>
            <form class="fo-filter" method="get" action="@SelfHref">
                <input type="hidden" name="tab" value="@_tab" />
                <label>
                    <span>Metal / karat</span>
                    <select name="metal">
                        <option value="" selected="@(_metal.Length == 0)">All metals</option>
                        @foreach (var m in _snap.Metals)
                        {
                            <option value="@m" selected="@(string.Equals(_metal, m, StringComparison.Ordinal))">@m</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Period</span>
                    <input type="month" name="period" value="@_period" />
                </label>
                <button class="btn btn-sm fo-board-btn" type="submit">Apply filter</button>
                @if (_metal.Length > 0 || _period.Length > 0)
                {
                    <a class="btn btn-sm fo-board-btn" href="@SelfHref?tab=@_tab">Clear</a>
                }
            </form>
        </div>
        <div class="fo-board-dock__actions">
            @if (_isAdmin)
            {
                <form method="post" action="@DemoHref("seed")" class="fo-inline">
                    <input type="hidden" name="@CpCsrfGuard.FieldName" value="@_csrf" />
                    <input type="hidden" name="confirmWrites" value="1" />
                    <input type="hidden" name="returnUrl" value="@(SelfHref + "?tab=" + _tab + QuerySuffix)" />
                    <button class="btn btn-sm fo-board-btn" type="submit"><i class="fa fa-cloud-download"></i> Load sample data</button>
                </form>
                <form method="post" action="@DemoHref("clear")" class="fo-inline">
                    <input type="hidden" name="@CpCsrfGuard.FieldName" value="@_csrf" />
                    <input type="hidden" name="confirmWrites" value="1" />
                    <input type="hidden" name="returnUrl" value="@(SelfHref + "?tab=" + _tab + QuerySuffix)" />
                    <button class="btn btn-sm fo-board-btn fo-board-btn--danger" type="submit"><i class="fa fa-trash"></i> Remove sample data</button>
                </form>
                                <a class="btn btn-sm fo-board-btn" href="@ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/gl-journals-app")"><i class="fa fa-book"></i> GL journals</a>
                <form method="post" action="@ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/jewellery/issue-invoice")" class="fo-inline">
                    <input type="hidden" name="@CpCsrfGuard.FieldName" value="@_csrf" />
                    <input type="hidden" name="confirmWrites" value="1" />
                    <input type="hidden" name="returnUrl" value="@(SelfHref + "?tab=invoices" + QuerySuffix)" />
                    <button class="btn btn-sm fo-board-btn" type="submit"><i class="fa fa-file-text-o"></i> Issue tax invoices</button>
                </form>
            }
            <a class="btn btn-sm fo-board-btn" href="@ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/reports/income-statement")" target="_blank" rel="noopener">Income statement</a>
            <a class="btn btn-sm fo-board-btn" href="@ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/reports/balance-sheet")" target="_blank" rel="noopener">Balance sheet</a>
            <a class="btn btn-sm fo-board-btn" href="@ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/reports/trial-balance")" target="_blank" rel="noopener">Trial balance</a>
        </div>
    </div>
    <style>
        .fo-board-dock { position: sticky; top: 0; z-index: 40; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; margin: 0 0 14px; padding: 10px 14px; background: linear-gradient(90deg, #06302b, #0f766e); color: #ecfdf5; border-bottom: 3px solid #14b8a6; border-radius: 6px; box-shadow: 0 8px 24px rgba(6,48,43,.22); }
        .fo-board-dock strong { color: #5eead4; }
        .fo-board-dock__col { display: flex; flex-direction: column; gap: 6px; }
        .fo-board-dock__actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
        .fo-board-btn { background: #5eead4 !important; color: #06302b !important; border: 0 !important; font-weight: 600; }
        .fo-board-btn--danger { background: #fda4af !important; color: #4c0519 !important; }
        .fo-filter { display: flex; flex-wrap: wrap; gap: 8px; align-items: end; }
        .fo-filter label { display: flex; flex-direction: column; gap: 2px; font-size: 11px; color: #a7f3d0; }
        .fo-filter select, .fo-filter input { font-size: 13px; padding: 4px 8px; border: 1px solid #5eead4; border-radius: 6px; background: #f0fdfa; color: #06302b; min-width: 210px; }
        .fo-filter input { min-width: 140px; }
        .fo-inline { display: inline; margin: 0; }
        .fo-grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 14px; }
        .fo-card { background: #fff; border: 1px solid #d5e3f2; border-radius: 10px; padding: 12px 14px; }
        .fo-card h3 { margin: 0 0 8px; font-size: 14px; color: #0f766e; }
        table.fo { border-collapse: collapse; width: 100%; font-size: 12px; }
        table.fo th, table.fo td { border: 1px solid #e2e8f0; padding: 4px 8px; text-align: left; }
        table.fo th { background: #f0fdfa; color: #0f766e; }
        table.fo td.num { text-align: right; font-variant-numeric: tabular-nums; }
        table.fo td a { color: #1d4ed8; font-weight: 600; }
    </style>

    <ErpJewelleryWorkspaceTabs Active="@_tab" QuerySuffix="@QuerySuffix" />

    @if (_tab == ErpJewelleryGuide.TabKey)
    {
        <ErpJewelleryGuideBoard QuerySuffix="@QuerySuffix" />
    }
    else
    {
        <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Jewellery KPIs">
            @foreach (var kpi in _snap.Kpis)
            {
                <div class="kpi"><div class="lbl">@kpi.Label</div><div class="val">@kpi.Value</div><div class="text-muted" style="font-size:11px">@kpi.Hint</div></div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_snap.Message))
        {
            <p class="text-muted">@_snap.Message</p>
        }

        @if (_tab == "stock")
        {
            <div class="fo-grid2">
                <div class="fo-card"><h3>Metal stock</h3>@RowsTable(new[] { "Code", "Item", "Metal", "Karat", "Type", "Brand", "Category", "Cost/g", "Sale/g", "Pcs", "Grams", "Value" }, _snap.Stock, 7, 8, 9, 10, 11)</div>
                <div class="fo-card"><h3>Low stock — reorder now</h3>@RowsTable(new[] { "Code", "Item", "Metal", "Karat", "Pcs", "Reorder at" }, _snap.LowStock, 4, 5)</div>
            </div>
        }
        else if (_tab == "purchases")
        {
            <div class="fo-grid2">
                <div class="fo-card"><h3>Purchase vouchers</h3>@RowsTable(new[] { "Id", "Type", "No.", "Supplier", "Customer", "Status", "Net", "VAT", "Total", "Date", "Print" }, WithPrint(_snap.Purchases, "voucher"), 10, 6, 7, 8)</div>
                <div class="fo-card"><h3>Voucher lines</h3>@RowsTable(new[] { "Id", "Type", "No.", "Stock code", "Item", "Grams", "Making", "Total" }, _snap.VoucherLines, 5, 6, 7)</div>
            </div>
        }
        else if (_tab == "sales")
        {
            <div class="fo-grid2">
                <div class="fo-card"><h3>Sale vouchers</h3>@RowsTable(new[] { "Id", "Type", "No.", "Supplier", "Customer", "Status", "Net", "VAT", "Total", "Date", "Print" }, WithPrint(_snap.Sales, "voucher"), 10, 6, 7, 8)</div>
            </div>
        }
        else if (_tab == "repairs")
        {
            <div class="fo-grid2">
                <div class="fo-card"><h3>Repair jobs</h3>@RowsTable(new[] { "Id", "No.", "Customer", "Mobile", "Narration", "Status", "Delivery", "Received", "Print" }, WithPrint(_snap.Repairs, "repair"), 8)</div>
            </div>
        }
        else if (_tab == "invoices")
        {
            <div class="fo-grid2">
                <div class="fo-card"><h3>Issued tax invoices</h3>@RowsTable(new[] { "Id", "Voucher", "Invoice no.", "Net", "VAT", "Gross", "Print" }, _snap.Invoices, 6, 3, 4, 5)</div>
            </div>
        }
        else if (_tab == "month-end")
        {
            <div class="fo-grid2">
                <div class="fo-card">
                    <h3>Post to the general ledger</h3>
                    <p class="text-muted">Posts metal purchase vouchers (Dr inventory / Cr supplier payable) and sale vouchers (Dr receivable / Cr revenue / Cr 5% output VAT) into the GL — so the income statement, balance sheet and dashboard insights include the jewellery figures. Scoped to the current period filter; already-posted vouchers are skipped.</p>
                </div>
                <div class="fo-card"><h3>GL journal trail</h3>@RowsTable(new[] { "Id", "Reference", "Journal", "Date" }, _snap.Ledger)</div>
            </div>
            @if (_ifrs is not null)
            {
                var f = _ifrs;
                <div class="fo-card" id="ifrs">
                    <h3>IFRS &amp; UAE VAT reconciliation · @f.From.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) – @f.To.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) · company @f.CompanyId</h3>
                    <form method="get" class="fo-inline"><input type="hidden" name="tab" value="month-end" />
                        From <input type="date" name="from" value="@f.From.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" /> To <input type="date" name="to" value="@f.To.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
                        <button class="btn btn-sm fo-board-btn" type="submit">Reconcile</button></form>
                    <p class="text-muted">Read-only checks from the posted ledger and the jewellery sub-ledgers. A difference is something to investigate; nothing is changed here. These are technical reconciliations, not an IFRS opinion — a qualified accountant must review policies, estimates and disclosures.</p>
                    @RowsTable(new[] { "Area", "Standard", "Check", "Expected", "Actual", "Difference", "Result", "Note" },
                        f.Checks.Select(x => (IReadOnlyList<string>)new[] { x.Area, x.Standard, x.Check, Mn(x.Expected), Mn(x.Actual), Mn(x.Difference), x.Passed ? "PASS" : "DIFFERENCE", x.Note }).ToList(), 3, 4, 5)
                    @if (f.PurchaseGaps.Count > 0)
                    {
                        <h4>Purchase vouchers posted at a different cost than the stock they added (IAS 2.10)</h4>
                        @RowsTable(new[] { "Voucher", "Posted to 1300", "Stock cost", "Difference" }, f.PurchaseGaps.Select(g => (IReadOnlyList<string>)new[] { g.Reference, Mn(g.Posted), Mn(g.StockCost), Mn(g.StockCost - g.Posted) }).ToList(), 1, 2, 3)
                        <p class="text-muted">Posted journals are never edited. Correct these with an approved adjusting journal (Dr 1300 / Cr supplier) after checking the supplier invoice.</p>
                    }
                </div>
                <div class="fo-card" id="ifrs-adjust">
                    <h3>Post IFRS period-end adjustments</h3>
                    <p class="text-muted">Each posts one new, balanced journal with a unique reference (re-posting the same reference is refused). Leave “Post” unticked to preview the entry. Posted journals are never edited; use a new adjustment to correct. Amounts and estimates need accountant approval.</p>
                    <div class="fo-grid2">
                        @foreach (var (kind, title, fields) in IfrsForms)
                        {
                            <form method="post" action="@ClientErpPath.PrefixIfBound(Http.HttpContext, EcomAeRoutes.ErpJewelleryIfrsAdjust)" class="fo-card" style="margin:0">
                                <input type="hidden" name="@CpCsrfGuard.FieldName" value="@_csrf" />
                                <input type="hidden" name="kind" value="@kind" />
                                <input type="hidden" name="returnUrl" value="/erp/jewellery/workspace?tab=month-end#ifrs-adjust" />
                                <strong>@title</strong>
                                <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;margin:6px 0">
                                    <label>As of <input class="form-control input-sm" type="date" name="as_of" value="@f.To.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" /></label>
                                    @foreach (var (name, label, type) in fields)
                                    {
                                        <label>@label <input class="form-control input-sm" name="@name" type="@type" step="any" /></label>
                                    }
                                </div>
                                <label><input type="checkbox" name="confirmWrites" value="1" /> Post (otherwise preview)</label>
                                <button class="btn btn-sm fo-board-btn" type="submit">Preview / post</button>
                            </form>
                        }
                    </div>
                </div>
                <div class="fo-grid2">
                    <div class="fo-card"><h3>Statement of cash flows (IAS 7, direct, from cash journals)</h3>
                        @RowsTable(new[] { "Section", "Counter account", "AED" }, f.CashFlow.Select(x => (IReadOnlyList<string>)new[] { x.Section, x.Label, Mn(x.Amount) }).ToList(), 2)
                        <p><strong>Net cash flow: @Mn(f.CashFlow.Sum(x => x.Amount))</strong></p></div>
                    <div class="fo-card"><h3>Statement of changes in equity (IAS 1.106)</h3>
                        @RowsTable(new[] { "Movement", "AED" }, f.EquityMovements.Select(x => (IReadOnlyList<string>)new[] { x.Label, Mn(x.Amount) }).ToList(), 1)</div>
                    <div class="fo-card"><h3>IAS 2 net realisable value test (metal content, 2% cost to sell)</h3>
                        @RowsTable(new[] { "Stock", "Karat", "Grams", "Carrying cost", "Metal NRV", "Possible write-down" }, f.Nrv.Select(x => (IReadOnlyList<string>)new[] { x.Code, x.Karat, x.Grams.ToString("N3", CultureInfo.InvariantCulture), Mn(x.Carrying), Mn(x.MetalNrv), Mn(x.Shortfall) }).ToList(), 2, 3, 4, 5)
                        <p class="text-muted">Inventory stays at weighted-average cost, not at the gold price. Metal NRV ignores making value, so a shortfall is an indicator for review, not an automatic write-down. Total indicator: @Mn(f.Nrv.Sum(x => x.Shortfall))</p></div>
                    <div class="fo-card"><h3>IFRS 9 expected credit loss — provision matrix</h3>
                        @RowsTable(new[] { "Age", "Outstanding", "Loss rate", "Allowance" }, f.Ecl.Select(x => (IReadOnlyList<string>)new[] { x.Bucket, Mn(x.Exposure), (x.Rate * 100).ToString("0.#", CultureInfo.InvariantCulture) + "%", Mn(x.Allowance) }).ToList(), 1, 2, 3)
                        <p class="text-muted">Illustrative rates; calibrate to loss history and forward-looking information before booking Dr ECL expense / Cr loss allowance. Proposed allowance: @Mn(f.Ecl.Sum(x => x.Allowance))</p></div>
                </div>
            }
        }
        else if (_tab == "indus")
        {
            <div class="fo-grid2">
                <div class="fo-card">
                    <h3>1. Test with INDUS sample data (sandbox)</h3>
                    <p class="text-muted">Loads real INDUS documents (GH-5120 tax invoice with scrap gold, HO-210 tax credit note, HO-37047 fixed-gold purchase, SFX-218 sales fixing, POS advance, journal, petty cash, repair, stock verification) with masters, opening stock and an opening trial balance. Stock weight/value moves per line and every voucher posts to the chart of accounts, so the stock report, metal report, trial balance and dashboard agree.</p>
                    @if (_isAdmin)
                    {
                        <form method="post" action="@IndusHref("samples")" class="fo-inline">
                            <input type="hidden" name="@CpCsrfGuard.FieldName" value="@_csrf" />
                            <input type="hidden" name="confirmWrites" value="1" />
                            <button class="btn btn-sm fo-board-btn" type="submit"><i class="fa fa-cloud-download"></i> Load INDUS sample data</button>
                        </form>
                        <form method="post" action="@IndusHref("samples")" class="fo-inline">
                            <input type="hidden" name="@CpCsrfGuard.FieldName" value="@_csrf" />
                            <button class="btn btn-sm fo-board-btn" type="submit">Dry-run samples</button>
                        </form>
                        <form method="post" action="@IndusHref("clear")" class="fo-inline">
                            <input type="hidden" name="@CpCsrfGuard.FieldName" value="@_csrf" />
                            <input type="hidden" name="confirmWrites" value="1" />
                            <button class="btn btn-sm fo-board-btn fo-board-btn--danger" type="submit"><i class="fa fa-trash"></i> Remove INDUS-imported data</button>
                        </form>
                    }
                </div>
                <div class="fo-card">
                    <h3>2. Import your INDUS export (CSV)</h3>
                    <p class="text-muted">Pick the template (or upload several files named like <code>14_vouchers.csv</code>). Leave “Write” unticked for a dry run — every row is validated and nothing is saved. Sandbox databases only.</p>
                    @if (_isAdmin)
                    {
                        <form method="post" action="@IndusHref("import")" enctype="multipart/form-data">
                            <input type="hidden" name="@CpCsrfGuard.FieldName" value="@_csrf" />
                            <select name="template">
                                <option value="">(from file names)</option>
                                @foreach (var t in ErpJwIndusImportSpec.Templates)
                                {
                                    <option value="@t.Key">@t.Step.ToString("00", CultureInfo.InvariantCulture) — @t.Title</option>
                                }
                            </select>
                            <input type="file" name="file" accept=".csv" multiple />
                            <label><input type="checkbox" name="confirmWrites" value="1" /> Write (otherwise dry run)</label>
                            <button class="btn btn-sm fo-board-btn" type="submit"><i class="fa fa-upload"></i> Validate / import</button>
                        </form>
                    }
                </div>
                @if (_indusTable is not null)
                {
                    var tpl = _indusTable.Template;
                    <div class="fo-card" style="grid-column:1/-1" id="indus-data">
                        <h3>@tpl.Step.ToString("00", CultureInfo.InvariantCulture) — @tpl.Title · <code>@tpl.Table</code> · @_indusTable.Total.ToString("N0", CultureInfo.InvariantCulture) rows <a class="btn btn-xs btn-default" href="@ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/jewellery/workspace?tab=indus")">Close</a></h3>
                        <p class="text-muted">INDUS screen: @tpl.IndusScreen · Module: @tpl.Module · Feeds: @tpl.Workflow</p>
                        @if (_isAdmin && ErpJwIndusDataService.EditableKeys.Contains(tpl.Key))
                        {
                            <form method="post" action="@ClientErpPath.PrefixIfBound(Http.HttpContext, EcomAeRoutes.ErpJewelleryIndusMasterSave)" class="jw-mp-grid" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-bottom:10px">
                                <input type="hidden" name="@CpCsrfGuard.FieldName" value="@_csrf" />
                                <input type="hidden" name="confirmWrites" value="1" />
                                <input type="hidden" name="key" value="@tpl.Key" />
                                <input type="hidden" name="returnUrl" value="@("/erp/jewellery/workspace?tab=indus&key=" + tpl.Key)" />
                                @foreach (var col in tpl.Columns.Where(x => x.Column.Length > 0))
                                {
                                    <label>@col.IndusField@(col.Required ? " *" : "")
                                        <input class="form-control input-sm" name="@col.Header" required="@col.Required"
                                               type="@(col.Type == ErpJwIndusColType.Date ? "date" : col.Type is ErpJwIndusColType.Decimal or ErpJwIndusColType.Int ? "number" : "text")"
                                               step="@(col.Type == ErpJwIndusColType.Decimal ? "0.01" : "1")"
                                               maxlength="@(col.MaxLength > 0 ? col.MaxLength : 200)" />
                                    </label>
                                }
                                <div style="grid-column:1/-1"><button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-save" aria-hidden="true"></i> Save @tpl.Title.Split(' ')[0].ToLowerInvariant()</button> <span class="text-muted">Same code updates the existing record.</span></div>
                            </form>
                        }
                        @if (_indusTable.Message.Length > 0)
                        {
                            <p class="text-muted">@_indusTable.Message</p>
                        }
                        else
                        {
                            <div style="overflow:auto;max-height:60vh">@RowsTable(_indusTable.Headers.ToArray(), _indusTable.Rows)</div>
                        }
                    </div>
                }
                <div class="fo-card" style="grid-column:1/-1">
                    <h3>Templates — load in this order · <a href="@TemplateHref("fieldmap", false)">Download full field map (INDUS field → table.column → module → GL)</a></h3>
                    <table class="fo">
                        <tr><th>#</th><th>Template</th><th>INDUS screen / report</th><th>ecomae table</th><th>Module</th><th>Feeds</th><th class="num">Rows in ERP</th><th>Where in ERP</th><th>Download</th></tr>
                        @foreach (var t in ErpJwIndusImportSpec.Templates)
                        {
                            var n = _indusCounts.TryGetValue(t.Key, out var c) ? c : 0;
                            <tr>
                                <td>@t.Step</td><td>@t.Title</td><td>@t.IndusScreen</td><td><code>@t.Table</code></td><td>@t.Module</td><td>@t.Workflow</td>
                                <td class="num">@(n < 0 ? "not provisioned" : n.ToString("N0", CultureInfo.InvariantCulture))</td>
                                <td><a href="@ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/jewellery/workspace?tab=indus&key=" + t.Key)">All fields</a> · <a href="@ClientErpPath.PrefixIfBound(Http.HttpContext, ErpJwIndusDataService.ScreenHref(t.Key))" target="_blank" rel="noopener">Open screen</a></td>
                                <td><a href="@TemplateHref(t.Key, true)">blank</a> · <a href="@TemplateHref(t.Key, false)">sample</a></td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        }
        else if (_tab == "reports")
        {
            <div class="fo-grid2">
                <div class="fo-card"><h3>Sales register</h3>@RowsTable(new[] { "Id", "Type", "No.", "Supplier", "Customer", "Status", "Net", "VAT", "Total", "Date" }, _snap.Sales, 6, 7, 8)</div>
                <div class="fo-card"><h3>Stock valuation</h3>@RowsTable(new[] { "Code", "Item", "Metal", "Karat", "Type", "Brand", "Category", "Cost/g", "Sale/g", "Pcs", "Grams", "Value" }, _snap.Stock, 7, 8, 9, 10, 11)</div>
                <div class="fo-card"><h3>GL journal trail</h3>@RowsTable(new[] { "Id", "Reference", "Journal", "Date" }, _snap.Ledger)</div>
            </div>
        }
    }
</PhpErpDesktopChrome>

@code {
    private ErpJewelleryWorkspaceSnapshot _snap = new();
    private string _tab = ErpJewelleryGuide.TabKey;
    private string _tabLabel = "Guide";
    private string _metal = string.Empty;
    private string _period = string.Empty;
    private bool _isAdmin;
    private IReadOnlyDictionary<string, long> _indusCounts = new Dictionary<string, long>();
    private ErpJwIndusDataTable? _indusTable;
    private ErpJwIfrsReport? _ifrs;

    private static string Mn(decimal v) => v.ToString("N2", CultureInfo.InvariantCulture);

    private static readonly (string Kind, string Title, (string Name, string Label, string Type)[] Fields)[] IfrsForms =
    [
        ("ecl", "IFRS 9 — expected credit loss allowance", [("amount", "Target allowance (blank = matrix)", "number")]),
        ("nrv", "IAS 2 — write stock down to NRV", [("cost_to_sell_pct", "Cost to sell % (default 2)", "number")]),
        ("true_up", "Inventory true-up GL → stock sub-ledger", [("approved_by", "Approved by", "text")]),
        ("provision", "IAS 37 — provision (negative releases)", [("ref", "Reference", "text"), ("amount", "Amount", "number"), ("description", "Obligation", "text")]),
        ("lease", "IFRS 16 — lease (month 0 = recognise)", [("ref", "Lease reference", "text"), ("payment", "Monthly payment", "number"), ("months", "Term (months)", "number"), ("rate", "Borrowing rate % p.a.", "number"), ("month", "Month to post (0 = initial)", "number")]),
    ];
    private string _csrf = string.Empty;
    private string _flashOk = string.Empty;
    private string _flashErr = string.Empty;

    private string QuerySuffix
    {
        get
        {
            var suffix = string.Empty;
            if (_metal.Length > 0)
            {
                suffix += "&metal=" + Uri.EscapeDataString(_metal);
            }

            if (_period.Length > 0)
            {
                suffix += "&period=" + Uri.EscapeDataString(_period);
            }

            return suffix;
        }
    }

    private string SelfHref
        => ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/jewellery/workspace");

    private string IndusHref(string action)
        => ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/jewellery/indus-" + action);

    private string TemplateHref(string key, bool blank)
        => ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/jewellery/indus-template?key=" + Uri.EscapeDataString(key) + (blank ? "&blank=1" : ""));

    private static IReadOnlyList<IReadOnlyList<string>> WithPrint(IReadOnlyList<IReadOnlyList<string>> rows, string kind)
        => rows.Select(r => (IReadOnlyList<string>)r.Concat(new[] { "/erp/jewellery/voucher-print?id=" + (r.Count > 0 ? r[0] : "0") + "&kind=" + kind }).ToList()).ToList();

    private string DemoHref(string action)
        => ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/jewellery/demo-" + action);

    private RenderFragment RowsTable(string[] headers, IReadOnlyList<IReadOnlyList<string>> rows, params int[] numCols)
        => RowsTable(headers, rows, -1, numCols);

    private RenderFragment RowsTable(string[] headers, IReadOnlyList<IReadOnlyList<string>> rows, int linkCol, params int[] numCols) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "table");
        builder.AddAttribute(seq++, "class", "fo");
        builder.OpenElement(seq++, "tr");
        foreach (var head in headers)
        {
            builder.OpenElement(seq++, "th");
            builder.AddContent(seq++, head);
            builder.CloseElement();
        }

        builder.CloseElement();
        foreach (var row in rows)
        {
            builder.OpenElement(seq++, "tr");
            for (var i = 0; i < row.Count && i < headers.Length; i++)
            {
                var numeric = numCols.Contains(i);
                builder.OpenElement(seq++, "td");
                if (numeric)
                {
                    builder.AddAttribute(seq++, "class", "num");
                }

                var cell = row[i];
                if (i == linkCol && cell.StartsWith("/", StringComparison.Ordinal))
                {
                    builder.OpenElement(seq++, "a");
                    builder.AddAttribute(seq++, "href", ClientErpPath.PrefixIfBound(Http.HttpContext, cell));
                    builder.AddAttribute(seq++, "target", "_blank");
                    builder.AddAttribute(seq++, "rel", "noopener");
                    builder.AddContent(seq++, "Print");
                    builder.CloseElement();
                }
                else
                {
                    builder.AddContent(seq++, cell);
                }

                builder.CloseElement();
            }

            builder.CloseElement();
        }

        builder.CloseElement();
    };

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _flashOk = ctx.Request.Query["ok"].ToString() ?? string.Empty;
        _flashErr = ctx.Request.Query["err"].ToString() ?? string.Empty;
        _tab = ErpJewelleryGuide.Normalize(ctx.Request.Query["tab"].ToString());
        _tabLabel = ErpJewelleryWorkspace.Label(_tab);
        _period = ctx.Request.Query["period"].ToString() ?? string.Empty;
        _metal = (ctx.Request.Query["metal"].ToString() ?? string.Empty).Trim();
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (_isAdmin)
        {
            _csrf = await Csrf.KeyForAsync(ctx, session, ctx.RequestAborted);
        }

        _snap = await Workspace.LoadAsync(_metal, _period, ctx.RequestAborted);
        if (_isAdmin && _tab == "month-end")
        {
            DateOnly? Date(string k) => DateOnly.TryParseExact(ctx.Request.Query[k].ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d : null;
            _ifrs = await Ifrs.ReadAsync(Date("from"), Date("to"), 0.02m, ctx.RequestAborted);
        }

        if (_isAdmin && _tab == "indus")
        {
            _indusCounts = await IndusData.CountsAsync(ctx.RequestAborted);
            var key = ctx.Request.Query["key"].ToString().Trim();
            if (key.Length > 0)
            {
                _indusTable = await IndusData.TableAsync(key, 300, ctx.RequestAborted);
            }
        }
    }
}
