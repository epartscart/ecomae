@page "/cp/delivery-methods-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Delivery Methods · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Delivery methods
                <a class="btn btn-xs btn-default pull-right" href="@_carriersHref">Carriers</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" style="margin-right:.4rem">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Pickup, courier, and obtaining modes offered at checkout. Activate or save a method here.</p>
            </div>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/delivery-methods/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/delivery-methods-app" />
            <input type="hidden" name="action" value="activation" />
            <label>Method id <input type="number" name="modeId" min="1" required style="width:6rem" /></label>
            <label>Available
                <select name="available">
                    <option value="1">Yes</option>
                    <option value="0">No</option>
                </select>
            </label>
            <button type="submit">Set available</button>
        </form>
        <form method="post" action="/cp/delivery-methods/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/delivery-methods-app" />
            <input type="hidden" name="action" value="save" />
            <label>Method id <input type="number" name="modeId" min="1" required style="width:6rem" /></label>
            <label>Caption <input type="text" name="caption" required /></label>
            <label>Sort <input type="number" name="sortOrder" value="0" style="width:5rem" /></label>
            <label>Available
                <select name="available">
                    <option value="1">Yes</option>
                    <option value="0">No</option>
                </select>
            </label>
            <label>Parameters JSON <input type="text" name="parametersValues" placeholder="{}" /></label>
            <button type="submit">Save method</button>
        </form>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Obtain modes</div>
            <div class="panel-body">
                <p class="help-block">@(_isAdmin ? $"{_modes.Count} obtain modes from shop_obtaining_modes." : "Sign in to load obtain modes.")</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th><input type="checkbox" id="check_uncheck_all" name="check_uncheck_all" onchange="on_check_uncheck_all();" /></th>
                                <th>ID</th>
                                <th>Caption</th>
                                <th>Sort</th>
                                <th class="text-center">Available</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!_isAdmin)
                        {
                            <tr><td colspan="5">Sign in for live data.</td></tr>
                        }
                        else if (_modes.Count == 0)
                        {
                            <tr><td colspan="5">No delivery methods configured yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var m in _modes)
                            {
                                var idText = m.Id.ToString(CultureInfo.InvariantCulture);
                                <tr>
                                    <td><input type="checkbox" id="checked_@idText" name="checked_@idText" onchange="on_one_check_changed('checked_@idText');" /></td>
                                    <td>@idText</td>
                                    <td>@(string.IsNullOrWhiteSpace(m.Caption) ? "—" : m.Caption)</td>
                                    <td>@m.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                                    <td class="text-center">
                                        <form method="post" action="/cp/delivery-methods/write" style="display:inline">
                                            <input type="hidden" name="confirmWrites" value="true" />
                                            <input type="hidden" name="returnUrl" value="/cp/delivery-methods-app" />
                                            <input type="hidden" name="action" value="activation" />
                                            <input type="hidden" name="obtain_mode_id" value="@idText" />
                                            <input type="hidden" name="activate_obtain_mode" value="@(m.Available ? "-1" : "1")" />
                                            <button type="submit" class="btn btn-xs @(m.Available ? "btn-primary" : "btn-default")">@(m.Available ? "On" : "Off")</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <script>
        function on_check_uncheck_all() {
            var master = document.getElementById("check_uncheck_all");
            if (!master) { return; }
            var boxes = document.querySelectorAll("input[id^='checked_']");
            for (var i = 0; i < boxes.length; i++) { boxes[i].checked = master.checked; }
        }
        function on_one_check_changed() {
            var master = document.getElementById("check_uncheck_all");
            if (!master) { return; }
            var boxes = document.querySelectorAll("input[id^='checked_']");
            for (var i = 0; i < boxes.length; i++) {
                if (!boxes[i].checked) { master.checked = false; return; }
            }
            master.checked = boxes.length > 0;
        }
    </script>
</PhpCpDesktopChrome>

@code {
    private const string _carriersHref = "/cp/carriers-app";
    private const string _phpTab = "/CP/shop/logistics/sposoby-polucheniya";
    private bool _isAdmin;
    private IReadOnlyList<CpDeliveryMethodDigest> _modes = [];
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpDeliveryMethodsDigestAsync(200, ctx.RequestAborted);
        _modes = result.Modes;
    }
}
