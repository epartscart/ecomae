@page "/cp/delivery-methods-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@inject ICpObtainingModeEditorService Modes
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Delivery Methods · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<style>
    .epc-dm-actions .panel_a { display:inline-block; text-align:center; text-decoration:none; color:#333; margin-right:14px; vertical-align:top; }
    .epc-dm-actions .panel_a_img { width:48px; height:48px; margin:0 auto 4px; border-radius:8px; background:#f1f3f6; display:flex; align-items:center; justify-content:center; font-size:22px; color:#3498db; }
    .epc-dm-actions .panel_a_caption { font-size:12px; }
    .epc-dm-list td a { color:inherit; display:block; text-decoration:none; }
    .epc-dm-list .pagination { margin:8px 0 0; }
    .epc-dm-list .a_col_img { border:0; background:none; font-size:20px; cursor:pointer; }
    .epc-dm-list .a_col_img.on { color:#62cb31; }
    .epc-dm-list .a_col_img.off { color:#c0c0c0; }
    .epc-dm-form .form-group { margin-bottom:10px; }
    .epc-dm-form .hr-line-dashed { border-top:1px dashed #e4e5e7; margin:12px 0; }
</style>

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    @if (!_isAdmin)
    {
        <div class="hpanel"><div class="panel-body">
            <div class="alert alert-warning" role="status">Sign in to the Control Panel to manage delivery methods. <a href="/cp/login?returnUrl=/cp/delivery-methods-app">Login</a></div>
        </div></div>
    }
    else if (_editor is not null)
    {
        @* ---- obtaining_mode.php twin: edit one obtaining mode ---- *@
        var idText = _editor.Id.ToString(CultureInfo.InvariantCulture);
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Obtaining mode #@idText
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab + "/sposob-polucheniya?obtaining_mode_id=" + idText)">Classic twin</a>
            </div>
            <div class="panel-body epc-dm-actions">
                <a class="panel_a" href="javascript:void(0);" onclick="document.getElementById('save_form').requestSubmit();"><div class="panel_a_img"><i class="fa fa-save"></i></div><div class="panel_a_caption">Save</div></a>
                <a class="panel_a" href="@_listHref"><div class="panel_a_img"><i class="fa fa-truck"></i></div><div class="panel_a_caption">Obtaining modes</div></a>
                <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="alert alert-success" role="status">@_flashOk</div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="alert alert-danger" role="status">@_flashErr</div> }

        <form id="save_form" method="post" action="/cp/delivery-methods/write" class="epc-dm-form">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@ErpRecordOpen.Href(_listHref, "obtaining_mode_id", _editor.Id)" />
            <input type="hidden" name="action" value="save_action" />
            <input type="hidden" name="id" value="@idText" />
            <input type="hidden" name="caption_lang_str_id" value="@_editor.CaptionLangStrId" />
            <input type="hidden" name="lang_code" value="en" />
            <input type="hidden" name="values_from_form" value="1" />
            <div class="row">
                <div class="col-lg-6">
                    <div class="hpanel">
                        <div class="panel-heading hbuilt">Main settings</div>
                        <div class="panel-body">
                            <div class="form-group"><label class="control-label">ID</label><div class="form-control-static">@idText</div></div>
                            <div class="hr-line-dashed"></div>
                            <div class="form-group"><label class="control-label" for="caption_input">Name</label><input class="form-control" type="text" id="caption_input" name="caption" required value="@_editor.Caption" /></div>
                            <div class="hr-line-dashed"></div>
                            <div class="form-group"><label class="control-label" for="order_input">Display order</label><input class="form-control" type="number" id="order_input" name="order" value="@_editor.SortOrder.ToString(CultureInfo.InvariantCulture)" /></div>
                            <div class="hr-line-dashed"></div>
                            <div class="form-group">
                                <label class="control-label" for="available_input">Available</label>
                                <input type="hidden" name="available" id="available" value="@(_editor.Available == 1 ? "1" : "0")" />
                                <div><input type="checkbox" id="available_input" checked="@(_editor.Available == 1)" onchange="document.getElementById('available').value = this.checked ? '1' : '0';" /></div>
                            </div>
                        </div>
                        <div class="panel-footer text-right">
                            <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Save</button>
                            <a class="btn btn-default" href="@_listHref">Cancel</a>
                        </div>
                    </div>
                </div>
                @if (_editor.Parameters.Count > 0)
                {
                    <div class="col-lg-6">
                        <div class="hpanel">
                            <div class="panel-heading hbuilt">Special settings</div>
                            <div class="panel-body">
                                @for (var i = 0; i < _editor.Parameters.Count; i++)
                                {
                                    var p = _editor.Parameters[i];
                                    if (i > 0) { <div class="hr-line-dashed"></div> }
                                    <div class="form-group">
                                        <label class="control-label" for="pv_@p.Name">@p.Caption</label>
                                        <input class="form-control" type="@p.Type" id="pv_@p.Name" name="pv_@p.Name" value="@p.Value" />
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </form>
    }
    else
    {
        @* ---- obtaining_modes.php twin: list with on/off toggles ---- *@
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Obtaining modes (delivery methods)
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body epc-dm-actions">
                <a class="panel_a" href="@_carriersHref"><div class="panel_a_img"><i class="fa fa-ship"></i></div><div class="panel_a_caption">Carriers</div></a>
                <a class="panel_a" href="/cp/offices-app"><div class="panel_a_img"><i class="fa fa-building-o"></i></div><div class="panel_a_caption">Offices</div></a>
                <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="alert alert-success" role="status">@_flashOk</div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="alert alert-danger" role="status">@_flashErr</div> }

        <div class="hpanel epc-dm-list">
            <div class="panel-heading hbuilt">Obtaining modes list</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped" id="modes_table">
                        <thead>
                            <tr>
                                <th style="width:30px"><input type="checkbox" id="check_uncheck_all" onchange="on_check_uncheck_all();" /></th>
                                <th style="width:70px">ID</th>
                                <th>Name</th>
                                <th style="width:120px">Order</th>
                                <th class="text-center" style="width:120px">Available</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_list.Rows.Count == 0)
                        {
                            <tr><td colspan="5" class="text-muted">No obtaining modes are enabled for the control panel (<code>control_available = 1</code>).</td></tr>
                        }
                        @foreach (var m in _list.Rows)
                        {
                            var idText = m.Id.ToString(CultureInfo.InvariantCulture);
                            var open = ErpRecordOpen.Href(_listHref, "obtaining_mode_id", m.Id);
                            <tr id="erp-row-@idText">
                                <td><input type="checkbox" class="epc-mode-check" id="checked_@idText" value="@idText" onchange="on_one_check_changed();" /></td>
                                <td><a href="@open">@idText</a></td>
                                <td><a href="@open">@m.Caption</a></td>
                                <td><a href="@open">@m.SortOrder.ToString(CultureInfo.InvariantCulture)</a></td>
                                <td class="text-center">
                                    <form method="post" action="/cp/delivery-methods/write" style="margin:0">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="@(_list.Page > 1 ? _listHref + "?s_page=" + _list.Page.ToString(CultureInfo.InvariantCulture) : _listHref)" />
                                        <input type="hidden" name="action" value="activation" />
                                        <input type="hidden" name="activate_obtain_mode" value="@(m.Available == 1 ? "0" : "1")" />
                                        <input type="hidden" name="obtain_mode_id" value="@idText" />
                                        <button type="submit" class="a_col_img @(m.Available == 1 ? "on" : "off")" title="@(m.Available == 1 ? "Deactivate" : "Activate")"><i class="fa @(m.Available == 1 ? "fa-toggle-on" : "fa-toggle-off")"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (_list.Pages > 1)
                {
                    <div class="row"><div class="col-lg-12 text-center"><div class="dataTables_paginate paging_simple_numbers"><ul class="pagination">
                        @for (var i = 1; i <= _list.Pages; i++)
                        {
                            <li class="paginate_button @(i == _list.Page ? "active" : "")">
                                @if (i == _list.Page) { <a href="javascript:void(0);">@i.ToString(CultureInfo.InvariantCulture)</a> }
                                else { <a href="@(_listHref)?s_page=@i.ToString(CultureInfo.InvariantCulture)">@i.ToString(CultureInfo.InvariantCulture)</a> }
                            </li>
                        }
                    </ul></div></div></div>
                }
            </div>
        </div>
        <script>
            function on_check_uncheck_all() {
                var state = document.getElementById('check_uncheck_all').checked;
                document.querySelectorAll('.epc-mode-check').forEach(function (c) { c.checked = state; });
            }
            function on_one_check_changed() {
                var all = true;
                document.querySelectorAll('.epc-mode-check').forEach(function (c) { if (!c.checked) all = false; });
                document.getElementById('check_uncheck_all').checked = all;
            }
        </script>
    }
</PhpCpDesktopChrome>

@code {
    private const string _carriersHref = "/cp/carriers-app";
    private const string _phpTab = "/CP/shop/logistics/sposoby-polucheniya";
    private const string _listHref = "/cp/delivery-methods-app";
    private bool _isAdmin;
    private string _flashOk = "";
    private string _flashErr = "";
    private CpObtainingModeList _list = new([], 0, 1, 30);
    private CpObtainingModeEditor? _editor;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var id = ErpRecordOpen.ReadId(ctx.Request, "obtaining_mode_id", "id");
        if (id > 0)
        {
            _editor = await Modes.OpenAsync(id, ctx.RequestAborted);
            if (_editor is not null) return;
            _flashErr = "Obtaining mode #" + id.ToString(CultureInfo.InvariantCulture) + " was not found.";
        }

        var page = int.TryParse(ctx.Request.Query["s_page"], NumberStyles.Integer, CultureInfo.InvariantCulture, out var p) && p > 0 ? p : 1;
        _list = await Modes.ListAsync(page, 30, ctx.RequestAborted);
    }
}
