@page "/cp/delivery-methods-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Delivery Methods · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-del-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-del-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-del-hero p { margin:0; color:rgba(255,255,255,.85); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-del-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-del-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0c4a6e; background:#e0f2fe;
        }
        .epc-del-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-del-kpis { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-del-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-del-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-del-kpi span { color:#64748b; font-size:.78rem; }
        .epc-del-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-del-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-del-table th, .epc-del-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-del-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        @@media (max-width:900px){ .epc-del-kpis{grid-template-columns:1fr;} }
    
</style>
</HeadContent>


<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-del-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Delivery Methods</h1>
        <p>Pickup, courier, and obtaining modes offered at checkout — wire handlers to carrier accounts as needed.</p>
        <div class="epc-del-cta">
            <a href="@_configureHref">Manage methods</a>
            <a class="ghost" href="@_carriersHref">Carriers</a>
        </div>
    </section>

    <div class="epc-del-kpis" aria-label="Delivery method stats">
        <div class="epc-del-kpi"><strong>@_summary.Methods.ToString(CultureInfo.InvariantCulture)</strong><span>Methods</span></div>
        <div class="epc-del-kpi"><strong>@_summary.Available.ToString(CultureInfo.InvariantCulture)</strong><span>Available</span></div>
    </div>

    <div class="epc-del-table-wrap">
        <table class="epc-del-table">
            <thead>
                <tr>
                    <th>Caption</th>
                    <th>Handler</th>
                    <th>Available</th>
                    <th>Control</th>
                    <th>Sort</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_modes.Count == 0)
                {
                    <tr><td colspan="6">No delivery methods configured yet.</td></tr>
                }
                else
                {
                    @foreach (var m in _modes)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(m.Caption) ? "—" : m.Caption)</td>
                            <td>@(string.IsNullOrWhiteSpace(m.Handler) ? "—" : m.Handler)</td>
                            <td>@(m.Available ? "yes" : "no")</td>
                            <td>@(m.ControlAvailable ? "yes" : "no")</td>
                            <td>@m.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@_configureHref">Configure</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _configureHref = "/cp/delivery-methods-app";
    private const string _carriersHref = "/cp/carriers-app";
    private bool _isAdmin;
    private CpDeliveryMethodsSummary _summary = new(0, 0, "n/a", "");
    private IReadOnlyList<CpDeliveryMethodDigest> _modes = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpDeliveryMethodsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _modes = result.Modes;
    }
}
