@page "/cp/po-approvals-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>PO approvals · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                PO approvals
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/po-approvals-app")</p>
                <p>Approve or reject a pending purchase-order request here.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/po-approvals-app" IsAdmin="_isAdmin" />


    @if (!string.IsNullOrWhiteSpace(_flash))
    {
        <div class="alert @(_flashOk ? "alert-success" : "alert-danger")" role="status" style="margin:0 0 1rem;padding:.7rem .9rem">@_flash</div>
    }

    <p class="help-block">@_summary.RequestCount.ToString(CultureInfo.InvariantCulture) Requests · @_summary.PendingCount.ToString(CultureInfo.InvariantCulture) Pending · @_summary.ApprovedCount.ToString(CultureInfo.InvariantCulture) Approved · @_summary.StepCount.ToString(CultureInfo.InvariantCulture) Steps.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Site</th>
                    <th>PO</th>
                    <th>Requester</th>
                    <th>Vendor</th>
                    <th>Currency</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Tier</th>
                    <th>Priority</th>
                    <th>Created</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="12">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.SiteKey) ? row.SiteKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PoNumber) ? row.PoNumber : "—")</td>
                            <td>@row.RequesterId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.VendorName) ? row.VendorName : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Currency) ? row.Currency : "—")</td>
                            <td>@row.Total.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@row.CurrentTier.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Priority) ? row.Priority : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CreatedAt) ? row.CreatedAt : "—")</td>
                            <td>
                                @if (string.Equals(row.Status, "pending", StringComparison.OrdinalIgnoreCase))
                                {
                                    <form method="post" action="/cp/po-approvals/approve" style="display:inline;margin:0">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="/cp/po-approvals-app" />
                                        <input type="hidden" name="poId" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                        <input type="hidden" name="tier" value="@row.CurrentTier.ToString(CultureInfo.InvariantCulture)" />
                                        <button type="submit" class="btn btn-xs btn-primary">Approve</button>
                                    </form>
                                    <form method="post" action="/cp/po-approvals/reject" style="display:inline;margin:0 0 0 .3rem">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="/cp/po-approvals-app" />
                                        <input type="hidden" name="poId" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                        <input type="hidden" name="tier" value="@row.CurrentTier.ToString(CultureInfo.InvariantCulture)" />
                                        <input type="hidden" name="reason" value="Rejected from CP" />
                                        <button type="submit" class="btn btn-xs btn-default">Reject</button>
                                    </form>
                                }
                            </td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/epc_po_approval";
    private bool _isAdmin;
    private CpPoApprovalsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPoApprovalsRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flash = "";
    private bool _flashOk;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var ok = ctx.Request.Query["ok"].ToString();
        var err = ctx.Request.Query["err"].ToString();
        if (!string.IsNullOrWhiteSpace(ok)) { _flash = ok; _flashOk = true; }
        else if (!string.IsNullOrWhiteSpace(err)) { _flash = err; _flashOk = false; }

        var result = await Dashboards.BuildCpPoApprovalsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Requests;
        _source = result.Source;
        _message = result.Message;
    }
}
