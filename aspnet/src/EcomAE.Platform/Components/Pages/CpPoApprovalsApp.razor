@page "/cp/po-approvals-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>PO approvals · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                PO approvals
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/po-approvals-app")</p>
                <p>Open a request for description and notes excerpts plus approval steps. Approve or reject a pending purchase-order request here. Line items and attachments stay on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/po-approvals-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedRequest is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (!string.IsNullOrWhiteSpace(_flash))
    {
        <div class="alert @(_flashOk ? "alert-success" : "alert-danger")" role="status" style="margin:0 0 1rem;padding:.7rem .9rem">@_flash</div>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="PO approval KPIs">
        <div class="kpi"><div class="lbl">Requests</div><div class="val">@_summary.RequestCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Pending</div><div class="val">@_summary.PendingCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Approved</div><div class="val">@_summary.ApprovedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Opened steps</div><div class="val">@_openedSteps.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedRequest is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @OpenedCaption
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedRequest.Status) ? _openedRequest.Status : "—")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedRequest.PoNumber) ? _openedRequest.PoNumber : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedRequest.VendorName) ? _openedRequest.VendorName : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedRequest.Currency) ? _openedRequest.Currency : "—")
                        · subtotal @_openedRequest.Subtotal.ToString(CultureInfo.InvariantCulture)
                        · tax @_openedRequest.Tax.ToString(CultureInfo.InvariantCulture)
                        · total @_openedRequest.Total.ToString(CultureInfo.InvariantCulture)
                        · tier @_openedRequest.CurrentTier.ToString(CultureInfo.InvariantCulture)
                        · @(!string.IsNullOrWhiteSpace(_openedRequest.Priority) ? _openedRequest.Priority : "—")</p>
                    <p>Requester @_openedRequest.RequesterId.ToString(CultureInfo.InvariantCulture)
                        · site @(!string.IsNullOrWhiteSpace(_openedRequest.SiteKey) ? _openedRequest.SiteKey : "—")
                        · created @(!string.IsNullOrWhiteSpace(_openedRequest.CreatedAt) ? _openedRequest.CreatedAt : "—")
                        · approved @(!string.IsNullOrWhiteSpace(_openedRequest.ApprovedAt) ? _openedRequest.ApprovedAt : "—")
                        · rejected @(!string.IsNullOrWhiteSpace(_openedRequest.RejectedAt) ? _openedRequest.RejectedAt : "—")</p>
                    @if (!string.IsNullOrWhiteSpace(_openedRequest.DescriptionExcerpt))
                    {
                        <p>@_openedRequest.DescriptionExcerpt
                            @if (_openedRequest.DescriptionLen > _openedRequest.DescriptionExcerpt.Length)
                            {
                                <span class="text-muted"> (excerpt)</span>
                            }
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">No description excerpt yet.</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedRequest.NotesExcerpt))
                    {
                        <p>@_openedRequest.NotesExcerpt
                            @if (_openedRequest.NotesLen > _openedRequest.NotesExcerpt.Length)
                            {
                                <span class="text-muted"> (excerpt)</span>
                            }
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">No notes excerpt yet.</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedRequest.RejectionExcerpt))
                    {
                        <p>@_openedRequest.RejectionExcerpt
                            @if (_openedRequest.RejectionLen > _openedRequest.RejectionExcerpt.Length)
                            {
                                <span class="text-muted"> (excerpt)</span>
                            }
                        </p>
                    }
                    @if (string.Equals(_openedRequest.Status, "pending", StringComparison.OrdinalIgnoreCase))
                    {
                        <form method="post" action="/cp/po-approvals/approve" style="display:inline;margin:0">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@_openedReturnUrl" />
                            <input type="hidden" name="poId" value="@_openedRequest.Id.ToString(CultureInfo.InvariantCulture)" />
                            <input type="hidden" name="tier" value="@_openedRequest.CurrentTier.ToString(CultureInfo.InvariantCulture)" />
                            <button type="submit" class="btn btn-xs btn-primary">Approve</button>
                        </form>
                        <form method="post" action="/cp/po-approvals/reject" style="display:inline;margin:0 0 0 .3rem">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@_openedReturnUrl" />
                            <input type="hidden" name="poId" value="@_openedRequest.Id.ToString(CultureInfo.InvariantCulture)" />
                            <input type="hidden" name="tier" value="@_openedRequest.CurrentTier.ToString(CultureInfo.InvariantCulture)" />
                            <input type="hidden" name="reason" value="Rejected from CP" />
                            <button type="submit" class="btn btn-xs btn-default">Reject</button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Approval steps</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Tier</th>
                                    <th>Approver</th>
                                    <th>Decision</th>
                                    <th>Decided</th>
                                    <th>Comment</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSteps.Count == 0)
                                {
                                    <tr><td colspan="6">No approval steps yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var step in _openedSteps)
                                    {
                                        <tr>
                                            <td>@step.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@step.Tier.ToString(CultureInfo.InvariantCulture) @(!string.IsNullOrWhiteSpace(step.TierLabel) ? step.TierLabel : "")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(step.ApproverName) ? step.ApproverName : step.ApproverId.ToString(CultureInfo.InvariantCulture))</td>
                                            <td>@(!string.IsNullOrWhiteSpace(step.Decision) ? step.Decision : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(step.DecidedAt) ? step.DecidedAt : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(step.CommentExcerpt) ? step.CommentExcerpt : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Same-site siblings</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>PO</th>
                                    <th>Vendor</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="6">No same-site siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.PoNumber) ? sib.PoNumber : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.VendorName) ? sib.VendorName : "—")</td>
                                            <td>@sib.Total.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Status) ? sib.Status : "—")</td>
                                            <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "po_req_id", sib.Id)">Open</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Site</th>
                    <th>PO</th>
                    <th>Requester</th>
                    <th>Vendor</th>
                    <th>Currency</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Tier</th>
                    <th>Priority</th>
                    <th>Created</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!_isAdmin)
            {
                <tr><td colspan="12">Sign in for live data.</td></tr>
            }
            else if (_rows.Count == 0)
            {
                <tr><td colspan="12">@(!string.IsNullOrWhiteSpace(_message) ? _message : "No records yet.")</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.SiteKey) ? row.SiteKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PoNumber) ? row.PoNumber : "—")</td>
                            <td>@row.RequesterId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.VendorName) ? row.VendorName : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Currency) ? row.Currency : "—")</td>
                            <td>@row.Total.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@row.CurrentTier.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Priority) ? row.Priority : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CreatedAt) ? row.CreatedAt : "—")</td>
                            <td>
                                <a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "po_req_id", row.Id)">Open</a>
                                @if (string.Equals(row.Status, "pending", StringComparison.OrdinalIgnoreCase))
                                {
                                    <form method="post" action="/cp/po-approvals/approve" style="display:inline;margin:0 0 0 .3rem">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="@_listHref" />
                                        <input type="hidden" name="poId" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                        <input type="hidden" name="tier" value="@row.CurrentTier.ToString(CultureInfo.InvariantCulture)" />
                                        <button type="submit" class="btn btn-xs btn-primary">Approve</button>
                                    </form>
                                    <form method="post" action="/cp/po-approvals/reject" style="display:inline;margin:0 0 0 .3rem">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="@_listHref" />
                                        <input type="hidden" name="poId" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                        <input type="hidden" name="tier" value="@row.CurrentTier.ToString(CultureInfo.InvariantCulture)" />
                                        <input type="hidden" name="reason" value="Rejected from CP" />
                                        <button type="submit" class="btn btn-xs btn-default">Reject</button>
                                    </form>
                                }
                            </td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/epc_po_approval";
    private bool _isAdmin;
    private CpPoApprovalsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPoApprovalsRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flash = "";
    private bool _flashOk;
    private string _listHref = "/cp/po-approvals-app";
    private long _openedId;
    private CpPoApprovalsDetail? _openedRequest;
    private IReadOnlyList<CpPoApprovalStepDigest> _openedSteps = [];
    private IReadOnlyList<CpPoApprovalsRowDigest> _openedSiblings = [];

    private string OpenedCaption => _openedRequest is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedRequest.PoNumber)
            ? ("PO request #" + _openedRequest.Id.ToString(CultureInfo.InvariantCulture))
            : _openedRequest.PoNumber);

    private string _openedReturnUrl => _openedId > 0
        ? (_listHref + "?po_req_id=" + _openedId.ToString(CultureInfo.InvariantCulture))
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "po_req_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var ok = ctx.Request.Query["ok"].ToString();
        var err = ctx.Request.Query["err"].ToString();
        if (!string.IsNullOrWhiteSpace(ok)) { _flash = ok; _flashOk = true; }
        else if (!string.IsNullOrWhiteSpace(err)) { _flash = err; _flashOk = false; }

        var result = await Dashboards.BuildCpPoApprovalsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Requests;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpPoApprovalsDetailAsync(_openedId, ctx.RequestAborted);
            _openedRequest = detail.Request;
            _openedSteps = detail.Steps;
            _openedSiblings = detail.Siblings;
            if (_openedRequest is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
