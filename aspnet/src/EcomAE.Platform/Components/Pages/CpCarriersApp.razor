@page "/cp/carriers-app"
@page "/cp/shop/finance/epc_custom_shipping"
@page "/cp/shop/logistics/custom_shipping"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ICpCustomShippingWriteService CustomShipping
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Carriers · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-car-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-car-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-car-hero p { margin:0; color:rgba(255,255,255,.85); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-car-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-car-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0c4a6e; background:#e0f2fe;
        }
        .epc-car-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-car-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-car-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-car-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-car-kpi span { color:#64748b; font-size:.78rem; }
        .epc-car-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-car-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-car-table th, .epc-car-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-car-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        @@media (max-width:900px){ .epc-car-kpis{grid-template-columns:1fr 1fr;} }
    
</style>
</HeadContent>


<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-car-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Carriers</h1>
        <p>Connect courier partners. Toggle active writes here. Seed partners and create-shipment stay on the Classic twin. Custom shipping save and submit write here.</p>
        <div class="epc-car-cta">
            <a href="@_configureHref">Manage carriers</a>
            <a class="ghost" href="@_deliveryHref">Delivery methods</a>
            <a class="ghost" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpCarriers)">Classic carriers</a>
            <a class="ghost" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpCustomShipping)">Classic shipping</a>
            <a class="ghost" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpErpShipping)">Classic ERP shipping</a>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/logistics/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/carriers-app" />
            <input type="hidden" name="action" value="toggle_carrier" />
            <label>Carrier code <input type="text" name="code" required maxlength="64" /></label>
            <button type="submit">Toggle carrier</button>
        </form>
        <form method="post" action="/cp/custom-shipping/write" data-epc-cs-save="1" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/carriers-app" />
            <input type="hidden" name="action" value="save" />
            <label>Id <input type="number" name="id" min="0" value="0" /></label>
            <label>Category
                <select name="category">
                    <option value="import" selected>import</option>
                    <option value="export">export</option>
                    <option value="transit">transit</option>
                    <option value="temp_admission">temp_admission</option>
                    <option value="transfer">transfer</option>
                </select>
            </label>
            <label>Type <input type="text" name="declarationType" value="Import to Local from ROW" required maxlength="191" /></label>
            <label>Status
                <select name="status">
                    <option value="draft" selected>draft</option>
                    <option value="submitted">submitted</option>
                    <option value="cleared">cleared</option>
                </select>
            </label>
            <label>Company <input type="text" name="company" required maxlength="255" /></label>
            <label>Emirate <input type="text" name="customsEmirate" value="DUBAI" maxlength="64" /></label>
            <label>Entry date <input type="date" name="entryDate" required /></label>
            <label>Declaration date <input type="date" name="declarationDate" required /></label>
            <label>Declaration no. <input type="text" name="declarationNumber" maxlength="64" /></label>
            <label>BL no. <input type="text" name="blNumber" maxlength="64" /></label>
            <label>BL date <input type="date" name="blDate" /></label>
            <label>SRV no. <input type="text" name="srvNumber" maxlength="64" /></label>
            <label>LC/DC no. <input type="text" name="lcDcNumber" maxlength="128" /></label>
            <label>LD/PO no. <input type="text" name="ldPoNumber" maxlength="128" /></label>
            <label>Supplier <input type="text" name="supplierDetail" maxlength="255" /></label>
            <label>Currency <input type="text" name="currency" value="AED" maxlength="16" /></label>
            <label>Invoice AED <input type="text" name="invoiceAmountAed" value="0" inputmode="decimal" /></label>
            <label>Total cost AED <input type="text" name="totalCostAed" value="0" inputmode="decimal" /></label>
            <label>Remarks <input type="text" name="remarks" maxlength="512" /></label>
            <label>Items JSON <input type="text" name="itemsJson" value="@_defaultItemsJson" required style="min-width:18rem" /></label>
            <button type="submit">Save declaration</button>
        </form>
        <form method="post" action="/cp/custom-shipping/write" data-epc-cs-submit="1" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/carriers-app" />
            <input type="hidden" name="action" value="submit" />
            <label>Declaration id <input type="number" name="declarationId" min="1" required /></label>
            <button type="submit">Submit declaration</button>
        </form>
    }

    <div class="epc-car-kpis" aria-label="Carriers stats">
        <div class="epc-car-kpi"><strong>@_summary.CarrierCount.ToString(CultureInfo.InvariantCulture)</strong><span>Carriers</span></div>
        <div class="epc-car-kpi"><strong>@_summary.ActiveCarriers.ToString(CultureInfo.InvariantCulture)</strong><span>Active</span></div>
        <div class="epc-car-kpi"><strong>@_summary.ShipmentCount.ToString(CultureInfo.InvariantCulture)</strong><span>Shipments</span></div>
        <div class="epc-car-kpi"><strong>@_summary.OpenShipments.ToString(CultureInfo.InvariantCulture)</strong><span>Open</span></div>
    </div>

    <div class="epc-car-table-wrap">
        <table class="epc-car-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Region</th>
                    <th>Blurb</th>
                    <th>Active</th>
                    <th>Demo</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_carriers.Count == 0)
                {
                    <tr><td colspan="9">No courier accounts yet. Seed partners from Manage carriers.</td></tr>
                }
                else
                {
                    @foreach (var row in _carriers)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Code) ? row.Code : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Region) ? row.Region : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Blurb) ? row.Blurb : "—")</td>
                            <td>@(row.Active ? "yes" : "no")</td>
                            <td>@(row.DemoMode ? "yes" : "no")</td>
                            <td>@row.TimeCreated.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@_configureHref">Configure</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 style="margin:1.25rem 0 .5rem;font-size:1.05rem">Custom shipping declarations</h2>
    <div class="epc-car-table-wrap" data-epc-cs-list="1">
        <table class="epc-car-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Company</th>
                    <th>Entry date</th>
                    <th>Items</th>
                    <th>Status</th>
                    <th>Declaration no.</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_declarations.Count == 0)
                {
                    <tr><td colspan="9">No declarations yet. Save the first record from the form.</td></tr>
                }
                else
                {
                    @foreach (var row in _declarations)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@Blank(row.Category)</td>
                            <td>@Blank(row.DeclarationType)</td>
                            <td>@Blank(row.Company)</td>
                            <td>@Blank(row.EntryDate)</td>
                            <td>@row.ItemCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@Blank(row.Status)</td>
                            <td>@Blank(row.DeclarationNumber)</td>
                            <td>
                                @if (_isAdmin && !string.Equals(row.Status, "submitted", StringComparison.OrdinalIgnoreCase))
                                {
                                    <form method="post" action="/cp/custom-shipping/write" style="display:inline">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="/cp/carriers-app" />
                                        <input type="hidden" name="action" value="submit" />
                                        <input type="hidden" name="declarationId" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                        <button type="submit">Submit</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _configureHref = "/cp/carriers-app";
    private const string _deliveryHref = "/cp/delivery-methods-app";
    private const string _phpCarriers = "/CP/shop/logistics/carriers";
    private const string _phpCustomShipping = "/CP/shop/finance/epc_custom_shipping";
    private const string _phpErpShipping = "/ERP/?epc_erp_shell=1&area=logistics&tab=custom_shipping";
    private const string _defaultItemsJson = """[{"hs_code":"8708.99","country_of_origin":"AE","description":"Oil filter","quantity":1,"unit":"PCS"}]""";
    private bool _isAdmin;
    private CpCarriersSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpCarrierDigest> _carriers = [];
    private IReadOnlyList<CpCustomShippingDeclarationRow> _declarations = [];
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpCarriersDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _carriers = result.Carriers;
        _declarations = await CustomShipping.ListRecentAsync(200, ctx.RequestAborted);
    }

    private static string Blank(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
