@page "/cp/carriers-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Carriers · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-car-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-car-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-car-hero p { margin:0; color:rgba(255,255,255,.85); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-car-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-car-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#1e3a5f; background:#93c5fd;
        }
        .epc-car-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-car-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-car-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-car-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-car-kpi span { color:#64748b; font-size:.78rem; }
        .epc-car-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-car-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-car-table th, .epc-car-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-car-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-car-note { margin-top:1rem; padding:.75rem .9rem; background:#eff6ff; border:1px solid #93c5fd; border-radius:.45rem; color:#1e3a5f; font-size:.86rem; }
        @@media (max-width:900px){ .epc-car-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-car-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Carriers</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-car-cta">
            <a href="@_phpTab">Open module</a>
        </div>
    </section>

    <div class="epc-car-kpis" aria-label="Carriers stats">
        <div class="epc-car-kpi"><strong>@_summary.CarrierCount.ToString(CultureInfo.InvariantCulture)</strong><span>Carriers</span></div>
        <div class="epc-car-kpi"><strong>@_summary.ActiveCarriers.ToString(CultureInfo.InvariantCulture)</strong><span>Active</span></div>
        <div class="epc-car-kpi"><strong>@_summary.RateCount.ToString(CultureInfo.InvariantCulture)</strong><span>Rates</span></div>
        <div class="epc-car-kpi"><strong>@_summary.OpenShipments.ToString(CultureInfo.InvariantCulture)</strong><span>Open shipments</span></div>
    </div>

    <div class="epc-car-table-wrap">
        <table class="epc-car-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Mode</th>
                    <th>Currency</th>
                    <th>Rating</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_carriers.Count == 0)
                {
                    <tr><td colspan="8">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _carriers)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Code) ? row.Code : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Mode) ? row.Mode : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Currency) ? row.Currency : "—")</td>
                            <td>@row.Rating.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(row.Active ? "yes" : "no")</td>
                            <td><a href="@_phpTab">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/logistics/carriers";
    private bool _isAdmin;
    private CpCarriersSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpCarrierDigest> _carriers = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpCarriersDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _carriers = result.Carriers;
        _source = result.Source;
        _message = result.Message;
    }
}
