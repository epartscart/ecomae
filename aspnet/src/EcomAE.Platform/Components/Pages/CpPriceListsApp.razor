@page "/cp/price-lists-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Price Lists · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Price lists
                <a class="btn btn-xs btn-default pull-right" href="/cp/auto-price-app">Auto-price</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" style="margin-right:.4rem">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Save or delete a supplier margin rule (overall, brand, or article). Price CSV import stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/price-lists-app" IsAdmin="_isAdmin" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/prices/storage-rules" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@WriteReturnHref" />
            <label>Rule id <input type="number" name="ruleId" min="1" required style="width:6rem" /></label>
            <label>Kind
                <select name="action">
                    <option value="delete_storage_rule">Overall</option>
                    <option value="delete_storage_brand_rule">Brand</option>
                    <option value="delete_storage_article_rule">Article</option>
                </select>
            </label>
            <button type="submit">Delete rule</button>
        </form>
        <form method="post" action="/cp/prices/storage-rules" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@WriteReturnHref" />
            <input type="hidden" name="action" value="save_storage_rule" />
            <label>Storage id <input type="number" name="storageId" min="1" required style="width:6rem" /></label>
            <label>Margin % <input type="text" name="marginPercent" value="0" required style="width:6rem" /></label>
            <label><input type="checkbox" name="visible" value="1" /> Visible</label>
            <button type="submit">Save overall rule</button>
        </form>
        <form method="post" action="/cp/prices/storage-rules" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@WriteReturnHref" />
            <input type="hidden" name="action" value="save_storage_brand_rule" />
            <label>Storage id <input type="number" name="storageId" min="1" required style="width:6rem" /></label>
            <label>Brand <input type="text" name="manufacturer" required /></label>
            <label>Margin % <input type="text" name="marginPercent" value="0" required style="width:6rem" /></label>
            <label><input type="checkbox" name="visible" value="1" /> Visible</label>
            <button type="submit">Save brand rule</button>
        </form>
        <form method="post" action="/cp/prices/storage-rules" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@WriteReturnHref" />
            <input type="hidden" name="action" value="save_storage_article_rule" />
            <label>Storage id <input type="number" name="storageId" min="1" required style="width:6rem" /></label>
            <label>Brand <input type="text" name="manufacturer" required /></label>
            <label>Article <input type="text" name="article" required /></label>
            <label>Margin % <input type="text" name="marginPercent" value="0" required style="width:6rem" /></label>
            <label><input type="checkbox" name="visible" value="1" /> Visible</label>
            <button type="submit">Save article rule</button>
        </form>
    }

    @if (_opened is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @OpenedCaption
                    <a class="btn btn-xs btn-default pull-right" href="@OpenedReturnHref">This row</a>
                    <a class="btn btn-xs btn-default pull-right" href="@_listHref" style="margin-right:.35rem">Close</a>
                </div>
                <div class="panel-body">
                    <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                        <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Code</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Code) ? "—" : _opened.Code)</dd>
                        <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Name) ? "—" : _opened.Name)</dd>
                        <dt>Currency</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Currency) ? "—" : _opened.Currency)</dd>
                        <dt>Customer</dt><dd>@_opened.CustomerId.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Priority</dt><dd>@_opened.Priority.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Active</dt><dd>@(_opened.Active ? "yes" : "no")</dd>
                    </dl>
                    <p class="text-muted" style="margin:.85rem 0 0">Price CSV import stays on the Classic twin. stored_relpath omitted.</p>
                    @if (!string.IsNullOrWhiteSpace(_opened.StatsExcerpt))
                    {
                        <p class="text-muted" style="margin:.85rem 0 .35rem">stats excerpt</p>
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.StatsExcerpt</pre>
                        @if (_opened.StatsLen > _opened.StatsExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_opened.StatsExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.StatsLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted" style="margin:.85rem 0 0">No stats excerpt yet.</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_opened.ErrorExcerpt))
                    {
                        <p class="text-muted" style="margin:.85rem 0 .35rem">error excerpt</p>
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.ErrorExcerpt</pre>
                        @if (_opened.ErrorLen > _opened.ErrorExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_opened.ErrorExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.ErrorLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted" style="margin:.85rem 0 0">No error excerpt yet.</p>
                    }
                    @if (_openedSiblings.Count > 0)
                    {
                        <p class="text-muted" style="margin:1rem 0 .4rem">Same-active siblings</p>
                        <div class="table-responsive">
                            <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Code</th>
                                        <th>Name</th>
                                        <th>Active</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Code) ? sib.Code : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Name) ? sib.Name : "—")</td>
                                            <td>@(sib.Active ? "yes" : "no")</td>
                                            <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "plist_id", sib.Id)">Open</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No same-active siblings yet.</p>
                    }
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Lists</div>
            <div class="panel-body">
                <p class="help-block">@_summary.ActiveLists.ToString(CultureInfo.InvariantCulture) active lists · @_summary.PriceRows.ToString(CultureInfo.InvariantCulture) price rows · @_summary.UploadCount.ToString(CultureInfo.InvariantCulture) upload history.</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Code</th>
                                <th>Name</th>
                                <th>Currency</th>
                                <th>Customer</th>
                                <th>Priority</th>
                                <th>Active</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_lists.Count == 0)
                        {
                            <tr><td colspan="8">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var l in _lists)
                            {
                                <tr id="erp-row-@l.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(l.Id, _openedId)">
                                    <td>@l.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(string.IsNullOrWhiteSpace(l.Code) ? "—" : l.Code)</td>
                                    <td>@(string.IsNullOrWhiteSpace(l.Name) ? "—" : l.Name)</td>
                                    <td>@(string.IsNullOrWhiteSpace(l.Currency) ? "—" : l.Currency)</td>
                                    <td>@l.CustomerId.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@l.Priority.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(l.Active ? "yes" : "no")</td>
                                    <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "plist_id", l.Id)">Open</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/pricing";
    private const string _listHref = "/cp/price-lists-app";
    private bool _isAdmin;
    private CpPriceListsSummary _summary = new(0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPriceListDigest> _lists = [];
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private CpPriceListDetail? _opened;
    private IReadOnlyList<CpPriceListDigest> _openedSiblings = [];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.Name)
            ? _opened.Name
            : (!string.IsNullOrWhiteSpace(_opened.Code)
                ? _opened.Code
                : ("List #" + _opened.Id.ToString(CultureInfo.InvariantCulture))));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?plist_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string WriteReturnHref => OpenedReturnHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "plist_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpPriceListsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _lists = result.Lists;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpPriceListDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.List;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _lists.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _lists = new[] { openedList }.Concat(_lists.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }
}
