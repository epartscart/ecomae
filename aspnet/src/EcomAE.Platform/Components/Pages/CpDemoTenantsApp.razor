@page "/cp/demo-tenants-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Demo Tenants · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
@if (_allowed)
{
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Demo Tenants
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/demo-tenants-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/demo-tenants-app" IsAdmin="_isAdmin" />


    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>Site</th>
                    <th>Hostname</th>
                    <th>Trade name</th>
                    <th>Hub</th>
                    <th>Hosted on</th>
                    <th>Industry</th>
                    <th>Status</th>
                    <th>ERP only</th>
                    <th>Active</th>
                    <th>Expires</th>
                    <th>Contact</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_tenants.Count == 0)
                {
                    <tr><td colspan="12">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var t in _tenants)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(t.SiteKey) ? "—" : t.SiteKey)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(t.Hostname) ? "—" : t.Hostname)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.TradeName) ? "—" : t.TradeName)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.HubName) ? "—" : t.HubName)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.HostedOn) ? "—" : t.HostedOn)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.IndustryCode) ? "—" : t.IndustryCode)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.Status) ? "—" : t.Status)</td>
                            <td>@(t.ErpOnly ? "yes" : "no")</td>
                            <td>@(t.IsActive ? "yes" : "no")</td>
                            <td>@(t.DemoExpiresAt > 0 ? t.DemoExpiresAt.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(t.DemoContactEmail) ? "—" : t.DemoContactEmail)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>Demo tenants are available on the platform Super CP host only.</p>
        <p><a href="/cp">Open Control Panel</a></p>
    </div>
}

@code {
    private const string _phpTab = "/CP/control/portal/epc_demo_tenants_manage";
    private bool _allowed;
    private bool _isAdmin;
    private IReadOnlyList<CpDemoTenantDigest> _tenants = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListCpDemoTenantsAsync(200, ctx.RequestAborted);
        _tenants = result.Tenants;
        _source = result.Source;
        _message = result.Message;
    }
}
