@page "/cp/platform-communication-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Platform communication · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Platform communication
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/platform-communication-app")</p>
                <p>Open a task for a short description excerpt and other tasks in the same category. Task writes stay on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/platform-communication-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedTask is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Platform communication KPIs">
        <div class="kpi"><div class="lbl">Tasks</div><div class="val">@_summary.TaskCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open</div><div class="val">@_summary.OpenTaskCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">High priority</div><div class="val">@_summary.HighPriorityCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Opened siblings</div><div class="val">@_openedSiblings.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedTask is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedTask.Title) ? _openedTask.Title : ("Task #" + _openedTask.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedTask.Status) ? _openedTask.Status : "—")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedTask.SiteKey) ? _openedTask.SiteKey : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedTask.Category) ? _openedTask.Category : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedTask.Priority) ? _openedTask.Priority : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedTask.AssignedEmail) ? _openedTask.AssignedEmail : ("user " + _openedTask.AssignedTo.ToString(CultureInfo.InvariantCulture)))</p>
                    <p>Due @_openedTask.DueAt.ToString(CultureInfo.InvariantCulture)
                        · created @_openedTask.CreatedAt.ToString(CultureInfo.InvariantCulture)
                        · by @_openedTask.CreatedBy.ToString(CultureInfo.InvariantCulture)</p>
                    @if (!string.IsNullOrWhiteSpace(_openedTask.DescriptionExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedTask.DescriptionExcerpt</pre>
                        @if (_openedTask.DescriptionLen > _openedTask.DescriptionExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_openedTask.DescriptionExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedTask.DescriptionLen.ToString(CultureInfo.InvariantCulture) chars). Full description stays on the Classic twin.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No description excerpt yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Category siblings</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Priority</th>
                                    <th>Due</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="5">No category siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Title) ? sib.Title : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Status) ? sib.Status : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Priority) ? sib.Priority : "—")</td>
                                            <td>@sib.DueAt.ToString(CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Title</th>
                    <th>Site</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Due</th>
                    <th>Created</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.SiteKey) ? row.SiteKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Category) ? row.Category : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Priority) ? row.Priority : "—")</td>
                            <td>@row.DueAt.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CreatedAt.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "task_id", row.Id)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_super_cp_communication";
    private const string _listHref = "/cp/platform-communication-app";
    private bool _isAdmin;
    private CpPlatformCommunicationSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPlatformCommunicationRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private CpPlatformCommunicationTaskDetail? _openedTask;
    private IReadOnlyList<CpPlatformCommunicationRowDigest> _openedSiblings = [];

    private string OpenedCaption => _openedTask is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedTask.Title)
            ? ("Task #" + _openedTask.Id.ToString(CultureInfo.InvariantCulture))
            : _openedTask.Title)
            + (string.IsNullOrWhiteSpace(_openedTask.Status) ? "" : (" · " + _openedTask.Status));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "task_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpPlatformCommunicationDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Tasks;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpPlatformCommunicationTaskDetailAsync(_openedId, ctx.RequestAborted);
            _openedTask = detail.Task;
            _openedSiblings = detail.Siblings;
            if (_openedTask is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
