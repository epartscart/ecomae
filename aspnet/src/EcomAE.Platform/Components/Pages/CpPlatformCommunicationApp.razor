@page "/cp/platform-communication-app"
@page "/erp/platform-communication-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ICpPlatformCommunicationWriteService Writes
@inject ICpPriceConfigsWriteService Tenants
@inject ICpCommunicationsDeskService Smtp
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Platform communication · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<style>
    .comm-guide{margin:0 0 14px;padding:12px 14px;border:1px solid #dbe4ea;background:#fff}
    .comm-guide h3{margin:0 0 4px;font-size:15px;color:#0f172a}
    .comm-guide__lead{margin:0 0 10px;color:#475569}
    .comm-steps{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0;padding:0}
    .comm-steps li{flex:1 1 180px;border:1px solid #dbe4ea;border-top:3px solid #0f4c81;background:#f8fafc;padding:8px 10px}
    .comm-steps__n{display:inline-block;width:18px;height:18px;border-radius:50%;background:#0f4c81;color:#fff;font-size:11px;font-weight:700;line-height:18px;text-align:center;margin-right:4px}
    .comm-steps strong{color:#0f172a}
    .comm-steps p{margin:4px 0 0;font-size:12px;color:#475569}
    .comm-counts{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 14px}
    .comm-count{flex:1 1 150px;background:#fff;border:1px solid #dbe4ea;padding:10px 12px}
    .comm-count span{display:block;font-size:12px;font-weight:700;color:#475569}
    .comm-count strong{display:block;margin-top:2px;font-size:16px;color:#0f172a}
    .comm-form[data-epc-inline="1"]{display:block !important;width:auto !important;max-width:none !important;margin:0 0 14px !important;padding:0 !important;border:0 !important;background:transparent !important;box-shadow:none !important}
    .comm-card{background:#fff;border:1px solid #dbe4ea;padding:12px}
    .comm-card h3{margin:0 0 4px;font-size:14px;color:#0f172a}
    .comm-card>p{margin:0 0 8px;color:#475569;font-size:12px}
    .comm-fields{display:flex !important;flex-wrap:wrap;gap:8px;align-items:flex-end}
    .comm-fields label,.comm-card .form-group{flex:0 0 auto;margin:0}
    .comm-wide{flex:0 0 auto;width:22rem;max-width:100%}
    .comm-checks{display:flex;flex-direction:column;gap:4px;margin:8px 0}
    .comm-filter[data-epc-inline="1"],.comm-delete[data-epc-inline="1"]{display:inline-flex !important;flex-wrap:wrap;gap:8px;align-items:center;width:auto !important;max-width:none !important;margin:0 !important;padding:0 !important;border:0 !important;background:transparent !important;box-shadow:none !important}
    .comm-pair{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin:0 0 14px}
</style>

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12 epc-scp-panel epc-scp-communication">
        <div class="epc-scp-panel__hero">
            <div>
                <span class="epc-scp-dashboard__badge">Super CP</span>
                <h2 class="epc-scp-dashboard__title">Communication setup</h2>
                <p class="epc-scp-dashboard__sub">Which platform events send a notice, and the internal tasks for operators.</p>
            </div>
            <div class="epc-scp-dashboard__hero-actions">
                <a class="btn btn-sm btn-default" href="@ModernAuthHref"><i class="fa fa-sign-in"></i> Modern auth</a>
                <a class="btn btn-sm btn-primary" href="@OperatorGuideHref"><i class="fa fa-book"></i> Operator guide</a>
            </div>
        </div>

        <section class="comm-guide" aria-label="How platform communication works">
            <h3>What this page is for</h3>
            <p class="comm-guide__lead">This is the platform operator’s desk. It is not the mailbox customers receive — that mailbox is Tenant email. Here you choose which platform events send a notice, and you keep the internal task list for operators. Saving records the choice. It does not send a message from this page. The mail server itself is on Modern auth.</p>
            <h3>How to use it</h3>
            <ol class="comm-steps">
                <li><span class="comm-steps__n">1</span><strong>Check the server</strong><p>Read the mail server line. If it is empty, open Modern auth and set the platform mailbox first.</p></li>
                <li><span class="comm-steps__n">2</span><strong>Choose the events</strong><p>Tick the notices you want: a company onboarded, a site goes live, a demo about to end, a task assigned, and the morning digest.</p></li>
                <li><span class="comm-steps__n">3</span><strong>Add a task</strong><p>Title, what to do, who owns it, which company it is about, and the due date. Save task.</p></li>
                <li><span class="comm-steps__n">4</span><strong>Close it</strong><p>Filter the list, open a row to update it, or delete it when it is finished.</p></li>
            </ol>
        </section>

        @if (!string.IsNullOrWhiteSpace(_flashOk))
        {
            <div class="alert alert-success">@_flashOk</div>
        }
        @if (!string.IsNullOrWhiteSpace(_flashErr))
        {
            <div class="alert alert-danger">@_flashErr</div>
        }

        @if (!_isSuper)
        {
            <div class="alert alert-warning">Communication setup is managed from the Super CP host only. Tenant CPs are independent.</div>
        }
        else if (!_isAdmin)
        {
            <div class="alert alert-warning">Sign in with a Super CP admin session to manage communication. <a href="/cp/login?returnUrl=/cp/platform-communication-app">Sign in</a></div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger">@_error</div>
            }

            <div class="comm-counts" aria-label="Communication summary">
                <div class="comm-count"><span>Notices on</span><strong>@EventsOn.ToString(CultureInfo.InvariantCulture) of 5</strong></div>
                <div class="comm-count"><span>Digest hour</span><strong>@Setting("digest_hour_utc") UTC</strong></div>
                <div class="comm-count"><span>Tasks in this list</span><strong>@_tasks.Count.ToString(CultureInfo.InvariantCulture)</strong></div>
                <div class="comm-count"><span>Mail server</span><strong>@(string.IsNullOrWhiteSpace(_smtp.Host) ? "Not set" : _smtp.Host + ":" + _smtp.Port)</strong></div>
            </div>

            <div class="comm-pair">
                <form method="post" action="/cp/platform-communication/write" class="comm-form" data-epc-inline="1">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@FilterHref" />
                    <input type="hidden" name="action" value="save_comm_settings" />
                    <section class="comm-card">
                        <h3>Which notices send</h3>
                        <p>Controls which platform events trigger outbound email. SMTP transport is configured in Modern auth.</p>
                        <table class="table table-condensed table-bordered epc-scp-status-table" style="margin-bottom:14px">
                            <tr><th>SMTP source</th><td>@_smtp.Source</td></tr>
                            <tr><th>Host</th><td><code>@(_smtp.Host + ":" + _smtp.Port)</code> (@_smtp.Encryption)</td></tr>
                            <tr><th>From</th><td>@_smtp.FromName &lt;@_smtp.FromEmail&gt;</td></tr>
                        </table>
                        <div class="comm-fields">
                            <div class="form-group"><label>From name</label><input class="form-control input-sm" name="notify_from_name" value="@Setting("notify_from_name")" /></div>
                            <div class="form-group"><label>From email</label><input class="form-control input-sm" type="email" name="notify_from_email" value="@Setting("notify_from_email")" /></div>
                            <div class="form-group"><label>Reply-to</label><input class="form-control input-sm" type="email" name="notify_reply_to" value="@Setting("notify_reply_to")" /></div>
                            <div class="form-group"><label>Digest hour (UTC)</label><input class="form-control input-sm" type="number" min="0" max="23" name="digest_hour_utc" value="@Setting("digest_hour_utc")" /></div>
                        </div>
                        <div class="comm-checks">
                            <div class="checkbox"><label><input type="checkbox" name="notify_tenant_onboard" value="1" checked="@FlagOn("notify_tenant_onboard")" /> Tenant onboard confirmation</label></div>
                            <div class="checkbox"><label><input type="checkbox" name="notify_tenant_dns_live" value="1" checked="@FlagOn("notify_tenant_dns_live")" /> Tenant goes live (DNS)</label></div>
                            <div class="checkbox"><label><input type="checkbox" name="notify_demo_expiry" value="1" checked="@FlagOn("notify_demo_expiry")" /> Demo expiry reminder</label></div>
                            <div class="checkbox"><label><input type="checkbox" name="notify_task_assigned" value="1" checked="@FlagOn("notify_task_assigned")" /> Task assigned to operator</label></div>
                            <div class="checkbox"><label><input type="checkbox" name="notify_daily_digest" value="1" checked="@FlagOn("notify_daily_digest")" /> Daily operator digest</label></div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-save"></i> Save notification policy</button>
                    </section>
                </form>

                <form method="post" action="/cp/platform-communication/write" class="comm-form" data-epc-inline="1">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="description_replace" value="1" />
                    <input type="hidden" name="returnUrl" value="@FilterHref" />
                    <input type="hidden" name="action" value="save_task" />
                    <input type="hidden" name="id" value="@((_edit?.Id ?? 0).ToString(CultureInfo.InvariantCulture))" />
                    <section class="comm-card">
                        <h3>@(_edit is not null ? "Edit task" : "New internal task")</h3>
                        <p>A job for an operator: onboarding follow-up, support, billing, pricing, or content. Assign a person and a company.</p>
                        <div class="form-group comm-wide"><label>Title</label><input class="form-control input-sm" name="title" required value="@(_edit?.Title ?? "")" /></div>
                        <div class="form-group comm-wide"><label>Description</label><textarea class="form-control input-sm" name="description" rows="3">@(_edit?.Description ?? "")</textarea></div>
                        <div class="comm-fields">
                            <div class="form-group"><label>Category</label>
                                <select class="form-control input-sm" name="category">
                                    @foreach (var c in CpPlatformCommunicationWriteService.Categories)
                                    {
                                        <option value="@c.Key" selected="@(EditCategory == c.Key)">@c.Value</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group"><label>Priority</label>
                                <select class="form-control input-sm" name="priority">
                                    @foreach (var p in CpPlatformCommunicationWriteService.Priorities)
                                    {
                                        <option value="@p.Key" selected="@(EditPriority == p.Key)">@p.Value</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group"><label>Status</label>
                                <select class="form-control input-sm" name="status">
                                    @foreach (var st in CpPlatformCommunicationWriteService.Statuses)
                                    {
                                        <option value="@st.Key" selected="@(EditStatus == st.Key)">@st.Value</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group"><label>Due date</label>
                                <input class="form-control input-sm" type="date" name="due_at" value="@CpPlatformCommunicationWriteService.DueDate(_edit?.DueAt ?? 0)" />
                            </div>
                        </div>
                        <div class="comm-fields">
                            <div class="form-group"><label>Assign to (platform user)</label>
                                <select class="form-control input-sm" name="assigned_to">
                                    <option value="0">— Unassigned —</option>
                                    @foreach (var u in _users)
                                    {
                                        <option value="@u.UserId.ToString(CultureInfo.InvariantCulture)" selected="@((_edit?.AssignedTo ?? 0) == u.UserId)">@u.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group"><label>Assign email (fallback)</label><input class="form-control input-sm" type="email" name="assigned_email" value="@(_edit?.AssignedEmail ?? "")" /></div>
                            <div class="form-group"><label>Related tenant</label>
                                <select class="form-control input-sm" name="site_key">
                                    <option value="">—</option>
                                    @foreach (var t in _tenants)
                                    {
                                        <option value="@t.SiteKey" selected="@((_edit?.SiteKey ?? "") == t.SiteKey)">@t.Label</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-save"></i> Save task</button>
                        @if (_edit is not null)
                        {
                            <a class="btn btn-default btn-sm" href="@FilterHref">Cancel</a>
                        }
                    </section>
                </form>
            </div>

            <div class="epc-scp-table-card" style="margin-top:16px">
                <div class="epc-scp-filter-bar" style="margin-bottom:12px;border:none;padding:0;background:transparent">
                    <form method="get" class="comm-filter" data-epc-inline="1" action="@ListPath">
                        @if (CompanyId is int companyId)
                        {
                            <input type="hidden" name="company" value="@companyId.ToString(CultureInfo.InvariantCulture)" />
                        }
                        <label>Tasks:</label>
                        <select name="task_status" class="form-control input-sm">
                            <option value="">All statuses</option>
                            @foreach (var st in CpPlatformCommunicationWriteService.Statuses)
                            {
                                <option value="@st.Key" selected="@(_taskFilter == st.Key)">@st.Value</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-default btn-sm">Filter</button>
                    </form>
                </div>
                <h4><i class="fa fa-tasks"></i> Internal tasks (@_tasks.Count.ToString(CultureInfo.InvariantCulture))</h4>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-condensed epc-scp-data-table">
                        <thead><tr><th>Task</th><th>Category</th><th>Assignee</th><th>Status</th><th>Due</th><th></th></tr></thead>
                        <tbody>
                        @if (_tasks.Count == 0)
                        {
                            <tr><td colspan="6" class="epc-scp-empty-cell">
                                <div class="epc-scp-empty-state">
                                    <div class="epc-scp-empty-state__icon"><i class="fa fa-inbox"></i></div>
                                    <h4>No internal tasks yet</h4>
                                    <p>Track onboarding follow-ups, DNS go-live checks, or support escalations — assign to a platform user or email.</p>
                                    <div class="epc-scp-empty-state__actions">
                                        <a class="btn btn-sm btn-primary" href="@OperatorGuideHref"><i class="fa fa-book"></i> Operator guide</a>
                                        <a class="btn btn-sm btn-default" href="@ModernAuthHref"><i class="fa fa-sign-in"></i> Modern auth</a>
                                    </div>
                                </div>
                            </td></tr>
                        }
                        @foreach (var t in _tasks)
                        {
                            <tr>
                                <td>
                                    <strong>@t.Title</strong>
                                    <span class="epc-scp-badge @PriorityBadge(t.Priority)">@Label(CpPlatformCommunicationWriteService.Priorities, t.Priority)</span>
                                    @if (!string.IsNullOrEmpty(t.Description))
                                    {
                                        <div class="text-muted small">@Excerpt(t.Description)</div>
                                    }
                                    @if (!string.IsNullOrEmpty(t.SiteKey))
                                    {
                                        <div><code>@t.SiteKey</code></div>
                                    }
                                </td>
                                <td>@Label(CpPlatformCommunicationWriteService.Categories, t.Category)</td>
                                <td>@(t.AssignedEmail.Length > 0 ? t.AssignedEmail : "User #" + t.AssignedTo.ToString(CultureInfo.InvariantCulture))</td>
                                <td><span class="label label-@StatusLabel(t.Status)">@Label(CpPlatformCommunicationWriteService.Statuses, t.Status)</span></td>
                                <td>@(t.DueAt > 0 ? CpPlatformCommunicationWriteService.DueDate(t.DueAt) : "—")</td>
                                <td class="epc-scp-actions-cell">
                                    <a class="btn btn-xs btn-default" href="@EditHref(t.Id)"><i class="fa fa-edit"></i></a>
                                    <form method="post" action="/cp/platform-communication/write" class="comm-delete" data-epc-inline="1" onsubmit="return confirm('Delete this task?');">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="@FilterHref" />
                                        <input type="hidden" name="action" value="delete_task" />
                                        <input type="hidden" name="id" value="@t.Id.ToString(CultureInfo.InvariantCulture)" />
                                        <button type="submit" class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_super_cp_communication";
    private const string _listHref = "/cp/platform-communication-app";
    private const string ModernAuthHref = "/cp/auth-mfa-app";
    private const string OperatorGuideHref = "/cp/super-cp-operator-guide-app";
    private bool _isAdmin;
    private bool _isSuper;
    private string _taskFilter = "";
    private string _error = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private IReadOnlyDictionary<string, string> _settings = CpPlatformCommunicationWriteService.DefaultSettings;
    private IReadOnlyList<CpPlatformTaskRow> _tasks = [];
    private IReadOnlyList<CpPlatformUserOption> _users = [];
    private IReadOnlyList<CpPriceConfigTenantOption> _tenants = [];
    private CpSmtpDiagnostics _smtp = new("n/a", "", "", "", "", "");
    private CpPlatformTaskRow? _edit;

    private string EditCategory => CpPlatformCommunicationWriteService.NormalizeCategory(_edit?.Category);
    private string EditPriority => CpPlatformCommunicationWriteService.NormalizePriority(_edit?.Priority);
    private string EditStatus => CpPlatformCommunicationWriteService.NormalizeStatus(_edit?.Status);

    private int? CompanyId => ErpHostContext.ActiveCompanyIdFromQuery(Http.HttpContext?.Request);

    private int EventsOn =>
        (FlagOn("notify_tenant_onboard") ? 1 : 0)
        + (FlagOn("notify_tenant_dns_live") ? 1 : 0)
        + (FlagOn("notify_demo_expiry") ? 1 : 0)
        + (FlagOn("notify_task_assigned") ? 1 : 0)
        + (FlagOn("notify_daily_digest") ? 1 : 0);

    private string ListPath
    {
        get
        {
            var path = Http.HttpContext?.Request.Path.Value;
            return string.IsNullOrWhiteSpace(path) || !path.StartsWith('/') ? _listHref : path;
        }
    }

    private string FilterHref
    {
        get
        {
            var parts = new List<string>();
            if (_taskFilter.Length > 0)
            {
                parts.Add("task_status=" + Uri.EscapeDataString(_taskFilter));
            }

            if (CompanyId is int company)
            {
                parts.Add("company=" + company.ToString(CultureInfo.InvariantCulture));
            }

            return parts.Count == 0 ? ListPath : ListPath + "?" + string.Join("&", parts);
        }
    }

    private string EditHref(long id)
    {
        var parts = new List<string>
        {
            "edit_task=" + id.ToString(CultureInfo.InvariantCulture),
        };
        if (_taskFilter.Length > 0)
        {
            parts.Add("task_status=" + Uri.EscapeDataString(_taskFilter));
        }

        if (CompanyId is int company)
        {
            parts.Add("company=" + company.ToString(CultureInfo.InvariantCulture));
        }

        return ListPath + "?" + string.Join("&", parts);
    }

    private string Setting(string key)
        => _settings.TryGetValue(key, out var value) ? value : "";

    private bool FlagOn(string key)
        => CpPlatformCommunicationWriteService.SettingFlag(_settings, key);

    private static string Label(IReadOnlyDictionary<string, string> map, string key)
        => map.TryGetValue(key, out var label) ? label : key;

    private static string PriorityBadge(string priority) => priority switch
    {
        "urgent" => "epc-scp-badge--urgent",
        "high" => "epc-scp-badge--high",
        _ => "epc-scp-badge--normal",
    };

    private static string StatusLabel(string status) => status switch
    {
        "done" => "success",
        "cancelled" => "default",
        _ => "info",
    };

    private static string Excerpt(string html)
    {
        var text = System.Text.RegularExpressions.Regex.Replace(html, "<[^>]*>", string.Empty);
        return text.Length > 120 ? text[..120] : text;
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _isSuper = SuperCpHostGate.IsAllowed(ctx);
        _flashOk = ctx.Request.Query["ok"].ToString();
        _flashErr = ctx.Request.Query["err"].ToString();
        _taskFilter = ctx.Request.Query["task_status"].ToString().Trim();

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!(_isAdmin && _isSuper))
        {
            return;
        }

        _settings = await Writes.LoadSettingsAsync(ctx.RequestAborted);
        var list = await Writes.ListTasksAsync(_taskFilter, ctx.RequestAborted);
        _tasks = list.Tasks;
        _error = list.Error;
        _users = await Writes.ListPlatformUsersAsync(ctx.RequestAborted);
        _tenants = await Tenants.ListTenantOptionsAsync(ctx.RequestAborted);
        _smtp = Smtp.Diagnose();

        var editId = long.TryParse(ctx.Request.Query["edit_task"].ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var e) ? e : 0;
        if (editId <= 0)
        {
            editId = ErpRecordOpen.ReadId(ctx.Request, "task_id");
        }

        if (editId > 0)
        {
            _edit = _tasks.FirstOrDefault(t => t.Id == editId);
        }
    }
}
