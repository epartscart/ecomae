@page "/cp/tenant-email-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Email / SMTP · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                <span class="label label-primary">Tenant CP</span> Email / SMTP settings
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
                <a class="btn btn-xs btn-default pull-right" href="/cp/integrations-app" style="margin-right:.4rem">Integrations</a>
            </div>
            <div class="panel-body">
                <p>This tenant’s outgoing mail for OTP codes, order notifications, and customer emails. The password is never returned to the browser.</p>
            </div>
        </div>
    </div>

    @if (_isSuperCpHost)
    {
        <div class="col-lg-12">
            <div class="alert alert-info" role="status">
                Platform SMTP is configured under
                <a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref("/CP/control/portal/epc_cp_auth_settings")">Modern auth settings</a>.
                This page is for tenant CP hosts.
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div>
    }

    @if (!_isAdmin)
    {
        <div class="alert alert-info" role="status">Sign in with a Control Panel admin session to load live tenant data.</div>
    }

    <div class="col-lg-12">
        <div class="well well-sm">
            <strong>Current transport:</strong> @(_summary.UseTenantSmtp ? "tenant SMTP" : "platform default")
            @if (!string.IsNullOrWhiteSpace(_summary.Host))
            {
                <text> — @_summary.Host@(!string.IsNullOrWhiteSpace(_summary.Port) ? ":" + _summary.Port : "")</text>
            }
        </div>
    </div>

    @if (_isAdmin)
    {
        <div class="col-lg-12">
            <form method="post" action="/cp/tenant-email/save" class="well">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/tenant-email-app" />
                <div class="checkbox">
                    <label>
                        @if (_summary.UseTenantSmtp)
                        {
                            <input type="checkbox" name="use_tenant_smtp" value="true" checked />
                        }
                        else
                        {
                            <input type="checkbox" name="use_tenant_smtp" value="true" />
                        }
                        Use tenant SMTP (override platform default)
                    </label>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>SMTP host</label>
                            <input type="text" class="form-control" name="smtp_host" value="@_summary.Host" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Port</label>
                            <input type="text" class="form-control" name="smtp_port" value="@(string.IsNullOrWhiteSpace(_summary.Port) ? "587" : _summary.Port)" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Encryption</label>
                            <select class="form-control" name="smtp_encryption">
                                @if (_enc == "ssl")
                                {
                                    <option value="tls">TLS</option>
                                    <option value="ssl" selected>SSL</option>
                                    <option value="">None</option>
                                }
                                else if (_enc != "tls")
                                {
                                    <option value="tls">TLS</option>
                                    <option value="ssl">SSL</option>
                                    <option value="" selected>None</option>
                                }
                                else
                                {
                                    <option value="tls" selected>TLS</option>
                                    <option value="ssl">SSL</option>
                                    <option value="">None</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Username</label>
                            <input type="text" class="form-control" name="smtp_username" value="@_summary.Username" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Password @if (_summary.HasPassword) { <span class="text-muted">(saved)</span> }</label>
                            <input type="password" class="form-control" name="smtp_password" placeholder="Leave blank to keep current" autocomplete="new-password" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>From name</label>
                            <input type="text" class="form-control" name="from_name" value="@_summary.FromName" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>From email</label>
                            <input type="email" class="form-control" name="from_email" value="@_summary.FromEmail" />
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save SMTP</button>
            </form>
        </div>

        <div class="col-lg-12">
            <form method="post" action="/cp/tenant-email/test" class="well" style="max-width:520px">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/tenant-email-app" />
                <h4 style="margin-top:0">Test send</h4>
                <div class="form-group">
                    <label>Send test to</label>
                    <input type="email" class="form-control" name="test_to" value="@_testTo" required />
                </div>
                <button type="submit" class="btn btn-primary"><i class="fa fa-paper-plane"></i> Send test email</button>
            </form>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Tenant mail settings</div>
            <div class="panel-body">
                <dl class="dl-horizontal" style="margin:0">
                    <dt>Use tenant SMTP</dt>
                    <dd>@(_summary.UseTenantSmtp ? "yes" : "no")</dd>
                    <dt>Host</dt>
                    <dd>@(string.IsNullOrWhiteSpace(_summary.Host) ? _host : _summary.Host)</dd>
                    <dt>Port / encryption</dt>
                    <dd>@(string.IsNullOrWhiteSpace(_summary.Port) ? "—" : _summary.Port) / @(string.IsNullOrWhiteSpace(_summary.Encryption) ? "—" : _summary.Encryption)</dd>
                    <dt>Username</dt>
                    <dd>@(string.IsNullOrWhiteSpace(_summary.Username) ? "—" : _summary.Username)</dd>
                    <dt>From name</dt>
                    <dd>@(string.IsNullOrWhiteSpace(_summary.FromName) ? "—" : _summary.FromName)</dd>
                    <dt>From email</dt>
                    <dd>@(string.IsNullOrWhiteSpace(_summary.FromEmail) ? "—" : _summary.FromEmail)</dd>
                    <dt>Password saved</dt>
                    <dd>@(_summary.HasPassword ? "yes" : "no")</dd>
                    <dt>This host</dt>
                    <dd>@_host</dd>
                </dl>
                <p class="help-block" style="margin-top:1rem">On Super CP hosts, platform SMTP lives under Modern auth settings — not this tenant page.</p>
            </div>
        </div>
    </div>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Activate in 3 steps</div>
            <div class="panel-body">
                <ol>
                    <li><strong>Enable</strong> &mdash; Platform operator enables Email/SMTP for your tenant.</li>
                    <li><strong>Configure</strong> &mdash; Enter SMTP host, port, and credentials above (Gmail App Password, SendGrid, etc.).</li>
                    <li><strong>Test</strong> &mdash; Send test email, then try storefront OTP or CP login.</li>
                </ol>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_tenant_email_settings";
    private bool _isAdmin;
    private bool _isSuperCpHost;
    private string _host = "—";
    private string _enc = "tls";
    private string _testTo = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private CpTenantEmailSummary _summary = new(false, string.Empty, string.Empty, string.Empty, string.Empty, string.Empty, string.Empty, false, "n/a", "");

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _host = string.IsNullOrWhiteSpace(ctx.Request.Host.Host) ? "—" : ctx.Request.Host.Host;
        _isSuperCpHost = SuperCpHostGate.IsAllowed(ctx);
        _flashOk = ctx.Request.Query["ok"].ToString();
        _flashErr = ctx.Request.Query["err"].ToString();
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!string.IsNullOrWhiteSpace(session.Email))
        {
            _testTo = session.Email;
        }

        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpTenantEmailDigestAsync(ctx.RequestAborted);
        _summary = result.Summary;
        _enc = string.IsNullOrWhiteSpace(_summary.Encryption) ? "tls" : _summary.Encryption.Trim().ToLowerInvariant();
    }
}
