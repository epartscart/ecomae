@page "/erp/aging-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Aging · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Aging" BreadcrumbArea="Finance" BreadcrumbTab="Aging">

    
    <PhpErpModulePageHeader Title="AR / AP / Inventory aging" Subtitle="Read digest with PHP-reference interactive module." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />


    <div class="epc-erp-kpi epc-erp-stat-row">
        <div class="kpi"><div class="lbl">AR outstanding</div><div class="val">@_summary.ArGrand.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">AP outstanding</div><div class="val">@_summary.ApGrand.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Inventory aged value</div><div class="val">@_summary.InventoryGrand.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @AgingTable("Receivables", _arLabels, _arRows)
    @AgingTable("Payables", _apLabels, _apRows)
    @AgingTable("Inventory", _invLabels, _invRows)

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">Source: @_summary.Source. Boundaries @_summary.Boundary1 / @_summary.Boundary2 / @_summary.Boundary3 days.</div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private ErpAgingSummary _summary = new(30, 60, 90, 0, 0, 0, "migration", string.Empty);
    private IReadOnlyList<string> _arLabels = [];
    private IReadOnlyList<string> _apLabels = [];
    private IReadOnlyList<string> _invLabels = [];
    private IReadOnlyList<ErpAgingPartyDigest> _arRows = [];
    private IReadOnlyList<ErpAgingPartyDigest> _apRows = [];
    private IReadOnlyList<ErpAgingPartyDigest> _invRows = [];
    private readonly string _phpTab = "/ERP/?epc_erp_shell=1&area=finance&tab=aging";

    private RenderFragment AgingTable(string title, IReadOnlyList<string> labels, IReadOnlyList<ErpAgingPartyDigest> rows) => __builder =>
    {
        <div class="epc-ag-section">
            <h2>@title</h2>
            <div class="epc-erp-table-wrap">
                <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            @foreach (var l in labels) { <th>@l</th> }
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (rows.Count == 0)
                        {
                            <tr><td colspan="@(labels.Count + 2)">Nothing to show yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var r in rows)
                            {
                                <tr>
                                    <td>@r.Name</td>
                                    <td>@r.Bucket0.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@r.Bucket1.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@r.Bucket2.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@r.Bucket3.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@r.Bucket4.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@r.Total.ToString("N2", CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }
        var result = await Dashboards.BuildErpAgingDigestAsync(100);
        _summary = result.Summary;
        _arLabels = result.ArLabels;
        _apLabels = result.ApLabels;
        _invLabels = result.InventoryLabels;
        _arRows = result.ArRows;
        _apRows = result.ApRows;
        _invRows = result.InventoryRows;
    }
}
