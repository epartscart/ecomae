@page "/erp/aging-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Aging · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Aging" BreadcrumbArea="Finance" BreadcrumbTab="Aging">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/aging-app" IsAdmin="_isAdmin" />


    
    <PhpErpModulePageHeader Title="@_pageTitle" Subtitle="AR, AP, and inventory aging buckets." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    <p style="margin:0 0 .75rem;display:flex;flex-wrap:wrap;gap:.4rem">
        <a class="btn btn-xs @(_view is "all" ? "btn-primary" : "btn-default")" href="/erp/aging-app">All</a>
        <a class="btn btn-xs @(_view is "ar" ? "btn-primary" : "btn-default")" href="/erp/aging-app?tab=ar">Receivables</a>
        <a class="btn btn-xs @(_view is "ap" ? "btn-primary" : "btn-default")" href="/erp/aging-app?tab=ap">Payables</a>
        <a class="btn btn-xs @(_view is "inv" ? "btn-primary" : "btn-default")" href="/erp/aging-app?tab=inv">Inventory</a>
    </p>


    <div class="epc-erp-kpi epc-erp-stat-row">
        <div class="kpi"><div class="lbl">AR outstanding</div><div class="val">@_summary.ArGrand.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">AP outstanding</div><div class="val">@_summary.ApGrand.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Inventory aged value</div><div class="val">@_summary.InventoryGrand.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_view is "all" or "ar")
    {
        @AgingTable("Receivables", _arLabels, _arRows)
    }
    @if (_view is "all" or "ap")
    {
        @AgingTable("Payables", _apLabels, _apRows)
    }
    @if (_view is "all" or "inv")
    {
        @AgingTable("Inventory", _invLabels, _invRows)
    }

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">Source: @_summary.Source. Boundaries @_summary.Boundary1 / @_summary.Boundary2 / @_summary.Boundary3 days.</div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private ErpAgingSummary _summary = new(30, 60, 90, 0, 0, 0, "migration", string.Empty);
    private IReadOnlyList<string> _arLabels = [];
    private IReadOnlyList<string> _apLabels = [];
    private IReadOnlyList<string> _invLabels = [];
    private IReadOnlyList<ErpAgingPartyDigest> _arRows = [];
    private IReadOnlyList<ErpAgingPartyDigest> _apRows = [];
    private IReadOnlyList<ErpAgingPartyDigest> _invRows = [];
    private string _view = "all";
    private string _pageTitle = "AR / AP / Inventory aging";
    private string _phpTab = "/ERP/?epc_erp_shell=1&area=finance&tab=aging";

    private RenderFragment AgingTable(string title, IReadOnlyList<string> labels, IReadOnlyList<ErpAgingPartyDigest> rows) => __builder =>
    {
        <div class="epc-ag-section">
            <h2>@title</h2>
            <div class="epc-erp-table-wrap">
                <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            @foreach (var l in labels) { <th>@l</th> }
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (rows.Count == 0)
                        {
                            <tr><td colspan="@(labels.Count + 2)">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var r in rows)
                            {
                                <tr>
                                    <td>@r.Name</td>
                                    <td>@r.Bucket0.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@r.Bucket1.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@r.Bucket2.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@r.Bucket3.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td style="@(r.Bucket4 > 0 ? "color:#b3261e;font-weight:600" : "")">@r.Bucket4.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td>@r.Total.ToString("N2", CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                            <tr style="font-weight:600;background:#f2f6fa">
                                <td>Total</td>
                                <td>@rows.Sum(r => r.Bucket0).ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@rows.Sum(r => r.Bucket1).ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@rows.Sum(r => r.Bucket2).ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@rows.Sum(r => r.Bucket3).ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@rows.Sum(r => r.Bucket4).ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td>@rows.Sum(r => r.Total).ToString("N2", CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var tab = (ctx.Request.Query["tab"].ToString() ?? string.Empty).Trim().ToLowerInvariant();
        _view = tab is "ar" or "ap" or "inv" ? tab : "all";
        _pageTitle = _view switch
        {
            "ar" => "Receivables aging",
            "ap" => "Payables aging",
            "inv" => "Inventory aging",
            _ => "AR / AP / Inventory aging",
        };
        var session = await Sessions.ValidateAsync(ctx);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }
        var result = await Dashboards.BuildErpAgingDigestAsync(100);
        _summary = result.Summary;
        _arLabels = result.ArLabels;
        _apLabels = result.ApLabels;
        _invLabels = result.InventoryLabels;
        _arRows = result.ArRows;
        _apRows = result.ApRows;
        _invRows = result.InventoryRows;
    }
}
