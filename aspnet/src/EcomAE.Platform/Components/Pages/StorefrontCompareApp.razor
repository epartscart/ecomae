@page "/storefront/compare-app"
@page "/en/shop/sravneniya"
@page "/shop/sravneniya"
@page "/en/shop/compare"
@page "/shop/compare"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using System.Text.Json
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject IHttpContextAccessor Http

<PageTitle>Compare · @_brand</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        
        .epc-sf-cmp-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-sf-cmp-cta a {
            display:inline-flex; padding:.5rem .85rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#fff; background:#dc2626;
        }
        .epc-sf-cmp-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); }
        .epc-sf-cmp-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-sf-cmp-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-sf-cmp-table th, .epc-sf-cmp-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; }
        .epc-sf-cmp-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; }
        .epc-sf-cmp-table a { color:#b91c1c; font-weight:700; text-decoration:none; }
        .epc-sf-cmp-empty { padding:1.25rem; background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; color:#475569; }
        .epc-sf-cmp-note { margin-top:1rem; padding:.75rem .9rem; background:#fff8e8; border:1px solid #f1d49a; border-radius:.45rem; color:#7a4e00; font-size:.86rem; }
    
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontTenantChrome>

    <PhpStorefrontPageHeader Title="Compare"
                            Subtitle="Products saved in the compare cookie.">
        <a class="btn btn-sm btn-primary" href="@StorefrontSurfaceLinks.Wishlist">Bookmarks</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.PartSearch">Search</a>
    </PhpStorefrontPageHeader>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
    }

    @if (_ids.Count == 0)
    {
        <div class="epc-sf-cmp-empty">No products in compare yet.</div>
    }
    else
    {
        <div class="epc-sf-cmp-table-wrap">
            <table class="epc-sf-cmp-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Brand</th>
                        <th>Article</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_products.Count == 0)
                    {
                        <tr><td colspan="4">Compare cookie has @_ids.Count id(s); catalogue rows unavailable (<code>@_source</code>). <a href="@StorefrontSurfaceLinks.OwnCatalog">Own catalog</a></td></tr>
                    }
                    else
                    {
                        @foreach (var p in _products)
                        {
                            <tr>
                                <td><strong>@(string.IsNullOrWhiteSpace(p.Caption) ? ("#" + p.Id) : p.Caption)</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(p.Manufacturer) ? "—" : p.Manufacturer)</td>
                                <td>@(string.IsNullOrWhiteSpace(p.Article) ? "—" : p.Article)</td>
                                <td>
                                    <a href="@StorefrontSurfaceLinks.ForProduct(p.Id)">View</a>
                                    ·
                                    <form method="post" action="@PhpCustomerWrites.CompareRemoveHref" style="display:inline">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="/storefront/compare-app" />
                                        <input type="hidden" name="product_id" value="@p.Id.ToString(CultureInfo.InvariantCulture)" />
                                        <button type="submit" class="btn btn-sm btn-default" style="padding:.15rem .5rem;font-size:.78rem">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    <p class="epc-sf-cmp-note">
        Compared products stay on this page. Add or remove them from a product card.
    </p>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private List<int> _ids = [];
    private IReadOnlyList<StorefrontProductDigest> _products = [];
    private string _source = "n/a";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);

        if (ctx.Request.Cookies.TryGetValue("compare", out var raw) && !string.IsNullOrWhiteSpace(raw))
        {
            try
            {
                var parsed = JsonSerializer.Deserialize<List<int>>(raw);
                if (parsed is not null)
                {
                    _ids = parsed.Where(id => id > 0).Distinct().Take(40).ToList();
                }
            }
            catch
            {
                _ids = [];
            }
        }

        if (_ids.Count == 0)
        {
            return;
        }

        var result = await Dashboards.ListStorefrontProductsByIdsAsync(_ids, ctx.RequestAborted);
        _products = result.Rows;
        _source = result.Source;
    }
}
