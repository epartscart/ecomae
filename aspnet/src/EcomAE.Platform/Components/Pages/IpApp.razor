@page "/ip"
@page "/ip/app"
@page "/ip/ecosystem"
@page "/ip/ecosystem-app"
@* Lowercase only — uppercase /IP duplicates AmbiguousMatchException under case-insensitive routing. *@
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.LifeOs.Cinematic
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@using EcomAE.Platform.Services
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject ILifeOsCinematicFilm Film

<PageTitle>Intelligence Platform OS · ecomae</PageTitle>
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<style>@((MarkupString)_css)</style>
<HeadContent>
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<meta name="ecomae-chrome-surface" content="ip-os" />
<style>@((MarkupString)_css)</style>
</HeadContent>

<div class="ipos" data-panel="@_panel">
  <div class="ipos-wallpaper" aria-hidden="true">
    <div class="ipos-orb ipos-orb--a"></div>
    <div class="ipos-orb ipos-orb--b"></div>
    <div class="ipos-grid"></div>
    <svg class="ipos-spark" viewBox="0 0 800 200" preserveAspectRatio="none">
      <path d="M0 140 C80 120 120 80 200 100 S320 160 400 90 S560 40 640 70 S760 120 800 60" fill="none" stroke="rgba(56,189,248,.45)" stroke-width="2"/>
    </svg>
  </div>

  <header class="ipos-menubar" role="banner">
    <div class="ipos-brand">
      <span class="ipos-brand__mark">IP</span>
      <div>
        <strong>Intelligence Platform <em>OS</em></strong>
        <small>ecomae · Super-CP operator desktop</small>
      </div>
    </div>
    <nav class="ipos-menubar__nav" aria-label="Quick launch">
      <button type="button" class="@PanelClass("dashboard")" @onclick='() => _panel = "dashboard"'>Dashboard</button>
      <button type="button" class="@PanelClass("apps")" @onclick='() => _panel = "apps"'>Apps</button>
      <button type="button" class="@PanelClass("clients")" @onclick='() => _panel = "clients"'>Clients</button>
      <button type="button" class="@PanelClass("lifeos")" @onclick='() => _panel = "lifeos"'>LifeOS</button>
      <a href="@Film.VideoDownloadUrl" download="LifeOS-Daily-Clone-Routine.mp4" title="Download LifeOS daily clone film">Film ↓</a>
      <a href="@EcomAeRoutes.ControlPanelLifeOsGuideApp">Guide</a>
    </nav>
    <div class="ipos-menubar__meta">
      @if (_isAdmin)
      {
        <span class="ipos-pill is-live">Operator session</span>
      }
      else
      {
        <a class="ipos-pill" href="@EcomAeRoutes.IpLogin">Sign in</a>
      }
      <a class="ipos-pill ghost" href="@EcomAeRoutes.IpLogout">Logout</a>
      <time class="ipos-clock">@_clock</time>
    </div>
  </header>

  <aside class="ipos-dock" aria-label="App dock">
    <button type="button" title="Dashboard" class="@DockClass("dashboard")" @onclick='() => _panel = "dashboard"'><span>◉</span><em>Home</em></button>
    <button type="button" title="App management" class="@DockClass("apps")" @onclick='() => _panel = "apps"'><span>▦</span><em>Apps</em></button>
    <button type="button" title="Client management" class="@DockClass("clients")" @onclick='() => _panel = "clients"'><span>◫</span><em>Clients</em></button>
    <button type="button" title="LifeOS" class="@DockClass("lifeos")" @onclick='() => _panel = "lifeos"'><span>◎</span><em>LifeOS</em></button>
    <a href="/bos" title="BOS Fleet"><span>⬡</span><em>BOS</em></a>
    <a href="/cp" title="Control Panel"><span>▣</span><em>CP</em></a>
    <a href="/erp" title="ERP"><span>▤</span><em>ERP</em></a>
    <a href="https://lifeos.ecomae.com/" target="_blank" rel="noopener" title="LifeOS product"><span>✦</span><em>Launch</em></a>
  </aside>

  <main class="ipos-desktop" role="main">
    @if (!_isAdmin)
    {
      <div class="ipos-guest">
        Preview mode — <a href="@EcomAeRoutes.IpLogin">sign in</a> to operate the Intelligence Platform OS.
      </div>
    }

    @if (_panel == "dashboard")
    {
      <section class="ipos-window ipos-window--hero" aria-label="System dashboard">
        <header class="ipos-window__bar">
          <span class="ipos-dots" aria-hidden="true"></span>
          <h1>System dashboard</h1>
          <span class="ipos-window__status">Live fabric</span>
        </header>
        <div class="ipos-window__body">
          <div class="ipos-hero-copy">
            <p class="ipos-kicker">Operating system for ambient intelligence</p>
            <h2>One desktop for apps, clients, and LifeOS™</h2>
            <p>
              Command BOS modules, multi-client fleets, and the LifeOS ambient operating system
              from a single Super-CP shell — not a BOS submenu.
            </p>
            <div class="ipos-cta">
              <button type="button" @onclick='() => _panel = "apps"'>Open app manager</button>
              <button type="button" class="ghost" @onclick='() => _panel = "lifeos"'>Enter LifeOS</button>
              <button type="button" class="ghost" @onclick='() => _panel = "clients"'>Manage clients</button>
            </div>
          </div>
          <div class="ipos-kpis" aria-label="Fabric metrics">
            <article><strong>@EcomaeEcosystemCatalog.BosModules.Count</strong><span>BOS apps</span></article>
            <article><strong>@EcomaeEcosystemCatalog.AmbientOsProducts.Count</strong><span>Ambient OS</span></article>
            <article><strong>@EcomaeEcosystemCatalog.ClientManagement.Count</strong><span>Client tools</span></article>
            <article><strong>@EcomaeEcosystemCatalog.LifeOsConsoles.Count</strong><span>LifeOS consoles</span></article>
          </div>
          <svg class="ipos-flow" viewBox="0 0 640 160" role="img" aria-label="Perceive decide act learn">
            <defs>
              <linearGradient id="iposFlow" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#38bdf8"/><stop offset="100%" stop-color="#2563eb"/>
              </linearGradient>
              <marker id="iposArr" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
                <path d="M0,0 L6,3 L0,6 Z" fill="#38bdf8"/>
              </marker>
            </defs>
            <rect x="20" y="50" width="120" height="56" rx="10" fill="#0b1b3a" stroke="url(#iposFlow)" stroke-width="2"/>
            <text x="80" y="84" text-anchor="middle" fill="#fff" font-size="14" font-family="Sora,sans-serif">Perceive</text>
            <path d="M140 78 H170" stroke="#38bdf8" stroke-width="2" marker-end="url(#iposArr)"/>
            <rect x="170" y="50" width="120" height="56" rx="10" fill="#0b1b3a" stroke="url(#iposFlow)" stroke-width="2"/>
            <text x="230" y="84" text-anchor="middle" fill="#fff" font-size="14" font-family="Sora,sans-serif">Decide</text>
            <path d="M290 78 H320" stroke="#38bdf8" stroke-width="2" marker-end="url(#iposArr)"/>
            <rect x="320" y="50" width="120" height="56" rx="10" fill="#0b1b3a" stroke="url(#iposFlow)" stroke-width="2"/>
            <text x="380" y="84" text-anchor="middle" fill="#fff" font-size="14" font-family="Sora,sans-serif">Act</text>
            <path d="M440 78 H470" stroke="#38bdf8" stroke-width="2" marker-end="url(#iposArr)"/>
            <rect x="470" y="50" width="120" height="56" rx="10" fill="#0b1b3a" stroke="url(#iposFlow)" stroke-width="2"/>
            <text x="530" y="84" text-anchor="middle" fill="#fff" font-size="14" font-family="Sora,sans-serif">Learn</text>
          </svg>
        </div>
      </section>
    }
    else if (_panel == "apps")
    {
      <section class="ipos-window" aria-label="App management">
        <header class="ipos-window__bar">
          <span class="ipos-dots" aria-hidden="true"></span>
          <h1>App management system</h1>
          <span class="ipos-window__status">BOS + Ambient OS</span>
        </header>
        <div class="ipos-window__body">
          <h2 class="ipos-sub">Business Operating System apps</h2>
          <div class="ipos-icons">
            @foreach (var mod in EcomaeEcosystemCatalog.BosModules)
            {
              <a class="ipos-icon" href="@mod.Href">
                <span class="ipos-icon__glyph">@IconFor(mod.Key)</span>
                <strong>@mod.Title</strong>
                <small>@mod.Tagline</small>
                <em class="@(mod.Status == "live" ? "live" : "soon")">@mod.Status</em>
              </a>
            }
          </div>
          <h2 class="ipos-sub">Ambient OS products</h2>
          <div class="ipos-icons">
            @foreach (var os in EcomaeEcosystemCatalog.AmbientOsProducts)
            {
              var life = os.Key == "lifeos";
              if (os.Href == "#")
              {
                <div class="ipos-icon is-disabled">
                  <span class="ipos-icon__glyph">◎</span>
                  <strong>@os.Title</strong>
                  <small>@os.Tagline</small>
                  <em class="soon">@os.Status</em>
                </div>
              }
              else
              {
                <a class="ipos-icon @(life ? "is-lifeos" : null)"
                   href="@os.Href"
                   target="@(life ? "_blank" : null)"
                   rel="@(life ? "noopener" : null)">
                  <span class="ipos-icon__glyph">◎</span>
                  <strong>@os.Title</strong>
                  <small>@os.Tagline</small>
                  <em class="@(os.Status.Contains("live", StringComparison.Ordinal) ? "live" : "soon")">@os.Status</em>
                </a>
              }
            }
          </div>
        </div>
      </section>
    }
    else if (_panel == "clients")
    {
      <section class="ipos-window" aria-label="Client management">
        <header class="ipos-window__bar">
          <span class="ipos-dots" aria-hidden="true"></span>
          <h1>Multiple client management</h1>
          <span class="ipos-window__status">Tenant fleet</span>
        </header>
        <div class="ipos-window__body">
          <p class="ipos-lede">Operate every client site from the IP desktop — tenants, features, users, API clients, and fleet health.</p>
          <div class="ipos-icons">
            @foreach (var c in EcomaeEcosystemCatalog.ClientManagement)
            {
              <a class="ipos-icon" href="@c.Href">
                <span class="ipos-icon__glyph">◫</span>
                <strong>@c.Title</strong>
                <small>@c.Tagline</small>
                <em class="live">@c.Status</em>
              </a>
            }
          </div>
        </div>
      </section>
    }
    else
    {
      <section class="ipos-window ipos-window--lifeos" aria-label="LifeOS operating system">
        <header class="ipos-window__bar">
          <span class="ipos-dots" aria-hidden="true"></span>
          <h1>LifeOS™ operating system</h1>
          <span class="ipos-window__status">Ambient AI OS</span>
        </header>
        <div class="ipos-window__body">
          <div class="ipos-lifeos-banner">
            <div>
              <p class="ipos-kicker">Universal Ambient Artificial Intelligence</p>
              <h2>Life<em>OS</em>™ inside the Intelligence Platform</h2>
              <p>Launch the product host, consoles, and Master Spec — Perceive → Decide → Act → Learn across work, wealth, health, home, and mobility.</p>
              <div class="ipos-cta">
                <a class="btn" href="https://lifeos.ecomae.com/" target="_blank" rel="noopener">Open lifeos.ecomae.com</a>
                <a class="btn ghost" href="/lifeos">Preview /lifeos</a>
                <a class="btn ghost" href="@EcomAeRoutes.ControlPanelLifeOsGuideApp">CP visual guide</a>
              </div>
            </div>
            <ul class="ipos-engines">
              @foreach (var eng in EcomaeEcosystemCatalog.FindOs("lifeos")!.Children!)
              {
                <li>@eng</li>
              }
            </ul>
          </div>

          <section class="ipos-film" aria-labelledby="ipos-film-title">
            <div class="ipos-film__head">
              <div>
                <h2 id="ipos-film-title">Daily clone film</h2>
                <p>Morning → evening with @Film.ProtagonistName ↔ @Film.ProtagonistName — watch here or download the MP4.</p>
              </div>
              <div class="ipos-film__actions">
                <a class="btn" href="@Film.VideoDownloadUrl" download="LifeOS-Daily-Clone-Routine.mp4">Download MP4</a>
                <a class="btn ghost" href="@EcomAeRoutes.LifeOsCinematicApp">Open theatre</a>
              </div>
            </div>
            <div class="ipos-film__player">
              <video controls playsinline preload="metadata" poster="@Film.PosterUrl" aria-label="LifeOS daily human + AI clone routine film">
                <source src="@Film.VideoUrl" type="video/mp4" />
              </video>
            </div>
            <p class="ipos-film__path">
              File: <code>@Film.VideoUrl</code>
              · Hero loop: <code>@Film.HeroVideoUrl</code>
              · <a href="@Film.PosterUrl" download="LifeOS-Daily-Clone-Poster.png">Download poster</a>
            </p>
          </section>

          <h2 class="ipos-sub">LifeOS consoles</h2>
          <div class="ipos-icons">
            @foreach (var c in EcomaeEcosystemCatalog.LifeOsConsoles)
            {
              <a class="ipos-icon is-lifeos" href="@c.Href">
                <span class="ipos-icon__glyph">✦</span>
                <strong>@c.Title</strong>
                <small>@c.Tagline</small>
                <em class="@(c.Status == "live" ? "live" : "soon")">@c.Status</em>
              </a>
            }
          </div>
        </div>
      </section>
    }
  </main>
</div>

@code {
    private bool _isAdmin;
    private string _panel = "dashboard";
    private string _clock = DateTimeOffset.Now.ToString("HH:mm");

    private string PanelClass(string id) => _panel == id ? "is-active" : null!;
    private string DockClass(string id) => _panel == id ? "is-active" : null!;

    private static string IconFor(string key) => key switch
    {
        "erp" => "▤",
        "crm" => "◎",
        "workflow" => "⇄",
        "automation" => "⚡",
        "ai" => "✦",
        "cp" => "▣",
        _ => "▦"
    };

    protected override async Task OnInitializedAsync()
    {
        _clock = DateTimeOffset.UtcNow.ToLocalTime().ToString("HH:mm");
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin;
    }

    private const string _css = """
        .ipos {
          --ipos-ink: #e2e8f0; --ipos-mute: #94a3b8; --ipos-line: rgba(56,189,248,.28);
          --ipos-display: "Fraunces", Georgia, serif; --ipos-sans: "Sora", "Segoe UI", sans-serif;
          position: relative; min-height: 100vh; color: var(--ipos-ink); font-family: var(--ipos-sans);
          background: #020617; overflow-x: hidden;
        }
        .ipos-wallpaper { position: fixed; inset: 0; z-index: 0; pointer-events: none;
          background: radial-gradient(120% 80% at 10% -10%, rgba(14,165,233,.28), transparent 55%),
                      radial-gradient(90% 70% at 90% 110%, rgba(37,99,235,.22), transparent 50%),
                      linear-gradient(160deg, #020617 0%, #0b1b3a 55%, #020617 100%); }
        .ipos-orb { position: absolute; border-radius: 50%; filter: blur(40px); opacity: .55;
          animation: ipos-float 14s ease-in-out infinite; }
        .ipos-orb--a { width: 22rem; height: 22rem; left: -4rem; top: 20%; background: rgba(56,189,248,.35); }
        .ipos-orb--b { width: 18rem; height: 18rem; right: -3rem; bottom: 10%; background: rgba(37,99,235,.4);
          animation-delay: -5s; }
        .ipos-grid { position: absolute; inset: 0; opacity: .12;
          background-image: linear-gradient(rgba(255,255,255,.12) 1px, transparent 1px),
                            linear-gradient(90deg, rgba(255,255,255,.12) 1px, transparent 1px);
          background-size: 48px 48px; mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%); }
        .ipos-spark { position: absolute; left: 10%; right: 10%; bottom: 18%; height: 160px; opacity: .7;
          animation: ipos-draw 8s ease-in-out infinite; }
        @@keyframes ipos-float { 0%,100%{ transform: translateY(0) scale(1);} 50%{ transform: translateY(-18px) scale(1.06);} }
        @@keyframes ipos-draw { 0%,100%{ opacity:.35; transform: translateY(0);} 50%{ opacity:.85; transform: translateY(-8px);} }
        @@keyframes ipos-rise { from{ opacity:0; transform: translateY(14px);} to{ opacity:1; transform: none;} }
        @@keyframes ipos-glow { 0%,100%{ box-shadow: 0 0 0 rgba(56,189,248,0);} 50%{ box-shadow: 0 0 24px rgba(56,189,248,.25);} }

        .ipos-menubar, .ipos-dock, .ipos-desktop { position: relative; z-index: 1; }
        .ipos-menubar {
          display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
          padding: .7rem 1rem; border-bottom: 1px solid var(--ipos-line);
          background: rgba(2,6,23,.72); backdrop-filter: blur(14px);
        }
        .ipos-brand { display: flex; align-items: center; gap: .75rem; }
        .ipos-brand__mark {
          width: 2.4rem; height: 2.4rem; display: grid; place-items: center; border-radius: .55rem;
          font-weight: 800; letter-spacing: .04em; color: #020617;
          background: linear-gradient(135deg, #7dd3fc, #2563eb); animation: ipos-glow 4s ease-in-out infinite;
        }
        .ipos-brand strong { display: block; font-family: var(--ipos-display); font-weight: 500; font-size: 1.05rem; }
        .ipos-brand em { font-style: italic; color: #7dd3fc; }
        .ipos-brand small { color: var(--ipos-mute); font-size: .72rem; }
        .ipos-menubar__nav { display: flex; flex-wrap: wrap; gap: .35rem; }
        .ipos-menubar__nav button, .ipos-menubar__nav a {
          appearance: none; border: 1px solid transparent; background: transparent; color: #cbd5e1;
          font: inherit; font-size: .78rem; font-weight: 700; padding: .4rem .7rem; border-radius: .4rem;
          cursor: pointer; text-decoration: none;
        }
        .ipos-menubar__nav button.is-active, .ipos-menubar__nav a:hover, .ipos-menubar__nav button:hover {
          background: rgba(56,189,248,.12); border-color: var(--ipos-line); color: #fff;
        }
        .ipos-menubar__meta { display: flex; align-items: center; gap: .45rem; flex-wrap: wrap; }
        .ipos-pill {
          font-size: .72rem; font-weight: 700; text-decoration: none; color: #e0f2fe;
          padding: .35rem .6rem; border-radius: .35rem; border: 1px solid var(--ipos-line);
          background: rgba(14,165,233,.12);
        }
        .ipos-pill.is-live { color: #bbf7d0; border-color: rgba(74,222,128,.35); background: rgba(22,163,74,.15); }
        .ipos-pill.ghost { background: transparent; color: #94a3b8; }
        .ipos-clock { font-variant-numeric: tabular-nums; color: #7dd3fc; font-size: .85rem; font-weight: 700; }

        .ipos-dock {
          position: fixed; left: .75rem; top: 50%; transform: translateY(-50%);
          display: flex; flex-direction: column; gap: .4rem; z-index: 3;
          padding: .55rem; border-radius: 1rem; border: 1px solid var(--ipos-line);
          background: rgba(2,6,23,.78); backdrop-filter: blur(12px);
        }
        .ipos-dock a, .ipos-dock button {
          width: 3.2rem; appearance: none; border: 0; background: rgba(15,23,42,.85); color: #e2e8f0;
          border-radius: .7rem; padding: .45rem .2rem .35rem; cursor: pointer; text-decoration: none;
          display: flex; flex-direction: column; align-items: center; gap: .15rem;
          transition: transform .2s ease, background .2s ease;
        }
        .ipos-dock a:hover, .ipos-dock button:hover, .ipos-dock .is-active {
          transform: translateY(-2px) scale(1.04); background: rgba(37,99,235,.45);
        }
        .ipos-dock span { font-size: 1.05rem; line-height: 1; }
        .ipos-dock em { font-style: normal; font-size: .58rem; font-weight: 700; color: #94a3b8; }

        .ipos-desktop { padding: 1.1rem 1.1rem 2rem 5.2rem; animation: ipos-rise .55s ease both; }
        .ipos-guest {
          margin: 0 0 1rem; padding: .75rem 1rem; border-radius: .5rem;
          background: rgba(14,165,233,.12); border: 1px solid var(--ipos-line); color: #bae6fd; font-size: .88rem;
        }
        .ipos-guest a { color: #fff; font-weight: 700; }

        .ipos-window {
          border: 1px solid var(--ipos-line); border-radius: 1rem; overflow: hidden;
          background: rgba(8,15,30,.88); box-shadow: 0 24px 60px rgba(0,0,0,.35);
          animation: ipos-rise .5s ease both;
        }
        .ipos-window__bar {
          display: flex; align-items: center; gap: .75rem; padding: .7rem 1rem;
          border-bottom: 1px solid rgba(148,163,184,.15);
          background: linear-gradient(90deg, rgba(14,165,233,.15), transparent 60%);
        }
        .ipos-dots { width: 2.6rem; height: .7rem; border-radius: 999px;
          background: radial-gradient(circle at 6px, #f87171 4px, transparent 5px),
                      radial-gradient(circle at 18px, #fbbf24 4px, transparent 5px),
                      radial-gradient(circle at 30px, #4ade80 4px, transparent 5px); }
        .ipos-window__bar h1 { margin: 0; flex: 1; font-size: .95rem; font-weight: 700; }
        .ipos-window__status { font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #7dd3fc; }
        .ipos-window__body { padding: 1.15rem 1.2rem 1.4rem; }
        .ipos-kicker { margin: 0; font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; color: #7dd3fc; font-weight: 700; }
        .ipos-hero-copy h2, .ipos-lifeos-banner h2 {
          margin: .35rem 0 .5rem; font-family: var(--ipos-display); font-weight: 500;
          font-size: clamp(1.5rem, 3vw, 2.15rem);
        }
        .ipos-lifeos-banner h2 em { font-style: italic; color: #7dd3fc; }
        .ipos-hero-copy p, .ipos-lede, .ipos-lifeos-banner p { margin: 0; color: #cbd5e1; max-width: 40rem; line-height: 1.5; font-size: .92rem; }
        .ipos-cta { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1rem; }
        .ipos-cta button, .ipos-cta a.btn, .ipos-cta a:not(.ghost) {
          appearance: none; border: 0; cursor: pointer; text-decoration: none;
          padding: .55rem .9rem; border-radius: .45rem; font-weight: 750; font-size: .82rem;
          color: #020617; background: linear-gradient(135deg, #7dd3fc, #38bdf8);
        }
        .ipos-cta button.ghost, .ipos-cta a.ghost {
          background: transparent; border: 1px solid var(--ipos-line); color: #e2e8f0;
        }
        .ipos-kpis {
          display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: .65rem; margin: 1.25rem 0 1rem;
        }
        .ipos-kpis article {
          padding: .9rem; border-radius: .65rem; border: 1px solid var(--ipos-line);
          background: rgba(15,23,42,.75);
        }
        .ipos-kpis strong { display: block; font-size: 1.45rem; color: #fff; }
        .ipos-kpis span { color: var(--ipos-mute); font-size: .75rem; }
        .ipos-flow { width: 100%; max-width: 40rem; height: auto; display: block; margin-top: .5rem; }
        .ipos-sub { margin: 1.1rem 0 .65rem; font-size: .95rem; color: #e2e8f0; }
        .ipos-icons {
          display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .65rem;
        }
        .ipos-icon {
          display: flex; flex-direction: column; gap: .25rem; min-height: 8.2rem;
          padding: .9rem; text-decoration: none; color: inherit;
          border: 1px solid var(--ipos-line); border-radius: .75rem;
          background: rgba(15,23,42,.7); transition: transform .2s ease, border-color .2s ease, background .2s ease;
        }
        .ipos-icon:hover { transform: translateY(-3px); border-color: #38bdf8; background: rgba(30,58,138,.35); }
        .ipos-icon.is-lifeos { background: linear-gradient(160deg, rgba(14,165,233,.18), rgba(15,23,42,.8)); }
        .ipos-icon.is-disabled { opacity: .55; }
        .ipos-icon__glyph {
          width: 2.2rem; height: 2.2rem; display: grid; place-items: center; border-radius: .55rem;
          background: rgba(56,189,248,.15); color: #7dd3fc; font-size: 1.05rem; margin-bottom: .2rem;
        }
        .ipos-icon strong { font-size: .92rem; color: #fff; }
        .ipos-icon small { color: #94a3b8; font-size: .72rem; line-height: 1.35; flex: 1; }
        .ipos-icon em {
          font-style: normal; font-size: .65rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
        }
        .ipos-icon em.live { color: #4ade80; }
        .ipos-icon em.soon { color: #fbbf24; }
        .ipos-lifeos-banner {
          display: grid; grid-template-columns: 1.4fr .9fr; gap: 1rem; align-items: start;
          margin-bottom: .5rem;
        }
        .ipos-film {
          margin: 1.15rem 0 1.25rem; padding: 1rem;
          border: 1px solid var(--ipos-line); border-radius: .85rem;
          background: linear-gradient(160deg, rgba(14,165,233,.12), rgba(2,6,23,.72));
        }
        .ipos-film__head {
          display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between;
          gap: .85rem; margin-bottom: .85rem;
        }
        .ipos-film__head h2 { margin: 0 0 .25rem; font-family: var(--ipos-display); font-size: 1.35rem; color: #fff; }
        .ipos-film__head p { margin: 0; color: var(--ipos-mute); font-size: .88rem; max-width: 34rem; }
        .ipos-film__actions { display: flex; flex-wrap: wrap; gap: .5rem; }
        .ipos-film__actions .btn {
          display: inline-flex; align-items: center; justify-content: center;
          padding: .55rem 1rem; border-radius: .55rem; border: 0; text-decoration: none;
          font-weight: 700; font-size: .85rem; cursor: pointer; color: #020617;
          background: linear-gradient(135deg, #7dd3fc, #2563eb);
        }
        .ipos-film__actions .btn.ghost {
          color: #e2e8f0; background: transparent; border: 1px solid var(--ipos-line);
        }
        .ipos-film__player {
          overflow: hidden; border-radius: .55rem; background: #000;
          box-shadow: 0 18px 40px rgba(0,0,0,.35);
        }
        .ipos-film__player video { display: block; width: 100%; aspect-ratio: 16 / 9; background: #000; }
        .ipos-film__path { margin: .7rem 0 0; font-size: .78rem; color: var(--ipos-mute); }
        .ipos-film__path code { color: #bae6fd; }
        .ipos-film__path a { color: #7dd3fc; }
        .ipos-engines {
          list-style: none; margin: 0; padding: .85rem; border-radius: .75rem;
          border: 1px solid var(--ipos-line); background: rgba(2,6,23,.55);
          display: grid; gap: .35rem; max-height: 16rem; overflow: auto;
        }
        .ipos-engines li {
          font-size: .78rem; color: #cbd5e1; padding: .35rem .45rem; border-radius: .35rem;
          background: rgba(56,189,248,.08);
        }
        @@media (max-width: 960px) {
          .ipos-dock { position: static; transform: none; flex-direction: row; flex-wrap: wrap;
            margin: .75rem; width: calc(100% - 1.5rem); }
          .ipos-desktop { padding: 1rem; }
          .ipos-kpis { grid-template-columns: 1fr 1fr; }
          .ipos-lifeos-banner { grid-template-columns: 1fr; }
        }
        """;
}
