@page "/cp/tenants-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Tenants · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

@if (_allowed)
{
    <PhpCpDesktopChrome IsAdmin="_isAdmin">

        <PhpCpModulePageHeader Title="Portal Tenants"
                               Subtitle="Super CP tenant fleet control (PHP tenant control centre presentation)."
                               PhpTabHref="@_phpTab"
                               ExtraPanelClass="epc-scp-panel--tenants">
            <a class="ghost" href="/cp/menus-app">Menus list</a>
            <a class="ghost" href="/bos/app">BOS fleet</a>
        </PhpCpModulePageHeader>

        <div class="epc-scp-kpi" aria-label="Tenants KPIs">
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">Shown (limit @_limit)</div>
                <div class="epc-scp-kpi__val">@_tenants.Count</div>
            </div>
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">Active</div>
                <div class="epc-scp-kpi__val">@_active</div>
            </div>
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">With database</div>
                <div class="epc-scp-kpi__val">@_withDb</div>
            </div>
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">ERP-only</div>
                <div class="epc-scp-kpi__val">@_erpOnly</div>
            </div>
        </div>

        <div class="epc-scp-table-card">
            <table class="epc-scp-data-table table table-epc-pro">
                <thead>
                    <tr>
                        <th>Site key</th>
                        <th>Hostname</th>
                        <th>Trade name</th>
                        <th>Industry</th>
                        <th>Status</th>
                        <th>Hub</th>
                        <th>Hosted</th>
                        <th>Active</th>
                        <th>DB</th>
                        <th>ERP-only</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_tenants.Count == 0)
                    {
                        <tr><td colspan="11">Nothing to show yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var t in _tenants)
                        {
                            <tr>
                                <td><strong>@(string.IsNullOrWhiteSpace(t.SiteKey) ? "—" : t.SiteKey)</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(t.Hostname) ? "—" : t.Hostname)</td>
                                <td>@(string.IsNullOrWhiteSpace(t.TradeName) ? "—" : t.TradeName)</td>
                                <td>@(string.IsNullOrWhiteSpace(t.IndustryCode) ? "—" : t.IndustryCode)</td>
                                <td><span class="epc-scp-badge epc-scp-badge--tenant">@(string.IsNullOrWhiteSpace(t.Status) ? "—" : t.Status)</span></td>
                                <td>@(string.IsNullOrWhiteSpace(t.HubName) ? "—" : t.HubName)</td>
                                <td>@(string.IsNullOrWhiteSpace(t.HostedOn) ? "—" : t.HostedOn)</td>
                                <td><span class="epc-scp-badge @(t.IsActive ? "epc-scp-badge--ok" : "epc-scp-badge--off")">@(t.IsActive ? "yes" : "no")</span></td>
                                <td><span class="epc-scp-badge @(t.HasDb ? "epc-scp-badge--ok" : "epc-scp-badge--off")">@(t.HasDb ? "yes" : "no")</span></td>
                                <td><span class="epc-scp-badge">@(t.ErpOnly ? "yes" : "no")</span></td>
                                <td class="epc-scp-actions-cell"><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

    </PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>Tenant fleet control is available on the platform Super CP host only.</p>
        <p><a href="/cp">Open Control Panel</a></p>
    </div>
}

@code {
    private const string _phpTab = "/CP/control/portal/epc_tenant_control_center";
    private bool _allowed;
    private bool _isAdmin;
    private IReadOnlyList<PortalTenantDigest> _tenants = [];
    private int _active;
    private int _withDb;
    private int _erpOnly;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListPortalTenantsAsync(_limit, ctx.RequestAborted);
        _tenants = result.Tenants;
        _active = _tenants.Count(t => t.IsActive);
        _withDb = _tenants.Count(t => t.HasDb);
        _erpOnly = _tenants.Count(t => t.ErpOnly);
        _source = result.Source;
        _message = result.Message;
    }
}
