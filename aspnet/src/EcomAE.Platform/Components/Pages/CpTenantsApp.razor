@page "/cp/tenants-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ICpTenantControlCenterService ControlCenter
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Tenants · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

@if (_allowed)
{
    <PhpCpDesktopChrome IsAdmin="_isAdmin">
    <PhpParityModuleBody AppPath="/cp/tenants-app" IsAdmin="_isAdmin" />


        <PhpCpModulePageHeader Title="Tenant control center"
                               Subtitle="All commerce, demo, and ERP-only tenants — operator credentials and immediate on/off. Internal Super CP only."
                               PhpTabHref="@_phpTab"
                               ExtraPanelClass="epc-scp-panel--tenants">
            <a class="ghost" href="/cp/tenant-config-app">Tenant hub</a>
            <a class="ghost" href="/cp/demo-tenants-app">Demo tenants</a>
            <a class="ghost" href="/cp/tenant-features-app">Feature registry</a>
            <a class="ghost" href="/cp/industry-settings-app">ERP module packs</a>
            <a class="ghost" href="/bos/app">BOS fleet</a>
        </PhpCpModulePageHeader>

        <div class="epc-scp-kpi" aria-label="Tenants KPIs">
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">Listed</div>
                <div class="epc-scp-kpi__val">@_tenants.Count</div>
            </div>
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">In registry</div>
                <div class="epc-scp-kpi__val">@_registry</div>
            </div>
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">Accessible</div>
                <div class="epc-scp-kpi__val">@_accessible</div>
            </div>
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">Platform DB</div>
                <div class="epc-scp-kpi__val"><code>@_platformDb</code></div>
            </div>
        </div>

        <p class="help-block">ERP-only tenants: configure granular modules in <strong>Portal → Industry settings</strong> (presets: Full ERP, HR only, Customs + Logistics). Password reveal, reset and demo-access credential edits stay on the Classic twin — this page does not invent a send.</p>

        @if (!string.IsNullOrWhiteSpace(_flashOk))
        {
            <div class="alert alert-success" role="status">@_flashOk</div>
        }
        @if (!string.IsNullOrWhiteSpace(_flashErr))
        {
            <div class="alert alert-danger" role="status">@_flashErr</div>
        }

        @if (_isAdmin)
        {
            <div class="epc-scp-table-card" style="margin-bottom:1rem;padding:1rem">
                <form method="post" action="/cp/tenants/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="/cp/tenants-app" />
                    <input type="hidden" name="action" value="tenant_set_active" />
                    <label>Site key
                        <input type="text" name="site_key" value="" />
                    </label>
                    <label>Active
                        <select name="active">
                            <option value="1">on</option>
                            <option value="0">off</option>
                        </select>
                    </label>
                    <button type="submit" class="btn btn-primary btn-sm">Set active</button>
                </form>
                <p class="help-block" style="margin:.75rem 0 0">Password reset and reveal stay Classic.</p>
            </div>
        }

        <div class="epc-scp-table-card">
            <table class="epc-scp-data-table table table-epc-pro">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Site key</th>
                        <th>Hostname</th>
                        <th>DB</th>
                        <th>ERP pack</th>
                        <th>Status</th>
                        <th>On</th>
                        <th>Login email</th>
                        <th>ERP login URL</th>
                        <th>Password</th>
                        <th>Links</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_tenants.Count == 0)
                    {
                        <tr><td colspan="11">No records yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var t in _tenants)
                        {
                            <tr class="@(t.AccessBlocked ? "warning" : "")">
                                <td><span class="label @t.BadgeClass">@t.TypeLabel</span></td>
                                <td><code>@(string.IsNullOrWhiteSpace(t.SiteKey) ? "—" : t.SiteKey)</code></td>
                                <td>@(string.IsNullOrWhiteSpace(t.Hostname) ? "—" : t.Hostname)</td>
                                <td><code>@(string.IsNullOrWhiteSpace(t.DbName) ? "—" : t.DbName)</code></td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(t.ErpPackLabel))
                                    {
                                        <span class="label label-info">@t.ErpPackLabel</span>
                                    }
                                    else if (t.TenantType == "erp_only")
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">n/a</span>
                                    }
                                </td>
                                <td>
                                    @if (t.StatusDisplay == "disabled")
                                    {
                                        <span class="text-danger">Off</span>
                                    }
                                    else if (t.StatusDisplay == "expired")
                                    {
                                        <span class="text-warning">Expired</span>
                                    }
                                    else
                                    {
                                        @(string.IsNullOrWhiteSpace(t.Status) ? "—" : t.Status)
                                    }
                                </td>
                                <td>
                                    @if (_isAdmin && !string.IsNullOrWhiteSpace(t.SiteKey))
                                    {
                                        <form method="post" action="/cp/tenants/write" style="display:inline">
                                            <input type="hidden" name="confirmWrites" value="true" />
                                            <input type="hidden" name="returnUrl" value="/cp/tenants-app" />
                                            <input type="hidden" name="action" value="tenant_set_active" />
                                            <input type="hidden" name="site_key" value="@t.SiteKey" />
                                            <input type="hidden" name="active" value="@(t.IsActive ? "0" : "1")" />
                                            <button type="submit" class="btn btn-xs @(t.IsActive ? "btn-default" : "btn-primary")">@(t.IsActive ? "ON" : "OFF")</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@(t.IsActive ? "ON" : "OFF")</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(t.AdminEmail))
                                    {
                                        <a href="@("mailto:" + t.AdminEmail)">@t.AdminEmail</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(t.ErpLoginUrl))
                                    {
                                        <a class="small" href="@t.ErpLoginUrl" target="_blank" rel="noopener">@t.ErpLoginUrl</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (t.HasStoredPassword)
                                    {
                                        <span class="epc-tcc-pwd-mask">••••••••</span>
                                        <a class="small" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Reveal (Classic)</a>
                                    }
                                    else
                                    {
                                        <a class="small" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Reset (Classic)</a>
                                    }
                                </td>
                                <td style="white-space:nowrap">
                                    @if (!string.IsNullOrWhiteSpace(t.StorefrontUrl))
                                    {
                                        <a class="btn btn-xs btn-default" target="_blank" rel="noopener" href="@t.StorefrontUrl">Store</a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(t.CpUrl))
                                    {
                                        <a class="btn btn-xs btn-primary" target="_blank" rel="noopener" href="@t.CpUrl">CP</a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(t.ErpLoginUrl))
                                    {
                                        <a class="btn btn-xs btn-info" target="_blank" rel="noopener" href="@t.ErpLoginUrl">ERP</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <p class="help-block">Template tenants share the default commerce database until registered in Tenant Hub. Toggle and password reset require a registry row.</p>

    </PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>Tenant fleet control is available on the platform Super CP host only.</p>
        <p><a href="/cp">Open Control Panel</a></p>
    </div>
}

@code {
    private const string _phpTab = "/CP/control/portal/epc_tenant_control_center";
    private bool _allowed;
    private bool _isAdmin;
    private IReadOnlyList<CpTenantControlRow> _tenants = [];
    private int _registry;
    private int _accessible;
    private string _platformDb = "ecomae";
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await ControlCenter.LoadAsync(ctx.RequestAborted);
        _tenants = result.Tenants;
        _registry = result.RegistryCount;
        _accessible = result.AccessibleCount;
        _platformDb = result.PlatformDb;
        _source = result.Source;
        _message = result.Error;
    }
}
