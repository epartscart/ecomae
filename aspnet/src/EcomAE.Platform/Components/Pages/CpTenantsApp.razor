@page "/cp/tenants-app"
@page "/cp/tenant-hub-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ICpTenantControlCenterService ControlCenter
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Tenants · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

@if (_allowed)
{
    <PhpCpDesktopChrome IsAdmin="_isAdmin">
    <PhpParityModuleBody AppPath="/cp/tenants-app" IsAdmin="_isAdmin" />


        <PhpCpModulePageHeader Title="Tenant control center"
                               Subtitle="All commerce, demo, and ERP-only tenants — operator credentials and immediate on/off. Internal Super CP only."
                               PhpTabHref="@_phpTab"
                               ExtraPanelClass="epc-scp-panel--tenants">
            <a class="ghost" href="/cp/super-mail-app">Mailboxes</a>
            <a class="ghost" href="/cp/client-erp">Client ERP</a>
            <a class="ghost" href="/erp/tenant-config-app">Tenant hub</a>
            <a class="ghost" href="/cp/demo-tenants-app">Demo tenants</a>
            <a class="ghost" href="/cp/tenant-features-app">Feature registry</a>
            <a class="ghost" href="/cp/industry-settings-app">ERP module packs</a>
            <a class="ghost" href="/bos/app">BOS fleet</a>
            <a class="ghost" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Open</a>
        </PhpCpModulePageHeader>

        <div class="epc-scp-kpi" aria-label="Tenants KPIs">
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">Listed</div>
                <div class="epc-scp-kpi__val">@_tenants.Count</div>
            </div>
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">In registry</div>
                <div class="epc-scp-kpi__val">@_registry</div>
            </div>
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">Accessible</div>
                <div class="epc-scp-kpi__val">@_accessible</div>
            </div>
            <div class="epc-scp-kpi__card">
                <div class="epc-scp-kpi__label">Platform DB</div>
                <div class="epc-scp-kpi__val"><code>@_platformDb</code></div>
            </div>
        </div>

        <p class="help-block">
            Operators create and delete ERP-only companies here — no storefront, no client domain, hostname stays <code>www.ecomae.com</code>.
            Industry pack (Jewellery, Auto parts, …) is stored on the registry row. This page does not invent a send: copy the temporary password from the green banner.
            Password reveal and the original portal editor stay on the Classic twin — keep that Open link until PHP removal is approved.
        </p>

        @if (!string.IsNullOrWhiteSpace(_flashOk))
        {
            <div class="alert alert-success" role="status">@_flashOk</div>
        }
        @if (!string.IsNullOrWhiteSpace(_flashErr))
        {
            <div class="alert alert-danger" role="status">@_flashErr</div>
        }

        @if (_isAdmin)
        {
            <div class="epc-scp-table-card" style="margin-bottom:1rem;padding:1.1rem 1.15rem">
                <h3 style="margin:0 0 .45rem;font-size:1.05rem">Onboard ERP-only company (no website)</h3>
                <p class="help-block" style="margin:0 0 .75rem">
                    Four-letter company key: <code>asap</code>, <code>indj</code>, <code>fito</code>, <code>real</code>.
                    Operator login is always <code>xxxx@@ecomae.com</code> from that key. Super CP can reset the password on this page at any time.
                    Staff open <code>/cp/client-erp/xxxx/</code> — no public storefront.
                </p>
                <form method="post" action="/cp/tenants/write" style="margin:0 0 1rem">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="/cp/tenants-app" />
                    <input type="hidden" name="action" value="onboard_four_erp_only" />
                    <button type="submit" class="btn btn-primary">Create ASAP / INDJ / FITO / REAL now</button>
                </form>
                <ul style="margin:0 0 1rem;padding-left:1.2rem">
                    @foreach (var client in ErpOnlyLaunchClients.All)
                    {
                        var present = _tenants.Any(t => string.Equals(t.SiteKey, client.SiteKey, StringComparison.OrdinalIgnoreCase));
                        <li>
                            <strong>@client.TradeName</strong>
                            (<code>@client.SiteKey</code> · <a href="mailto:@client.Email">@client.Email</a>)
                            — @(present ? "in registry" : "not created yet")
                            · <a href="@client.LoginPath">@client.LoginPath</a>
                        </li>
                    }
                </ul>
                <form method="post" action="/cp/tenants/write" id="epc-erp-only-onboard" style="display:flex;flex-wrap:wrap;gap:.55rem;align-items:end">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="/cp/tenants-app" />
                    <input type="hidden" name="action" value="onboard_erp_only" />
                    <label>Site key
                        <input type="text" name="site_key" id="epc-erp-only-key" required maxlength="32" placeholder="fito" autocomplete="off" />
                    </label>
                    <label>Company name
                        <input type="text" name="trade_name" required maxlength="120" placeholder="FITO Fit-out" />
                    </label>
                    <label>Industry
                        <select name="industry_code">
                            <option value="auto_parts">Auto spare parts</option>
                            <option value="jewellery">Jewellery &amp; luxury</option>
                            <option value="fit_out">Interior fit-out</option>
                            <option value="real_estate">Real estate (investment, construction, developer)</option>
                            <option value="construction_contracting">Construction &amp; contracting</option>
                            <option value="erp_standalone">ERP standalone</option>
                            <option value="tax_advisory">Tax &amp; advisory</option>
                        </select>
                    </label>
                    <label>Operator email
                        <input type="email" name="admin_email" id="epc-erp-only-email" required placeholder="fito@@ecomae.com" />
                    </label>
                    <button type="submit" class="btn btn-primary">Create ERP-only tenant</button>
                </form>
                <script>
                (function () {
                    var key = document.getElementById('epc-erp-only-key');
                    var email = document.getElementById('epc-erp-only-email');
                    if (!key || !email) { return; }
                    function sync() {
                        var k = (key.value || '').toLowerCase().replace(/[^a-z0-9_]/g, '');
                        if (k) { email.value = k + '@@ecomae.com'; }
                    }
                    key.addEventListener('input', sync);
                    sync();
                })();
                </script>
            </div>
            <div class="epc-scp-table-card" style="margin-bottom:1rem;padding:1rem">
                <form method="post" action="/cp/tenants/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="/cp/tenants-app" />
                    <input type="hidden" name="action" value="tenant_set_active" />
                    <label>Site key
                        <input type="text" name="site_key" value="" />
                    </label>
                    <label>Active
                        <select name="active">
                            <option value="1">on</option>
                            <option value="0">off</option>
                        </select>
                    </label>
                    <button type="submit" class="btn btn-primary btn-sm">Set active</button>
                </form>
            </div>
        }

        <div class="epc-scp-table-card">
            <table class="epc-scp-data-table table table-epc-pro">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Site key</th>
                        <th>Hostname</th>
                        <th>DB</th>
                        <th>ERP pack</th>
                        <th>Status</th>
                        <th>On</th>
                        <th>Login email</th>
                        <th>ERP login URL</th>
                        <th>Password</th>
                        <th>Links</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_tenants.Count == 0)
                    {
                        <tr><td colspan="12">No records yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var t in _tenants)
                        {
                            <tr class="@(t.AccessBlocked ? "warning" : "")">
                                <td><span class="label @t.BadgeClass">@t.TypeLabel</span></td>
                                <td><code>@(string.IsNullOrWhiteSpace(t.SiteKey) ? "—" : t.SiteKey)</code></td>
                                <td>@(string.IsNullOrWhiteSpace(t.Hostname) ? "—" : t.Hostname)</td>
                                <td><code>@(string.IsNullOrWhiteSpace(t.DbName) ? "—" : t.DbName)</code></td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(t.ErpPackLabel))
                                    {
                                        <span class="label label-info">@t.ErpPackLabel</span>
                                    }
                                    else if (t.TenantType == "erp_only")
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">n/a</span>
                                    }
                                </td>
                                <td>
                                    @if (t.StatusDisplay == "disabled")
                                    {
                                        <span class="text-danger">Off</span>
                                    }
                                    else if (t.StatusDisplay == "expired")
                                    {
                                        <span class="text-warning">Expired</span>
                                    }
                                    else
                                    {
                                        @(string.IsNullOrWhiteSpace(t.Status) ? "—" : t.Status)
                                    }
                                </td>
                                <td>
                                    @if (_isAdmin && !string.IsNullOrWhiteSpace(t.SiteKey))
                                    {
                                        <form method="post" action="/cp/tenants/write" style="display:inline">
                                            <input type="hidden" name="confirmWrites" value="true" />
                                            <input type="hidden" name="returnUrl" value="/cp/tenants-app" />
                                            <input type="hidden" name="action" value="tenant_set_active" />
                                            <input type="hidden" name="site_key" value="@t.SiteKey" />
                                            <input type="hidden" name="active" value="@(t.IsActive ? "0" : "1")" />
                                            <button type="submit" class="btn btn-xs @(t.IsActive ? "btn-default" : "btn-primary")">@(t.IsActive ? "ON" : "OFF")</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@(t.IsActive ? "ON" : "OFF")</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(t.AdminEmail))
                                    {
                                        <a href="@("mailto:" + t.AdminEmail)">@t.AdminEmail</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(t.ErpLoginUrl))
                                    {
                                        <a class="small" href="@t.ErpLoginUrl" target="_blank" rel="noopener">@t.ErpLoginUrl</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (_isAdmin && !string.IsNullOrWhiteSpace(t.SiteKey))
                                    {
                                        <form method="post" action="/cp/tenants/write" style="display:inline">
                                            <input type="hidden" name="confirmWrites" value="true" />
                                            <input type="hidden" name="returnUrl" value="/cp/tenants-app" />
                                            <input type="hidden" name="action" value="reset_operator_password" />
                                            <input type="hidden" name="site_key" value="@t.SiteKey" />
                                            <button type="submit" class="btn btn-xs btn-default">Reset password</button>
                                        </form>
                                    }
                                    else if (t.HasStoredPassword)
                                    {
                                        <span class="epc-tcc-pwd-mask">••••••••</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td style="white-space:nowrap">
                                    @if (!string.IsNullOrWhiteSpace(t.StorefrontUrl))
                                    {
                                        <a class="btn btn-xs btn-default" target="_blank" rel="noopener" href="@t.StorefrontUrl">Store</a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(t.CpUrl))
                                    {
                                        <a class="btn btn-xs btn-primary" target="_blank" rel="noopener" href="@t.CpUrl">CP</a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(t.ErpLoginUrl))
                                    {
                                        <a class="btn btn-xs btn-info" target="_blank" rel="noopener" href="@t.ErpLoginUrl">ERP</a>
                                    }
                                    <a class="small" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Open</a>
                                </td>
                                <td>
                                    @if (_isAdmin && t.TenantType == "erp_only" && !t.IsDemo && !string.IsNullOrWhiteSpace(t.SiteKey))
                                    {
                                        <form method="post" action="/cp/tenants/write" style="display:flex;flex-wrap:wrap;gap:.3rem;align-items:center" onsubmit="return window.confirm('Permanently delete this ERP-only tenant and its dedicated database?');">
                                            <input type="hidden" name="confirmWrites" value="true" />
                                            <input type="hidden" name="returnUrl" value="/cp/tenants-app" />
                                            <input type="hidden" name="action" value="delete_standalone_erp" />
                                            <input type="hidden" name="site_key" value="@t.SiteKey" />
                                            <input type="text" name="confirm_site_key" required placeholder="@t.SiteKey" title="Type the site key to confirm" style="width:7.5rem" />
                                            <button type="submit" class="btn btn-xs btn-danger">Delete</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <p class="help-block">Commerce tenants stay in this list for on/off only. Complete delete is limited to ERP-only rows (no storefront) after you type the site key. Protected commerce keys cannot be removed here.</p>

    </PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>Tenant fleet control is available on the platform Super CP host only.</p>
        <p><a href="/cp">Open Control Panel</a></p>
    </div>
}

@code {
    private const string _phpTab = "/CP/control/portal/epc_tenant_control_center";
    private bool _allowed;
    private bool _isAdmin;
    private IReadOnlyList<CpTenantControlRow> _tenants = [];
    private int _registry;
    private int _accessible;
    private string _platformDb = "ecomae";
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await ControlCenter.LoadAsync(ctx.RequestAborted);
        _tenants = result.Tenants;
        _registry = result.RegistryCount;
        _accessible = result.AccessibleCount;
        _platformDb = result.PlatformDb;
        _source = result.Source;
        _message = result.Error;
    }
}
