@page "/storefront/vin-app"
@page "/en/katalog-laximo"
@page "/katalog-laximo"
@layout Layout.PhpChromeLayout
@using System.Text.Json
@using EcomAE.Platform.Api.Catalog
@using EcomAE.Platform.Presentation
@inject ICatalogOfflineCacheService OfflineCache
@inject IHttpContextAccessor Http

<PageTitle>VIN / Frame search · @_brand</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        .epc-sf-vin-form {
            display:flex; flex-wrap:wrap; gap:.45rem; align-items:center;
        }
        .epc-sf-vin-form input {
            flex:1 1 14rem; min-width:10rem; padding:.4rem .65rem; border-radius:3px;
            border:1px solid #cbd5e1; background:#fff; color:#111827;
        }
        .epc-sf-vin-form input::placeholder { color:#94a3b8; }
        .epc-sf-vin-form button {
            display:inline-flex; padding:5px 12px; border-radius:3px; border:1px solid #b91c1c;
            background:#dc2626; color:#fff; font-weight:600; font-size:12px; cursor:pointer;
        }
        .epc-sf-vin-panel {
            background:#fff; border:1px solid #e2e8f0; border-radius:2px; overflow:hidden; min-height:12rem;
        }
        .epc-sf-vin-note {
            margin-top:.85rem; padding:.7rem .85rem; background:#eff6ff; border:1px solid #bfdbfe;
            border-radius:2px; color:#1e3a8a; font-size:.84rem;
        }
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontTenantChrome>

    <PhpStorefrontPageHeader Title="VIN / Frame search"
                            Subtitle="Decode a VIN or frame number, then continue into part search.">
        <form class="epc-sf-vin-form" method="post" action="/storefront/vin/decode">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="search" name="vin" value="@_vin" maxlength="32" placeholder="VIN or Frame" aria-label="VIN or Frame" required />
            <button type="submit">Decode VIN</button>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.PartSearch">Part search</a>
            <a class="btn btn-sm btn-default" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(StorefrontPhpCanonical.ForVinSearch(_vin.Length > 0 ? "?identString=" + Uri.EscapeDataString(_vin) : null))" target="_blank" rel="noopener">Classic twin</a>
        </form>
    </PhpStorefrontPageHeader>

    @if (!string.IsNullOrWhiteSpace(_vin))
    {
        <div class="epc-sf-vin-panel" style="padding:1.1rem 1.2rem;color:#334155" aria-label="VIN decode workspace">
            <p style="margin:0 0 .65rem;font-weight:700">VIN / frame: @_vin</p>
            @if (_cacheHit || _manufacturer.Length > 0)
            {
                <p style="margin:0 0 .35rem;color:#166534;font-weight:700">@(_cacheHit ? "Cached decode" : "Live Laximo decode")</p>
                <p style="margin:0 0 .35rem">Make: @(_manufacturer.Length > 0 ? _manufacturer : "—")</p>
                <p style="margin:0 0 .85rem">Model: @(_modelLabel.Length > 0 ? _modelLabel : "—")</p>
            }
            else
            {
                <p style="margin:0 0 .65rem;color:#b45309;font-weight:700">
                    @(_liveErr.Length > 0 ? _liveErr : (_cacheCode == "invalid_vin" ? "Enter a VIN of 11–17 characters." : "Not in cache. Submit Decode VIN for live Laximo."))
                </p>
                <p style="margin:0 0 .85rem;color:#64748b;font-size:.9rem;line-height:1.45">
                    Continue to live stock, a seller request, or the vehicle catalog.
                </p>
            }
            <p>
                <a class="btn btn-sm btn-primary" href="@StorefrontSurfaceLinks.PartSearch">Part search</a>
                <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.SellerRequest">Request to seller</a>
                <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.VehicleCatalog">Vehicle catalog</a>
            </p>
        </div>
    }
    else
    {
        <div class="epc-sf-vin-panel" style="padding:1.25rem;color:#475569">
            Enter a VIN or frame number to start. Unknown articles can go to the seller request form.
        </div>
    }
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private string _vin = "";
    private bool _cacheHit;
    private string _cacheCode = "";
    private string _manufacturer = "";
    private string _modelLabel = "";
    private string _liveErr = "";

    [SupplyParameterFromQuery(Name = "identString")]
    public string? IdentString { get; set; }

    [SupplyParameterFromQuery(Name = "vin")]
    public string? VinAlias { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _vin = FirstNonEmpty(IdentString, VinAlias);
        var ctx = Http.HttpContext;
        if (ctx is not null)
        {
            _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);
            _liveErr = ctx.Request.Query["err"].ToString() ?? "";
            var make = ctx.Request.Query["make"].ToString();
            var model = ctx.Request.Query["model"].ToString();
            if (!string.IsNullOrWhiteSpace(make))
            {
                _manufacturer = make;
            }

            if (!string.IsNullOrWhiteSpace(model))
            {
                _modelLabel = model;
            }
        }

        if (string.IsNullOrWhiteSpace(_vin))
        {
            return;
        }

        var result = await OfflineCache.LookupVinAsync(_vin, "en", "WWW", ctx?.RequestAborted ?? default);
        _cacheHit = result.Ok;
        _cacheCode = result.Code ?? string.Empty;
        if (result.Ok && result.Payload is not null)
        {
            try
            {
                using var doc = JsonDocument.Parse(JsonSerializer.Serialize(result.Payload));
                var root = doc.RootElement;
                if (root.TryGetProperty("manufacturer", out var make) && make.ValueKind == JsonValueKind.String)
                {
                    _manufacturer = make.GetString() ?? string.Empty;
                }

                if (root.TryGetProperty("model_label", out var model) && model.ValueKind == JsonValueKind.String)
                {
                    _modelLabel = model.GetString() ?? string.Empty;
                }
            }
            catch (JsonException)
            {
                _cacheHit = false;
                _cacheCode = "vin_cache_invalid";
            }
        }
    }

    private static string FirstNonEmpty(params string?[] values)
    {
        foreach (var v in values)
        {
            if (!string.IsNullOrWhiteSpace(v))
            {
                return v.Trim();
            }
        }

        return "";
    }
}
