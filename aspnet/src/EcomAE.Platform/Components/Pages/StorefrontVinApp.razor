@page "/storefront/vin-app"
@page "/en/katalog-laximo"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http
@inject NavigationManager Navigation

<PageTitle>VIN / Frame search · eParts Cart</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        .epc-sf-vin-form {
            display:flex; flex-wrap:wrap; gap:.45rem; align-items:center;
        }
        .epc-sf-vin-form input {
            flex:1 1 14rem; min-width:10rem; padding:.4rem .65rem; border-radius:3px;
            border:1px solid #cbd5e1; background:#fff; color:#111827;
        }
        .epc-sf-vin-form input::placeholder { color:#94a3b8; }
        .epc-sf-vin-form button {
            display:inline-flex; padding:5px 12px; border-radius:3px; border:1px solid #b91c1c;
            background:#dc2626; color:#fff; font-weight:600; font-size:12px; cursor:pointer;
        }
        .epc-sf-vin-panel {
            background:#fff; border:1px solid #e2e8f0; border-radius:2px; overflow:hidden; min-height:12rem;
        }
        .epc-sf-vin-note {
            margin-top:.85rem; padding:.7rem .85rem; background:#eff6ff; border:1px solid #bfdbfe;
            border-radius:2px; color:#1e3a8a; font-size:.84rem;
        }
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<PhpStorefrontDesktopChrome>

    <PhpStorefrontPageHeader Title="VIN / Frame search"
                            Subtitle="Decode vehicles and open OEM unit trees. Laximo decode is temporary compare under /php-reference/*.">
        <form class="epc-sf-vin-form" @onsubmit="OnSubmit" @onsubmit:preventDefault>
            <input type="search" @bind="_vin" maxlength="32" placeholder="VIN or Frame" aria-label="VIN or Frame" required />
            <button type="submit">Decode VIN</button>
            <a class="btn btn-sm btn-default" href="@PhpResultsHref" title="Temporary PHP compare only">Compare PHP reference</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.PartSearch">Part search</a>
        </form>
    </PhpStorefrontPageHeader>

    @if (!string.IsNullOrWhiteSpace(_vin))
    {
        <div class="epc-sf-vin-panel" style="padding:1.1rem 1.2rem;color:#334155" aria-label="VIN decode workspace">
            <p style="margin:0 0 .65rem;font-weight:700">VIN / frame: <code>@_vin</code></p>
            <p style="margin:0 0 .75rem;color:#64748b;font-size:.9rem;line-height:1.45">
                Product shell is ASP.NET Core. Open Laximo only as temporary PHP reference compare.
            </p>
            <p style="margin:0">
                <a class="btn btn-sm btn-primary" href="@CompareEmbedHref">Show PHP compare</a>
                <a class="btn btn-sm btn-default" href="@PhpResultsHref">Open /php-reference</a>
            </p>
            @if (_showPhpCompare)
            {
                <iframe title="Laximo VIN results (PHP compare)" src="@PhpResultsHref" loading="lazy" referrerpolicy="same-origin"
                        style="width:100%;min-height:70vh;margin-top:.85rem;border:1px solid #e2e8f0;border-radius:2px;background:#f8fafc"></iframe>
            }
        </div>
        <p class="epc-sf-vin-note">
            Product path: <code>/storefront/vin-app</code>. PHP compare only under <code>/php-reference</code>.
        </p>
    }
    else
    {
        <div class="epc-sf-vin-panel" style="padding:1.25rem;color:#475569">
            Enter a VIN or frame number. Production UI is ASP.NET Core; PHP Laximo is opt-in compare only.
        </div>
    }
</PhpStorefrontDesktopChrome>

@code {
    private string _vin = "";
    private bool _showPhpCompare;

    [SupplyParameterFromQuery(Name = "identString")]
    public string? IdentString { get; set; }

    [SupplyParameterFromQuery(Name = "vin")]
    public string? VinAlias { get; set; }

    private string PhpResultsHref
    {
        get
        {
            var vin = string.IsNullOrWhiteSpace(_vin) ? "" : _vin.Trim();
            var baseHref = "/php-reference" + StorefrontPhpCanonical.LaximoVin;
            if (vin.Length == 0)
            {
                return baseHref;
            }

            return baseHref
                   + "?task=vehicles&ft=FindVehicle&identString="
                   + Uri.EscapeDataString(vin);
        }
    }

    private string CompareEmbedHref
    {
        get
        {
            var vin = string.IsNullOrWhiteSpace(_vin) ? "" : _vin.Trim();
            var href = StorefrontAspNetCanonical.LaximoVin + "?php=1";
            if (vin.Length > 0)
            {
                href += "&identString=" + Uri.EscapeDataString(vin);
            }

            return href;
        }
    }

    protected override void OnInitialized()
    {
        _vin = FirstNonEmpty(IdentString, VinAlias);
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var phpQ = ctx.Request.Query["php"].ToString();
        _showPhpCompare = string.Equals(phpQ, "1", StringComparison.OrdinalIgnoreCase)
                          || string.Equals(phpQ, "true", StringComparison.OrdinalIgnoreCase)
                          || phpQ.StartsWith("/php-reference", StringComparison.OrdinalIgnoreCase);
    }

    private void OnSubmit()
    {
        if (string.IsNullOrWhiteSpace(_vin))
        {
            return;
        }

        Navigation.NavigateTo(StorefrontSurfaceLinks.ForVin(_vin.Trim()), forceLoad: true);
    }

    private static string FirstNonEmpty(params string?[] values)
    {
        foreach (var v in values)
        {
            if (!string.IsNullOrWhiteSpace(v))
            {
                return v.Trim();
            }
        }

        return "";
    }
}
