@page "/storefront/vin-app"
@page "/en/katalog-laximo"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http
@inject NavigationManager Navigation

<PageTitle>VIN / Frame search · eParts Cart</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        .epc-sf-vin-hero {
            margin-bottom:1rem; padding:1.15rem 1.25rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0f172a 0%,#1e3a5f 55%,#0ea5e9 100%);
        }
        .epc-sf-vin-hero h1 { margin:.2rem 0 .35rem; font-size:clamp(1.35rem,3vw,1.9rem); }
        .epc-sf-vin-hero p { margin:0; color:#bae6fd; max-width:42rem; font-size:.92rem; line-height:1.45; }
        .epc-sf-vin-form {
            display:flex; flex-wrap:wrap; gap:.55rem; margin-top:.9rem; align-items:center;
        }
        .epc-sf-vin-form input {
            flex:1 1 16rem; min-width:12rem; padding:.55rem .75rem; border-radius:.4rem;
            border:1px solid rgba(255,255,255,.35); background:rgba(15,23,42,.35); color:#fff;
        }
        .epc-sf-vin-form input::placeholder { color:#94a3b8; }
        .epc-sf-vin-form button, .epc-sf-vin-form a.btn {
            display:inline-flex; padding:.55rem .95rem; border-radius:.4rem; border:0;
            background:#0284c7; color:#fff; font-weight:700; font-size:.86rem; text-decoration:none; cursor:pointer;
        }
        .epc-sf-vin-form a.ghost {
            background:transparent; border:1px solid rgba(255,255,255,.35);
        }
        .epc-sf-vin-panel {
            background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:hidden; min-height:12rem;
        }
        .epc-sf-vin-panel iframe { width:100%; min-height:70vh; border:0; display:block; background:#f8fafc; }
        .epc-sf-vin-note {
            margin-top:.85rem; padding:.7rem .85rem; background:#eff6ff; border:1px solid #bfdbfe;
            border-radius:.45rem; color:#1e3a8a; font-size:.84rem;
        }
    
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<PhpStorefrontDesktopChrome>

    <section class="epc-sf-vin-hero">
        <img src="@LegacyPresentationAssets.EpartsCartMarkUrl" alt="eparts" style="height:28px;filter:brightness(1.15)" />
        <h1>VIN / Frame search</h1>
        <p>ASP.NET Core product shell. Decode stays here; Laximo PHP is temporary compare under <code>/php-reference/*</code> only.</p>
        <form class="epc-sf-vin-form" @onsubmit="OnSubmit" @onsubmit:preventDefault>
            <input type="search" @bind="_vin" maxlength="32" placeholder="VIN or Frame" aria-label="VIN or Frame" required />
            <button type="submit">Decode VIN</button>
            <a class="btn ghost" href="@PhpResultsHref" title="Temporary PHP compare only">Compare PHP reference</a>
            <a class="btn ghost" href="@StorefrontSurfaceLinks.PartSearch">Part search</a>
        </form>
    </section>

    @if (!string.IsNullOrWhiteSpace(_vin))
    {
        <div class="epc-sf-vin-panel" style="padding:1.15rem 1.25rem;color:#334155" aria-label="VIN decode workspace">
            <p style="margin:0 0 .65rem;font-weight:700">VIN / frame: <code>@_vin</code></p>
            <p style="margin:0 0 .75rem;color:#64748b;font-size:.9rem;line-height:1.45">
                Product results stay on ASP.NET Core. The classic Laximo tree is not the default production body —
                open it only as temporary PHP reference compare (<code>?php=1</code> embeds the compare iframe).
            </p>
            <p style="margin:0">
                <a href="@CompareEmbedHref" style="display:inline-flex;padding:.5rem .85rem;border-radius:.4rem;background:#0284c7;color:#fff;font-weight:700;text-decoration:none;margin-right:.35rem">Show PHP compare</a>
                <a href="@PhpResultsHref" style="display:inline-flex;padding:.5rem .85rem;border-radius:.4rem;border:1px solid #d1d5db;color:#111;font-weight:700;text-decoration:none">Open /php-reference</a>
            </p>
            @if (_showPhpCompare)
            {
                <iframe title="Laximo VIN results (PHP compare)" src="@PhpResultsHref" loading="lazy" referrerpolicy="same-origin"
                        style="width:100%;min-height:70vh;margin-top:.85rem;border:1px solid #e2e8f0;border-radius:.45rem;background:#f8fafc"></iframe>
            }
        </div>
        <p class="epc-sf-vin-note">
            Product path: <code>/storefront/vin-app</code>. PHP compare only:
            <code>@StorefrontPhpCanonical.LaximoVin</code> under <code>/php-reference</code>.
        </p>
    }
    else
    {
        <div class="epc-sf-vin-panel" style="padding:1.25rem;color:#475569">
            Enter a VIN or frame number. Production UI is ASP.NET Core; PHP Laximo is opt-in compare only.
        </div>
    }
</PhpStorefrontDesktopChrome>

@code {
    private string _vin = "";
    private bool _showPhpCompare;

    [SupplyParameterFromQuery(Name = "identString")]
    public string? IdentString { get; set; }

    [SupplyParameterFromQuery(Name = "vin")]
    public string? VinAlias { get; set; }

    /// <summary>PHP reference decode tree only — never a product /en path.</summary>
    private string PhpResultsHref
    {
        get
        {
            var vin = string.IsNullOrWhiteSpace(_vin) ? "" : _vin.Trim();
            var baseHref = "/php-reference" + StorefrontPhpCanonical.LaximoVin;
            if (vin.Length == 0)
            {
                return baseHref;
            }

            return baseHref
                   + "?task=vehicles&ft=FindVehicle&identString="
                   + Uri.EscapeDataString(vin);
        }
    }

    private string CompareEmbedHref
    {
        get
        {
            var vin = string.IsNullOrWhiteSpace(_vin) ? "" : _vin.Trim();
            var href = StorefrontAspNetCanonical.LaximoVin + "?php=1";
            if (vin.Length > 0)
            {
                href += "&identString=" + Uri.EscapeDataString(vin);
            }

            return href;
        }
    }

    protected override void OnInitialized()
    {
        _vin = FirstNonEmpty(IdentString, VinAlias);
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var phpQ = ctx.Request.Query["php"].ToString();
        _showPhpCompare = string.Equals(phpQ, "1", StringComparison.OrdinalIgnoreCase)
                          || string.Equals(phpQ, "true", StringComparison.OrdinalIgnoreCase)
                          || phpQ.StartsWith("/php-reference", StringComparison.OrdinalIgnoreCase);
    }

    private void OnSubmit()
    {
        if (string.IsNullOrWhiteSpace(_vin))
        {
            return;
        }

        Navigation.NavigateTo(StorefrontSurfaceLinks.ForVin(_vin.Trim()), forceLoad: true);
    }

    private static string FirstNonEmpty(params string?[] values)
    {
        foreach (var v in values)
        {
            if (!string.IsNullOrWhiteSpace(v))
            {
                return v.Trim();
            }
        }

        return "";
    }
}
