@page "/en/users/profile"
@page "/users/profile"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject IHttpContextAccessor Http
@inject EcomAE.Platform.Data.ITenantDbConnectionFactory Connections
@inject Microsoft.Extensions.Options.IOptions<EcomAE.Platform.Configuration.PhpReferenceOptions> PhpReference
@*
  PHP twin: content/users/profileform.php. The currency change form posts back here (StorefrontProfilePostMiddleware).
*@

<PageTitle>My data · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" />

<StorefrontTenantChrome>
    <section style="padding:2rem 0 3rem">
        <div class="container">
            <script src="/lib/jQuery/jQuery.js"></script>
            @((MarkupString)_html)
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private string _html = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);
        var alert = ctx.Items[StorefrontProfileForm.AlertItemKey] as string ?? string.Empty;
        var config = ctx.RequestServices.GetService<EcomAE.Platform.Cp.ICpPlatformMailer>()?.ReadConfig()
            ?? EcomAE.Platform.Cp.PriceImport.CpPhpConfig.Read(PhpReference.Value);
        var tenant = ctx.Items[EcomAE.Platform.Middleware.TenantResolutionMiddleware.HttpContextItemKey] as EcomAE.Platform.Services.TenantContext;
        var request = new StorefrontProfileForm.Request(
            ctx.Request.Cookies["session"],
            ctx.Request.Cookies["u_id"],
            StorefrontPhpHomeLinks.LangHref(ctx),
            config);

        try
        {
            await using var connection = await Connections.OpenForTenantAsync(tenant, ctx.RequestAborted);
            var translator = new StorefrontPhpTranslator(connection, request.LangHref.TrimStart('/'));
            _html = alert + await StorefrontProfileForm.RenderAsync(connection, request, key => translator.TextAsync(key, ctx.RequestAborted), ctx.RequestAborted);
        }
        catch (System.Data.Common.DbException)
        {
            _html = "<p>Your profile is unavailable right now.</p>";
        }
        catch (InvalidOperationException)
        {
            _html = "<p>Your profile is unavailable right now.</p>";
        }
    }
}
