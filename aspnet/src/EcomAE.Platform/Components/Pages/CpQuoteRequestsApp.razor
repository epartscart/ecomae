@page "/cp/quote-requests-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ICpQuoteRequestEditorService Quotes
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Quote requests · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div>
    }

    @if (!_isAdmin)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Quote requests</div>
                <div class="panel-body">Sign in with a staff CP session to manage quote requests. <a href="/cp/login?returnUrl=/cp/quote-requests-app">Log in</a></div>
            </div>
        </div>
    }
    else if (_openedId > 0)
    {
        @if (_detail is null)
        {
            <div class="col-lg-12">
                <div class="alert alert-warning">Quote not found, or it is not linked to a registered customer.</div>
                <p><a href="@_listHref">Back to list</a></p>
            </div>
        }
        else
        {
            var q = _detail;
            var c = q.Customer;
            var qid = q.Id.ToString(CultureInfo.InvariantCulture);
            var returnHere = ErpRecordOpen.Href(_listHref, "quote_id", q.Id);
            <div class="col-lg-12">
                <div class="hpanel">
                    <div class="panel-heading hbuilt">
                        Quote #@qid — @(c.Label.Length > 0 ? c.Label : "Customer #" + c.UserId.ToString(CultureInfo.InvariantCulture))
                        <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab + "?quote_id=" + qid)">Classic twin</a>
                    </div>
                    <div class="panel-body">
                        <p><a href="@_listHref">Back to list</a></p>

                        <div class="well" style="margin-bottom:20px;">
                            <h4 style="margin-top:0;">Customer details</h4>
                            <p class="text-muted" style="margin-bottom:12px;">Quotes are available only for logged-in / registered customers.</p>
                            <table class="table table-condensed" style="margin-bottom:0; max-width:720px;">
                                <tbody>
                                    <tr>
                                        <th style="width:160px;">Customer ID</th>
                                        <td>@c.UserId.ToString(CultureInfo.InvariantCulture)
                                            @if (c.ProfileHref.Length > 0)
                                            {
                                                <text>&nbsp;</text><a href="@c.ProfileHref" target="_blank">Open profile</a>
                                            }
                                        </td>
                                    </tr>
                                    <tr><th>Name</th><td>@(c.Name.Length > 0 ? c.Name : "—")</td></tr>
                                    @if (c.Company.Length > 0)
                                    {
                                        <tr><th>Company</th><td>@c.Company</td></tr>
                                    }
                                    <tr><th>Email</th><td>@if (c.Email.Length > 0) { <a href="mailto:@c.Email">@c.Email</a> } else { <text>—</text> }</td></tr>
                                    <tr><th>Phone</th><td>@if (c.Phone.Length > 0) { <a href="tel:@(c.Phone.Replace(" ", ""))">@c.Phone</a> } else { <text>—</text> }</td></tr>
                                    <tr><th>Status</th><td>@q.Status</td></tr>
                                    <tr><th>Created</th><td>@CpQuoteRequestEditorService.FormatTime(q.TimeCreated)</td></tr>
                                    <tr><th>Updated</th><td>@CpQuoteRequestEditorService.FormatTime(q.TimeUpdated)</td></tr>
                                    @if (q.TimeSubmitted > 0)
                                    {
                                        <tr><th>Submitted</th><td>@CpQuoteRequestEditorService.FormatTime(q.TimeSubmitted)</td></tr>
                                    }
                                    @if (q.AcceptedOrderId > 0)
                                    {
                                        <tr><th>Accepted order</th><td><a href="/cp/orders-app?order_id=@q.AcceptedOrderId.ToString(CultureInfo.InvariantCulture)">#@q.AcceptedOrderId.ToString(CultureInfo.InvariantCulture)</a></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <form method="post" action="/cp/quote-requests/save-lines" id="epc-quote-form" onsubmit="return epcQuoteSerialize();">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@returnHere" />
                            <input type="hidden" name="action" value="save_quote" />
                            <input type="hidden" name="quote_id" value="@qid" />
                            <input type="hidden" name="linesJson" id="epc-quote-lines-json" value="" />

                            <div class="form-group">
                                <label>Customer note</label>
                                <div class="well well-sm" style="white-space:pre-line">@(q.CustomerNote.Length > 0 ? q.CustomerNote : "—")</div>
                            </div>
                            <div class="form-group">
                                <label>Staff note (visible to customer on detail page)</label>
                                <textarea class="form-control" name="admin_note" rows="3">@q.AdminNote</textarea>
                            </div>

                            <p class="text-muted">
                                Customer requested part A — if you stock B instead, use <strong>Amend / alternative</strong> (cross/OEM dropdown + supplier warehouse)
                                to set brand, article, qty, and price. The customer will see both the request and your offer.
                            </p>

                            <table class="table table-bordered table-condensed" id="epc-quote-lines-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Customer request</th>
                                        <th>Qty</th>
                                        <th>Quoted price (@q.CurrencySign)</th>
                                        <th>Lead time (days)</th>
                                        <th>Line note</th>
                                        <th>Alternative</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (q.Lines.Count == 0)
                                    {
                                        <tr><td colspan="7" class="text-muted">No lines on this quote yet.</td></tr>
                                    }
                                    @foreach (var ln in q.Lines)
                                    {
                                        var lid = ln.Id.ToString(CultureInfo.InvariantCulture);
                                        <tr data-line-id="@lid" class="epc-quote-line">
                                            <td>@lid</td>
                                            <td>
                                                <div><strong>@ln.RequestedLabel</strong></div>
                                                <div class="text-muted" style="font-size:12px;">Requested brand/article (window 1)</div>
                                            </td>
                                            <td>@ln.CountNeed.ToString(CultureInfo.InvariantCulture)</td>
                                            <td><input class="form-control epc-quote-main-price" type="text" data-field="quoted_price" value="@(ln.QuotedPrice?.ToString("0.##", CultureInfo.InvariantCulture) ?? "")" readonly="@ln.OfferAlternative" /></td>
                                            <td><input class="form-control epc-quote-lead" type="text" data-field="quoted_time_to_exe" value="@(ln.QuotedTimeToExe?.ToString(CultureInfo.InvariantCulture) ?? "")" /></td>
                                            <td><input class="form-control" type="text" data-field="line_admin_note" value="@ln.LineAdminNote" /></td>
                                            <td style="min-width:200px;">
                                                <input type="hidden" data-field="offer_alternative" class="epc-alt-flag" value="@(ln.OfferAlternative ? "1" : "0")" />
                                                <input type="hidden" data-field="alt_manufacturer" class="epc-alt-mfr" value="@ln.AltManufacturer" />
                                                <input type="hidden" data-field="alt_article" class="epc-alt-art" value="@ln.AltArticle" />
                                                <input type="hidden" data-field="alt_name" class="epc-alt-name" value="@ln.AltName" />
                                                <input type="hidden" data-field="alt_count_need" class="epc-alt-qty" value="@(ln.AltCountNeed?.ToString(CultureInfo.InvariantCulture) ?? "")" />
                                                <input type="hidden" data-field="alt_quoted_price" class="epc-alt-price" value="@(ln.AltQuotedPrice?.ToString("0.##", CultureInfo.InvariantCulture) ?? "")" />
                                                <input type="hidden" data-field="alt_storage_id" class="epc-alt-storage-id" value="@(ln.AltStorageId > 0 ? ln.AltStorageId.ToString(CultureInfo.InvariantCulture) : "")" />
                                                <input type="hidden" class="epc-alt-storage-label" value="@ln.AltStorageLabel" />
                                                <div class="epc-alt-summary" style="margin-bottom:6px;@(ln.OfferAlternative ? "" : "display:none;")">
                                                    <span class="label label-warning">Alternative</span>
                                                    <span class="epc-alt-summary-text">@ln.AltSummary</span>
                                                </div>
                                                <button type="button" class="btn btn-xs btn-default epc-open-alt-modal"
                                                        data-line-id="@lid" data-quote-id="@qid"
                                                        data-req-label="@ln.RequestedLabel" data-req-brand="@ln.RequestedManufacturer"
                                                        data-req-article="@ln.RequestedArticle" data-req-qty="@ln.CountNeed.ToString(CultureInfo.InvariantCulture)">
                                                    @(ln.OfferAlternative ? "Edit alternative" : "Amend / alternative")
                                                </button>
                                                <button type="button" class="btn btn-xs btn-link epc-clear-alt" style="@(ln.OfferAlternative ? "" : "display:none;")">Clear</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <button type="submit" class="btn btn-primary">Save</button>
                        </form>
                        <form method="post" action="/cp/quote-requests/note" class="form-inline" style="margin-top:10px;">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@returnHere" />
                            <input type="hidden" name="quote_id" value="@qid" />
                            <input type="text" class="form-control" name="admin_note" maxlength="4000" placeholder="Quick staff note (saves note only, lines untouched)" style="min-width:320px;" value="@q.AdminNote" />
                            <button type="submit" class="btn btn-default">Save note only</button>
                        </form>

                        <div class="modal fade" id="epcAltOfferModal" tabindex="-1" role="dialog" aria-labelledby="epcAltOfferModalLabel">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                        <h4 class="modal-title" id="epcAltOfferModalLabel">Offer alternative (window 2)</h4>
                                    </div>
                                    <div class="modal-body">
                                        <p class="text-muted" style="margin-bottom:12px;">
                                            Customer requested: <strong id="epcAltReqLabel"></strong>
                                            (qty <span id="epcAltReqQty"></span>). Choose a cross / OEM alternative and the supplier warehouse for ordering.
                                        </p>
                                        <input type="hidden" id="epcAltLineId" value="" />
                                        <input type="hidden" id="epcAltQuoteId" value="@qid" />
                                        <div id="epcAltOptionsStatus" class="text-muted" style="margin-bottom:10px;display:none;"></div>
                                        <div class="form-group">
                                            <label for="epcAltPartSelect">Alternative part <span class="text-muted">(cross / article / OEM)</span></label>
                                            <select class="form-control" id="epcAltPartSelect"><option value="">Loading alternatives…</option></select>
                                        </div>
                                        <div id="epcAltManualFields" style="display:none;">
                                            <div class="form-group"><label>Alternative brand</label><input type="text" class="form-control" id="epcAltBrand" placeholder="e.g. TOYOTA" /></div>
                                            <div class="form-group"><label>Alternative article</label><input type="text" class="form-control" id="epcAltArticle" placeholder="e.g. 31250-05021" /></div>
                                        </div>
                                        <div class="form-group"><label>Name / description (optional)</label><input type="text" class="form-control" id="epcAltName" placeholder="Part description" /></div>
                                        <div class="form-group">
                                            <label for="epcAltWarehouseSelect">Supplier warehouse <span class="text-muted">(for LPO / order process)</span></label>
                                            <select class="form-control" id="epcAltWarehouseSelect"><option value="">Select warehouse…</option></select>
                                            <p class="help-block" style="margin-bottom:0;font-size:12px;">Warehouses with stock for the selected part are listed first; you can still pick any active warehouse.</p>
                                        </div>
                                        <div class="row">
                                            <div class="col-sm-6"><div class="form-group"><label>Qty</label><input type="number" min="1" class="form-control" id="epcAltQty" value="1" /></div></div>
                                            <div class="col-sm-6"><div class="form-group"><label>Price (@q.CurrencySign)</label><input type="text" class="form-control" id="epcAltPrice" placeholder="0.00" /></div></div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                                        <button type="button" class="btn btn-primary" id="epcAltApplyBtn">Apply alternative</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (q.Status is "submitted" or "quoted")
                        {
                            <form method="post" action="/cp/quote-requests/send" style="margin-top:15px;" onsubmit="return confirm('Publish this quote? Customer will be able to accept and add lines to cart.');">
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="returnUrl" value="@returnHere" />
                                <input type="hidden" name="action" value="send_quote" />
                                <input type="hidden" name="quote_id" value="@qid" />
                                <button type="submit" class="btn btn-success">Publish quote to customer</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
            <script>
            (function () {
                var altUrl = '/cp/quote-requests/alt-options';
                var options = [];
                var warehousesAll = [];
                function $(id) { return document.getElementById(id); }
                function rowOf(lineId) { return document.querySelector('tr.epc-quote-line[data-line-id="' + lineId + '"]'); }
                function field(row, name) { return row.querySelector('[data-field="' + name + '"]'); }
                window.epcQuoteSerialize = function () {
                    var lines = [];
                    document.querySelectorAll('tr.epc-quote-line').forEach(function (row) {
                        var o = { id: parseInt(row.getAttribute('data-line-id'), 10) };
                        row.querySelectorAll('[data-field]').forEach(function (i) { o[i.getAttribute('data-field')] = i.value; });
                        lines.push(o);
                    });
                    $('epc-quote-lines-json').value = JSON.stringify(lines);
                    return true;
                };
                function fillWarehouses(opt) {
                    var sel = $('epcAltWarehouseSelect');
                    sel.innerHTML = '';
                    var first = document.createElement('option'); first.value = ''; first.textContent = 'Select warehouse…'; sel.appendChild(first);
                    var seen = {};
                    (opt && opt.warehouses ? opt.warehouses : []).forEach(function (w) {
                        seen[w.storageId] = true;
                        var o = document.createElement('option');
                        o.value = w.storageId;
                        o.textContent = w.label + (w.qty > 0 ? ' — qty ' + w.qty : '') + (w.price > 0 ? ' @@ ' + w.price : '') + (w.delivery ? ' · ' + w.delivery + 'd' : '');
                        o.setAttribute('data-price', w.price || '');
                        sel.appendChild(o);
                    });
                    warehousesAll.forEach(function (w) {
                        if (seen[w.storageId]) { return; }
                        var o = document.createElement('option'); o.value = w.storageId; o.textContent = w.label; sel.appendChild(o);
                    });
                }
                function onPartChange() {
                    var sel = $('epcAltPartSelect');
                    var v = sel.value;
                    $('epcAltManualFields').style.display = v === '__manual' ? '' : 'none';
                    var opt = null;
                    options.forEach(function (o) { if (o.key === v) { opt = o; } });
                    if (opt) { $('epcAltBrand').value = opt.brand; $('epcAltArticle').value = opt.articleShow; if (!$('epcAltName').value) { $('epcAltName').value = opt.name || ''; } }
                    fillWarehouses(opt);
                }
                function onWarehouseChange() {
                    var sel = $('epcAltWarehouseSelect');
                    var o = sel.options[sel.selectedIndex];
                    var p = o ? o.getAttribute('data-price') : '';
                    if (p && !$('epcAltPrice').value) { $('epcAltPrice').value = p; }
                }
                function loadOptions(quoteId, lineId) {
                    var status = $('epcAltOptionsStatus');
                    status.style.display = ''; status.textContent = 'Loading alternatives…';
                    var sel = $('epcAltPartSelect'); sel.innerHTML = '<option value="">Loading alternatives…</option>';
                    fetch(altUrl + '?quote_id=' + quoteId + '&line_id=' + lineId, { credentials: 'same-origin' })
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            options = data.alternatives || [];
                            warehousesAll = data.warehousesAll || [];
                            sel.innerHTML = '';
                            options.forEach(function (o) {
                                var e = document.createElement('option');
                                e.value = o.key;
                                e.textContent = o.brand + ' ' + o.articleShow + (o.name ? ' — ' + o.name : '') + ' [' + o.source + (o.inStock ? ', in stock' : '') + ']';
                                sel.appendChild(e);
                            });
                            var m = document.createElement('option'); m.value = '__manual'; m.textContent = 'Other (enter brand + article manually)'; sel.appendChild(m);
                            status.textContent = options.length + ' option(s), ' + warehousesAll.length + ' warehouse(s)';
                            var row = rowOf(lineId);
                            var curBrand = field(row, 'alt_manufacturer').value, curArt = field(row, 'alt_article').value;
                            var matched = false;
                            options.forEach(function (o) { if (curBrand && o.brand === curBrand.toUpperCase() && o.articleShow.replace(/[^a-zA-Z0-9]/g, '').toUpperCase() === curArt.replace(/[^a-zA-Z0-9]/g, '').toUpperCase()) { sel.value = o.key; matched = true; } });
                            if (!matched && curBrand) { sel.value = '__manual'; }
                            onPartChange();
                            if (!matched && curBrand) { $('epcAltBrand').value = curBrand; $('epcAltArticle').value = curArt; }
                            var curWh = field(row, 'alt_storage_id').value;
                            if (curWh) { $('epcAltWarehouseSelect').value = curWh; }
                        })
                        .catch(function () { status.textContent = 'Could not load alternatives; enter brand + article manually.'; sel.innerHTML = '<option value="__manual">Other (enter brand + article manually)</option>'; onPartChange(); });
                }
                document.querySelectorAll('.epc-open-alt-modal').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var lineId = btn.getAttribute('data-line-id');
                        var row = rowOf(lineId);
                        $('epcAltLineId').value = lineId;
                        $('epcAltReqLabel').textContent = btn.getAttribute('data-req-label');
                        $('epcAltReqQty').textContent = btn.getAttribute('data-req-qty');
                        $('epcAltName').value = field(row, 'alt_name').value;
                        $('epcAltQty').value = field(row, 'alt_count_need').value || btn.getAttribute('data-req-qty') || '1';
                        $('epcAltPrice').value = field(row, 'alt_quoted_price').value;
                        loadOptions(btn.getAttribute('data-quote-id'), lineId);
                        if (window.jQuery && jQuery.fn.modal) { jQuery('#epcAltOfferModal').modal('show'); } else { $('epcAltOfferModal').style.display = 'block'; $('epcAltOfferModal').classList.add('in'); }
                    });
                });
                function hideModal() { if (window.jQuery && jQuery.fn.modal) { jQuery('#epcAltOfferModal').modal('hide'); } else { $('epcAltOfferModal').style.display = 'none'; $('epcAltOfferModal').classList.remove('in'); } }
                document.querySelectorAll('#epcAltOfferModal [data-dismiss="modal"]').forEach(function (b) { b.addEventListener('click', hideModal); });
                $('epcAltPartSelect').addEventListener('change', onPartChange);
                $('epcAltWarehouseSelect').addEventListener('change', onWarehouseChange);
                $('epcAltApplyBtn').addEventListener('click', function () {
                    var row = rowOf($('epcAltLineId').value);
                    var brand = $('epcAltBrand').value.trim(), art = $('epcAltArticle').value.trim();
                    var wh = $('epcAltWarehouseSelect').value, price = $('epcAltPrice').value.trim(), qty = $('epcAltQty').value.trim();
                    if (!brand || !art) { alert('Alternative needs brand and article'); return; }
                    if (!wh) { alert('Select a supplier warehouse'); return; }
                    if (!price || isNaN(parseFloat(price.replace(',', '.'))) || parseFloat(price.replace(',', '.')) <= 0) { alert('Alternative needs a positive price'); return; }
                    field(row, 'offer_alternative').value = '1';
                    field(row, 'alt_manufacturer').value = brand.toUpperCase();
                    field(row, 'alt_article').value = art;
                    field(row, 'alt_name').value = $('epcAltName').value.trim();
                    field(row, 'alt_count_need').value = qty || '1';
                    field(row, 'alt_quoted_price').value = price;
                    field(row, 'alt_storage_id').value = wh;
                    var whLabel = $('epcAltWarehouseSelect').options[$('epcAltWarehouseSelect').selectedIndex].textContent;
                    row.querySelector('.epc-alt-storage-label').value = whLabel;
                    row.querySelector('.epc-alt-summary-text').textContent = brand.toUpperCase() + ' ' + art + ' × ' + (qty || '1') + ' @@ ' + price + ' · ' + whLabel;
                    row.querySelector('.epc-alt-summary').style.display = '';
                    row.querySelector('.epc-clear-alt').style.display = '';
                    row.querySelector('.epc-open-alt-modal').textContent = 'Edit alternative';
                    var main = field(row, 'quoted_price'); main.value = price; main.setAttribute('readonly', 'readonly');
                    hideModal();
                });
                document.querySelectorAll('.epc-clear-alt').forEach(function (b) {
                    b.addEventListener('click', function () {
                        var row = b.closest('tr');
                        ['alt_manufacturer', 'alt_article', 'alt_name', 'alt_count_need', 'alt_quoted_price', 'alt_storage_id'].forEach(function (f) { field(row, f).value = ''; });
                        field(row, 'offer_alternative').value = '0';
                        row.querySelector('.epc-alt-summary').style.display = 'none';
                        b.style.display = 'none';
                        row.querySelector('.epc-open-alt-modal').textContent = 'Amend / alternative';
                        field(row, 'quoted_price').removeAttribute('readonly');
                    });
                });
            })();
            </script>
        }
    }
    else
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Quote requests
                    <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
                </div>
                <div class="panel-body">
                    <p class="text-muted">Quotes are for registered (login / register) customers only. Customer name, email, and phone are shown below.</p>
                    <form method="get" class="form-inline" action="@_listHref">
                        <label>Status</label>
                        <select name="status" class="form-control" onchange="this.form.submit()">
                            <option value="">All</option>
                            @foreach (var s in CpQuoteRequestEditorService.Statuses)
                            {
                                <option value="@s" selected="@(s == _status)">@s</option>
                            }
                        </select>
                    </form>

                    <table class="table table-striped table-epc" style="margin-top:15px;">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Customer</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th>Updated</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_rows.Count == 0)
                            {
                                <tr><td colspan="7" class="text-muted">No quote requests for registered customers.</td></tr>
                            }
                            @foreach (var r in _rows)
                            {
                                var c = r.Customer;
                                var nameCell = (c.Name.Length > 0 ? c.Name : "Customer #" + c.UserId.ToString(CultureInfo.InvariantCulture)) + (c.Company.Length > 0 ? " (" + c.Company + ")" : "");
                                var href = ErpRecordOpen.Href(_listHref, "quote_id", r.Id);
                                <tr>
                                    <td>@r.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>
                                        <a href="@href">@nameCell</a>
                                        <div class="text-muted" style="font-size:12px;">ID @c.UserId.ToString(CultureInfo.InvariantCulture)
                                            @if (c.ProfileHref.Length > 0)
                                            {
                                                <text> · </text><a href="@c.ProfileHref" target="_blank">profile</a>
                                            }
                                        </div>
                                    </td>
                                    <td>@(c.Email.Length > 0 ? c.Email : "—")</td>
                                    <td>@(c.Phone.Length > 0 ? c.Phone : "—")</td>
                                    <td>@r.Status</td>
                                    <td>@(r.TimeUpdated > 0 ? CpQuoteRequestEditorService.FormatTime(r.TimeUpdated) : "")</td>
                                    <td><a href="@href">Open</a></td>
                                </tr>
                            }
                        </tbody>
