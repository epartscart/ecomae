@code {
    private const string _phpTab = "/CP/shop/quote-requests";
    private const string _listHref = "/cp/quote-requests-app";
    private bool _isAdmin;
    private long _openedId;
    private string _status = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private IReadOnlyList<CpQuoteListRow> _rows = [];
    private CpQuoteDetail? _detail;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "quote_id", "id");
        _status = ctx.Request.Query["status"].ToString();
        if (!CpQuoteRequestEditorService.Statuses.Contains(_status, StringComparer.Ordinal))
        {
            _status = "";
        }

        _flashOk = ctx.Request.Query["ok"].ToString();
        _flashErr = ctx.Request.Query["err"].ToString();
        if (_flashOk.Length == 0)
        {
            _flashOk = ctx.Request.Query["success_message"].ToString();
        }

        if (_flashErr.Length == 0)
        {
            _flashErr = ctx.Request.Query["error_message"].ToString();
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        if (_openedId > 0)
        {
            _detail = await Quotes.OpenAsync(_openedId, ctx.RequestAborted);
            return;
        }

        _rows = await Quotes.ListAsync(_status, ctx.RequestAborted);
    }
}
