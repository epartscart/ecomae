@page "/cp/quote-requests-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Quote requests · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Quote requests
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/quote-requests-app")</p>
                <p>Save a note, send a quote, or save quote lines here. Open a row to see notes and lines.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/quote-requests-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedDetail is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Quote request KPIs">
        <div class="kpi"><div class="lbl">Quotes</div><div class="val">@_summary.QuoteCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Draft</div><div class="val">@_summary.DraftCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Submitted</div><div class="val">@_summary.SubmittedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Quoted</div><div class="val">@_summary.QuotedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Accepted</div><div class="val">@_summary.AcceptedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Items</div><div class="val">@_summary.ItemCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <form method="post" action="/cp/quote-requests/note" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Quote id <input type="number" name="quoteId" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
            <label>Staff note <input type="text" name="adminNote" maxlength="4000" style="width:18rem" /></label>
            <button type="submit">Save note</button>
        </form>
        <form method="post" action="/cp/quote-requests/send" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Quote id <input type="number" name="quoteId" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
            <button type="submit">Send quote</button>
        </form>
        <form id="erp-module-new" method="post" action="/cp/quote-requests/save-lines" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Quote id <input type="number" name="quoteId" min="1" required style="width:6rem" value="@OpenedIdValue" /></label>
            <label>Line id <input type="number" name="lineId" min="1" required style="width:6rem" /></label>
            <label>Price <input type="text" name="quotedPrice" /></label>
            <label>Days <input type="number" name="quotedTimeToExe" min="0" /></label>
            <label>Line note <input type="text" name="lineAdminNote" maxlength="4000" /></label>
            <button type="submit">Save line</button>
        </form>
    }

    @if (_openedDetail is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Quote #@_openedDetail.Id.ToString(CultureInfo.InvariantCulture)
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedDetail.Status) ? _openedDetail.Status : "—")</span>
                </div>
                <div class="panel-body">
                    <p>Customer id <strong>@_openedDetail.UserId.ToString(CultureInfo.InvariantCulture)</strong>
                        @if (_openedDetail.AcceptedOrderId > 0)
                        {
                            <span> · accepted order #@_openedDetail.AcceptedOrderId.ToString(CultureInfo.InvariantCulture)</span>
                        }
                    </p>
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.CustomerNote))
                    {
                        <p class="text-muted">@_openedDetail.CustomerNote</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.AdminNote))
                    {
                        <p>@_openedDetail.AdminNote</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Lines</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th class="text-right">Qty</th>
                                    <th class="text-right">Price</th>
                                    <th class="text-right">Days</th>
                                    <th>Alternative</th>
                                    <th>Note</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedLines.Count == 0)
                                {
                                    <tr><td colspan="6">No lines yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var line in _openedLines)
                                    {
                                        var alt = line.OfferAlternative == 0
                                            ? "—"
                                            : string.Join(" ", new[] { line.AltManufacturer, line.AltArticle, line.AltName }.Where(s => !string.IsNullOrWhiteSpace(s)));
                                        <tr>
                                            <td>@line.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td class="text-right">@line.CountNeed.ToString(CultureInfo.InvariantCulture)</td>
                                            <td class="text-right">@line.QuotedPrice.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                            <td class="text-right">@line.QuotedTimeToExe.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@alt</td>
                                            <td>@(!string.IsNullOrWhiteSpace(line.LineAdminNote) ? line.LineAdminNote : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_summary.QuoteCount.ToString(CultureInfo.InvariantCulture) Quotes · @_summary.DraftCount.ToString(CultureInfo.InvariantCulture) Draft · @_summary.SubmittedCount.ToString(CultureInfo.InvariantCulture) Submitted · @_summary.QuotedCount.ToString(CultureInfo.InvariantCulture) Quoted · @_summary.AcceptedCount.ToString(CultureInfo.InvariantCulture) Accepted · @_summary.ItemCount.ToString(CultureInfo.InvariantCulture) Items.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>User</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Submitted</th>
                                <th>Order</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_rows.Count == 0)
                            {
                                <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
                            }
                            else
                            {
                                @foreach (var row in _rows)
                                {
                                    <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                        <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@row.UserId.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                                        <td>@row.TimeCreated.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@row.TimeSubmitted.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@row.AcceptedOrderId.ToString(CultureInfo.InvariantCulture)</td>
                                        <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "quote_id", row.Id)">Open</a></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/quote-requests";
    private const string _listHref = "/cp/quote-requests-app";
    private bool _isAdmin;
    private CpQuoteRequestsSummary _summary = new(0, 0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpQuoteRequestsRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private CpQuoteRequestDetail? _openedDetail;
    private IReadOnlyList<CpQuoteRequestLineDigest> _openedLines = [];
    private string _returnHref = _listHref;

    private string OpenedCaption => _openedDetail is null
        ? ""
        : ("Quote #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)
            + " · " + (string.IsNullOrWhiteSpace(_openedDetail.Status) ? "open" : _openedDetail.Status));

    private string OpenedIdValue => _openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "quote_id");
        _returnHref = _openedId > 0
            ? ErpRecordOpen.Href(_listHref, "quote_id", _openedId).Split('#')[0]
            : _listHref;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpQuoteRequestsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Quotes;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpQuoteRequestDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Quote;
            _openedLines = detail.Lines;
            if (_openedDetail is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
