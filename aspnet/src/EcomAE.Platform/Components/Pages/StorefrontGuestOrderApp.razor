@page "/storefront/guest-order-app"
@page "/en/shop/orders/guest"
@page "/shop/orders/guest"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>Track order · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" />

<StorefrontTenantChrome>
    <section style="padding:2rem 0 3rem">
        <div class="container" style="max-width:40rem">
            <p style="margin:0 0 .35rem;color:#64748b;font-size:.85rem">
                <a href="@StorefrontSurfaceLinks.Orders">My orders</a>
                · Guest order
            </p>
            <h1 style="margin:.1rem 0 .4rem">Track a guest order</h1>
            <p style="color:#475569">Use the order number from checkout if you placed the order without signing in.</p>
            <form method="post" action="@PhpCustomerWrites.GuestOrderWriteHref" style="background:#fff;border:1px solid #e2e8f0;border-radius:.55rem;padding:1.1rem 1.2rem">
                <label for="order_id">Order number</label>
                <input id="order_id" type="number" name="order_id" min="1" required value="@OrderId" style="width:100%;margin:.25rem 0 .75rem;padding:.5rem" />
                <label for="email_not_auth">Email on the order</label>
                <input id="email_not_auth" type="email" name="email_not_auth" required style="width:100%;margin:.25rem 0 .75rem;padding:.5rem" />
                <label for="phone_not_auth">Phone on the order</label>
                <input id="phone_not_auth" type="text" name="phone_not_auth" style="width:100%;margin:.25rem 0 1rem;padding:.5rem" />
                <button type="submit" style="padding:.65rem 1.1rem;border:0;border-radius:.45rem;background:#0f766e;color:#fff;font-weight:800;cursor:pointer">Open order</button>
            </form>
            <p style="margin-top:1rem"><a href="@StorefrontSurfaceLinks.Login">Sign in for a full order history</a></p>
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";

    [SupplyParameterFromQuery(Name = "order_id")]
    public int? OrderId { get; set; }

    protected override void OnInitialized()
    {
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(Http.HttpContext?.Request.Host.Host);
    }
}
