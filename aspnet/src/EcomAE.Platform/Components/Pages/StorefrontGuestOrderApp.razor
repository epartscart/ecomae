@page "/storefront/guest-order-app"
@page "/en/shop/orders/guest"
@page "/shop/orders/guest"
@page "/en/shop/orders/zakaz-bez-registracii"
@page "/shop/orders/zakaz-bez-registracii"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject IHttpContextAccessor Http
@inject ILegacySessionValidator Sessions
@inject IStorefrontGuestSessionService Guests
@inject EcomAE.Platform.Data.ITenantDbConnectionFactory Connections
@inject ILogger<StorefrontGuestOrderApp> Log
@inject Microsoft.Extensions.Options.IOptions<EcomAE.Platform.Configuration.PhpReferenceOptions> PhpReference
@*
  PHP twin: content/shop/order_process/my_order_not_authorized.php (StorefrontOrderNotAuthorized). Its pay_on_place
  POST is StorefrontOrderNotAuthorizedPostMiddleware.
*@

<PageTitle>Track order · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" />

<StorefrontTenantChrome>
    <section style="padding:2rem 0 3rem">
        <div class="container">
            <script>window.jQuery || document.write('<script src="/lib/jQuery/jQuery.js"><\/script>');</script>
            @((MarkupString)_html)
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private string _html = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);
        var sessionCookie = ctx.Request.Cookies["session"];
        var userCookie = ctx.Request.Cookies["u_id"];
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Customer || session.UserId <= 0)
        {
            var shopper = await Guests.ResolveAsync(ctx, createIfMissing: true, ctx.RequestAborted);
            if (!shopper.IsSignedIn)
            {
                Guests.ApplyGuestCookies(ctx.Response, shopper);
                if (shopper.SessionToken.Length > 0)
                {
                    sessionCookie = shopper.SessionToken;
                    userCookie = "0";
                }
            }
        }

        var tenant = ctx.Items[EcomAE.Platform.Middleware.TenantResolutionMiddleware.HttpContextItemKey] as EcomAE.Platform.Services.TenantContext;
        var lang = StorefrontPhpHomeLinks.LangHref(ctx);
        try
        {
            await using var connection = await Connections.OpenForTenantAsync(tenant, ctx.RequestAborted);
            var translator = new StorefrontPhpTranslator(connection, lang.TrimStart('/'));
            Func<string, Task<string>> t = key => translator.TextAsync(key, ctx.RequestAborted);
            var alertStrings = new Dictionary<int, string>();
            foreach (var id in StorefrontActionsAlert.StringIds)
            {
                alertStrings[id] = await t(id.ToString(System.Globalization.CultureInfo.InvariantCulture));
            }

            var orderId = StorefrontActionsAlert.Last(ctx.Request.Query, "order_id");
            var picker = string.Empty;
            if (orderId is not null)
            {
                picker = StorefrontPaymentMethodPicker.Render(await StorefrontPaymentMethodPicker.ListSelectableAsync(connection, translator, ctx.RequestAborted));
            }

            var input = new StorefrontOrderNotAuthorized.Input(
                orderId,
                lang,
                await StorefrontBottomPanelCart.CsrfGuardKeyAsync(connection, sessionCookie, userCookie, ctx.RequestAborted),
                EcomAE.Platform.Cp.PriceImport.CpPhpConfig.Read(PhpReference.Value),
                picker,
                StorefrontActionsAlert.Render(key => StorefrontActionsAlert.Last(ctx.Request.Query, key), id => alertStrings[id]));
            _html = await StorefrontOrderNotAuthorized.RenderAsync(connection, input, t, StorefrontOrderNotAuthorized.PhpDate, ctx.RequestAborted);
        }
        catch (System.Data.Common.DbException ex)
        {
            Log.LogWarning(ex, "Guest order page query failed");
            _html = "<p>Order lookup is unavailable right now.</p>";
        }
        catch (InvalidOperationException ex)
        {
            Log.LogWarning(ex, "Guest order page render failed");
            _html = "<p>Order lookup is unavailable right now.</p>";
        }
    }
}
