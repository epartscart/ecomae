@page "/marketing/blockchain-disclaimer"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>ECOM AE — Blockchain disclaimer</PageTitle>
<PhpChromeStyles Surface="marketing" />

<PhpEcomaeMarketingChrome ActiveKey="blockchain_disclaimer">
    <PhpHybridWorkspaceFrame PhpHref="@_phpHref" ClearHref="/marketing/blockchain-disclaimer" />

    @if (string.IsNullOrWhiteSpace(_phpHref))
    {
        <PhpEcomaeLegalAliasOverview
            Title="Blockchain disclaimer"
            Badge="Blockchain"
            Icon="fa-link"
            GradientStart="#0c4a6e"
            GradientMid="#0284c7"
            PhpSlug="blockchain-disclaimer"
            AspNetRoute="/marketing/blockchain-disclaimer"
            Lead="Blockchain BOS disclaimers and risk notices. Full policy text is available from the linked policy page."
            CardOne="Distributed-ledger related caveats for operators." />
    }
</PhpEcomaeMarketingChrome>

@code {
    private string? _phpHref;

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        if (ctx?.Request.Query.TryGetValue("php", out var php) == true && !string.IsNullOrWhiteSpace(php))
        {
            _phpHref = php.ToString();
        }
    }
}
