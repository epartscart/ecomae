@page "/storefront/forgot-password-app"
@page "/en/users/forgot_password"
@page "/en/users/forgot"
@page "/users/forgot_password"
@page "/users/forgot"
@page "/en/users/new_password"
@page "/users/new_password"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>Forgot password · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" LoginChrome="true" />

<HeadContent>
<style>
    .epc-auth-page { box-sizing:border-box; width:100%; max-width:480px; margin:0 auto; padding:28px 16px 48px; }
    .epc-auth-page h1 { margin:.1rem 0 .4rem; font-size:1.45rem; }
    .epc-auth-page .lead { color:#475569; margin-bottom:1rem; }
    .epc-auth-page .login-input { margin:0 0 .85rem; }
    .epc-auth-page .login-input .input-group-addon { display:block; font-size:.82rem; font-weight:600; margin-bottom:.25rem; color:#334155; }
    .epc-auth-page .form-control {
        width:100%; height:40px; padding:.5rem .65rem; background:#fff; border:1px solid #ccc; color:#555; border-radius:.4rem;
    }
    .epc-auth-page button[type=submit] {
        width:100%; padding:.75rem 1rem; border:0; border-radius:.45rem; background:#dc2626; color:#fff; font-weight:800; cursor:pointer;
    }
</style>
</HeadContent>

<StorefrontTenantChrome>
    <section class="epc-auth-page">
        <p style="margin:0 0 .35rem;color:#64748b;font-size:.85rem"><a href="@StorefrontSurfaceLinks.Login">Customer login</a></p>
        <h1>Forgot password</h1>
        <p class="lead">Enter the confirmed email or phone on the account. A reset code is sent to that contact.</p>
        <form method="post" action="@PhpVendorPortal.ForgotWriteHref" id="forgot_password_form">
            <div class="input-group login-input">
                <span class="input-group-addon">Contact type</span>
                <select name="forgot_password_contact_type" class="form-control" id="forgot_password_contact_select">
                    <option value="email">E-mail</option>
                    <option value="phone">Phone</option>
                </select>
            </div>
            <div class="input-group login-input">
                <span class="input-group-addon"><i id="contact_type_icon_forgot_password" class="fa fa-envelope"></i></span>
                <input type="text" class="form-control" placeholder="Enter your E-mail"
                       name="forgot_password_contact" id="forgot_password_contact_input" required />
            </div>
            <button type="submit">Send reset code</button>
        </form>
        <p style="margin-top:1rem"><a href="@StorefrontSurfaceLinks.Login">Back to login</a></p>
    </section>
</StorefrontTenantChrome>
<script>
(function () {
    var sel = document.getElementById('forgot_password_contact_select');
    var input = document.getElementById('forgot_password_contact_input');
    var icon = document.getElementById('contact_type_icon_forgot_password');
    if (!sel || !input || !icon) return;
    function apply() {
        var phone = sel.value === 'phone';
        icon.className = phone ? 'fa fa-phone' : 'fa fa-envelope';
        input.placeholder = phone ? 'Enter phone' : 'Enter your E-mail';
    }
    sel.addEventListener('change', apply);
    apply();
})();
</script>

@code {
    private string _brand = "eParts Cart";

    protected override void OnInitialized()
    {
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(Http.HttpContext?.Request.Host.Host);
    }
}
