@page "/storefront/forgot-password-app"
@page "/en/users/forgot_password"
@page "/en/users/forgot"
@page "/users/forgot_password"
@page "/users/forgot"
@page "/en/users/new_password"
@page "/users/new_password"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>Forgot password · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" LoginChrome="true" />

<StorefrontTenantChrome>
    <section style="padding:2rem 0 3rem">
        <div class="container" style="max-width:36rem">
            <p style="margin:0 0 .35rem;color:#64748b;font-size:.85rem"><a href="@StorefrontSurfaceLinks.Login">Customer login</a></p>
            <h1 style="margin:.1rem 0 .4rem">Forgot password</h1>
            <p style="color:#475569">Enter the confirmed email or phone on the account. A reset code is sent to that contact.</p>
            <form method="post" action="@PhpVendorPortal.ForgotWriteHref" style="background:#fff;border:1px solid #e2e8f0;border-radius:.55rem;padding:1.1rem 1.2rem">
                <label>Contact type</label>
                <select name="forgot_password_contact_type" style="width:100%;margin:.25rem 0 .75rem;padding:.5rem">
                    <option value="email">E-mail</option>
                    <option value="phone">Phone</option>
                </select>
                <label>Email or phone</label>
                <input type="text" name="forgot_password_contact" required style="width:100%;margin:.25rem 0 1rem;padding:.5rem" />
                <button type="submit" style="width:100%;padding:.75rem 1rem;border:0;border-radius:.45rem;background:#dc2626;color:#fff;font-weight:800;cursor:pointer">Send reset code</button>
            </form>
            <p style="margin-top:1rem"><a href="@StorefrontSurfaceLinks.Login">Back to login</a></p>
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";

    protected override void OnInitialized()
    {
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(Http.HttpContext?.Request.Host.Host);
    }
}
