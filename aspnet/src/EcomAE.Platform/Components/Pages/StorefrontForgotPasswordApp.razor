@page "/storefront/forgot-password-app"
@page "/en/users/forgot_password"
@page "/en/users/forgot"
@page "/users/forgot_password"
@page "/users/forgot"
@page "/en/users/new_password"
@page "/users/new_password"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Storefront
@inject IHttpContextAccessor Http
@inject ILegacySessionValidator Sessions
@inject NavigationManager Navigation
@inject EcomAE.Platform.Data.ITenantDbConnectionFactory Connections
@inject Microsoft.Extensions.Options.IOptions<EcomAE.Platform.Configuration.PhpReferenceOptions> PhpReference

<PageTitle>Forgot password · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" LoginChrome="true" />

<HeadContent>
<style>
    .epc-auth-page { box-sizing:border-box; width:100%; max-width:480px; margin:0 auto; padding:28px 16px 48px; }
    .epc-auth-page h1 { margin:.1rem 0 .4rem; font-size:1.45rem; }
    .epc-auth-page .lead { color:#475569; margin-bottom:1rem; }
    .epc-auth-page .login-input { margin:0 0 .85rem; }
    .epc-auth-page .login-input .input-group-addon { display:block; font-size:.82rem; font-weight:600; margin-bottom:.25rem; color:#334155; }
    .epc-auth-page .form-control {
        width:100%; height:40px; padding:.5rem .65rem; background:#fff; border:1px solid #ccc; color:#555; border-radius:.4rem;
    }
    .epc-auth-page button[type=submit] {
        width:100%; padding:.75rem 1rem; border:0; border-radius:.45rem; background:#dc2626; color:#fff; font-weight:800; cursor:pointer;
    }
    .epc-auth-page .epc-auth-result { margin:0 0 1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #e2e8f0; border-radius:.45rem; }
    .epc-auth-page .epc-auth-result h2 { font-size:1.15rem; margin:0 0 .4rem; }
</style>
</HeadContent>

<StorefrontTenantChrome>
    <section class="epc-auth-page">
        <p style="margin:0 0 .35rem;color:#64748b;font-size:.85rem"><a href="@StorefrontSurfaceLinks.Login">Customer login</a></p>
        <h1>@(_newPassword ? "New password" : "Forgot password")</h1>
        @if (_resultHtml is not null)
        {
            <div class="epc-auth-result" id="forgot_password_result">@((MarkupString)_resultHtml)</div>
        }
        else if (!_newPassword)
        {
            <p class="lead">Enter the confirmed email or phone on the account. A reset code is sent to that contact.</p>
            <form method="post" action="@StorefrontPhpAjax.ForgotPasswordSendPath" id="forgot_password_form">
                <div class="input-group login-input" style="@(_communications.All ? null : "display:none;")">
                    <span class="input-group-addon">@_selectLabel</span>
                    <select name="forgot_password_contact_type" class="form-control" id="forgot_password_contact_select">
                        @if (_communications.All || _communications.Sms)
                        {
                            <option value="phone">@_phoneLabel</option>
                        }
                        @if (_communications.All || !_communications.Sms)
                        {
                            <option value="email">E-mail</option>
                        }
                    </select>
                </div>
                <div class="input-group login-input">
                    <span class="input-group-addon"><i id="contact_type_icon_forgot_password" class="fa fa-envelope"></i></span>
                    <input type="text" class="form-control" placeholder="@_emailPlaceholder" data-phone-placeholder="@_phonePlaceholder"
                           name="forgot_password_contact" id="forgot_password_contact_input" required />
                </div>
                <button type="submit">@_submitLabel</button>
            </form>
        }
        <p style="margin-top:1rem"><a href="@StorefrontSurfaceLinks.Login">Back to login</a></p>
    </section>
</StorefrontTenantChrome>
<script>
(function () {
    var sel = document.getElementById('forgot_password_contact_select');
    var input = document.getElementById('forgot_password_contact_input');
    var icon = document.getElementById('contact_type_icon_forgot_password');
    if (!sel || !input || !icon) return;
    var emailPlaceholder = input.getAttribute('placeholder');
    function apply() {
        var phone = sel.value === 'phone';
        icon.className = phone ? 'fa fa-phone' : 'fa fa-envelope';
        input.placeholder = phone ? input.getAttribute('data-phone-placeholder') : emailPlaceholder;
    }
    sel.addEventListener('change', apply);
    apply();
})();
</script>

@code {
    private string _brand = "eParts Cart";
    private bool _newPassword;
    private string? _resultHtml;
    private StorefrontPhpAjax.Communications _communications = new(true, false);
    private string _selectLabel = "Contact type";
    private string _phoneLabel = "Phone";
    private string _emailPlaceholder = "Enter your E-mail";
    private string _phonePlaceholder = "Enter phone";
    private string _submitLabel = "Send reset code";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);
        var path = (ctx.Items.TryGetValue(EcomAE.Platform.Middleware.IndustryStorefrontSlugMiddleware.OriginalPathItem, out var original) && original is string originalPath
            ? originalPath
            : ctx.Request.Path.Value ?? string.Empty).TrimEnd('/');
        _newPassword = path.EndsWith("/new_password", StringComparison.Ordinal);
        var langHref = path.StartsWith("/en/", StringComparison.Ordinal) ? "/en" : string.Empty;
        var config = EcomAE.Platform.Cp.PriceImport.CpPhpConfig.Read(PhpReference.Value);
        var query = ctx.Request.Query;
        string? Query(string key) => query.TryGetValue(key, out var value) ? value.ToString() : null;

        string? redirect = null;
        try
        {
            await using var connection = await Connections.OpenAsync(null, ctx.RequestAborted);
            var translator = new StorefrontPhpTranslator(connection, "en");
            async Task<string> T(int id, string fallback)
            {
                var text = await translator.TextAsync(id, ctx.RequestAborted);
                return text.Length > 0 ? text : fallback;
            }

            Task<string> Message(string id)
                => T(int.Parse(id, System.Globalization.CultureInfo.InvariantCulture), StorefrontPhpAjax.PasswordResetFallbacks.TryGetValue(id, out var english) ? english : id);

            if (_newPassword)
            {
                var outcome = await StorefrontPhpAjax.NewPasswordAsync(connection, Query("code"), Query("type"), Query("contact"), config, ctx.RequestAborted);
                if (outcome.RedirectHome)
                {
                    redirect = "/";
                }
                else if (outcome.Password is not null)
                {
                    _resultHtml = "<h2>" + System.Net.WebUtility.HtmlEncode(await Message("4732")) + "</h2>" + outcome.Password;
                }
                else
                {
                    _resultHtml = System.Net.WebUtility.HtmlEncode(await Message(outcome.MessageId!));
                }
            }
            else
            {
                var session = await Sessions.ValidateCustomerAsync(ctx, ctx.RequestAborted);
                if (session.Kind == LegacySessionKind.Customer && session.UserId > 0)
                {
                    redirect = "/";
                }
                else if (Query("r") is { } result && StorefrontPhpAjax.ForgotPasswordResults.Contains(result))
                {
                    _resultHtml = result == StorefrontPhpAjax.ForgotPhoneSent
                        ? await StorefrontPhpAjax.ForgotPhoneCodeFormAsync(translator, langHref, Query("contact") ?? string.Empty, ctx.RequestAborted)
                        : System.Net.WebUtility.HtmlEncode(await Message(result));
                }
                else
                {
                    _communications = await StorefrontPhpAjax.AvailableCommunicationsAsync(connection, config, ctx.RequestAborted);
                    _selectLabel = await T(4727, _selectLabel);
                    _phoneLabel = await T(1312, _phoneLabel);
                    _emailPlaceholder = await T(4017, _emailPlaceholder);
                    _phonePlaceholder = await T(4018, _phonePlaceholder);
                    _submitLabel = await T(4728, _submitLabel);
                }
            }
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException)
        {
            _resultHtml = _newPassword ? "Password reset is unavailable right now." : null;
        }

        if (redirect is not null)
        {
            Navigation.NavigateTo(redirect);
        }
    }
}
