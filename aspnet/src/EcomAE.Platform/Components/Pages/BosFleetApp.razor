@page "/bos/app"
@page "/bos"
@page "/bos/"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Super BOS · Fleet Command</PageTitle>
<PhpChromeStyles Surface="bos" />

<PhpBosDesktopChrome IsAdmin="_isAdmin" Title="Command Center">
        <style>
            .epc-bosapp-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:.65rem; margin:1.1rem 0; }
            .epc-bosapp-card { background:#fff; border:1px solid #e4e4e7; border-radius:.55rem; padding:.9rem; }
            .epc-bosapp-card strong { display:block; font-size:1.4rem; }
            .epc-bosapp-card span { color:#71717a; font-size:.8rem; }
            .epc-bosapp-note { margin-top:1rem; padding:.8rem; border:1px solid #e4e4e7; border-radius:.45rem; background:#fff; color:#52525b; font-size:.88rem; }
        </style>

        <p style="color:#52525b;max-width:40rem">Fleet Command Center — ASP.NET shell matching BOS topnav mega layout. Browse tenants, readiness, and modules; PHP only via /php-reference/*.</p>
        @if (!_isAdmin)
        {
            <div class="epc-bosapp-note" style="background:#eff6ff;border-color:#bfdbfe;color:#1e3a8a;">
                Guest preview — browse the ASP.NET BOS shell.
                <a href="/bos/login">Sign in</a> for live KPIs.
                PHP detail: <a href="/php-reference/bos">/php-reference/bos</a>
            </div>
        }
        <div class="epc-bosapp-grid">
            <div class="epc-bosapp-card"><strong>@_tenants</strong><span>Total tenants</span></div>
            <div class="epc-bosapp-card"><strong>@_commerce</strong><span>Commerce</span></div>
            <div class="epc-bosapp-card"><strong>@_erpOnly</strong><span>ERP only</span></div>
            <div class="epc-bosapp-card"><strong>@_demo</strong><span>Demo</span></div>
            <div class="epc-bosapp-card"><strong>@_platform</strong><span>Platform</span></div>
            <div class="epc-bosapp-card"><strong>@_active</strong><span>Active tenants</span></div>
            <div class="epc-bosapp-card"><strong>@_withDb</strong><span>With database</span></div>
            <div class="epc-bosapp-card"><strong>@_sessions</strong><span>Admin sessions</span></div>
        </div>

        <div class="epc-bosapp-grid" style="margin-top:.35rem">
            <a class="epc-bosapp-card" href="/bos/tenants-app" style="text-decoration:none;color:inherit"><strong><i class="fa fa-building"></i></strong><span>Tenant control</span></a>
            <a class="epc-bosapp-card" href="/bos/fleet-health-app" style="text-decoration:none;color:inherit"><strong><i class="fa fa-heartbeat"></i></strong><span>Fleet health</span></a>
            <a class="epc-bosapp-card" href="/bos/fleet-readiness-app" style="text-decoration:none;color:inherit"><strong><i class="fa fa-check-circle"></i></strong><span>Readiness</span></a>
            <a class="epc-bosapp-card" href="/bos/fleet-summary-app" style="text-decoration:none;color:inherit"><strong><i class="fa fa-dashboard"></i></strong><span>Fleet summary</span></a>
            <a class="epc-bosapp-card" href="/bos/audit-log-app" style="text-decoration:none;color:inherit"><strong><i class="fa fa-list-alt"></i></strong><span>Audit log</span></a>
            <a class="epc-bosapp-card" href="/cp" style="text-decoration:none;color:inherit"><strong><i class="fa fa-th-large"></i></strong><span>Control panel</span></a>
            <a class="epc-bosapp-card" href="/erp" style="text-decoration:none;color:inherit"><strong><i class="fa fa-line-chart"></i></strong><span>ERP workspace</span></a>
            <a class="epc-bosapp-card" href="/" style="text-decoration:none;color:inherit"><strong><i class="fa fa-shopping-cart"></i></strong><span>Storefront</span></a>
        </div>

        <PhpHybridModuleDirectory
            Title="Complete BOS section directory"
            Subtitle="@($"{PhpModuleCatalog.BosSectionCount} topnav sections")"
            Links="@PhpModuleCatalog.BosSections"
            PhpWorkspaceBase="/bos/app" />

        <PhpHybridModuleDirectory
            Title="Complete BOS module directory"
            Subtitle="@($"{PhpModuleCatalog.BosModuleCount} BOS modules")"
            Links="@PhpModuleCatalog.BosModules"
            PhpWorkspaceBase="/bos/app" />

        <div class="epc-bosapp-note">Open any module below on ASP.NET. PHP product pages are only under /php-reference/*.</div>
</PhpBosDesktopChrome>

@code {
    private int _tenants, _active, _sessions, _withDb, _erpOnly, _commerce, _demo, _platform;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin;
        if (!_isAdmin)
        {
            return;
        }
        var summary = await Dashboards.BuildBosAsync(ctx.RequestAborted);
        _tenants = summary.PortalTenants;
        _active = summary.ActivePortalTenants;
        _sessions = summary.AdminSessions;
        _withDb = summary.WithDatabase;
        _erpOnly = summary.ErpOnly;
        _commerce = summary.CommerceTenants;
        _demo = summary.DemoTenants;
        _platform = summary.PlatformTenants;
    }
}
