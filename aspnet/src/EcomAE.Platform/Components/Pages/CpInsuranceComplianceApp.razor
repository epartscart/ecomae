@page "/cp/insurance-compliance-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Insurance compliance · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-w16-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0f172a 0%,#1e3a5f 50%,#0ea5e9 100%);
        }
        .epc-w16-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-w16-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-w16-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-w16-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f172a; background:#fff;
        }
        .epc-w16-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-w16-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-w16-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-w16-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-w16-kpi span { color:#64748b; font-size:.78rem; }
        .epc-w16-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-w16-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-w16-table th, .epc-w16-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-w16-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-w16-note { margin-top:1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:.45rem; color:#334155; font-size:.86rem; }
        @@media (max-width:900px){ .epc-w16-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-w16-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Insurance compliance</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-w16-cta">
            <a href="@_phpTab">Open module</a>
        </div>
    </section>

    <div class="epc-w16-kpis" aria-label="Insurance compliance stats">
        <div class="epc-w16-kpi"><strong>@_summary.PolicyCount.ToString(CultureInfo.InvariantCulture)</strong><span>Policies</span></div>
        <div class="epc-w16-kpi"><strong>@_summary.ActiveCount.ToString(CultureInfo.InvariantCulture)</strong><span>Active</span></div>
        <div class="epc-w16-kpi"><strong>@_summary.ClaimCount.ToString(CultureInfo.InvariantCulture)</strong><span>Claims</span></div>
        <div class="epc-w16-kpi"><strong>@_summary.DocumentCount.ToString(CultureInfo.InvariantCulture)</strong><span>Documents</span></div>
    </div>

    <div class="epc-w16-table-wrap">
    <table class="epc-w16-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Policy</th>
                    <th>Class</th>
                    <th>Title</th>
                    <th>Insurer</th>
                    <th>Sum</th>
                    <th>Status</th>
                    <th>Expiry</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="9">Nothing to show yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PolicyNo) ? row.PolicyNo : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Class) ? row.Class : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Insurer) ? row.Insurer : "—")</td>
                            <td>@row.SumInsured.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@row.ExpiryDate.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@_phpTab">Open</a></td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=risk&tab=insurance";
    private bool _isAdmin;
    private CpInsuranceComplianceSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpInsuranceCompliancePolicyDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpInsuranceComplianceDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Policies;
        _source = result.Source;
        _message = result.Message;
    }
}
