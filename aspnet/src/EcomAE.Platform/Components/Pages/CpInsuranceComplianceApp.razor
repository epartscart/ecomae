@page "/cp/insurance-compliance-app"
@page "/erp/insurance-compliance-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Insurance compliance · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Insurance compliance
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/insurance-compliance-app")</p>
                <p>Log a claim, set claim status, add or remove a document, and save or delete a policy here.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/insurance-compliance-app" IsAdmin="_isAdmin" />


    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/ajax/ins-claim-add" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/insurance-compliance-app" />
            <label>Policy id <input type="number" name="policy_id" min="0" style="width:6rem" /></label>
            <label>Claim no <input type="text" name="claim_no" /></label>
            <label>Description <input type="text" name="description" /></label>
            <label>Amount <input type="number" name="claim_amount" step="0.01" style="width:7rem" /></label>
            <button type="submit">Log claim</button>
        </form>
        <form method="post" action="/erp/ajax/ins-claim-status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/cp/insurance-compliance-app")" />
            <label>Claim id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <label>Status
                <select name="status">
                    <option value="notified">notified</option>
                    <option value="survey">survey</option>
                    <option value="docs">docs</option>
                    <option value="assessed">assessed</option>
                    <option value="settled">settled</option>
                    <option value="rejected">rejected</option>
                    <option value="closed">closed</option>
                </select>
            </label>
            <button type="submit">Set claim status</button>
        </form>
        <form method="post" action="/erp/ajax/ins-doc-delete" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/cp/insurance-compliance-app")" />
            <label>Document id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <button type="submit">Remove document</button>
        </form>
        <form method="post" action="/erp/insurance/delete" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/insurance-compliance-app" />
            <label>Policy id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <button type="submit">Delete policy</button>
        </form>
        <form method="post" action="/erp/insurance/docs/add" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/insurance-compliance-app" />
            <label>Policy id <input type="number" name="policy_id" min="1" required style="width:6rem" /></label>
            <label>Type
                <select name="doc_type">
                    <option value="policy">Policy schedule</option>
                    <option value="endorsement">Endorsement</option>
                    <option value="invoice">Premium invoice</option>
                    <option value="cover_note">Cover note</option>
                    <option value="claim">Claim document</option>
                    <option value="other">Other</option>
                </select>
            </label>
            <label>Title <input type="text" name="title" /></label>
            <label>File path / URL <input type="text" name="file_path" placeholder="/uploads/policy.pdf" /></label>
            <button type="submit">Add document</button>
        </form>
        <form method="post" action="/erp/insurance/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/insurance-compliance-app" />
            <label>Policy no <input type="text" name="policy_no" required /></label>
            <label>Class
                <select name="class">
                    <option value="marine">Marine Cargo / Hull</option>
                    <option value="property_air">Property All-Risk</option>
                    <option value="medical">Group Medical / Health</option>
                    <option value="motor">Motor / Fleet</option>
                    <option value="other">Other</option>
                </select>
            </label>
            <label>Title <input type="text" name="title" /></label>
            <label>Insurer <input type="text" name="insurer" /></label>
            <label>Sum <input type="number" name="sum_insured" step="0.01" style="width:7rem" /></label>
            <label>Premium <input type="number" name="premium" step="0.01" style="width:7rem" /></label>
            <label>Expiry <input type="date" name="expiry_date_str" required /></label>
            <label>Currency <input type="text" name="currency" maxlength="3" value="AED" style="width:4rem" /></label>
            <button type="submit">Save policy</button>
        </form>
    }

    <p class="help-block">@_summary.PolicyCount.ToString(CultureInfo.InvariantCulture) Policies · @_summary.ActiveCount.ToString(CultureInfo.InvariantCulture) Active · @_summary.ClaimCount.ToString(CultureInfo.InvariantCulture) Claims · @_summary.DocumentCount.ToString(CultureInfo.InvariantCulture) Documents.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Company</th>
                    <th>Policy</th>
                    <th>Class</th>
                    <th>Title</th>
                    <th>Insurer</th>
                    <th>Sum</th>
                    <th>Premium</th>
                    <th>CCY</th>
                    <th>Status</th>
                    <th>Expiry</th>
                    <th>Created</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="13">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CompanyId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PolicyNo) ? row.PolicyNo : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Class) ? row.Class : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Insurer) ? row.Insurer : "—")</td>
                            <td>@row.SumInsured.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.Premium.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Currency) ? row.Currency : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@row.ExpiryDate.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.TimeCreated.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=risk&tab=insurance";
    private bool _isAdmin;
    private CpInsuranceComplianceSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpInsuranceCompliancePolicyDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpInsuranceComplianceDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Policies;
        _source = result.Source;
        _message = result.Message;
    }
}
