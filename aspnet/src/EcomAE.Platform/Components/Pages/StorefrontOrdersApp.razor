@page "/storefront/orders-app"
@page "/en/shop/orders"
@page "/shop/orders"
@page "/en/shop/orders/order"
@page "/shop/orders/order"
@page "/en/shop/orders/items"
@page "/shop/orders/items"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>My Orders · @_brand</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        
        .epc-sf-ord-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-sf-ord-cta a {
            display:inline-flex; padding:.5rem .85rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0c4a6e; background:#fee2e2;
        }
        .epc-sf-ord-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-sf-ord-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-sf-ord-badge { display:inline-flex; padding:.15rem .45rem; border-radius:.3rem; font-size:.72rem; font-weight:700; }
        .epc-sf-ord-badge--ok { background:#cffafe; color:#155e75; }
        .epc-sf-ord-badge--off { background:#fee2e2; color:#991b1b; }
        .epc-sf-ord-badge--info { background:#e2e8f0; color:#334155; }
        .epc-sf-ord-note { margin-top:1rem; padding:.75rem .9rem; background:#ecfeff; border:1px solid #a5f3fc; border-radius:.45rem; color:#155e75; font-size:.86rem; }
        .epc-sf-ord-gate { padding:1.25rem; background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; }
    
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontTenantChrome>

    <PhpStorefrontPageHeader Title="My Orders"
                            Subtitle="Your orders, receipts, and messages to the store.">
            <a class="btn btn-sm btn-primary" href="/storefront/cart-app">Cart</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.PartSearch">Search parts</a>
            <a class="btn btn-sm btn-default" href="@StorefrontAspNetCanonical.GuestOrder">Guest order</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Login">Customer login</a>
    </PhpStorefrontPageHeader>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
    }

    @if (!_isCustomer)
    {
        <div class="panel panel-primary">
            <div class="panel-body">
                <p style="margin:0 0 .75rem;color:#334155">Sign in with your store account to load recent orders.</p>
                <div class="epc-commerce-login-cta">
                    <a class="btn btn-sm btn-primary" href="/storefront/login">Log in</a>
                    <span class="epc-commerce-login-cta__sep">or</span>
                    <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Registration">Register</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-2">
                <div><label style="margin-bottom: 0;" for="time_from_show">From</label></div>
                <input type="text" id="time_from" class="form-control" value="@_filter.TimeFrom" />
                <input type="hidden" id="time_from_show" />
            </div>
            <div class="col-md-2">
                <div><label style="margin-bottom: 0;" for="time_to_show">To</label></div>
                <input type="text" id="time_to" class="form-control" value="@_filter.TimeTo" />
                <input type="hidden" id="time_to_show" />
            </div>
            <div class="col-md-2">
                <div><label style="margin-bottom: 0;" for="order_id">Order ID</label></div>
                <input type="text" id="order_id" class="form-control" value="@_filter.OrderId" />
            </div>
            <div class="col-md-2">
                <div><label style="margin-bottom: 0;" for="paid">Paid</label></div>
                <select id="paid" class="form-control">
                    <option value="-1">All</option>
                    <option value="1">Paid</option>
                    <option value="0">Unpaid</option>
                    <option value="2">Partial</option>
                </select>
            </div>
            <div class="col-md-2 hidden">
                <div><label style="margin-bottom: 0;" for="paid_type">Paid type</label></div>
                <select id="paid_type" class="form-control">
                    <option value="-1">All</option>
                    <option value="0">Not specified</option>
                </select>
            </div>
            <div class="col-md-2">
                <div><label style="margin-bottom: 0;" for="garage">Garage</label></div>
                <select id="garage" class="form-control">
                    <option value="0">All</option>
                    <option value="-1">Not specified</option>
                </select>
            </div>
            <div class="col-md-2">
                <div><label style="margin-bottom: 0;" for="status-select">Status</label></div>
                <select id="status-select" class="form-control">
                    <option value="0">All</option>
                    @foreach (var st in _shownOrders.Select(o => o.Status).Distinct().OrderBy(s => s))
                    {
                        <option value="@st.ToString(CultureInfo.InvariantCulture)">@st.ToString(CultureInfo.InvariantCulture)</option>
                    }
                </select>
            </div>
        </div>
        <div class="box_btn_filter" style="margin:20px 0px 15px;">
            <button style="margin-right: 2px; margin-bottom:5px;" class="btn btn-ar btn-primary" onclick="filterOrders();">Filter</button>
            <button style="margin-right: 2px; margin-bottom:5px;" class="btn btn-ar btn-primary" onclick="unsetFilterOrders();">Clear</button>
            <button style="margin-right: 2px; margin-bottom:5px;" class="btn btn-ar btn-primary" onclick="location='@StorefrontAspNetCanonical.Orders?view=items';">Order items</button>
            <button style="margin-right: 2px; margin-bottom:5px;" class="hidden-xs hidden-sm btn btn-ar btn-primary" onclick="show_orders_items();"><i style="margin-right: 0px;" class="fa fa-level-down"></i></button>
        </div>
        <script>
            document.getElementById("paid").value = "@_filter.Paid";
            document.getElementById("paid_type").value = "@_filter.PaidType";
            document.getElementById("garage").value = "@_filter.Garage";
            document.getElementById("status-select").value = "@_filter.Status";
            function filterOrders() {
                var my_orders_filter = {
                    time_from: encodeURIComponent(document.getElementById("time_from").value),
                    time_to: encodeURIComponent(document.getElementById("time_to").value),
                    order_id: encodeURIComponent(document.getElementById("order_id").value),
                    status: encodeURIComponent(document.getElementById("status-select").value),
                    paid: encodeURIComponent(document.getElementById("paid").value),
                    paid_type: encodeURIComponent(document.getElementById("paid_type").value),
                    garage: encodeURIComponent(document.getElementById("garage").value)
                };
                var date = new Date(new Date().getTime() + 15552000 * 1000);
                document.cookie = "my_orders_filter="+JSON.stringify(my_orders_filter)+"; path=/; expires=" + date.toUTCString();
                location = "@StorefrontAspNetCanonical.Orders";
            }
            function unsetFilterOrders() {
                var my_orders_filter = { time_from:"", time_to:"", order_id:"", status:"0", paid:"-1", paid_type:"-1", garage:"0" };
                var date = new Date(new Date().getTime() + 15552000 * 1000);
                document.cookie = "my_orders_filter="+JSON.stringify(my_orders_filter)+"; path=/; expires=" + date.toUTCString();
                location = "@StorefrontAspNetCanonical.Orders";
            }
            function show_orders_items() {
                var rows = document.querySelectorAll('.orders-items-tr');
                rows.forEach(function(r){ r.style.display = r.style.display === 'table-row' ? 'none' : 'table-row'; });
            }
        </script>

        <div style="overflow: hidden; overflow-x: auto;">
            <table class="table">
                <thead>
                    <tr>
                        <th class="hidden"><input type="checkbox" id="check_uncheck_all" name="check_uncheck_all" /></th>
                        <th style="vertical-align: middle; white-space: nowrap;"><a href="javascript:void(0);" onclick="sortOrders('id');" id="id_sorter">ID</a></th>
                        <th style="vertical-align: middle; white-space: nowrap;"><a href="javascript:void(0);" onclick="sortOrders('time');" id="time_sorter">When</a></th>
                        <th style="vertical-align: middle; white-space: nowrap;"><a href="javascript:void(0);" onclick="sortOrders('price_sum');" id="price_sum_sorter">Sum</a></th>
                        <th style="vertical-align: middle; white-space: nowrap;"><a href="javascript:void(0);" onclick="sortOrders('paid');" id="paid_sorter">Paid</a></th>
                        <th style="vertical-align: middle; white-space: nowrap;"><a href="javascript:void(0);" onclick="sortOrders('paid_type');" id="paid_type_sorter">Paid type</a></th>
                        <th style="vertical-align: middle; white-space: nowrap;"><a href="javascript:void(0);" onclick="sortOrders('status');" id="status_sorter">Status</a></th>
                        <th style="vertical-align: middle; white-space: nowrap;"><a href="javascript:void(0);" onclick="sortOrders('obtain_caption');" id="obtain_caption_sorter">How to obtain</a></th>
                        <th style="vertical-align: middle; white-space: nowrap;"><a href="javascript:void(0);" onclick="sortOrders('office_id');" id="office_id_sorter">Office</a></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_shownOrders.Count == 0)
                    {
                        <tr><td colspan="10">You have no orders yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var o in _shownOrders)
                        {
                            <tr>
                                <td class="hidden"></td>
                                <td><a href="@StorefrontSurfaceLinks.ForOrder(o.Id)">@o.Id.ToString(CultureInfo.InvariantCulture)</a></td>
                                <td>@FormatTs(o.TimeUnix)</td>
                                <td>—</td>
                                <td>@(o.Paid != 0 ? "yes" : "no")</td>
                                <td>—</td>
                                <td>@o.Status.ToString(CultureInfo.InvariantCulture)</td>
                                <td>—</td>
                                <td>—</td>
                                <td>
                                    <a href="@StorefrontSurfaceLinks.ForOrder(o.Id)">Open</a>
                                    ·
                                    <a href="@StorefrontSurfaceLinks.ForPrint(o.Id, "sales_receipt")">Receipt</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <script>
            function sortOrders(field) {
                var date = new Date(new Date().getTime() + 15552000 * 1000);
                document.cookie = "my_orders_sort="+JSON.stringify({field:field,asc_desc:"desc"})+"; path=/; expires=" + date.toUTCString();
                location = "@StorefrontAspNetCanonical.Orders";
            }
        </script>

        @if (_items.Count > 0 || _showItems)
        {
            <div class="epc-sf-ord-table-wrap" style="margin-top:1rem">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Brand</th>
                            <th>Article</th>
                            <th>Name</th>
                            <th>Qty</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_items.Count == 0)
                        {
                            <tr><td colspan="6">No order lines yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var line in _items)
                            {
                                <tr>
                                    <td><a href="@StorefrontSurfaceLinks.ForOrder(line.OrderId)">#@line.OrderId.ToString(CultureInfo.InvariantCulture)</a></td>
                                    <td>@(string.IsNullOrWhiteSpace(line.Brand) ? "—" : line.Brand)</td>
                                    <td>@(string.IsNullOrWhiteSpace(line.Article) ? "—" : line.Article)</td>
                                    <td>@(string.IsNullOrWhiteSpace(line.Name) ? "—" : line.Name)</td>
                                    <td>@line.CountNeed.ToString("0.##", CultureInfo.InvariantCulture)</td>
                                    <td>@line.Price.ToString("N2", CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_selected is not null)
        {
            <div class="epc-sf-ord-table-wrap" style="margin-top:1rem;padding:1rem 1.1rem">
                <h2 style="margin:0 0 .55rem;font-size:1.05rem">Order #@_selected.Id.ToString(CultureInfo.InvariantCulture)</h2>
                <p style="margin:0 0 .75rem;color:#475569">
                    @(_selected.Paid != 0 ? "Paid" : "Unpaid")
                    · status @_selected.Status.ToString(CultureInfo.InvariantCulture)
                    · @FormatTs(_selected.TimeUnix)
                </p>
                <p style="margin:0 0 .85rem">
                    <a href="@StorefrontSurfaceLinks.ForPrint(_selected.Id, "sales_receipt")">Receipt</a>
                    ·
                    <a href="@StorefrontSurfaceLinks.ForPrint(_selected.Id, "invoice_for_payment")">Invoice</a>
                    ·
                    <a href="@StorefrontAspNetCanonical.CustomerReturns">Return</a>
                    ·
                    <a href="@(StorefrontAspNetCanonical.Payment + "?order_id=" + _selected.Id.ToString(CultureInfo.InvariantCulture))">Pay</a>
                </p>
                @if (_selected.Paid != 1)
                {
                    <form method="post" action="/storefront/payment/create-operation" style="margin-bottom:1rem">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="order_id" value="@_selected.Id.ToString(CultureInfo.InvariantCulture)" />
                        <input type="hidden" name="pay_handler" value="epc_demo" />
                        <label>Amount <input type="number" step="0.01" min="0.01" name="amount" required style="width:8rem" /></label>
                        <button type="submit" style="padding:.55rem .9rem;border:0;border-radius:.4rem;background:#0f766e;color:#fff;font-weight:800;cursor:pointer">Pay now</button>
                    </form>
                    <a class="btn btn-xs btn-ar btn-default" href="javascript:void(0);" onclick="pay_on_place();">Pay on place</a>
                    <form id="pay_form" name="pay_form" method="post" action="@("/storefront/orders-app?order_id=" + _selected.Id.ToString(CultureInfo.InvariantCulture))" style="display:none;">
                        <input type="hidden" name="action" id="action" value="pay_on_place" />
                        <input type="hidden" name="order_id" value="@_selected.Id.ToString(CultureInfo.InvariantCulture)" />
                        <input type="hidden" name="confirmWrites" value="true" />
                    </form>
                    <script>
                        function pay_on_place() {
                            if (!confirm('Confirm pay on place for this order?')) { return; }
                            document.forms["pay_form"].submit();
                        }
                    </script>
                }
                @if (_messages.Count > 0)
                {
                    <h3 style="margin:0 0 .45rem;font-size:.95rem">Messages</h3>
                    <ul class="epc-sf-ord-msgs" style="list-style:none;margin:0 0 1rem;padding:0">
                        @foreach (var msg in _messages)
                        {
                            <li style="margin:0 0 .55rem;padding:.55rem .7rem;border:1px solid #e5e7eb;border-radius:.4rem;background:#f8fafc">
                                <div style="font-size:.75rem;color:#64748b;margin-bottom:.25rem">
                                    @(msg.IsCustomer != 0 ? "You" : "Store") · @FormatTs(msg.TimeUnix)
                                </div>
                                <div>@msg.Text</div>
                            </li>
                        }
                    </ul>
                }
                <table class="table" style="margin-bottom:1rem">
                    <tbody>
                    @if (_garage.Count == 0)
                    {
                        <tr>
                            <td>No garage vehicles yet.</td>
                            <td><a class="btn btn-xs btn-ar btn-primary pull-right" href="/en/garazh/avtomobil"><i class="fa fa-car"></i> Add vehicle</a></td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var car in _garage)
                        {
                            var carId = car.Id.ToString(CultureInfo.InvariantCulture);
                            <tr class="car_tr_@carId">
                                <td style="padding-top:5px;padding-bottom:6px;vertical-align:middle;width:3rem">
                                    <form method="post" action="@PhpCustomerWrites.GarageCheckCarHref" style="margin:0">
                                        <input type="hidden" name="confirmWrites" value="true" />
                                        <input type="hidden" name="returnUrl" value="@("/storefront/orders-app?order_id=" + _selected.Id.ToString(CultureInfo.InvariantCulture))" />
                                        <input type="hidden" name="orderId" value="@_selected.Id.ToString(CultureInfo.InvariantCulture)" />
                                        <input type="hidden" name="carId" value="@carId" />
                                        <button type="submit" class="btn btn-xs" style="color:#a9a9a9;font-size:14px;border:1px solid #dddddd;" onclick="return check_car(this);">
                                            <i class="fa fa-check" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </td>
                                <td style="line-height:1.1em;width:100%;font-size:12px">
                                    @(string.IsNullOrWhiteSpace(car.Caption) ? ("Vehicle #" + carId) : car.Caption)
                                    @if (!string.IsNullOrWhiteSpace(car.Vin))
                                    {
                                        <br /><small>@car.Vin</small>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
                <script>
                    function check_car(el) { return true; }
                </script>
                <form method="post" action="@PhpCustomerWrites.OrderMessageHref">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@("/storefront/orders-app?order_id=" + _selected.Id.ToString(CultureInfo.InvariantCulture))" />
                    <input type="hidden" name="order_id" value="@_selected.Id.ToString(CultureInfo.InvariantCulture)" />
                    <label for="order_message">Message to the store</label>
                    <textarea id="order_message" name="text" rows="3" required style="width:100%;margin:.25rem 0 .75rem;padding:.5rem"></textarea>
                    <button type="submit" style="padding:.55rem .9rem;border:0;border-radius:.4rem;background:#dc2626;color:#fff;font-weight:800;cursor:pointer">Send message</button>
                </form>
            </div>
        }
        else
        {
            <p style="margin-top:1rem"><a href="@StorefrontAspNetCanonical.GuestOrder">Track a guest order</a></p>
        }
    }

</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private bool _isCustomer;
    private IReadOnlyList<StorefrontOrderDigest> _orders = [];
    private IReadOnlyList<StorefrontOrderDigest> _shownOrders = [];
    private MyOrdersFilter _filter = MyOrdersFilter.Empty;
    private int _paid;
    private int _created;
    private int _limit = 25;
    private string _source = "n/a";
    private string _message = "";
    private StorefrontOrderDigest? _selected;
    private IReadOnlyList<StorefrontOrderItemDigest> _items = [];
    private IReadOnlyList<StorefrontOrderMessageDigest> _messages = [];
    private bool _showItems;
    private string _flashOk = "";
    private string _flashErr = "";
    private IReadOnlyList<StorefrontGarageVehicleDigest> _garage = [];

    [SupplyParameterFromQuery(Name = "order_id")]
    public long? OrderId { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);
        _flashOk = ctx.Request.Query["ok"].ToString();
        _flashErr = ctx.Request.Query["err"].ToString();

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Customer || session.UserId <= 0)
        {
            _isCustomer = false;
            return;
        }

        _isCustomer = true;
        ctx.Request.Cookies.TryGetValue("my_orders_filter", out var filterCookie);
        _filter = MyOrdersFilter.Parse(filterCookie);
        var result = await Dashboards.ListStorefrontOrdersAsync(session.UserId, _limit, ctx.RequestAborted);
        _orders = result.Orders;
        _shownOrders = _filter.Apply(_orders);
        _paid = _shownOrders.Count(o => o.Paid != 0);
        _created = _shownOrders.Count(o => o.SuccessfullyCreated != 0);
        _source = result.Source;
        _message = result.Message;
        var path = ctx.Request.Path.Value ?? string.Empty;
        _showItems = path.Contains("/items", StringComparison.OrdinalIgnoreCase)
                     || string.Equals(View, "items", StringComparison.OrdinalIgnoreCase);
        if (OrderId is > 0)
        {
            _selected = _orders.FirstOrDefault(o => o.Id == OrderId.Value);
        }

        if (_showItems || _selected is not null)
        {
            var lines = await Dashboards.ListStorefrontOrderItemsAsync(
                session.UserId,
                _selected?.Id ?? 0,
                100,
                ctx.RequestAborted);
            _items = lines.Items;
        }

        if (_selected is not null)
        {
            var thread = await Dashboards.ListStorefrontOrderMessagesAsync(
                session.UserId,
                _selected.Id,
                80,
                ctx.RequestAborted);
            _messages = thread.Messages;
            var garage = await Dashboards.ListStorefrontGarageAsync(session.UserId, 50, ctx.RequestAborted);
            _garage = garage.Vehicles;
        }
    }

    private static string FormatTs(long ts)
    {
        if (ts <= 0) return "—";
        try
        {
            return DateTimeOffset.FromUnixTimeSeconds(ts).UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC";
        }
        catch (ArgumentOutOfRangeException)
        {
            return ts.ToString(CultureInfo.InvariantCulture);
        }
    }

    private sealed record MyOrdersFilter(
        string TimeFrom,
        string TimeTo,
        string OrderId,
        string Status,
        string Paid,
        string PaidType,
        string Garage)
    {
        public static MyOrdersFilter Empty { get; } = new("", "", "", "0", "-1", "-1", "0");

        public static MyOrdersFilter Parse(string? cookie)
        {
            if (string.IsNullOrWhiteSpace(cookie))
            {
                return Empty;
            }

            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(Uri.UnescapeDataString(cookie));
                var r = doc.RootElement;
                return new(
                    Read(r, "time_from"),
                    Read(r, "time_to"),
                    Read(r, "order_id"),
                    Read(r, "status", "0"),
                    Read(r, "paid", "-1"),
                    Read(r, "paid_type", "-1"),
                    Read(r, "garage", "0"));
            }
            catch (Exception)
            {
                return Empty;
            }
        }

        public IReadOnlyList<StorefrontOrderDigest> Apply(IReadOnlyList<StorefrontOrderDigest> source)
        {
            IEnumerable<StorefrontOrderDigest> q = source;
            var id = Uri.UnescapeDataString(OrderId ?? "");
            if (!string.IsNullOrWhiteSpace(id) && long.TryParse(id, out var orderId))
            {
                q = q.Where(o => o.Id == orderId);
            }

            var paid = Uri.UnescapeDataString(Paid ?? "-1");
            if (paid == "1")
            {
                q = q.Where(o => o.Paid != 0);
            }
            else if (paid == "0")
            {
                q = q.Where(o => o.Paid == 0);
            }

            var status = Uri.UnescapeDataString(Status ?? "0");
            if (status != "0" && int.TryParse(status, out var st) && st != 0)
            {
                q = q.Where(o => o.Status == st);
            }

            var from = Uri.UnescapeDataString(TimeFrom ?? "");
            if (long.TryParse(from, out var fromTs) && fromTs > 0)
            {
                q = q.Where(o => o.TimeUnix >= fromTs);
            }

            var to = Uri.UnescapeDataString(TimeTo ?? "");
            if (long.TryParse(to, out var toTs) && toTs > 0)
            {
                q = q.Where(o => o.TimeUnix <= toTs);
            }

            return q.ToArray();
        }

        private static string Read(System.Text.Json.JsonElement root, string name, string fallback = "")
        {
            if (!root.TryGetProperty(name, out var el))
            {
                return fallback;
            }

            var raw = el.ValueKind == System.Text.Json.JsonValueKind.String ? el.GetString() ?? fallback : el.ToString();
            return string.IsNullOrWhiteSpace(raw) ? fallback : raw;
        }
    }
}
