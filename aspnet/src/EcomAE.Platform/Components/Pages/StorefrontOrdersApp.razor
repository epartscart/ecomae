@page "/storefront/orders-app"
@page "/en/shop/orders"
@page "/shop/orders"
@page "/en/shop/orders/order"
@page "/shop/orders/order"
@page "/en/shop/orders/items"
@page "/shop/orders/items"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>My Orders · @_brand</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        
        .epc-sf-ord-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-sf-ord-cta a {
            display:inline-flex; padding:.5rem .85rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0c4a6e; background:#fee2e2;
        }
        .epc-sf-ord-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-sf-ord-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-sf-ord-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-sf-ord-kpi strong { display:block; font-size:1.35rem; font-variant-numeric:tabular-nums; }
        .epc-sf-ord-kpi span { color:#64748b; font-size:.78rem; }
        .epc-sf-ord-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-sf-ord-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-sf-ord-table th, .epc-sf-ord-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-sf-ord-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-sf-ord-table a { color:#0e7490; font-weight:700; text-decoration:none; }
        .epc-sf-ord-badge { display:inline-flex; padding:.15rem .45rem; border-radius:.3rem; font-size:.72rem; font-weight:700; }
        .epc-sf-ord-badge--ok { background:#cffafe; color:#155e75; }
        .epc-sf-ord-badge--off { background:#fee2e2; color:#991b1b; }
        .epc-sf-ord-badge--info { background:#e2e8f0; color:#334155; }
        .epc-sf-ord-note { margin-top:1rem; padding:.75rem .9rem; background:#ecfeff; border:1px solid #a5f3fc; border-radius:.45rem; color:#155e75; font-size:.86rem; }
        .epc-sf-ord-gate { padding:1.25rem; background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; }
        @@media (max-width:900px){ .epc-sf-ord-kpis{grid-template-columns:1fr;} }
    
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontTenantChrome>

    <PhpStorefrontPageHeader Title="My Orders"
                            Subtitle="Browse parts, manage your garage, and track recent orders.">
        <a class="btn btn-sm btn-primary" href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpOrders)">Open orders</a>
            <a class="btn btn-sm btn-default" href="/storefront/cart-app">Cart</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.PartSearch">Search parts</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Login">Customer login</a>
    </PhpStorefrontPageHeader>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#ecfdf3;border:1px solid #86efac;color:#166534">@_flashOk</p>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <p style="margin:0 0 .75rem;padding:.65rem .8rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b">@_flashErr</p>
    }

    @if (!_isCustomer)
    {
        <div class="epc-sf-ord-gate">
            <p style="margin:0 0 .75rem;color:#334155">Sign in with your store account to load recent orders.</p>
            <a href="/storefront/login" style="display:inline-flex;padding:.55rem .9rem;border-radius:.4rem;background:#dc2626;color:#fff;font-weight:700;text-decoration:none">Sign in</a>
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpOrders)" style="display:inline-flex;margin-left:.45rem;padding:.55rem .9rem;border-radius:.4rem;border:1px solid #d1d5db;color:#111;font-weight:700;text-decoration:none">Orders</a>
        </div>
    }
    else
    {
        <div class="epc-sf-ord-kpis" aria-label="Orders KPIs">
            <div class="epc-sf-ord-kpi"><strong>@_orders.Count</strong><span>Shown (limit @_limit)</span></div>
            <div class="epc-sf-ord-kpi"><strong>@_paid</strong><span>Paid</span></div>
            <div class="epc-sf-ord-kpi"><strong>@_created</strong><span>Successfully created</span></div>
        </div>

        <div class="epc-sf-ord-table-wrap">
            <table class="epc-sf-ord-table">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>When</th>
                        <th>Paid</th>
                        <th>Created</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_orders.Count == 0)
                    {
                        <tr><td colspan="6">Nothing to show yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var o in _orders)
                        {
                            <tr>
                                <td><strong>@o.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                                <td>@FormatTs(o.TimeUnix)</td>
                                <td><span class="epc-sf-ord-badge @(o.Paid != 0 ? "epc-sf-ord-badge--ok" : "epc-sf-ord-badge--off")">@(o.Paid != 0 ? "yes" : "no")</span></td>
                                <td><span class="epc-sf-ord-badge @(o.SuccessfullyCreated != 0 ? "epc-sf-ord-badge--ok" : "epc-sf-ord-badge--info")">@(o.SuccessfullyCreated != 0 ? "yes" : "no")</span></td>
                                <td><span class="epc-sf-ord-badge epc-sf-ord-badge--info">@o.Status.ToString(CultureInfo.InvariantCulture)</span></td>
                                <td>
                                    <a href="@StorefrontSurfaceLinks.ForOrder(o.Id)">Open</a>
                                    ·
                                    <a href="@StorefrontSurfaceLinks.ForPrint(o.Id, "sales_receipt")">Receipt</a>
                                    ·
                                    <a href="@StorefrontSurfaceLinks.ForPrint(o.Id, "invoice_for_payment")">Invoice</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_items.Count > 0 || _showItems)
        {
            <div class="epc-sf-ord-table-wrap" style="margin-top:1rem">
                <table class="epc-sf-ord-table">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Brand</th>
                            <th>Article</th>
                            <th>Name</th>
                            <th>Qty</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_items.Count == 0)
                        {
                            <tr><td colspan="6">No order lines yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var line in _items)
                            {
                                <tr>
                                    <td><a href="@StorefrontSurfaceLinks.ForOrder(line.OrderId)">#@line.OrderId.ToString(CultureInfo.InvariantCulture)</a></td>
                                    <td>@(string.IsNullOrWhiteSpace(line.Brand) ? "—" : line.Brand)</td>
                                    <td>@(string.IsNullOrWhiteSpace(line.Article) ? "—" : line.Article)</td>
                                    <td>@(string.IsNullOrWhiteSpace(line.Name) ? "—" : line.Name)</td>
                                    <td>@line.CountNeed.ToString("0.##", CultureInfo.InvariantCulture)</td>
                                    <td>@line.Price.ToString("N2", CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_selected is not null)
        {
            <div class="epc-sf-ord-table-wrap" style="margin-top:1rem;padding:1rem 1.1rem">
                <h2 style="margin:0 0 .55rem;font-size:1.05rem">Order #@_selected.Id.ToString(CultureInfo.InvariantCulture)</h2>
                <p style="margin:0 0 .75rem;color:#475569">
                    @(_selected.Paid != 0 ? "Paid" : "Unpaid")
                    · status @_selected.Status.ToString(CultureInfo.InvariantCulture)
                    · @FormatTs(_selected.TimeUnix)
                </p>
                <p style="margin:0 0 .85rem">
                    <a href="@StorefrontSurfaceLinks.ForPrint(_selected.Id, "sales_receipt")">Receipt</a>
                    ·
                    <a href="@StorefrontSurfaceLinks.ForPrint(_selected.Id, "invoice_for_payment")">Invoice</a>
                    ·
                    <a href="@StorefrontAspNetCanonical.CustomerReturns">Return</a>
                    ·
                    <a href="@StorefrontAspNetCanonical.Payment">Pay</a>
                </p>
                <form method="post" action="@PhpCustomerWrites.OrderWriteHref" style="margin-bottom:1rem">
                    <input type="hidden" name="order_id" value="@_selected.Id.ToString(CultureInfo.InvariantCulture)" />
                    <input type="hidden" name="action" value="pay_on_place" />
                    <button type="submit" style="padding:.55rem .9rem;border:0;border-radius:.4rem;background:#0f766e;color:#fff;font-weight:800;cursor:pointer">Pay on collection</button>
                </form>
                @if (_messages.Count > 0)
                {
                    <h3 style="margin:0 0 .45rem;font-size:.95rem">Messages</h3>
                    <ul class="epc-sf-ord-msgs" style="list-style:none;margin:0 0 1rem;padding:0">
                        @foreach (var msg in _messages)
                        {
                            <li style="margin:0 0 .55rem;padding:.55rem .7rem;border:1px solid #e5e7eb;border-radius:.4rem;background:#f8fafc">
                                <div style="font-size:.75rem;color:#64748b;margin-bottom:.25rem">
                                    @(msg.IsCustomer != 0 ? "You" : "Store") · @FormatTs(msg.TimeUnix)
                                </div>
                                <div>@msg.Text</div>
                            </li>
                        }
                    </ul>
                }
                <form method="post" action="@PhpCustomerWrites.OrderMessageHref">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="@("/storefront/orders-app?order_id=" + _selected.Id.ToString(CultureInfo.InvariantCulture))" />
                    <input type="hidden" name="order_id" value="@_selected.Id.ToString(CultureInfo.InvariantCulture)" />
                    <label for="order_message">Message to the store</label>
                    <textarea id="order_message" name="text" rows="3" required style="width:100%;margin:.25rem 0 .75rem;padding:.5rem"></textarea>
                    <button type="submit" style="padding:.55rem .9rem;border:0;border-radius:.4rem;background:#dc2626;color:#fff;font-weight:800;cursor:pointer">Send message</button>
                </form>
            </div>
        }
        else
        {
            <p style="margin-top:1rem"><a href="@StorefrontAspNetCanonical.GuestOrder">Track a guest order</a></p>
        }
    }

</StorefrontTenantChrome>

@code {
    private const string _phpOrders = "https://epartscart.com/shop/orders";
    private string _brand = "eParts Cart";
    private bool _isCustomer;
    private IReadOnlyList<StorefrontOrderDigest> _orders = [];
    private int _paid;
    private int _created;
    private int _limit = 25;
    private string _source = "n/a";
    private string _message = "";
    private StorefrontOrderDigest? _selected;
    private IReadOnlyList<StorefrontOrderItemDigest> _items = [];
    private IReadOnlyList<StorefrontOrderMessageDigest> _messages = [];
    private bool _showItems;
    private string _flashOk = "";
    private string _flashErr = "";

    [SupplyParameterFromQuery(Name = "order_id")]
    public long? OrderId { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);
        _flashOk = ctx.Request.Query["ok"].ToString();
        _flashErr = ctx.Request.Query["err"].ToString();

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Customer || session.UserId <= 0)
        {
            _isCustomer = false;
            return;
        }

        _isCustomer = true;
        var result = await Dashboards.ListStorefrontOrdersAsync(session.UserId, _limit, ctx.RequestAborted);
        _orders = result.Orders;
        _paid = _orders.Count(o => o.Paid != 0);
        _created = _orders.Count(o => o.SuccessfullyCreated != 0);
        _source = result.Source;
        _message = result.Message;
        var path = ctx.Request.Path.Value ?? string.Empty;
        _showItems = path.Contains("/items", StringComparison.OrdinalIgnoreCase)
                     || string.Equals(View, "items", StringComparison.OrdinalIgnoreCase);
        if (OrderId is > 0)
        {
            _selected = _orders.FirstOrDefault(o => o.Id == OrderId.Value);
        }

        if (_showItems || _selected is not null)
        {
            var lines = await Dashboards.ListStorefrontOrderItemsAsync(
                session.UserId,
                _selected?.Id ?? 0,
                100,
                ctx.RequestAborted);
            _items = lines.Items;
        }

        if (_selected is not null)
        {
            var thread = await Dashboards.ListStorefrontOrderMessagesAsync(
                session.UserId,
                _selected.Id,
                80,
                ctx.RequestAborted);
            _messages = thread.Messages;
        }
    }

    private static string FormatTs(long ts)
    {
        if (ts <= 0) return "—";
        try
        {
            return DateTimeOffset.FromUnixTimeSeconds(ts).UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC";
        }
        catch (ArgumentOutOfRangeException)
        {
            return ts.ToString(CultureInfo.InvariantCulture);
        }
    }
}
