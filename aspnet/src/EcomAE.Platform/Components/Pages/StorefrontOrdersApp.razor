@page "/storefront/orders-app"
@page "/en/shop/orders"
@page "/en/shop/orders/order"
@page "/en/shop/orders/items"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>My Orders · @_brand</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        
        .epc-sf-ord-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-sf-ord-cta a {
            display:inline-flex; padding:.5rem .85rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0c4a6e; background:#fee2e2;
        }
        .epc-sf-ord-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-sf-ord-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-sf-ord-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-sf-ord-kpi strong { display:block; font-size:1.35rem; font-variant-numeric:tabular-nums; }
        .epc-sf-ord-kpi span { color:#64748b; font-size:.78rem; }
        .epc-sf-ord-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-sf-ord-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-sf-ord-table th, .epc-sf-ord-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-sf-ord-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-sf-ord-table a { color:#0e7490; font-weight:700; text-decoration:none; }
        .epc-sf-ord-badge { display:inline-flex; padding:.15rem .45rem; border-radius:.3rem; font-size:.72rem; font-weight:700; }
        .epc-sf-ord-badge--ok { background:#cffafe; color:#155e75; }
        .epc-sf-ord-badge--off { background:#fee2e2; color:#991b1b; }
        .epc-sf-ord-badge--info { background:#e2e8f0; color:#334155; }
        .epc-sf-ord-note { margin-top:1rem; padding:.75rem .9rem; background:#ecfeff; border:1px solid #a5f3fc; border-radius:.45rem; color:#155e75; font-size:.86rem; }
        .epc-sf-ord-gate { padding:1.25rem; background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; }
        @@media (max-width:900px){ .epc-sf-ord-kpis{grid-template-columns:1fr;} }
    
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontTenantChrome>

    <PhpStorefrontPageHeader Title="My Orders"
                            Subtitle="Browse parts, manage your garage, and track recent orders.">
        <a class="btn btn-sm btn-primary" href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpOrders)">Open orders</a>
            <a class="btn btn-sm btn-default" href="/storefront/cart-app">Cart</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.PartSearch">Search parts</a>
            <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.Login">Customer login</a>
    </PhpStorefrontPageHeader>

    @if (!_isCustomer)
    {
        <div class="epc-sf-ord-gate">
            <p style="margin:0 0 .75rem;color:#334155">Sign in with your store account to load recent orders.</p>
            <a href="/storefront/login" style="display:inline-flex;padding:.55rem .9rem;border-radius:.4rem;background:#dc2626;color:#fff;font-weight:700;text-decoration:none">Sign in</a>
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpOrders)" style="display:inline-flex;margin-left:.45rem;padding:.55rem .9rem;border-radius:.4rem;border:1px solid #d1d5db;color:#111;font-weight:700;text-decoration:none">Orders</a>
        </div>
    }
    else
    {
        <div class="epc-sf-ord-kpis" aria-label="Orders KPIs">
            <div class="epc-sf-ord-kpi"><strong>@_orders.Count</strong><span>Shown (limit @_limit)</span></div>
            <div class="epc-sf-ord-kpi"><strong>@_paid</strong><span>Paid</span></div>
            <div class="epc-sf-ord-kpi"><strong>@_created</strong><span>Successfully created</span></div>
        </div>

        <div class="epc-sf-ord-table-wrap">
            <table class="epc-sf-ord-table">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>When</th>
                        <th>Paid</th>
                        <th>Created</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_orders.Count == 0)
                    {
                        <tr><td colspan="6">Nothing to show yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var o in _orders)
                        {
                            <tr>
                                <td><strong>@o.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                                <td>@FormatTs(o.TimeUnix)</td>
                                <td><span class="epc-sf-ord-badge @(o.Paid != 0 ? "epc-sf-ord-badge--ok" : "epc-sf-ord-badge--off")">@(o.Paid != 0 ? "yes" : "no")</span></td>
                                <td><span class="epc-sf-ord-badge @(o.SuccessfullyCreated != 0 ? "epc-sf-ord-badge--ok" : "epc-sf-ord-badge--info")">@(o.SuccessfullyCreated != 0 ? "yes" : "no")</span></td>
                                <td><span class="epc-sf-ord-badge epc-sf-ord-badge--info">@o.Status.ToString(CultureInfo.InvariantCulture)</span></td>
                                <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpOrders)">Open module</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

</StorefrontTenantChrome>

@code {
    private const string _phpOrders = "https://epartscart.com/shop/orders";
    private string _brand = "eParts Cart";
    private bool _isCustomer;
    private IReadOnlyList<StorefrontOrderDigest> _orders = [];
    private int _paid;
    private int _created;
    private int _limit = 25;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Customer || session.UserId <= 0)
        {
            _isCustomer = false;
            return;
        }

        _isCustomer = true;
        var result = await Dashboards.ListStorefrontOrdersAsync(session.UserId, _limit, ctx.RequestAborted);
        _orders = result.Orders;
        _paid = _orders.Count(o => o.Paid != 0);
        _created = _orders.Count(o => o.SuccessfullyCreated != 0);
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTs(long ts)
    {
        if (ts <= 0) return "—";
        try
        {
            return DateTimeOffset.FromUnixTimeSeconds(ts).UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC";
        }
        catch (ArgumentOutOfRangeException)
        {
            return ts.ToString(CultureInfo.InvariantCulture);
        }
    }
}
