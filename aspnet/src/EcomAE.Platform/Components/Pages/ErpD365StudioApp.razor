@page "/erp/d365-studio"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@using System.Text
@using System.Web
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@using EcomAE.Platform.Cp
@inject ICpCsrfGuard Csrf
@inject IErpWriteConnectionFactory Connections
@inject IErpD365DocCycleService D365
@inject IErpD365GlService Gl

<PageTitle>D365 studio · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<style>
    .tg-card { background:#fff; border:1px solid #dde6ee; border-radius:10px; padding:16px 18px; margin:0 0 16px; box-shadow:0 1px 2px rgba(16,42,66,.05); }
    .tg-card h3 { margin:0 0 8px; font-size:15px; color:#12324f; }
    .tg-card p, .tg-card li { font-size:12.5px; color:#40566c; line-height:1.55; }
    .tg-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:14px; }
    .tg-form label { display:block; font-size:11px; color:#4a627a; margin:8px 0 2px; }
    .tg-form input, .tg-form select, .tg-form textarea { width:100%; box-sizing:border-box; border:1px solid #c3d3de; border-radius:6px; padding:6px 8px; font-size:12.5px; }
    .tg-form button { margin-top:10px; background:#12324f; color:#fff; border:0; border-radius:6px; padding:7px 14px; font-size:12.5px; cursor:pointer; }
    .tg-form textarea { min-height:110px; font-family:ui-monospace,monospace; font-size:11px; }
    .tg-flash { border-radius:8px; padding:10px 14px; margin:0 0 16px; font-size:13px; }
    .tg-flash-ok { background:#e8f6ee; border:1px solid #9fd8b6; color:#0f6b3f; }
    .tg-flash-err { background:#fdeaea; border:1px solid #f0b4b4; color:#9c1c1c; }
    .tg-table { width:100%; border-collapse:collapse; font-size:12px; }
    .tg-table th, .tg-table td { border-bottom:1px solid #e4ecf2; padding:6px 8px; text-align:left; }
    .tg-table th { color:#12324f; background:#f4f8fb; }
    .tg-links a { margin-right:12px; font-size:12px; }
</style>

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="D365 studio" BreadcrumbArea="Organization" BreadcrumbTab="D365 studio">
    <PhpErpModulePageHeader
        Title="D365 studio"
        Subtitle="Per-legal-entity document header/footer (used by every PDF), D365 field saves on documents and masters, and CSV bulk load/export for opening data — the same shapes as Finance and Operations."
        PhpTabHref="/erp/d365-studio" />

    @if (_flashOk.Length > 0)
    {
        <div class="tg-flash tg-flash-ok">@_flashOk</div>
    }
    @if (_flashErr.Length > 0)
    {
        <div class="tg-flash tg-flash-err">@_flashErr</div>
    }

    <div class="tg-grid">
        <div class="tg-card tg-form">
            <h3>Legal entity document profile (header / footer)</h3>
            <p>Saved per legal entity — drives the TAX INVOICE and DELIVERY NOTE letterhead, TRN, bank and footer. Entity id 0 = tenant-wide fallback.</p>
            <form method="post" action="@Post("/erp/d365/doc-profile-set")">
                @HiddenFields()
                <label>Legal entity id</label><input name="entity_id" value="@_entityId" required />
                <label>Legal name</label><input name="legal_name" value="@P("legal_name")" required />
                <label>Trade name</label><input name="trade_name" value="@P("trade_name")" />
                <label>TRN</label><input name="trn" value="@P("trn")" />
                <label>Address line 1 / 2</label><input name="address_line1" value="@P("address_line1")" /><input name="address_line2" value="@P("address_line2")" />
                <label>City / Emirate / Country</label><input name="city" value="@P("city")" /><input name="emirate" value="@P("emirate")" /><input name="country_code" value="@P("country_code")" />
                <label>Phone / Fax / Email</label><input name="phone" value="@P("phone")" /><input name="fax" value="@P("fax")" /><input name="email" value="@P("email")" />
                <label>Bank name / IBAN</label><input name="bank_name" value="@P("bank_name")" /><input name="bank_iban" value="@P("bank_iban")" />
                <label>Legal footer</label><input name="legal_footer" value="@P("legal_footer")" />
                <label>Header note / Footer note</label><input name="doc_header_note" value="@P("doc_header_note")" /><input name="doc_footer_note" value="@P("doc_footer_note")" />
                <label>Logo URL</label><input name="logo_url" value="@P("logo_url")" />
                <button type="submit">Save document profile</button>
            </form>
        </div>

        <div class="tg-card tg-form">
            <h3>Save D365 fields on a record</h3>
            <p>Writes any captured F&O fields onto an existing row — unknown names are ignored, so paste field=value pairs straight from the study list.</p>
            <form method="post" action="@Post("/erp/d365/fields-save")">
                @HiddenFields()
                <label>Record kind</label>
                <select name="kind">
                    <option value="so">Sales order header</option>
                    <option value="po">Purchase order header</option>
                    <option value="dn">Delivery note</option>
                    <option value="customer">Customer</option>
                    <option value="vendor">Vendor</option>
                    <option value="product">Released product attributes</option>
                    <option value="warehouse">Warehouse (InventLocations fields)</option>
                    <option value="quote">Sales quotation header</option>
                    <option value="quote_line">Sales quotation line (id = quotation id)</option>
                </select>
                <label>Record id (blank = create new, quotation only)</label><input name="id" type="number" min="0" value="0" />
                <label>Fields (one per line: name=value)</label><textarea name="fields_kv" placeholder="warehouse=ASAP-WSL&#10;mode_of_delivery=Sea&#10;delivery_terms=CIF"></textarea>
                <button type="submit">Save fields</button>
            </form>
        </div>
    </div>

    <h3 style="margin:18px 0 10px;color:#12324f">Opening data — CSV import &amp; export</h3>
    <div class="tg-card">
        <p>Download the template, fill it, paste back into the box, commit. Natural-key upsert (sku / account / voucher no), so re-running is safe. Order CSVs carry header fields plus one line per row — repeat the document number for multiple lines.</p>
        <table class="tg-table">
            <thead><tr><th>Area</th><th>Required</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var a in ErpD365BulkCsv.Areas.Values)
                {
                    <tr>
                        <td><strong>@a.Label</strong> <code>@a.Key</code></td>
                        <td>@string.Join(", ", a.Required)</td>
                        <td class="tg-links">
                            <a href="@Get("/erp/d365/csv-template")?area=@a.Key">template</a>
                            <a href="@Get("/erp/d365/csv-export")?area=@a.Key">export CSV</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="tg-card tg-form">
        <h3>Import CSV</h3>
        <form method="post" action="@Post("/erp/d365/csv-import")">
            @HiddenFields()
            <label>Area</label>
            <select name="area">
                @foreach (var a in ErpD365BulkCsv.Areas.Values)
                {
                    <option value="@a.Key">@a.Label</option>
                }
            </select>
            <label>CSV content (header row + data rows)</label><textarea name="csv" placeholder="sku,name,unit&#10;ABC-001,Brake pad,pcs" required></textarea>
            <button type="submit">Validate + commit import</button>
        </form>
    </div>

    <div class="tg-card tg-form">
        <h3>Document PDFs</h3>
        <p>Sales invoice uses the wholesale TAX INVOICE layout with the entity's letterhead; delivery note renders the consignment/packing/delivery sections.</p>
        <form method="get" action="@Get("/erp/d365/invoice-pdf")" target="_blank" style="display:flex;gap:8px;align-items:end">
            <label style="flex:1">Invoice id<input name="id" type="number" min="1" required /></label>
            <button type="submit">Invoice PDF</button>
        </form>
        <form method="get" action="@Get("/erp/d365/delivery-pdf")" target="_blank" style="display:flex;gap:8px;align-items:end;margin-top:8px">
            <label style="flex:1">Delivery note id<input name="id" type="number" min="1" required /></label>
            <button type="submit">Delivery note PDF</button>
        </form>
        <form method="get" action="@Get("/erp/d365/quote-pdf")" target="_blank" style="display:flex;gap:8px;align-items:end;margin-top:8px">
            <label style="flex:1">Quotation id<input name="id" type="number" min="1" required /></label>
            <button type="submit">Quotation PDF</button>
        </form>
    </div>

    <div class="tg-card tg-form">
        <h3>GL foundation — dimensions, calendars, FX, banks, COA</h3>
        <p>Dimension types (legal entity, business unit, cost centre…), dimension sets (<code>main_account&gt;business_unit&gt;cost_centre</code>), fiscal calendars, exchange rates, bank accounts, journal line dimensions, and MainAccountDetails fields on COA.</p>
        <form method="post" action="@Post("/erp/d365/gl-save")">
            @HiddenFields()
            <label>Kind</label>
            <select name="kind">
                <option value="dim_type">Dimension type (code,name)</option>
                <option value="dim_value">Dimension value (type_id,value_code,value_name)</option>
                <option value="dim_set">Dimension set (code,name,composition)</option>
                <option value="fiscal_calendar">Fiscal calendar (code,year,period_type,start_date,end_date,status)</option>
                <option value="fx_rate">Exchange rate (from_currency,to_currency,rate,rate_date)</option>
                <option value="bank">Bank account</option>
                <option value="journal_dims">Journal line dimensions (line_id + dim fields)</option>
                <option value="coa">COA account fields</option>
            </select>
            <label>Id (0 = create)</label><input name="id" type="number" min="0" value="0" />
            <label>Fields (name=value per line)</label><textarea name="fields_kv" placeholder="code=MA-BU-CC&#10;name=Main by BU by CC&#10;composition=main_account>business_unit>cost_centre"></textarea>
            <button type="submit">Save GL setup</button>
        </form>
        <form method="post" action="@Post("/erp/d365/bank-recon")" style="margin-top:10px;display:flex;gap:8px;align-items:end">
            @HiddenFields()
            <label style="flex:1">Cash/bank entry id<input name="entry_id" type="number" min="1" required /></label>
            <label>Reconciled<select name="reconciled"><option value="1">Reconciled</option><option value="0">Unreconciled</option></select></label>
            <button type="submit">Set</button>
        </form>
        @if (_dimTypes.Count > 0 || _dimSets.Count > 0 || _fiscal.Count > 0 || _banks.Count > 0)
        {
            <h4 style="margin:12px 0 4px">Current setup</h4>
            <table class="tg-table">
                <thead><tr><th>Area</th><th>Code</th><th>Name / detail</th></tr></thead>
                <tbody>
                    @foreach (var t in _dimTypes)
                    {<tr><td>Dimension type</td><td>@t.GetValueOrDefault("code")</td><td>@t.GetValueOrDefault("name")</td></tr>}
                    @foreach (var s in _dimSets)
                    {<tr><td>Dimension set</td><td>@s.GetValueOrDefault("code")</td><td>@s.GetValueOrDefault("name") — @s.GetValueOrDefault("composition")</td></tr>}
                    @foreach (var f in _fiscal)
                    {<tr><td>Fiscal calendar</td><td>@f.GetValueOrDefault("code") @f.GetValueOrDefault("year")</td><td>@f.GetValueOrDefault("period_type") — @f.GetValueOrDefault("status")</td></tr>}
                    @foreach (var b in _banks)
                    {<tr><td>Bank account</td><td>@b.GetValueOrDefault("bank_account")</td><td>@b.GetValueOrDefault("name") — @b.GetValueOrDefault("bank_group")</td></tr>}
                </tbody>
            </table>
        }
        <p style="margin-top:8px">TB pivot by set: <code>/erp/d365/tb-set?set=&lt;id&gt;</code> returns debit/credit per set member.</p>
    </div>

    <div class="tg-card tg-form">
        <h3>Journals — general, customer payment, vendor payment</h3>
        <p>LedgerJournalTable3 / _CustPaym / Table5 style: one header + dimensioned lines. Each line: <code>account_code|debit|credit|note|business_unit_id|cost_centre_id|legal_entity_id</code>.</p>
        <form method="post" action="@Post("/erp/d365/journal-post")">
            @HiddenFields()
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px">
                <label>Journal type
                    <select name="journal_type">
                        <option value="general">General journal</option>
                        <option value="customer_payment">Customer payment</option>
                        <option value="vendor_payment">Vendor payment</option>
                    </select>
                </label>
                <label>Reference<input name="reference" /></label>
                <label>Currency<input name="currency_code" value="AED" /></label>
                <label>Description<input name="description" /></label>
                <label>Legal entity id<input name="entity" type="number" min="0" value="0" /></label>
                <label>Business unit id<input name="business_unit_id" type="number" min="0" value="0" /></label>
            </div>
            <label>Lines</label><textarea name="lines" placeholder="1111001|1000.00|0|Payment received|1|0|1&#10;3101001|0|1000.00|Bank|1|0|1" required></textarea>
            <button type="submit">Post journal</button>
        </form>
    </div>

    <div class="tg-card tg-form">
        <h3>Sales quotation — create, lifecycle, print</h3>
        <p>New quotation: pick kind <code>quote</code> in the fields form above and leave id blank (include <code>quote_no</code>, <code>customer_name</code>…). Add lines with kind <code>quote_line</code> and id = quotation id.</p>
        <form method="post" action="@Post("/erp/d365/quote-status")">
            @HiddenFields()
            <div style="display:flex;gap:8px;align-items:end">
                <label style="flex:1">Quotation id<input name="id" type="number" min="1" required /></label>
                <label style="flex:1">Status
                    <select name="status">
                        <option value="sent">Sent</option>
                        <option value="confirmed">Confirmed</option>
                        <option value="rejected">Rejected</option>
                        <option value="expired">Expired</option>
                        <option value="cancelled">Cancelled</option>
                    </select>
                </label>
                <button type="submit">Set status</button>
            </div>
        </form>
    </div>

    <div class="tg-card">
        <h3>Warehouses (InventLocations)</h3>
        <p>Fields saved via the D365 field form above (kind=warehouse): site, type, entity, cost centre (SHAM links warehouses to cost centres), business unit, allow-negative, cycle counting, retail flags.</p>
        <table class="tg-table">
            <thead><tr><th>Id</th><th>Code</th><th>Name</th><th>Entity</th><th>Site</th><th>Type</th><th>Cost centre</th><th>BU</th></tr></thead>
            <tbody>
                @foreach (var r in _warehouses)
                {
                    <tr><td>@R(r,"id")</td><td>@R(r,"code")</td><td>@R(r,"name")</td><td>@R(r,"entity_id")</td><td>@R(r,"site")</td><td>@R(r,"type")</td><td>@R(r,"cost_centre_id")</td><td>@R(r,"business_unit_id")</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="tg-card">
        <h3>Prospects → customer / vendor (smmBusinessRelations)</h3>
        <p>Convert a qualified prospect into a customer or vendor master — the D365 prospect conversion flow. Already-converted prospects show their party id.</p>
        <table class="tg-table">
            <thead><tr><th>#</th><th>Company</th><th>Contact</th><th>Email</th><th>Phone</th><th>Status</th><th>Convert</th></tr></thead>
            <tbody>
                @foreach (var r in _prospects)
                {
                    <tr>
                        <td>@R(r,"id")</td><td>@R(r,"company")</td><td>@R(r,"contact_name")</td>
                        <td>@R(r,"email")</td><td>@R(r,"phone")</td>
                        <td>@R(r,"status")@(R(r,"converted_party_id") is { Length: >0 } cp && cp != "0" ? (cp == "-1" ? " (converting…)" : " → " + R(r,"converted_party_type") + " #" + cp) : "")</td>
                        <td>
                            @if (R(r,"status") != "converted")
                            {
                                <form method="post" action="@Post("/erp/d365/prospect-convert")" style="display:flex;gap:6px">
                                    @HiddenFields()
                                    <input type="hidden" name="lead_id" value="@R(r,"id")" />
                                    <button type="submit" name="party" value="customer" style="padding:2px 8px;font-size:11px">→ Customer</button>
                                    <button type="submit" name="party" value="vendor" style="padding:2px 8px;font-size:11px">→ Vendor</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="tg-card">
        <h3>Invoice journals (CustInvoiceJournal / VendInvoiceJournal)</h3>
        <div class="tg-grid">
            <div>
                <p><strong>Customer invoices</strong> <a href="@Get("/erp/d365/csv-export")?area=customer_invoice_journal">export CSV</a></p>
                <table class="tg-table">
                    <thead><tr><th>Invoice</th><th>Date</th><th>Cur</th><th>Net</th><th>VAT</th><th>Total</th><th>Paid</th></tr></thead>
                    <tbody>
                        @foreach (var r in _custInvoices)
                        {
                            <tr>
                                <td>@R(r,"invoice_number")</td><td>@R(r,"issue_date")</td><td>@R(r,"currency_code")</td>
                                <td>@R(r,"subtotal_ex_vat")</td><td>@R(r,"total_vat")</td><td>@R(r,"total_incl_vat")</td><td>@R(r,"paid_amount")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div>
                <p><strong>Vendor invoices (PO journal)</strong> <a href="@Get("/erp/d365/csv-export")?area=vendor_invoice_journal">export CSV</a></p>
                <table class="tg-table">
                    <thead><tr><th>PO</th><th>Status</th><th>Total</th><th>Created</th></tr></thead>
                    <tbody>
                        @foreach (var r in _vendInvoices)
                        {
                            <tr><td>@R(r,"po_no")</td><td>@R(r,"status")</td><td>@R(r,"total_amount")</td><td>@R(r,"time_created")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="tg-card">
        <h3>Customer account statement — entity wise</h3>
        <form method="get" action="@Get("/erp/d365-studio")" style="display:flex;gap:8px;align-items:end;margin-bottom:10px">
            <label style="flex:1">Legal entity
                <select name="stmt_entity">
                    <option value="">All entities</option>
                    @foreach (var e in _entities)
                    {
                        <option value="@R(e,"id")" selected="@(R(e,"id") == _stmtEntity)">@R(e,"code") — @R(e,"name")</option>
                    }
                </select>
            </label>
            <button type="submit">Run</button>
            <a href="@Get("/erp/d365/csv-export")?area=customer_statement&entity=@_stmtEntity" style="font-size:12px">print / export CSV</a>
        </form>
        <table class="tg-table">
            <thead><tr><th>Customer</th><th>Account</th><th>TRN</th><th class="text-right">Balance</th></tr></thead>
            <tbody>
                @foreach (var r in _stmtRows)
                {
                    <tr><td>@R(r,"name")</td><td>@R(r,"account_code")</td><td>@R(r,"trn")</td><td class="text-right">@R(r,"balance")</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="tg-card">
        <h3>Sales analysis by invoice (margin)</h3>
        <p><a href="@Get("/erp/d365/csv-export")?area=sales_analysis_by_invoice">export CSV</a> — customizable columns: pick any listed field into the report.</p>
        <table class="tg-table">
            <thead><tr><th>Invoice</th><th>Date</th><th>Cur</th><th class="text-right">Revenue</th><th class="text-right">Cost</th><th class="text-right">Margin</th></tr></thead>
            <tbody>
                @foreach (var r in _analysis)
                {
                    <tr>
                        <td>@R(r,"invoice_number")</td><td>@R(r,"issue_date")</td><td>@R(r,"currency_code")</td>
                        <td class="text-right">@R(r,"revenue")</td><td class="text-right">@R(r,"cost")</td><td class="text-right">@R(r,"margin")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private string _csrf = string.Empty;
    private string _flashOk = string.Empty;
    private string _flashErr = string.Empty;
    private string _entityId = "0";
    private IReadOnlyDictionary<string, string?> _profile = new Dictionary<string, string?>();
    private List<Dictionary<string, string?>> _dimTypes = [];
    private List<Dictionary<string, string?>> _dimSets = [];
    private List<Dictionary<string, string?>> _fiscal = [];
    private List<Dictionary<string, string?>> _banks = [];
    private List<Dictionary<string, string?>> _custInvoices = [];
    private List<Dictionary<string, string?>> _vendInvoices = [];
    private List<Dictionary<string, string?>> _entities = [];
    private List<Dictionary<string, string?>> _stmtRows = [];
    private List<Dictionary<string, string?>> _analysis = [];
    private string _stmtEntity = "";
    private List<Dictionary<string, string?>> _prospects = [];
    private List<Dictionary<string, string?>> _warehouses = [];

    private string P(string key) => _profile.TryGetValue(key, out var v) ? v ?? "" : "";
    private static string R(Dictionary<string, string?> row, string key) => row.TryGetValue(key, out var v) ? v ?? "" : "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted).ConfigureAwait(false);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        _csrf = await Csrf.KeyForAsync(ctx, session, ctx.RequestAborted).ConfigureAwait(false);
        _flashOk = ctx.Request.Query["ok"].ToString();
        _flashErr = ctx.Request.Query["err"].ToString();
        _entityId = ctx.Request.Query["entity_id"].ToString() is { Length: > 0 } e ? e : "0";

        try
        {
            if (Connections.IsConfigured && long.TryParse(_entityId, out var eid))
            {
                await using var conn = await Connections.OpenAsync(ctx.RequestAborted).ConfigureAwait(false);
                _profile = await D365.EntityDocProfileAsync(conn, eid, ctx.RequestAborted).ConfigureAwait(false);
                _dimTypes = await Gl.DimensionTypesAsync(conn, ctx.RequestAborted).ConfigureAwait(false);
                _dimSets = await Gl.DimensionSetsAsync(conn, ctx.RequestAborted).ConfigureAwait(false);
                _fiscal = await Gl.FiscalCalendarsAsync(conn, ctx.RequestAborted).ConfigureAwait(false);
                _banks = await Gl.BankAccountsAsync(conn, ctx.RequestAborted).ConfigureAwait(false);
                _entities = await ErpD365DocCycleService.RowsAsync(conn, "SELECT `id`, `code`, `name` FROM `epc_erp_pm_legal_entities` WHERE `active` = 1 ORDER BY `code`", ctx.RequestAborted).ConfigureAwait(false);
                _custInvoices = await ErpD365DocCycleService.RowsAsync(conn,
                    "SELECT `id`, `invoice_number`, `issue_date`, `currency_code`, `subtotal_ex_vat`, `total_vat`, `total_incl_vat`, `paid_amount` FROM `epc_einvoice_documents` ORDER BY `id` DESC LIMIT 50",
                    ctx.RequestAborted).ConfigureAwait(false);
                _vendInvoices = await ErpD365DocCycleService.RowsAsync(conn,
                    "SELECT `id`, `po_no`, `status`, `total_amount`, `time_created` FROM `epc_erp_purchase_orders` ORDER BY `id` DESC LIMIT 50",
                    ctx.RequestAborted).ConfigureAwait(false);
                _stmtEntity = ctx.Request.Query["stmt_entity"].ToString();
                var stmtSql = "SELECT c.`name`, c.`account_code`, IFNULL(c.`trn`,'') AS trn, IFNULL(SUM(l.`debit`),0)-IFNULL(SUM(l.`credit`),0) AS balance"
                    + " FROM `epc_erp_contacts` c"
                    + " LEFT JOIN `epc_erp_gl_lines` l ON l.`coa_id` IN (SELECT `id` FROM `epc_erp_coa_accounts` WHERE `code` = c.`account_code`)";
                if (long.TryParse(_stmtEntity, out var se) && se > 0)
                {
                    stmtSql += " WHERE c.`entity_id` = " + se.ToString(System.Globalization.CultureInfo.InvariantCulture);
                }
                stmtSql += " GROUP BY c.`id` ORDER BY c.`name` LIMIT 200";
                _stmtRows = await ErpD365DocCycleService.RowsAsync(conn, stmtSql, ctx.RequestAborted).ConfigureAwait(false);
                _warehouses = await ErpD365DocCycleService.RowsAsync(conn,
                    "SELECT `id`, `code`, `name`, `entity_id`, `site`, `type`, `cost_centre_id`, `business_unit_id` FROM `epc_erp_inv_warehouses` ORDER BY `code` LIMIT 200",
                    ctx.RequestAborted).ConfigureAwait(false);
                _prospects = (await D365.ProspectsAsync(conn, ctx.RequestAborted).ConfigureAwait(false)).Select(r => new Dictionary<string, string?>(r, StringComparer.Ordinal)).ToList();
                _analysis = await ErpD365DocCycleService.RowsAsync(conn,
                    "SELECT d.`invoice_number`, d.`issue_date`, d.`currency_code`, d.`total_incl_vat` AS revenue,"
                    + " IFNULL((SELECT SUM(l.`quantity`*IFNULL(i.`cost_price`,0)) FROM `epc_einvoice_lines` l JOIN `epc_erp_inv_items` i ON i.`sku` = l.`item_name` WHERE l.`document_id` = d.`id`),0) AS cost,"
                    + " d.`total_incl_vat` - IFNULL((SELECT SUM(l.`quantity`*IFNULL(i.`cost_price`,0)) FROM `epc_einvoice_lines` l JOIN `epc_erp_inv_items` i ON i.`sku` = l.`item_name` WHERE l.`document_id` = d.`id`),0) AS margin"
                    + " FROM `epc_einvoice_documents` d ORDER BY d.`id` DESC LIMIT 100",
                    ctx.RequestAborted).ConfigureAwait(false);
            }
        }
        catch
        {
            // Profile load is best-effort; the form still posts.
        }
    }

    private string Post(string path) => ClientErpPath.PrefixIfBound(Http.HttpContext!, path);
    private string Get(string path) => ClientErpPath.PrefixIfBound(Http.HttpContext!, path);

    private MarkupString HiddenFields()
    {
        var returnUrl = HttpUtility.HtmlAttributeEncode(
            (Http.HttpContext?.Request.Path.Value ?? "/erp/d365-studio") + Http.HttpContext?.Request.QueryString.Value);
        return (MarkupString)(
            $"<input type=\"hidden\" name=\"confirmWrites\" value=\"true\" />"
            + $"<input type=\"hidden\" name=\"returnUrl\" value=\"{returnUrl}\" />"
            + $"<input type=\"hidden\" name=\"csrf_guard_key\" value=\"{HttpUtility.HtmlAttributeEncode(_csrf)}\" />");
    }
}
