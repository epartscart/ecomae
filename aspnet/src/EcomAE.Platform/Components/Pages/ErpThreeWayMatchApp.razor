@page "/erp/three-way-match-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>3-way match · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Three-Way Match" BreadcrumbArea="Procure to Pay" BreadcrumbTab="Three-way match">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/three-way-match-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Three-Way Match" Subtitle="Open a row for the 280-character notes excerpt, invoice, and receipt count. Writes stay on the Classic twin." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Three-Way Match KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_rows.Count</div></div>
        <div class="kpi"><div class="lbl">Digest source</div><div class="val">@_source</div></div>
        <div class="kpi"><div class="lbl">Session</div><div class="val">@(_isAdmin ? "live" : "guest")</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>PO id</dt><dd>@_opened.PoId.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>PO #</dt><dd>@(string.IsNullOrWhiteSpace(_opened.PoNo) ? "—" : _opened.PoNo)</dd>
                <dt>Title</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Title) ? "—" : _opened.Title)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.PoStatus) ? "—" : _opened.PoStatus)</dd>
                <dt>Supplier</dt><dd>@(_opened.SupplierId > 0 ? _opened.SupplierId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>PO total</dt><dd>@_opened.PoTotal.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Invoice</dt><dd>@(string.IsNullOrWhiteSpace(_opened.InvoiceNumber) ? "—" : _opened.InvoiceNumber)</dd>
                <dt>Inv total</dt><dd>@_opened.InvoiceTotal.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Inv status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.PurchaseStatus) ? "—" : _opened.PurchaseStatus)</dd>
                <dt>Receipts</dt><dd>@_opened.ReceiptCount.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Order</dt><dd>@(_opened.OrderId > 0 ? _opened.OrderId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Approved</dt><dd>@FormatTime(_opened.ApprovedAt)</dd>
                <dt>Received</dt><dd>@FormatTime(_opened.ReceivedAt)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Writes stay on the Classic twin.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.NotesExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">notes excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.NotesExcerpt</pre>
                @if (_opened.NotesLen > _opened.NotesExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.NotesExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NotesLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No notes excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>PO #</th>
                            <th>Invoice</th>
                            <th>Receipts</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.PoNo) ? "—" : sib.PoNo)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.InvoiceNumber) ? "—" : sib.InvoiceNumber)</td>
                                <td>@sib.ReceiptCount.ToString(CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "po_id", sib.PoId)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>PO #</th>
                    <th>PO status</th>
                    <th>PO total</th>
                    <th>Invoice</th>
                    <th>Inv total</th>
                    <th>Receipts</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr id="erp-row-@row.PoId.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.PoId, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(row.PoNo) ? $"PO#{row.PoId}" : row.PoNo)</strong></td>
                            <td><span class="label label-default">@row.PoStatus</span></td>
                            <td>@row.PoTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.InvoiceNumber) ? "—" : row.InvoiceNumber)</td>
                            <td>@row.InvoiceTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(row.ReceiptCount > 0 ? row.ReceiptCount.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "po_id", row.PoId)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">@_message</div>
    }

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=purchasing&tab=three_way_match";
    private const string _listHref = "/erp/three-way-match-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpThreeWayMatchDigest> _rows = [];
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpThreeWayMatchDetail? _opened;
    private IReadOnlyList<ErpThreeWayMatchDigest> _openedSiblings = [];

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?po_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.PoNo)
            ? _opened.PoNo
            : ("PO #" + _opened.PoId.ToString(CultureInfo.InvariantCulture)))
            + (string.IsNullOrWhiteSpace(_opened.PoStatus) ? "" : (" · " + _opened.PoStatus));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "po_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpThreeWayMatchAsync(_limit, ctx.RequestAborted);
        _rows = result.Rows;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpThreeWayMatchDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Match;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.PoId == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.PoId != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
