@page "/erp/three-way-match-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>3-way match · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Three-Way Match" BreadcrumbArea="Procure to Pay" BreadcrumbTab="Three-way match">

    <PhpErpModulePageHeader Title="Three-Way Match" Subtitle="Live shop digest. Writes stay on ERP ajax." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Three-Way Match KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_rows.Count</div></div>
        <div class="kpi"><div class="lbl">Digest source</div><div class="val">@_source</div></div>
        <div class="kpi"><div class="lbl">Session</div><div class="val">@(_isAdmin ? "live" : "guest")</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>PO #</th>
                    <th>PO status</th>
                    <th>PO total</th>
                    <th>Invoice</th>
                    <th>Inv total</th>
                    <th>Receipts</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "Nothing to show yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.PoNo) ? $"PO#{row.PoId}" : row.PoNo)</strong></td>
                            <td><span class="label label-default">@row.PoStatus</span></td>
                            <td>@row.PoTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.InvoiceNumber) ? "—" : row.InvoiceNumber)</td>
                            <td>@row.InvoiceTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(row.ReceiptCount > 0 ? row.ReceiptCount.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">@_message</div>
    }

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=purchasing&tab=three_way_match";
    private bool _isAdmin;
    private IReadOnlyList<ErpThreeWayMatchDigest> _rows = [];
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpThreeWayMatchAsync(_limit, ctx.RequestAborted);
        _rows = result.Rows;
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
