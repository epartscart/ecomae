@page "/erp/three-way-match-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Three-Way Match · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<HeadContent>
<style>
        .epc-thre-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#1d4ed8 45%,#2563eb 100%);
        }
        .epc-thre-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-thre-hero p { margin:0; color:#bfdbfe; max-width:42rem; font-size:.92rem; line-height:1.45; }
        .epc-thre-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-thre-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#fff; background:#2563eb;
        }
        .epc-thre-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); }
        .epc-thre-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-thre-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-thre-kpi strong { display:block; font-size:1.45rem; font-variant-numeric:tabular-nums; }
        .epc-thre-kpi span { color:#64748b; font-size:.78rem; }
        .epc-thre-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-thre-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-thre-table th, .epc-thre-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-thre-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-thre-table a { color:#1d4ed8; font-weight:700; text-decoration:none; }
        .epc-thre-badge { display:inline-flex; padding:.15rem .45rem; border-radius:.3rem; font-size:.72rem; font-weight:700; background:#dbeafe; color:#1e3a8a; }
        .epc-thre-note { margin-top:1rem; padding:.75rem .9rem; background:#eff6ff; border:1px solid #bfdbfe; border-radius:.45rem; color:#1e3a8a; font-size:.86rem; }
        @@media (max-width:900px){ .epc-thre-kpis{grid-template-columns:1fr;} }
</style>
</HeadContent>

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Three-Way Match" BreadcrumbArea="Procure to Pay" BreadcrumbTab="Three-way match">

    <section class="epc-thre-hero">
        <h1>Three-Way Match</h1>
        <p>PO · receipt · invoice match board (PHP epc_erp_three_way_match_rows).</p>
        <div class="epc-thre-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/erp/purchase-orders-app">Purchase orders</a>
            <a class="ghost" href="/erp/purchases-app">Purchases</a>
            <a class="ghost" href="/erp/app">ERP dashboard</a>
        </div>
    </section>

    <div class="epc-thre-kpis" aria-label="Three-Way Match KPIs">
        <div class="epc-thre-kpi"><strong>@_rows.Count</strong><span>Shown (limit @_limit)</span></div>
        <div class="epc-thre-kpi"><strong>@_source</strong><span>Digest source</span></div>
        <div class="epc-thre-kpi"><strong>@(_isAdmin ? "live" : "guest")</strong><span>Session</span></div>
    </div>

    <div class="epc-thre-table-wrap">
        <table class="epc-thre-table">
            <thead>
                <tr>
                    <th>PO #</th>
                    <th>PO status</th>
                    <th>PO total</th>
                    <th>Invoice</th>
                    <th>Inv total</th>
                    <th>Receipts</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "Nothing to show yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.PoNo) ? $"PO#{row.PoId}" : row.PoNo)</strong></td>
                            <td><span class="epc-thre-badge">@row.PoStatus</span></td>
                            <td>@row.PoTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.InvoiceNumber) ? "—" : row.InvoiceNumber)</td>
                            <td>@row.InvoiceTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(row.ReceiptCount > 0 ? row.ReceiptCount.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="epc-thre-note">@_message</div>
    }

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=purchasing&tab=three_way_match";
    private bool _isAdmin;
    private IReadOnlyList<ErpThreeWayMatchDigest> _rows = [];
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpThreeWayMatchAsync(_limit, ctx.RequestAborted);
        _rows = result.Rows;
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
