@page "/erp/module-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>@_title · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="@_title" BreadcrumbArea="Modules" BreadcrumbTab="@_tab">

    <PhpErpModulePageHeader Title="@_title"
                            Subtitle="Module shell for residual ERP tabs. Dedicated digest apps stay on /erp/*."
                            PhpTabHref="@_phpTab" />

    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-section-card">
        <div class="epc-erp-section-card-hd"><h4><i class="fa fa-cubes"></i> @_title</h4></div>
        <div class="epc-erp-section-card-bd" style="font-size:12.5px;color:#475569;line-height:1.45;">
            <p style="margin:0 0 8px;">
                Product route: <code>@_mappedApp</code>.
                Tab key: <code>@_tab</code>.
            </p>
            @if (_hasDedicatedApp)
            {
                <p style="margin:0 0 8px;">
                    Dedicated digest app:
                    <a href="@_mappedApp"><strong>@_mappedApp</strong></a>
                </p>
            }
            <p style="margin:0;">
                <a class="btn btn-sm btn-primary" href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open this module</a>
            </p>
        </div>
    </div>

    <h4>ERP tab catalog</h4>
    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Tab</th>
                    <th>App</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _catalog)
                {
                    <tr>
                        <td><code>@row.Tab</code></td>
                        <td>@row.Href</td>
                        <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(row.Href)">Open</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Opt-in only — never the default production body. *@
    @if (!string.IsNullOrWhiteSpace(_hybridPhp))
    {
        <PhpHybridWorkspaceFrame PhpHref="@_hybridPhp" ClearHref="@_clearHref" />
    }
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private string _tab = "module";
    private string _title = "ERP Module";
    private string _phpTab = "/ERP/?epc_erp_shell=1";
    private string _mappedApp = "/erp/module-app";
    private bool _hasDedicatedApp;
    private string _compareHref = "/php-reference/erp";
    private string? _hybridPhp;
    private string _clearHref = "/erp/module-app";
    private IReadOnlyList<(string Tab, string Href)> _catalog = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var q = ctx.Request.Query["tab"].ToString();
        _tab = string.IsNullOrWhiteSpace(q) ? "module" : q.Trim().ToLowerInvariant();
        _title = ToTitle(_tab);
        _phpTab = $"/ERP/?epc_erp_shell=1&tab={Uri.EscapeDataString(_tab)}";
        _mappedApp = ErpPhpTabRouteMap.MapTabOrModuleApp(_tab);
        _hasDedicatedApp = !_mappedApp.StartsWith(ErpPhpTabRouteMap.ModuleAppPath, StringComparison.OrdinalIgnoreCase);
        _catalog = ErpPhpTabRouteMap.All
            .OrderBy(kv => kv.Key, StringComparer.Ordinal)
            .Select(kv => (kv.Key, kv.Value))
            .Take(80)
            .ToList();
        _compareHref = PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab);
        _clearHref = "/erp/module-app?tab=" + Uri.EscapeDataString(_tab);

        // Opt-in hybrid compare: ?php=/php-reference/... or ?php=1
        var phpQ = ctx.Request.Query["php"].ToString();
        if (!string.IsNullOrWhiteSpace(phpQ))
        {
            _hybridPhp = string.Equals(phpQ, "1", StringComparison.OrdinalIgnoreCase)
                || string.Equals(phpQ, "true", StringComparison.OrdinalIgnoreCase)
                ? _compareHref
                : phpQ;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
    }

    private static string ToTitle(string tab)
    {
        if (string.IsNullOrWhiteSpace(tab)) return "ERP Module";
        return string.Join(' ', tab.Split('_', StringSplitOptions.RemoveEmptyEntries)
            .Select(p => char.ToUpperInvariant(p[0]) + p[1..]));
    }
}
