@page "/cp/landed-cost-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Landed cost · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-lc-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-lc-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-lc-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-lc-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-lc-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f172a; background:#fff;
        }
        .epc-lc-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-lc-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-lc-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-lc-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-lc-kpi span { color:#64748b; font-size:.78rem; }
        .epc-lc-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-lc-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-lc-table th, .epc-lc-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-lc-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-lc-note { margin-top:1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:.45rem; color:#334155; font-size:.86rem; }
        @@media (max-width:900px){ .epc-lc-kpis{grid-template-columns:1fr 1fr;} }
    
</style>
</HeadContent>


<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-lc-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Landed cost</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-lc-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
        </div>
    </section>

    <div class="epc-lc-kpis" aria-label="Landed cost stats">
        <div class="epc-lc-kpi"><strong>@_summary.SheetCount.ToString(CultureInfo.InvariantCulture)</strong><span>Sheets</span></div>
        <div class="epc-lc-kpi"><strong>@_summary.PostedCount.ToString(CultureInfo.InvariantCulture)</strong><span>Posted/calc</span></div>
        <div class="epc-lc-kpi"><strong>@_summary.ExpenseCount.ToString(CultureInfo.InvariantCulture)</strong><span>Expenses</span></div>
        <div class="epc-lc-kpi"><strong>@_summary.LineCount.ToString(CultureInfo.InvariantCulture)</strong><span>Lines</span></div>
    </div>

    <div class="epc-lc-table-wrap">
        <table class="epc-lc-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Sheet</th>
                    <th>PO</th>
                    <th>Supplier</th>
                    <th>Goods</th>
                    <th>Expenses</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="8">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.SheetNo) ? row.SheetNo : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PoReference) ? row.PoReference : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.SupplierName) ? row.SupplierName : "—")</td>
                            <td>@row.GoodsValue.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.TotalExpenses.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=landed_cost_area&tab=landed_cost";
    private bool _isAdmin;
    private CpLandedCostSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpLandedCostSheetDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpLandedCostDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Sheets;
        _source = result.Source;
        _message = result.Message;
    }
}
