@page "/cp/landed-cost-app"
@page "/erp/landed-cost-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Landed cost · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Landed cost
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/landed-cost-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/landed-cost-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_summary.SheetCount.ToString(CultureInfo.InvariantCulture) Sheets · @_summary.PostedCount.ToString(CultureInfo.InvariantCulture) Posted/calc · @_summary.ExpenseCount.ToString(CultureInfo.InvariantCulture) Expenses · @_summary.LineCount.ToString(CultureInfo.InvariantCulture) Lines.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Sheet</th>
                    <th>PO</th>
                    <th>Supplier</th>
                    <th>Goods</th>
                    <th>Expenses</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="8">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.SheetNo) ? row.SheetNo : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PoReference) ? row.PoReference : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.SupplierName) ? row.SupplierName : "—")</td>
                            <td>@row.GoodsValue.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.TotalExpenses.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=landed_cost_area&tab=landed_cost";
    private bool _isAdmin;
    private CpLandedCostSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpLandedCostSheetDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpLandedCostDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Sheets;
        _source = result.Source;
        _message = result.Message;
    }
}
