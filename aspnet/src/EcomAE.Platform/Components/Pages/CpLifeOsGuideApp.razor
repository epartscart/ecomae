        .lo-guide-svg { display: block; width: 100%; height: auto; }
        .lo-guide-kpis {
          display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .65rem; margin-bottom: .9rem;
        }
        .lo-guide-kpis > div {
          background: #fff; border: 1px solid #e2e8f0; border-radius: .55rem; padding: .85rem .9rem;
