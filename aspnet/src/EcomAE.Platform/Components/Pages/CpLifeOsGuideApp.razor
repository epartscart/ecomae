        .lo-guide-part header strong { display: block; font-size: .98rem; color: #0f172a; margin-bottom: .55rem; }
        .lo-guide-part ol {
          margin: 0; padding-left: 1.1rem; color: #334155; font-size: .8rem; line-height: 1.4;
        }
        .lo-guide-deliv {
          margin: .65rem 0 0; font-size: .75rem; color: #64748b; line-height: 1.35;
