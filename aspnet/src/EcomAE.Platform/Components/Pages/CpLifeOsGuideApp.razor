        .lo-guide-part.is-pending { border-color: #fbbf24; background: linear-gradient(180deg, #fffbeb 0%, #fff 40%); }
        .lo-guide-part header em {
          display: block; font-style: normal; font-size: .7rem; font-weight: 800;
          letter-spacing: .06em; text-transform: uppercase; color: #0284c7; margin-bottom: .25rem;
