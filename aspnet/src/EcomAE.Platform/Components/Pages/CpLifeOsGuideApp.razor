        .lo-guide-part-links a.json { background: #f1f5f9; color: #334155; }
        .lo-guide-note {
          padding: 1rem 1.1rem; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: .55rem;
        }
        .lo-guide-note ul { margin: .4rem 0 0; padding-left: 1.15rem; color: #334155; font-size: .86rem; line-height: 1.45; }
        @@media (max-width: 900px) {
          .lo-guide-kpis { grid-template-columns: 1fr 1fr; }
        }
        @@media (max-width: 560px) {
