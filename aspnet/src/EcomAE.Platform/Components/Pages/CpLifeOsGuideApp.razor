@page "/cp/lifeos-guide-app"
@layout Layout.LifeOsProductLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.LifeOs.Spec
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ILifeOsMasterSpec Spec
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>LifeOS™ system guide · ecomae</PageTitle>
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />

@* Body CSS — live SSR may drop HeadContent. ecomae LifeOS chrome only (not tenant CP shell). *@
<style>@((MarkupString)_css)</style>
<HeadContent>
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<meta name="ecomae-chrome-surface" content="lifeos-guide" />
<style>@((MarkupString)_css)</style>
</HeadContent>

<div class="lo-guide" data-surface="lifeos-guide">
  <header class="lo-guide-top" role="banner">
    <a class="lo-guide-brand" href="@EcomAeRoutes.LifeOs">
      <img src="/assets/media/logos/ecomae_mark.svg" alt="" width="28" height="28" />
      <span>ecomae · Life<em>OS</em>™</span>
    </a>
    <nav class="lo-guide-nav" aria-label="LifeOS guide">
      <a href="@EcomAeRoutes.LifeOs">LifeOS home</a>
      <a class="is-on" href="@EcomAeRoutes.ControlPanelLifeOsGuideApp">System guide</a>
      <a href="@EcomAeRoutes.LifeOsClientsBoard">Clients board</a>
      <a href="@EcomAeRoutes.LifeOsSpec">Spec</a>
      <a href="@EcomAeRoutes.Ip">IP hub</a>
      <a href="@EcomAeRoutes.ControlPanel">CP home</a>
      @if (_isAdmin)
      {
        <span class="lo-guide-pill">Operator</span>
      }
      else
      {
        <a class="lo-guide-pill" href="@EcomAeRoutes.ControlPanelLogin">Sign in</a>
      }
    </nav>
  </header>

  <main class="lo-guide-main">
    <section class="lo-guide-hero" aria-label="LifeOS system guide">
        <p class="lo-guide-kicker">ecomae · Intelligence Platform</p>
        <h1>Life<em>OS</em>™ full system guide</h1>
        <p>
            Visual map of the ambient AI operating system on ecomae — hosts, frontend consoles,
            backend digests, and Master Spec Parts 1–10 chapters. Super-CP / CP operators.
        </p>
        <div class="lo-guide-cta">
            <a href="@EcomAeRoutes.Ip">Open /ip hub</a>
            <a class="ghost" href="https://lifeos.ecomae.com/">lifeos.ecomae.com</a>
            <a class="ghost" href="@EcomAeRoutes.LifeOsSpec">Spec UI</a>
            <a class="ghost" href="@EcomAeRoutes.LifeOsSpecJson">Spec JSON</a>
        </div>
    </section>

    @if (!_isAdmin)
    {
        <div class="lo-guide-guest">
            Guest preview of the LifeOS link map.
            <a href="@EcomAeRoutes.ControlPanelLogin">Sign in</a> for CP operator session.
        </div>
    }

    <section class="lo-guide-section" aria-label="System architecture diagram">
        <h2>System architecture</h2>
        <p class="lo-guide-lede">One stack: product hosts → ASP.NET primary (:5100) → digests + Blazor consoles. PHP stays under <code>/php-reference/*</code>.</p>
        <div class="lo-guide-svg-wrap" role="img" aria-label="LifeOS stack diagram from hosts through cognitive cycle to digests">
            <svg viewBox="0 0 1100 520" class="lo-guide-svg" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="lgSky" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#020617"/><stop offset="100%" stop-color="#0c4a6e"/>
                    </linearGradient>
                    <linearGradient id="lgBlue" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0%" stop-color="#38bdf8"/><stop offset="100%" stop-color="#2563eb"/>
                    </linearGradient>
                    <marker id="lgArr" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
                        <path d="M0,0 L6,3 L0,6 Z" fill="#38bdf8"/>
                    </marker>
                </defs>
                <rect width="1100" height="520" rx="12" fill="url(#lgSky)"/>
                <text x="36" y="42" fill="#e2e8f0" font-family="Sora,sans-serif" font-size="18" font-weight="700">LifeOS™ · ecomae Intelligence Platform</text>
                <text x="36" y="64" fill="#94a3b8" font-family="Sora,sans-serif" font-size="12">Perceive → Decide → Act → Learn · human control first</text>

                @* Hosts *@
                <g class="lo-guide-node">
                    <rect x="40" y="100" width="200" height="70" rx="8" fill="#0b1b3a" stroke="#38bdf8" stroke-width="2"/>
                    <text x="140" y="128" text-anchor="middle" fill="#7dd3fc" font-size="11" font-family="Sora,sans-serif">HOSTS</text>
                    <text x="140" y="150" text-anchor="middle" fill="#fff" font-size="12" font-family="Sora,sans-serif">lifeos.ecomae.com</text>
                    <text x="140" y="166" text-anchor="middle" fill="#cbd5e1" font-size="11" font-family="Sora,sans-serif">www /ip · /cp · /bos</text>
                </g>

                @* Gateway *@
                <g>
                    <rect x="300" y="100" width="200" height="70" rx="8" fill="#0b1b3a" stroke="#38bdf8" stroke-width="2"/>
                    <text x="400" y="128" text-anchor="middle" fill="#7dd3fc" font-size="11" font-family="Sora,sans-serif">EDGE</text>
                    <text x="400" y="150" text-anchor="middle" fill="#fff" font-size="12" font-family="Sora,sans-serif">nginx · classic-entry</text>
                    <text x="400" y="166" text-anchor="middle" fill="#cbd5e1" font-size="11" font-family="Sora,sans-serif">Kestrel :5100 primary</text>
