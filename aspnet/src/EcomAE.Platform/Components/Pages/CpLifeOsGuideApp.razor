        .lo-guide-kpis strong { display: block; font-size: 1.25rem; color: #0f172a; }
        .lo-guide-kpis span { color: #64748b; font-size: .78rem; }
        .lo-guide-table-wrap {
          background: #fff; border: 1px solid #e2e8f0; border-radius: .55rem; overflow: auto;
        }
        .lo-guide-table { width: 100%; border-collapse: collapse; font-size: .84rem; }
        .lo-guide-table th, .lo-guide-table td {
          padding: .55rem .7rem; border-bottom: 1px solid #f1f5f9; text-align: left; vertical-align: top;
        }
        .lo-guide-table th {
          background: #f8fafc; color: #475569; font-size: .72rem; text-transform: uppercase; letter-spacing: .04em;
        }
        .lo-guide-table a { color: #0369a1; font-weight: 600; text-decoration: none; }
        .lo-guide-table code { font-size: .8rem; }
        .lo-guide-method {
          display: inline-block; min-width: 3.2rem; text-align: center;
