                <text x="105" y="280" text-anchor="middle" fill="#fff" font-size="14" font-family="Sora,sans-serif" font-weight="700">Perceive</text>
                <path d="M170 274 H200" stroke="#38bdf8" stroke-width="2" fill="none" marker-end="url(#lgArr)"/>
                <rect x="200" y="250" width="130" height="48" rx="8" fill="#12263f" stroke="url(#lgBlue)" stroke-width="2"/>
                <text x="265" y="280" text-anchor="middle" fill="#fff" font-size="14" font-family="Sora,sans-serif" font-weight="700">Decide</text>
                <path d="M330 274 H360" stroke="#38bdf8" stroke-width="2" fill="none" marker-end="url(#lgArr)"/>
                <rect x="360" y="250" width="130" height="48" rx="8" fill="#12263f" stroke="url(#lgBlue)" stroke-width="2"/>
                <text x="425" y="280" text-anchor="middle" fill="#fff" font-size="14" font-family="Sora,sans-serif" font-weight="700">Act</text>
                <path d="M490 274 H520" stroke="#38bdf8" stroke-width="2" fill="none" marker-end="url(#lgArr)"/>
                <rect x="520" y="250" width="130" height="48" rx="8" fill="#12263f" stroke="url(#lgBlue)" stroke-width="2"/>
                <text x="585" y="280" text-anchor="middle" fill="#fff" font-size="14" font-family="Sora,sans-serif" font-weight="700">Learn</text>
                <path d="M670 298 C720 330, 100 330, 105 298" stroke="#38bdf8" stroke-width="1.5" fill="none" stroke-dasharray="4 4" marker-end="url(#lgArr)" opacity=".7"/>

                <text x="36" y="350" fill="#94a3b8" font-size="12" font-family="Sora,sans-serif">Life domains</text>
                <rect x="40" y="365" width="120" height="56" rx="8" fill="#0b1b3a" stroke="#64748b" stroke-width="1.5"/>
                <text x="68" y="400" fill="#38bdf8" font-size="16" font-family="Sora,sans-serif">$</text>
                <text x="92" y="400" fill="#e2e8f0" font-size="13" font-family="Sora,sans-serif">Work</text>
                <rect x="180" y="365" width="120" height="56" rx="8" fill="#0b1b3a" stroke="#64748b" stroke-width="1.5"/>
                <text x="208" y="400" fill="#38bdf8" font-size="16" font-family="Sora,sans-serif">↑</text>
                <text x="232" y="400" fill="#e2e8f0" font-size="13" font-family="Sora,sans-serif">Wealth</text>
                <rect x="320" y="365" width="120" height="56" rx="8" fill="#0b1b3a" stroke="#64748b" stroke-width="1.5"/>
                <text x="348" y="400" fill="#38bdf8" font-size="16" font-family="Sora,sans-serif">+</text>
                <text x="372" y="400" fill="#e2e8f0" font-size="13" font-family="Sora,sans-serif">Health</text>
                <rect x="460" y="365" width="120" height="56" rx="8" fill="#0b1b3a" stroke="#64748b" stroke-width="1.5"/>
                <text x="488" y="400" fill="#38bdf8" font-size="16" font-family="Sora,sans-serif">⌂</text>
                <text x="512" y="400" fill="#e2e8f0" font-size="13" font-family="Sora,sans-serif">Home</text>
                <rect x="600" y="365" width="120" height="56" rx="8" fill="#0b1b3a" stroke="#64748b" stroke-width="1.5"/>
                <text x="628" y="400" fill="#38bdf8" font-size="16" font-family="Sora,sans-serif">→</text>
                <text x="652" y="400" fill="#e2e8f0" font-size="13" font-family="Sora,sans-serif">Mobility</text>

                <text x="36" y="460" fill="#94a3b8" font-size="12" font-family="Sora,sans-serif">Master Spec v@Spec.Version — Parts 1–10</text>
                <rect x="40" y="472" width="92" height="32" rx="6" fill="#12263f" stroke="#38bdf8" stroke-width="1.5"/>
                <text x="86" y="493" text-anchor="middle" fill="#fff" font-size="12" font-family="Sora,sans-serif">P1</text>
                <rect x="142" y="472" width="92" height="32" rx="6" fill="#12263f" stroke="#38bdf8" stroke-width="1.5"/>
                <text x="188" y="493" text-anchor="middle" fill="#fff" font-size="12" font-family="Sora,sans-serif">P2</text>
                <rect x="244" y="472" width="92" height="32" rx="6" fill="#12263f" stroke="#38bdf8" stroke-width="1.5"/>
                <text x="290" y="493" text-anchor="middle" fill="#fff" font-size="12" font-family="Sora,sans-serif">P3</text>
                <rect x="346" y="472" width="92" height="32" rx="6" fill="#12263f" stroke="#38bdf8" stroke-width="1.5"/>
                <text x="392" y="493" text-anchor="middle" fill="#fff" font-size="12" font-family="Sora,sans-serif">P4</text>
                <rect x="448" y="472" width="92" height="32" rx="6" fill="#12263f" stroke="#38bdf8" stroke-width="1.5"/>
                <text x="494" y="493" text-anchor="middle" fill="#fff" font-size="12" font-family="Sora,sans-serif">P5</text>
                <rect x="550" y="472" width="92" height="32" rx="6" fill="#12263f" stroke="#38bdf8" stroke-width="1.5"/>
                <text x="596" y="493" text-anchor="middle" fill="#fff" font-size="12" font-family="Sora,sans-serif">P6</text>
                <rect x="652" y="472" width="92" height="32" rx="6" fill="#12263f" stroke="#38bdf8" stroke-width="1.5"/>
                <text x="698" y="493" text-anchor="middle" fill="#fff" font-size="12" font-family="Sora,sans-serif">P7</text>
                <rect x="754" y="472" width="92" height="32" rx="6" fill="#12263f" stroke="#38bdf8" stroke-width="1.5"/>
                <text x="800" y="493" text-anchor="middle" fill="#fff" font-size="12" font-family="Sora,sans-serif">P8</text>
                <rect x="856" y="472" width="92" height="32" rx="6" fill="#12263f" stroke="#38bdf8" stroke-width="1.5"/>
                <text x="902" y="493" text-anchor="middle" fill="#fff" font-size="12" font-family="Sora,sans-serif">P9</text>
                <rect x="958" y="472" width="92" height="32" rx="6" fill="#1e293b" stroke="#fbbf24" stroke-width="1.5"/>
                <text x="1004" y="493" text-anchor="middle" fill="#fff" font-size="12" font-family="Sora,sans-serif">P10</text>
            </svg>
        </div>
    </section>

    <section class="lo-guide-section" aria-label="Hosts">
        <h2>Hosts &amp; entry links</h2>
        <p class="lo-guide-lede">Where operators and customers land. Product <code>/bos</code> and <code>/ip</code> are Super-CP only.</p>
        <div class="lo-guide-table-wrap">
            <table class="lo-guide-table">
                <thead><tr><th>Host / URL</th><th>Path</th><th>Role</th><th>Access</th></tr></thead>
                <tbody>
                @foreach (var h in LifeOsLinkCatalog.Hosts)
                {
                    <tr>
                        <td><a href="@h.Host">@h.Host</a></td>
                        <td><code>@h.EntryPath</code></td>
                        <td>@h.Role</td>
                        <td>@h.Access</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="lo-guide-section" aria-label="Master Spec chapters">
        <h2>Chapters by part (Master Spec v@Spec.Version)</h2>
        <p class="lo-guide-lede">Complete chapter list from <code>ILifeOsMasterSpec</code>. Part 10 Ch.151–168 execution strategy is live at <code>/lifeos/roadmap-app</code>.</p>
        <div class="lo-guide-parts">
            @foreach (var part in Spec.Parts)
            {
                <article class="lo-guide-part @(part.Number == 10 ? "is-pending" : null)">
                    <header>
                        <em>Part @part.Number · @part.Status</em>
                        <strong>@part.Title</strong>
                    </header>
                    <ol>
                        @foreach (var ch in part.Chapters)
                        {
                            <li>@ch</li>
                        }
                    </ol>
                    <p class="lo-guide-deliv">@string.Join(" · ", part.Deliverables)</p>
                    @{
                        var fe = LifeOsLinkCatalog.FrontendApps.Where(f => f.Part == part.Number).ToList();
                        var be = _backend.Where(b => b.Part == part.Number).ToList();
                    }
                    @if (fe.Count > 0 || be.Count > 0)
                    {
                        <div class="lo-guide-part-links">
                            @foreach (var f in fe.Take(4))
                            {
                                <a href="@f.Path">UI @f.Path</a>
                            }
                            @foreach (var b in be.Take(3))
                            {
                                <a class="json" href="@b.Path">@b.Method @b.Path</a>
                            }
                        </div>
                    }
                </article>
            }
        </div>
    </section>

    <section class="lo-guide-section" aria-label="Frontend links">
        <h2>Frontend links (Blazor / HTML)</h2>
        <p class="lo-guide-lede">All LifeOS / IP operator consoles. Open on Super-CP www or lifeos host as noted.</p>
        <div class="lo-guide-kpis">
            <div><strong>@LifeOsLinkCatalog.FrontendApps.Count</strong><span>Frontend routes</span></div>
            <div><strong>@_backend.Count</strong><span>Backend digests</span></div>
            <div><strong>@Spec.Parts.Count</strong><span>Spec parts</span></div>
            <div><strong>@Spec.Parts.Sum(p => p.Chapters.Count)</strong><span>Chapters</span></div>
        </div>
        <div class="lo-guide-table-wrap">
            <table class="lo-guide-table">
                <thead><tr><th>Part</th><th>Title</th><th>Path</th><th>Host</th><th>Chapters / scope</th></tr></thead>
                <tbody>
                @foreach (var row in LifeOsLinkCatalog.FrontendApps)
                {
                    <tr>
                        <td>@row.Part</td>
                        <td>@row.Title</td>
                        <td><a href="@row.Path"><code>@row.Path</code></a></td>
                        <td>@row.HostHint</td>
                        <td>@row.Chapters</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="lo-guide-section" aria-label="Backend links">
        <h2>Backend links (JSON digests &amp; dry-runs)</h2>
        <p class="lo-guide-lede">Scaffold digests — GET unless noted. POST endpoints are dry-run (no irreversible side effects).</p>
        <div class="lo-guide-table-wrap">
            <table class="lo-guide-table">
                <thead><tr><th>Part</th><th>Method</th><th>Path</th><th>Purpose</th></tr></thead>
                <tbody>
                @foreach (var row in _backend)
                {
                    <tr>
                        <td>@row.Part</td>
                        <td><span class="lo-guide-method">@row.Method</span></td>
                        <td><a href="@row.Path"><code>@row.Path</code></a></td>
                        <td>@row.Title</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="lo-guide-section lo-guide-note" aria-label="Locks">
        <h2>Operator locks</h2>
        <ul>
            <li>ASP.NET Core is product-primary; PHP reference under <code>/php-reference/*</code>.</li>
            <li><code>cutoverAllowed=false</code>, <code>readyForPhpRemoval=false</code>, <code>RequirePhpFallback=true</code>.</li>
            <li>Product <code>/bos</code> and <code>/ip</code> are Super-CP only — tenants must 404 those paths.</li>
            <li>Live republish needs <code>FORCE_LIVE</code> after merge; merge alone does not republish :5100.</li>
            <li>Part 10 Ch.151–168 is scaffold registry (digest + roadmap UI) — not a claim of shipped MAU/marketplace GA.</li>
        </ul>
    </section>
  </main>
</div>

@code {
    private bool _isAdmin;
    private IReadOnlyList<LifeOsLinkCatalog.LinkRow> _backend = [];

    private const string _css = """
