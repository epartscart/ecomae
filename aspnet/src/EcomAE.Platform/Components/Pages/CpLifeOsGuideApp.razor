                    <rect x="560" y="88" width="220" height="94" rx="8" fill="#0b1b3a" stroke="#38bdf8" stroke-width="2"/>
                    <text x="670" y="116" text-anchor="middle" fill="#7dd3fc" font-size="11" font-family="Sora,sans-serif">SURFACES</text>
                    <text x="670" y="138" text-anchor="middle" fill="#fff" font-size="12" font-family="Sora,sans-serif">Frontend · *-app consoles</text>
                    <text x="670" y="156" text-anchor="middle" fill="#cbd5e1" font-size="11" font-family="Sora,sans-serif">Backend · JSON digests</text>
                    <text x="670" y="172" text-anchor="middle" fill="#cbd5e1" font-size="11" font-family="Sora,sans-serif">CP guide · /cp/lifeos-guide-app</text>
                </g>

                @* IP / BOS *@
                <g>
                    <rect x="840" y="100" width="220" height="70" rx="8" fill="#0b1b3a" stroke="#fbbf24" stroke-width="2"/>
                    <text x="950" y="128" text-anchor="middle" fill="#fde68a" font-size="11" font-family="Sora,sans-serif">SUPER-CP ONLY</text>
                    <text x="950" y="150" text-anchor="middle" fill="#fff" font-size="12" font-family="Sora,sans-serif">/ip · /bos · tenants 404</text>
                    <text x="950" y="166" text-anchor="middle" fill="#cbd5e1" font-size="11" font-family="Sora,sans-serif">no stack names in tenant UI</text>
                </g>

                <path d="M240 135 H300" stroke="#38bdf8" stroke-width="2.5" fill="none" marker-end="url(#lgArr)"/>
