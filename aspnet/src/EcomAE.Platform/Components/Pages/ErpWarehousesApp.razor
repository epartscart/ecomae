@page "/erp/warehouses-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Warehouses · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Warehouses" BreadcrumbArea="Inventory & Fulfilment" BreadcrumbTab="Inventory">
    @if (_view != "virtual_warehouse")
    {
        <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/warehouses-app" IsAdmin="_isAdmin" />
    }
    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@OpenedListHref" />
    <ErpPhpFlash Ok="@_ok" Err="@_err" />
    <PhpErpModulePageHeader Title="@_title" Subtitle="@_subtitle" PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <p class="text-muted" style="margin:8px 0 12px;">
        <a href="/erp/warehouses-app">Warehouses</a>
        · <a href="/erp/warehouses-app?tab=virtual_warehouse">Virtual warehouse</a>
    </p>

    @if (_view == "virtual_warehouse")
    {
        @if (_isAdmin)
        {
            <ErpPhpCreateWell Title="New virtual warehouse">
                <form method="post" action="@EcomAeRoutes.ErpVirtualWarehouseCreateForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="/erp/warehouses-app?tab=virtual_warehouse" />
                    <input type="hidden" name="is_sellable" value="1" />
                    <label>Code <input class="form-control input-sm" name="code" placeholder="Auto" /></label>
                    <label>Name <input class="form-control input-sm" name="name" placeholder="Exhibition hall" /></label>
                    <label>Type
                        <select class="form-control input-sm" name="type">
                            <option value="virtual" selected>Virtual</option>
                            <option value="exhibition">Exhibition</option>
                            <option value="consignment">Consignment</option>
                            <option value="transit">Transit</option>
                            <option value="physical">Physical</option>
                        </select>
                    </label>
                    <label>Event <input class="form-control input-sm" name="event_name" placeholder="Dubai show" /></label>
                    <button type="submit" class="btn btn-primary btn-sm">Create warehouse</button>
                </form>
            </ErpPhpCreateWell>
            <ErpPhpCreateWell Title="Create transfer">
                <form method="post" action="@EcomAeRoutes.ErpVirtualWarehouseTransferForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="/erp/warehouses-app?tab=virtual_warehouse" />
                    <label>From id <input class="form-control input-sm" name="from_warehouse_id" type="number" min="1" required /></label>
                    <label>To id <input class="form-control input-sm" name="to_warehouse_id" type="number" min="1" required /></label>
                    <label>Reason <input class="form-control input-sm" name="reason" value="exhibition" /></label>
                    <label>SKU <input class="form-control input-sm" name="sku" placeholder="SKU-1" /></label>
                    <label>Qty <input class="form-control input-sm" name="qty" type="number" step="0.001" value="1" /></label>
                    <button type="submit" class="btn btn-primary btn-sm">Create transfer</button>
                </form>
            </ErpPhpCreateWell>
        }
        <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Virtual warehouse KPIs">
            <div class="kpi"><div class="lbl">Virtual locations</div><div class="val">@_virtual.Count.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Transfers</div><div class="val">@_transfers.Summary.TransferCount.ToString(CultureInfo.InvariantCulture)</div></div>
        </div>
        <h2 style="font-size:16px;">Virtual locations</h2>
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Storage ID</th>
                        <th>Active</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_virtual.Count == 0)
                    {
                        <tr><td colspan="4">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No virtual / exhibition / consignment locations in the warehouse master." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                    }
                    else
                    {
                        @foreach (var w in _virtual)
                        {
                            <tr>
                                <td><strong>@(string.IsNullOrWhiteSpace(w.Code) ? $"#{w.Id}" : w.Code)</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(w.Name) ? "—" : w.Name)</td>
                                <td>@(w.StorageId > 0 ? w.StorageId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                                <td><span class="label label-default">@(w.Active ? "active" : "inactive")</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <h2 style="font-size:16px;margin-top:16px;">Transfer history</h2>
        <div class="epc-erp-table-wrap">
            <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
                <thead>
                    <tr>
                        <th>Transfer</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th class="text-right">Qty</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_transfers.Transfers.Count == 0)
                    {
                        <tr><td colspan="6">No stock transfers yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var t in _transfers.Transfers)
                        {
                            <tr>
                                <td><strong>@(string.IsNullOrWhiteSpace(t.TransferNo) ? $"#{t.Id}" : t.TransferNo)</strong></td>
                                <td>@t.FromWarehouseId.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@t.ToWarehouseId.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@(string.IsNullOrWhiteSpace(t.Reason) ? "—" : t.Reason)</td>
                                <td>@t.Status</td>
                                <td class="text-right">@t.TotalQty.ToString("N2", CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Code</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Code) ? "—" : _opened.Code)</dd>
                <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Name) ? "—" : _opened.Name)</dd>
                <dt>Storage ID</dt><dd>@(_opened.StorageId > 0 ? _opened.StorageId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Active</dt><dd>@(_opened.Active ? "active" : "inactive")</dd>
                <dt>Created</dt><dd>@FormatTime(_opened.TimeCreated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Create and transfer stay on the virtual-warehouse tab.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.NameExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">name excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.NameExcerpt</pre>
                @if (_opened.NameLen > _opened.NameExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.NameExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NameLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No name excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-active siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Storage</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Code) ? "—" : sib.Code)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Name) ? "—" : sib.Name)</td>
                                <td>@(sib.StorageId > 0 ? sib.StorageId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "warehouse_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-active siblings yet.</p>
            }
        </div>
    }
    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Warehouse KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_warehouses.Count</div></div>
        <div class="kpi"><div class="lbl">Active in page</div><div class="val">@_active</div></div>
        <div class="kpi"><div class="lbl">Linked to shop storage</div><div class="val">@_linkedStorage</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Storage ID</th>
                    <th>Created</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_warehouses.Count == 0)
                {
                    <tr><td colspan="6">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var w in _warehouses)
                    {
                        <tr id="erp-row-@w.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(w.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(w.Code) ? $"#{w.Id}" : w.Code)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(w.Name) ? "—" : w.Name)</td>
                            <td>@(w.StorageId > 0 ? w.StorageId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@FormatTime(w.TimeCreated)</td>
                            <td><span class="label label-default">@(w.Active ? "active" : "inactive")</span></td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "warehouse_id", w.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
            </table>
        </div>
    }

</PhpErpDesktopChrome>

@code {
    private const string _listHref = "/erp/warehouses-app";
    private string _phpTab = "/ERP/?epc_erp_shell=1&area=inventory_mgmt&tab=inventory";
    private const string _phpWms = "/ERP/?epc_erp_shell=1&area=warehouse&tab=wms";
    private string _title = "Warehouses";
    private string _subtitle = "Warehouse master linked to shop storage.";
    private string _view = "warehouses";
    private bool _isAdmin;
    private long _openedId;
    private ErpWarehouseDetail? _opened;
    private IReadOnlyList<ErpWarehouseDigest> _openedSiblings = [];
    private IReadOnlyList<ErpWarehouseDigest> _warehouses = [];
    private IReadOnlyList<ErpWarehouseDigest> _virtual = [];
    private ErpStockTransfersDigestResult _transfers = new(new(0, 0, 0, 0, 0, "n/a", ""), [], 0, "n/a", "");
    private int _active;
    private int _linkedStorage;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";
    private string _ok = "";
    private string _err = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _ok = ctx.Request.Query["ok"].ToString();
        _err = ctx.Request.Query["err"].ToString();
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "warehouse_id");
        var tab = (ctx.Request.Query["tab"].ToString() ?? "").Trim().ToLowerInvariant();
        _view = tab == "virtual_warehouse" ? "virtual_warehouse" : "warehouses";
        _phpTab = _view == "virtual_warehouse"
            ? "/ERP/?epc_erp_shell=1&area=warehouse&tab=virtual_warehouse"
            : "/ERP/?epc_erp_shell=1&area=inventory_mgmt&tab=inventory";
        _title = _view == "virtual_warehouse" ? "Virtual warehouse" : "Warehouses";
        _subtitle = _view == "virtual_warehouse"
            ? "Exhibition, display, consignment and transit locations. Create and transfer are live when confirmed."
            : "Open a row for the 280-character name excerpt and same-active siblings. Warehouse master linked to shop storage.";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        if (_view == "virtual_warehouse")
        {
            var vw = await Dashboards.BuildErpVirtualWarehouseDigestAsync(_limit, ctx.RequestAborted);
            _virtual = vw.Locations;
            _transfers = vw.Transfers;
            _source = vw.Source;
            _message = vw.Message;
            return;
        }

        var result = await Dashboards.ListErpWarehousesAsync(_limit, ctx.RequestAborted);
        _warehouses = result.Warehouses;
        _active = _warehouses.Count(w => w.Active);
        _linkedStorage = _warehouses.Count(w => w.StorageId > 0);
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpWarehouseDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Warehouse;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _warehouses.FirstOrDefault(w => w.Id == _openedId);
                if (openedList is not null)
                {
                    _warehouses = new[] { openedList }.Concat(_warehouses.Where(w => w.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }

    private string OpenedListHref => _view == "virtual_warehouse"
        ? _listHref + "?tab=virtual_warehouse"
        : _listHref;

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?warehouse_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : OpenedListHref;

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.Code)
            ? _opened.Code
            : (!string.IsNullOrWhiteSpace(_opened.Name)
                ? _opened.Name
                : ("Warehouse #" + _opened.Id.ToString(CultureInfo.InvariantCulture))))
            + (_opened.Active ? " · active" : " · inactive");

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
