@page "/cp/doc-expiry-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Doc expiry · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-w17-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-w17-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-w17-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-w17-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-w17-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f172a; background:#fff;
        }
        .epc-w17-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-w17-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-w17-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-w17-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-w17-kpi span { color:#64748b; font-size:.78rem; }
        .epc-w17-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-w17-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-w17-table th, .epc-w17-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-w17-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-w17-note { margin-top:1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:.45rem; color:#334155; font-size:.86rem; }
        @@media (max-width:900px){ .epc-w17-kpis{grid-template-columns:1fr 1fr;} }
    
</style>
</HeadContent>


<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-w17-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Doc expiry</h1>
        <p>@CpPhpModuleCopy.PurposeFor(Nav.Uri)</p>
        <div class="epc-w17-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
        </div>
    </section>
    <PhpParityModuleBody AppPath="/cp/doc-expiry-app" IsAdmin="_isAdmin" />


    <div class="epc-w17-kpis" aria-label="Doc expiry stats">
        <div class="epc-w17-kpi"><strong>@_summary.DocumentCount.ToString(CultureInfo.InvariantCulture)</strong><span>Documents</span></div>
        <div class="epc-w17-kpi"><strong>@_summary.ActiveCount.ToString(CultureInfo.InvariantCulture)</strong><span>Active</span></div>
        <div class="epc-w17-kpi"><strong>@_summary.ExpiredCount.ToString(CultureInfo.InvariantCulture)</strong><span>Expired</span></div>
        <div class="epc-w17-kpi"><strong>@_summary.ReminderCount.ToString(CultureInfo.InvariantCulture)</strong><span>Reminders</span></div>
    </div>

    <div class="epc-w17-table-wrap">
    <table class="epc-w17-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Company</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Title</th>
                    <th>Ref</th>
                    <th>Owner</th>
                    <th>Issuer</th>
                    <th>Source</th>
                    <th>Expiry</th>
                    <th>Active</th>
                    <th>Created</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="13">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CompanyId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Category) ? row.Category : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.DocType) ? row.DocType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.RefNo) ? row.RefNo : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Owner) ? row.Owner : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Issuer) ? row.Issuer : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.SourceModule) ? row.SourceModule : "—")</td>
                            <td>@row.ExpiryDate.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.Active.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.TimeCreated.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=risk&tab=doc_expiry";
    private bool _isAdmin;
    private CpDocExpirySummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpDocExpiryDocumentDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpDocExpiryDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Documents;
        _source = result.Source;
        _message = result.Message;
    }
}
