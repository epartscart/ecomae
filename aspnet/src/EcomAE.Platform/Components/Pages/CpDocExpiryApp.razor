@page "/cp/doc-expiry-app"
@page "/erp/doc-expiry-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Doc expiry · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Doc expiry
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/doc-expiry-app")</p>
                <p>Save or delete an expiry-tracked document here. Open a row for notes, reminder email, attachment, and reminder log.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/doc-expiry-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedDetail is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Doc expiry KPIs">
        <div class="kpi"><div class="lbl">Documents</div><div class="val">@_summary.DocumentCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active</div><div class="val">@_summary.ActiveCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Expired</div><div class="val">@_summary.ExpiredCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Reminders</div><div class="val">@_summary.ReminderCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedDetail is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedDetail.Title) ? _openedDetail.Title : (!string.IsNullOrWhiteSpace(_openedDetail.DocType) ? _openedDetail.DocType : ("Doc #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture))))
                    <span class="label label-default pull-right">@(_openedDetail.Active == 1 ? "active" : "inactive")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedDetail.Category) ? _openedDetail.Category : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedDetail.DocType) ? _openedDetail.DocType : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedDetail.RefNo) ? _openedDetail.RefNo : "no ref")</p>
                    <p>Owner @(!string.IsNullOrWhiteSpace(_openedDetail.Owner) ? _openedDetail.Owner : "—")
                        @if (!string.IsNullOrWhiteSpace(_openedDetail.OwnerEmail))
                        {
                            <span> · @_openedDetail.OwnerEmail</span>
                        }
                    </p>
                    <p>Issuer @(!string.IsNullOrWhiteSpace(_openedDetail.Issuer) ? _openedDetail.Issuer : "—")
                        · Expiry @_openedDetail.ExpiryDate.ToString(CultureInfo.InvariantCulture)
                        @if (!string.IsNullOrWhiteSpace(_openedDetail.ReminderDays))
                        {
                            <span> · Lead @_openedDetail.ReminderDays</span>
                        }
                    </p>
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.AttachmentPath))
                    {
                        <p>File @_openedDetail.AttachmentPath</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.Note))
                    {
                        <p class="text-muted">@_openedDetail.Note</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Reminders sent</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Lead days</th>
                                    <th>Days left</th>
                                    <th>Recipient</th>
                                    <th>Channel</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedReminders.Count == 0)
                                {
                                    <tr><td colspan="4">No reminders yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var rem in _openedReminders)
                                    {
                                        <tr>
                                            <td>@rem.ThresholdDays.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@rem.DaysLeft.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(rem.Recipient) ? rem.Recipient : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(rem.Channel) ? rem.Channel : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_summary.DocumentCount.ToString(CultureInfo.InvariantCulture) Documents · @_summary.ActiveCount.ToString(CultureInfo.InvariantCulture) Active · @_summary.ExpiredCount.ToString(CultureInfo.InvariantCulture) Expired · @_summary.ReminderCount.ToString(CultureInfo.InvariantCulture) Reminders.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Company</th>
                                <th>Category</th>
                                <th>Type</th>
                                <th>Title</th>
                                <th>Ref</th>
                                <th>Owner</th>
                                <th>Issuer</th>
                                <th>Source</th>
                                <th>Expiry</th>
                                <th>Active</th>
                                <th>Created</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_rows.Count == 0)
                            {
                                <tr><td colspan="13">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
                            }
                            else
                            {
                                @foreach (var row in _rows)
                                {
                                    <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                        <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@row.CompanyId.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.Category) ? row.Category : "—")</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.DocType) ? row.DocType : "—")</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.RefNo) ? row.RefNo : "—")</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.Owner) ? row.Owner : "—")</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.Issuer) ? row.Issuer : "—")</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.SourceModule) ? row.SourceModule : "—")</td>
                                        <td>@row.ExpiryDate.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@row.Active.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@row.TimeCreated.ToString(CultureInfo.InvariantCulture)</td>
                                        <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "doc", row.Id)">Open</a></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

<ErpPhpCreateWell Title="Remove document">
<form method="post" action="/erp/doc-expiry/delete" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                <input type="hidden" name="returnUrl" value="@_listHref" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Id <input class="form-control input-sm" type="number" name="id" min="1" required style="width:90px;" value="@OpenedIdValue" /></label>
                <button type="submit" class="btn btn-danger btn-sm">Remove from register</button>
            </form>
</ErpPhpCreateWell>

<ErpPhpCreateWell Title="Add document">
<form method="post" action="/erp/doc-expiry/save" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                <input type="hidden" name="returnUrl" value="@_returnHref" />
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="id" value="@OpenedIdValue" />
                <label>Category
                    <select class="form-control input-sm" name="category">
                        <option value="legal">Legal</option>
                        <option value="customer">Customer</option>
                        <option value="insurance">Insurance</option>
                        <option value="banking">Banking</option>
                        <option value="other">Other</option>
                    </select>
                </label>
                <label>Document type <input class="form-control input-sm" name="doc_type" placeholder="e.g. Trade Licence" required style="width:180px;" /></label>
                <label>Title <input class="form-control input-sm" name="title" style="width:160px;" /></label>
                <label>Reference <input class="form-control input-sm" name="ref_no" style="width:120px;" /></label>
                <label>Issuer <input class="form-control input-sm" name="issuer" style="width:140px;" /></label>
                <label>Owner <input class="form-control input-sm" name="owner" style="width:140px;" /></label>
                <label>Reminder email <input class="form-control input-sm" type="email" name="owner_email" style="width:180px;" value="@OpenedEmail" /></label>
                <label>Issue <input class="form-control input-sm" type="date" name="issue_date_str" /></label>
                <label>Expiry <input class="form-control input-sm" type="date" name="expiry_date_str" required /></label>
                <label>Lead days <input class="form-control input-sm" name="reminder_days" value="90,60,30,7" style="width:120px;" /></label>
                <label>Attachment path <input class="form-control input-sm" name="attachment_path" style="width:180px;" /></label>
                <label>Note <input class="form-control input-sm" name="note" style="width:180px;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Add to register</button>
            </form>
</ErpPhpCreateWell>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=risk&tab=doc_expiry";
    private bool _isAdmin;
    private CpDocExpirySummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpDocExpiryDocumentDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private CpDocExpiryDocumentDetail? _openedDetail;
    private IReadOnlyList<CpDocExpiryReminderDigest> _openedReminders = [];
    private string _listHref = "/cp/doc-expiry-app";
    private string _returnHref = "/cp/doc-expiry-app";

    private string OpenedCaption => _openedDetail is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedDetail.Title)
            ? (string.IsNullOrWhiteSpace(_openedDetail.DocType) ? ("Doc #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.DocType)
            : _openedDetail.Title)
            + " · " + (_openedDetail.Active == 1 ? "active" : "inactive");

    private string OpenedIdValue => _openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "";

    private string OpenedEmail => _openedDetail is null || string.IsNullOrWhiteSpace(_openedDetail.OwnerEmail)
        ? ""
        : _openedDetail.OwnerEmail;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var path = ctx.Request.Path.Value;
        _listHref = string.Equals(path, "/erp/doc-expiry-app", StringComparison.OrdinalIgnoreCase)
            ? "/erp/doc-expiry-app"
            : "/cp/doc-expiry-app";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "doc", "document_id");
        _returnHref = _openedId > 0
            ? ErpRecordOpen.Href(_listHref, "doc", _openedId).Split('#')[0]
            : _listHref;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpDocExpiryDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Documents;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpDocExpiryDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Document;
            _openedReminders = detail.Reminders;
            if (_openedDetail is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
