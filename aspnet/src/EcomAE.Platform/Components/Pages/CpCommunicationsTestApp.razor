@page "/cp/communications-test-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Routing
@inject ICpCommunicationsDeskService Desk
@inject ILegacySessionValidator Sessions
@inject ICpCsrfGuard Csrf
@inject IHttpContextAccessor Http

<PageTitle>Communications test · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
    .epc-cn { --cn-ink:#0f172a; --cn-muted:#64748b; --cn-line:#e2e8f0; --cn-soft:#f8fafc; --cn-accent:#0f766e; --cn-email:#0369a1; --cn-sms:#0f766e; color:var(--cn-ink); }
    .epc-cn-hero { background:linear-gradient(125deg,#0f172a 0%,#134e4a 52%,#0f766e 100%); color:#fff; border-radius:14px; padding:20px 22px; margin:0 0 16px; }
    .epc-cn-hero h3 { margin:0 0 6px; color:#fff; font-size:20px; }
    .epc-cn-hero p { margin:0; opacity:.92; max-width:52rem; line-height:1.45; font-size:13px; }
    .epc-cn-hero__actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }
    .epc-cn-hero__actions .btn { border:1px solid rgba(255,255,255,.28); background:rgba(255,255,255,.12); color:#fff; font-weight:600; }
    .epc-cn-hero__actions .btn-primary { background:#fff; color:#0f172a; border-color:#fff; }
    .epc-cn-quick { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:12px; margin:0 0 16px; }
    .epc-cn-quick a { display:block; background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:14px 15px; color:#0f172a; text-decoration:none !important; }
    .epc-cn-quick strong { display:block; font-size:14px; margin-bottom:3px; }
    .epc-cn-quick span { display:block; font-size:12px; color:#64748b; line-height:1.4; }
    .epc-cn-guide { background:linear-gradient(135deg,#f0fdfa 0%,#f0f9ff 100%); border:1px solid #cce7e2; border-radius:12px; padding:16px 18px; margin:0 0 16px; }
    .epc-cn-guide h4 { margin:0 0 10px; font-size:14px; font-weight:700; color:#134e4a; }
    .epc-cn-steps { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:10px; margin:0; padding:0; list-style:none; }
    .epc-cn-steps li { background:rgba(255,255,255,.75); border:1px solid #d9ebe7; border-radius:10px; padding:12px; font-size:12px; line-height:1.45; color:#334155; }
    .epc-cn-steps strong { display:block; color:#0f172a; font-size:13px; margin-bottom:2px; }
    .epc-cn-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; margin-bottom:8px; }
    @@media (max-width:991px){ .epc-cn-grid{grid-template-columns:1fr;} }
    .epc-cn-card { background:#fff; border:1px solid #e2e8f0; border-radius:14px; overflow:hidden; }
    .epc-cn-card__head { display:flex; align-items:flex-start; justify-content:space-between; gap:10px; padding:14px 16px; border-bottom:1px solid #e2e8f0; background:#f8fafc; }
    .epc-cn-card__head h4 { margin:0 0 2px; font-size:15px; font-weight:700; }
    .epc-cn-card__head p { margin:0; font-size:12px; color:#64748b; }
    .epc-cn-card__body { padding:16px; }
    .epc-cn-card.is-email .epc-cn-card__head { border-top:3px solid #0369a1; }
    .epc-cn-card.is-sms .epc-cn-card__head { border-top:3px solid #0f766e; }
    .epc-cn-status { display:flex; flex-wrap:wrap; gap:8px; margin:0 0 14px; }
    .epc-cn-pill { display:inline-flex; align-items:center; gap:6px; border-radius:999px; padding:4px 10px; font-size:12px; font-weight:600; background:#f1f5f9; color:#334155; }
    .epc-cn-pill.is-ok { background:#dcfce7; color:#15803d; }
    .epc-cn-pill.is-bad { background:#fee2e2; color:#b91c1c; }
    .epc-cn-pill.is-idle { background:#e2e8f0; color:#64748b; }
    .epc-cn-pill.is-stale { background:#fef9c3; color:#a16207; }
    .epc-cn-pill.is-old { background:#ffedd5; color:#c2410c; }
    .epc-cn-meta { font-size:13px; color:#334155; line-height:1.5; }
    .epc-cn-test { margin-top:14px; padding-top:14px; border-top:1px dashed #e2e8f0; }
    .epc-cn-test label { font-size:12px; font-weight:600; color:#334155; }
    .epc-cn-test .help { margin:6px 0 0; font-size:12px; color:#64748b; }
</style>
</HeadContent>

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12 epc-cn" id="epc-cn-comms-root">
        <div class="epc-cn-hero">
            <h3>Communications</h3>
            <p>Check SMTP and SMS readiness, see the last test result from <code>debug_results</code>, and send a test e-mail or SMS to confirm delivery.</p>
            <div class="epc-cn-hero__actions">
                <a class="btn btn-sm btn-primary" href="@EmailSettingsHref"><i class="far fa-envelope"></i> E-mail settings</a>
                <a class="btn btn-sm" href="/cp/sms-whatsapp-app"><i class="fas fa-mobile-alt"></i> SMS operators</a>
                <a class="btn btn-sm" href="/cp/notifications-app"><i class="fas fa-envelope-open-text"></i> Templates</a>
                <a class="btn btn-sm" href="/cp"><i class="fas fa-home"></i> Control panel</a>
                <a class="btn btn-sm" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
        </div>

        <div class="epc-cn-quick">
            <a class="is-email" href="@EmailSettingsHref">
                <strong>SMTP / From address</strong>
                <span>Host, port, encryption, username, From name &amp; e-mail.</span>
            </a>
            <a class="is-sms" href="/cp/sms-whatsapp-app">
                <strong>SMS operator</strong>
                <span>Activate Etisalat, du, Unifonic, or Pakistan — set sender number.</span>
            </a>
            <a class="is-templates" href="/cp/notifications-app">
                <strong>Notification templates</strong>
                <span>Turn e-mail / SMS on per event and edit message bodies.</span>
            </a>
            <a href="/cp/ops-guides-app">
                <strong>CP guideline</strong>
                <span>Full map of System → Communications workflows.</span>
            </a>
        </div>

        <div class="epc-cn-guide">
            <h4>How to get messaging working</h4>
            <ol class="epc-cn-steps">
                <li><strong>Configure e-mail</strong>Fill SMTP fields in Configuration → E-mail group, then return here to test.</li>
                <li><strong>Activate SMS</strong>Pick one operator, paste API credentials, confirm sender number (default +971567607011).</li>
                <li><strong>Edit templates</strong>Enable e-mail/SMS per event under Notification settings.</li>
                <li><strong>Test here</strong>Send a test to your inbox / mobile. Green status means the last test succeeded.</li>
            </ol>
        </div>

        @if (!string.IsNullOrEmpty(_flashOk))
        {
            <div class="alert alert-success" role="status">@_flashOk</div>
        }
        @if (!string.IsNullOrEmpty(_flashErr))
        {
            <div class="alert alert-danger" role="alert">@_flashErr</div>
        }

        @if (!_isAdmin)
        {
            <div class="alert alert-warning" role="status">Sign in with an admin CP session to check and test messaging. <a href="/cp/login?returnUrl=/cp/communications-test-app">Sign in</a></div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_view.Error))
            {
                <div class="alert alert-warning" role="status">@_view.Error</div>
            }

            <div class="epc-cn-grid">
                <div class="epc-cn-card is-email">
                    <div class="epc-cn-card__head">
                        <div>
                            <h4><i class="far fa-envelope"></i> E-mail</h4>
                            <p>SMTP settings from Configuration → E-mail.</p>
                        </div>
                        <a class="btn btn-sm btn-success" href="@EmailSettingsHref"><i class="far fa-envelope"></i> Settings</a>
                    </div>
                    <div class="epc-cn-card__body">
                        <div class="epc-cn-status">
                            <span class="epc-cn-pill @(_view.EmailConfigured ? "is-ok" : "is-bad")">@(_view.EmailConfigured ? "Configured" : "Not configured")</span>
                            <span class="epc-cn-pill is-@_view.EmailDebug.Pill @_view.EmailDebug.AgeClass">@_view.EmailDebug.Label</span>
                        </div>
                        <div class="epc-cn-meta">
                            @if (_view.EmailConfigured)
                            {
                                <text>From <code>@_view.FromEmail</code></text>
                                @if (!string.IsNullOrEmpty(_view.SmtpHost))
                                {
                                    <text> · SMTP <code>@_view.SmtpHost:@_view.SmtpPort</code></text>
                                }
                                <br />@_view.EmailDebug.Meta
                            }
                            else
                            {
                                <text>Fill all SMTP fields (From name, From e-mail, mode, encryption, host, port, username, password) to enable e-mail.</text>
                            }
                        </div>
                        @if (_view.EmailConfigured)
                        {
                            <form class="epc-cn-test" method="post" action="@EcomAeRoutes.CpCommunicationsTest">
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="csrf_guard_key" value="@_csrfKey" />
                                <input type="hidden" name="type" value="email" />
                                <input type="hidden" name="returnUrl" value="/cp/communications-test-app" />
                                <label for="email_for_test">E-mail for test letter</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="E-mail" value="@_view.TestEmail" id="email_for_test" name="contact" required />
                                    <span class="input-group-btn">
                                        <button type="submit" class="btn btn-primary"><i class="far fa-envelope"></i> Send test</button>
                                    </span>
                                </div>
                                <p class="help">Uses the <code>test_email</code> notification template and records the result.</p>
                            </form>
                        }
                    </div>
                </div>

                <div class="epc-cn-card is-sms">
                    <div class="epc-cn-card__head">
                        <div>
                            <h4><i class="fas fa-mobile-alt"></i> SMS</h4>
                            <p>Active operator from SMS operators.</p>
                        </div>
                        <a class="btn btn-sm btn-success" href="/cp/sms-whatsapp-app"><i class="fas fa-mobile-alt"></i> Operators</a>
                    </div>
                    <div class="epc-cn-card__body">
                        <div class="epc-cn-status">
                            <span class="epc-cn-pill @(_view.SmsConfigured ? "is-ok" : "is-bad")">@(_view.SmsConfigured ? "Configured" : "Not configured")</span>
                            <span class="epc-cn-pill is-@_view.SmsDebug.Pill @_view.SmsDebug.AgeClass">@_view.SmsDebug.Label</span>
                        </div>
                        <div class="epc-cn-meta">
                            @if (_view.SmsConfigured)
                            {
                                <text>Operator <code>@(string.IsNullOrEmpty(_view.SmsOperatorName) ? "Active" : _view.SmsOperatorName)</code></text>
                                @if (!string.IsNullOrEmpty(_view.SmsHandler))
                                {
                                    <text> · Handler <code>@_view.SmsHandler</code></text>
                                }
                                @if (!string.IsNullOrEmpty(_view.SmsSender))
                                {
                                    <text> · From <code>@_view.SmsSender</code></text>
                                }
                                <br />@_view.SmsDebug.Meta
                            }
                            else
                            {
                                <text>No active SMS operator. Activate one on the SMS operators page.</text>
                            }
                        </div>
                        @if (_view.SmsConfigured)
                        {
                            <form class="epc-cn-test" method="post" action="@EcomAeRoutes.CpCommunicationsTest">
                                <input type="hidden" name="confirmWrites" value="true" />
                                <input type="hidden" name="csrf_guard_key" value="@_csrfKey" />
                                <input type="hidden" name="type" value="phone" />
                                <input type="hidden" name="returnUrl" value="/cp/communications-test-app" />
                                <label for="phone_for_test">Phone for test SMS</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="Phone" value="@_view.TestPhone" id="phone_for_test" name="contact" required />
                                    <span class="input-group-btn">
                                        <button type="submit" class="btn btn-primary"><i class="fas fa-mobile-alt"></i> Send test</button>
                                    </span>
                                </div>
                                <p class="help">Uses the <code>test_phone</code> notification template through the active operator.</p>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/communications";
    private const string EmailSettingsHref = "/cp/config-items-app?need_config_group=3";
    private bool _isAdmin;
    private CpCommunicationsView _view = CpCommunicationsView.Empty("", "");
    private string _flashOk = "";
    private string _flashErr = "";
    private string _csrfKey = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        _csrfKey = await Csrf.KeyForAsync(ctx, session, ctx.RequestAborted);
        if (!_isAdmin)
        {
            return;
        }

        _flashOk = ctx.Request.Query["ok"].ToString();
        _flashErr = ctx.Request.Query["err"].ToString();
        _view = await Desk.LoadAsync(session.UserId, session.Email, ctx.RequestAborted);
    }
}
