@page "/cp/event-bus-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Event bus · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

@if (_allowed)
{
    <PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Event bus
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/event-bus-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/event-bus-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_eventCount.ToString(CultureInfo.InvariantCulture) Events · @_typeCount.ToString(CultureInfo.InvariantCulture) Types · @_tenantCount.ToString(CultureInfo.InvariantCulture) Tenants · @_last24h.ToString(CultureInfo.InvariantCulture) Last 24h.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Type</th>
                    <th>Tenant</th>
                    <th>Actor</th>
                    <th>Created</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="6">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.EventType) ? row.EventType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.TenantKey) ? row.TenantKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ActorType) ? row.ActorType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CreatedAt) ? row.CreatedAt : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="epc-nw-note">Super CP host only. MySQL epc_events peek — no Kafka/Rabbit brokers or payloads.</div>

</PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>This control is available on the platform Super CP host only.</p>
        <p><a href="/cp">Open Control Panel</a></p>
    </div>
}

@code {
    private bool _allowed;
    private const string _phpTab = "/CP/control/portal/epc_event_bus";
    private bool _isAdmin;
    private int _eventCount = 0;
    private int _typeCount = 0;
    private int _tenantCount = 0;
    private int _last24h = 0;
    private IReadOnlyList<CpEventBusRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpEventBusDigestAsync(200, ctx.RequestAborted);
        _eventCount = result.Summary.EventCount;
        _typeCount = result.Summary.TypeCount;
        _tenantCount = result.Summary.TenantCount;
        _last24h = result.Summary.Last24h;
        _rows = result.Rows;
        _source = result.Source;
        _message = result.Message;
    }
}
