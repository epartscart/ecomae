@page "/cp/event-bus-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Event bus · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

@if (_allowed)
{
    <PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Event bus
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/event-bus-app")</p>
                <p>Open a row for type, tenant, actor, and a short payload excerpt. Webhook dispatch stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/event-bus-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedEvent is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Event bus KPIs">
        <div class="kpi"><div class="lbl">Events</div><div class="val">@_eventCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Types</div><div class="val">@_typeCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Tenants</div><div class="val">@_tenantCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Last 24h</div><div class="val">@_last24h.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedEvent is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedEvent.EventType) ? _openedEvent.EventType : ("Event #" + _openedEvent.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedEvent.CreatedAt) ? _openedEvent.CreatedAt : "—")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedEvent.TenantKey) ? _openedEvent.TenantKey : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedEvent.ActorType) ? _openedEvent.ActorType : "—")
                        #@_openedEvent.ActorId.ToString(CultureInfo.InvariantCulture)</p>
                    @if (!string.IsNullOrWhiteSpace(_openedEvent.IdempotencyKey))
                    {
                        <p>Idempotency @_openedEvent.IdempotencyKey</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedEvent.PayloadExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedEvent.PayloadExcerpt</pre>
                        @if (_openedEvent.PayloadLen > _openedEvent.PayloadExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_openedEvent.PayloadExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedEvent.PayloadLen.ToString(CultureInfo.InvariantCulture) chars). Full payload stays on the Classic twin.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No payload excerpt yet.</p>
                    }
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_eventCount.ToString(CultureInfo.InvariantCulture) Events · @_typeCount.ToString(CultureInfo.InvariantCulture) Types · @_tenantCount.ToString(CultureInfo.InvariantCulture) Tenants · @_last24h.ToString(CultureInfo.InvariantCulture) Last 24h.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Type</th>
                    <th>Tenant</th>
                    <th>Actor</th>
                    <th>Created</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="6">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.EventType) ? row.EventType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.TenantKey) ? row.TenantKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ActorType) ? row.ActorType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CreatedAt) ? row.CreatedAt : "—")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "event_id", row.Id)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="epc-nw-note">Super CP host only. MySQL epc_events peek — no Kafka/Rabbit brokers. Webhook dispatch stays on the Classic twin.</div>

</PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>This control is available on the platform Super CP host only.</p>
        <p><a href="/cp">Open Control Panel</a></p>
    </div>
}

@code {
    private bool _allowed;
    private const string _phpTab = "/CP/control/portal/epc_event_bus";
    private const string _listHref = "/cp/event-bus-app";
    private bool _isAdmin;
    private int _eventCount = 0;
    private int _typeCount = 0;
    private int _tenantCount = 0;
    private int _last24h = 0;
    private IReadOnlyList<CpEventBusRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private CpEventBusEventDetail? _openedEvent;

    private string OpenedCaption => _openedEvent is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedEvent.EventType) ? ("Event #" + _openedEvent.Id.ToString(CultureInfo.InvariantCulture)) : _openedEvent.EventType)
            + " · " + (string.IsNullOrWhiteSpace(_openedEvent.TenantKey) ? "bus" : _openedEvent.TenantKey);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "event_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpEventBusDigestAsync(200, ctx.RequestAborted);
        _eventCount = result.Summary.EventCount;
        _typeCount = result.Summary.TypeCount;
        _tenantCount = result.Summary.TenantCount;
        _last24h = result.Summary.Last24h;
        _rows = result.Rows;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpEventBusDetailAsync(_openedId, ctx.RequestAborted);
            _openedEvent = detail.Event;
            if (_openedEvent is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
