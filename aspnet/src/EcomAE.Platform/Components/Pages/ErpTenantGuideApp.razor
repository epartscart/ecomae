@page "/erp/tenant-guide"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@using System.Text
@using System.Web
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject IErpTenantGuideReadService Guide
@inject ICpCsrfGuard Csrf
@inject IErpShamModuleFlowsService Flows

<PageTitle>Tenant guide · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<style>
    .tg-card { background:#fff; border:1px solid #dde6ee; border-radius:10px; padding:16px 18px; margin:0 0 16px; box-shadow:0 1px 2px rgba(16,42,66,.05); }
    .tg-card h3 { margin:0 0 8px; font-size:15px; color:#12324f; }
    .tg-card p, .tg-card li { font-size:12.5px; color:#40566c; line-height:1.55; }
    .tg-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:14px; }
    .tg-num { display:inline-block; min-width:22px; height:22px; line-height:22px; border-radius:11px; background:#12324f; color:#fff; text-align:center; font-size:12px; margin-right:6px; }
    .tg-form label { display:block; font-size:11px; color:#4a627a; margin:8px 0 2px; }
    .tg-form input, .tg-form select, .tg-form textarea { width:100%; box-sizing:border-box; border:1px solid #c3d3de; border-radius:6px; padding:6px 8px; font-size:12.5px; }
    .tg-form button { margin-top:10px; background:#12324f; color:#fff; border:0; border-radius:6px; padding:7px 14px; font-size:12.5px; cursor:pointer; }
    .tg-flash { border-radius:8px; padding:10px 14px; margin:0 0 16px; font-size:13px; }
    .tg-flash-ok { background:#e8f6ee; border:1px solid #9fd8b6; color:#0f6b3f; }
    .tg-flash-err { background:#fdeaea; border:1px solid #f0b4b4; color:#9c1c1c; }
    .tg-table { width:100%; border-collapse:collapse; font-size:12px; }
    .tg-table th, .tg-table td { border-bottom:1px solid #e4ecf2; padding:6px 8px; text-align:left; }
    .tg-table th { color:#12324f; background:#f4f8fb; }
    .tg-live { color:#0f6b3f; font-weight:600; } .tg-empty { color:#9c5c1c; font-weight:600; }
</style>

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Tenant guide" BreadcrumbArea="Organization" BreadcrumbTab="Guide">
    <PhpErpModulePageHeader
        Title="Your organisation, visually"
        Subtitle="A live map of this tenant's legal entities, business units and warehouses — plus how the main flows connect. This page reads the real org data, not a static document."
        PhpTabHref="/erp/tenant-guide" />

    @if (_flashOk.Length > 0)
    {
        <div class="tg-flash tg-flash-ok">@_flashOk</div>
    }
    @if (_flashErr.Length > 0)
    {
        <div class="tg-flash tg-flash-err">@_flashErr</div>
    }

    @if (!_loaded)
    {
        <div class="tg-card"><p>Loading the organisation map…</p></div>
    }
    else if (!_model.HasOrgData)
    {
        <div class="tg-card">
            <h3>No organisation data yet</h3>
            <p>This tenant has no legal entities seeded. For ERP-only tenants, run the foundation seed from the control centre — the guide draws the full structure here automatically afterwards.</p>
        </div>
    }
    else
    {
        <div class="tg-card" style="overflow-x:auto">
            <h3>Organisation structure</h3>
            @((MarkupString)BuildSvg())
            <p style="color:#4a627a;font-size:12px;margin:6px 0 0">
                @_model.Entities.Count legal entit@(_model.Entities.Count == 1 ? "y" : "ies") ·
                @_model.BusinessUnits.Count business unit@(_model.BusinessUnits.Count == 1 ? "" : "s") ·
                @_model.WarehouseCount warehouse@(_model.WarehouseCount == 1 ? "" : "s")
            </p>
        </div>

        <div class="tg-grid">
            <div class="tg-card">
                <h3><span class="tg-num">1</span>Work in a legal entity</h3>
                <p>The top bar carries a <strong>company switcher</strong> — it sets which legal entity your screens post to. In the URL it is <code>?company=N</code> (entity id) or <code>?cmp=CODE</code> (e.g. <code>?cmp=ASAPL</code>). Add <code>&amp;bu=CODE</code> to pin a business unit. Posting endpoints and workspaces honour the same selection and enforce access per entity × BU × role × action.</p>
            </div>
            <div class="tg-card">
                <h3><span class="tg-num">2</span>Users &amp; access</h3>
                <p>Create users in <strong>/erp/users-app</strong>, then grant entity + BU + action rights in the organization admin workspace (<strong>org_user_access</strong> tab). Grants are checked server-side — UI hiding is never the only control.</p>
            </div>
            <div class="tg-card">
                <h3><span class="tg-num">3</span>Intercompany</h3>
                <p>Trade between your entities via the intercompany workspace (<strong>/erp/intercompany-app</strong>). The paired journal (<code>POST /erp/sham/ic-post</code>) posts both legs in one transaction with an <code>IC-&lt;ref&gt;</code> trace, granted per entity.</p>
            </div>
            <div class="tg-card">
                <h3><span class="tg-num">4</span>Order-to-cash</h3>
                <p>Reserve stock with <code>stock-reserve</code>, issue the invoice with <code>sales-invoice-issue</code>, then post to GL with <code>invoice-post</code> — posted amounts come from the issued document and the order's holds are consumed in the same transaction.</p>
            </div>
            <div class="tg-card">
                <h3><span class="tg-num">5</span>Procure-to-pay</h3>
                <p>Receipts land in the BU's default warehouse via <code>po-receive</code> (movement + weighted-average stock). VAT posts to 1150/2100 and <code>GET /erp/sham/vat-summary</code> gives the per-entity FTA return input.</p>
            </div>
            <div class="tg-card">
                <h3><span class="tg-num">6</span>Close &amp; consolidate</h3>
                <p>Lock a month per entity with <code>period-lock</code> — posting engines refuse locked periods. Consolidated statements include only the solid-green entities above; dashed ones stay off group reports.</p>
            </div>
        </div>

        @if (_isAdmin)
        {
            <h3 style="margin:18px 0 10px;color:#12324f">Operate the blueprint (§8–§14)</h3>
            <div class="tg-grid">
                <div class="tg-card tg-form">
                    <h3>MSP pricing (§8)</h3>
                    <form method="post" action="@Post("/erp/sham/msp-set")">
                        @HiddenFields()
                        <label>Legal entity</label><input name="entity" value="@_cmp" required />
                        <label>Business unit</label><input name="bu" value="@_bu" required />
                        <label>Unit margin %</label><input name="unit" type="number" step="0.01" min="0" max="100" value="0" />
                        <label>Offer margin %</label><input name="offer" type="number" step="0.01" min="0" max="100" value="0" />
                        <label>Actual margin %</label><input name="actual" type="number" step="0.01" min="0" max="100" value="0" />
                        <label>MSP margin %</label><input name="msp" type="number" step="0.01" min="0" max="100" value="0" />
                        <button type="submit">Append MSP version</button>
                    </form>
                    <p style="margin-top:8px"><a href="@Get("/erp/sham/msp-check")?cmp=@Uri.EscapeDataString(_cmp)&amp;buc=@Uri.EscapeDataString(_bu)">View version history</a></p>
                </div>

                <div class="tg-card tg-form">
                    <h3>Landed cost (§9)</h3>
                    <form method="post" action="@Post("/erp/sham/landed-cost")">
                        @HiddenFields()
                        <label>Legal entity</label><input name="entity" value="@_cmp" required />
                        <label>Business unit</label><input name="bu" value="@_bu" required />
                        <label>Receipt ref</label><input name="receiptRef" placeholder="GRN-…" required />
                        <label>Method</label>
                        <select name="method"><option value="value">value</option><option value="qty">qty</option><option value="weight">weight</option></select>
                        <label>Freight</label><input name="freight" type="number" step="0.01" min="0" value="0" />
                        <label>Duty</label><input name="duty" type="number" step="0.01" min="0" value="0" />
                        <label>Insurance</label><input name="insurance" type="number" step="0.01" min="0" value="0" />
                        <label>Other</label><input name="other" type="number" step="0.01" min="0" value="0" />
                        <label>Lines (JSON [{"itemCode","qty","weight","baseAmount"}])</label>
                        <textarea name="lines" rows="3" required>[{"itemCode":"ITEM-1","qty":1,"weight":0,"baseAmount":100}]</textarea>
                        <button type="submit">Allocate landed cost</button>
                    </form>
                </div>

                <div class="tg-card tg-form">
                    <h3>Eliminations (§10/§12)</h3>
                    <form method="post" action="@Post("/erp/sham/elim-run")">
                        @HiddenFields()
                        <label>Group parent entity</label><input name="entity" value="@_cmp" required />
                        <label>Period (YYYYMM)</label><input name="period" placeholder="@DateTime.UtcNow.ToString("yyyyMM")" required />
                        <button type="submit">Post elimination journal</button>
                    </form>
                    <p style="margin-top:8px">Scans IC postings across full-consolidation members of this entity's group and posts the reversing journal into the parent. Idempotent per period.</p>
                </div>

                <div class="tg-card tg-form">
                    <h3>E-invoicing (§11)</h3>
                    <form method="get" action="@Get("/erp/sham/einvoice")">
                        <label>Legal entity</label><input name="cmp" value="@_cmp" required />
                        <label>Invoice ref</label><input name="ref" placeholder="INV-…" required />
                        <button type="submit">Render UBL 2.1 XML</button>
                    </form>
                </div>

                <div class="tg-card tg-form">
                    <h3>Treasury (§13)</h3>
                    <form method="post" action="@Post("/erp/sham/treasury")">
                        @HiddenFields()
                        <label>Legal entity</label><input name="entity" value="@_cmp" required />
                        <label>Kind</label>
                        <select name="kind"><option value="lc">LC</option><option value="cad">CAD</option><option value="fx">FX</option></select>
                        <label>Reference</label><input name="ref" placeholder="LC-…" required />
                        <label>Counterparty</label><input name="counterparty" />
                        <label>Amount</label><input name="amount" type="number" step="0.01" min="0" value="0" />
                        <label>Currency</label><input name="currency" value="AED" />
                        <label>Expiry (unix seconds, optional)</label><input name="expiry" type="number" min="0" />
                        <button type="submit">Register instrument</button>
                    </form>
                    <form method="post" action="@Post("/erp/sham/treasury")" style="margin-top:12px">
                        @HiddenFields()
                        <label>Transition</label>
                        <select name="action"><option value="settle">settle</option><option value="expire">expire</option><option value="cancel">cancel</option></select>
                        <label>Reference</label><input name="ref" required />
                        <button type="submit">Apply transition</button>
                    </form>
                    <p style="margin-top:8px"><a href="@Get("/erp/sham/treasury-view")?cmp=@Uri.EscapeDataString(_cmp)">Open instruments + exposure</a></p>
                </div>

                <div class="tg-card">
                    <h3>Module data flows (§14)</h3>
                    @if (_flows != null)
                    {
                        <p>@_flows.Live of @_flows.Total modules live</p>
                        <table class="tg-table">
                            <thead><tr><th>Module</th><th>Rows</th><th>Feeds</th></tr></thead>
                            <tbody>
                            @foreach (var m in _flows.Modules)
                            {
                                <tr>
                                    <td>@m.Module</td>
                                    <td class="@(m.Rows > 0 ? "tg-live" : "tg-empty")">@m.Rows</td>
                                    <td>@m.Feeds</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>Module coverage requires the <code>vat-view</code> grant.</p>
                    }
                </div>
            </div>

            <h3 style="margin:18px 0 10px;color:#12324f">Core flows (phases 1–7)</h3>
            <div class="tg-grid">
                <div class="tg-card tg-form">
                    <h3>Stock reservation</h3>
                    <form method="post" action="@Post("/erp/sham/stock-reserve")">
                        @HiddenFields()
                        <label>Legal entity</label><input name="entity" value="@_cmp" required />
                        <label>Business unit</label><input name="bu" value="@_bu" required />
                        <label>Operation</label>
                        <select name="op"><option value="reserve">reserve</option><option value="release">release</option></select>
                        <label>SKU</label><input name="sku" required />
                        <label>Qty</label><input name="qty" type="number" step="0.001" min="0" value="1" />
                        <label>Source type</label>
                        <select name="sourceType"><option value="sales_order">sales_order</option><option value="quote">quote</option></select>
                        <label>Source id</label><input name="sourceId" type="number" min="0" value="0" />
                        <label>Reservation id (release)</label><input name="reservationId" type="number" min="0" value="0" />
                        <button type="submit">Reserve / release</button>
                    </form>
                </div>

                <div class="tg-card tg-form">
                    <h3>Issue sales invoice</h3>
                    <form method="post" action="@Post("/erp/sham/sales-invoice-issue")">
                        @HiddenFields()
                        <label>Legal entity</label><input name="entity" value="@_cmp" required />
                        <label>Business unit</label><input name="bu" value="@_bu" required />
                        <label>Invoice number</label><input name="number" placeholder="INV-…" required />
                        <label>Customer</label><input name="customer" required />
                        <label>Subtotal</label><input name="subtotal" type="number" step="0.01" min="0" value="0" />
                        <label>VAT</label><input name="vat" type="number" step="0.01" min="0" value="0" />
                        <label>Total</label><input name="total" type="number" step="0.01" min="0" value="0" />
                        <label>Order id (optional)</label><input name="orderId" type="number" min="0" value="0" />
                        <button type="submit">Issue document</button>
                    </form>
                </div>

                <div class="tg-card tg-form">
                    <h3>Post invoice to GL</h3>
                    <form method="post" action="@Post("/erp/sham/invoice-post")">
                        @HiddenFields()
                        <label>Legal entity</label><input name="entity" value="@_cmp" required />
                        <label>Business unit</label><input name="bu" value="@_bu" required />
                        <label>Invoice id</label><input name="invoiceId" type="number" min="0" value="0" />
                        <label>or invoice number</label><input name="number" placeholder="INV-…" />
                        <label>Consume holds of order id (optional)</label><input name="consumeSourceId" type="number" min="0" value="0" />
                        <button type="submit">Post to GL</button>
                    </form>
                </div>

                <div class="tg-card tg-form">
                    <h3>Purchase receipt</h3>
                    <form method="post" action="@Post("/erp/sham/po-receive")">
                        @HiddenFields()
                        <label>Legal entity</label><input name="entity" value="@_cmp" required />
                        <label>Business unit</label><input name="bu" value="@_bu" required />
                        <label>PO reference</label><input name="po" required />
                        <label>SKU</label><input name="sku" required />
                        <label>Qty</label><input name="qty" type="number" step="0.001" min="0" value="1" />
                        <label>Unit cost</label><input name="cost" type="number" step="0.01" min="0" value="0" />
                        <button type="submit">Receive into default WH</button>
                    </form>
                </div>

                <div class="tg-card tg-form">
                    <h3>Intercompany journal</h3>
                    <form method="post" action="@Post("/erp/sham/ic-post")">
                        @HiddenFields()
                        <label>Entity A</label><input name="entityA" value="@_cmp" required />
                        <label>BU A</label><input name="buA" value="@_bu" />
                        <label>Entity B</label><input name="entityB" required />
                        <label>BU B</label><input name="buB" />
                        <label>Reference</label><input name="reference" placeholder="IC-…" required />
                        <label>Description</label><input name="description" />
                        <label>Amount</label><input name="amount" type="number" step="0.01" min="0" value="0" />
                        <label>Currency</label><input name="currency" value="AED" />
                        <button type="submit">Post paired journal</button>
                    </form>
                </div>

                <div class="tg-card tg-form">
                    <h3>Period lock &amp; VAT</h3>
                    <form method="post" action="@Post("/erp/sham/period-lock")">
                        @HiddenFields()
                        <label>Legal entity</label><input name="entity" value="@_cmp" required />
                        <label>Period (YYYYMM)</label><input name="period" required />
                        <button type="submit">Lock period</button>
                    </form>
                    <p style="margin-top:8px"><a href="@Get("/erp/sham/vat-summary")?cmp=@Uri.EscapeDataString(_cmp)&amp;buc=@Uri.EscapeDataString(_bu)">VAT summary for this entity</a></p>
                </div>
            </div>
        }
    }
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private bool _loaded;
    private string _csrf = string.Empty;
    private string _cmp = string.Empty;
    private string _bu = string.Empty;
    private string _flashOk = string.Empty;
    private string _flashErr = string.Empty;
    private ErpShamModuleFlowsResult? _flows;
    private ErpTenantGuideModel _model = new();

    private const int EntityWidth = 200;
    private const int EntityGap = 30;
    private int SvgWidth => Math.Max(760, _model.Entities.Count * (EntityWidth + EntityGap) + 20);
    private int SvgHeight
    {
        get
        {
            var maxBus = _model.Entities.Count == 0 ? 0 : _model.Entities.Max(e => _model.BusinessUnits.Count(b => b.EntityId == e.Id));
            return 220 + maxBus * 56;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx != null)
        {
            var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted).ConfigureAwait(false);
            _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
            if (_isAdmin)
            {
                _csrf = await Csrf.KeyForAsync(ctx, session, ctx.RequestAborted).ConfigureAwait(false);
            }
            _cmp = ctx.Request.Query["cmp"].ToString().Trim();
            _bu = ErpHostContext.BuCodeFromQuery(ctx.Request);
            _flashOk = ctx.Request.Query["ok"].ToString();
            _flashErr = ctx.Request.Query["err"].ToString();
            if (_isAdmin && (session.Capabilities?.Contains("erp") ?? false))
            {
                try { _flows = await Flows.LoadAsync(session.Email ?? string.Empty, ctx.RequestAborted).ConfigureAwait(false); }
                catch { _flows = null; }
                if (_flows is { Ok: false }) _flows = null;
            }
        }
        try
        {
            _model = await Guide.ReadAsync(CancellationToken.None).ConfigureAwait(false);
        }
        catch
        {
            _model = new ErpTenantGuideModel();
        }
        _loaded = true;
    }

    private string Post(string path) => ClientErpPath.PrefixIfBound(Http.HttpContext!, path);
    private string Get(string path) => ClientErpPath.PrefixIfBound(Http.HttpContext!, path);

    private MarkupString HiddenFields()
    {
        var returnUrl = HttpUtility.HtmlAttributeEncode(
            (Http.HttpContext?.Request.Path.Value ?? "/erp/tenant-guide") + Http.HttpContext?.Request.QueryString.Value);
        return (MarkupString)(
            $"<input type=\"hidden\" name=\"confirmWrites\" value=\"true\" />"
            + $"<input type=\"hidden\" name=\"returnUrl\" value=\"{returnUrl}\" />"
            + $"<input type=\"hidden\" name=\"csrf_guard_key\" value=\"{HttpUtility.HtmlAttributeEncode(_csrf)}\" />");
    }

    private static string Shorten(string value) =>
        value.Length <= 22 ? value : value[..21] + "…";

    private static string Esc(string value) => HttpUtility.HtmlEncode(value);

    private string BuildSvg()
    {
        var w = SvgWidth;
        var h = SvgHeight;
        var sb = new StringBuilder();
        sb.Append($"<svg viewBox=\"0 0 {w} {h}\" width=\"{w}\" style=\"min-width:720px\" role=\"img\" aria-label=\"Organisation chart\">");
        sb.Append($"<rect x=\"{(w/2)-140}\" y=\"8\" width=\"280\" height=\"44\" rx=\"8\" fill=\"#12324f\"/>");
        sb.Append($"<text x=\"{w/2}\" y=\"26\" text-anchor=\"middle\" fill=\"#fff\" font-size=\"13\" font-weight=\"600\">Group · Consolidation</text>");
        sb.Append($"<text x=\"{w/2}\" y=\"42\" text-anchor=\"middle\" fill=\"#9fc3e8\" font-size=\"11\">{_model.Entities.Count(e => e.Consolidated)} of {_model.Entities.Count} entities in group statements</text>");
        for (var i = 0; i < _model.Entities.Count; i++)
        {
            var entity = _model.Entities[i];
            var x = 20 + i * (EntityWidth + EntityGap);
            var cx = x + EntityWidth / 2;
            sb.Append($"<line x1=\"{w/2}\" y1=\"52\" x2=\"{cx}\" y2=\"86\" stroke=\"#7fa6c9\" stroke-width=\"1.5\"/>");
            sb.Append($"<rect x=\"{x}\" y=\"86\" width=\"{EntityWidth}\" height=\"66\" rx=\"8\" fill=\"{(entity.Consolidated ? "#0f6b3f" : "#5b6570")}\" stroke=\"{(entity.Consolidated ? "#0a4a2b" : "#3f4750")}\"{(entity.Consolidated ? "" : " stroke-dasharray=\"5,4\"")}/>");
            sb.Append($"<text x=\"{cx}\" y=\"104\" text-anchor=\"middle\" fill=\"#fff\" font-size=\"12\" font-weight=\"700\">{Esc(entity.Code)}</text>");
            sb.Append($"<text x=\"{cx}\" y=\"120\" text-anchor=\"middle\" fill=\"#d9efe2\" font-size=\"10\">{Esc(Shorten(entity.Name))}</text>");
            sb.Append($"<text x=\"{cx}\" y=\"135\" text-anchor=\"middle\" fill=\"#bfe0cd\" font-size=\"9\">{Esc(entity.Country)} · {Esc(entity.Currency)}{(entity.Consolidated ? "" : " · not consolidated")}</text>");
            var bus = _model.BusinessUnits.Where(b => b.EntityId == entity.Id).ToList();
            var by = 168;
            foreach (var bu in bus)
            {
                sb.Append($"<line x1=\"{cx}\" y1=\"{by - 16}\" x2=\"{cx}\" y2=\"{by}\" stroke=\"#a7bccb\" stroke-width=\"1\"/>");
                sb.Append($"<rect x=\"{x + 8}\" y=\"{by}\" width=\"{EntityWidth - 16}\" height=\"46\" rx=\"6\" fill=\"#eef4f9\" stroke=\"#c3d3de\"/>");
                sb.Append($"<text x=\"{cx}\" y=\"{by + 15}\" text-anchor=\"middle\" fill=\"#12324f\" font-size=\"11\" font-weight=\"600\">{Esc(bu.Code)}</text>");
                sb.Append($"<text x=\"{cx}\" y=\"{by + 29}\" text-anchor=\"middle\" fill=\"#4a627a\" font-size=\"9\">{Esc(Shorten(bu.Name))}</text>");
                var dims = (bu.CostCentre != "" ? "CC " + bu.CostCentre : "") + (bu.Warehouse != "" ? " · WH " + bu.Warehouse : "");
                sb.Append($"<text x=\"{cx}\" y=\"{by + 41}\" text-anchor=\"middle\" fill=\"#6b8196\" font-size=\"8\">{Esc(dims)}</text>");
                by += 56;
            }
        }
        sb.Append($"<rect x=\"20\" y=\"{h - 24}\" width=\"14\" height=\"12\" rx=\"3\" fill=\"#0f6b3f\"/>");
        sb.Append($"<text x=\"40\" y=\"{h - 14}\" fill=\"#4a627a\" font-size=\"11\">Consolidated entity</text>");
        sb.Append($"<rect x=\"170\" y=\"{h - 24}\" width=\"14\" height=\"12\" rx=\"3\" fill=\"#5b6570\" stroke=\"#3f4750\" stroke-dasharray=\"5,4\"/>");
        sb.Append($"<text x=\"190\" y=\"{h - 14}\" fill=\"#4a627a\" font-size=\"11\">Held outside group statements</text>");
        sb.Append($"<rect x=\"400\" y=\"{h - 24}\" width=\"14\" height=\"12\" rx=\"3\" fill=\"#eef4f9\" stroke=\"#c3d3de\"/>");
        sb.Append($"<text x=\"420\" y=\"{h - 14}\" fill=\"#4a627a\" font-size=\"11\">Business unit (CC = cost centre, WH = default warehouse)</text>");
        sb.Append("</svg>");
        return sb.ToString();
    }
}
