@page "/lifeos/security-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.LifeOs.Part7
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ILifeOsSecurityGovernance Gov

<PageTitle>LifeOS™ · Part 7 Security & Governance</PageTitle>
<PhpSurfaceHead Surface="lifeos" />
<PhpChromeBodyClass Surface="lifeos" />

<HeadContent>
<link rel="stylesheet" href="@LegacyPhpFontAssets.LifeOsFonts" />
<style>
:root {
  --lo-ink:#0a1f1c; --lo-sea:#0f766e; --lo-sun:#f59e0b; --lo-paper:#f4faf8;
  --lo-display:"Instrument Serif", Georgia, serif; --lo-sans:"Manrope","Segoe UI",sans-serif;
}
body.lifeos-body { margin:0; background:var(--lo-paper); color:var(--lo-ink); font-family:var(--lo-sans); }
.lo-top {
  display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap;
  padding:1rem clamp(1rem,3vw,2rem);
  background:linear-gradient(90deg,#062a26,#0f766e 55%,#134e4a); color:#ecfdf5;
}
.lo-top .brand { font-family:var(--lo-display); font-size:1.55rem; }
.lo-top .brand em { font-style:italic; color:#99f6e4; }
.lo-top nav { display:flex; flex-wrap:wrap; gap:.75rem; font-size:.8rem; font-weight:700; }
.lo-top a { color:#ccfbf1; text-decoration:none; }
.lo-main { padding:1.35rem clamp(1rem,3vw,2.2rem) 2.5rem; max-width:80rem; margin:0 auto; }
.lo-main h1 { font-family:var(--lo-display); font-weight:400; font-size:clamp(1.65rem,3.5vw,2.3rem); margin:.1rem 0 .4rem; }
.lo-main > p { max-width:52rem; color:#334155; line-height:1.5; }
.lo-chips { display:flex; flex-wrap:wrap; gap:.4rem; margin:.5rem 0 1rem; }
.lo-chips span {
  font-size:.72rem; font-weight:700; padding:.3rem .55rem; border-radius:.28rem;
  background:#ecfdf5; color:var(--lo-sea); border:1px solid #a7f3d0;
}
.lo-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:.6rem; }
.lo-grid article { padding:.85rem; border:1px solid #cce5de; border-radius:.4rem; background:#fff; }
.lo-grid strong { display:block; margin-bottom:.2rem; font-size:.9rem; color:#062a26; }
.lo-grid span { font-size:.78rem; color:#475569; line-height:1.35; }
.lo-h2 { font-family:var(--lo-display); font-weight:400; font-size:1.4rem; margin:1.2rem 0 .4rem; }
.lo-table { width:100%; border-collapse:collapse; font-size:.8rem; margin:.4rem 0 1rem; }
.lo-table th, .lo-table td { text-align:left; padding:.4rem .35rem; border-bottom:1px solid #e2efe9; vertical-align:top; }
.lo-code {
  margin:.75rem 0; padding:.85rem 1rem; border-radius:.4rem; background:#062a26; color:#ccfbf1;
  font-family:"JetBrains Mono", ui-monospace, monospace; font-size:.78rem; overflow:auto; white-space:pre-wrap;
}
.lo-note { margin-top:1.3rem; padding:1rem; border-left:3px solid var(--lo-sun); background:#fffbeb; color:#78350f; font-size:.86rem; }
</style>
</HeadContent>

<div class="lifeos-ambient">
  <header class="lo-top">
    <div class="brand">Life<em>OS</em>™</div>
    <nav>
      <a href="@EcomAeRoutes.LifeOs">Home</a>
      <a href="@EcomAeRoutes.LifeOsInfraApp">Part 6</a>
      <a href="@EcomAeRoutes.LifeOsSecurityApp">Part 7</a>
      <a href="@EcomAeRoutes.LifeOsSpecApp">Spec</a>
      <a href="@EcomAeRoutes.LifeOsSecurityDigest">JSON</a>
    </nav>
  </header>
  <main class="lo-main">
    <h1>Part 7 — Security &amp; Governance</h1>
    <p>
      Zero Trust, IAM, RBAC/ABAC/PBAC, agent sandboxes, encryption, privacy-by-design, consent,
      AI governance &amp; safety, threat/SOC, enterprise admin, residency, and deployment models (Ch.82–101).
    </p>

    <div class="lo-chips">
      @foreach (var p in Gov.SecurityPrinciples)
      {
        <span>@p.Title</span>
      }
    </div>

    <h2 class="lo-h2">Zero Trust — never trust</h2>
    <div class="lo-chips">
      @foreach (var n in Gov.ZeroTrustNeverTrust)
      {
        <span>@n</span>
      }
    </div>

    <h2 class="lo-h2">Identity types</h2>
    <div class="lo-grid">
      @foreach (var id in Gov.IdentityTypes)
      {
        <article>
          <strong>@id.Title</strong>
          <span>key: @id.Key</span>
        </article>
      }
    </div>

    <h2 class="lo-h2">Data classification</h2>
    <table class="lo-table">
      <thead><tr><th>Level</th><th>Examples</th></tr></thead>
      <tbody>
      @foreach (var level in Gov.DataClassificationLevels)
      {
        <tr>
          <td><strong>@level.Title</strong></td>
          <td>@string.Join(", ", level.Examples)</td>
        </tr>
      }
      </tbody>
    </table>

    <h2 class="lo-h2">AI agent sandbox sample</h2>
    <div class="lo-code">@AgentJson</div>

    <h2 class="lo-h2">AI Safety decisions</h2>
    <div class="lo-chips">
      @foreach (var d in Gov.SafetyDecisions)
      {
        <span>@d.Title</span>
      }
    </div>

    <h2 class="lo-h2">Compliance frameworks</h2>
    <div class="lo-grid">
      @foreach (var f in Gov.ComplianceFrameworks)
      {
        <article>
          <strong>@f.Title</strong>
          <span>@f.Notes</span>
        </article>
      }
    </div>

    <h2 class="lo-h2">Deployment models</h2>
    <div class="lo-chips">
      @foreach (var m in Gov.DeploymentModels)
      {
        <span title="@m.Notes">@m.Title</span>
      }
    </div>

    <div class="lo-note">
      Digests: <code>/lifeos/security</code>, <code>/zero-trust</code>, <code>/iam</code>,
      <code>/authorization</code>, <code>/encryption</code>, <code>/privacy</code>,
      <code>/ai-governance</code>, <code>/threat-soc</code>, <code>/enterprise-deploy</code>.
      Full IdP / SOC / TEE not claimed — scaffold registry; Super-CP host gate + ethics confirmations are live.
    </div>
  </main>
</div>

@code {
    private string AgentJson =>
        System.Text.Json.JsonSerializer.Serialize(
            new { agent = Gov.SampleAgentPermissions.Agent, permissions = Gov.SampleAgentPermissions.Permissions },
            new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
}
