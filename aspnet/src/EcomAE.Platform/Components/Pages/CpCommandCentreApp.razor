@page "/cp/app"
@page "/cp"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Control Command Centre · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    @* PHP cp/content/control/epc_tenant_cp_dashboard.php — .cp-dash markup so command_dashboard.css applies *@
    <div class="col-lg-12 cp-dash" data-cp-dashboard="command">
        <div class="cp-dash-hero">
            <div class="cp-dash-hero-panel">
                <div class="epc-cp-dash-brand" style="margin:0 0 10px">
                    <PhpEpartsCartAnimatedLogo Variant="dash" />
                </div>
                <div class="cp-dash-kicker"><i class="fa fa-cogs"></i> Control Command Centre</div>
                <h2 class="cp-dash-title">eParts Cart</h2>
                <p class="cp-dash-sub">
                    Live commerce pulse — orders, catalogue, prices, warehouses, and finance in one red-black command view.
                </p>
                <div class="cp-dash-meta">
                    <span class="cp-dash-chip cp-dash-chip--dark"><i class="fa fa-industry"></i> Auto parts</span>
                    <span class="cp-dash-chip"><i class="fa fa-calendar"></i> @DateTime.UtcNow.ToString("yyyy-MM-dd")</span>
                    <span class="cp-dash-chip"><i class="fa fa-money"></i> AED</span>
                    <a class="cp-dash-chip" href="/erp"><i class="fa fa-university"></i> Open ERP</a>
                    <a class="cp-dash-chip" href="/"><i class="fa fa-external-link"></i> View site</a>
                </div>
            </div>
            <div class="cp-dash-metrics">
                <a class="cp-dash-metric" href="/cp/orders">
                    <div class="cp-dash-metric__label">Admin users</div>
                    <div class="cp-dash-metric__val">@_users</div>
                    <div class="cp-dash-metric__hint">@(_isAdmin ? "Live session digest" : "Sign in for live KPIs")</div>
                </a>
                <a class="cp-dash-metric" href="/cp/orders">
                    <div class="cp-dash-metric__label">Admin sessions</div>
                    <div class="cp-dash-metric__val cp-dash-metric__val--warn">@_sessions</div>
                    <div class="cp-dash-metric__hint">Active operator sessions</div>
                </a>
                <a class="cp-dash-metric cp-dash-metric--accent" href="/cp/product-catalogue-app">
                    <div class="cp-dash-metric__label">Portal tenants</div>
                    <div class="cp-dash-metric__val">@_tenants</div>
                    <div class="cp-dash-metric__hint">Registered tenants</div>
                </a>
                <a class="cp-dash-metric cp-dash-metric--accent" href="/cp/tenants-app">
                    <div class="cp-dash-metric__label">Active tenants</div>
                    <div class="cp-dash-metric__val">@_active</div>
                    <div class="cp-dash-metric__hint">Active portal tenants</div>
                </a>
                <a class="cp-dash-metric" href="/cp/storages-app">
                    <div class="cp-dash-metric__label">Warehouses</div>
                    <div class="cp-dash-metric__val">—</div>
                    <div class="cp-dash-metric__hint">Supplier warehouses</div>
                </a>
                <a class="cp-dash-metric" href="/cp/users-app">
                    <div class="cp-dash-metric__label">Clients</div>
                    <div class="cp-dash-metric__val">—</div>
                    <div class="cp-dash-metric__hint">Storefront customers</div>
                </a>
            </div>
        </div>

        <div class="cp-dash-port">
            <div class="bd" style="padding-top:14px">
                <h4 style="margin:0 0 12px;font-size:.95rem;"><i class="fa fa-th-large"></i> Quick actions</h4>
                <div class="cp-dash-tiles" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:.55rem;">
                    @foreach (var tile in _tiles)
                    {
                        <a class="cp-dash-tile cp-dash-tile--@tile.Tone" href="@tile.Href"
                           style="display:flex;flex-direction:column;gap:.35rem;padding:.85rem .75rem;border-radius:.55rem;text-decoration:none;min-height:88px;color:#fff;font-weight:700;background:@ToneColor(tile.Tone);">
                            <i class="fa @tile.Icon" aria-hidden="true"></i>
                            <span>@tile.Label</span>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="cp-dash-grid" style="display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:.85rem;margin-top:1rem;">
            <div class="cp-dash-col-left">
                <div class="cp-dash-port">
                    <h4><i class="fa fa-bell-o"></i> Reminders</h4>
                    <div class="bd">
                        <ul class="cp-dash-rem">
                            <li><span class="cnt">@_sessions</span> <a href="/cp/orders">Open operator sessions</a></li>
                            <li><span class="cnt">@_users</span> <a href="/cp/users-app">Admin users</a></li>
                            <li><span class="cnt zero">0</span> <a href="/cp/returns-rma-app">Open returns</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="cp-dash-col-mid">
                <div class="cp-dash-port">
                    <h4><i class="fa fa-tachometer"></i> Key performance indicators</h4>
                    <div class="bd" style="padding:0">
                        <table class="cp-dash-kpi-tbl">
                            <thead><tr><th>Indicator</th><th>Current</th><th>Previous</th><th>Change</th></tr></thead>
                            <tbody>
                                <tr><td>Admin users</td><td>@_users</td><td>—</td><td><span class="cp-dash-chg flat">—</span></td></tr>
                                <tr><td>Admin sessions</td><td>@_sessions</td><td>—</td><td><span class="cp-dash-chg flat">—</span></td></tr>
                                <tr><td>Portal tenants</td><td>@_tenants</td><td>—</td><td><span class="cp-dash-chg flat">—</span></td></tr>
                                <tr><td>Active tenants</td><td>@_active</td><td>—</td><td><span class="cp-dash-chg flat">—</span></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="cp-dash-col-right">
                <div class="cp-dash-port">
                    <h4><i class="fa fa-rocket"></i> Today’s focus</h4>
                    <div class="bd" style="font-size:13px;color:#475569;line-height:1.5">
                        @if (!_isAdmin)
                        {
                            <p style="margin:0 0 .6rem;">Guest preview of the PHP Command Centre layout.
                            <a href="/cp/login">Sign in</a> for live KPIs.</p>
                        }
                        else
                        {
                            <p style="margin:0 0 .6rem;">Signed in — open Orders OMS or ERP for today’s fulfilment work.</p>
                        }
                        <a href="/cp/orders" style="font-weight:700;color:#b91c1c;">Open Orders / OMS →</a>
                    </div>
                </div>
            </div>
        </div>

        <PhpHybridModuleDirectory
            Title="Complete Control Panel module directory"
            Subtitle="@($"All {PhpModuleCatalog.CpBrochureFeatureCount} control panel modules")"
            Links="@PhpModuleCatalog.CpBrochureFeatures"
            PhpWorkspaceBase="/cp/app" />
    </div>
</PhpCpDesktopChrome>

@code {
    private int _users;
    private int _sessions;
    private int _tenants;
    private int _active;
    private bool _isAdmin;

    private static readonly DashTile[] _tiles =
    [
        new("Orders (OMS)", "fa-shopping-cart", "/cp/orders", "red"),
        new("Catalogue", "fa-th-large", "/cp/product-catalogue-app", "black"),
        new("Prices", "fa-tags", "/cp/price-lists-app", "crimson"),
        new("Clients", "fa-address-book", "/cp/users-app", "stone"),
        new("Warehouses", "fa-building", "/cp/storages-app", "black"),
        new("ERP finance", "fa-university", "/erp", "red"),
        new("Documents", "fa-file-text-o", "/cp/document-control-app", "stone"),
        new("Settings", "fa-cog", "/cp/portal-settings-app", "crimson"),
    ];

    private sealed record DashTile(string Label, string Icon, string Href, string Tone);

    private static string ToneColor(string tone) => tone switch
    {
        "red" => "linear-gradient(135deg,#b91c1c,#dc2626)",
        "crimson" => "linear-gradient(135deg,#9f1239,#e11d48)",
        "black" => "linear-gradient(135deg,#0f172a,#334155)",
        _ => "linear-gradient(135deg,#57534e,#78716c)"
    };

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin;
        if (!_isAdmin)
        {
            return;
        }

        var summary = await Dashboards.BuildControlPanelAsync(ctx.RequestAborted);
        _users = summary.Users;
        _sessions = summary.AdminSessions;
        _tenants = summary.PortalTenants;
        _active = summary.ActivePortalTenants;
    }
}
