@page "/cp/app"
@page "/cp"
@page "/cp/control"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using System.Text.Json
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Cp
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ICpTenantDashboardService CpDashboard
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>@_pageTitle</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
@if (_isSuperHost)
{
    @* PHP: super-cp hosts render epc_super_cp_dashboard.php (BOC fleet console) —
       NEVER a tenant's shop dashboard. Tenant data stays on tenant hosts. *@
    <PhpSuperCpCommandCentre />
}
else
{
    @* PHP cp/content/control/epc_tenant_cp_dashboard.php — .cp-dash markup so command_dashboard.css applies *@
    <div class="col-lg-12 cp-dash" data-cp-dashboard="command">
        <div class="cp-dash-hero">
            <div class="cp-dash-hero-panel">
                <div class="epc-cp-dash-brand" style="margin:0 0 10px">
                    <PhpSurfaceHostLogo Surface="cp" Variant="dash" />
                </div>
                <div class="cp-dash-kicker"><i class="fa @_industryIcon"></i> Control Command Centre</div>
                <h2 class="cp-dash-title">@_brandLabel</h2>
                <p class="cp-dash-sub">
                    Live commerce pulse — orders, catalogue, prices, warehouses, and finance in one red-black command view.
                </p>
                <div class="cp-dash-meta">
                    <span class="cp-dash-chip cp-dash-chip--dark"><i class="fa fa-industry"></i> @_industryLabel</span>
                    <span class="cp-dash-chip"><i class="fa fa-calendar"></i> @DateTime.Now.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span>
                    <span class="cp-dash-chip"><i class="fa fa-money"></i> @_currency</span>
                    <a class="cp-dash-chip" href="/erp"><i class="fa fa-university"></i> Open ERP</a>
                    <a class="cp-dash-chip" href="/"><i class="fa fa-external-link"></i> View site</a>
                </div>
            </div>
            <div class="cp-dash-metrics">
                <a class="cp-dash-metric" href="/cp/orders">
                    <div class="cp-dash-metric__label">Orders today</div>
                    <div class="cp-dash-metric__val">@_ordersToday.ToString("N0")</div>
                    <div class="cp-dash-metric__hint">New successfully created orders</div>
                </a>
                <a class="cp-dash-metric" href="/cp/orders">
                    <div class="cp-dash-metric__label">Open orders</div>
                    <div class="cp-dash-metric__val cp-dash-metric__val--warn">@_openOrders.ToString("N0")</div>
                    <div class="cp-dash-metric__hint">Need fulfilment</div>
                </a>
                <a class="cp-dash-metric cp-dash-metric--accent" href="/cp/price-lists-app">
                    <div class="cp-dash-metric__label">Products</div>
                    <div class="cp-dash-metric__val">@_products.ToString("N0")</div>
                    <div class="cp-dash-metric__hint">All warehouse SKUs (S-UAE, R-UAE, …)</div>
                </a>
                <a class="cp-dash-metric cp-dash-metric--accent" href="/cp/price-lists-app">
                    <div class="cp-dash-metric__label">Warehouse qty</div>
                    <div class="cp-dash-metric__val">@_warehouseQty.ToString("N0")</div>
                    <div class="cp-dash-metric__hint">Supplier warehouse stock (all price lists)</div>
                </a>
                <a class="cp-dash-metric" href="/cp/storages-app">
                    <div class="cp-dash-metric__label">Vendors</div>
                    <div class="cp-dash-metric__val">@_vendors.ToString("N0")</div>
                    <div class="cp-dash-metric__hint">Supplier warehouses</div>
                </a>
                <a class="cp-dash-metric" href="/cp/users-app">
                    <div class="cp-dash-metric__label">Clients</div>
                    <div class="cp-dash-metric__val">@_clients.ToString("N0")</div>
                    <div class="cp-dash-metric__hint">Storefront customers</div>
                </a>
            </div>
        </div>

        <div class="cp-dash-port">
            <div class="bd" style="padding-top:14px">
                <h4 style="margin:0 0 12px;"><i class="fa fa-th-large"></i> Quick actions</h4>
                <div class="cp-dash-tiles" data-epc-shortcuts="cp">
                    @foreach (var tile in ShortcutTiles)
                    {
                        <a class="cp-dash-tile cp-dash-tile--@tile.Tone" href="@tile.Href" data-shortcut-key="@tile.Key">
                            <i class="fa @tile.Icon ic" aria-hidden="true"></i>
                            <span class="tl">@tile.Label</span>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="cp-dash-port cp-dash-port--insights">
            <div class="bd" style="padding:12px">
                <div class="epc-insights epc-insights--cp">
                    <div class="epc-insights__head">
                        <strong>Control insights</strong>
                        <span class="epc-insights__period">Last 7 days</span>
                    </div>
                    <div class="epc-insights__tiles">
                        <article class="epc-insights__tile">
                            <span class="epc-insights__label">Orders (7 days)</span>
                            <div class="epc-insights__value">@_ordersWeek.ToString("N0")</div>
                        </article>
                        <article class="epc-insights__tile">
                            <span class="epc-insights__label">VIN / parts requests</span>
                            <div class="epc-insights__value">@_vinOpen.ToString("N0")</div>
                        </article>
                        <article class="epc-insights__tile">
                            <span class="epc-insights__label">Open returns</span>
                            <div class="epc-insights__value">@_returnsOpen.ToString("N0")</div>
                        </article>
                        <article class="epc-insights__tile">
                            <span class="epc-insights__label">Published products</span>
                            <div class="epc-insights__value">@_products.ToString("N0")</div>
                        </article>
                    </div>
                </div>
            </div>
        </div>

        <div class="cp-dash-grid">
            <div class="cp-dash-col-left">
                <div class="cp-dash-port">
                    <h4><i class="fa fa-bell-o"></i> Reminders</h4>
                    <div class="bd">
                        <ul class="cp-dash-rem">
                            <li><span class="cnt@(_openOrders == 0 ? " zero" : "")">@_openOrders</span> <a href="/cp/orders">Open orders needing fulfilment</a></li>
                            <li><span class="cnt@(_ordersToday == 0 ? " zero" : "")">@_ordersToday</span> <a href="/cp/orders">Orders created today</a></li>
                            <li><span class="cnt@(_vinOpen == 0 ? " zero" : "")">@_vinOpen</span> <a href="/cp/quote-requests-app">Unread VIN / parts requests</a></li>
                            <li><span class="cnt@(_returnsOpen == 0 ? " zero" : "")">@_returnsOpen</span> <a href="/cp/returns-rma-app">Open returns</a></li>
                        </ul>
                    </div>
                </div>
                <div class="cp-dash-port">
                    <h4><i class="fa fa-pencil"></i> Customize shortcuts</h4>
                    <div class="bd" style="font-size:13px;color:#475569;line-height:1.5">
                        Use <strong>Edit shortcuts</strong> in Quick actions above — same graphical builder as ERP.
                        Toggle catalogue modules, add a custom URL, or reset to defaults. Changes save immediately.
                    </div>
                </div>
            </div>
            <div class="cp-dash-col-mid">
                <div class="cp-dash-port">
                    <h4><i class="fa fa-tachometer"></i> Key performance indicators</h4>
                    <div class="bd" style="padding:0">
                        <table class="cp-dash-kpi-tbl">
                            <thead><tr><th>Indicator</th><th>Current</th><th>Previous</th><th>Change</th></tr></thead>
                            <tbody>
                                <tr>
                                    <td>Orders (7 days)</td>
                                    <td>@_ordersWeek.ToString("N0")</td>
                                    <td>@(_ordersPrevWeek > 0 ? _ordersPrevWeek.ToString("N0") : "—")</td>
                                    <td>@((MarkupString)ChangeHtml(_ordersWeek, _ordersPrevWeek, true))</td>
                                </tr>
                                <tr><td>Orders today</td><td>@_ordersToday.ToString("N0")</td><td>—</td><td><span class="cp-dash-chg flat">—</span></td></tr>
                                <tr><td>Open orders</td><td>@_openOrders.ToString("N0")</td><td>—</td><td><span class="cp-dash-chg flat">—</span></td></tr>
                                <tr><td>Products (all warehouse SKUs)</td><td>@_products.ToString("N0")</td><td>—</td><td><span class="cp-dash-chg flat">—</span></td></tr>
                                <tr><td>Warehouse qty (suppliers)</td><td>@_warehouseQty.ToString("N0")</td><td>—</td><td><span class="cp-dash-chg flat">—</span></td></tr>
                                <tr><td>Vendors</td><td>@_vendors.ToString("N0")</td><td>—</td><td><span class="cp-dash-chg flat">—</span></td></tr>
                                <tr><td>Clients</td><td>@_clients.ToString("N0")</td><td>—</td><td><span class="cp-dash-chg flat">—</span></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                @if (_hasFinance)
                {
                    <div class="cp-dash-port">
                        <h4><i class="fa fa-money"></i> Finance pulse (MTD)</h4>
                        <div class="bd">
                            <div class="cp-dash-fin">
                                <div class="cell"><div class="l">Sales ex VAT</div><div class="v">@_salesExVat.ToString("N2", CultureInfo.InvariantCulture) @_currency</div></div>
                                <div class="cell"><div class="l">Cash &amp; bank</div><div class="v">@_cashBank.ToString("N2", CultureInfo.InvariantCulture) @_currency</div></div>
                                <div class="cell"><div class="l">Receivables</div><div class="v">@_receivables.ToString("N2", CultureInfo.InvariantCulture) @_currency</div></div>
                                <div class="cell"><div class="l">Payables</div><div class="v">@_payables.ToString("N2", CultureInfo.InvariantCulture) @_currency</div></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="cp-dash-col-right">
                <div class="cp-dash-port">
                    <h4><i class="fa fa-area-chart"></i> Orders — last 7 days</h4>
                    <div class="bd">
                        <div class="cp-dash-chart-wrap">
                            <canvas id="cpDashOrdersChart" aria-label="Orders last 7 days"></canvas>
                        </div>
                    </div>
                </div>
                <div class="cp-dash-port">
                    <h4><i class="fa fa-rocket"></i> Today’s focus</h4>
                    <div class="bd">
                        <div class="cp-dash-fin">
                            <div class="cell"><div class="l">Week orders</div><div class="v">@_ordersWeek</div></div>
                            <div class="cell"><div class="l">Open work</div><div class="v" style="color:#dc2626">@_openOrders</div></div>
                            <div class="cell"><div class="l">VIN / requests</div><div class="v">@_vinOpen</div></div>
                            <div class="cell"><div class="l">Returns</div><div class="v">@_returnsOpen</div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <details class="cp-dash-more">
            <summary>
                <span><i class="fa fa-ellipsis-h"></i> More tools</span>
                <span class="hint">POS, documents, pricing AI, accessories…</span>
            </summary>
            <div class="bd">
                <div class="cp-dash-qa-grid">
                    @foreach (var link in MoreTools)
                    {
                        <a class="cp-dash-qa" href="@link.Href">
                            <span class="qa-ic qa-ic--@link.Tone"><i class="fa @link.Icon"></i></span>
                            <span class="qa-lb">@link.Label</span>
                        </a>
                    }
                </div>
            </div>
        </details>

        <p class="cp-dash-help">
            Tip: use the top menu to jump across modules. Open the full
            <a href="/erp">ERP Command Centre</a>
            for finance depth, or share the
            <a href="/brochure/cp" target="_blank" rel="noopener">CP brochure</a>.
        </p>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" defer></script>
    <script>
    (function () {
        function boot() {
            var canvas = document.getElementById('cpDashOrdersChart');
            if (!canvas || typeof Chart === 'undefined') { return; }
            var labels = @((MarkupString)_chartLabelsJson);
            var data = @((MarkupString)_chartDataJson);
            new Chart(canvas, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Orders',
                        data: data,
                        backgroundColor: 'rgba(220, 38, 38, 0.75)',
                        borderColor: '#0a0a0a',
                        borderWidth: 1,
                        borderRadius: 4,
                        maxBarThickness: 28
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () { setTimeout(boot, 60); });
        } else {
            setTimeout(boot, 60);
        }
        window.addEventListener('load', boot);
    })();
    </script>
}
</PhpCpDesktopChrome>

@code {
    private int _ordersToday;
    private int _openOrders;
    private int _ordersWeek;
    private int _ordersPrevWeek;
    private int _products;
    private int _warehouseQty;
    private int _vendors;
    private int _clients;
    private int _vinOpen;
    private int _returnsOpen;
    private decimal _salesExVat;
    private decimal _cashBank;
    private decimal _receivables;
    private decimal _payables;
    private int[] _chartDays = new int[7];
    private string[] _chartLabels = [];
    private string _currency = "AED";
    private bool _hasFinance;

    private string _chartLabelsJson => JsonSerializer.Serialize(_chartLabels);

    private string _chartDataJson => JsonSerializer.Serialize(_chartDays);
    private bool _isAdmin;
    private bool _isSuperHost;
    private string _pageTitle = "Control Command Centre";
    private string _brandLabel = "Control Panel";
    private string _industryLabel = "Auto parts";
    private string _industryCode = "auto_parts";
    private string _industryIcon = "fa-car";

    // PHP epc_tenant_cp_dashboard.php auto_parts shortcut defaults.
    private static readonly DashTile[] AutoPartsShortcuts =
    [
        new("orders", "Orders (OMS)", "fa-shopping-cart", "/cp/orders", "red"),
        new("prices", "Prices", "fa-tags", "/cp/price-lists-app", "crimson"),
        new("multivendor", "Multivendor", "fa-handshake-o", "/cp/prices-upload-app", "black"),
        new("crosses", "Crosses", "fa-exchange", "/cp/crosses-app", "stone"),
        new("procurement", "Procurement", "fa-shopping-basket", "/cp/procurement-app", "black"),
        new("pos", "POS", "fa-desktop", "/cp/pos-overview-app", "crimson"),
        new("erp", "ERP finance", "fa-university", "/erp", "red"),
        new("stock", "Stock", "fa-cubes", "/cp/storages-app", "black"),
    ];

    private static readonly DashTile[] DefaultShortcuts =
    [
        new("orders", "Orders (OMS)", "fa-shopping-cart", "/cp/orders", "red"),
        new("catalogue", "Catalogue", "fa-th-large", "/cp/product-catalogue-app", "black"),
        new("sku_media", "SKU photos & specs", "fa-picture-o", "/cp/product-catalogue-app", "stone"),
        new("prices", "Prices", "fa-tags", "/cp/price-lists-app", "crimson"),
        new("clients", "Clients", "fa-address-book", "/cp/users-app", "stone"),
        new("warehouses", "Warehouses", "fa-building", "/cp/storages-app", "black"),
        new("erp", "ERP finance", "fa-university", "/erp", "red"),
        new("documents", "Documents", "fa-file-text-o", "/cp/document-control-app", "stone"),
        // Tenant Command Centre must not deep-link Super CP portal fleet inventory.
        new("settings", "Settings", "fa-cog", "/cp/config-items-app", "crimson"),
    ];

    private static readonly DashTile[] MoreTools =
    [
        new("brochure", "CP brochure", "fa-book", "/brochure/cp", "black"),
        new("auto_price", "Auto Price AI", "fa-line-chart", "/cp/auto-price-app", "red"),
        new("accessories", "Accessories", "fa-puzzle-piece", "/cp/accessories-app", "stone"),
        new("visual", "Visual editor", "fa-magic", "/cp/page-builder-app", "black"),
        new("tax", "Tax Toolkit", "fa-balance-scale", "/cp/uae-tax-compliance-app", "red"),
        new("social", "Social media", "fa-share-alt", "/cp/social-hub-app", "stone"),
        new("sku_media", "SKU photos & specs", "fa-picture-o", "/cp/product-catalogue-app", "stone"),
        new("settings", "Settings", "fa-cog", "/cp/config-items-app", "crimson"),
    ];

    private IReadOnlyList<DashTile> ShortcutTiles =>
        string.Equals(_industryCode, "auto_parts", StringComparison.OrdinalIgnoreCase)
            ? AutoPartsShortcuts
            : DefaultShortcuts;

    private sealed record DashTile(string Key, string Label, string Icon, string Href, string Tone);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        // Same split as PHP cp/content/control/control.php: super-cp hosts get the
        // BOC fleet console; tenant hosts get THEIR OWN tenant Command Centre.
        var host = ctx.Request.Host.Host;
        _isSuperHost = Services.PlatformHostPolicy.IsSuperCpHost(host);
        if (_isSuperHost)
        {
            _pageTitle = "Platform Super CP · ECOM AE";
        }
        else
        {
            var erpHost = ErpHostContext.Resolve(host);
            _brandLabel = erpHost.BrandLabel;
            _industryLabel = erpHost.IndustryLabel;
            _industryCode = string.IsNullOrWhiteSpace(erpHost.IndustryCode) ? "auto_parts" : erpHost.IndustryCode;
            _industryIcon = string.Equals(_industryCode, "auto_parts", StringComparison.OrdinalIgnoreCase)
                ? "fa-car"
                : "fa-cogs";
            _pageTitle = $"Control Command Centre · {_brandLabel}";
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin;
        if (_isAdmin && _isSuperHost)
        {
            return; // Super CP KPIs come from PhpSuperCpCommandCentre (platform fleet).
        }

        if (!_isAdmin)
        {
            return;
        }

        // PHP epc_tcp_dash_stats(): tenant-scoped SQL, guarded per KPI, zero-safe under containment.
        var stats = await CpDashboard.LoadStatsAsync(ctx.RequestAborted);
        _ordersToday = stats.OrdersToday;
        _ordersWeek = stats.OrdersWeek;
        _ordersPrevWeek = stats.OrdersPrevWeek;
        _openOrders = stats.PendingTasks;
        _products = stats.Products;
        _warehouseQty = stats.WarehouseQty;
        _vendors = stats.Vendors;
        _clients = stats.Clients;
        _vinOpen = stats.VinOpen;
        _returnsOpen = stats.ReturnsOpen;
        _chartLabels = [.. stats.DayLabels];
        _chartDays = [.. stats.DayCounts];

        var company = await CpDashboard.LoadCompanyAsync(ctx.RequestAborted);
        _currency = company.Currency;
        if (!string.IsNullOrWhiteSpace(company.CompanyName))
        {
            _brandLabel = company.CompanyName;
            _pageTitle = $"Control Command Centre · {_brandLabel}";
        }

        // PHP finance pulse: epc_erp_dashboard() MTD, rendered only when finance data exists.
        try
        {
            var home = await Dashboards.BuildErpWorkspaceHomeAsync(ctx.RequestAborted);
            _salesExVat = home.Current.RevenueExVat;
            _cashBank = home.Current.CashPosition;
            _receivables = home.Current.Receivables != 0 ? home.Current.Receivables : home.Current.ArBalance;
            _payables = home.Current.Payables != 0 ? home.Current.Payables : home.Current.ApBalance;
            _hasFinance = true;
        }
        catch
        {
            // Dashboard chrome still renders with zeros — same as PHP first-visit.
        }
    }

    /// <summary>PHP <c>epc_tcp_dash_change()</c> — flat below 0.005, one decimal, arrow glyph.</summary>
    private static string ChangeHtml(double current, double previous, bool goodWhenUp)
    {
        if (Math.Abs(previous) < 0.005)
        {
            return "<span class=\"cp-dash-chg flat\">—</span>";
        }

        var pct = ((current - previous) / Math.Abs(previous)) * 100.0;
        var up = pct >= 0;
        var css = up == goodWhenUp ? "up" : "down";
        var arrow = up ? "&#9650;" : "&#9660;";
        return $"<span class=\"cp-dash-chg {css}\">{arrow} {Math.Abs(pct).ToString("N1", CultureInfo.InvariantCulture)}%</span>";
    }
}
