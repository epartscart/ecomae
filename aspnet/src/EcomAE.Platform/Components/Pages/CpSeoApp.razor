@page "/cp/seo-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>SEO · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                SEO
                <a class="btn btn-xs btn-default pull-right" href="/sitemap.xml" target="_blank" rel="noopener">Sitemap.xml</a>
                <a class="btn btn-xs btn-default pull-right" href="/cp/sitemap-app" style="margin-right:.4rem">Sitemap app</a>
                <a class="btn btn-xs btn-default pull-right" href="/en/parts/JS%20ASAKASHI/C110J" target="_blank" rel="noopener" style="margin-right:.4rem">Probe CHPU SEO</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" style="margin-right:.4rem">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>
                    ASP.NET-primary storefront SEO mirrors PHP <code>epc_seo_indexing</code>:
                    CHPU part pages emit Part-number titles, regional descriptions, Product JSON-LD, and stock-aware robots.
                    Content KPIs below come from the shop <code>content</code> table (same source as CP Content editor).
                </p>
                <p>Live ASP.NET SEO status: home uses body-stream canonical/OG/hreflang/JSON-LD; CHPU uses PHP-parity <em>Part number</em> title + description; no product <code>.php</code> URLs in canonicals. Source: <code>@_source</code>@if (!string.IsNullOrWhiteSpace(_message)) { <text> — @_message</text> }</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/seo-app" IsAdmin="_isAdmin" />

    <p class="help-block">@_urlCount.ToString(CultureInfo.InvariantCulture) Frontend URLs · @_indexedReady.ToString(CultureInfo.InvariantCulture) Published · @_pingJobs.ToString(CultureInfo.InvariantCulture) Ping jobs · @_warmJobs.ToString(CultureInfo.InvariantCulture) Warm jobs.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">SEO rows</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Key</th>
                    <th>Value</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="3">Nothing to show yet — log in as CP admin or check shop DB bind.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@(!string.IsNullOrWhiteSpace(row.Key) ? row.Key : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Value) ? row.Value : "—")</td>
                            <td>
                                @if (string.Equals(row.Key, "sitemap_xml", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a href="/sitemap.xml" target="_blank" rel="noopener">Open</a>
                                }
                                else if (string.Equals(row.Key, "sitemap_pages", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a href="/cp/sitemap-app">Open</a>
                                }
                                else if (string.Equals(row.Key, "aspnet_chpu_seo", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a href="/en/parts/JS%20ASAKASHI/C110J" target="_blank" rel="noopener">Probe</a>
                                }
                                else if (string.Equals(row.Key, "aspnet_home_seo", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a href="/" target="_blank" rel="noopener">Probe</a>
                                }
                                else
                                {
                                    <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">PHP ops</a>
                                }
                            </td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
                <p class="help-block">
                    Edit per-page <code>title_tag</code> / <code>description_tag</code> / <code>robots_tag</code> in CP Content. CMS writes stay on the Classic twin.
                    Warehouse CHPU SEO is generated from stock + article data (same rules as <code>epc_seo_indexing.php</code>).
                    Sitemap warm/ping stay on Classic cron until workers leave dry-run.
                </p>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/marketing/seo";
    private bool _isAdmin;
    private int _urlCount = 0;
    private int _indexedReady = 0;
    private int _pingJobs = 0;
    private int _warmJobs = 0;
    private IReadOnlyList<CpSeoRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpSeoDigestAsync(200, ctx.RequestAborted);
        _urlCount = result.Summary.UrlCount;
        _indexedReady = result.Summary.IndexedReady;
        _pingJobs = result.Summary.PingJobs;
        _warmJobs = result.Summary.WarmJobs;
        _rows = result.Rows;
        _source = result.Source;
        _message = result.Message;
    }
}
