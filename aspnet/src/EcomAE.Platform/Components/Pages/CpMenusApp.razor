@page "/cp/menus-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@inject ICpMenuEditorService Menus
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Menus · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<style>
    .epc-menu-actions .panel_a { display:inline-block; text-align:center; text-decoration:none; color:#333; margin-right:14px; vertical-align:top; cursor:pointer; }
    .epc-menu-actions .panel_a_img { width:48px; height:48px; margin:0 auto 4px; border-radius:8px; background:#f1f3f6; display:flex; align-items:center; justify-content:center; font-size:22px; color:#3498db; }
    .epc-menu-actions .panel_a_caption { font-size:12px; }
    .epc-menu-actions .panel_a.epc-mode-on .panel_a_img { background:#dbeeff; }
    #container_A { height:420px; overflow:auto; border:1px solid #e4e5e7; background:#fff; }
    #container_A ul { list-style:none; margin:0; padding-left:18px; }
    #container_A > ul { padding-left:4px; }
    #container_A li > .epc-menu-row { display:flex; align-items:center; gap:6px; padding:3px 6px; cursor:pointer; border-radius:3px; }
    #container_A li > .epc-menu-row:hover { background:#f5f7fa; }
    #container_A li.epc-sel > .epc-menu-row { background:#dbeeff; }
    #container_A .epc-menu-tog { width:14px; color:#888; font-size:11px; text-align:center; }
    #container_A li.epc-closed > ul { display:none; }
    #container_A .epc-menu-val { flex:1; }
    #container_A .epc-menu-val input { width:100%; border:1px solid #3498db; padding:1px 4px; font:inherit; }
    #container_A .epc-menu-mv { color:#999; font-size:11px; visibility:hidden; }
    #container_A li.epc-sel > .epc-menu-row .epc-menu-mv { visibility:visible; }
    #item_info_div .form-group { margin-bottom:8px; }
</style>

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    @if (!_isAdmin)
    {
        <div class="col-lg-12"><div class="hpanel"><div class="panel-body">
            <div class="alert alert-warning" role="status">Sign in to the Control Panel to manage menus. <a href="/cp/login?returnUrl=/cp/menus-app">Login</a></div>
        </div></div></div>
    }
    else if (_editor is null)
    {
        @* ---- menu_manager.php twin ---- *@
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Menus
                    <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
                </div>
                <div class="panel-body epc-menu-actions">
                    <a class="panel_a" href="@EditorHref(0)"><div class="panel_a_img"><i class="fa fa-plus"></i></div><div class="panel_a_caption">Create menu</div></a>
                    <a class="panel_a" href="javascript:void(0);" onclick="delete_menus();"><div class="panel_a_img"><i class="fa fa-trash-o"></i></div><div class="panel_a_caption">Delete selected</div></a>
                    <a class="panel_a @(_isFrontend ? "" : "epc-mode-on")" href="@ModeHref(false)"><div class="panel_a_img"><i class="fa fa-cogs"></i></div><div class="panel_a_caption">Control Panel menus</div></a>
                    <a class="panel_a @(_isFrontend ? "epc-mode-on" : "")" href="@ModeHref(true)"><div class="panel_a_img"><i class="fa fa-globe"></i></div><div class="panel_a_caption">Site menus</div></a>
                    <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div> }
        @if (_notFound) { <div class="col-lg-12"><div class="alert alert-danger" role="status">Menu #@_selectedId.ToString(CultureInfo.InvariantCulture) was not found.</div></div> }

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">@(_isFrontend ? "Site menus" : "Control Panel menus") (@_list.Total.ToString(CultureInfo.InvariantCulture))</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover table-epc">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" id="check_uncheck_all" name="check_uncheck_all" onchange="on_check_uncheck_all();" /></th>
                                    <th>ID</th>
                                    <th>Caption</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_list.Rows.Count == 0)
                                {
                                    <tr><td colspan="3">No menus yet.</td></tr>
                                }
                                @foreach (var m in _list.Rows)
                                {
                                    var id = m.Id.ToString(CultureInfo.InvariantCulture);
                                    <tr id="erp-row-@id" class="@ErpRecordOpen.RowClass(m.Id, _selectedId)">
                                        <td><input type="checkbox" class="epc-menu-check" onchange="on_one_check_changed();" id="checked_@id" name="checked_@id" value="@id" /></td>
                                        <td>@id</td>
                                        <td><a href="@ErpRecordOpen.Href(_listHref, "menu_id", m.Id)">@(string.IsNullOrWhiteSpace(m.Caption) ? "—" : m.Caption)</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_list.PageCount > 1)
                    {
                        <div class="row"><div class="col-lg-12 text-center"><div class="dataTables_paginate paging_simple_numbers"><ul class="pagination">
                            @for (var i = 1; i <= _list.PageCount; i++)
                            {
                                <li class="paginate_button @(i == _list.Page ? "active" : "")">
                                    @if (i == _list.Page) { <a href="javascript:void(0);">@i.ToString(CultureInfo.InvariantCulture)</a> }
                                    else { <a href="@PageHref(i)">@i.ToString(CultureInfo.InvariantCulture)</a> }
                                </li>
                            }
                        </ul></div></div></div>
                    }
                </div>
            </div>
        </div>

        <form name="delete_menu_form" id="delete_menu_form" method="post" action="/cp/menus/write" style="display:none">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_listHref" />
            <input type="hidden" name="menu_action" value="delete" />
            <input type="hidden" name="menu_list" id="menu_list" value="" />
            <input type="hidden" name="is_frontend" value="@(_isFrontend ? "1" : "0")" />
        </form>
        <script>
            function on_check_uncheck_all() {
                var state = document.getElementById('check_uncheck_all').checked;
                document.querySelectorAll('.epc-menu-check').forEach(function (c) { c.checked = state; });
            }
            function on_one_check_changed() {
                var all = true;
                document.querySelectorAll('.epc-menu-check').forEach(function (c) { if (!c.checked) all = false; });
                document.getElementById('check_uncheck_all').checked = all;
            }
            function delete_menus() {
                var ids = [];
                document.querySelectorAll('.epc-menu-check:checked').forEach(function (c) { ids.push(parseInt(c.value, 10)); });
                if (ids.length === 0) { alert('Select at least one menu to delete.'); return; }
                if (!confirm('Delete the selected menus?')) return;
                document.getElementById('menu_list').value = JSON.stringify(ids);
                document.getElementById('delete_menu_form').submit();
            }
        </script>
    }
    else
    {
        @* ---- menu_edit.php twin ---- *@
        var e = _editor;
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(e.Id > 0 ? "Menu editor — #" + e.Id.ToString(CultureInfo.InvariantCulture) : "New menu")
                    <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(e.Id > 0 ? "/CP/menu/menu_edit?menu_id=" + e.Id.ToString(CultureInfo.InvariantCulture) : "/CP/menu/menu_edit")">Classic twin</a>
                </div>
                <div class="panel-body epc-menu-actions">
                    <a class="panel_a" onclick="add_new_item();" href="javascript:void(0);"><div class="panel_a_img"><i class="fa fa-plus"></i></div><div class="panel_a_caption">Add item</div></a>
                    <a class="panel_a" onclick="delete_selected_item();" href="javascript:void(0);"><div class="panel_a_img"><i class="fa fa-trash-o"></i></div><div class="panel_a_caption">Delete item</div></a>
                    <a class="panel_a" onclick="unselect_tree();" href="javascript:void(0);"><div class="panel_a_img"><i class="fa fa-square-o"></i></div><div class="panel_a_caption">Unselect</div></a>
                    <a class="panel_a" onclick="save_tree();" href="javascript:void(0);"><div class="panel_a_img"><i class="fa fa-save"></i></div><div class="panel_a_caption">Save</div></a>
                    <a class="panel_a" href="@ModeHref(_isFrontend)"><div class="panel_a_img"><i class="fa fa-list"></i></div><div class="panel_a_caption">Menus</div></a>
                    <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div> }

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Menu parameters</div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-2"><label class="control-label" for="menu_caption_input">Menu caption</label></div>
                        <div class="col-lg-2"><input type="text" id="menu_caption_input" value="@e.Caption" class="form-control" /></div>
                        <div class="col-lg-2"><label class="control-label" for="menu_ul_class_input">UL class attribute</label></div>
                        <div class="col-lg-2"><input type="text" id="menu_ul_class_input" value="@e.MenuUlClass" class="form-control" /></div>
                        <div class="col-lg-2"><label class="control-label" for="menu_ul_id_input">UL id attribute</label></div>
                        <div class="col-lg-2"><input type="text" id="menu_ul_id_input" value="@e.MenuUlId" class="form-control" /></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Menu items</div>
                <div class="panel-body">
                    <div id="container_A"></div>
                    <p class="text-muted small" style="margin:6px 0 0">Select an item and use the toolbar; a new item is added inside the selected one. Double-click to rename; arrows change order.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-6" id="item_info_div_col">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Item parameters</div>
                <div class="panel-body form-horizontal" id="item_info_div">
                    <p class="text-muted">Select a menu item to edit its parameters.</p>
                </div>
            </div>
        </div>

        <form method="post" name="save_menu" id="save_menu" action="/cp/menus/write" style="display:none">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(e.Id > 0 ? EditorHref(e.Id) : ModeHref(_isFrontend))" />
            <input type="hidden" name="lang_code" value="en" />
            @if (e.Id > 0)
            {
                <input type="hidden" name="save_action" value="update" />
                <input type="hidden" name="menu_id" value="@e.Id.ToString(CultureInfo.InvariantCulture)" />
            }
            else
            {
                <input type="hidden" name="save_action" value="create" />
            }
            <input type="hidden" name="menu_tree" id="menu_tree" value="" />
            <input type="hidden" name="menu_caption" id="menu_caption" value="" />
            <input type="hidden" name="menu_caption_lang_str_id" id="menu_caption_lang_str_id" value="@e.CaptionLangStrId" />
            <input type="hidden" name="menu_ul_class" id="menu_ul_class" value="" />
            <input type="hidden" name="menu_ul_id" id="menu_ul_id" value="" />
            <input type="hidden" name="is_frontend" value="@(e.IsFrontend ? "1" : "0")" />
        </form>

        <script>
            var saved_menu = @((MarkupString)e.TreeJson);
            var content_options = @((MarkupString)ContentOptionsJson(e));
            var next_id = 1;
            var epcSel = null;
            var NODE_FIELDS = ['value_lang_str_id', 'class_li', 'class_ul', 'class_a', 'id_li', 'id_ul', 'id_a', 'a_innerhtml_mode', 'a_innerhtml', 'a_innerhtml_lang_str_id', 'link_mode', 'content_id', 'href', 'target', 'onclick', 'img_src'];
            var NODE_DEFAULTS = { value_lang_str_id: '0', class_li: '', class_ul: '', class_a: '', id_li: '', id_ul: '', id_a: '', a_innerhtml_mode: 'auto', a_innerhtml: '', a_innerhtml_lang_str_id: '0', link_mode: 'content', content_id: 0, href: '', target: '', onclick: '', img_src: '' };

            function epcNode(item) {
                var li = document.createElement('li');
                var id = parseInt(item.id, 10);
                if (isNaN(id) || id <= 0) { id = next_id; }
                if (id >= next_id) next_id = id + 1;
                li.setAttribute('data-id', id);
                var node = {};
                NODE_FIELDS.forEach(function (f) { node[f] = item[f] !== undefined && item[f] !== null ? item[f] : NODE_DEFAULTS[f]; });
                li.epcData = node;
                var row = document.createElement('div');
                row.className = 'epc-menu-row';
                row.innerHTML = '<span class="epc-menu-tog"></span><span class="epc-menu-val"></span>' +
                    '<span class="epc-menu-mv" onclick="move_selected(-1);event.stopPropagation();" title="Up">&#9650;</span>' +
                    '<span class="epc-menu-mv" onclick="move_selected(1);event.stopPropagation();" title="Down">&#9660;</span>';
                row.querySelector('.epc-menu-val').textContent = item.value || '';
                row.onclick = function () { epcSelect(li); };
                row.ondblclick = function (ev) { ev.stopPropagation(); epcEdit(li); };
                row.querySelector('.epc-menu-tog').onclick = function (ev) { ev.stopPropagation(); li.classList.toggle('epc-closed'); epcRefreshToggle(li); };
                li.appendChild(row);
                var ul = document.createElement('ul');
                (item.data || []).forEach(function (c) { ul.appendChild(epcNode(c)); });
                li.appendChild(ul);
                epcRefreshToggle(li);
                return li;
            }
            function epcRefreshToggle(li) {
                var has = li.querySelector(':scope > ul > li') !== null;
                li.querySelector(':scope > .epc-menu-row > .epc-menu-tog').textContent = has ? (li.classList.contains('epc-closed') ? '+' : '\u2212') : '';
            }
            function epcValue(li) { return li.querySelector(':scope > .epc-menu-row > .epc-menu-val').textContent; }
            function epcSelect(li) {
                if (epcSel) epcSel.classList.remove('epc-sel');
                epcSel = li;
                if (li) li.classList.add('epc-sel');
                onSelected();
            }
            function epcEdit(li) {
                var val = li.querySelector(':scope > .epc-menu-row > .epc-menu-val');
                if (val.querySelector('input')) return;
                var old = val.textContent;
                var inp = document.createElement('input');
                inp.type = 'text'; inp.value = old;
                function stop(commit) {
                    val.textContent = commit && inp.value.trim() !== '' ? inp.value.trim() : old;
                    if (commit && li.epcData.a_innerhtml_mode === 'auto') { li.epcData.a_innerhtml = val.textContent; }
                    onSelected();
                }
                inp.onblur = function () { stop(true); };
                inp.onkeydown = function (ev) { if (ev.key === 'Enter') { ev.preventDefault(); inp.blur(); } if (ev.key === 'Escape') { stop(false); } };
                val.textContent = ''; val.appendChild(inp); inp.focus(); inp.select();
            }
            function add_new_item() {
                var ul = epcSel ? epcSel.querySelector(':scope > ul') : document.querySelector('#container_A > ul');
                var li = epcNode({ id: next_id, value: 'New item', a_innerhtml: 'New item', link_mode: 'content', content_id: 0, data: [] });
                ul.appendChild(li);
                if (epcSel) { epcSel.classList.remove('epc-closed'); epcRefreshToggle(epcSel); }
                epcSelect(li);
                epcEdit(li);
            }
            function delete_selected_item() {
                if (!epcSel) return;
                var parent = epcSel.parentNode.closest('li');
                epcSel.parentNode.removeChild(epcSel);
                epcSel = null;
                if (parent) epcRefreshToggle(parent);
                onSelected();
            }
            function move_selected(dir) {
                if (!epcSel) return;
                var sib = dir < 0 ? epcSel.previousElementSibling : epcSel.nextElementSibling;
                if (!sib) return;
                if (dir < 0) epcSel.parentNode.insertBefore(epcSel, sib); else epcSel.parentNode.insertBefore(sib, epcSel);
            }
            function unselect_tree() { epcSelect(null); }

            function esc(s) { return String(s === undefined || s === null ? '' : s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;'); }
            function fg(label, control) { return '<div class="form-group"><label class="col-lg-6 control-label">' + label + '</label><div class="col-lg-6">' + control + '</div></div>'; }
            function textInput(attr) { return '<input class="form-control" onkeyup="dynamicApplying(\'' + attr + '\');" type="text" id="' + attr + '" value="' + esc(epcSel.epcData[attr]) + '" />'; }
            function onSelected() {
                var box = document.getElementById('item_info_div');
                if (!epcSel) { box.innerHTML = '<p class="text-muted">Select a menu item to edit its parameters.</p>'; return; }
                var n = epcSel.epcData;
                var html = '';
                html += fg('Item caption', '<input class="form-control" type="text" id="value_input" value="' + esc(epcValue(epcSel)) + '" onkeyup="applyCaption();" />');
                html += fg('Link text (&lt;a&gt; content)', '<select class="form-control" id="a_innerhtml_mode" onchange="dynamicApplying(\'a_innerhtml_mode\'); on_a_innerhtml_mode_changed();"><option value="auto"' + (n.a_innerhtml_mode === 'auto' ? ' selected' : '') + '>Same as caption</option><option value="user"' + (n.a_innerhtml_mode === 'user' ? ' selected' : '') + '>Custom</option></select>');
                html += fg('', '<div id="a_innerhtml_div"></div>');
                html += fg('Link type', '<select class="form-control" id="link_mode" onchange="dynamicApplying(\'link_mode\'); on_link_mode_changed();"><option value="url"' + (n.link_mode === 'url' ? ' selected' : '') + '>URL</option><option value="content"' + (n.link_mode !== 'url' ? ' selected' : '') + '>Site page</option></select>');
                html += '<div class="form-group"><label class="col-lg-6 control-label" id="link_value_name"></label><div class="col-lg-6" id="link_value"></div></div>';
                html += fg('target attribute', textInput('target'));
                html += fg('onclick attribute', textInput('onclick'));
                html += fg('Image src', textInput('img_src'));
                html += fg('&lt;a&gt; class attribute', textInput('class_a'));
                html += fg('&lt;a&gt; id attribute', textInput('id_a'));
                html += fg('&lt;li&gt; class attribute', textInput('class_li'));
                html += fg('&lt;li&gt; id attribute', textInput('id_li'));
                html += fg('&lt;ul&gt; class attribute (children)', textInput('class_ul'));
                html += fg('&lt;ul&gt; id attribute (children)', textInput('id_ul'));
                box.innerHTML = html;
                on_a_innerhtml_mode_changed();
                on_link_mode_changed();
            }
            function applyCaption() {
                if (!epcSel) return;
                var v = document.getElementById('value_input').value;
                epcSel.querySelector(':scope > .epc-menu-row > .epc-menu-val').textContent = v;
                if (epcSel.epcData.a_innerhtml_mode === 'auto') { epcSel.epcData.a_innerhtml = v; var d = document.getElementById('a_innerhtml_div'); if (d && !d.querySelector('input')) d.textContent = v; }
            }
            function dynamicApplying(attr) {
                if (!epcSel) return;
                var el = document.getElementById(attr);
                if (!el) return;
                epcSel.epcData[attr] = attr === 'content_id' ? parseInt(el.value, 10) || 0 : el.value;
            }
            function on_a_innerhtml_mode_changed() {
                var n = epcSel.epcData;
                var d = document.getElementById('a_innerhtml_div');
                if (n.a_innerhtml_mode === 'user') {
                    d.innerHTML = '<input class="form-control" onkeyup="dynamicApplying(\'a_innerhtml\');" type="text" id="a_innerhtml" name="a_innerhtml" value="' + esc(n.a_innerhtml) + '" />';
                } else {
                    n.a_innerhtml = epcValue(epcSel);
                    d.textContent = n.a_innerhtml;
                }
            }
            function on_link_mode_changed() {
                var n = epcSel.epcData;
                var name = document.getElementById('link_value_name');
                var d = document.getElementById('link_value');
                if (n.link_mode === 'url') {
                    name.textContent = 'URL';
                    d.innerHTML = '<input class="form-control" onkeyup="dynamicApplying(\'href\');" type="text" id="href" value="' + esc(n.href) + '" />';
                } else {
                    name.textContent = 'Site page';
                    var html = '<select class="form-control" id="content_id" onchange="dynamicApplying(\'content_id\');"><option value="0">— not selected —</option>';
                    content_options.forEach(function (c) { html += '<option value="' + c.id + '"' + (parseInt(n.content_id, 10) === c.id ? ' selected' : '') + '>' + esc(c.caption) + ' (' + esc(c.url) + ')</option>'; });
                    html += '</select>';
                    d.innerHTML = html;
                }
            }
            function epcSerialize(ul) {
                var out = [];
                Array.prototype.forEach.call(ul.children, function (li) {
                    var o = { id: parseInt(li.getAttribute('data-id'), 10), value: epcValue(li) };
                    NODE_FIELDS.forEach(function (f) { o[f] = li.epcData[f]; });
                    if (o.a_innerhtml_mode === 'auto') { o.a_innerhtml = o.value; }
                    o.data = epcSerialize(li.querySelector(':scope > ul'));
                    out.push(o);
                });
                return out;
            }
            function save_tree() {
                var caption = document.getElementById('menu_caption_input').value.trim();
                if (caption === '') { alert('Menu caption is required.'); return; }
                document.getElementById('menu_caption').value = caption;
                document.getElementById('menu_ul_class').value = document.getElementById('menu_ul_class_input').value;
                document.getElementById('menu_ul_id').value = document.getElementById('menu_ul_id_input').value;
                document.getElementById('menu_tree').value = JSON.stringify(epcSerialize(document.querySelector('#container_A > ul')));
                document.getElementById('save_menu').submit();
            }
            function menu_start_init() {
                var box = document.getElementById('container_A');
                var ul = document.createElement('ul');
                saved_menu.forEach(function (n) { ul.appendChild(epcNode(n)); });
                box.appendChild(ul);
            }
            menu_start_init();
            onSelected();
        </script>
    }
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/menu/menu_manager";
    private const string _listHref = "/cp/menus-app";
    private bool _isAdmin;
    private bool _isFrontend = true;
    private long _selectedId;
    private bool _notFound;
    private string _flashOk = "";
    private string _flashErr = "";
    private CpMenuList _list = new([], 0, 1, 20, true);
    private CpMenuEditor? _editor;

    private string ModeHref(bool frontend) => _listHref + "?is_frontend=" + (frontend ? "1" : "0");
    private string PageHref(int page) => ModeHref(_isFrontend) + "&s_page=" + page.ToString(CultureInfo.InvariantCulture);
    private string EditorHref(long id) => ModeHref(_isFrontend) + (id > 0 ? "&menu_id=" + id.ToString(CultureInfo.InvariantCulture) : "&new=1");

    private static string ContentOptionsJson(CpMenuEditor e)
    {
        var arr = new System.Text.Json.Nodes.JsonArray();
        foreach (var c in e.ContentOptions)
        {
            arr.Add(new System.Text.Json.Nodes.JsonObject { ["id"] = c.Id, ["caption"] = c.Caption, ["url"] = c.Url });
        }

        return arr.ToJsonString();
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _isFrontend = ctx.Request.Query["is_frontend"].ToString() != "0";
        _selectedId = ErpRecordOpen.ReadId(ctx.Request, "menu_id");
        var isNew = ctx.Request.Query["new"].ToString() == "1";
        var page = int.TryParse(ctx.Request.Query["s_page"], NumberStyles.Integer, CultureInfo.InvariantCulture, out var p) && p > 0 ? p : 1;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        if (_selectedId > 0 || isNew)
        {
            _editor = await Menus.OpenAsync(_selectedId, _isFrontend, ctx.RequestAborted);
            if (_editor is not null)
            {
                _isFrontend = _editor.IsFrontend;
                return;
            }

            _notFound = _selectedId > 0;
        }

        _list = await Menus.ListAsync(_isFrontend, page, 20, ctx.RequestAborted);
    }
}
