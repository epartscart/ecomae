@page "/cp/menus-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Menus · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
@foreach (var href in LegacyPresentationAssets.CpUsersConsoleStylesheets)
{
    <link rel="stylesheet" href="@href" />
}

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <PhpCpModulePageHeader Title="Menus"
                           Subtitle="PHP menu_manager parity — menu list with node counts, depth, and URL/content link tallies. Drag-tree editor remains classic PHP."
                           PhpTabHref="@_phpTab">
        <a class="ghost" href="/cp/pages-app">Pages</a>
        <a class="ghost" href="/cp/modules-app">Modules</a>
    </PhpCpModulePageHeader>

    @if (!_isAdmin)
    {
        <div class="alert alert-info" role="status">Sign in with a Control Panel admin session to load live menus.</div>
    }
    else if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-warning" role="status">@_message <span class="text-muted small">(@_source)</span></div>
    }

    <div class="epc-scp-kpi" aria-label="Menus KPIs">
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Shown (limit @_limit)</div>
            <div class="epc-scp-kpi__val">@_menus.Count</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Frontend menus</div>
            <div class="epc-scp-kpi__val">@_frontend</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Structure nodes (sum)</div>
            <div class="epc-scp-kpi__val">@_nodes</div>
        </div>
    </div>

    <div class="epc-scp-users-workspace @(_selectedId > 0 ? "is-detail-active" : null)">
        <div class="epc-scp-users-workspace__list">
            <div class="epc-scp-table-card">
                <div class="epc-scp-table-card__head">
                    <div>
                        <h3>Menus</h3>
                        <p class="epc-users-hint">Structure summary from digest — full tree edit is PHP menu_edit</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="epc-scp-data-table table table-epc-pro table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Caption</th>
                                <th>Frontend</th>
                                <th>Nodes</th>
                                <th>Depth</th>
                                <th>URL / content</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_menus.Count == 0)
                            {
                                <tr><td colspan="7">Nothing to show yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var m in _menus)
                                {
                                    <tr class="@(_selectedId == m.Id ? "active" : null)">
                                        <td><strong>@m.Id</strong></td>
                                        <td>@(string.IsNullOrWhiteSpace(m.Caption) ? "—" : m.Caption)</td>
                                        <td><span class="epc-scp-badge">@(m.IsFrontend ? "yes" : "no")</span></td>
                                        <td>@(m.StructurePresent ? m.NodeCount.ToString(CultureInfo.InvariantCulture) : "—")</td>
                                        <td>@(m.StructurePresent ? m.MaxDepth.ToString(CultureInfo.InvariantCulture) : "—")</td>
                                        <td>@m.UrlLinkCount / @m.ContentLinkCount</td>
                                        <td class="epc-scp-actions-cell">
                                            <a href="/cp/menus-app?menu_id=@m.Id.ToString(CultureInfo.InvariantCulture)">Open</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (_selected is not null)
        {
            <div class="epc-scp-users-workspace__detail">
                <div class="epc-scp-table-card">
                    <div class="epc-scp-table-card__head">
                        <div>
                            <h3>@_selected.Caption</h3>
                            <p class="epc-users-hint">Menu structure summary</p>
                        </div>
                        <a class="btn btn-default btn-xs" href="/cp/menus-app">Close</a>
                    </div>
                    <dl style="display:grid;grid-template-columns:9rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                        <dt>ID</dt><dd>@_selected.Id.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Frontend</dt><dd>@(_selected.IsFrontend ? "yes" : "no")</dd>
                        <dt>UL class / id</dt>
                        <dd>
                            <code>@(_selected.MenuUlClass is { Length: > 0 } ? _selected.MenuUlClass : "—")</code>
                            /
                            <code>@(_selected.MenuUlId is { Length: > 0 } ? _selected.MenuUlId : "—")</code>
                        </dd>
                        <dt>Structure</dt>
                        <dd>
                            @if (_selected.StructurePresent)
                            {
                                <span>@_selected.NodeCount nodes · depth @_selected.MaxDepth · parse @(_selected.StructureParseOk ? "ok" : "error")</span>
                            }
                            else
                            {
                                <span>not present</span>
                            }
                        </dd>
                        <dt>Links</dt>
                        <dd>URL @_selected.UrlLinkCount · content @_selected.ContentLinkCount · unknown @_selected.UnknownLinkCount</dd>
                    </dl>
                    <p style="margin:.85rem 0 0;font-size:.86rem;">
                        <a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref($"/CP/menu/menu_edit?menu_id={_selected.Id.ToString(CultureInfo.InvariantCulture)}")">Edit tree in PHP menu_edit</a>
                    </p>
                </div>
            </div>
        }
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/menu/menu_manager";
    private bool _isAdmin;
    private int _selectedId;
    private IReadOnlyList<CpMenuDigest> _menus = [];
    private CpMenuDigest? _selected;
    private int _frontend;
    private int _nodes;
    private int _limit = 200;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("menu_id", out var idRaw)
            && int.TryParse(idRaw.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var id))
        {
            _selectedId = id;
        }

        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.ListCpMenusAsync(_limit, ctx.RequestAborted);
        _menus = result.Menus;
        _frontend = _menus.Count(m => m.IsFrontend);
        _nodes = _menus.Sum(m => m.NodeCount);
        _source = result.Source;
        _message = result.Message;
        if (_selectedId > 0)
        {
            _selected = _menus.FirstOrDefault(m => m.Id == _selectedId);
        }
    }
}
