@page "/cp/menus-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Menus · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-mn-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#1c1917 0%,#44403c 50%,#78716c 100%);
        }
        .epc-mn-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-mn-hero p { margin:0; color:#e7e5e4; max-width:40rem; font-size:.92rem; line-height:1.45; }
        .epc-mn-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-mn-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#1c1917; background:#fbbf24;
        }
        .epc-mn-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-mn-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-mn-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-mn-kpi strong { display:block; font-size:1.45rem; font-variant-numeric:tabular-nums; }
        .epc-mn-kpi span { color:#64748b; font-size:.78rem; }
        .epc-mn-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-mn-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-mn-table th, .epc-mn-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-mn-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-mn-table a { color:#a16207; font-weight:700; text-decoration:none; }
        .epc-mn-badge { display:inline-flex; padding:.15rem .45rem; border-radius:.3rem; font-size:.72rem; font-weight:700; background:#fef3c7; color:#78350f; }
        .epc-mn-note { margin-top:1rem; padding:.75rem .9rem; background:#fafaf9; border:1px solid #d6d3d1; border-radius:.45rem; color:#44403c; font-size:.86rem; }
        @@media (max-width:900px){ .epc-mn-kpis{grid-template-columns:1fr;} }
    </style>

    <section class="epc-mn-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Menus</h1>
        <p>Read-only CP menu metadata + structure summary from <code>/cp/menus</code> digest under PHP CP desktop chrome. Raw structure JSON omitted. Create/edit stay on live PHP menu manager — same-to-same for tenants.</p>
        <div class="epc-mn-cta">
            <a href="@_phpTab">Open PHP menu manager</a>
            <a class="ghost" href="@PhpModuleCatalog.HybridWorkspaceHref("/cp/app", _phpTab)">Hybrid workspace</a>
            <a class="ghost" href="/cp/pages-app">Pages list</a>
            <a class="ghost" href="/cp/modules-app">Modules list</a>
            <a class="ghost" href="/cp/app">Command centre</a>
        </div>
    </section>

    <div class="epc-mn-kpis" aria-label="Menus KPIs">
        <div class="epc-mn-kpi"><strong>@_menus.Count</strong><span>Shown (limit @_limit)</span></div>
        <div class="epc-mn-kpi"><strong>@_frontend</strong><span>Frontend menus</span></div>
        <div class="epc-mn-kpi"><strong>@_nodes</strong><span>Structure nodes (sum)</span></div>
    </div>

    <div class="epc-mn-table-wrap">
        <table class="epc-mn-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Caption</th>
                    <th>Frontend</th>
                    <th>Nodes</th>
                    <th>Depth</th>
                    <th>URL / content</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_menus.Count == 0)
                {
                    <tr><td colspan="7">No menus in digest (@_source). @_message</td></tr>
                }
                else
                {
                    @foreach (var m in _menus)
                    {
                        var phpHref = $"/CP/menu/menu_edit?menu_id={m.Id.ToString(CultureInfo.InvariantCulture)}";
                        <tr>
                            <td><strong>@m.Id</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(m.Caption) ? "—" : m.Caption)</td>
                            <td><span class="epc-mn-badge">@(m.IsFrontend ? "yes" : "no")</span></td>
                            <td>@(m.StructurePresent ? m.NodeCount.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(m.StructurePresent ? m.MaxDepth.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@m.UrlLinkCount / @m.ContentLinkCount</td>
                            <td><a href="@phpHref">Open in PHP</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-mn-note">
        Read-only preview · JSON digest <a href="/cp/menus?limit=200">/cp/menus</a> (structure summary only; raw tree omitted).
        PHP <code>menu_manager</code> / <code>menu_edit</code> remain authoritative for create/edit.
        Not a broad /cp cutover · tenant product chrome stays PHP (same-to-same).
        Source: <code>@_source</code>.
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/menu/menu_manager";
    private bool _isAdmin;
    private IReadOnlyList<CpMenuDigest> _menus = [];
    private int _frontend;
    private int _nodes;
    private int _limit = 200;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.ListCpMenusAsync(_limit, ctx.RequestAborted);
        _menus = result.Menus;
        _frontend = _menus.Count(m => m.IsFrontend);
        _nodes = _menus.Sum(m => m.NodeCount);
        _source = result.Source;
        _message = result.Message;
    }
}
