@page "/cp/menus-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Menus · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
@foreach (var href in LegacyPresentationAssets.CpUsersConsoleStylesheets)
{
    <link rel="stylesheet" href="@href" />
}

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/menus-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_selectedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />


    <PhpCpModulePageHeader Title="Menus"
                           Subtitle="Create, save, or delete a menu here. Drag-tree editor stays on the Classic twin."
                           PhpTabHref="@_phpTab">
        <a class="ghost" href="/cp/pages-app">Pages</a>
        <a class="ghost" href="/cp/modules-app">Modules</a>
    </PhpCpModulePageHeader>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/menus/write" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(_selectedId > 0 ? _listHref + "?menu_id=" + _selectedId.ToString(CultureInfo.InvariantCulture) : _listHref)" />
            <input type="hidden" name="langCode" value="en" />
            <div style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                <label>Action
                    <select name="action">
                        <option value="create">create</option>
                        <option value="update">update</option>
                    </select>
                </label>
                <label>Menu id <input type="number" name="menuId" min="0" value="@(_selectedId > 0 ? _selectedId.ToString(CultureInfo.InvariantCulture) : "0")" style="width:6rem" title="0 = create" /></label>
                <label>Caption <input type="text" name="caption" /></label>
                <label>UL class <input type="text" name="menuUlClass" /></label>
                <label>UL id <input type="text" name="menuUlId" /></label>
                <label>Frontend
                    <select name="isFrontend">
                        <option value="1">Yes</option>
                        <option value="0">No</option>
                    </select>
                </label>
            </div>
            <label>Structure JSON
                <textarea name="treeJson" rows="6" style="width:100%;font-family:monospace" placeholder="[] or paste menu_tree JSON. Leave empty on update to keep the current tree."></textarea>
            </label>
            <button type="submit">Save menu</button>
        </form>
        <form method="post" action="/cp/menus/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(_selectedId > 0 ? _listHref + "?menu_id=" + _selectedId.ToString(CultureInfo.InvariantCulture) : _listHref)" />
            <input type="hidden" name="action" value="delete" />
            <label>Ids <input type="text" name="ids" required placeholder="[1] or 1,2" /></label>
            <button type="submit">Delete menus</button>
        </form>
    }

    @if (!_isAdmin)
    {
        <div class="alert alert-info" role="status">Sign in with a Control Panel admin session to load live menus.</div>
    }
    else if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-warning" role="status">@_message <span class="text-muted small">(@_source)</span></div>
    }

    <div class="epc-scp-kpi" aria-label="Menus KPIs">
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Shown (limit @_limit)</div>
            <div class="epc-scp-kpi__val">@_menus.Count</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Frontend menus</div>
            <div class="epc-scp-kpi__val">@_frontend</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Structure nodes (sum)</div>
            <div class="epc-scp-kpi__val">@_nodes</div>
        </div>
    </div>

    <div class="epc-scp-users-workspace @(_selectedId > 0 ? "is-detail-active" : null)">
        <div class="epc-scp-users-workspace__list">
            <div class="epc-scp-table-card">
                <div class="epc-scp-table-card__head">
                    <div>
                        <h3>Menus</h3>
                        <p class="epc-users-hint">Open a row for the 280-character structure excerpt. Save menu writes here; drag-tree stays Classic.</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="epc-scp-data-table table table-epc-pro table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Caption</th>
                                <th>Frontend</th>
                                <th>Nodes</th>
                                <th>Depth</th>
                                <th>URL / content</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_menus.Count == 0)
                            {
                                <tr><td colspan="7">No records yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var m in _menus)
                                {
                                    <tr id="erp-row-@m.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(m.Id, _selectedId)">
                                        <td><strong>@m.Id</strong></td>
                                        <td>@(string.IsNullOrWhiteSpace(m.Caption) ? "—" : m.Caption)</td>
                                        <td><span class="epc-scp-badge">@(m.IsFrontend ? "yes" : "no")</span></td>
                                        <td>@(m.StructurePresent ? m.NodeCount.ToString(CultureInfo.InvariantCulture) : "—")</td>
                                        <td>@(m.StructurePresent ? m.MaxDepth.ToString(CultureInfo.InvariantCulture) : "—")</td>
                                        <td>@m.UrlLinkCount / @m.ContentLinkCount</td>
                                        <td class="epc-scp-actions-cell">
                                            <a href="@ErpRecordOpen.Href(_listHref, "menu_id", m.Id)">Open</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (_selected is not null || _opened is not null)
        {
            <div class="epc-scp-users-workspace__detail">
                <div class="epc-scp-table-card">
                    <div class="epc-scp-table-card__head">
                        <div>
                            <h3>@OpenedCaption</h3>
                            <p class="epc-users-hint">Menu field preview. Full tree stays on the Classic twin.</p>
                        </div>
                        <a class="btn btn-default btn-xs" href="@_listHref">Close</a>
                    </div>
                    <dl style="display:grid;grid-template-columns:9rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                        <dt>ID</dt><dd>@(_opened?.Id ?? _selected?.Id ?? 0).ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Frontend</dt><dd>@((_opened?.IsFrontend ?? _selected?.IsFrontend ?? false) ? "yes" : "no")</dd>
                        <dt>UL class / id</dt>
                        <dd>
                            <code>@(!string.IsNullOrWhiteSpace(_opened?.MenuUlClass) ? _opened!.MenuUlClass : (!string.IsNullOrWhiteSpace(_selected?.MenuUlClass) ? _selected!.MenuUlClass : "—"))</code>
                            /
                            <code>@(!string.IsNullOrWhiteSpace(_opened?.MenuUlId) ? _opened!.MenuUlId : (!string.IsNullOrWhiteSpace(_selected?.MenuUlId) ? _selected!.MenuUlId : "—"))</code>
                        </dd>
                        <dt>Structure</dt>
                        <dd>
                            @if (_selected is { StructurePresent: true } selectedStructure)
                            {
                                <span>@selectedStructure.NodeCount nodes · depth @selectedStructure.MaxDepth · parse @(selectedStructure.StructureParseOk ? "ok" : "error")</span>
                            }
                            else if (_opened is { StructureLen: > 0 })
                            {
                                <span>@_opened.StructureLen.ToString(CultureInfo.InvariantCulture) characters stored</span>
                            }
                            else
                            {
                                <span>not present</span>
                            }
                        </dd>
                        <dt>Links</dt>
                        <dd>URL @(_selected?.UrlLinkCount ?? 0) · content @(_selected?.ContentLinkCount ?? 0) · unknown @(_selected?.UnknownLinkCount ?? 0)</dd>
                    </dl>
                    @if (_opened is not null && !string.IsNullOrWhiteSpace(_opened.StructureExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:.85rem 0 0">@_opened.StructureExcerpt</pre>
                        @if (_opened.StructureLen > _opened.StructureExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_opened.StructureExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.StructureLen.ToString(CultureInfo.InvariantCulture) chars). Full tree stays on the Classic twin.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted" style="margin:.85rem 0 0">No structure excerpt yet.</p>
                    }
                    @if (_openedSiblings.Count > 0)
                    {
                        <p class="epc-users-hint" style="margin:1rem 0 .4rem">Same frontend</p>
                        <table class="table table-condensed table-striped table-epc">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Caption</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sib in _openedSiblings)
                                {
                                    <tr>
                                        <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@(string.IsNullOrWhiteSpace(sib.Caption) ? "—" : sib.Caption)</td>
                                        <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "menu_id", sib.Id)">Open</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (_opened is not null)
                    {
                        <p class="text-muted">No same-frontend siblings yet.</p>
                    }
                    <p style="margin:.85rem 0 0;font-size:.86rem;">
                        <a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref($"/CP/menu/menu_edit?menu_id={(_opened?.Id ?? _selected?.Id ?? 0).ToString(CultureInfo.InvariantCulture)}")">Drag-tree on the Classic twin</a>
                    </p>
                </div>
            </div>
        }
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/menu/menu_manager";
    private bool _isAdmin;
    private long _selectedId;
    private IReadOnlyList<CpMenuDigest> _menus = [];
    private CpMenuDigest? _selected;
    private CpMenuDetail? _opened;
    private IReadOnlyList<CpMenuDigest> _openedSiblings = [];
    private int _frontend;
    private int _nodes;
    private int _limit = 200;
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private string _listHref = "/cp/menus-app";

    private string OpenedCaption =>
        !string.IsNullOrWhiteSpace(_opened?.Caption)
            ? _opened.Caption
            : (!string.IsNullOrWhiteSpace(_selected?.Caption)
                ? _selected.Caption
                : (_selectedId > 0 ? ("Menu #" + _selectedId.ToString(CultureInfo.InvariantCulture)) : ""));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _selectedId = ErpRecordOpen.ReadId(ctx.Request, "menu_id");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);

        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.ListCpMenusAsync(_limit, ctx.RequestAborted);
        _menus = result.Menus;
        _frontend = _menus.Count(m => m.IsFrontend);
        _nodes = _menus.Sum(m => m.NodeCount);
        _source = result.Source;
        _message = result.Message;
        if (_selectedId > 0)
        {
            _selected = _menus.FirstOrDefault(m => m.Id == _selectedId);
            var detail = await Dashboards.BuildCpMenusDetailAsync(_selectedId, ctx.RequestAborted);
            _opened = detail.Menu;
            _openedSiblings = detail.Siblings;
            if (_selected is not null)
            {
                _menus = new[] { _selected }.Concat(_menus.Where(m => m.Id != _selectedId)).ToList();
            }
        }
    }
}
