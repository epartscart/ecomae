@page "/cp/users-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using System.Text.Json
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@inject ICpUserEditorService Users
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Users · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
@foreach (var href in LegacyPresentationAssets.CpUsersConsoleStylesheets)
{
    <link rel="stylesheet" href="@href" />
}
<style>
    .epc-users-actions .panel_a { display:inline-block; text-align:center; text-decoration:none; color:#333; margin-right:14px; vertical-align:top; cursor:pointer; }
    .epc-users-actions .panel_a_img { width:48px; height:48px; margin:0 auto 4px; border-radius:8px; background:#f1f3f6; display:flex; align-items:center; justify-content:center; font-size:22px; color:#3498db; }
    .epc-users-actions .panel_a_caption { font-size:12px; }
    .table-epc td a { color:inherit; display:block; }
    .table-epc th a { color:inherit; text-decoration:none; }
    .table-epc tr.epc-locked td { background-color:#fbe9e7 !important; }
    .filter_panel .form-group { margin-bottom:6px; }
    .epc-row-icons a { display:inline-block; width:22px; height:22px; margin-right:3px; text-align:center; line-height:22px; color:#555; }
    .epc-group-tree ul { list-style:none; padding-left:18px; margin:0; }
    .epc-group-tree li { padding:2px 0; }
    .epc-group-tree .fa { margin-left:4px; }
</style>

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    @if (!_isAdmin)
    {
        <div class="col-lg-12"><div class="hpanel"><div class="panel-body">
            <div class="alert alert-warning" role="status">Sign in to the Control Panel to manage users. <a href="/cp/login?returnUrl=/cp/users-app">Login</a></div>
        </div></div></div>
    }
    else if (_editor is not null)
    {
        var e = _editor;
        var isNew = e.UserId <= 0;
        @* ---- user.php twin ---- *@
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(isNew ? "New user" : "User #" + e.UserId.ToString(CultureInfo.InvariantCulture))
                    <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(isNew ? _phpEditTab : _phpEditTab + "?user_id=" + e.UserId.ToString(CultureInfo.InvariantCulture))">Classic twin</a>
                </div>
                <div class="panel-body epc-users-actions">
                    <a class="panel_a" href="javascript:void(0);" onclick="save_action();"><div class="panel_a_img"><i class="fa fa-save"></i></div><div class="panel_a_caption">Save</div></a>
                    <a class="panel_a" href="/cp/users-app"><div class="panel_a_img"><i class="fa fa-users"></i></div><div class="panel_a_caption">Users</div></a>
                    @if (!isNew)
                    {
                        <a class="panel_a" href="/cp/orders?customer_id=@e.UserId.ToString(CultureInfo.InvariantCulture)"><div class="panel_a_img"><i class="fa fa-shopping-cart"></i></div><div class="panel_a_caption">Orders</div></a>
                        <a class="panel_a" href="/cp/credit-limits-app?user_id=@e.UserId.ToString(CultureInfo.InvariantCulture)"><div class="panel_a_img"><i class="fa fa-credit-card"></i></div><div class="panel_a_caption">Balance</div></a>
                        <a class="panel_a" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpEditTab + "?user_id=" + e.UserId.ToString(CultureInfo.InvariantCulture))" title="Sign in as this user (opens the classic twin)"><div class="panel_a_img"><i class="fa fa-key"></i></div><div class="panel_a_caption">Login as user</div></a>
                        <a class="panel_a" href="/cp/statistics-app?user_id=@e.UserId.ToString(CultureInfo.InvariantCulture)"><div class="panel_a_img"><i class="fa fa-bar-chart"></i></div><div class="panel_a_caption">Statistics</div></a>
                    }
                    <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div> }

        <div class="col-lg-6">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Account</div>
                <div class="panel-body form-horizontal">
                    @if (!isNew)
                    {
                        <div class="form-group"><label class="col-lg-6 control-label">ID</label><div class="col-lg-6"><p class="form-control-static">@e.UserId.ToString(CultureInfo.InvariantCulture)</p></div></div>
                    }
                    <div class="form-group">
                        <label class="col-lg-6 control-label" for="reg_variant_selector">Registration variant</label>
                        <div class="col-lg-6">
                            <select id="reg_variant_selector" class="form-control" onchange="regenerateFields();">
                                @foreach (var v in e.Variants)
                                {
                                    <option value="@v.Id.ToString(CultureInfo.InvariantCulture)" selected="@(v.Id == e.RegVariant)">@v.Caption</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-6 control-label" for="unlocked_checkbox">Unlocked</label>
                        <div class="col-lg-6"><input type="checkbox" id="unlocked_checkbox" checked="@e.Unlocked" /></div>
                    </div>
                    <div class="hr-line-dashed"></div>
                    <div class="form-group">
                        <label class="col-lg-6 control-label" for="email">E-mail</label>
                        <div class="col-lg-6"><input type="text" id="email" class="form-control" value="@e.Email" /></div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-6 control-label" for="email_confirmed">E-mail confirmed</label>
                        <div class="col-lg-6"><input type="checkbox" id="email_confirmed" checked="@e.EmailConfirmed" /></div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-6 control-label" for="phone">Phone</label>
                        <div class="col-lg-6"><input type="text" id="phone" class="form-control" placeholder="9005556677" value="@e.Phone" /></div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-6 control-label" for="phone_confirmed">Phone confirmed</label>
                        <div class="col-lg-6"><input type="checkbox" id="phone_confirmed" checked="@e.PhoneConfirmed" /></div>
                    </div>
                    <div class="hr-line-dashed"></div>
                    <div class="form-group">
                        <label class="col-lg-6 control-label" for="password">Password</label>
                        <div class="col-lg-6"><input type="password" id="password" class="form-control" autocomplete="new-password" placeholder="@(isNew ? "Required" : "Leave empty to keep")" /></div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-6 control-label" for="password_repeat">Repeat password</label>
                        <div class="col-lg-6"><input type="password" id="password_repeat" class="form-control" autocomplete="new-password" /></div>
                    </div>
                    <div id="additional_fields_div"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Groups</div>
                <div class="panel-body epc-group-tree" id="groups_tree">
                    @if (e.Groups.Count == 0)
                    {
                        <p class="text-muted">No groups defined. <a href="/cp/groups-app">Groups</a></p>
                    }
                    else
                    {
                        @RenderGroupTree(e, 0)
                    }
                </div>
            </div>
            @if (!isNew)
            {
                <div class="hpanel">
                    <div class="panel-heading hbuilt">Balance</div>
                    <div class="panel-body"><h3 style="margin:0">@e.Balance.ToString("N2", CultureInfo.InvariantCulture)</h3></div>
                </div>
                <div class="hpanel">
                    <div class="panel-heading hbuilt">Staff comment</div>
                    <div class="panel-body">
                        <form method="post" action="/cp/users/set-comment">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@EditorHref(e.UserId)" />
                            <input type="hidden" name="userId" value="@e.UserId.ToString(CultureInfo.InvariantCulture)" />
                            <textarea id="user_comment" name="comment" rows="6" maxlength="4000" style="width:100%;font-size:14px;font-weight:bold">@e.Comment</textarea>
                            <button type="submit" class="btn btn-xs btn-default" style="margin-top:6px">Save comment</button>
                        </form>
                    </div>
                </div>
                <div class="hpanel">
                    <div class="panel-heading hbuilt">Set password only</div>
                    <div class="panel-body">
                        <form method="post" action="/cp/users/set-password" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@EditorHref(e.UserId)" />
                            <input type="hidden" name="userId" value="@e.UserId.ToString(CultureInfo.InvariantCulture)" />
                            <label>New password <input type="password" name="password" required maxlength="200" autocomplete="new-password" class="form-control" style="width:12rem" /></label>
                            <button type="submit" class="btn btn-xs btn-default">Set password</button>
                        </form>
                    </div>
                </div>
                <div class="hpanel">
                    <div class="panel-heading hbuilt">Vendor approval</div>
                    <div class="panel-body">
                        <form method="post" action="/cp/vendors/approvals" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@EditorHref(e.UserId)" />
                            <input type="hidden" name="id" value="@e.UserId.ToString(CultureInfo.InvariantCulture)" />
                            <label>Action
                                <select name="action" class="form-control">
                                    <option value="approve">Approve</option>
                                    <option value="suspend">Suspend</option>
                                    <option value="reject">Reject</option>
                                </select>
                            </label>
                            <button type="submit" class="btn btn-xs btn-primary">Apply vendor status</button>
                            <a class="btn btn-default btn-xs" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref("/CP/users/vendor_approvals")">Classic twin</a>
                        </form>
                    </div>
                </div>
            }
        </div>

        <form id="save_form" method="post" action="@(isNew ? "/cp/users/create" : "/cp/users/update")" style="display:none">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(isNew ? "/cp/users-app" : EditorHref(e.UserId))" />
            <input type="hidden" name="save_action" id="save_action" value="@(isNew ? "create" : "update")" />
            <input type="hidden" name="user_id" id="user_id" value="@e.UserId.ToString(CultureInfo.InvariantCulture)" />
            <input type="hidden" name="reg_variant" id="reg_variant" value="" />
            <input type="hidden" name="unlocked" id="unlocked" value="" />
            <input type="hidden" name="fields_json" id="fields_json" value="" />
            <input type="hidden" name="groups" id="groups" value="" />
            <input type="hidden" name="email" id="email_form" value="" />
            <input type="hidden" name="email_confirmed" id="email_confirmed_form" value="" />
            <input type="hidden" name="phone" id="phone_form" value="" />
            <input type="hidden" name="phone_confirmed" id="phone_confirmed_form" value="" />
            <input type="hidden" name="password" id="password_form" value="" />
        </form>

        <script>
            var reg_fields = @((MarkupString)RegFieldsJson(e));
            var user_groups_list = @((MarkupString)JsonSerializer.Serialize(e.GroupIds));
            function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }
            function regenerateFields() {
                var variant = parseInt(document.getElementById('reg_variant_selector').value, 10);
                var html = '';
                for (var i = 0; i < reg_fields.length; i++) {
                    var f = reg_fields[i];
                    if (f.show_for.indexOf(variant) < 0) { continue; }
                    var star = f.required_for.indexOf(variant) >= 0 ? '*' : '';
                    html += '<div class="form-group"><label class="col-lg-6 control-label">' + esc(f.caption) + star + '</label><div class="col-lg-6">';
                    html += '<input onkeyup="dynamicApplying(\'' + esc(f.name) + '\');" type="text" name="' + esc(f.name) + '" id="' + esc(f.name) + '" value="' + esc(f.value_buffer) + '" class="form-control" maxlength="' + (f.maxlen > 0 ? f.maxlen : 255) + '" />';
                    html += '</div></div><div class="hr-line-dashed col-lg-12"></div>';
                }
                if (html.length > 0) { html = '<div class="col-lg-12 text-center"><h3><strong>Additional fields</strong></h3></div>' + html; }
                document.getElementById('additional_fields_div').innerHTML = html;
            }
            function dynamicApplying(name) {
                var v = document.getElementById(name).value;
                for (var i = 0; i < reg_fields.length; i++) { if (reg_fields[i].name === name) { reg_fields[i].value_buffer = v; break; } }
            }
            function save_action() {
                var variant = parseInt(document.getElementById('reg_variant_selector').value, 10);
                var email = document.getElementById('email').value.trim();
                var phone = document.getElementById('phone').value.trim();
                var pwd = document.getElementById('password').value;
                var rep = document.getElementById('password_repeat').value;
                if (email.length === 0 && phone.length === 0) { alert('Enter an e-mail or a phone.'); return; }
                if (pwd !== rep) { alert('Passwords do not match.'); return; }
                if (@(isNew ? "true" : "false") && pwd.length === 0) { alert('Password is required.'); return; }
                var fields = [];
                for (var i = 0; i < reg_fields.length; i++) {
                    var f = reg_fields[i];
                    if (f.show_for.indexOf(variant) < 0) { continue; }
                    if (f.required_for.indexOf(variant) >= 0 && f.value_buffer.trim().length === 0) { alert('Field "' + f.caption + '" is required.'); return; }
                    if (f.regexp && f.regexp.length > 0 && f.value_buffer.length > 0) {
                        try { if (!(new RegExp(f.regexp)).test(f.value_buffer)) { alert('Field "' + f.caption + '" has an invalid value.'); return; } } catch (ex) { }
                    }
                    fields.push({ name: f.name, value: f.value_buffer });
                }
                var groups = [];
                var boxes = document.querySelectorAll('#groups_tree input[type=checkbox]:checked');
                for (var b = 0; b < boxes.length; b++) { groups.push(parseInt(boxes[b].value, 10)); }
                document.getElementById('reg_variant').value = variant;
                document.getElementById('unlocked').value = document.getElementById('unlocked_checkbox').checked ? '1' : '0';
                document.getElementById('fields_json').value = JSON.stringify(fields);
                document.getElementById('groups').value = JSON.stringify(groups);
                document.getElementById('email_form').value = email;
                document.getElementById('email_confirmed_form').value = document.getElementById('email_confirmed').checked ? '1' : '0';
                document.getElementById('phone_form').value = phone;
                document.getElementById('phone_confirmed_form').value = document.getElementById('phone_confirmed').checked ? '1' : '0';
                document.getElementById('password_form').value = pwd;
                document.getElementById('save_form').submit();
            }
            regenerateFields();
        </script>
    }
    else
    {
        var l = _list!;
        @* ---- user_manager.php twin ---- *@
        <PhpCpModulePageHeader Title="Users"
                               Subtitle="PHP user_manager twin: filter, sort and page the users table; open a row for the user.php editor (profile fields, groups, balance, comment)."
                               PhpTabHref="@_phpTab">
            <a class="ghost" href="/cp/groups-app">Groups</a>
            <a class="ghost" href="/cp/orders">Orders</a>
            <a class="ghost" href="/cp/credit-limits-app">Balances</a>
        </PhpCpModulePageHeader>
        <div class="col-lg-12 epc-users-page">
            <div class="epc-scp-kpi" aria-label="Users KPIs">
                <div class="epc-scp-kpi__card"><div class="epc-scp-kpi__label">Total (filtered)</div><div class="epc-scp-kpi__val">@l.Total.ToString(CultureInfo.InvariantCulture)</div></div>
                <div class="epc-scp-kpi__card"><div class="epc-scp-kpi__label">Unlocked in page</div><div class="epc-scp-kpi__val">@l.Rows.Count(r => r.Unlocked).ToString(CultureInfo.InvariantCulture)</div></div>
                <div class="epc-scp-kpi__card"><div class="epc-scp-kpi__label">Locked in page</div><div class="epc-scp-kpi__val">@l.Rows.Count(r => !r.Unlocked).ToString(CultureInfo.InvariantCulture)</div></div>
                <div class="epc-scp-kpi__card"><div class="epc-scp-kpi__label">Page</div><div class="epc-scp-kpi__val">@l.Page.ToString(CultureInfo.InvariantCulture) / @l.PageCount.ToString(CultureInfo.InvariantCulture)</div></div>
            </div>
        </div>
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Users
                    <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
                </div>
                <div class="panel-body epc-users-actions">
                    <a class="panel_a" href="/cp/users-app?new=1"><div class="panel_a_img"><i class="fa fa-user-plus"></i></div><div class="panel_a_caption">Create user</div></a>
                    <a class="panel_a" href="javascript:void(0);" onclick="delete_users();"><div class="panel_a_img"><i class="fa fa-trash-o"></i></div><div class="panel_a_caption">Delete</div></a>
                    <a class="panel_a" href="/cp/groups-app"><div class="panel_a_img"><i class="fa fa-sitemap"></i></div><div class="panel_a_caption">Groups</div></a>
                    <a class="panel_a" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref("/CP/users/polya-registracii")"><div class="panel_a_img"><i class="fa fa-list-alt"></i></div><div class="panel_a_caption">Registration fields</div></a>
                    <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div> }
        @if (_notFound) { <div class="col-lg-12"><div class="alert alert-danger" role="status">User #@_selectedId.ToString(CultureInfo.InvariantCulture) was not found.</div></div> }

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Filter</div>
                <div class="panel-body filter_panel">
                    <form method="get" action="/cp/users-app" class="form-horizontal" id="filter_form">
                        <input type="hidden" name="sort" value="@l.SortField" />
                        <input type="hidden" name="dir" value="@(l.SortAsc ? "asc" : "desc")" />
                        <div class="row">
                            <div class="col-lg-3">
                                <div class="form-group"><label class="col-lg-5 control-label" for="user_id">ID</label><div class="col-lg-7"><input type="text" id="user_id" name="f_user_id" class="form-control" value="@l.Filter.UserId" style="@(l.Filter.UserId.Length > 0 ? "background:#b9fcab" : "")" /></div></div>
                                <div class="form-group"><label class="col-lg-5 control-label" for="group_id">Group</label><div class="col-lg-7">
                                    <select id="group_id" name="f_group_id" class="form-control" style="@(l.Filter.GroupId >= 0 ? "background:#b9fcab" : "")">
                                        <option value="-1" selected="@(l.Filter.GroupId < 0)">— any —</option>
                                        @foreach (var g in l.Groups.OrderBy(g => g.Level).ThenBy(g => g.Id))
                                        {
                                            <option value="@g.Id.ToString(CultureInfo.InvariantCulture)" selected="@(g.Id == l.Filter.GroupId)">@(new string('·', Math.Max(0, g.Level)))@g.Value</option>
                                        }
                                    </select></div></div>
                            </div>
                            <div class="col-lg-3">
                                <div class="form-group"><label class="col-lg-5 control-label" for="f_email">E-mail</label><div class="col-lg-7"><input type="text" id="f_email" name="f_email" class="form-control" value="@l.Filter.Email" style="@(l.Filter.Email.Length > 0 ? "background:#b9fcab" : "")" /></div></div>
                                <div class="form-group"><label class="col-lg-5 control-label" for="f_phone">Phone</label><div class="col-lg-7"><input type="text" id="f_phone" name="f_phone" class="form-control" value="@l.Filter.Phone" style="@(l.Filter.Phone.Length > 0 ? "background:#b9fcab" : "")" /></div></div>
                            </div>
                            <div class="col-lg-3">
                                <div class="form-group"><label class="col-lg-5 control-label" for="f_unlocked">Unlocked</label><div class="col-lg-7">
                                    <select id="f_unlocked" name="f_unlocked" class="form-control" style="@(l.Filter.Unlocked >= 0 ? "background:#b9fcab" : "")">
                                        <option value="-1" selected="@(l.Filter.Unlocked < 0)">— any —</option>
                                        <option value="1" selected="@(l.Filter.Unlocked == 1)">Yes</option>
                                        <option value="0" selected="@(l.Filter.Unlocked == 0)">No</option>
                                    </select></div></div>
                                @foreach (var f in l.FilterFields)
                                {
                                    var fv = FilterFieldValue(l, f.Name);
                                    <div class="form-group"><label class="col-lg-5 control-label" for="ff_@f.Name">@f.Caption</label><div class="col-lg-7"><input type="text" id="ff_@f.Name" name="ff_@f.Name" class="form-control" value="@fv" style="@(fv.Length > 0 ? "background:#b9fcab" : "")" /></div></div>
                                }
                            </div>
                            <div class="col-lg-3">
                                <button type="submit" class="btn btn-sm btn-primary"><i class="fa fa-filter"></i> Apply</button>
                                <a class="btn btn-sm btn-default" href="/cp/users-app">Reset</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Users list — @l.Total.ToString(CultureInfo.InvariantCulture) total, page @l.Page.ToString(CultureInfo.InvariantCulture) / @l.PageCount.ToString(CultureInfo.InvariantCulture)
                </div>
                <div class="panel-body epc-scp-table-card">
                    <div class="table-responsive">
                        <table class="epc-scp-data-table table table-striped table-bordered table-hover table-epc" id="users_table">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" id="check_uncheck_all" onchange="on_check_uncheck_all();" /></th>
                                    <th>@SortLink(l, "user_id", "ID")</th>
                                    <th></th>
                                    <th>Groups</th>
                                    <th>@SortLink(l, "reg_variant", "Reg. variant")</th>
                                    <th>@SortLink(l, "email", "E-mail")</th>
                                    <th>@SortLink(l, "phone", "Phone")</th>
                                    @foreach (var c in l.TableColumns)
                                    {
                                        <th>@SortLink(l, c.Name, c.Caption)</th>
                                    }
                                    <th>@SortLink(l, "time_registered", "Registered")</th>
                                    <th>@SortLink(l, "time_last_visit", "Last visit")</th>
                                    <th>@SortLink(l, "admin_created", "Created by admin")</th>
                                    <th>@SortLink(l, "balance", "Balance")</th>
                                    <th class="text-center">@SortLink(l, "unlocked", "Unlocked")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (l.Rows.Count == 0)
                                {
                                    <tr><td colspan="@((13 + l.TableColumns.Count).ToString(CultureInfo.InvariantCulture))" class="text-muted">No users match the filter.</td></tr>
                                }
                                @foreach (var r in l.Rows)
                                {
                                    var id = r.UserId.ToString(CultureInfo.InvariantCulture);
                                    var href = EditorHref(r.UserId);
                                    <tr id="erp-row-@id" class="@(r.Unlocked ? "" : "epc-locked")">
                                        <td><input type="checkbox" class="epc-user-check" id="checked_@id" name="checked_@id" value="@id" onchange="on_one_check_changed();" /></td>
                                        <td><a href="@href">@id</a></td>
                                        <td class="epc-row-icons" style="white-space:nowrap">
                                            <a href="/cp/orders?customer_id=@id" title="Orders"><i class="fa fa-shopping-cart"></i></a>
                                            <a href="/cp/credit-limits-app?user_id=@id" title="Balance"><i class="fa fa-credit-card"></i></a>
                                            <a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpEditTab + "?user_id=" + id)" title="Login as user (PHP twin)"><i class="fa fa-key"></i></a>
                                            <a href="/cp/statistics-app?user_id=@id" title="Statistics"><i class="fa fa-bar-chart"></i></a>
                                        </td>
                                        <td>@((MarkupString)string.Join(";<br>", r.Groups.Select(System.Net.WebUtility.HtmlEncode)))</td>
                                        <td><a href="@href">@r.RegVariantCaption</a></td>
                                        <td>
                                            <a href="@href" style="display:inline">@r.Email</a>
                                            @if (r.Email.Length > 0)
                                            {
                                                @if (r.EmailConfirmed) { <i class="fa fa-check-circle" style="color:#0A0" title="Confirmed"></i> } else { <i class="fa fa-exclamation-triangle" style="color:#F00" title="Not confirmed"></i> }
                                            }
                                        </td>
                                        <td>
                                            <a href="@href" style="display:inline">@r.Phone</a>
                                            @if (r.Phone.Length > 0)
                                            {
                                                @if (r.PhoneConfirmed) { <i class="fa fa-check-circle" style="color:#0A0" title="Confirmed"></i> } else { <i class="fa fa-exclamation-triangle" style="color:#F00" title="Not confirmed"></i> }
                                            }
                                        </td>
                                        @foreach (var pv in r.ProfileValues)
                                        {
                                            <td><a href="@href">@pv</a></td>
                                        }
                                        <td><a href="@href">@Stamp(r.TimeRegistered)</a></td>
                                        <td><a href="@href">@(r.TimeLastVisit > 0 ? Stamp(r.TimeLastVisit) : "never")</a></td>
                                        <td><a href="@href">@(r.AdminCreated ? "Yes" : "No")</a></td>
                                        <td style="white-space:nowrap"><a href="@href">@r.Balance.ToString("N2", CultureInfo.InvariantCulture)</a></td>
                                        <td class="text-center">
                                            <form method="post" action="/cp/users/set-unlocked" style="margin:0">
                                                <input type="hidden" name="confirmWrites" value="true" />
                                                <input type="hidden" name="returnUrl" value="@ListHref(l, l.Page)" />
                                                <input type="hidden" name="userId" value="@id" />
                                                <input type="hidden" name="unlocked" value="@(r.Unlocked ? "0" : "1")" />
                                                @if (r.Unlocked)
                                                {
                                                    <button type="submit" class="btn btn-xs btn-success" title="Block"><i class="fa fa-unlock"></i></button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-xs btn-danger" title="Unblock"><i class="fa fa-lock"></i></button>
                                                }
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (l.PageCount > 1)
                    {
                        <ul class="pagination pagination-sm" style="margin:6px 0 0">
                            @for (var p = 1; p <= l.PageCount; p++)
                            {
                                <li class="@(p == l.Page ? "active" : "")"><a href="@ListHref(l, p)">@p.ToString(CultureInfo.InvariantCulture)</a></li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <form id="delete_form" method="post" action="/cp/users/delete" style="display:none">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@ListHref(l, l.Page)" />
            <input type="hidden" name="ids" id="delete_ids" value="" />
        </form>
        <script>
            function on_check_uncheck_all() {
                var on = document.getElementById('check_uncheck_all').checked;
                var boxes = document.querySelectorAll('.epc-user-check');
                for (var i = 0; i < boxes.length; i++) { boxes[i].checked = on; }
            }
            function on_one_check_changed() {
                var boxes = document.querySelectorAll('.epc-user-check');
                var all = boxes.length > 0;
                for (var i = 0; i < boxes.length; i++) { if (!boxes[i].checked) { all = false; break; } }
                document.getElementById('check_uncheck_all').checked = all;
            }
            function checked_ids() {
                var ids = [];
                var boxes = document.querySelectorAll('.epc-user-check:checked');
                for (var i = 0; i < boxes.length; i++) { ids.push(parseInt(boxes[i].value, 10)); }
                return ids;
            }
            function delete_users() {
                var ids = checked_ids();
                if (ids.length === 0) { alert('Select users first.'); return; }
                if (!confirm('Delete ' + ids.length + ' user(s)? Profiles and group bindings are removed too.')) { return; }
                document.getElementById('delete_ids').value = JSON.stringify(ids);
                document.getElementById('delete_form').submit();
            }
        </script>
    }
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/users/usermanager";
    private const string _phpEditTab = "/CP/users/usermanager/user";
    private const int _pageSize = 50;

    private bool _isAdmin;
    private bool _notFound;
    private long _selectedId;
    private CpUserList? _list;
    private CpUserEditor? _editor;
    private string _flashOk = "";
    private string _flashErr = "";

    private static string EditorHref(long userId) => "/cp/users-app?user_id=" + userId.ToString(CultureInfo.InvariantCulture);

    private static string Stamp(long unix) => unix <= 0 ? "—" : DateTimeOffset.FromUnixTimeSeconds(unix).ToString("dd.MM.yyyy HH:mm:ss", CultureInfo.InvariantCulture);

    private static string FilterFieldValue(CpUserList l, string name)
        => l.Filter.Fields is not null && l.Filter.Fields.TryGetValue(name, out var v) ? v : "";

    private static string ListHref(CpUserList l, int page, string? sort = null, bool? asc = null)
    {
        var parts = new List<string>();
        var s = sort ?? l.SortField;
        var a = asc ?? l.SortAsc;
        if (s != "user_id") parts.Add("sort=" + Uri.EscapeDataString(s));
        if (!a) parts.Add("dir=desc");
        if (page > 1) parts.Add("s_page=" + page.ToString(CultureInfo.InvariantCulture));
        if (l.Filter.UserId.Length > 0) parts.Add("f_user_id=" + Uri.EscapeDataString(l.Filter.UserId));
        if (l.Filter.GroupId >= 0) parts.Add("f_group_id=" + l.Filter.GroupId.ToString(CultureInfo.InvariantCulture));
        if (l.Filter.Email.Length > 0) parts.Add("f_email=" + Uri.EscapeDataString(l.Filter.Email));
        if (l.Filter.Phone.Length > 0) parts.Add("f_phone=" + Uri.EscapeDataString(l.Filter.Phone));
        if (l.Filter.Unlocked >= 0) parts.Add("f_unlocked=" + l.Filter.Unlocked.ToString(CultureInfo.InvariantCulture));
        if (l.Filter.Fields is not null)
        {
            foreach (var kv in l.Filter.Fields.Where(kv => kv.Value.Length > 0))
            {
                parts.Add("ff_" + Uri.EscapeDataString(kv.Key) + "=" + Uri.EscapeDataString(kv.Value));
            }
        }

        return parts.Count == 0 ? "/cp/users-app" : "/cp/users-app?" + string.Join("&", parts);
    }

    private static RenderFragment SortLink(CpUserList l, string field, string caption) => builder =>
    {
        var active = l.SortField == field;
        var nextAsc = !active || !l.SortAsc;
        builder.OpenElement(0, "a");
        builder.AddAttribute(1, "class", "epc_sorter");
        builder.AddAttribute(2, "href", ListHref(l, 1, field, nextAsc));
        builder.AddContent(3, caption);
        if (active)
        {
            builder.OpenElement(4, "i");
            builder.AddAttribute(5, "class", l.SortAsc ? "fa fa-sort-asc" : "fa fa-sort-desc");
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private static RenderFragment RenderGroupTree(CpUserEditor e, long parent) => builder =>
    {
        var children = e.Groups.Where(g => g.Parent == parent && g.Id != parent).OrderBy(g => g.Id).ToList();
        if (children.Count == 0) return;
        builder.OpenElement(0, "ul");
        var seq = 1;
        foreach (var g in children)
        {
            builder.OpenElement(seq++, "li");
            builder.OpenElement(seq++, "label");
            builder.AddAttribute(seq++, "style", "font-weight:normal;cursor:pointer");
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "checkbox");
            builder.AddAttribute(seq++, "class", "epc-group-check");
            builder.AddAttribute(seq++, "value", g.Id.ToString(CultureInfo.InvariantCulture));
            builder.AddAttribute(seq++, "checked", e.GroupIds.Contains(g.Id));
            builder.CloseElement();
            builder.AddContent(seq++, " " + g.Value);
            if (g.ForRegistrated) { builder.OpenElement(seq++, "i"); builder.AddAttribute(seq++, "class", "fa fa-check text-success"); builder.AddAttribute(seq++, "title", "Registered users"); builder.CloseElement(); }
            if (g.ForGuests) { builder.OpenElement(seq++, "i"); builder.AddAttribute(seq++, "class", "fa fa-user-o"); builder.AddAttribute(seq++, "title", "Guests"); builder.CloseElement(); }
            if (g.ForBackend) { builder.OpenElement(seq++, "i"); builder.AddAttribute(seq++, "class", "fa fa-shield text-primary"); builder.AddAttribute(seq++, "title", "Backend"); builder.CloseElement(); }
            if (!g.Unblocked) { builder.OpenElement(seq++, "i"); builder.AddAttribute(seq++, "class", "fa fa-lock text-danger"); builder.AddAttribute(seq++, "title", "Blocked"); builder.CloseElement(); }
            builder.CloseElement();
            builder.AddContent(seq++, RenderGroupTree(e, g.Id));
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private static string RegFieldsJson(CpUserEditor e)
    {
        var items = e.Fields.Select(f => new
        {
            name = f.Name,
            caption = f.Caption,
            show_for = ParseIntArray(f.ShowFor),
            required_for = ParseIntArray(f.RequiredFor),
            maxlen = f.MaxLen,
            regexp = f.Regexp,
            widget_type = f.WidgetType,
            value_buffer = e.Profile.TryGetValue(f.Name, out var v) ? v : ""
        });
        return JsonSerializer.Serialize(items);
    }

    private static int[] ParseIntArray(string json)
    {
        try
        {
            return JsonSerializer.Deserialize<int[]>(json) ?? [];
        }
        catch (JsonException)
        {
            return [];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var q = ctx.Request.Query;
        _flashOk = q["ok"].ToString() ?? "";
        _flashErr = q["err"].ToString() ?? "";
        _selectedId = ErpRecordOpen.ReadId(ctx.Request, "user_id");
        var isNew = q["new"].ToString() == "1";
        var page = int.TryParse(q["s_page"], NumberStyles.Integer, CultureInfo.InvariantCulture, out var p) && p > 0 ? p : 1;
        var sort = q["sort"].ToString();
        var asc = q["dir"].ToString() != "desc";
        var fields = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var key in q.Keys.Where(k => k.StartsWith("ff_", StringComparison.Ordinal)))
        {
            fields[key[3..]] = (q[key].ToString() ?? "").Trim();
        }

        var filter = new CpUserFilter(
            (q["f_user_id"].ToString() ?? "").Trim(),
            long.TryParse(q["f_group_id"], NumberStyles.Integer, CultureInfo.InvariantCulture, out var gid) ? gid : -1,
            (q["f_email"].ToString() ?? "").Trim(),
            (q["f_phone"].ToString() ?? "").Trim(),
            int.TryParse(q["f_unlocked"], NumberStyles.Integer, CultureInfo.InvariantCulture, out var ul) ? ul : -1,
            fields);

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        if (_selectedId > 0 || isNew)
        {
            _editor = await Users.OpenAsync(_selectedId, ctx.RequestAborted);
            if (_editor is not null)
            {
                return;
            }

            _notFound = _selectedId > 0;
        }

        _list = await Users.ListAsync(page, _pageSize, string.IsNullOrWhiteSpace(sort) ? "user_id" : sort, asc, filter, ctx.RequestAborted);
    }
}
