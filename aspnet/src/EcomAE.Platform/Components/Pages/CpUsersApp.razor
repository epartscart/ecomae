@page "/cp/users-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Users · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <PhpCpModulePageHeader Title="Users"
                           Subtitle="Manage storefront accounts, unlock status, and partner logins (PHP users module presentation)."
                           PhpTabHref="/CP/control/users">
        <a class="ghost" href="/cp/groups-app">Groups list</a>
    </PhpCpModulePageHeader>

    <div class="epc-scp-kpi" aria-label="Users KPIs">
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Shown (limit @_limit)</div>
            <div class="epc-scp-kpi__val">@_users.Count</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Unlocked in page</div>
            <div class="epc-scp-kpi__val">@_unlocked</div>
        </div>
    </div>

    <div class="epc-scp-table-card">
        <table class="epc-scp-data-table table table-epc-pro">
            <thead>
                <tr>
                    <th>User ID</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Unlocked</th>
                    <th>Registered</th>
                    <th>Last visit</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_users.Count == 0)
                {
                    <tr><td colspan="7">@(string.IsNullOrWhiteSpace(_message) ? "Nothing to show yet." : _message)@if (!string.IsNullOrWhiteSpace(_source) && _source != "n/a") { <text> (source=@_source)</text> }</td></tr>
                }
                else
                {
                    @foreach (var u in _users)
                    {
                        var phpHref = $"/CP/control/users?user_id={u.UserId.ToString(CultureInfo.InvariantCulture)}";
                        <tr>
                            <td><strong>@u.UserId</strong></td>
                            <td>@u.Email</td>
                            <td>@(string.IsNullOrWhiteSpace(u.Phone) ? "—" : u.Phone)</td>
                            <td>
                                @if (u.Unlocked == 1)
                                {
                                    <span class="epc-scp-badge epc-scp-badge--ok">Yes</span>
                                }
                                else
                                {
                                    <span class="epc-scp-badge epc-scp-badge--off">No</span>
                                }
                            </td>
                            <td>@FormatTime(u.TimeRegistered)</td>
                            <td>@FormatTime(u.TimeLastVisit)</td>
                            <td class="epc-scp-actions-cell"><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(phpHref)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private bool _isAdmin;
    private IReadOnlyList<CpUserDigest> _users = [];
    private int _unlocked;
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListCpUsersAsync(_limit, ctx.RequestAborted);
        _users = result.Users;
        _unlocked = _users.Count(u => u.Unlocked == 1);
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
