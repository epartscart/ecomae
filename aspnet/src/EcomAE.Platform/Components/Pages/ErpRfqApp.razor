@page "/erp/rfq-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>RFQs · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="RFQs" BreadcrumbArea="Procure to Pay" BreadcrumbTab="RFQ">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/rfq-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="RFQs" Subtitle="Open a row for the 280-character description excerpt. Save stays on the Classic twin." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="RFQs KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_rfqs.Count</div></div>
        <div class="kpi"><div class="lbl">Digest source</div><div class="val">@_source</div></div>
        <div class="kpi"><div class="lbl">Session</div><div class="val">@(_isAdmin ? "live" : "guest")</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>RFQ #</dt><dd>@(string.IsNullOrWhiteSpace(_opened.RfqNo) ? "—" : _opened.RfqNo)</dd>
                <dt>Title</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Title) ? "—" : _opened.Title)</dd>
                <dt>Supplier</dt><dd>@(_opened.SupplierId > 0 ? _opened.SupplierId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Est. amount</dt><dd>@_opened.AmountEst.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Currency</dt><dd>@(string.IsNullOrWhiteSpace(_opened.CurrencyCode) ? "—" : _opened.CurrencyCode)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Status) ? "—" : _opened.Status)</dd>
                <dt>Due</dt><dd>@FormatTime(_opened.DueDate)</dd>
                <dt>Order</dt><dd>@(_opened.OrderId > 0 ? _opened.OrderId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Updated</dt><dd>@(_opened.TimeUpdated > 0 ? _opened.TimeUpdated.ToString(CultureInfo.InvariantCulture) : "—")</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Save stays on the Classic twin.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.DescriptionExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">description excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.DescriptionExcerpt</pre>
                @if (_opened.DescriptionLen > _opened.DescriptionExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.DescriptionExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.DescriptionLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No description excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>RFQ #</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.RfqNo) ? "—" : sib.RfqNo)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Title) ? "—" : sib.Title)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "rfq_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>RFQ #</th>
                    <th>Supplier</th>
                    <th>Title</th>
                    <th>Est. amount</th>
                    <th>CCY</th>
                    <th>Status</th>
                    <th>Due</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rfqs.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _rfqs)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(row.RfqNo) ? $"#{row.Id}" : row.RfqNo)</strong></td>
                            <td>@(row.SupplierId > 0 ? row.SupplierId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Title) ? $"#{row.Id}" : row.Title)</strong></td>
                            <td>@row.AmountEst.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.CurrencyCode) ? "—" : row.CurrencyCode)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td>@FormatTime(row.DueDate)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "rfq_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">@_message</div>
    }

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=purchasing&tab=rfq";
    private const string _listHref = "/erp/rfq-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpRfqDigest> _rfqs = [];
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpRfqDetail? _opened;
    private IReadOnlyList<ErpRfqDigest> _openedSiblings = [];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.RfqNo)
            ? _opened.RfqNo
            : (!string.IsNullOrWhiteSpace(_opened.Title)
                ? _opened.Title
                : ("RFQ #" + _opened.Id.ToString(CultureInfo.InvariantCulture))));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?rfq_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "rfq_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpRfqsAsync(_limit, ctx.RequestAborted);
        _rfqs = result.Rfqs;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpRfqDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Rfq;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _rfqs.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rfqs = new[] { openedList }.Concat(_rfqs.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
