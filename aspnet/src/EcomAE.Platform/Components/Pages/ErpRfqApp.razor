@page "/erp/rfq-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Components.Shared.Desktop
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Middleware
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav
@inject IErpDimensionCatalogReadService DimensionCatalog
@inject IErpDimensionLinkReadService DimensionLinks
@inject ICpCsrfGuard Csrf

<PageTitle>RFQs · ERP · eParts Cart</PageTitle>
<HeadContent>
    <style>
        .epc-rfq-create{margin:0 0 14px;padding:16px 18px;border:1px solid #bfdbfe;border-radius:14px;background:#f8fbff;box-shadow:0 10px 24px rgba(15,23,42,.06);}
        .epc-rfq-create h2{margin:0 0 6px;color:#1e3a8a;font-size:18px;font-weight:800;}
        .epc-rfq-create p{margin:0 0 12px;max-width:52rem;color:#475569;font-size:13px;line-height:1.5;}
        .epc-rfq-create form{display:flex;flex-wrap:wrap;gap:.45rem;align-items:end;margin:0;}
        .epc-rfq-empty{margin:0 0 14px;padding:28px 18px;border:1px dashed #93c5fd;border-radius:14px;background:#f8fbff;text-align:center;}
        .epc-rfq-empty h3{margin:0 0 6px;color:#1e3a8a;font-size:16px;font-weight:800;}
        .epc-rfq-empty p{margin:0 0 12px;color:#475569;font-size:13px;}
        .epc-rfq-chip{display:inline-flex;align-items:center;padding:4px 9px;border:1px solid #cbd5e1;border-radius:999px;background:#fff;color:#1d4ed8;font-size:11px;font-weight:700;}
    </style>
</HeadContent>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="RFQs" BreadcrumbArea="Procure to Pay" BreadcrumbTab="RFQ">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/rfq-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="RFQs" Subtitle="Create and edit supplier requests for quotation. Unsupported workflow actions are not available on this page." PhpTabHref="@_phpTab" />
    <ErpManualProcessStrip Keys="purchase" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    @if (_follow.HasValues)
    {
        <div class="alert alert-info" role="status" style="margin:0 0 12px;padding:.7rem .9rem">Process follow: @_follow.Banner. Matching fields are filled on the form.</div>
    }
    @if (_companyId > 0)
    {
        <p style="margin:0 0 12px"><span class="epc-rfq-chip">Company @_companyId.ToString(CultureInfo.InvariantCulture)</span></p>
    }

    @if (_isAdmin)
    {
        <section class="epc-rfq-create" aria-labelledby="epc-rfq-create-title">
            <h2 id="epc-rfq-create-title">New request for quotation</h2>
            <p>Create an RFQ header for a supplier. Open a saved row to edit, collect responses, and award a draft purchase order.</p>
            <form id="erp-rfq-new" method="post" action="@Href("/erp/ajax/save-rfq")">
                <input type="hidden" name="returnUrl" value="@_listHref" />
                <input type="hidden" name="id" value="0" />
                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                <ErpMasterPicker Kind="supplier" FieldName="supplier_id" Label="Supplier" />
                <label>Title <input type="text" name="title" required maxlength="255" value="@_follow.Name" /></label>
                <label>Estimate <input type="text" name="amount_est" value="@(_follow.Amount != 0 ? _follow.Amount.ToString("0.00", CultureInfo.InvariantCulture) : "0.00")" /></label>
                <label>Status
                    <select name="status">
                        @foreach (var status in RfqStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </label>
                <label>Due <input type="date" name="due_date" /></label>
                <label>Order <input type="number" name="order_id" min="0" value="0" /></label>
                <label>Description <input type="text" name="description" maxlength="4000" value="@_follow.Note" /></label>
                <button type="submit" name="confirmWrites" value="true" class="btn btn-primary btn-sm">Save RFQ</button>
            </form>
        </section>
    }

    @if (_isAdmin && _rfqs.Count == 0)
    {
        <section class="epc-rfq-empty" aria-labelledby="epc-rfq-empty-title">
            <h3 id="epc-rfq-empty-title">No RFQs yet</h3>
            <p>Use the form above to save the first supplier request for quotation. The list stays empty until a header is saved.</p>
            <a class="btn btn-primary btn-sm" href="#erp-rfq-new">Create RFQ</a>
        </section>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="RFQs KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_rfqs.Count</div></div>
        <div class="kpi"><div class="lbl">Digest source</div><div class="val">@_source</div></div>
        <div class="kpi"><div class="lbl">Session</div><div class="val">@(_isAdmin ? "live" : "guest")</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <ErpDocumentWorkspace
                DocumentKind="Request for quotation"
                Title="@(_opened.RfqNo is { Length: > 0 } ? _opened.RfqNo : $"RFQ #{_opened.Id}")"
                DocumentNumber="@_opened.Id.ToString(CultureInfo.InvariantCulture)"
                PartyLabel="Supplier"
                Party="@FormatId(_opened.SupplierId)"
                ReferenceLabel="Source order"
                Reference="@FormatId(_opened.OrderId)"
                Status="@(_opened.Status is { Length: > 0 } ? _opened.Status : "draft")"
                ApprovalState="@(_opened.DueDate > 0 ? $"Due {FormatTime(_opened.DueDate)}" : "No due date")"
                CompanyContext="Tenant / company"
                Currency="@(_opened.CurrencyCode is { Length: > 0 } ? _opened.CurrencyCode : "AED")"
                Subtotal="@_opened.AmountEst"
                Total="@_opened.AmountEst"
                BalanceDue="0"
                Fields="@RfqWorkspaceFields"
                Lines="@RfqWorkspaceLines"
                Tabs="@RfqWorkspaceTabs"
                HeaderActions="@RfqHeaderActions" />
            <p class="text-muted" style="margin:.85rem 0 0">RFQ saves use the guarded live write path. When SCM lines exist, the workspace reads their persisted request quantities and target prices without creating or mutating the existing schema.</p>
            <ErpDimensionLinksPanel Links="_openedDimensionLinks" />
            @if (_isAdmin && _opened.Lines.Count > 0)
            {
                <form method="post" action="@Href("/erp/ajax/save-rfq-response")" class="epc-erp-form" style="margin-top:1rem">
                    <input type="hidden" name="rfq_id" value="@_opened.Id" />
                    <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                    <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
                    <div class="epc-form-grid">
                        <label>RFQ line
                            <select name="rfq_line_id" required>
                                @foreach (var line in _opened.Lines)
                                {
                                    <option value="@line.Id">@line.Description (@line.Qty.ToString("N2", CultureInfo.InvariantCulture))</option>
                                }
                            </select>
                        </label>
                        <ErpMasterPicker Kind="supplier" FieldName="supplier_id" Label="Supplier" Required="true" Min="1" />
                        <label>Unit price<input type="number" name="unit_price" min="0" step="0.0001" required /></label>
                        <label>Lead time days<input type="number" name="lead_time_days" min="0" value="0" required /></label>
                        <label>Notes<input name="notes" maxlength="1000" /></label>
                    </div>
                    <label style="display:flex;align-items:flex-start;gap:.45rem;margin-top:.75rem">
                        <input type="checkbox" name="confirmWrites" value="true" required />
                        <span>I confirm this supplier response is ready to be persisted in the SCM response table.</span>
                    </label>
                    <div class="epc-button-row" style="margin-top:.75rem">
                        <button class="btn btn-primary" type="submit">Save supplier response</button>
                    </div>
                </form>
            }
            @if (_opened.Responses is { Count: > 0 })
            {
                <div class="epc-erp-kpi epc-erp-stat-row" aria-label="RFQ comparison recommendation" style="margin-top:1rem">
                    <div class="kpi">
                        <div class="lbl">Comparison recommendation</div>
                        <div class="val">@(_opened.RecommendedSupplierId > 0 ? $"Supplier {_opened.RecommendedSupplierId.ToString(CultureInfo.InvariantCulture)}" : "No recommendation")</div>
                    </div>
                    <div class="kpi">
                        <div class="lbl">Award state</div>
                        <div class="val">open</div>
                    </div>
                </div>
                <p class="text-muted" style="margin:1rem 0 .4rem">Persisted supplier responses (comparison read-only)</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead><tr><th>Line</th><th>Supplier</th><th class="text-right">Unit price</th><th class="text-right">Line total</th><th class="text-right">Lead days</th><th>Notes</th></tr></thead>
                    <tbody>
                        @foreach (var response in _opened.Responses)
                        {
                            <tr>
                                <td>@response.Description</td>
                                <td>@response.SupplierId.ToString(CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@response.UnitPrice.ToString("N4", CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@response.LineTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                                <td class="text-right">@response.LeadTimeDays.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@(string.IsNullOrWhiteSpace(response.Notes) ? "—" : response.Notes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_opened.SupplierRanking is { Count: > 0 })
                {
                    <p class="text-muted" style="margin:1rem 0 .4rem">Supplier ranking by quoted value</p>
                    <table class="table table-bordered table-condensed table-epc epc-erp-table">
                        <thead><tr><th>Rank</th><th>Supplier</th><th class="text-right">Quoted total</th></tr></thead>
                        <tbody>
                            @{ var rank = 0; }
                            @foreach (var supplier in _opened.SupplierRanking)
                            {
                                rank++;
                                <tr>
                                    <td>@rank.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@supplier.SupplierId.ToString(CultureInfo.InvariantCulture)</td>
                                    <td class="text-right">@supplier.TotalQuoted.ToString("N2", CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (_opened.BestQuotes is { Count: > 0 })
                {
                    <p class="text-muted" style="margin:1rem 0 .4rem">Best supplier per RFQ line</p>
                    <table class="table table-bordered table-condensed table-epc epc-erp-table">
                        <thead><tr><th>Line</th><th>Supplier</th><th class="text-right">Unit price</th><th class="text-right">Line total</th><th class="text-right">Lead days</th></tr></thead>
                        <tbody>
                            @foreach (var quote in _opened.BestQuotes)
                            {
                                var line = _opened.Lines.FirstOrDefault(item => item.Id == quote.RfqLineId);
                                <tr>
                                    <td>@(line is null ? $"Line {quote.RfqLineId.ToString(CultureInfo.InvariantCulture)}" : line.Description)</td>
                                    <td>@quote.SupplierId.ToString(CultureInfo.InvariantCulture)</td>
                                    <td class="text-right">@quote.UnitPrice.ToString("N4", CultureInfo.InvariantCulture)</td>
                                    <td class="text-right">@quote.LineTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td class="text-right">@quote.LeadTimeDays.ToString(CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (_opened.AwardPreview is { } awardPreview)
                {
                    <p class="text-muted" style="margin:1rem 0 .4rem">Read-only draft PO preview for recommended supplier</p>
                    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="RFQ draft purchase order preview">
                        <div class="kpi">
                            <div class="lbl">Supplier</div>
                            <div class="val">@awardPreview.SupplierId.ToString(CultureInfo.InvariantCulture)</div>
                        </div>
                        <div class="kpi">
                            <div class="lbl">Quoted lines</div>
                            <div class="val">@($"{awardPreview.QuotedLineCount.ToString(CultureInfo.InvariantCulture)} / {awardPreview.RfqLineCount.ToString(CultureInfo.InvariantCulture)}")</div>
                        </div>
                        <div class="kpi">
                            <div class="lbl">Preview total ex VAT</div>
                            <div class="val">@awardPreview.TotalEx.ToString("N2", CultureInfo.InvariantCulture)</div>
                        </div>
                    </div>
                    <table class="table table-bordered table-condensed table-epc epc-erp-table">
                        <thead><tr><th>Line</th><th class="text-right">Qty</th><th class="text-right">Unit cost ex VAT</th><th class="text-right">Line ex VAT</th></tr></thead>
                        <tbody>
                            @foreach (var line in awardPreview.Lines)
                            {
                                <tr>
                                    <td>@line.Description</td>
                                    <td class="text-right">@line.Qty.ToString("N2", CultureInfo.InvariantCulture)</td>
                                    <td class="text-right">@line.UnitPrice.ToString("N4", CultureInfo.InvariantCulture)</td>
                                    <td class="text-right">@line.LineTotal.ToString("N2", CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="text-muted">This preview uses only persisted responses. Awarding creates a draft purchase order through the existing ERP PO writer, then records the award on the existing SCM RFQ row.</p>
                    @if (_isAdmin && awardPreview.QuotedLineCount == awardPreview.RfqLineCount && !string.Equals(_opened.Status, "awarded", StringComparison.OrdinalIgnoreCase))
                    {
                        <form method="post" action="@Href("/erp/ajax/award-rfq")" class="epc-erp-form" style="margin-top:1rem">
                            <input type="hidden" name="rfq_id" value="@_opened.Id" />
                            <input type="hidden" name="supplier_id" value="@awardPreview.SupplierId" />
                            <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                            <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
                            <label style="display:flex;align-items:flex-start;gap:.45rem">
                                <input type="checkbox" name="confirmWrites" value="true" required />
                                <span>I confirm this supplier selection and authorize creation of a draft purchase order.</span>
                            </label>
                            <div class="epc-button-row" style="margin-top:.75rem">
                                <button class="btn btn-primary" type="submit">Award RFQ and create draft PO</button>
                            </div>
                        </form>
                    }
                }
                <p class="text-muted">Supplier responses use the guarded insert above. Awarding is guarded and requires complete quoted-line coverage plus explicit confirmation.</p>
            }
            @if (!string.IsNullOrWhiteSpace(_opened.DescriptionExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">description excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.DescriptionExcerpt</pre>
                @if (_opened.DescriptionLen > _opened.DescriptionExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.DescriptionExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.DescriptionLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No description excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>RFQ #</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.RfqNo) ? "—" : sib.RfqNo)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Title) ? "—" : sib.Title)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "rfq_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>RFQ #</th>
                    <th>Supplier</th>
                    <th>Title</th>
                    <th>Est. amount</th>
                    <th>CCY</th>
                    <th>Status</th>
                    <th>Due</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rfqs.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? "No records yet." : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _rfqs)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(row.RfqNo) ? $"#{row.Id}" : row.RfqNo)</strong></td>
                            <td>@(row.SupplierId > 0 ? row.SupplierId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Title) ? $"#{row.Id}" : row.Title)</strong></td>
                            <td>@row.AmountEst.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.CurrencyCode) ? "—" : row.CurrencyCode)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td>@FormatTime(row.DueDate)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "rfq_id", row.Id)">Open</a></td>
                        </tr>
                    }
                    <tr style="font-weight:600;background:#f2f6fa">
                        <td>Total</td>
                        <td colspan="2"></td>
                        <td>@_rfqs.Sum(r => r.AmountEst).ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td colspan="4" class="text-muted">@_rfqs.Count RFQs</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">@_message</div>
    }

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=purchasing&tab=rfq";
    private string _listHref = "/erp/rfq-app";
    private bool _isAdmin;
    private long _companyId;
    private string _csrf = "";
    private ErpD365FollowPrefill _follow = new("", 0, "", "", "", "", "", 0, 0, "");
    private IReadOnlyList<ErpRfqDigest> _rfqs = [];
    private IReadOnlyList<ErpDimensionCatalog> _dimensionCatalog = [];
    private IReadOnlyList<ErpDimensionLink> _openedDimensionLinks = [];
    private bool IsDimensionSelected(string key, long valueId)
        => _openedDimensionLinks.Any(link => string.Equals(link.Key, key, StringComparison.OrdinalIgnoreCase) && link.ValueId == valueId);
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpRfqDetail? _opened;
    private IReadOnlyList<ErpRfqDigest> _openedSiblings = [];

    private IReadOnlyList<string> RfqWorkspaceTabs =>
        ["General", "Supplier", "Delivery", "Lines", "Financial"];

    private IReadOnlyList<ErpDocumentWorkspaceField> RfqWorkspaceFields => _opened is null
        ? []
        : [
            new("RFQ id", _opened.Id.ToString(CultureInfo.InvariantCulture), "General"),
            new("RFQ number", string.IsNullOrWhiteSpace(_opened.RfqNo) ? "—" : _opened.RfqNo, "General"),
            new("Title", string.IsNullOrWhiteSpace(_opened.Title) ? "—" : _opened.Title, "General"),
            new("Updated", FormatTime(_opened.TimeUpdated), "General"),
            new("Supplier", FormatId(_opened.SupplierId), "Operational"),
            new("Source order", FormatId(_opened.OrderId), "Operational"),
            new("Due date", FormatTime(_opened.DueDate), "Delivery"),
            new("Description", _opened.DescriptionLen > 0 ? $"{_opened.DescriptionLen.ToString(CultureInfo.InvariantCulture)} chars" : "None", "Financial")
        ];

    private IReadOnlyList<ErpDocumentWorkspaceLine> RfqWorkspaceLines => (_opened?.Lines ?? [])
        .Select(line => new ErpDocumentWorkspaceLine(
            line.Id.ToString(CultureInfo.InvariantCulture),
            string.IsNullOrWhiteSpace(line.Description) ? $"Item {line.ItemId}" : line.Description,
            line.Qty,
            line.Unit,
            "RFQ",
            line.ItemId.ToString(CultureInfo.InvariantCulture),
            line.TargetPrice,
            0,
            0,
            line.Qty * line.TargetPrice,
            0,
            "Target price"))
        .ToArray() ?? [];

    private RenderFragment? RfqHeaderActions => _isAdmin && _opened is not null
        ? @<div>
            <strong>RFQ lifecycle</strong>
            <form method="post" action="@Href("/erp/ajax/save-rfq")">
                <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
                <input type="hidden" name="id" value="@_opened.Id" />
                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                <ErpMasterPicker Kind="supplier" FieldName="supplier_id" Label="Supplier" Value="@_opened.SupplierId" />
                <label>Title <input type="text" name="title" required maxlength="255" value="@_opened.Title" /></label>
                <label>Estimate <input type="text" name="amount_est" value="@_opened.AmountEst.ToString("0.00", CultureInfo.InvariantCulture)" /></label>
                <label>Status
                    <select name="status">
                        @foreach (var status in RfqStatuses)
                        {
                            <option value="@status" selected="@string.Equals(status, _opened.Status, StringComparison.OrdinalIgnoreCase)">@status</option>
                        }
                    </select>
                </label>
                <label>Due <input type="date" name="due_date" value="@FormatDateInput(_opened.DueDate)" /></label>
                <label>Order <input type="number" name="order_id" min="0" value="@_opened.OrderId" /></label>
                <label>Description <input type="text" name="description" maxlength="4000" value="@_opened.DescriptionExcerpt" /></label>
                @foreach (var dimension in _dimensionCatalog)
                {
                    <label>@dimension.Label
                        <select name="dim[@dimension.Key]" style="min-width:10rem">
                            <option value="0" selected="@IsDimensionSelected(dimension.Key, 0)">— none —</option>
                            @foreach (var option in dimension.Options)
                            {
                                <option value="@option.Id" selected="@IsDimensionSelected(dimension.Key, option.Id)">@option.Code · @option.Name</option>
                            }
                        </select>
                    </label>
                }
                <button type="submit" name="confirmWrites" value="false" class="btn btn-xs btn-default">Validate</button>
                <button type="submit" name="confirmWrites" value="true" class="btn btn-xs btn-primary">Save RFQ</button>
            </form>
        </div>
        : null;

    private static readonly string[] RfqStatuses = ["draft", "sent", "quoted", "accepted", "rejected", "cancelled"];

    private string Href(string path) => ClientErpPath.PrefixIfBound(Http.HttpContext, path);

    private static bool IsSchemaGap(string? message)
        => !string.IsNullOrWhiteSpace(message)
           && (message.Contains("doesn't exist", StringComparison.OrdinalIgnoreCase)
               || message.Contains("does not exist", StringComparison.OrdinalIgnoreCase)
               || message.Contains("Unknown table", StringComparison.OrdinalIgnoreCase));

    private static string FormatId(long id) => id > 0
        ? id.ToString(CultureInfo.InvariantCulture)
        : "—";

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.RfqNo)
            ? _opened.RfqNo
            : (!string.IsNullOrWhiteSpace(_opened.Title)
                ? _opened.Title
                : ("RFQ #" + _opened.Id.ToString(CultureInfo.InvariantCulture))));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + (_listHref.Contains('?', StringComparison.Ordinal) ? "&" : "?")
            + "rfq_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _listHref = "/erp/rfq-app";
        if (ctx.Items.TryGetValue(ClientErpPathRewriteMiddleware.OriginalPathItem, out var original)
            && original is string originalPath
            && originalPath.Contains("rfq-app", StringComparison.OrdinalIgnoreCase))
        {
            _listHref = originalPath.Split('?', 2)[0];
        }
        else
        {
            _listHref = Href("/erp/rfq-app");
        }

        long.TryParse(
            ctx.Request.Query["company"].FirstOrDefault()
            ?? ctx.Request.Query["company_id"].FirstOrDefault()
            ?? ctx.Request.Query["companyId"].FirstOrDefault(),
            NumberStyles.Integer,
            CultureInfo.InvariantCulture,
            out _companyId);
        if (_companyId > 0)
        {
            _listHref += (_listHref.Contains('?', StringComparison.Ordinal) ? "&" : "?")
                + "company=" + _companyId.ToString(CultureInfo.InvariantCulture);
        }

        _follow = ErpD365FollowPrefill.Read(ctx.Request);
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "rfq_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        _csrf = _isAdmin ? await Csrf.KeyForAsync(ctx, session, ctx.RequestAborted) : "";
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpRfqsAsync(_limit, ctx.RequestAborted);
        _rfqs = result.Rfqs;
        _source = result.Source;
        _message = IsSchemaGap(result.Message) ? string.Empty : result.Message;
        _dimensionCatalog = await DimensionCatalog.LoadAsync(100, ctx.RequestAborted);

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpRfqDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Rfq;
            _openedSiblings = detail.Siblings;
            _openedDimensionLinks = await DimensionLinks.LoadAsync("rfq", _openedId, ctx.RequestAborted);
            if (_opened is not null)
            {
                var openedList = _rfqs.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rfqs = new[] { openedList }.Concat(_rfqs.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }

    private static string FormatDateInput(long unix)
    {
        if (unix <= 0) return string.Empty;
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
