@page "/cp/jewellery-stock-verification-app"
@page "/erp/jewellery-stock-verification-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Jewellery stock verification · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="@_spec.Title" BreadcrumbArea="Jewellery" BreadcrumbTab="@_spec.Label">
    <PhpErpModulePageHeader Title="@_spec.Title" Subtitle="@_spec.Subtitle" />
    <ErpPhpFlash Ok="@_ok" Err="@_err" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Jewellery stock verification stats">
        <div class="kpi"><div class="lbl">Verifications</div><div class="val">@_summary.VerificationCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">In progress</div><div class="val">@_summary.InProgressCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Complete</div><div class="val">@_summary.CompleteCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Lines</div><div class="val">@_summary.LineCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <ErpPhpViewTabs QueryName="tab" Active="@_tab" BaseHref="@_tabBase" Tabs="@ErpJewelleryModuleChrome.StockTabs" />

    @if (_isAdmin && _tab == "jw_stock_verification")
    {
        <ErpPhpCreateWell Title="New Count">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryModuleSaveForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="returnUrl" value="@_returnHere" />
                <input type="hidden" name="action" value="jw_stock_verification_save" />
                <label>Branch <input class="form-control input-sm" name="branch" value="HO" /></label>
                <label>Location <input class="form-control input-sm" name="code" placeholder="Showroom" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin)
    {
        <ErpPhpCreateWell Title="@("New " + _spec.Label)">
            <form method="post" action="@EcomAeRoutes.ErpJewelleryModuleSaveForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="returnUrl" value="@_returnHere" />
                <input type="hidden" name="action" value="@(_tab + "_save")" />
                <label>Item Code <input class="form-control input-sm" name="code" required /></label>
                <label>Metal
                    <select class="form-control input-sm" name="metal">
                        <option value="Gold">Gold</option>
                        <option value="Silver">Silver</option>
                    </select>
                </label>
                <label>Karat <input class="form-control input-sm" name="karat" placeholder="22" style="width:70px;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
            </form>
        </ErpPhpCreateWell>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    @foreach (var col in _spec.Columns)
                    {
                        <th>@col</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (_tab == "jw_stock_verification" && _display.Count > 0)
                {
                    @foreach (var row in _display)
                    {
                        <tr>
                            <td>@row.Id</td>
                            <td>@row.Branch</td>
                            <td>@row.Type</td>
                            <td>@row.Date</td>
                            <td>@row.No</td>
                            <td>@row.Location</td>
                            <td>@row.Total</td>
                            <td>@row.Scanned</td>
                            <td>@row.Status</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="@_spec.Columns.Count" class="text-muted">@(_isAdmin ? _spec.EmptyCopy : "Sign in with ERP or Control Panel capability for live rows.")</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. Counts bind from <code>epc_jewel_stock_verification</code>. Form posts are dry-run — writes=0.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private int _company;
    private string _tab = "jw_stock_verification";
    private string _appPath = "/cp/jewellery-stock-verification-app";
    private string _tabBase = "/cp/jewellery-stock-verification-app";
    private string _returnHere = "/cp/jewellery-stock-verification-app?tab=jw_stock_verification";
    private ErpJewelleryModuleChrome.TabSpec _spec = ErpJewelleryModuleChrome.StockSpec("jw_stock_verification");
    private CpJewelleryStockVerificationSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<StockRow> _display = [];
    private string _source = "n/a";
    private string _message = "";
    private string _ok = "";
    private string _err = "";

    private sealed record StockRow(string Id, string Branch, string Type, string Date, string No, string Location, string Total, string Scanned, string Status);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var path = ctx.Request.Path.Value ?? "/cp/jewellery-stock-verification-app";
        _appPath = path.StartsWith("/erp/", StringComparison.OrdinalIgnoreCase)
            ? "/erp/jewellery-stock-verification-app"
            : "/cp/jewellery-stock-verification-app";
        _company = ErpJewelleryModuleChrome.CompanyFromQuery(ctx.Request.Query["company"].ToString());
        _tab = ErpJewelleryModuleChrome.NormalizeTab(ctx.Request.Query["tab"].ToString(), ErpJewelleryModuleChrome.StockTabs, "jw_stock_verification");
        _ok = ctx.Request.Query["ok"].ToString();
        _err = ctx.Request.Query["err"].ToString();
        _spec = ErpJewelleryModuleChrome.StockSpec(_tab);
        _tabBase = ErpJewelleryModuleChrome.AppHref(_appPath, _company);
        _returnHere = ErpJewelleryModuleChrome.AppHref(_appPath, _company, ("tab", _tab));

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = ErpJewelleryModuleChrome.HasJewelleryStaffAccess(session);
        if (!_isAdmin)
        {
            _message = "Sign in with ERP or Control Panel capability for live rows.";
            return;
        }

        var result = await Dashboards.BuildCpJewelleryStockVerificationDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _source = result.Source;
        _message = result.Message;
        _display = result.Verifications.Select(r => new StockRow(
            r.Id.ToString(CultureInfo.InvariantCulture),
            string.IsNullOrWhiteSpace(r.Branch) ? "—" : r.Branch,
            string.IsNullOrWhiteSpace(r.VocType) ? "—" : r.VocType,
            string.IsNullOrWhiteSpace(r.VocDate) ? "—" : r.VocDate,
            r.VocNo.ToString(CultureInfo.InvariantCulture),
            string.IsNullOrWhiteSpace(r.Location) ? "—" : r.Location,
            r.TotalPcs.ToString(CultureInfo.InvariantCulture),
            r.ScannedPcs.ToString(CultureInfo.InvariantCulture),
            string.IsNullOrWhiteSpace(r.Status) ? "—" : r.Status)).ToList();
    }
}
