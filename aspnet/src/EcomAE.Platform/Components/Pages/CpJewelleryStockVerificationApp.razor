@page "/cp/jewellery-stock-verification-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Jewellery stock verification · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-w17-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0f172a 0%,#1e3a5f 50%,#0ea5e9 100%);
        }
        .epc-w17-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-w17-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-w17-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-w17-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f172a; background:#fff;
        }
        .epc-w17-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-w17-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-w17-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-w17-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-w17-kpi span { color:#64748b; font-size:.78rem; }
        .epc-w17-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-w17-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-w17-table th, .epc-w17-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-w17-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-w17-note { margin-top:1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:.45rem; color:#334155; font-size:.86rem; }
        @@media (max-width:900px){ .epc-w17-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-w17-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Jewellery stock verification</h1>
        <p>Read-only stock verification KPIs + vouchers from <code>/cp/jewellery-stock-verification</code>. Remarks stay on live PHP.</p>
        <div class="epc-w17-cta">
            <a href="@_phpTab">Open PHP</a>
            <a class="ghost" href="@PhpModuleCatalog.HybridWorkspaceHref("/cp/app", _phpTab)">Hybrid workspace</a>
            <a class="ghost" href="/cp/app">Command centre</a>
        </div>
    </section>

    <div class="epc-w17-kpis" aria-label="Jewellery stock verification stats">
        <div class="epc-w17-kpi"><strong>@_summary.VerificationCount.ToString(CultureInfo.InvariantCulture)</strong><span>Verifications</span></div>
        <div class="epc-w17-kpi"><strong>@_summary.InProgressCount.ToString(CultureInfo.InvariantCulture)</strong><span>In progress</span></div>
        <div class="epc-w17-kpi"><strong>@_summary.CompleteCount.ToString(CultureInfo.InvariantCulture)</strong><span>Complete</span></div>
        <div class="epc-w17-kpi"><strong>@_summary.LineCount.ToString(CultureInfo.InvariantCulture)</strong><span>Lines</span></div>
    </div>

    <div class="epc-w17-table-wrap">
    <table class="epc-w17-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Branch</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>No</th>
                    <th>Location</th>
                    <th>Total</th>
                    <th>Scanned</th>
                    <th>Status</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="10">No rows in digest (@_source). @_message</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Branch) ? row.Branch : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.VocType) ? row.VocType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.VocDate) ? row.VocDate : "—")</td>
                            <td>@row.VocNo.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Location) ? row.Location : "—")</td>
                            <td>@row.TotalPcs.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.ScannedPcs.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td><a href="@_phpTab">Open in PHP</a></td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>

    <div class="epc-w17-note">
        Read-only preview · JSON digest <a href="/cp/jewellery-stock-verification?limit=200">/cp/jewellery-stock-verification</a>. PHP jewellery stock verification remains authoritative · Not a broad /cp cutover · tenant product chrome stays PHP.
        Source: <code>@_source</code>. Tables: <code>epc_jewel_stock_verification, epc_jewel_stock_verification_lines</code>.
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=inventory_mgmt&tab=jw_stock_verification";
    private bool _isAdmin;
    private CpJewelleryStockVerificationSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpJewelleryStockVerificationRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Admin || !session.Capabilities.Contains("cp"))
        {
            Nav.NavigateTo("/cp/login", forceLoad: true);
            return;
        }

        _isAdmin = true;
        var result = await Dashboards.BuildCpJewelleryStockVerificationDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Verifications;
        _source = result.Source;
        _message = result.Message;
    }
}
