@page "/cp/soc2-compliance-app"
@page "/erp/soc2-compliance-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>SOC 2 compliance · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                SOC 2 compliance
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/soc2-compliance-app")</p>
                <p>Disable an obligation, save a filing or retention rule, and add an obligation here. Open a control to see description, implementation, and evidence.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/soc2-compliance-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedDetail is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="SOC 2 KPIs">
        <div class="kpi"><div class="lbl">Controls</div><div class="val">@_summary.ControlCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Implemented</div><div class="val">@_summary.ImplementedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Evidence</div><div class="val">@_summary.EvidenceCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Policies</div><div class="val">@_summary.PolicyCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <form method="post" action="/erp/ajax/bos-compliance-disable-obligation" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Obligation id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <button type="submit">Disable obligation</button>
        </form>
        <form method="post" action="/erp/compliance/filings/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Obligation id <input type="number" name="obligation_id" min="1" required style="width:6rem" /></label>
            <label>Period <input type="text" name="period_label" required placeholder="2026-09" /></label>
            <label>Status
                <select name="status">
                    <option value="filed">Filed</option>
                    <option value="open">Open</option>
                    <option value="waived">Waived</option>
                </select>
            </label>
            <label>Reference <input type="text" name="reference" /></label>
            <button type="submit">Save filing</button>
        </form>
        <form method="post" action="/erp/compliance/retention/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Label <input type="text" name="label" required /></label>
            <label>Doc type <input type="text" name="doc_type" /></label>
            <label>Years <input type="number" name="retention_years" value="5" min="0" style="width:5rem" /></label>
            <label>Basis <input type="text" name="basis" /></label>
            <label>Legal ref <input type="text" name="legal_ref" /></label>
            <button type="submit">Save retention</button>
        </form>
        <form method="post" action="/erp/compliance/obligations/add" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Title <input type="text" name="title" required /></label>
            <label>Code <input type="text" name="code" /></label>
            <label>Regime <input type="text" name="regime" placeholder="VAT/CT/..." /></label>
            <label>Authority <input type="text" name="authority" /></label>
            <label>Frequency
                <select name="frequency">
                    <option value="monthly">Monthly</option>
                    <option value="quarterly">Quarterly</option>
                    <option value="annual">Annual</option>
                    <option value="one_off">One-off</option>
                </select>
            </label>
            <label>Lead days <input type="number" name="lead_days" value="28" style="width:5rem" /></label>
            <label>Documents <input type="text" name="doc_requirements" /></label>
            <button type="submit">Add obligation</button>
        </form>
    }

    @if (_openedDetail is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedDetail.ControlId) ? _openedDetail.ControlId : ("#" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedDetail.Status) ? _openedDetail.Status : "—")</span>
                </div>
                <div class="panel-body">
                    <p><strong>@(!string.IsNullOrWhiteSpace(_openedDetail.Title) ? _openedDetail.Title : "—")</strong>
                        · @(!string.IsNullOrWhiteSpace(_openedDetail.Category) ? _openedDetail.Category : "—")
                        · Risk: @(!string.IsNullOrWhiteSpace(_openedDetail.RiskLevel) ? _openedDetail.RiskLevel : "—")</p>
                    <p>Owner: @(!string.IsNullOrWhiteSpace(_openedDetail.Owner) ? _openedDetail.Owner : "—")
                        · Frequency: @(!string.IsNullOrWhiteSpace(_openedDetail.Frequency) ? _openedDetail.Frequency : "—")</p>
                    <p>Last tested: @(!string.IsNullOrWhiteSpace(_openedDetail.LastTested) ? _openedDetail.LastTested : "—")
                        · Next review: @(!string.IsNullOrWhiteSpace(_openedDetail.NextReview) ? _openedDetail.NextReview : "—")</p>
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.Description))
                    {
                        <p>@_openedDetail.Description</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.Implementation))
                    {
                        <p class="text-muted">@_openedDetail.Implementation</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Evidence</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Title</th>
                                    <th>Collected</th>
                                    <th>By</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedEvidence.Count == 0)
                                {
                                    <tr><td colspan="5">No evidence yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var item in _openedEvidence)
                                    {
                                        <tr>
                                            <td>@(!string.IsNullOrWhiteSpace(item.EvidenceType) ? item.EvidenceType : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(item.Title) ? item.Title : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(item.CollectedAt) ? item.CollectedAt : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(item.CollectedBy) ? item.CollectedBy : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(item.Notes) ? item.Notes : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_summary.ControlCount.ToString(CultureInfo.InvariantCulture) Controls · @_summary.ImplementedCount.ToString(CultureInfo.InvariantCulture) Implemented · @_summary.EvidenceCount.ToString(CultureInfo.InvariantCulture) Evidence · @_summary.PolicyCount.ToString(CultureInfo.InvariantCulture) Policies.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Control</th>
                    <th>Category</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Risk</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ControlId) ? row.ControlId : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Category) ? row.Category : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.RiskLevel) ? row.RiskLevel : "—")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "soc2_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_soc2_compliance";
    private bool _isAdmin;
    private CpSoc2ComplianceSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpSoc2ControlDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private CpSoc2ControlDetail? _openedDetail;
    private IReadOnlyList<CpSoc2EvidenceDigest> _openedEvidence = [];
    private string _listHref = "/cp/soc2-compliance-app";
    private string _returnHref = "/cp/soc2-compliance-app";

    private string OpenedCaption => _openedDetail is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedDetail.ControlId) ? ("Control #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.ControlId)
            + " · " + (string.IsNullOrWhiteSpace(_openedDetail.Status) ? "open" : _openedDetail.Status);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var path = ctx.Request.Path.Value;
        _listHref = string.Equals(path, "/erp/soc2-compliance-app", StringComparison.OrdinalIgnoreCase)
            ? "/erp/soc2-compliance-app"
            : "/cp/soc2-compliance-app";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "soc2_id");
        _returnHref = _openedId > 0
            ? ErpRecordOpen.Href(_listHref, "soc2_id", _openedId).Split('#')[0]
            : _listHref;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpSoc2ComplianceDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Controls;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpSoc2ControlDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Control;
            _openedEvidence = detail.Evidence;
            if (_openedDetail is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
