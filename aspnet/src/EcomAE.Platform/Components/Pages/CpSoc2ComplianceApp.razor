@page "/cp/soc2-compliance-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>SOC 2 compliance · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-soc2-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-soc2-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-soc2-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-soc2-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-soc2-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0f172a; background:#fff;
        }
        .epc-soc2-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-soc2-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-soc2-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-soc2-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-soc2-kpi span { color:#64748b; font-size:.78rem; }
        .epc-soc2-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-soc2-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-soc2-table th, .epc-soc2-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-soc2-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-soc2-note { margin-top:1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:.45rem; color:#334155; font-size:.86rem; }
        @@media (max-width:900px){ .epc-soc2-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-soc2-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>SOC 2 compliance</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-soc2-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
        </div>
    </section>

    <div class="epc-soc2-kpis" aria-label="SOC 2 compliance stats">
        <div class="epc-soc2-kpi"><strong>@_summary.ControlCount.ToString(CultureInfo.InvariantCulture)</strong><span>Controls</span></div>
        <div class="epc-soc2-kpi"><strong>@_summary.ImplementedCount.ToString(CultureInfo.InvariantCulture)</strong><span>Implemented</span></div>
        <div class="epc-soc2-kpi"><strong>@_summary.EvidenceCount.ToString(CultureInfo.InvariantCulture)</strong><span>Evidence</span></div>
        <div class="epc-soc2-kpi"><strong>@_summary.PolicyCount.ToString(CultureInfo.InvariantCulture)</strong><span>Policies</span></div>
    </div>

    <div class="epc-soc2-table-wrap">
        <table class="epc-soc2-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Control</th>
                    <th>Category</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Risk</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="7">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ControlId) ? row.ControlId : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Category) ? row.Category : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Title) ? row.Title : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.RiskLevel) ? row.RiskLevel : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_soc2_compliance";
    private bool _isAdmin;
    private CpSoc2ComplianceSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpSoc2ControlDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpSoc2ComplianceDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Controls;
        _source = result.Source;
        _message = result.Message;
    }
}
