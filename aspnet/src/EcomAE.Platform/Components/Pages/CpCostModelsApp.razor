@page "/cp/cost-models-app"
@page "/erp/cost-models-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Cost models · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Cost models
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/cost-models-app")</p>
                <p>Add a costing transaction or assign a costing model here.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/cost-models-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_summary.ItemCount.ToString(CultureInfo.InvariantCulture) Items · @_summary.TxnCount.ToString(CultureInfo.InvariantCulture) Txns · @_summary.CloseCount.ToString(CultureInfo.InvariantCulture) Closes · @_summary.ModelCount.ToString(CultureInfo.InvariantCulture) Models.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Company</th>
                    <th>Item</th>
                    <th>Model</th>
                    <th>Std cost</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="7">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CompanyId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.ItemId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Model) ? row.Model : "—")</td>
                            <td>@row.StdCost.ToString("0.0000", CultureInfo.InvariantCulture)</td>
                            <td>@row.TimeUpdated.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

<form method="post" action="/erp/cost-models/txns/add" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/cost-models-app" />
            <strong style="width:100%;font-size:.85rem">Add transaction</strong>
            <label>Item id <input type="number" name="item_id" min="0" required style="width:7rem" /></label>
            <label>Type
                <select name="txn_type">
                    <option value="receipt">receipt</option>
                    <option value="issue">issue</option>
                </select>
            </label>
            <label>Qty <input type="text" name="qty" placeholder="0.0000" style="width:7rem" /></label>
            <label>Unit cost <input type="text" name="unit_cost" placeholder="0.0000" style="width:7rem" /></label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Add</button>
        </form>

<form method="post" action="/erp/cost-models/items/set" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/cost-models-app" />
            <strong style="width:100%;font-size:.85rem">Assign costing model</strong>
            <label>Item id <input type="number" name="item_id" min="0" required style="width:7rem" /></label>
            <label>Model
                <select name="model">
                    <option value="moving_avg">moving_avg</option>
                    <option value="standard">standard</option>
                    <option value="fifo">fifo</option>
                    <option value="lifo">lifo</option>
                </select>
            </label>
            <label>Std cost <input type="text" name="std_cost" placeholder="0.0000" style="width:7rem" /></label>
            <label>Company id <input type="number" name="company_id" min="0" value="0" style="width:5rem" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </form>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=cost_mgmt&tab=cost_models";
    private bool _isAdmin;
    private CpCostModelsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpCostModelItemDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpCostModelsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Items;
        _source = result.Source;
        _message = result.Message;
    }
}
