@page "/cp/plugins-manager-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Plugins manager · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Plugins manager
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Installed plugins from tenant tables. Activate or lock stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/plugins-manager-app" IsAdmin="_isAdmin" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (_opened is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @OpenedCaption
                    <a class="btn btn-xs btn-default pull-right" href="@OpenedReturnHref">This row</a>
                    <a class="btn btn-xs btn-default pull-right" href="@_listHref" style="margin-right:.35rem">Close</a>
                </div>
                <div class="panel-body">
                    <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                        <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Caption</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Caption) ? "—" : _opened.Caption)</dd>
                        <dt>Order</dt><dd>@_opened.SortOrder.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Active</dt><dd>@_opened.Activated.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Frontend</dt><dd>@_opened.IsFrontend.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Lock</dt><dd>@_opened.ControlLock.ToString(CultureInfo.InvariantCulture)</dd>
                    </dl>
                    <p class="text-muted" style="margin:.85rem 0 0">Activate or lock stays on the Classic twin.</p>
                    @if (!string.IsNullOrWhiteSpace(_opened.DataValueExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:.85rem 0 0">@_opened.DataValueExcerpt</pre>
                        @if (_opened.DataValueLen > _opened.DataValueExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_opened.DataValueExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.DataValueLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted" style="margin:.85rem 0 0">No data_value excerpt yet.</p>
                    }
                    @if (_openedSiblings.Count > 0)
                    {
                        <p class="text-muted" style="margin:1rem 0 .4rem">Same-frontend siblings</p>
                        <div class="table-responsive">
                            <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                                <thead>
                                    <tr>
                                        <th>Id</th>
                                        <th>Caption</th>
                                        <th>Order</th>
                                        <th>Active</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Caption) ? sib.Caption : "—")</td>
                                            <td>@sib.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@sib.Activated.ToString(CultureInfo.InvariantCulture)</td>
                                            <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "plugin_id", sib.Id)">Open</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No same-frontend siblings yet.</p>
                    }
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Plugins</div>
            <div class="panel-body">
                <p class="help-block">@_summary.PluginCount.ToString(CultureInfo.InvariantCulture) plugins · @_summary.ActivatedCount.ToString(CultureInfo.InvariantCulture) activated · @_summary.FrontendCount.ToString(CultureInfo.InvariantCulture) frontend · @_summary.LockedCount.ToString(CultureInfo.InvariantCulture) locked.</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Caption</th>
                                <th>Order</th>
                                <th>Active</th>
                                <th>Frontend</th>
                                <th>Lock</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_rows.Count == 0)
                        {
                            <tr><td colspan="7">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Caption) ? row.Caption : "—")</td>
                                    <td>@row.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.Activated.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.IsFrontend.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.ControlLock.ToString(CultureInfo.InvariantCulture)</td>
                                    <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "plugin_id", row.Id)">Open</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/plugins/plugins_manager";
    private const string _listHref = "/cp/plugins-manager-app";
    private bool _isAdmin;
    private CpPluginsManagerSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPluginsManagerRowDigest> _rows = [];
    private long _openedId;
    private CpPluginsManagerDetail? _opened;
    private IReadOnlyList<CpPluginsManagerRowDigest> _openedSiblings = [];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.Caption)
            ? _opened.Caption
            : ("Plugin #" + _opened.Id.ToString(CultureInfo.InvariantCulture)));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?plugin_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "plugin_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpPluginsManagerDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Plugins;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpPluginsManagerDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Plugin;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }
}
