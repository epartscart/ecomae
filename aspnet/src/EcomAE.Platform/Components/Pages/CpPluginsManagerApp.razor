@page "/cp/plugins-manager-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Plugins manager · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Plugins manager
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Installed plugins from tenant tables. Activate or lock stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/plugins-manager-app" IsAdmin="_isAdmin" />

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Plugins</div>
            <div class="panel-body">
                <p class="help-block">@_summary.PluginCount.ToString(CultureInfo.InvariantCulture) plugins · @_summary.ActivatedCount.ToString(CultureInfo.InvariantCulture) activated · @_summary.FrontendCount.ToString(CultureInfo.InvariantCulture) frontend · @_summary.LockedCount.ToString(CultureInfo.InvariantCulture) locked.</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Caption</th>
                                <th>Order</th>
                                <th>Active</th>
                                <th>Frontend</th>
                                <th>Lock</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_rows.Count == 0)
                        {
                            <tr><td colspan="6">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr>
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Caption) ? row.Caption : "—")</td>
                                    <td>@row.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.Activated.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.IsFrontend.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.ControlLock.ToString(CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/plugins/plugins_manager";
    private bool _isAdmin;
    private CpPluginsManagerSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPluginsManagerRowDigest> _rows = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpPluginsManagerDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Plugins;
    }
}
