@page "/cp/plugins-manager-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@inject ICpTemplatesPluginsService Plugins
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Plugins manager · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<style>
    .epc-pl-actions .panel_a { display:inline-block; text-align:center; text-decoration:none; color:#333; margin-right:14px; vertical-align:top; }
    .epc-pl-actions .panel_a_img { width:48px; height:48px; margin:0 auto 4px; border-radius:8px; background:#f1f3f6; display:flex; align-items:center; justify-content:center; font-size:22px; color:#3498db; }
    .epc-pl-actions .panel_a_caption { font-size:12px; }
    .epc-pl-list td a { color:inherit; display:block; text-decoration:none; }
    .epc-pl-list .pagination { margin:8px 0 0; }
    .epc-pl-list tr.epc-locked td { color:#999; }
    .epc-pl-form .form-group { margin-bottom:10px; }
    .epc-pl-form .hr-line-dashed { border-top:1px dashed #e4e5e7; margin:12px 0; }
    .epc-pl-form .control-label { text-align:right; padding-top:7px; }
</style>

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    @if (!_isAdmin)
    {
        <div class="col-lg-12"><div class="alert alert-warning">Admin CP session required. <a href="/cp/login?returnUrl=/cp/plugins-manager-app">Log in</a>.</div></div>
    }
    else if (_editId > 0)
    {
        @* ---- plugin_edit.php twin ---- *@
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Control
                    <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref("/CP/plugins/plugin?plugin_id=" + _editId.ToString(CultureInfo.InvariantCulture))">Classic twin</a>
                </div>
                <div class="panel-body epc-pl-actions">
                    @if (_edit is not null && !_edit.ControlLock)
                    {
                        <a class="panel_a" href="javascript:void(0);" onclick="epcSavePlugin();"><div class="panel_a_img"><i class="fa fa-save"></i></div><div class="panel_a_caption">Save</div></a>
                    }
                    <a class="panel_a" href="@_listHref"><div class="panel_a_img"><i class="fa fa-plug"></i></div><div class="panel_a_caption">Plugins</div></a>
                    <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div> }

        @if (_edit is null)
        {
            <div class="col-lg-12"><div class="alert alert-danger">Plugin #@_editId.ToString(CultureInfo.InvariantCulture) was not found.</div></div>
        }
        else
        {
            <form id="plugin_form" method="post" action="/cp/plugins-manager/save" class="form-horizontal epc-pl-form">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@EditHref(_edit.Id)" />
                <input type="hidden" name="save_plugin_action" value="save_plugin_action" />
                <input type="hidden" name="id" value="@_edit.Id.ToString(CultureInfo.InvariantCulture)" />
                <input type="hidden" name="caption_lang_str_id" value="@_edit.CaptionLangStrId" />
                <input type="hidden" name="description_lang_str_id" value="@_edit.DescriptionLangStrId" />
                <input type="hidden" name="is_frontend" value="@_edit.IsFrontend.ToString(CultureInfo.InvariantCulture)" />
                <div class="col-lg-6">
                    <div class="hpanel">
                        <div class="panel-heading hbuilt">Plugin</div>
                        <div class="panel-body">
                            <div class="form-group">
                                <label class="col-lg-6 control-label">ID</label>
                                <div class="col-lg-6"><p class="form-control-static">@_edit.Id.ToString(CultureInfo.InvariantCulture)</p></div>
                            </div>
                            <div class="hr-line-dashed col-lg-12"></div>
                            <div class="form-group">
                                <label for="caption_input" class="col-lg-6 control-label">Caption</label>
                                <div class="col-lg-6"><input class="form-control" type="text" name="caption" id="caption_input" value="@_edit.Caption" required disabled="@_edit.ControlLock" /></div>
                            </div>
                            <div class="hr-line-dashed col-lg-12"></div>
                            <div class="form-group">
                                <label for="description_input" class="col-lg-6 control-label">Description</label>
                                <div class="col-lg-6"><textarea class="form-control" name="description" id="description_input" rows="4" disabled="@_edit.ControlLock">@_edit.Description</textarea></div>
                            </div>
                            <div class="hr-line-dashed col-lg-12"></div>
                            <div class="form-group">
                                <label for="activated_checkbox" class="col-lg-6 control-label">Activated</label>
                                <div class="col-lg-6"><input type="checkbox" name="activated" id="activated_checkbox" value="1" checked="@_edit.Activated" disabled="@_edit.ControlLock" /></div>
                            </div>
                            <div class="hr-line-dashed col-lg-12"></div>
                            <div class="form-group">
                                <label for="order_input" class="col-lg-6 control-label">Execution order</label>
                                <div class="col-lg-6"><input class="form-control" type="number" name="order" id="order_input" value="@_edit.Order.ToString(CultureInfo.InvariantCulture)" disabled="@_edit.ControlLock" /></div>
                            </div>
                            <div class="hr-line-dashed col-lg-12"></div>
                            <div class="form-group">
                                <label class="col-lg-6 control-label">Control</label>
                                <div class="col-lg-6"><p class="form-control-static">@(_edit.ControlLock ? "Locked (system plugin, read only)" : "Available")</p></div>
                            </div>
                        </div>
                    </div>
                </div>
                @if (_edit.Fields.Count > 0)
                {
                    <div class="col-lg-6">
                        <div class="hpanel">
                            <div class="panel-heading hbuilt">Special settings</div>
                            <div class="panel-body">
                                @for (var i = 0; i < _edit.Fields.Count; i++)
                                {
                                    var f = _edit.Fields[i];
                                    if (f.Type == "hidden")
                                    {
                                        <CpDataStructureWidget Field="f" />
                                        continue;
                                    }
                                    if (i > 0) { <div class="hr-line-dashed col-lg-12"></div> }
                                    <div class="form-group">
                                        <label for="@f.Name" class="col-lg-6 control-label">@f.Caption</label>
                                        <div class="col-lg-6"><CpDataStructureWidget Field="f" /></div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </form>
            <script>
                function epcSavePlugin() {
                    var c = document.getElementById('caption_input');
                    if (!c.value.trim()) { alert('Caption is required.'); c.focus(); return; }
                    document.getElementById('plugin_form').requestSubmit();
                }
            </script>
        }
    }
    else
    {
        @* ---- plugins_manager.php twin ---- *@
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Control
                    <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
                </div>
                <div class="panel-body epc-pl-actions">
                    <a class="panel_a" href="javascript:void(0);" onclick="deletePlugins(0);"><div class="panel_a_img"><i class="fa fa-trash"></i></div><div class="panel_a_caption">Delete</div></a>
                    <a class="panel_a" href="javascript:void(0);" onclick="activatePlugins(0, 1);"><div class="panel_a_img"><i class="fa fa-toggle-on"></i></div><div class="panel_a_caption">Activate</div></a>
                    <a class="panel_a" href="javascript:void(0);" onclick="activatePlugins(0, 0);"><div class="panel_a_img"><i class="fa fa-toggle-off"></i></div><div class="panel_a_caption">Deactivate</div></a>
                    @if (_isFrontend == 1)
                    {
                        <a class="panel_a" href="javascript:void(0);" onclick="epcEditMode('backend');"><div class="panel_a_img"><i class="fa fa-cogs"></i></div><div class="panel_a_caption">Backend editing</div></a>
                    }
                    else
                    {
                        <a class="panel_a" href="javascript:void(0);" onclick="epcEditMode('frontend');"><div class="panel_a_img"><i class="fa fa-desktop"></i></div><div class="panel_a_caption">Frontend editing</div></a>
                    }
                    <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div> }

        <form name="plugins_manager_action_form" id="plugins_manager_action_form" method="post" action="/cp/plugins-manager/activate" style="display:none">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@PageHref(_list.Page)" />
            <input type="hidden" name="plugins_action" value="plugins_action" />
            <input type="hidden" name="plugins_action_type" id="plugins_action_type" value="" />
            <input type="hidden" name="plugins_list" id="plugins_list" value="" />
            <input type="hidden" name="plugin_id" id="plugin_id" value="" />
            <input type="hidden" name="flag_value" id="flag_value" value="" />
            <input type="hidden" name="is_frontend" value="@_isFrontend.ToString(CultureInfo.InvariantCulture)" />
        </form>
        <form id="edit_mode_form" method="post" action="/cp/control/edit-mode" style="display:none">
            <input type="hidden" name="returnUrl" value="@_listHref" />
            <input type="hidden" name="edit_mode" id="edit_mode" value="" />
        </form>

        <div class="col-lg-12">
            <div class="hpanel epc-pl-list">
                <div class="panel-heading hbuilt">@(_isFrontend == 1 ? "Storefront plugins" : "Control panel plugins")</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped" id="plugins_table">
                            <thead>
                                <tr>
                                    <th style="width:30px"><input type="checkbox" id="check_uncheck_all" onchange="on_check_uncheck_all();" /></th>
                                    <th style="width:70px">ID</th>
                                    <th>Caption</th>
                                    <th style="width:90px">Order</th>
                                    <th class="text-center" style="width:110px">Activated</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (_list.Items.Count == 0)
                            {
                                <tr><td colspan="5" class="text-muted">No @(_isFrontend == 1 ? "storefront" : "control panel") plugins are installed.</td></tr>
                            }
                            @foreach (var p in _list.Items)
                            {
                                var id = p.Id.ToString(CultureInfo.InvariantCulture);
                                <tr class="@(p.ControlLock ? "epc-locked" : "")">
                                    <td>
                                        @if (!p.ControlLock)
                                        {
                                            <input type="checkbox" class="epc-row-check" data-id="@id" id="checked_@id" name="checked_@id" onchange="on_one_check_changed('checked_@id');" />
                                        }
                                        else
                                        {
                                            <i class="fa fa-lock" title="Control locked"></i>
                                        }
                                    </td>
                                    <td><a href="@EditHref(p.Id)">@id</a></td>
                                    <td><a href="@EditHref(p.Id)">@p.Caption</a></td>
                                    <td><a href="@EditHref(p.Id)">@p.Order.ToString(CultureInfo.InvariantCulture)</a></td>
                                    <td class="text-center">
                                        @if (p.Activated)
                                        {
                                            if (p.ControlLock)
                                            {
                                                <i class="fa fa-check text-success" title="Activated (locked)"></i>
                                            }
                                            else
                                            {
                                                <a href="javascript:void(0);" onclick="activatePlugins(@id, 0);" title="Deactivate" style="display:inline"><i class="fa fa-check text-success"></i></a>
                                            }
                                        }
                                        else
                                        {
                                            if (p.ControlLock)
                                            {
                                                <i class="fa fa-times text-muted" title="Deactivated (locked)"></i>
                                            }
                                            else
                                            {
                                                <a href="javascript:void(0);" onclick="activatePlugins(@id, 1);" title="Activate" style="display:inline"><i class="fa fa-times text-danger"></i></a>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    @if (_list.Pages > 1)
                    {
                        <div class="row">
                            <div class="col-lg-12 text-center">
                                <div class="dataTables_paginate paging_simple_numbers">
                                    <ul class="pagination">
                                        @for (var i = 0; i < _list.Pages; i++)
                                        {
                                            var n = (i + 1).ToString(CultureInfo.InvariantCulture);
                                            if (i == _list.Page)
                                            {
                                                <li class="paginate_button active"><a href="javascript:void(0);">@n</a></li>
                                            }
                                            else
                                            {
                                                <li class="paginate_button"><a href="@PageHref(i)">@n</a></li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <script>
            function epcChecked() {
                var ids = [];
                document.querySelectorAll('#plugins_table .epc-row-check:checked').forEach(function (c) { ids.push(parseInt(c.getAttribute('data-id'), 10)); });
                return ids;
            }
            function on_check_uncheck_all() {
                var on = document.getElementById('check_uncheck_all').checked;
                document.querySelectorAll('#plugins_table .epc-row-check').forEach(function (c) { c.checked = on; });
            }
            function on_one_check_changed(id) {
                if (!document.getElementById(id).checked) { document.getElementById('check_uncheck_all').checked = false; }
            }
            function epcSubmit(action, type, ids, flag) {
                var f = document.getElementById('plugins_manager_action_form');
                f.action = action;
                document.getElementById('plugins_action_type').value = type;
                document.getElementById('plugins_list').value = JSON.stringify(ids);
                document.getElementById('plugin_id').value = ids.length == 1 ? ids[0] : '';
                document.getElementById('flag_value').value = flag;
                f.submit();
            }
            function activatePlugins(id, flag) {
                var ids = id > 0 ? [id] : epcChecked();
                if (ids.length == 0) { alert('Select plugins first.'); return; }
                epcSubmit('/cp/plugins-manager/activate', 'activated', ids, flag);
            }
            function deletePlugins(id) {
                var ids = id > 0 ? [id] : epcChecked();
                if (ids.length == 0) { alert('Select plugins to delete.'); return; }
                if (!confirm('Delete ' + ids.length + ' plugin(s)? Plugin files listed in dirs_files are removed too.')) { return; }
                epcSubmit('/cp/plugins-manager/delete', 'delete', ids, '');
            }
            function epcEditMode(mode) {
                document.getElementById('edit_mode').value = mode;
                document.getElementById('edit_mode_form').submit();
            }
        </script>
    }
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/plugins/plugins_manager";
    private const string _listHref = "/cp/plugins-manager-app";
    private bool _isAdmin;
    private string _flashOk = "";
    private string _flashErr = "";
    private int _isFrontend = 1;
    private long _editId;
    private CpPagedList<CpPluginRow> _list = new([], 0, 0, 0);
    private CpPluginDetail? _edit;

    private static string EditHref(long id) => _listHref + "?plugin_id=" + id.ToString(CultureInfo.InvariantCulture);

    private static string PageHref(int page) => page <= 0 ? _listHref : _listHref + "?s_page=" + page.ToString(CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString();
        _flashErr = ctx.Request.Query["err"].ToString();
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        _isFrontend = CpTemplatesPluginsService.ReadIsFrontend(ctx.Request);
        var rawId = ctx.Request.Query["plugin_id"].ToString();
        if (long.TryParse(rawId, NumberStyles.Integer, CultureInfo.InvariantCulture, out var id) && id > 0)
        {
            _editId = id;
            _edit = await Plugins.PluginAsync(id, _isFrontend, ctx.RequestAborted);
            return;
        }

        _list = await Plugins.PluginsAsync(_isFrontend, CpTemplatesPluginsService.ReadPage(ctx.Request), ctx.RequestAborted);
    }
}
