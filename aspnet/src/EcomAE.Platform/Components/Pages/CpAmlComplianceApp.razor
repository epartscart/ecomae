@page "/erp/aml-compliance-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Erp
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>AML compliance · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-aml-pack{margin:0 0 14px;}
        .epc-aml-lead{margin:0 0 10px;color:#334155;font-size:13px;line-height:1.45;}
        .epc-aml-steps{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;margin:10px 0 14px;}
        .epc-aml-step{background:#fff;border:1px solid #d5dde6;border-radius:8px;padding:8px;min-height:108px;}
        .epc-aml-step b{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:#1f4e79;color:#fff;font-size:12px;margin-bottom:6px;}
        .epc-aml-step strong{display:block;color:#1d2740;font-size:12px;}
        .epc-aml-step span{display:block;color:#475569;font-size:11px;margin-top:4px;}
        .epc-aml-docs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:0 0 12px;}
        .epc-aml-doc{display:block;background:#fff;border:1px solid #d5dde6;border-radius:8px;padding:8px 10px;text-decoration:none;min-height:78px;}
        .epc-aml-doc strong{display:block;color:#1d2740;font-size:12px;}
        .epc-aml-doc span{display:block;color:#64748b;font-size:11px;margin-top:4px;}
        .epc-aml-doc.is-open{border-color:#1f4e79;background:#eef4fa;}
        .epc-aml-doc.is-open strong,.epc-aml-doc.is-open span,.epc-aml-doc.is-open a{color:#1d2740;}
        .epc-aml-dl{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 12px;}
        .epc-aml-pack .epc-aml-dl a{display:inline-block;background:#1f4e79 !important;color:#fff !important;text-decoration:none;border-radius:6px;padding:6px 10px;font-size:12px;font-weight:700;}
        .epc-aml-mini{display:flex;gap:10px;margin-top:6px;}
        .epc-aml-mini a{color:#1f4e79;font-size:11px;font-weight:700;}
        .epc-aml-sheet{background:#fff;border:1px solid #d5dde6;border-radius:8px;padding:12px;margin:0 0 12px;}
        .epc-aml-sheet h3{margin:0 0 6px;color:#1d2740;font-size:15px;}
        .epc-aml-sheet h4{margin:10px 0 4px;color:#1d2740;font-size:13px;}
        .epc-aml-sheet p{margin:0 0 6px;color:#334155;font-size:13px;line-height:1.45;}
        .epc-aml-countries{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:0 0 12px;align-items:start;}
        .epc-aml-country{border:1px solid #d5dde6;border-radius:8px;padding:8px 10px;background:#fff;}
        .epc-aml-country h3{margin:0 0 6px;color:#1d2740;font-size:13px;}
        .epc-aml-country ul{margin:0;padding-left:1.1rem;}
        .epc-aml-country li{color:#1d2740;font-size:12px;margin:0 0 3px;}
        .epc-aml-edd ul{columns:2;column-gap:12px;}
        .epc-aml-refuse{background:#fef2f2;border-color:#fecaca;}
        .epc-aml-hold{background:#fffbeb;border-color:#fde68a;}
        .epc-aml-edd{background:#f8fbff;border-color:#dbe7f5;}
        .epc-aml-screen{display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin:0 0 8px;}
        .epc-aml-screen label{margin:0;font-size:12px;font-weight:700;color:#334155;}
        .epc-aml-note{margin:0;padding:8px 10px;border-radius:8px;background:#f8fbff;border:1px solid #d5dde6;color:#1d2740;font-size:13px;}
        .epc-aml-diary{width:100%;border-collapse:collapse;font-size:12px;margin:8px 0 0;}
        .epc-aml-diary th,.epc-aml-diary td{border:1px solid #e6eaf1;padding:6px 8px;text-align:left;color:#1d2740;}
        .epc-aml-diary th{background:#1d2740;color:#fff;}
        @@media (max-width:900px){.epc-aml-steps,.epc-aml-docs,.epc-aml-countries{grid-template-columns:1fr;}.epc-aml-edd ul{columns:1;}}
    </style>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                AML compliance
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/erp/aml-compliance-app")</p>
                <p>Save a KYC record or set an AML alert status here. Open a row to see notes, ID details, and customer transactions. Fetch FTA legislation for goAML / sanctions-adjacent tax instruments. A supplier buy at or above AED 55,000, including a buy above AED 100,000, needs the complete supplier file on <a href="/erp/suppliers-app">Suppliers</a> before it is saved.</p>
            </div>
        </div>
    </div>

    <div class="col-lg-12 epc-aml-pack">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Visual guide · AML programme · pack @ErpAmlProgramme.PackVersion</div>
            <div class="panel-body">
                <p class="epc-aml-lead">This is the workspace pack for every tenant where AML applies: a financial institution, a virtual-asset service provider, or a designated non-financial business. A dealer in precious metals and stones uses the same pack, and the cash and supply-chain annex, when a single or linked cash transaction reaches AED 55,000. A purchase above AED 100,000 is inside that line. The wording is original. It follows @ErpAmlProgramme.Decree and @ErpAmlProgramme.Resolution. Reports go to the Financial Intelligence Unit on goAML. Records are kept for five years. Fetch AML legislation when the Ministry or the FATF publishes an update. The country list does not replace name screening against the UN consolidated list and the UAE local terrorist list. Download PDF or Word at any time. Each file is stamped with the date and time it is prepared, and the reporting clocks are counted from that moment.</p>
                <div class="epc-aml-dl">
                    <a href="@DownloadHref(null, "pdf")">Download full pack PDF</a>
                    <a href="@DownloadHref(null, "docx")">Download full pack Word</a>
                </div>
                <div class="epc-aml-steps" aria-label="AML process from registration to reporting">
                    @foreach (var step in ErpAmlProgramme.Steps)
                    {
                        <div class="epc-aml-step">
                            <b>@step.Number</b>
                            <strong>@step.Title</strong>
                            <span>@step.Body</span>
                        </div>
                    }
                </div>
                <div class="epc-aml-docs" aria-label="AML documents">
                    @foreach (var doc in ErpAmlProgramme.Documents)
                    {
                        <div class="epc-aml-doc @(_pack?.Code == doc.Code ? "is-open" : "")">
                            <a href="@WithQuery(doc.Code, _country)"><strong>@doc.Title</strong></a>
                            <span>@doc.AppliesTo</span>
                            <span class="epc-aml-mini">
                                <a href="@DownloadHref(doc.Code, "pdf")">PDF</a>
                                <a href="@DownloadHref(doc.Code, "docx")">Word</a>
                            </span>
                        </div>
                    }
                </div>
                @if (_pack is not null)
                {
                    <article class="epc-aml-sheet">
                        <h3>@_pack.Title</h3>
                        <p><strong>@_pack.AppliesTo.</strong> @_pack.Lead</p>
                        @foreach (var part in _pack.Sections)
                        {
                            <h4>@part.Heading</h4>
                            <p>@part.Body</p>
                        }
                        <p class="epc-aml-mini">
                            <a href="@DownloadHref(_pack.Code, "pdf")">Download this document PDF</a>
                            <a href="@DownloadHref(_pack.Code, "docx")">Download this document Word</a>
                            <a href="@WithQuery(null, _country)">All documents</a>
                        </p>
                    </article>
                }
                <div class="epc-aml-countries" aria-label="Invoice country monitor">
                    <div class="epc-aml-country epc-aml-refuse">
                        <h3>Refused · FATF countermeasures</h3>
                        <ul>
                            @foreach (var country in ErpAmlProgramme.Countermeasures)
                            {
                                <li>@country.Code · @country.Name</li>
                            }
                        </ul>
                    </div>
                    <div class="epc-aml-country epc-aml-hold">
                        <h3>Held · call for action</h3>
                        <ul>
                            @foreach (var country in ErpAmlProgramme.CallForAction)
                            {
                                <li>@country.Code · @country.Name</li>
                            }
                        </ul>
                    </div>
                    <div class="epc-aml-country epc-aml-edd">
                        <h3>Enhanced due diligence · not refused</h3>
                        <ul>
                            @foreach (var country in ErpAmlProgramme.IncreasedMonitoring)
                            {
                                <li>@country.Code · @country.Name</li>
                            }
                        </ul>
                    </div>
                </div>
                <form class="epc-aml-screen" method="get" action="@_listHref">
                    @if (_openedId > 0)
                    {
                        <input type="hidden" name="kyc_id" value="@_openedId.ToString(CultureInfo.InvariantCulture)" />
                    }
                    @if (_pack is not null)
                    {
                        <input type="hidden" name="pack" value="@_pack.Code" />
                    }
                    <label>Country code <input name="country" value="@_country" maxlength="8" /></label>
                    <button type="submit">Screen country</button>
                </form>
                @if (_screen.Length > 0)
                {
                    <p class="epc-aml-note" role="status">@_screen</p>
                }
                <table class="epc-aml-diary">
                    <thead>
                        <tr><th>Report</th><th>When</th><th>Where</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Suspicious transaction</td><td>Without delay</td><td>goAML</td></tr>
                        <tr><td>Confirmed sanctions match</td><td>Freeze within 24 hours, then report within five business days</td><td>goAML and the Executive Office</td></tr>
                        <tr><td>Partial sanctions match</td><td>Suspend. Reject if identity is not received within 10 business days. Report within five business days</td><td>goAML</td></tr>
                        <tr><td>Dealers' report (DPMSR)</td><td>This workspace diaries 14 days from the qualified cash transaction. Fetch checks the diary against the current Ministry circular</td><td>goAML</td></tr>
                        <tr><td>Ministry file</td><td>When the supervisor asks, and when an officer or the risk assessment changes</td><td>Ministry of Economy and Tourism for a dealer</td></tr>
                        <tr><td>Annual review</td><td>Once a year: risk assessment, training, senior-management report</td><td>This workspace</td></tr>
                        <tr><td>Records</td><td>Five years after the relationship ends or the transaction is completed</td><td>This workspace</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/erp/aml-compliance-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedDetail is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="AML KYC KPIs">
        <div class="kpi"><div class="lbl">KYC</div><div class="val">@_summary.KycCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Pending</div><div class="val">@_summary.PendingKycCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Flagged txns</div><div class="val">@_summary.FlaggedTxnCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active rules</div><div class="val">@_summary.ActiveRuleCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_isAdmin)
    {
        <form id="erp-module-new" method="post" action="/erp/aml/kyc-save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <input type="hidden" name="id" value="@OpenedIdValue" />
            <ErpMasterPicker Kind="customer" FieldName="customer_id" InputId="aml-kyc-customer" Label="Customer" Required="true" Min="1" NameFieldName="customer_name" Value="@(_openedDetail is { CustomerId: > 0 } ? _openedDetail.CustomerId : 0)" />
            <input type="hidden" name="customer_name" value="@OpenedCustomerName" />
            <label>Id type <input name="id_type" value="@OpenedIdType" /></label>
            <label>Id number <input name="id_number" value="@OpenedIdNumber" /></label>
            <label>Expiry <input name="id_expiry" value="@OpenedIdExpiry" /></label>
            <label>Nationality <input name="nationality" value="@OpenedNationality" /></label>
            <label>Risk
                <select name="risk_level">
                    <option value="low" selected="@OpenedRiskIs("low")">low</option>
                    <option value="medium" selected="@OpenedRiskIs("medium")">medium</option>
                    <option value="high" selected="@OpenedRiskIs("high")">high</option>
                    <option value="very_high" selected="@OpenedRiskIs("very_high")">very_high</option>
                </select>
            </label>
            <label>Status
                <select name="verification_status">
                    <option value="pending" selected="@OpenedStatusIs("pending")">pending</option>
                    <option value="verified" selected="@OpenedStatusIs("verified")">verified</option>
                    <option value="rejected" selected="@OpenedStatusIs("rejected")">rejected</option>
                    <option value="expired" selected="@OpenedStatusIs("expired")">expired</option>
                </select>
            </label>
            <label>Notes <input name="notes" value="@OpenedNotes" style="width:14rem" /></label>
            <label><input type="checkbox" name="pep_status" value="1" checked="@OpenedPep" /> PEP</label>
            <button type="submit">Save KYC</button>
        </form>
        <form method="post" action="/erp/aml/alert-status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label>Txn id <input name="id" type="number" min="1" required value="@OpenedTxnIdValue" /></label>
            <label>Status
                <select name="status">
                    <option value="open">open</option>
                    <option value="reviewed">reviewed</option>
                    <option value="escalated">escalated</option>
                    <option value="closed">closed</option>
                </select>
            </label>
            <label>SAR ref <input name="sar_reference" /></label>
            <label><input type="checkbox" name="file_sar" value="1" /> File SAR</label>
            <button type="submit">Set alert status</button>
        </form>
        <form method="post" action="@ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/uae-tax/fta-fetch")" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label><input type="checkbox" name="force" value="1" /> Force refetch</label>
            <button type="submit">Fetch FTA legislation</button>
        </form>
        <form method="post" action="@ClientErpPath.PrefixIfBound(Http.HttpContext, "/erp/aml/legislation-fetch")" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_returnHref" />
            <label><input type="checkbox" name="force" value="1" /> Force refetch</label>
            <button type="submit">Fetch AML legislation</button>
        </form>
    }

    @if (_openedDetail is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedDetail.CustomerName) ? _openedDetail.CustomerName : ("KYC #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedDetail.VerificationStatus) ? _openedDetail.VerificationStatus : "—")</span>
                </div>
                <div class="panel-body">
                    <p>Customer id: <strong>@_openedDetail.CustomerId.ToString(CultureInfo.InvariantCulture)</strong>
                        · Risk: <strong>@(!string.IsNullOrWhiteSpace(_openedDetail.RiskLevel) ? _openedDetail.RiskLevel : "—")</strong>
                        @if (_openedDetail.PepStatus != 0)
                        {
                            <span class="label label-warning">PEP</span>
                        }
                    </p>
                    <p>ID: <strong>@(!string.IsNullOrWhiteSpace(_openedDetail.IdType) ? _openedDetail.IdType : "—")</strong>
                        @(!string.IsNullOrWhiteSpace(_openedDetail.IdNumber) ? _openedDetail.IdNumber : "—")
                        @if (!string.IsNullOrWhiteSpace(_openedDetail.IdExpiry))
                        {
                            <span> · expires @_openedDetail.IdExpiry</span>
                        }
                    </p>
                    <p>Nationality: @(!string.IsNullOrWhiteSpace(_openedDetail.Nationality) ? _openedDetail.Nationality : "—")
                        · DOB: @(!string.IsNullOrWhiteSpace(_openedDetail.Dob) ? _openedDetail.Dob : "—")</p>
                    <p>Sanctions: @(_openedDetail.SanctionsChecked != 0 ? "checked" : "not checked")
                        @if (_openedDetail.SanctionsMatch != 0)
                        {
                            <span class="label label-danger">match</span>
                        }
                    </p>
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.NextReview))
                    {
                        <p>Next review: @_openedDetail.NextReview</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.IdDocumentPath))
                    {
                        <p class="text-muted">Document: @_openedDetail.IdDocumentPath</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedDetail.Notes))
                    {
                        <p class="text-muted">@_openedDetail.Notes</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Customer transactions</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Type</th>
                                    <th class="text-right">Amount</th>
                                    <th>Score</th>
                                    <th>Flagged</th>
                                    <th>Status</th>
                                    <th>Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedTxns.Count == 0)
                                {
                                    <tr><td colspan="7">No transactions yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var txn in _openedTxns)
                                    {
                                        <tr>
                                            <td>@txn.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(txn.TransactionType) ? txn.TransactionType : "—")</td>
                                            <td class="text-right">@txn.Amount.ToString("0.00", CultureInfo.InvariantCulture) @(!string.IsNullOrWhiteSpace(txn.Currency) ? txn.Currency : "")</td>
                                            <td>@txn.RiskScore.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(txn.Flagged != 0 ? "yes" : "no")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(txn.ReviewStatus) ? txn.ReviewStatus : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(txn.FlagReason) ? txn.FlagReason : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_summary.KycCount.ToString(CultureInfo.InvariantCulture) KYC · @_summary.PendingKycCount.ToString(CultureInfo.InvariantCulture) Pending · @_summary.FlaggedTxnCount.ToString(CultureInfo.InvariantCulture) Flagged txns · @_summary.ActiveRuleCount.ToString(CultureInfo.InvariantCulture) Active rules.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Company</th>
                    <th>Customer id</th>
                    <th>Customer</th>
                    <th>Id type</th>
                    <th>Risk</th>
                    <th>PEP</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="10">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CompanyId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CustomerId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CustomerName) ? row.CustomerName : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.IdType) ? row.IdType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.RiskLevel) ? row.RiskLevel : "—")</td>
                            <td>@row.PepStatus.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.VerificationStatus) ? row.VerificationStatus : "—")</td>
                            <td>@row.TimeCreated.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "kyc_id", row.Id)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=tax&tab=aml_compliance";
    private bool _isAdmin;
    private CpAmlComplianceSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpAmlComplianceKycDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private CpAmlComplianceKycDetail? _openedDetail;
    private IReadOnlyList<CpAmlComplianceKycTxnDigest> _openedTxns = [];
    private string _listHref = "/erp/aml-compliance-app";
    private string _returnHref = "/erp/aml-compliance-app";
    private ErpAmlDocument? _pack;
    private string _country = "";
    private string _screen = "";

    private string DownloadHref(string? code, string format)
    {
        var path = "/erp/aml/pack?format=" + format;
        if (!string.IsNullOrWhiteSpace(code))
        {
            path += "&doc=" + Uri.EscapeDataString(code.Trim());
        }

        return ClientErpPath.PrefixIfBound(Http.HttpContext, path);
    }

    private string WithQuery(string? pack, string? country)
    {
        var query = new List<string>();
        if (_openedId > 0)
        {
            query.Add("kyc_id=" + _openedId.ToString(CultureInfo.InvariantCulture));
        }

        if (!string.IsNullOrWhiteSpace(pack))
        {
            query.Add("pack=" + Uri.EscapeDataString(pack.Trim()));
        }

        if (!string.IsNullOrWhiteSpace(country))
        {
            query.Add("country=" + Uri.EscapeDataString(country.Trim()));
        }

        return query.Count == 0 ? _listHref : _listHref + "?" + string.Join("&", query);
    }

    private string OpenedCaption => _openedDetail is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedDetail.CustomerName) ? ("KYC #" + _openedDetail.Id.ToString(CultureInfo.InvariantCulture)) : _openedDetail.CustomerName)
            + " · " + (string.IsNullOrWhiteSpace(_openedDetail.VerificationStatus) ? "open" : _openedDetail.VerificationStatus);

    private string OpenedIdValue => _openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "";
    private string OpenedCustomerName => _openedDetail?.CustomerName ?? "";
    private string OpenedCustomerIdValue => _openedDetail is { CustomerId: > 0 } ? _openedDetail.CustomerId.ToString(CultureInfo.InvariantCulture) : "";
    private string OpenedIdType => _openedDetail?.IdType ?? "";
    private string OpenedIdNumber => _openedDetail?.IdNumber ?? "";
    private string OpenedIdExpiry => _openedDetail?.IdExpiry ?? "";
    private string OpenedNationality => _openedDetail?.Nationality ?? "";
    private string OpenedNotes => _openedDetail?.Notes ?? "";
    private bool OpenedPep => _openedDetail is { PepStatus: not 0 };
    private string OpenedTxnIdValue
    {
        get
        {
            var flagged = _openedTxns.FirstOrDefault(t => t.Flagged != 0);
            var pick = flagged ?? _openedTxns.FirstOrDefault();
            return pick is null ? "" : pick.Id.ToString(CultureInfo.InvariantCulture);
        }
    }

    private bool OpenedRiskIs(string value)
        => string.Equals(_openedDetail?.RiskLevel, value, StringComparison.OrdinalIgnoreCase)
           || (_openedDetail is null && string.Equals(value, "low", StringComparison.Ordinal));

    private bool OpenedStatusIs(string value)
        => string.Equals(_openedDetail?.VerificationStatus, value, StringComparison.OrdinalIgnoreCase)
           || (_openedDetail is null && string.Equals(value, "pending", StringComparison.Ordinal));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _listHref = ClientErpPath.PrefixIfBound(ctx, "/erp/aml-compliance-app");
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "kyc_id", "kyc");
        _country = (ctx.Request.Query["country"].ToString() ?? "").Trim();
        _pack = ErpAmlProgramme.Find(ctx.Request.Query["pack"].ToString());
        _screen = _country.Length == 0 ? "" : ErpAmlProgramme.ScreenSummary(_country);
        _returnHref = _openedId > 0
            ? ErpRecordOpen.Href(_listHref, "kyc_id", _openedId).Split('#')[0]
            : _listHref;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpAmlComplianceDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Kyc;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpAmlComplianceKycDetailAsync(_openedId, ctx.RequestAborted);
            _openedDetail = detail.Kyc;
            _openedTxns = detail.Transactions;
            if (_openedDetail is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
