@page "/cp/aml-compliance-app"
@page "/erp/aml-compliance-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>AML compliance · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                AML compliance
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/aml-compliance-app")</p>
                <p>Save a KYC record or set an AML alert status here.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/aml-compliance-app" IsAdmin="_isAdmin" />


    @if (_isAdmin)
    {
        <form method="post" action="/erp/aml/kyc-save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/aml-compliance-app" />
            <label>Customer <input name="customer_name" required /></label>
            <label>Id type <input name="id_type" /></label>
            <label>Id number <input name="id_number" /></label>
            <label>Risk
                <select name="risk_level">
                    <option value="low">low</option>
                    <option value="medium">medium</option>
                    <option value="high">high</option>
                    <option value="very_high">very_high</option>
                </select>
            </label>
            <label>Status
                <select name="verification_status">
                    <option value="pending">pending</option>
                    <option value="verified">verified</option>
                    <option value="rejected">rejected</option>
                    <option value="expired">expired</option>
                </select>
            </label>
            <button type="submit">Save KYC</button>
        </form>
        <form method="post" action="/erp/aml/alert-status" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/aml-compliance-app" />
            <label>Txn id <input name="id" type="number" min="1" required /></label>
            <label>Status
                <select name="status">
                    <option value="open">open</option>
                    <option value="reviewed">reviewed</option>
                    <option value="escalated">escalated</option>
                    <option value="closed">closed</option>
                </select>
            </label>
            <label>SAR ref <input name="sar_reference" /></label>
            <label><input type="checkbox" name="file_sar" value="1" /> File SAR</label>
            <button type="submit">Set alert status</button>
        </form>
    }

    <p class="help-block">@_summary.KycCount.ToString(CultureInfo.InvariantCulture) KYC · @_summary.PendingKycCount.ToString(CultureInfo.InvariantCulture) Pending · @_summary.FlaggedTxnCount.ToString(CultureInfo.InvariantCulture) Flagged txns · @_summary.ActiveRuleCount.ToString(CultureInfo.InvariantCulture) Active rules.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Company</th>
                    <th>Customer id</th>
                    <th>Customer</th>
                    <th>Id type</th>
                    <th>Risk</th>
                    <th>PEP</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="10">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CompanyId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CustomerId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CustomerName) ? row.CustomerName : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.IdType) ? row.IdType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.RiskLevel) ? row.RiskLevel : "—")</td>
                            <td>@row.PepStatus.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.VerificationStatus) ? row.VerificationStatus : "—")</td>
                            <td>@row.TimeCreated.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=tax&tab=aml_compliance";
    private bool _isAdmin;
    private CpAmlComplianceSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpAmlComplianceKycDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpAmlComplianceDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Kyc;
        _source = result.Source;
        _message = result.Message;
    }
}
