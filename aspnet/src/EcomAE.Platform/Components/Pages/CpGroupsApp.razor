@page "/cp/groups-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Groups · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/groups-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpCpModulePageHeader Title="Groups & roles"
                           Subtitle="Open a row for the 280-character description excerpt. Tree save stays on the Classic twin."
                           PhpTabHref="@_phpTab">
        <a class="ghost" href="/cp/users-app">Users list</a>
    </PhpCpModulePageHeader>

    <div class="epc-scp-kpi" aria-label="Groups KPIs">
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Shown</div>
            <div class="epc-scp-kpi__val">@_groups.Count</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Backend groups</div>
            <div class="epc-scp-kpi__val">@_backend</div>
        </div>
    </div>

    <div class="epc-scp-table-card">
        <div class="epc-scp-table-card__head">
            <div>
                <h3>Groups</h3>
                <p class="epc-users-hint">Open uses <code>?ugroup_id=</code>. Full tree editor stays on the Classic twin.</p>
            </div>
        </div>
        <table class="epc-scp-data-table table table-epc-pro">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Backend</th>
                    <th>Guests</th>
                    <th>Registered</th>
                    <th>Unblocked</th>
                    <th>Parent</th>
                    <th>Level</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_groups.Count == 0)
                {
                    <tr><td colspan="9">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var g in _groups)
                    {
                        <tr id="erp-row-@g.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(g.Id, _openedId)">
                            <td><strong>@g.Id</strong></td>
                            <td>@g.Value</td>
                            <td>@(g.ForBackend ? "yes" : "—")</td>
                            <td>@(g.ForGuests ? "yes" : "—")</td>
                            <td>@(g.ForRegistrated ? "yes" : "—")</td>
                            <td>@(g.Unblocked ? "yes" : "no")</td>
                            <td>@g.Parent</td>
                            <td><span class="epc-scp-badge">L@g.Level</span></td>
                            <td class="epc-scp-actions-cell">
                                <a href="@ErpRecordOpen.Href(_listHref, "ugroup_id", g.Id)">Open</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-scp-table-card" style="margin-top:1rem">
            <div class="epc-scp-table-card__head">
                <div>
                    <h3>@OpenedCaption</h3>
                    <p class="epc-users-hint">Group field preview. Tree save stays on the Classic twin.</p>
                </div>
                <a class="btn btn-default btn-xs" href="@_listHref">Close</a>
            </div>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Parent</dt><dd>@_opened.Parent.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Level</dt><dd>@_opened.Level.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Children</dt><dd>@_opened.ChildCount.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Order</dt><dd>@_opened.SortOrder.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Percentage</dt><dd>@(_opened.ForPercentage ? "yes" : "no")</dd>
                <dt>Backend</dt><dd>@(_opened.ForBackend ? "yes" : "—")</dd>
                <dt>Unblocked</dt><dd>@(_opened.Unblocked ? "yes" : "no")</dd>
            </dl>
            @if (!string.IsNullOrWhiteSpace(_opened.DescriptionExcerpt))
            {
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:.85rem 0 0">@_opened.DescriptionExcerpt</pre>
                @if (_opened.DescriptionLen > _opened.DescriptionExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.DescriptionExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.DescriptionLen.ToString(CultureInfo.InvariantCulture) chars). Tree save stays on the Classic twin.</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No description excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="epc-users-hint" style="margin:1rem 0 .4rem">Same parent</p>
                <table class="table table-condensed table-striped table-epc">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Level</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Value) ? "—" : sib.Value)</td>
                                <td>@sib.Level.ToString(CultureInfo.InvariantCulture)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "ugroup_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-parent siblings yet.</p>
            }
        </div>
    }

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/users/usergroups";
    private bool _isAdmin;
    private IReadOnlyList<CpGroupDigest> _groups = [];
    private int _backend;
    private string _source = "n/a";
    private string _message = "";
    private string _listHref = "/cp/groups-app";
    private long _openedId;
    private CpGroupDetail? _opened;
    private IReadOnlyList<CpGroupDigest> _openedSiblings = [];

    private string OpenedCaption =>
        !string.IsNullOrWhiteSpace(_opened?.Value)
            ? _opened.Value
            : (_openedId > 0 ? ("Group #" + _openedId.ToString(CultureInfo.InvariantCulture)) : "");

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "ugroup_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListCpGroupsAsync(200, ctx.RequestAborted);
        _groups = result.Groups;
        _backend = _groups.Count(g => g.ForBackend);
        _source = result.Source;
        _message = result.Message;
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpGroupsDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Group;
            _openedSiblings = detail.Siblings;
        }
    }
}
