@page "/cp/groups-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Groups · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <PhpParityModuleBody AppPath="/cp/groups-app" IsAdmin="_isAdmin" />


    <PhpCpModulePageHeader Title="Groups & roles"
                           Subtitle="Role groups for storefront and backend access (PHP usergroups presentation)."
                           PhpTabHref="/CP/users/usergroups">
        <a class="ghost" href="/cp/users-app">Users list</a>
    </PhpCpModulePageHeader>

    <div class="epc-scp-kpi" aria-label="Groups KPIs">
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Shown</div>
            <div class="epc-scp-kpi__val">@_groups.Count</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Backend groups</div>
            <div class="epc-scp-kpi__val">@_backend</div>
        </div>
    </div>

    <div class="epc-scp-table-card">
        <table class="epc-scp-data-table table table-epc-pro">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Backend</th>
                    <th>Guests</th>
                    <th>Registered</th>
                    <th>Unblocked</th>
                    <th>Parent</th>
                    <th>Level</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_groups.Count == 0)
                {
                    <tr><td colspan="9">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var g in _groups)
                    {
                        <tr>
                            <td><strong>@g.Id</strong></td>
                            <td>@g.Value</td>
                            <td>@(g.ForBackend ? "yes" : "—")</td>
                            <td>@(g.ForGuests ? "yes" : "—")</td>
                            <td>@(g.ForRegistrated ? "yes" : "—")</td>
                            <td>@(g.Unblocked ? "yes" : "no")</td>
                            <td>@g.Parent</td>
                            <td><span class="epc-scp-badge">L@g.Level</span></td>
                            <td class="epc-scp-actions-cell"><a href="@(PhpSurfaceLinkMap.AspNetPrimaryHref("/CP/users/usergroups"))">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private bool _isAdmin;
    private IReadOnlyList<CpGroupDigest> _groups = [];
    private int _backend;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.ListCpGroupsAsync(200, ctx.RequestAborted);
        _groups = result.Groups;
        _backend = _groups.Count(g => g.ForBackend);
        _source = result.Source;
        _message = result.Message;
    }
}
