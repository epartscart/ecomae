@page "/cp/payment-gateways-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Payment Gateways · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <style>
        .epc-pay-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-pay-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-pay-hero p { margin:0; color:rgba(255,255,255,.85); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-pay-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-pay-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#0c4a6e; background:#e0f2fe;
        }
        .epc-pay-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-pay-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-pay-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-pay-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-pay-kpi span { color:#64748b; font-size:.78rem; }
        .epc-pay-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-pay-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-pay-table th, .epc-pay-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-pay-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        @@media (max-width:900px){ .epc-pay-kpis{grid-template-columns:1fr 1fr;} }
    </style>

    <section class="epc-pay-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Payment Gateways</h1>
        <p>Enable checkout handlers, choose the default rail, and manage settlement accounts for this store.</p>
        <div class="epc-pay-cta">
            <a href="@_configureHref">Configure</a>
            <a class="ghost" href="@_accountsHref">Accounts</a>
        </div>
    </section>

    <div class="epc-pay-kpis" aria-label="Payment Gateways stats">
        <div class="epc-pay-kpi"><strong>@_summary.GatewayCount.ToString(CultureInfo.InvariantCulture)</strong><span>Gateways</span></div>
        <div class="epc-pay-kpi"><strong>@_summary.EnabledGateways.ToString(CultureInfo.InvariantCulture)</strong><span>Enabled</span></div>
        <div class="epc-pay-kpi"><strong>@_summary.ActiveGateways.ToString(CultureInfo.InvariantCulture)</strong><span>Default</span></div>
        <div class="epc-pay-kpi"><strong>@_summary.AccountCount.ToString(CultureInfo.InvariantCulture)</strong><span>Accounts</span></div>
    </div>

    <div class="epc-pay-table-wrap">
        <table class="epc-pay-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Handler</th>
                    <th>Enabled</th>
                    <th>Default</th>
                    <th>Selectable</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_gateways.Count == 0)
                {
                    <tr><td colspan="6">No payment gateways configured yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _gateways)
                    {
                        <tr>
                            <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Handler) ? row.Handler : "—")</td>
                            <td>@(row.Anable ? "yes" : "no")</td>
                            <td>@(row.Active ? "yes" : "no")</td>
                            <td>@(row.IsSelectable ? "yes" : "no")</td>
                            <td><a href="@_configureHref">Configure</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _configureHref = "/CP/shop/payments/payments";
    private const string _accountsHref = "/CP/shop/payments/payments?tab=accounts";
    private bool _isAdmin;
    private CpPaymentGatewaysSummary _summary = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPaymentGatewayDigest> _gateways = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpPaymentGatewaysDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _gateways = result.Gateways;
    }
}
