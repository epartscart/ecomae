@page "/cp/payment-gateways-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Payment Gateways · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
@foreach (var href in LegacyPresentationAssets.CpUsersConsoleStylesheets)
{
    <link rel="stylesheet" href="@href" />
}

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <PhpCpModulePageHeader Title="Payment Gateways"
                           Subtitle="Set the default checkout rail or mark a settlement paid here. API keys, settlement accounts, seed, and send-test stay Classic. This page does not invent a send."
                           PhpTabHref="@_phpTab">
        <a class="ghost" href="@ConfigureHref(0)">Configure</a>
        <a class="ghost" href="#epc-pay-accounts">Accounts</a>
        <a class="ghost" href="/cp/orders">Orders · OMS</a>
    </PhpCpModulePageHeader>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }

    @if (!_isAdmin)
    {
        <div class="alert alert-info" role="status">Sign in with a Control Panel admin session to load live payment gateways.</div>
    }

    <div class="epc-scp-kpi" aria-label="Payment Gateways stats">
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Gateways</div>
            <div class="epc-scp-kpi__val">@_summary.GatewayCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Enabled</div>
            <div class="epc-scp-kpi__val">@_summary.EnabledGateways.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Default</div>
            <div class="epc-scp-kpi__val">@_summary.ActiveGateways.ToString(CultureInfo.InvariantCulture)</div>
        </div>
        <div class="epc-scp-kpi__card">
            <div class="epc-scp-kpi__label">Accounts</div>
            <div class="epc-scp-kpi__val">@_summary.AccountCount.ToString(CultureInfo.InvariantCulture)</div>
        </div>
    </div>

    <div class="epc-scp-users-workspace @(_selectedId > 0 ? "is-detail-active" : null)">
        <div class="epc-scp-users-workspace__list">
            <div class="epc-scp-table-card">
                <div class="epc-scp-table-card__head">
                    <div>
                        <h3>Checkout handlers</h3>
                        <p class="epc-users-hint">PHP <code>shop_payment_systems</code> — Set default writes <code>active</code>. Configure credentials stay Classic.</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="epc-scp-data-table table table-epc-pro table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Handler</th>
                                <th>Enabled</th>
                                <th>Default</th>
                                <th>Selectable</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_gateways.Count == 0)
                            {
                                <tr><td colspan="7">No payment gateways configured yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var row in _gateways)
                                {
                                    <tr class="@(_selectedId == row.Id ? "active" : null)">
                                        <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                                        <td>@(!string.IsNullOrWhiteSpace(row.Handler) ? row.Handler : "—")</td>
                                        <td>@(row.Anable ? "yes" : "no")</td>
                                        <td>@(row.Active ? "yes" : "no")</td>
                                        <td>@(row.IsSelectable ? "yes" : "no")</td>
                                        <td class="epc-scp-actions-cell">
                                            @if (_isAdmin && !string.IsNullOrWhiteSpace(row.Handler) && !row.Active)
                                            {
                                                <form method="post" action="/cp/payments/write" style="display:inline;margin:0 0.4rem 0 0;">
                                                    <input type="hidden" name="confirmWrites" value="true" />
                                                    <input type="hidden" name="returnUrl" value="@ActivateReturnHref(row.Id)" />
                                                    <input type="hidden" name="action" value="activate" />
                                                    <input type="hidden" name="handler" value="@row.Handler" />
                                                    <button type="submit" class="btn btn-default btn-xs">Set default</button>
                                                </form>
                                            }
                                            <a href="@ConfigureHref(row.Id)">Configure</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (_selected is not null)
        {
            <div class="epc-scp-users-workspace__detail">
                <div class="epc-scp-table-card">
                    <div class="epc-scp-table-card__head">
                        <div>
                            <h3>Configure · @_selected.Name</h3>
                            <p class="epc-users-hint">Read fields from digest — parameters / credentials remain Classic</p>
                        </div>
                        <a class="btn btn-default btn-xs" href="/cp/payment-gateways-app">Close</a>
                    </div>
                    <dl class="epc-scp-dl" style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                        <dt>ID</dt><dd>@_selected.Id.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Name</dt><dd>@(_selected.Name is { Length: > 0 } ? _selected.Name : "—")</dd>
                        <dt>Handler</dt><dd><code>@(_selected.Handler is { Length: > 0 } ? _selected.Handler : "—")</code></dd>
                        <dt>Enabled</dt><dd>@(_selected.Anable ? "yes" : "no")</dd>
                        <dt>Default rail</dt><dd>@(_selected.Active ? "yes" : "no")</dd>
                        <dt>Selectable</dt><dd>@(_selected.IsSelectable ? "yes" : "no")</dd>
                    </dl>
                    @if (_isAdmin && !string.IsNullOrWhiteSpace(_selected.Handler) && !_selected.Active)
                    {
                        <form method="post" action="/cp/payments/write" style="margin:.85rem 0 0;">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@ActivateReturnHref(_selected.Id)" />
                            <input type="hidden" name="action" value="activate" />
                            <input type="hidden" name="handler" value="@_selected.Handler" />
                            <button type="submit" class="btn btn-primary btn-sm">Set default rail</button>
                        </form>
                    }
                    <p style="margin:.85rem 0 0;font-size:.86rem;color:#475569;">
                        API keys, settlement accounts, seed, and send-test stay Classic. This page does not invent a send.
                        <a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref($"{_phpTab}?id={_selected.Id.ToString(CultureInfo.InvariantCulture)}")">Classic configure</a>
                    </p>
                </div>
            </div>
        }
    </div>

    <div class="epc-scp-table-card" id="epc-pay-accounts" style="margin-top:1rem;">
        <div class="epc-scp-table-card__head">
            <div>
                <h3>Settlement accounts</h3>
                <p class="epc-users-hint">PHP <code>epc_payment_accounts</code> count — account editor stays Classic. Mark paid writes <code>epc_payment_settlements.status</code>.</p>
            </div>
            <span class="epc-scp-badge">@_summary.AccountCount.ToString(CultureInfo.InvariantCulture) accounts</span>
        </div>
        <p style="margin:0 0 .85rem;font-size:.9rem;color:#334155;">
            @_summary.AccountCount.ToString(CultureInfo.InvariantCulture) settlement account(s) linked for this tenant.
            <a href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab + "#accounts")">Manage accounts on Classic</a>
        </p>
        @if (_isAdmin)
        {
            <form method="post" action="/cp/payments/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .85rem">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/payment-gateways-app" />
                <input type="hidden" name="action" value="mark_settlement" />
                <label>Settlement id <input type="number" name="id" min="1" required style="width:6rem" /></label>
                <label>Status
                    <select name="status">
                        <option value="paid_out" selected>paid_out</option>
                        <option value="pending">pending</option>
                    </select>
                </label>
                <button type="submit" class="btn btn-xs btn-success">Mark settlement</button>
            </form>
        }
        <p class="help-block" style="margin:.75rem 0 0">API keys, settlement accounts, seed, and send-test stay Classic. This page does not invent a send.</p>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/payments";
    private bool _isAdmin;
    private long _selectedId;
    private string _flashOk = "";
    private string _flashErr = "";
    private CpPaymentGatewaysSummary _summary = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpPaymentGatewayDigest> _gateways = [];
    private CpPaymentGatewayDigest? _selected;

    private static string ConfigureHref(long id) =>
        id > 0
            ? $"/cp/payment-gateways-app?id={id.ToString(CultureInfo.InvariantCulture)}"
            : "/cp/payment-gateways-app?configure=1";

    private static string ActivateReturnHref(long id) =>
        id > 0
            ? $"/cp/payment-gateways-app?id={id.ToString(CultureInfo.InvariantCulture)}"
            : "/cp/payment-gateways-app";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("id", out var idRaw)
            && long.TryParse(idRaw.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var id))
        {
            _selectedId = id;
        }

        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpPaymentGatewaysDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _gateways = result.Gateways;
        if (_selectedId > 0)
        {
            _selected = _gateways.FirstOrDefault(g => g.Id == _selectedId);
        }
        else if (query.ContainsKey("configure") && _gateways.Count > 0)
        {
            _selected = _gateways[0];
            _selectedId = _selected.Id;
        }
    }
}
