@page "/cp/payment-gateways-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@inject ICpPaymentsDeskService Desk
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Payment gateways · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
@foreach (var href in LegacyPresentationAssets.CpUsersConsoleStylesheets)
{
    <link rel="stylesheet" href="@href" />
}
<style>
    .epc-pay-hub { --ink:#0f172a; --muted:#64748b; --line:#e2e8f0; --accent:#0f766e; --soft:#f8fafc; margin:0 0 20px; }
    .epc-pay-kpi { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:10px; margin:0 0 16px; }
    @@media (max-width:991px){ .epc-pay-kpi{ grid-template-columns:repeat(2,minmax(0,1fr)); } }
    .epc-pay-kpi .kpi { background:#fff; border:1px solid var(--line); border-radius:12px; padding:12px 14px; box-shadow:0 1px 2px rgba(15,23,42,.04); }
    .epc-pay-kpi .lbl { font-size:11px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:var(--muted); }
    .epc-pay-kpi .val { margin-top:4px; font-size:22px; font-weight:750; color:var(--ink); }
    .epc-pay-tabs { display:flex; flex-wrap:wrap; gap:8px; margin:0 0 16px; }
    .epc-pay-tabs a { border:1px solid var(--line); background:#fff; color:var(--ink); border-radius:9px; padding:8px 12px; font-size:13px; font-weight:650; text-decoration:none !important; }
    .epc-pay-tabs a.active, .epc-pay-tabs a:hover { border-color:#5eead4; background:#f0fdfa; color:#0f766e; }
    .epc-pay-hint { margin:0 0 14px; padding:10px 12px; border:1px solid #99f6e4; border-radius:10px; background:#f0fdfa; color:#115e59; font-size:13px; }
    .epc-pay-section { margin:0 0 18px; border:1px solid var(--line); border-radius:12px; background:#fff; overflow:hidden; }
    .epc-pay-section h4 { margin:0; padding:12px 14px; border-bottom:1px solid var(--line); background:linear-gradient(180deg,#fff,var(--soft)); font-size:15px; font-weight:700; }
    .epc-pay-section .body { padding:0; }
    .badge-region { background:#ecfeff; color:#0e7490; font-size:11px; font-weight:700; padding:2px 8px; border-radius:8px; }
    .badge-active { background:#dcfce7; color:#166534; font-size:11px; font-weight:700; padding:2px 8px; border-radius:8px; }
    .badge-demo { background:#fef3c7; color:#92400e; font-size:11px; font-weight:700; padding:2px 8px; border-radius:8px; }
    .epc-pay-actions { display:flex; flex-wrap:wrap; gap:8px; margin:0 0 14px; }
    .epc-pay-actions .btn { border-radius:9px; }
</style>

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <PhpCpModulePageHeader Title="Payment gateways"
                           Subtitle="Platform gateways plus individual office/vendor accounts so each seller can receive payment."
                           PhpTabHref="@PhpTab">
        <a class="ghost" href="@TabHref("accounts")">Individual accounts</a>
        <a class="ghost" href="@TabHref("configure")">Configure</a>
        <a class="ghost" href="/cp/guides-app?g=payments">Guide</a>
    </PhpCpModulePageHeader>

    <div class="epc-pay-hub">
        @if (!string.IsNullOrWhiteSpace(_flashOk))
        {
            <div class="alert alert-success" role="status">@_flashOk</div>
        }
        @if (!string.IsNullOrWhiteSpace(_flashErr))
        {
            <div class="alert alert-danger" role="status">@_flashErr</div>
        }
        @if (!_isAdmin)
        {
            <div class="alert alert-info" role="status">Sign in with a Control Panel admin session to load live payment gateways.</div>
        }
        else if (!_desk.Available)
        {
            <div class="alert alert-warning" role="status">@_desk.Message</div>
        }

        <p class="epc-pay-hint">
            <strong>Multi-method checkout:</strong> enable gateways below, then customers choose Card / BNPL / JazzCash / Crypto on the order page.
            Active default: <strong>@(_desk.ActiveGateway?.DisplayName ?? "None")</strong>@if (_desk.ActiveGateway is not null)
            {
                <text> (<code>@_desk.ActiveGateway.Handler</code>)</text>
            }.
        </p>

        <div class="epc-pay-tabs">
            <a class="@(_tab == "dashboard" ? "active" : null)" href="@TabHref("dashboard")">Dashboard</a>
            <a class="@(_tab == "accounts" ? "active" : null)" href="@TabHref("accounts")">Individual accounts</a>
            <a class="@(_tab == "configure" ? "active" : null)" href="@TabHref("configure")">Configure</a>
            <a class="@(_tab == "legacy" ? "active" : null)" href="@TabHref("legacy")">Legacy (CIS)</a>
        </div>

        @if (_tab == "dashboard")
        {
            <div class="epc-pay-kpi">
                <div class="kpi"><div class="lbl">Total</div><div class="val">@Num(_desk.Gateways.Count)</div></div>
                <div class="kpi"><div class="lbl">GCC / MENA</div><div class="val">@Num(_desk.CountInRegion(PhpPaymentGatewayCatalog.RegionGcc))</div></div>
                <div class="kpi"><div class="lbl">Pakistan</div><div class="val">@Num(_desk.CountInRegion(PhpPaymentGatewayCatalog.RegionPakistan))</div></div>
                <div class="kpi"><div class="lbl">Crypto</div><div class="val">@Num(_desk.CountInRegion(PhpPaymentGatewayCatalog.RegionCrypto))</div></div>
                <div class="kpi"><div class="lbl">International</div><div class="val">@Num(_desk.CountInRegion(PhpPaymentGatewayCatalog.RegionInternational))</div></div>
            </div>

            @if (_isAdmin)
            {
                <div class="epc-pay-actions">
                    <form method="post" action="@WriteRoute" style="display:inline;">
                        @WriteFields("seed_dummy", TabHref("dashboard"))
                        <button type="submit" class="btn btn-success btn-sm">Seed / refresh gateways</button>
                    </form>
                    <form method="post" action="@WriteRoute" style="display:inline;">
                        @WriteFields("activate", TabHref("dashboard"))
                        <input type="hidden" name="handler" value="stripe" />
                        <button type="submit" class="btn btn-primary btn-sm">Activate Stripe</button>
                    </form>
                    <form method="post" action="@WriteRoute" style="display:inline;">
                        @WriteFields("activate", TabHref("dashboard"))
                        <input type="hidden" name="handler" value="nowpayments" />
                        <button type="submit" class="btn btn-default btn-sm">Activate Crypto</button>
                    </form>
                </div>
            }

            @foreach (var region in DashboardRegions)
            {
                var list = _desk.InRegion(region);
                if (list.Count == 0)
                {
                    continue;
                }

                <div class="epc-pay-section">
                    <h4>@PhpPaymentGatewayCatalog.RegionLabel(region)</h4>
                    <div class="body table-responsive">
                        <table class="table table-condensed" style="margin:0;">
                            <thead><tr><th>Gateway</th><th>Handler</th><th>Mode</th><th>Webhook</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var gateway in list)
                                {
                                    <tr>
                                        <td><strong>@gateway.DisplayName</strong></td>
                                        <td><code>@gateway.Handler</code></td>
                                        <td>
                                            @if (gateway.DemoMode)
                                            {
                                                <span class="badge-demo">Demo</span>
                                            }
                                            else
                                            {
                                                <span class="label label-warning">Live keys</span>
                                            }
                                            @if (gateway.Active)
                                            {
                                                <span class="badge-active">Default</span>
                                            }
                                        </td>
                                        <td><small>@WebhookUrl(gateway.Handler)</small></td>
                                        <td>
                                            @if (_isAdmin && !gateway.Active)
                                            {
                                                <form method="post" action="@WriteRoute" style="margin:0;">
                                                    @WriteFields("activate", TabHref("dashboard"))
                                                    <input type="hidden" name="handler" value="@gateway.Handler" />
                                                    <button type="submit" class="btn btn-xs btn-default">Set default</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }

        @if (_tab == "legacy")
        {
            <div class="epc-pay-section">
                <h4>Legacy payment systems (CIS / DocPart)</h4>
                <div class="body table-responsive">
                    <table class="table table-striped table-condensed" style="margin:0;">
                        <thead><tr><th>Name</th><th>Handler</th><th>Enabled</th><th>Default</th></tr></thead>
                        <tbody>
                            @if (_desk.InRegion(PhpPaymentGatewayCatalog.RegionLegacy).Count == 0)
                            {
                                <tr><td colspan="4" class="text-muted">No legacy payment systems configured.</td></tr>
                            }
                            @foreach (var gateway in _desk.InRegion(PhpPaymentGatewayCatalog.RegionLegacy))
                            {
                                <tr>
                                    <td>@gateway.DisplayName</td>
                                    <td><code>@gateway.Handler</code></td>
                                    <td>@(gateway.Enabled ? "Yes" : "No")</td>
                                    <td>@if (gateway.Active) { <strong>Default</strong> } else { <text>—</text> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (_tab == "accounts")
        {
            <div class="epc-pay-hint">
                <strong>Individual accounts:</strong> each shop office or marketplace vendor can hold its own merchant credentials
                (or a connected account ID / payout IBAN). Checkout routes payment to that account; settlements record who received the money.
            </div>

            @if (_isAdmin)
            {
                <div class="epc-pay-actions">
                    <form method="post" action="@WriteRoute" style="display:inline;">
                        @WriteFields("seed_platform_account", TabHref("accounts"))
                        <button type="submit" class="btn btn-success btn-sm">Ensure platform account</button>
                    </form>
                </div>
            }

            <div class="row">
                <div class="col-lg-5">
                    <div class="epc-pay-section">
                        <h4>@(_editAccount is null ? "Add payment account" : "Edit account #" + Num(_editAccount.Id))</h4>
                        <div class="body" style="padding:14px;">
                            <form method="post" action="@WriteRoute" class="form-horizontal">
                                @WriteFields("save_account", TabHref("accounts"))
                                <input type="hidden" name="id" value="@Num(_editAccount?.Id ?? 0)" />
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Owner type</label>
                                    <div class="col-sm-8">
                                        <select name="owner_type" class="form-control">
                                            @foreach (var (key, label) in OwnerTypes)
                                            {
                                                <option value="@key" selected="@(Account.OwnerType == key)">@label</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Office</label>
                                    <div class="col-sm-8">
                                        <select name="office_id" class="form-control">
                                            <option value="0">—</option>
                                            @foreach (var office in _desk.Offices)
                                            {
                                                <option value="@Num(office.Id)"
                                                        selected="@(Account.OwnerType == "office" && Account.OwnerId == office.Id)">
                                                    #@Num(office.Id) — @office.Caption
                                                </option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Vendor</label>
                                    <div class="col-sm-8">
                                        <select name="vendor_id" class="form-control">
                                            <option value="0">—</option>
                                            @foreach (var vendor in _desk.Vendors)
                                            {
                                                <option value="@Num(vendor.Id)"
                                                        selected="@(Account.OwnerType == "vendor" && Account.OwnerId == vendor.Id)">
                                                    #@Num(vendor.Id) — @vendor.Caption
                                                </option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Title</label>
                                    <div class="col-sm-8">
                                        <input type="text" name="title" class="form-control" value="@Account.Title" placeholder="e.g. Dubai warehouse Telr" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Gateway</label>
                                    <div class="col-sm-8">
                                        <select name="handler" class="form-control">
                                            @foreach (var definition in PhpPaymentGatewayCatalog.Definitions.Values)
                                            {
                                                <option value="@definition.Handler" selected="@(Account.Handler == definition.Handler)">
                                                    @definition.Title (@definition.Handler)
                                                </option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Mode</label>
                                    <div class="col-sm-8">
                                        <select name="mode" class="form-control">
                                            <option value="direct" selected="@(Account.Mode == "direct")">Direct merchant keys (account receives charge)</option>
                                            <option value="connected" selected="@(Account.Mode == "connected")">Connected account ID (Stripe Connect / sub-merchant)</option>
                                            <option value="payout" selected="@(Account.Mode == "payout")">Platform collects → payout to bank IBAN</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Connected account ID</label>
                                    <div class="col-sm-8">
                                        <input type="text" name="connected_account_id" class="form-control" value="@Account.ConnectedAccountId" placeholder="acct_… or Telr merchant ref" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Payout IBAN</label>
                                    <div class="col-sm-8"><input type="text" name="payout_iban" class="form-control" value="@Account.PayoutIban" /></div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Bank / account name</label>
                                    <div class="col-sm-8">
                                        <input type="text" name="payout_bank" class="form-control" style="margin-bottom:6px;" value="@Account.PayoutBank" placeholder="Bank name" />
                                        <input type="text" name="payout_name" class="form-control" value="@Account.PayoutName" placeholder="Account name" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Platform fee %</label>
                                    <div class="col-sm-8">
                                        <input type="number" step="0.01" min="0" max="100" name="platform_fee_pct" class="form-control"
                                               value="@Account.PlatformFeePct.ToString("0.##", CultureInfo.InvariantCulture)" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Merchant credentials (JSON)</label>
                                    <div class="col-sm-8">
                                        <textarea name="credentials_json" class="form-control" rows="5">@Account.CredentialsJson</textarea>
                                        <p class="help-block" style="margin:6px 0 0;font-size:12px;">
                                            Paste gateway keys for this account. Office saves also sync to legacy <code>shop_offices.pay_system_*</code>.
                                        </p>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Flags</label>
                                    <div class="col-sm-8">
                                        <label class="checkbox-inline"><input type="checkbox" name="demo_mode" value="1" checked="@Account.DemoMode" /> Demo mode</label>
                                        <label class="checkbox-inline"><input type="checkbox" name="is_default" value="1" checked="@Account.IsDefault" /> Default for owner</label>
                                        <select name="status" class="form-control" style="margin-top:8px;max-width:180px;">
                                            <option value="active" selected="@(Account.Status == "active")">Active</option>
                                            <option value="pending" selected="@(Account.Status == "pending")">Pending</option>
                                            <option value="disabled" selected="@(Account.Status == "disabled")">Disabled</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-sm-offset-4 col-sm-8">
                                        <button type="submit" class="btn btn-primary" disabled="@(!_isAdmin)">Save account</button>
                                        @if (_editAccount is not null)
                                        {
                                            <a class="btn btn-default" href="@TabHref("accounts")">Cancel</a>
                                        }
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="epc-pay-section">
                        <h4>Payment accounts</h4>
                        <div class="body table-responsive">
                            <table class="table table-condensed" style="margin:0;">
                                <thead><tr><th>Title</th><th>Owner</th><th>Gateway</th><th>Mode</th><th>Fee</th><th>Status</th><th></th></tr></thead>
                                <tbody>
                                    @if (_desk.Accounts.Count == 0)
                                    {
                                        <tr><td colspan="7" class="text-muted">No accounts yet — save one on the left.</td></tr>
                                    }
                                    @foreach (var account in _desk.Accounts)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@account.Title</strong>
                                                @if (account.IsDefault)
                                                {
                                                    <span class="badge-active">Default</span>
                                                }
                                            </td>
                                            <td><span class="badge-region">@account.OwnerType</span> #@Num(account.OwnerId)</td>
                                            <td><code>@account.Handler</code></td>
                                            <td>@account.Mode</td>
                                            <td>@account.PlatformFeePct.ToString("0.##", CultureInfo.InvariantCulture)%</td>
                                            <td>@account.Status</td>
                                            <td>
                                                <a class="btn btn-xs btn-default" href="@AccountHref(account.Id)">Edit</a>
                                                @if (_isAdmin && account.Status != "disabled")
                                                {
                                                    <form method="post" action="@WriteRoute" style="display:inline;">
                                                        @WriteFields("disable_account", TabHref("accounts"))
                                                        <input type="hidden" name="id" value="@Num(account.Id)" />
                                                        <button type="submit" class="btn btn-xs btn-danger">Disable</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="epc-pay-section">
                        <h4>Recent settlements (who received the payment)</h4>
                        <div class="body table-responsive">
                            <table class="table table-condensed" style="margin:0;">
                                <thead><tr><th>ID</th><th>Order</th><th>Account</th><th>Gross</th><th>Fee</th><th>Net</th><th>Status</th><th></th></tr></thead>
                                <tbody>
                                    @if (_desk.Settlements.Count == 0)
                                    {
                                        <tr><td colspan="8" class="text-muted">Settlements appear after a successful online payment.</td></tr>
                                    }
                                    @foreach (var settlement in _desk.Settlements)
                                    {
                                        <tr>
                                            <td>@Num(settlement.Id)</td>
                                            <td>@(settlement.OrderId > 0 ? Num(settlement.OrderId) : "—")</td>
                                            <td>@settlement.OwnerType #@Num(settlement.OwnerId) <code>@settlement.Handler</code></td>
                                            <td>@Money(settlement.GrossAmount) @settlement.Currency</td>
                                            <td>@Money(settlement.FeeAmount)</td>
                                            <td><strong>@Money(settlement.NetAmount)</strong></td>
                                            <td>@settlement.Status</td>
                                            <td>
                                                @if (_isAdmin && settlement.Status != "paid_out")
                                                {
                                                    <form method="post" action="@WriteRoute" style="display:inline;">
                                                        @WriteFields("mark_settlement", TabHref("accounts"))
                                                        <input type="hidden" name="id" value="@Num(settlement.Id)" />
                                                        <input type="hidden" name="status" value="paid_out" />
                                                        <button type="submit" class="btn btn-xs btn-success">Mark paid out</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (_tab == "configure")
        {
            <p class="text-muted">
                Set the <strong>default</strong> gateway and credentials. All <em>enabled</em> gateways still appear in the customer
                “Pay with” picker (cards, BNPL, JazzCash, crypto). Replace dummy keys with live credentials before turning off Demo mode.
            </p>

            <div class="epc-pay-section">
                <h4>Active gateway</h4>
                <div class="body" style="padding:12px 14px;">
                    @if (_desk.ActiveGateway is not null)
                    {
                        <strong>Active:</strong> @_desk.ActiveGateway.DisplayName <code>@_desk.ActiveGateway.Handler</code>
                    }
                    else
                    {
                        <span class="text-warning">No gateway active — select one below</span>
                    }
                </div>
            </div>

            <div class="epc-scp-users-workspace">
                <div class="epc-scp-users-workspace__list epc-pay-section">
                    <h4>Select gateway</h4>
                    <div class="body" style="padding:12px 14px;">
                        <ul class="list-unstyled" style="margin:0;">
                            @foreach (var gateway in _desk.Gateways.Where(g => g.Enabled))
                            {
                                <li class="@(_selected?.Id == gateway.Id ? "active" : "")" style="padding:4px 0;">
                                    <a href="@ConfigureHref(gateway.Id)">@gateway.DisplayName</a>
                                    <code>@gateway.Handler</code>
                                    @if (gateway.Active)
                                    {
                                        <span class="label label-success">Default</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="epc-scp-users-workspace__detail epc-pay-section">
                    <h4>Credentials &amp; options</h4>
                    <div class="body" style="padding:12px 14px;">
                    @if (_selected is null)
                    {
                        <p class="text-muted">Select a gateway</p>
                    }
                    else
                    {
                        <form method="post" action="@WriteRoute">
                            @WriteFields("save_config", ConfigureHref(_selected.Id))
                            <input type="hidden" name="system_id" value="@Num(_selected.Id)" />
                            @foreach (var parameter in _selected.Parameters)
                            {
                                var value = _selected.Values.TryGetValue(parameter.Name, out var saved) ? saved : "";
                                <div class="form-group">
                                    <label>@parameter.Caption</label>
                                    @if (parameter.Type == "checkbox")
                                    {
                                        <div>
                                            <input type="checkbox" name="param_@parameter.Name" value="1"
                                                   checked="@(value is not ("" or "0" or "false"))" />
                                        </div>
                                    }
                                    else
                                    {
                                        <input type="@(parameter.Type == "password" ? "password" : "text")"
                                               class="form-control" name="param_@parameter.Name" value="@value" />
                                    }
                                </div>
                                <div class="hr-line-dashed"></div>
                            }
                            @if (_selected.Description.Length > 0)
                            {
                                <div class="well well-sm">@_selected.Description</div>
                            }
                            <p class="text-muted"><small>Webhook: <code>@WebhookUrl(_selected.Handler)</code></small></p>
                            <button type="submit" class="btn btn-success" disabled="@(!_isAdmin)">Save &amp; activate</button>
                        </form>
                    }
                    </div>
                </div>
            </div>
        }
    </div>
</PhpCpDesktopChrome>

@code {
    private const string PhpTab = "/CP/shop/payments";
    private const string WriteRoute = "/cp/payments/write";

    private static readonly string[] DashboardRegions =
    [
        PhpPaymentGatewayCatalog.RegionGcc,
        PhpPaymentGatewayCatalog.RegionPakistan,
        PhpPaymentGatewayCatalog.RegionCrypto,
        PhpPaymentGatewayCatalog.RegionInternational
    ];

    /// <summary>PHP <c>epc_pay_accounts_owner_types()</c>.</summary>
    private static readonly (string Key, string Label)[] OwnerTypes =
    [
        ("platform", "Platform (store default)"),
        ("office", "Shop / office"),
        ("vendor", "Marketplace vendor")
    ];

    private bool _isAdmin;
    private string _tab = "dashboard";
    private string _flashOk = "";
    private string _flashErr = "";
    private string _origin = "";
    private CpPaymentsDesk _desk = CpPaymentsDesk.Unavailable("");
    private CpPaymentAccount? _editAccount;
    private CpPaymentGateway? _selected;

    private CpPaymentAccount Account => _editAccount ?? CpPaymentAccount.Empty;

    private static string Num(long value) => value.ToString(CultureInfo.InvariantCulture);

    private static string Money(decimal value) => value.ToString("0.00", CultureInfo.InvariantCulture);

    private static string TabHref(string tab) => "/cp/payment-gateways-app?tab=" + tab;

    private static string AccountHref(long id)
        => "/cp/payment-gateways-app?tab=accounts&account_id=" + Num(id);

    private static string ConfigureHref(long systemId)
        => "/cp/payment-gateways-app?tab=configure&system_id=" + Num(systemId);

    private string WebhookUrl(string handler)
        => _origin + "/content/shop/finance/payment_systems/" + handler + "/notification.php";

    private static RenderFragment WriteFields(string action, string returnUrl) => @<text>
        <input type="hidden" name="confirmWrites" value="true" />
        <input type="hidden" name="action" value="@action" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
    </text>;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _origin = ctx.Request.Scheme + "://" + ctx.Request.Host.Value;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        var requestedTab = query.TryGetValue("tab", out var tabRaw) ? tabRaw.ToString() : "";
        _tab = requestedTab is "accounts" or "configure" or "legacy" ? requestedTab : "dashboard";

        if (!_isAdmin)
        {
            return;
        }

        _desk = await Desk.LoadDeskAsync(30, ctx.RequestAborted);

        if (query.TryGetValue("account_id", out var accountRaw)
            && long.TryParse(accountRaw.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var accountId)
            && accountId > 0)
        {
            _editAccount = _desk.Accounts.FirstOrDefault(a => a.Id == accountId);
        }

        if (query.TryGetValue("system_id", out var systemRaw)
            && long.TryParse(systemRaw.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var systemId)
            && systemId > 0)
        {
            _selected = _desk.Gateways.FirstOrDefault(g => g.Id == systemId);
        }
        else
        {
            _selected = _desk.ActiveGateway;
        }
    }
}
