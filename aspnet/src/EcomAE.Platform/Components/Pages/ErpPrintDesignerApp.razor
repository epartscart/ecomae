@page "/erp/print-designer-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using System.Net
@using System.Text.Json
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Print designer · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Print designer" BreadcrumbArea="Setup" BreadcrumbTab="Print designer">

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Print templates" Subtitle="Open a row for page setup and full HTML/CSS bodies. Save writes here." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Print template KPIs">
        <div class="kpi"><div class="lbl">Templates</div><div class="val">@_count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Defaults</div><div class="val">@_defaults.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Doc types</div><div class="val">@_docTypes.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Doc type</dt><dd>@(string.IsNullOrWhiteSpace(_opened.DocType) ? "—" : _opened.DocType)</dd>
                <dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Name) ? "—" : _opened.Name)</dd>
                <dt>Page</dt><dd>@(string.IsNullOrWhiteSpace(_opened.PageSize) ? "—" : _opened.PageSize)</dd>
                <dt>Orientation</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Orientation) ? "—" : _opened.Orientation)</dd>
                <dt>Margins</dt><dd>@_opened.MarginTop.ToString(CultureInfo.InvariantCulture)/@_opened.MarginRight.ToString(CultureInfo.InvariantCulture)/@_opened.MarginBottom.ToString(CultureInfo.InvariantCulture)/@_opened.MarginLeft.ToString(CultureInfo.InvariantCulture) mm</dd>
                <dt>Font</dt><dd>@(string.IsNullOrWhiteSpace(_opened.FontFamily) ? "—" : _opened.FontFamily) @(_opened.FontSize > 0 ? _opened.FontSize.ToString(CultureInfo.InvariantCulture) + "pt" : "")</dd>
                <dt>Colors</dt><dd>@(string.IsNullOrWhiteSpace(_opened.PrimaryColor) ? "—" : _opened.PrimaryColor) / @(string.IsNullOrWhiteSpace(_opened.SecondaryColor) ? "—" : _opened.SecondaryColor)</dd>
                <dt>Logo</dt><dd>@(string.IsNullOrWhiteSpace(_opened.LogoPosition) ? "—" : _opened.LogoPosition)</dd>
                <dt>Default</dt><dd>@(_opened.IsDefault ? "yes" : "no")</dd>
                <dt>Status</dt><dd>@(_opened.Active ? "active" : "inactive")</dd>
                <dt>Updated</dt><dd>@FormatDate(_opened.TimeUpdated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Full HTML/CSS bodies are available for editing. Save writes here.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.HeaderHtmlExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">header HTML</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.HeaderHtmlExcerpt</pre>
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No header HTML yet.</p>
            }
            @if (!string.IsNullOrWhiteSpace(_opened.FooterHtmlExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">footer HTML</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.FooterHtmlExcerpt</pre>
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No footer HTML yet.</p>
            }
            @if (!string.IsNullOrWhiteSpace(_opened.CustomCssExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">custom CSS</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.CustomCssExcerpt</pre>
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No custom CSS yet.</p>
            }
            <p class="text-muted" style="margin:1rem 0 .35rem">print preview</p>
            <iframe title="Print template preview"
                    sandbox
                    srcdoc="@PreviewDocument"
                    style="width:100%;min-height:22rem;border:1px solid #c5d4de;background:#fff"></iframe>
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-type siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Doc type</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.Name) ? "—" : sib.Name)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.DocType) ? "—" : sib.DocType)</td>
                                <td>@(sib.Active ? "active" : "inactive")</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "template_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-type siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Doc type</th>
                    <th>Name</th>
                    <th>Page</th>
                    <th>Orientation</th>
                    <th>Default</th>
                    <th>Status</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_templates.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No print templates yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _templates)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@(string.IsNullOrWhiteSpace(row.DocType) ? "—" : row.DocType)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Name) ? $"#{row.Id.ToString(CultureInfo.InvariantCulture)}" : row.Name)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.PageSize) ? "—" : row.PageSize)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Orientation) ? "—" : row.Orientation)</td>
                            <td>@(row.IsDefault ? "yes" : "—")</td>
                            <td><span class="label label-default">@(row.Active ? "active" : "inactive")</span></td>
                            <td>@FormatDate(row.TimeUpdated)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "template_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source.
        @if (!string.IsNullOrWhiteSpace(_message)) { <span> @_message</span> }
    </div>
</PhpErpDesktopChrome>

@if (_opened is not null)
{
    <ErpPhpCreateWell Title="Edit print template">
        <form method="post" action="/erp/print-designer/save" style="display:grid;grid-template-columns:repeat(3,minmax(180px,1fr));gap:8px;align-items:end;margin-bottom:1rem;">
            <input type="hidden" name="id" value="@_opened.Id.ToString(CultureInfo.InvariantCulture)" />
            <input type="hidden" name="returnUrl" value="@OpenedReturnHref" />
            <input type="hidden" name="confirmWrites" value="true" />
            <label>Doc type <input class="form-control input-sm" name="doc_type" value="@_opened.DocType" /></label>
            <label>Name <input class="form-control input-sm" name="name" value="@_opened.Name" /></label>
            <label>Page <input class="form-control input-sm" name="page_size" value="@_opened.PageSize" /></label>
            <label>Orientation <input class="form-control input-sm" name="orientation" value="@_opened.Orientation" /></label>
            <label>Font <input class="form-control input-sm" name="font_family" value="@_opened.FontFamily" /></label>
            <label>Font size <input class="form-control input-sm" name="font_size" value="@_opened.FontSize" /></label>
            <label>Primary color <input class="form-control input-sm" name="primary_color" value="@_opened.PrimaryColor" /></label>
            <label>Secondary color <input class="form-control input-sm" name="secondary_color" value="@_opened.SecondaryColor" /></label>
            <label>Logo position <input class="form-control input-sm" name="logo_position" value="@_opened.LogoPosition" /></label>
            <label>Margin top <input class="form-control input-sm" name="margin_top" value="@_opened.MarginTop" /></label>
            <label>Margin right <input class="form-control input-sm" name="margin_right" value="@_opened.MarginRight" /></label>
            <label>Margin bottom <input class="form-control input-sm" name="margin_bottom" value="@_opened.MarginBottom" /></label>
            <label>Margin left <input class="form-control input-sm" name="margin_left" value="@_opened.MarginLeft" /></label>
            <label>Logo max height <input class="form-control input-sm" name="logo_max_height" value="@_opened.LogoMaxHeight" /></label>
            <label>Body columns <input class="form-control input-sm" name="body_columns" value="@_opened.BodyColumns" /></label>
            <label>Signature labels <input class="form-control input-sm" name="signature_labels" value="@_opened.SignatureLabels" /></label>
            <label><input type="checkbox" name="show_terms" value="1" checked="@_opened.ShowTerms" /> Show terms</label>
            <label><input type="checkbox" name="show_bank_details" value="1" checked="@_opened.ShowBankDetails" /> Show bank details</label>
            <label><input type="checkbox" name="show_signature_line" value="1" checked="@_opened.ShowSignatureLine" /> Signature line</label>
            <label><input type="checkbox" name="show_qr_code" value="1" checked="@_opened.ShowQrCode" /> QR code</label>
            <label><input type="checkbox" name="show_barcode" value="1" checked="@_opened.ShowBarcode" /> Barcode</label>
            <label style="grid-column:span 3">Header HTML <textarea class="form-control input-sm" name="header_html" rows="6">@_opened.HeaderHtmlExcerpt</textarea><small class="text-muted">Merge fields: @MergeFields</small></label>
            <label style="grid-column:span 3">Footer HTML <textarea class="form-control input-sm" name="footer_html" rows="6">@_opened.FooterHtmlExcerpt</textarea><small class="text-muted">Merge fields: @MergeFields</small></label>
            <label style="grid-column:span 3">Terms HTML <textarea class="form-control input-sm" name="terms_html" rows="6">@_opened.TermsHtmlExcerpt</textarea></label>
            <label style="grid-column:span 3">Bank details HTML <textarea class="form-control input-sm" name="bank_details_html" rows="6">@_opened.BankDetailsHtmlExcerpt</textarea></label>
            <label style="grid-column:span 3">Custom CSS <textarea class="form-control input-sm" name="custom_css" rows="8">@_opened.CustomCssExcerpt</textarea></label>
            <label><input type="checkbox" name="is_default" value="1" checked="@_opened.IsDefault" /> Default</label>
            <button type="submit" class="btn btn-primary btn-sm">Save template</button>
        </form>
    </ErpPhpCreateWell>
}

<ErpPhpCreateWell Title="New print template">
<form method="post" action="/erp/print-designer/save" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                <input type="hidden" name="returnUrl" value="@(_openedId > 0 ? _listHref + "?template_id=" + _openedId.ToString(CultureInfo.InvariantCulture) : _listHref)" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>Doc type
                    <select class="form-control input-sm" name="doc_type">
                        <option value="invoice">invoice</option>
                        <option value="sales_order">sales_order</option>
                        <option value="purchase_order">purchase_order</option>
                        <option value="payment_voucher">payment_voucher</option>
                        <option value="receipt_voucher">receipt_voucher</option>
                        <option value="journal_voucher">journal_voucher</option>
                        <option value="delivery_note">delivery_note</option>
                        <option value="quotation">quotation</option>
                        <option value="report">report</option>
                    </select>
                </label>
                <label>Name <input class="form-control input-sm" name="name" style="width:180px;" /></label>
                <label>Page
                    <select class="form-control input-sm" name="page_size">
                        <option value="A4">A4</option>
                        <option value="Letter">Letter</option>
                        <option value="A5">A5</option>
                    </select>
                </label>
                <label>Orientation
                    <select class="form-control input-sm" name="orientation">
                        <option value="portrait">portrait</option>
                        <option value="landscape">landscape</option>
                    </select>
                </label>
                <label><input type="checkbox" name="is_default" value="1" /> Default</label>
                <button type="submit" class="btn btn-primary btn-sm">Save template</button>
            </form>
</ErpPhpCreateWell>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=setup&tab=print_designer";
    private const string _listHref = "/erp/print-designer-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpPrintTemplateDigest> _templates = [];
    private int _count;
    private int _defaults;
    private int _docTypes;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpPrintTemplateDetail? _opened;
    private IReadOnlyList<ErpPrintTemplateDigest> _openedSiblings = [];
    private const string MergeFields = "{{company_name}}, {{trn}}, {{address}}, {{phone}}, {{email}}, {{doc_no}}, {{doc_date}}, {{due_date}}, {{customer_name}}, {{supplier_name}}, {{currency}}, {{total}}, {{page}}, {{total_pages}}, {{printed_by}}, {{printed_date}}";

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.Name)
            ? _opened.Name
            : ("Template #" + _opened.Id.ToString(CultureInfo.InvariantCulture)));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?template_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    private string PreviewDocument
    {
        get
        {
            if (_opened is null) return string.Empty;

            var header = _opened.HeaderHtmlExcerpt;
            var footer = _opened.FooterHtmlExcerpt;
            var body = RenderPreviewTable(_opened.BodyColumns);
            var terms = _opened.TermsHtmlExcerpt;
            var bank = _opened.BankDetailsHtmlExcerpt;
            var css = _opened.CustomCssExcerpt;
            var sections = string.Join(
                Environment.NewLine,
                new[] { header, "<main><h2>Print template preview</h2>", body, terms, bank, "</main>", footer }
                    .Where(section => !string.IsNullOrWhiteSpace(section)));

            return $$"""
                <!doctype html>
                <html lang="en">
                <head>
                  <meta charset="utf-8">
                  <style>
                    @page { size: {{_opened.PageSize}} {{_opened.Orientation}}; margin: {{_opened.MarginTop}}mm {{_opened.MarginRight}}mm {{_opened.MarginBottom}}mm {{_opened.MarginLeft}}mm; }
                    :root { --primary: {{_opened.PrimaryColor}}; --secondary: {{_opened.SecondaryColor}}; }
                    body { color: var(--primary); font-family: "{{_opened.FontFamily}}", Arial, sans-serif; font-size: {{_opened.FontSize}}pt; margin: 0; }
                    h2 { color: var(--secondary); }
                    {{css}}
                  </style>
                </head>
                <body>{{sections}}</body>
                </html>
                """;
        }
    }

    private static string RenderPreviewTable(string columnsJson)
    {
        if (string.IsNullOrWhiteSpace(columnsJson)) return "<p>No body columns configured.</p>";

        try
        {
            using var document = JsonDocument.Parse(columnsJson);
            if (document.RootElement.ValueKind != JsonValueKind.Array) return "<p>No body columns configured.</p>";

            var headers = new List<string>();
            var cells = new List<string>();
            foreach (var column in document.RootElement.EnumerateArray())
            {
                if (column.ValueKind != JsonValueKind.Object) continue;
                var label = column.TryGetProperty("label", out var labelValue)
                    ? labelValue.GetString()
                    : null;
                var key = column.TryGetProperty("key", out var keyValue)
                    ? keyValue.GetString()
                    : null;
                var text = string.IsNullOrWhiteSpace(label) ? key : label;
                if (!string.IsNullOrWhiteSpace(text))
                {
                    var style = ColumnStyle(column);
                    headers.Add("<th" + style + ">" + WebUtility.HtmlEncode(text) + "</th>");
                    cells.Add("<td" + style + ">Sample value</td>");
                }
            }

            if (headers.Count == 0) return "<p>No body columns configured.</p>";
            return "<table class=\"print-table\"><thead><tr>" + string.Concat(headers) +
                   "</tr></thead><tbody><tr>" +
                   string.Concat(cells) +
                   "</tr></tbody></table>";
        }
        catch (JsonException)
        {
            return "<p>Body columns JSON is invalid.</p>";
        }
    }

    private static string ColumnStyle(JsonElement column)
    {
        var styles = new List<string>();
        if (column.TryGetProperty("width", out var widthValue)
            && widthValue.ValueKind == JsonValueKind.String
            && decimal.TryParse(widthValue.GetString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var width)
            && width is > 0 and <= 100)
        {
            styles.Add("width:" + width.ToString("0.##", CultureInfo.InvariantCulture) + "%");
        }

        if (column.TryGetProperty("align", out var alignValue)
            && alignValue.ValueKind == JsonValueKind.String)
        {
            var align = alignValue.GetString()?.ToLowerInvariant();
            if (align is "left" or "center" or "right")
            {
                styles.Add("text-align:" + align);
            }
        }

        return styles.Count == 0 ? string.Empty : " style=\"" + string.Join(";", styles) + "\"";
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "template_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpPrintTemplatesAsync(200, ctx.RequestAborted);
        _templates = result.Templates;
        _count = result.Count;
        _defaults = result.DefaultCount;
        _docTypes = result.DocTypeCount;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpPrintTemplateDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Template;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _templates.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _templates = new[] { openedList }.Concat(_templates.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }

    private static string FormatDate(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }
}
