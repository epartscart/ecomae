    private string OpenedText
    {
        get
        {
            if (_opened is null)
            {
                return string.Empty;
            }

            var text = string.Join(
                "\n",
                _opened.HeaderHtmlExcerpt,
                _opened.FooterHtmlExcerpt,
                _opened.TermsHtmlExcerpt,
                _opened.BankDetailsHtmlExcerpt,
                _opened.BodyColumns,
                _opened.ShowQrCode ? "QR code" : "No QR code");
            return _opened.ShowQrCode
                ? text.Replace("No QR code", "", StringComparison.OrdinalIgnoreCase)
                : text;
        }
    }

    private static string LegacyTaxInvoiceHtml
    {
        get
        {
            var row = ErpDocumentControlRender.DefaultTemplates.First(item => item.Code == "fta_tax_invoice");
            return row.HeaderHtml + row.BodyHtml + row.FooterHtml;
        }
    }

    private string TabClass(string tab) => _tab == tab ? "is-active" : "";

