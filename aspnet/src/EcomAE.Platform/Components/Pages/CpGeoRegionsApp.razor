@page "/cp/geo-regions-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@inject ICpGeoTreeEditorService Geo
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Geo nodes · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<style>
    .epc-geo-actions .panel_a { display:inline-block; text-align:center; text-decoration:none; color:#333; margin-right:14px; vertical-align:top; cursor:pointer; }
    .epc-geo-actions .panel_a_img { width:48px; height:48px; margin:0 auto 4px; border-radius:8px; background:#f1f3f6; display:flex; align-items:center; justify-content:center; font-size:22px; color:#3498db; }
    .epc-geo-actions .panel_a_caption { font-size:12px; }
    #container_A { height:350px; overflow:auto; border:1px solid #e4e5e7; background:#fff; }
    #container_A ul { list-style:none; margin:0; padding-left:18px; }
    #container_A > ul { padding-left:4px; }
    #container_A li > .epc-geo-row { display:flex; align-items:center; gap:6px; padding:3px 6px; cursor:pointer; border-radius:3px; }
    #container_A li > .epc-geo-row:hover { background:#f5f7fa; }
    #container_A li.epc-sel > .epc-geo-row { background:#dbeeff; }
    #container_A .epc-geo-tog { width:14px; color:#888; font-size:11px; text-align:center; }
    #container_A li.epc-closed > ul { display:none; }
    #container_A .epc-geo-val { flex:1; }
    #container_A .epc-geo-val input { width:100%; border:1px solid #3498db; padding:1px 4px; font:inherit; }
    #container_A .epc-geo-lvl { color:#999; font-size:11px; }
    #container_A .epc-geo-mv { color:#999; font-size:11px; visibility:hidden; }
    #container_A li.epc-sel > .epc-geo-row .epc-geo-mv { visibility:visible; }
</style>

<PhpCpDesktopChrome IsAdmin="_isAdmin">
    @if (!_isAdmin)
    {
        <div class="col-lg-12"><div class="hpanel"><div class="panel-body">
            <div class="alert alert-warning" role="status">Sign in to the Control Panel to manage geo nodes. <a href="/cp/login?returnUrl=/cp/geo-regions-app">Login</a></div>
        </div></div></div>
    }
    else
    {
        @* ---- geo_tree.php twin ---- *@
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    Geography (countries, regions, cities)
                    <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
                </div>
                <div class="panel-body epc-geo-actions">
                    <a class="panel_a" onclick="add_new_country();" href="javascript:void(0);"><div class="panel_a_img"><i class="fa fa-flag"></i></div><div class="panel_a_caption">Add country</div></a>
                    <a class="panel_a" onclick="add_new_region();" href="javascript:void(0);"><div class="panel_a_img"><i class="fa fa-shield"></i></div><div class="panel_a_caption">Add region</div></a>
                    <a class="panel_a" onclick="add_new_city();" href="javascript:void(0);"><div class="panel_a_img"><i class="fa fa-building"></i></div><div class="panel_a_caption">Add city</div></a>
                    <a class="panel_a" onclick="delete_selected_item();" href="javascript:void(0);"><div class="panel_a_img"><i class="fa fa-trash-o"></i></div><div class="panel_a_caption">Delete</div></a>
                    <a class="panel_a" onclick="unselect_tree();" href="javascript:void(0);"><div class="panel_a_img"><i class="fa fa-square-o"></i></div><div class="panel_a_caption">Unselect</div></a>
                    <a class="panel_a" onclick="save_tree();" href="javascript:void(0);"><div class="panel_a_img"><i class="fa fa-save"></i></div><div class="panel_a_caption">Save</div></a>
                    <a class="panel_a" href="/cp/offices-app"><div class="panel_a_img"><i class="fa fa-building-o"></i></div><div class="panel_a_caption">Offices</div></a>
                    <a class="panel_a" href="/cp"><div class="panel_a_img"><i class="fa fa-power-off"></i></div><div class="panel_a_caption">Exit</div></a>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_flashOk)) { <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div> }
        @if (!string.IsNullOrWhiteSpace(_flashErr)) { <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div> }

        <form name="form_to_save" id="form_to_save" method="post" action="/cp/geo-regions/write" style="display:none">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@_listHref" />
            <input type="hidden" name="lang_code" value="en" />
            <input name="save_tree" id="save_tree" type="hidden" value="ok" />
            <input name="treeJson" id="tree_json" type="hidden" value="" />
        </form>

        <div class="col-lg-6">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Geo nodes tree</div>
                <div class="panel-body">
                    <div id="container_A"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Help</div>
                <div class="panel-body">
                    Select a node and use the toolbar: a region is added into the selected country, a city into the selected region.
                    Double-click a node to rename it; use the arrows on the selected node to change its order. Nodes removed here are deleted from the database on save.
                    Nodes: @_page.Nodes.Count.ToString(CultureInfo.InvariantCulture).
                </div>
            </div>
        </div>

        <script>
            var next_id = @_page.NextId.ToString(CultureInfo.InvariantCulture);
            var saved_tree = @((MarkupString)_page.ToTreeJson());
            var epcSel = null;
            var LEVEL_NAMES = { 1: 'country', 2: 'region', 3: 'city' };

            function epcNode(item, level) {
                var li = document.createElement('li');
                li.setAttribute('data-id', item.id);
                li.setAttribute('data-lang', item.value_lang_str_id || '0');
                li.setAttribute('data-from-server', item.from_server ? '1' : '0');
                li.setAttribute('data-level', level);
                var row = document.createElement('div');
                row.className = 'epc-geo-row';
                row.innerHTML = '<span class="epc-geo-tog"></span><span class="epc-geo-val"></span><span class="epc-geo-lvl"></span>' +
                    '<span class="epc-geo-mv" onclick="move_selected(-1);event.stopPropagation();" title="Up">&#9650;</span>' +
                    '<span class="epc-geo-mv" onclick="move_selected(1);event.stopPropagation();" title="Down">&#9660;</span>';
                row.querySelector('.epc-geo-val').textContent = item.value || '';
                row.querySelector('.epc-geo-lvl').textContent = LEVEL_NAMES[level] || ('level ' + level);
                row.onclick = function () { epcSelect(li); };
                row.ondblclick = function (e) { e.stopPropagation(); epcEdit(li); };
                row.querySelector('.epc-geo-tog').onclick = function (e) { e.stopPropagation(); li.classList.toggle('epc-closed'); epcRefreshToggle(li); };
                li.appendChild(row);
                var ul = document.createElement('ul');
                (item.data || []).forEach(function (c) { ul.appendChild(epcNode(c, level + 1)); });
                li.appendChild(ul);
                epcRefreshToggle(li);
                return li;
            }
            function epcRefreshToggle(li) {
                var has = li.querySelector(':scope > ul > li') !== null;
                li.querySelector(':scope > .epc-geo-row > .epc-geo-tog').textContent = has ? (li.classList.contains('epc-closed') ? '+' : '\u2212') : '';
            }
            function epcSelect(li) {
                if (epcSel) epcSel.classList.remove('epc-sel');
                epcSel = li;
                if (li) li.classList.add('epc-sel');
            }
            function epcEdit(li) {
                var val = li.querySelector(':scope > .epc-geo-row > .epc-geo-val');
                if (val.querySelector('input')) return;
                var old = val.textContent;
                var inp = document.createElement('input');
                inp.type = 'text'; inp.value = old;
                function stop(commit) { val.textContent = commit && inp.value.trim() !== '' ? inp.value.trim() : old; }
                inp.onblur = function () { stop(true); };
                inp.onkeydown = function (e) { if (e.key === 'Enter') { e.preventDefault(); inp.blur(); } if (e.key === 'Escape') { stop(false); } };
                val.textContent = ''; val.appendChild(inp); inp.focus(); inp.select();
            }
            function epcAdd(parentLi, level, caption) {
                var ul = parentLi ? parentLi.querySelector(':scope > ul') : document.querySelector('#container_A > ul');
                var li = epcNode({ id: next_id, value: caption, value_lang_str_id: '0', from_server: 0, data: [] }, level);
                ul.appendChild(li);
                next_id++;
                if (parentLi) { parentLi.classList.remove('epc-closed'); epcRefreshToggle(parentLi); }
                epcSelect(li);
                epcEdit(li);
            }
            function add_new_country() { epcAdd(null, 1, 'New country'); }
            function add_new_region() {
                if (!epcSel || epcSel.getAttribute('data-level') !== '1') { alert('Select a country to add a region into.'); return; }
                epcAdd(epcSel, 2, 'New region');
            }
            function add_new_city() {
                if (!epcSel || epcSel.getAttribute('data-level') !== '2') { alert('Select a region to add a city into.'); return; }
                epcAdd(epcSel, 3, 'New city');
            }
            function delete_selected_item() {
                if (!epcSel) return;
                var parent = epcSel.parentNode.closest('li');
                epcSel.parentNode.removeChild(epcSel);
                epcSel = null;
                if (parent) epcRefreshToggle(parent);
            }
            function move_selected(dir) {
                if (!epcSel) return;
                var sib = dir < 0 ? epcSel.previousElementSibling : epcSel.nextElementSibling;
                if (!sib) return;
                if (dir < 0) epcSel.parentNode.insertBefore(epcSel, sib); else epcSel.parentNode.insertBefore(sib, epcSel);
            }
            function unselect_tree() { epcSelect(null); }
            function epcSerialize(ul, parentId, level) {
                var out = [];
                Array.prototype.forEach.call(ul.children, function (li) {
                    var kids = epcSerialize(li.querySelector(':scope > ul'), parseInt(li.getAttribute('data-id'), 10), level + 1);
                    out.push({
                        id: parseInt(li.getAttribute('data-id'), 10),
                        value: li.querySelector(':scope > .epc-geo-row > .epc-geo-val').textContent,
                        value_lang_str_id: li.getAttribute('data-lang'),
                        from_server: parseInt(li.getAttribute('data-from-server'), 10),
                        $level: level, $parent: parentId, $count: kids.length,
                        data: kids
                    });
                });
                return out;
            }
            function save_tree() {
                var dump = epcSerialize(document.querySelector('#container_A > ul'), 0, 1);
                if (dump.length === 0) { alert('At least one country is required.'); return; }
                document.getElementById('tree_json').value = JSON.stringify(dump);
                document.getElementById('form_to_save').submit();
            }
            function tree_start_init() {
                var box = document.getElementById('container_A');
                var ul = document.createElement('ul');
                saved_tree.forEach(function (n) { ul.appendChild(epcNode(n, 1)); });
                box.appendChild(ul);
            }
            tree_start_init();
        </script>
    }
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/geo/nodes";
    private const string _listHref = "/cp/geo-regions-app";
    private bool _isAdmin;
    private string _flashOk = "";
    private string _flashErr = "";
    private CpGeoTreePage _page = new([], 1);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        _page = await Geo.LoadAsync(ctx.RequestAborted);
    }
}
