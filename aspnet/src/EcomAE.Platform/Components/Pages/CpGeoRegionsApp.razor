@page "/cp/geo-regions-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Geo / regions · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Geo / regions
                <a class="btn btn-xs btn-default pull-right" href="/cp/offices-app">Offices</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" style="margin-right:.4rem">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Geo tree used by offices and checkout. Save the tree here. Webix editor chrome stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/geo-regions-app" IsAdmin="_isAdmin" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/geo-regions/write" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/geo-regions-app" />
            <label>Tree JSON
                <textarea name="treeJson" required rows="8" style="width:100%;font-family:ui-monospace,monospace;font-size:.82rem" placeholder='[{"id":1,"level":1,"value":"UAE","value_lang_str_id":"0","parent":0,"from_server":1,"count":1}]'></textarea>
            </label>
            <p style="margin:0;color:#475569;font-size:.82rem">Webix hierarchy or linear list. Nodes not listed are deleted. Empty tree is refused.</p>
            <button type="submit">Save tree</button>
        </form>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Nodes</div>
            <div class="panel-body">
                <p class="help-block">@_summary.NodeCount.ToString(CultureInfo.InvariantCulture) nodes · level 1 @_summary.Level1Count.ToString(CultureInfo.InvariantCulture) · level 2 @_summary.Level2Count.ToString(CultureInfo.InvariantCulture) · mapped offices @_summary.MappedOfficeCount.ToString(CultureInfo.InvariantCulture).</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Level</th>
                                <th>Parent</th>
                                <th>Order</th>
                                <th>Children</th>
                                <th>Lang id</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_rows.Count == 0)
                        {
                            <tr><td colspan="6">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr>
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.Level.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.Parent.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.ChildCount.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.ValueLangId.ToString(CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/geo/nodes";
    private bool _isAdmin;
    private CpGeoRegionsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpGeoRegionsRowDigest> _rows = [];
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpGeoRegionsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Nodes;
    }
}
