@page "/cp/geo-regions-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Geo / regions · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Geo / regions
                <a class="btn btn-xs btn-default pull-right" href="/cp/offices-app">Offices</a>
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)" style="margin-right:.4rem">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Open a node for a caption excerpt. Save the tree here. Full lang translations and Webix editor chrome stay on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/geo-regions-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedNode is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/geo-regions/write" style="display:flex;flex-direction:column;gap:.45rem;margin:0 0 1rem;max-width:52rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/geo-regions-app" />
            <label>Tree JSON
                <textarea name="treeJson" required rows="8" style="width:100%;font-family:ui-monospace,monospace;font-size:.82rem" placeholder='[{"id":1,"level":1,"value":"UAE","value_lang_str_id":"0","parent":0,"from_server":1,"count":1}]'></textarea>
            </label>
            <p style="margin:0;color:#475569;font-size:.82rem">Webix hierarchy or linear list. Nodes not listed are deleted. Empty tree is refused.</p>
            <button type="submit">Save tree</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Geo region KPIs">
        <div class="kpi"><div class="lbl">Nodes</div><div class="val">@_summary.NodeCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Level 1</div><div class="val">@_summary.Level1Count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Level 2</div><div class="val">@_summary.Level2Count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Mapped offices</div><div class="val">@_summary.MappedOfficeCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedNode is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @OpenedCaption
                    <span class="label label-default pull-right">level @_openedNode.Level.ToString(CultureInfo.InvariantCulture)</span>
                </div>
                <div class="panel-body">
                    <p>Parent @_openedNode.Parent.ToString(CultureInfo.InvariantCulture)
                        · order @_openedNode.SortOrder.ToString(CultureInfo.InvariantCulture)
                        · children @_openedNode.ChildCount.ToString(CultureInfo.InvariantCulture)
                        · lang @_openedNode.ValueLangId.ToString(CultureInfo.InvariantCulture)</p>
                    @if (!string.IsNullOrWhiteSpace(_openedNode.CaptionExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedNode.CaptionExcerpt</pre>
                        @if (_openedNode.CaptionLen > _openedNode.CaptionExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_openedNode.CaptionExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedNode.CaptionLen.ToString(CultureInfo.InvariantCulture) chars). Full lang translation stays on the Classic twin.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No caption excerpt yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Same-parent siblings</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Level</th>
                                    <th>Parent</th>
                                    <th>Order</th>
                                    <th>Children</th>
                                    <th>Lang id</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="7">No same-parent siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@sib.Level.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@sib.Parent.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@sib.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@sib.ChildCount.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@sib.ValueLangId.ToString(CultureInfo.InvariantCulture)</td>
                                            <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "geo_id", sib.Id)">Open</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Nodes</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Level</th>
                                <th>Parent</th>
                                <th>Order</th>
                                <th>Children</th>
                                <th>Lang id</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!_isAdmin)
                        {
                            <tr><td colspan="7">Sign in for live data.</td></tr>
                        }
                        else if (_rows.Count == 0)
                        {
                            <tr><td colspan="7">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.Level.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.Parent.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.ChildCount.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.ValueLangId.ToString(CultureInfo.InvariantCulture)</td>
                                    <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "geo_id", row.Id)">Open</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/geo/nodes";
    private bool _isAdmin;
    private CpGeoRegionsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpGeoRegionsRowDigest> _rows = [];
    private string _flashOk = "";
    private string _flashErr = "";
    private string _listHref = "/cp/geo-regions-app";
    private long _openedId;
    private CpGeoRegionsDetail? _openedNode;
    private IReadOnlyList<CpGeoRegionsRowDigest> _openedSiblings = [];

    private string OpenedCaption => _openedNode is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedNode.CaptionExcerpt)
            ? ("Node #" + _openedNode.Id.ToString(CultureInfo.InvariantCulture))
            : _openedNode.CaptionExcerpt);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "geo_id");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpGeoRegionsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Nodes;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpGeoRegionsDetailAsync(_openedId, ctx.RequestAborted);
            _openedNode = detail.Node;
            _openedSiblings = detail.Siblings;
            if (_openedNode is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }
}
