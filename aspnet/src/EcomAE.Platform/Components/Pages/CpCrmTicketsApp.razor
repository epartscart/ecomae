@page "/cp/crm-tickets-app"
@page "/erp/crm-tickets-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>CRM tickets · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                CRM tickets
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Create or save a CRM ticket here. Set status on Open. Leftover ERP SLA/create/reply stay on their routes. File attachments stay Classic. This page does not invent a send.</p>
            </div>
        </div>
    </div>
    @if (!_leftoverWrite)
    {
        <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/crm-tickets-app" IsAdmin="_isAdmin" />
    }
    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedTicket is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />
    <ErpPhpFlash Ok="@_ok" Err="@_err" />
    @if (_isAdmin && _tab == "sla")
    {
        <ErpPhpCreateWell Title="Create SLA">
            <form method="post" action="@EcomAeRoutes.ErpSlaCreateForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/crm-tickets-app?tab=sla" />
                <label>SLA code <input class="form-control input-sm" name="sla_code" placeholder="Auto" /></label>
                <label>Client <input class="form-control input-sm" name="client_name" required placeholder="Al Noor" /></label>
                <label>Service <input class="form-control input-sm" name="service_type" placeholder="repairs" /></label>
                <label>Response h <input class="form-control input-sm" name="response_hours" type="number" step="0.01" value="4" /></label>
                <label>Resolution h <input class="form-control input-sm" name="resolution_hours" type="number" step="0.01" value="24" /></label>
                <label>Uptime % <input class="form-control input-sm" name="uptime_pct" type="number" step="0.01" value="99.5" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Create SLA</button>
            </form>
        </ErpPhpCreateWell>
    }
    else if (_isAdmin && _tab == "tickets")
    {
        <ErpPhpCreateWell Title="Create ticket">
            <form method="post" action="@EcomAeRoutes.ErpTicketsCreateForm" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/crm-tickets-app?tab=tickets" />
                <label>Subject <input class="form-control input-sm" name="subject" required placeholder="Resize ring" /></label>
                <label>Client <input class="form-control input-sm" name="client_name" /></label>
                <label>Category <input class="form-control input-sm" name="category" value="general" /></label>
                <label>Priority
                    <select class="form-control input-sm" name="priority">
                        <option value="low">Low</option>
                        <option value="medium" selected>Medium</option>
                        <option value="high">High</option>
                        <option value="critical">Critical</option>
                    </select>
                </label>
                <button type="submit" class="btn btn-primary btn-sm">Create ticket</button>
            </form>
        </ErpPhpCreateWell>
        <ErpPhpCreateWell Title="Reply to ticket">
            <form method="post" action="/erp/tickets/reply" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="/cp/crm-tickets-app?tab=tickets" />
                <label>Ticket id <input class="form-control input-sm" name="ticket_id" type="number" min="1" required value="@(_openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "")" /></label>
                <label>Message <input class="form-control input-sm" name="message" required /></label>
                <label>Author <input class="form-control input-sm" name="author_name" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save reply</button>
            </form>
        </ErpPhpCreateWell>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="CRM ticket KPIs">
        <div class="kpi"><div class="lbl">Tickets</div><div class="val">@_summary.TicketCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open</div><div class="val">@_summary.OpenCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">High priority</div><div class="val">@_summary.HighPriorityCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Opened messages</div><div class="val">@_openedMessages.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedTicket is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedTicket.Subject) ? _openedTicket.Subject : ("Ticket #" + _openedTicket.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedTicket.Status) ? _openedTicket.Status : "—")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedTicket.Priority) ? _openedTicket.Priority : "—")
                        · customer @_openedTicket.CustomerUserId.ToString(CultureInfo.InvariantCulture)
                        · assignee @_openedTicket.AssignedUserId.ToString(CultureInfo.InvariantCulture)
                        · order @_openedTicket.OrderId.ToString(CultureInfo.InvariantCulture)
                        · @(_openedTicket.Active ? "active" : "inactive")</p>
                    <p>Created @_openedTicket.TimeCreated.ToString(CultureInfo.InvariantCulture)
                        · updated @_openedTicket.TimeUpdated.ToString(CultureInfo.InvariantCulture)</p>
                    @if (_isAdmin)
                    {
                        <form method="post" action="/cp/crm/tickets/write" style="margin:1rem 0 0;display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@ErpRecordOpen.Href(_listHref, "ticket_id", _openedTicket.Id)" />
                            <input type="hidden" name="action" value="save_ticket" />
                            <input type="hidden" name="id" value="@_openedTicket.Id.ToString(CultureInfo.InvariantCulture)" />
                            <label>Subject <input type="text" name="subject" maxlength="255" value="@_openedTicket.Subject" /></label>
                            <label>Customer <input type="text" name="customer_user_id" inputmode="numeric" value="@_openedTicket.CustomerUserId.ToString(CultureInfo.InvariantCulture)" /></label>
                            <label>Order <input type="text" name="order_id" inputmode="numeric" value="@_openedTicket.OrderId.ToString(CultureInfo.InvariantCulture)" /></label>
                            <label>Assignee <input type="text" name="assigned_user_id" inputmode="numeric" value="@_openedTicket.AssignedUserId.ToString(CultureInfo.InvariantCulture)" /></label>
                            <label>Status
                                <select name="status">
                                    @foreach (var st in _statuses)
                                    {
                                        @if (string.Equals(st, _openedTicket.Status, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@st" selected>@st</option>
                                        }
                                        else
                                        {
                                            <option value="@st">@st</option>
                                        }
                                    }
                                </select>
                            </label>
                            <label>Priority
                                <select name="priority">
                                    @foreach (var pr in _priorities)
                                    {
                                        @if (string.Equals(pr, _openedTicket.Priority, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@pr" selected>@pr</option>
                                        }
                                        else
                                        {
                                            <option value="@pr">@pr</option>
                                        }
                                    }
                                </select>
                            </label>
                            <label>Note <input type="text" name="message" /></label>
                            <button type="submit" class="btn btn-primary btn-sm">Save ticket</button>
                        </form>
                        <form method="post" action="/cp/crm/tickets/write" style="margin:.75rem 0 0;display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                            <input type="hidden" name="confirmWrites" value="true" />
                            <input type="hidden" name="returnUrl" value="@ErpRecordOpen.Href(_listHref, "ticket_id", _openedTicket.Id)" />
                            <input type="hidden" name="action" value="update_ticket_status" />
                            <input type="hidden" name="id" value="@_openedTicket.Id.ToString(CultureInfo.InvariantCulture)" />
                            <label>Status
                                <select name="status">
                                    @foreach (var st in _statuses)
                                    {
                                        @if (string.Equals(st, _openedTicket.Status, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@st" selected>@st</option>
                                        }
                                        else
                                        {
                                            <option value="@st">@st</option>
                                        }
                                    }
                                </select>
                            </label>
                            <label>Priority
                                <select name="priority">
                                    @foreach (var pr in _priorities)
                                    {
                                        @if (string.Equals(pr, _openedTicket.Priority, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@pr" selected>@pr</option>
                                        }
                                        else
                                        {
                                            <option value="@pr">@pr</option>
                                        }
                                    }
                                </select>
                            </label>
                            <label>Note <input type="text" name="message" /></label>
                            <button type="submit" class="btn btn-primary btn-sm">Update ticket</button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Messages</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Author</th>
                                    <th>Staff</th>
                                    <th>Created</th>
                                    <th>Excerpt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedMessages.Count == 0)
                                {
                                    <tr><td colspan="5">No messages yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var msg in _openedMessages)
                                    {
                                        <tr>
                                            <td>@msg.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@msg.AuthorUserId.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(msg.IsStaff != 0 ? "staff" : "customer")</td>
                                            <td>@msg.TimeCreated.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(msg.BodyExcerpt))
                                                {
                                                    @msg.BodyExcerpt
                                                    @if (msg.BodyLen > msg.BodyExcerpt.Length)
                                                    {
                                                        <span class="text-muted"> (excerpt)</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <text>—</text>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_isAdmin)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">New CRM ticket</div>
                <div class="panel-body">
                    <form method="post" action="/cp/crm/tickets/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@_listHref" />
                        <input type="hidden" name="action" value="save_ticket" />
                        <input type="hidden" name="id" value="0" />
                        <label>Subject <input type="text" name="subject" maxlength="255" /></label>
                        <label>Customer <input type="text" name="customer_user_id" inputmode="numeric" value="0" /></label>
                        <label>Order <input type="text" name="order_id" inputmode="numeric" value="0" /></label>
                        <label>Status
                            <select name="status">
                                <option value="open" selected>open</option>
                                <option value="pending">pending</option>
                                <option value="resolved">resolved</option>
                                <option value="closed">closed</option>
                            </select>
                        </label>
                        <label>Priority
                            <select name="priority">
                                <option value="low">low</option>
                                <option value="normal" selected>normal</option>
                                <option value="high">high</option>
                                <option value="urgent">urgent</option>
                            </select>
                        </label>
                        <label>Note <input type="text" name="message" /></label>
                        <button type="submit" class="btn btn-primary btn-sm">Create ticket</button>
                    </form>
                    <p class="help-block" style="margin:.75rem 0 0">This saves a CRM ticket. Leftover ERP create stays on its route. File attachments stay Classic.</p>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Tickets</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Subject</th>
                                <th>Status</th>
                                <th>Priority</th>
                                <th>Customer</th>
                                <th>Assignee</th>
                                <th>Order</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!_isAdmin)
                        {
                            <tr><td colspan="8">Sign in for live data.</td></tr>
                        }
                        else if (_rows.Count == 0)
                        {
                            <tr><td colspan="8">@(!string.IsNullOrWhiteSpace(_message) ? _message : "No records yet.")</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Subject) ? row.Subject : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Priority) ? row.Priority : "—")</td>
                                    <td>@row.CustomerUserId.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.AssignedUserId.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.OrderId.ToString(CultureInfo.InvariantCulture)</td>
                                    <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "ticket_id", row.Id)">Open</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @if (_leftoverWrite)
    {
        <div class="col-lg-12">
            <p class="help-block">SLA, leftover ERP ticket create, and text replies are live when confirmed. CRM save/status writes here. File attachments stay Classic.</p>
        </div>
    }

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=sales&tab=crm";
    private bool _isAdmin;
    private string _tab = "";
    private bool _leftoverWrite;
    private string _ok = "";
    private string _err = "";
    private CpCrmTicketsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpCrmTicketDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _listHref = "/cp/crm-tickets-app";
    private long _openedId;
    private CpCrmTicketDetail? _openedTicket;
    private IReadOnlyList<CpCrmTicketMessageDigest> _openedMessages = [];
    private static readonly string[] _statuses = ["open", "pending", "resolved", "closed"];
    private static readonly string[] _priorities = ["low", "normal", "high", "urgent"];

    private string OpenedCaption => _openedTicket is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedTicket.Subject)
            ? ("Ticket #" + _openedTicket.Id.ToString(CultureInfo.InvariantCulture))
            : _openedTicket.Subject)
            + (string.IsNullOrWhiteSpace(_openedTicket.Status) ? "" : (" · " + _openedTicket.Status));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var path = ctx.Request.Path.Value;
        var basePath = string.Equals(path, "/erp/crm-tickets-app", StringComparison.OrdinalIgnoreCase)
            ? "/erp/crm-tickets-app"
            : "/cp/crm-tickets-app";
        _tab = (ctx.Request.Query["tab"].ToString() ?? string.Empty).Trim();
        _leftoverWrite = _tab is "sla" or "tickets";
        _listHref = _leftoverWrite && !string.IsNullOrWhiteSpace(_tab)
            ? basePath + "?tab=" + _tab
            : basePath;
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "ticket_id");
        _ok = ctx.Request.Query["ok"].ToString();
        _err = ctx.Request.Query["err"].ToString();
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpCrmTicketsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Tickets;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpCrmTicketsDetailAsync(_openedId, ctx.RequestAborted);
            _openedTicket = detail.Ticket;
            _openedMessages = detail.Messages;
            if (_openedTicket is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
