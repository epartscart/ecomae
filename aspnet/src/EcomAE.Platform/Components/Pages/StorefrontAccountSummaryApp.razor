@page "/storefront/account-summary-app"
@page "/storefront/account-app"
@page "/en/shop/balans"
@page "/shop/balans"
@page "/en/users/account"
@page "/users/account"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Account · @_brand</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        
        .epc-sf-acc-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-sf-acc-cta a {
            display:inline-flex; padding:.5rem .85rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#1c1917; background:#fee2e2;
        }
        .epc-sf-acc-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-sf-acc-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-sf-acc-kpi { background:#fff; border:1px solid #e7e5e4; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-sf-acc-kpi strong { display:block; font-size:1.35rem; font-variant-numeric:tabular-nums; }
        .epc-sf-acc-kpi span { color:#78716c; font-size:.78rem; }
        .epc-sf-acc-table-wrap { background:#fff; border:1px solid #e7e5e4; border-radius:.55rem; overflow:auto; margin-bottom:1rem; }
        .epc-sf-acc-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-sf-acc-table th, .epc-sf-acc-table td { padding:.55rem .7rem; border-bottom:1px solid #f5f5f4; text-align:left; }
        .epc-sf-acc-table th { background:#fafaf9; color:#57534e; font-size:.75rem; text-transform:uppercase; }
        .epc-sf-acc-links { display:flex; gap:.45rem; flex-wrap:wrap; margin-bottom:1rem; }
        .epc-sf-acc-links a {
            display:inline-flex; padding:.5rem .85rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#78350f; background:#fff; border:1px solid #e7e5e4;
        }
        .epc-sf-acc-note { margin-top:1rem; padding:.75rem .9rem; background:#fffbeb; border:1px solid #fde68a; border-radius:.45rem; color:#713f12; font-size:.86rem; }
        .epc-sf-acc-gate { padding:1.25rem; background:#fff; border:1px solid #e7e5e4; border-radius:.55rem; }
        @@media (max-width:900px){ .epc-sf-acc-kpis{grid-template-columns:1fr 1fr;} }
        @@media (max-width:560px){ .epc-sf-acc-kpis{grid-template-columns:1fr;} }
    
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontTenantChrome>

    <PhpStorefrontPageHeader Title="Account"
                            Subtitle="Browse parts, manage your garage, and track recent orders.">
        <a class="btn btn-sm btn-primary" href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpAccount)">Open module</a>
            <a class="btn btn-sm btn-default" href="/storefront/orders-app">My orders</a>
            <a class="btn btn-sm btn-default" href="/storefront/garage-app">Garage</a>
            <a class="btn btn-sm btn-default" href="/storefront/profile-app">Profile</a>
            <a class="btn btn-sm btn-default" href="/storefront/login">Customer login</a>
    </PhpStorefrontPageHeader>

    @if (!_isCustomer)
    {
        <div class="epc-sf-acc-gate">
            <p style="margin:0 0 .75rem;color:#44403c">Sign in with your store account to load account summary.</p>
            <a href="/storefront/login" style="display:inline-flex;padding:.55rem .9rem;border-radius:.4rem;background:#dc2626;color:#fff;font-weight:700;text-decoration:none">Sign in</a>
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpAccount)" style="display:inline-flex;margin-left:.45rem;padding:.55rem .9rem;border-radius:.4rem;border:1px solid #d6d3d1;color:#111;font-weight:700;text-decoration:none">Account</a>
        </div>
    }
    else
    {
        <div class="epc-sf-acc-kpis" aria-label="Account KPIs">
            <div class="epc-sf-acc-kpi"><strong>@_summary.UserId.ToString(CultureInfo.InvariantCulture)</strong><span>User ID</span></div>
            <div class="epc-sf-acc-kpi"><strong>@_summary.Orders.ToString(CultureInfo.InvariantCulture)</strong><span>Orders</span></div>
            <div class="epc-sf-acc-kpi"><strong>@_summary.Sessions.ToString(CultureInfo.InvariantCulture)</strong><span>Sessions</span></div>
            <div class="epc-sf-acc-kpi"><strong>@_summary.GarageVehicles.ToString(CultureInfo.InvariantCulture)</strong><span>Garage vehicles</span></div>
        </div>

        <h2 style="margin:0 0 .5rem;font-size:1rem;">Recent orders</h2>
        <div class="epc-sf-acc-table-wrap">
            <table class="epc-sf-acc-table">
                <thead>
                    <tr><th>Id</th><th>Time</th><th>Paid</th><th>Status</th><th>Created</th></tr>
                </thead>
                <tbody>
                    @if (_recent.Count == 0)
                    {
                        <tr><td colspan="5">No recent orders.</td></tr>
                    }
                    else
                    {
                        @foreach (var o in _recent)
                        {
                            <tr>
                                <td>@o.Id.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@o.TimeUnix.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@o.Paid.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@o.Status.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@o.SuccessfullyCreated.ToString(CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <form method="post" action="@PhpCustomerWrites.BalanceTopUpHref" style="background:#fff;border:1px solid #e7e5e4;border-radius:.55rem;padding:1.1rem 1.2rem;margin-bottom:1rem">
            <label for="money_value">Top up (AED)</label>
            <input id="money_value" type="number" name="amount" min="1" step="0.01" required style="width:100%;margin:.25rem 0 1rem;padding:.5rem" />
            <button type="submit" style="padding:.55rem .95rem;border:0;border-radius:.4rem;background:#0f766e;color:#fff;font-weight:800;cursor:pointer">Create top-up</button>
        </form>

        <div class="epc-sf-acc-links" aria-label="Account shortcuts">
            <a href="@StorefrontSurfaceLinks.Orders">Orders list</a>
            <a href="@StorefrontSurfaceLinks.GarageLogin">Garage list</a>
            <a href="/storefront/profile-app">Profile</a>
            <a href="@StorefrontAspNetCanonical.Payment">Pay</a>
        </div>
    }

</StorefrontTenantChrome>

@code {
    private const string _phpAccount = "https://epartscart.com/users/";
    private string _brand = "eParts Cart";
    private bool _isCustomer;
    private StorefrontAccountSummary _summary = new(0, 0, 0, 0, "n/a", string.Empty);
    private IReadOnlyList<StorefrontOrderDigest> _recent = [];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Customer || session.UserId <= 0)
        {
            _isCustomer = false;
            return;
        }

        _isCustomer = true;
        var result = await Dashboards.BuildStorefrontAccountAsync(session.UserId, 10, ctx.RequestAborted);
        _summary = result.Summary;
        _recent = result.RecentOrders;
    }
}
