@page "/storefront/account-summary-app"
@page "/storefront/account-app"
@page "/en/shop/balans"
@page "/shop/balans"
@page "/en/users/account"
@page "/users/account"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Account · @_brand</PageTitle>
<PhpChromeStyles Surface="storefront" />
<HeadContent>
<style>
        
        .epc-sf-acc-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-sf-acc-cta a {
            display:inline-flex; padding:.5rem .85rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#1c1917; background:#fee2e2;
        }
        .epc-sf-acc-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-sf-acc-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-sf-acc-kpi { background:#fff; border:1px solid #e7e5e4; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-sf-acc-kpi strong { display:block; font-size:1.35rem; font-variant-numeric:tabular-nums; }
        .epc-sf-acc-kpi span { color:#78716c; font-size:.78rem; }
        .epc-sf-acc-table-wrap { background:#fff; border:1px solid #e7e5e4; border-radius:.55rem; overflow:auto; margin-bottom:1rem; }
        .epc-sf-acc-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-sf-acc-table th, .epc-sf-acc-table td { padding:.55rem .7rem; border-bottom:1px solid #f5f5f4; text-align:left; }
        .epc-sf-acc-table th { background:#fafaf9; color:#57534e; font-size:.75rem; text-transform:uppercase; }
        .epc-sf-acc-links { display:flex; gap:.45rem; flex-wrap:wrap; margin-bottom:1rem; }
        .epc-sf-acc-links a {
            display:inline-flex; padding:.5rem .85rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#78350f; background:#fff; border:1px solid #e7e5e4;
        }
        .epc-sf-acc-note { margin-top:1rem; padding:.75rem .9rem; background:#fffbeb; border:1px solid #fde68a; border-radius:.45rem; color:#713f12; font-size:.86rem; }
        .epc-sf-acc-gate { padding:1.25rem; background:#fff; border:1px solid #e7e5e4; border-radius:.55rem; }
        @@media (max-width:900px){ .epc-sf-acc-kpis{grid-template-columns:1fr 1fr;} }
        @@media (max-width:560px){ .epc-sf-acc-kpis{grid-template-columns:1fr;} }
    
</style>
</HeadContent>

<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontTenantChrome>

    <PhpStorefrontPageHeader Title="Account"
                            Subtitle="Balance, recent orders, and account shortcuts.">
            <a class="btn btn-sm btn-default" href="/storefront/orders-app">My orders</a>
            <a class="btn btn-sm btn-default" href="/storefront/garage-app">Garage</a>
            <a class="btn btn-sm btn-default" href="/storefront/profile-app">Profile</a>
            <a class="btn btn-sm btn-default" href="/storefront/login">Customer login</a>
    </PhpStorefrontPageHeader>

    @if (!_isCustomer)
    {
        <div class="panel panel-primary epc-sf-acc-gate">
            <div class="panel-body">
                <p style="margin:0 0 .75rem;color:#44403c">Sign in with your store account to load account summary.</p>
                <a class="btn btn-ar btn-primary" href="@StorefrontSurfaceLinks.Login">Sign in</a>
                <a class="btn btn-ar btn-default" href="@StorefrontSurfaceLinks.Registration">Register</a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-2">
                <div><label style="margin-bottom: 0;" for="time_from_show">From</label></div>
                <input type="text" id="time_from" class="form-control" value="@_opsFilter.TimeFrom" />
                <input type="hidden" id="time_from_show" />
            </div>
            <div class="col-md-2">
                <div><label style="margin-bottom: 0;" for="time_to_show">To</label></div>
                <input type="text" id="time_to" class="form-control" value="@_opsFilter.TimeTo" />
                <input type="hidden" id="time_to_show" />
            </div>
            <div class="col-md-2">
                <div><label style="margin-bottom: 0;" for="income">Direction</label></div>
                <select id="income" class="form-control">
                    <option value="-1">All</option>
                    <option value="1">Income</option>
                    <option value="0">Expense</option>
                </select>
            </div>
            <div class="col-md-2">
                <div><label style="margin-bottom: 0;" for="operation_code">Operation</label></div>
                <select id="operation_code" class="form-control">
                    <option value="-1">All</option>
                </select>
            </div>
            <div class="col-md-2">
                <div><label style="margin-bottom: 0;" for="order_id">Order ID</label></div>
                <input type="text" id="order_id" class="form-control" value="@_opsFilter.OrderId" />
            </div>
        </div>
        <div style="margin:20px 0px 15px;">
            <button style="margin-right: 2px; margin-bottom:5px;" class="btn btn-ar btn-primary" onclick="filterOperations();">Filter</button>
            <button style="margin-right: 2px; margin-bottom:5px;" class="btn btn-ar btn-primary" onclick="unsetFilterOperations();">Clear</button>
        </div>
        <script>
            document.getElementById("income").value = "@_opsFilter.Income";
            document.getElementById("operation_code").value = "@_opsFilter.OperationCode";
            function filterOperations() {
                var account_operations_filter = {
                    time_from: document.getElementById("time_from").value,
                    time_to: document.getElementById("time_to").value,
                    income: document.getElementById("income").value,
                    operation_code: document.getElementById("operation_code").value,
                    order_id: document.getElementById("order_id").value
                };
                var date = new Date(new Date().getTime() + 15552000 * 1000);
                document.cookie = "my_account_operations_filter="+JSON.stringify(account_operations_filter)+"; path=/; expires=" + date.toUTCString();
                location = "@StorefrontAspNetCanonical.Balance";
            }
            function unsetFilterOperations() {
                var account_operations_filter = { time_from:"", time_to:"", income:"-1", operation_code:"-1", order_id:"" };
                var date = new Date(new Date().getTime() + 15552000 * 1000);
                document.cookie = "my_account_operations_filter="+JSON.stringify(account_operations_filter)+"; path=/; expires=" + date.toUTCString();
                location = "@StorefrontAspNetCanonical.Balance";
            }
            function sortOperationsItems(field) {
                var date = new Date(new Date().getTime() + 15552000 * 1000);
                document.cookie = "my_account_operations_sort="+JSON.stringify({field:field,asc_desc:"desc"})+"; path=/; expires=" + date.toUTCString();
                location = "@StorefrontAspNetCanonical.Balance";
            }
        </script>
        <div style="overflow: hidden; overflow-x: auto;">
            <table class="table" style="margin-bottom:0;">
                <thead>
                    <tr>
                        <th style="vertical-align: middle; white-space: nowrap;"><a href="javascript:void(0);" onclick="sortOperationsItems('id');" id="id_sorter">ID</a></th>
                        <th style="vertical-align: middle; white-space: nowrap;"><a href="javascript:void(0);" onclick="sortOperationsItems('time');" id="time_sorter">When</a></th>
                        <th style="vertical-align: middle; white-space: nowrap;"><a href="javascript:void(0);" onclick="sortOperationsItems('amount');" id="amount_sorter">Amount</a></th>
                        <th style="vertical-align: middle; white-space: nowrap;"><a href="javascript:void(0);" onclick="sortOperationsItems('order_id');" id="order_id_sorter">Order</a></th>
                        <th style="vertical-align: middle;"><a href="javascript:void(0);" onclick="sortOperationsItems('name');" id="name_sorter">Name</a></th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td colspan="5">No account operations yet.</td></tr>
                </tbody>
            </table>
        </div>

        <div class="panel panel-primary">
            <div class="panel-heading">Top up</div>
            <div class="panel-body">
                <form method="post" action="@PhpCustomerWrites.BalanceTopUpHref">
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="returnUrl" value="/storefront/account-summary-app" />
                    <div class="col-md-12">
                        <label for="money_value">Amount</label>
                        <input id="money_value" class="form-control" type="number" name="amount" min="1" step="0.01" required placeholder="Amount" />
                    </div>
                    <div class="col-md-12" style="margin-top:.75rem">
                        <div class="epc-pay-method-picker">
                            <label for="epc_pay_handler">Pay with</label>
                            <select id="epc_pay_handler" name="pay_handler" class="form-control">
                                @foreach (var gate in PhpCustomerWrites.PayGateways)
                                {
                                    <option value="@gate.Code">@gate.Label</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-ar btn-primary" style="margin-top:7px;">Create top-up</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="epc-sf-acc-links" aria-label="Account shortcuts">
            <a href="@StorefrontSurfaceLinks.Orders">Orders list</a>
            <a href="@(StorefrontAspNetCanonical.Orders + "?view=items")">Order items</a>
            <a href="@StorefrontSurfaceLinks.GarageLogin">Garage list</a>
            <a href="@StorefrontAspNetCanonical.Profile">Profile</a>
            <a href="@StorefrontAspNetCanonical.PricesDownload">Price list</a>
            <a href="@StorefrontAspNetCanonical.CustomerReturns">Returns</a>
            <a href="@StorefrontAspNetCanonical.CustomerRequests">Requests</a>
            <a href="@StorefrontAspNetCanonical.Payment">Pay</a>
        </div>
    }

</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private bool _isCustomer;
    private StorefrontAccountSummary _summary = new(0, 0, 0, 0, "n/a", string.Empty);
    private IReadOnlyList<StorefrontOrderDigest> _recent = [];
    private AccountOpsFilter _opsFilter = AccountOpsFilter.Empty;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        if (session.Kind != LegacySessionKind.Customer || session.UserId <= 0)
        {
            _isCustomer = false;
            return;
        }

        _isCustomer = true;
        ctx.Request.Cookies.TryGetValue("my_account_operations_filter", out var filterCookie);
        _opsFilter = AccountOpsFilter.Parse(filterCookie);
        var result = await Dashboards.BuildStorefrontAccountAsync(session.UserId, 10, ctx.RequestAborted);
        _summary = result.Summary;
        _recent = result.RecentOrders;
    }

    private sealed record AccountOpsFilter(
        string TimeFrom,
        string TimeTo,
        string Income,
        string OperationCode,
        string OrderId)
    {
        public static AccountOpsFilter Empty { get; } = new("", "", "-1", "-1", "");

        public static AccountOpsFilter Parse(string? cookie)
        {
            if (string.IsNullOrWhiteSpace(cookie))
            {
                return Empty;
            }

            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(Uri.UnescapeDataString(cookie));
                var r = doc.RootElement;
                return new(
                    Read(r, "time_from"),
                    Read(r, "time_to"),
                    Read(r, "income", "-1"),
                    Read(r, "operation_code", "-1"),
                    Read(r, "order_id"));
            }
            catch (Exception)
            {
                return Empty;
            }
        }

        private static string Read(System.Text.Json.JsonElement root, string name, string fallback = "")
        {
            if (!root.TryGetProperty(name, out var el))
            {
                return fallback;
            }

            var raw = el.ValueKind == System.Text.Json.JsonValueKind.String ? el.GetString() ?? fallback : el.ToString();
            return string.IsNullOrWhiteSpace(raw) ? fallback : raw;
        }
    }
}
