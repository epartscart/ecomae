@page "/storefront/print-app"
@page "/en/shop/print"
@page "/shop/print"
@page "/en/shop/print_docs"
@page "/shop/print_docs"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Print documents · @_brand</PageTitle>
<PhpSurfaceHead Surface="storefront" IncludeStorefrontAnalytics="true" ApplyStorefrontIndustryAttrs="true" />
<PhpChromeBodyClass Surface="storefront" />

<StorefrontTenantChrome>
    <section style="padding:2rem 0 3rem">
        <div class="container" style="max-width:40rem">
            <p style="margin:0 0 .35rem;color:#64748b;font-size:.85rem">
                <a href="@StorefrontSurfaceLinks.Orders">My orders</a>
                · Print
            </p>
            <h1 style="margin:.1rem 0 .4rem">Print order documents</h1>
            <p style="color:#475569">Open a sales receipt or invoice for a paid order.</p>
            @if (!_isCustomer)
            {
                <div class="panel panel-primary">
                    <div class="panel-body">
                        <p style="margin:0 0 .75rem">Sign in to print order documents.</p>
                        <a class="btn btn-ar btn-primary" href="@StorefrontSurfaceLinks.Login">Sign in</a>
                    </div>
                </div>
            }
            else
            {
                <div class="panel panel-primary">
                    <div class="panel-heading">Print</div>
                    <div class="panel-body">
                        <form method="get" action="@PhpSellerRequest.PrintWriteHref" target="_blank">
                            <label for="order_id">Order number</label>
                            <input id="order_id" class="form-control" type="number" name="order_id" min="1" required value="@OrderId" />
                            <label for="doc_name">Document</label>
                            <select id="doc_name" class="form-control" name="doc_name">
                                @foreach (var doc in PhpSellerRequest.PrintDocs)
                                {
                                    <option value="@doc.Code" selected="@(string.Equals(doc.Code, DocName, StringComparison.OrdinalIgnoreCase))">@doc.Label</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-ar btn-primary" style="margin-top:10px;"><i class="fa fa-print"></i> Open print</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </section>
</StorefrontTenantChrome>

@code {
    private string _brand = "eParts Cart";
    private bool _isCustomer;

    [SupplyParameterFromQuery(Name = "order_id")]
    public int? OrderId { get; set; }

    [SupplyParameterFromQuery(Name = "doc_name")]
    public string? DocName { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        _brand = StorefrontIndustryHostResolver.ResolveBrandLabel(ctx.Request.Host.Host);
        var session = await Sessions.ValidateCustomerAsync(ctx, ctx.RequestAborted);
        _isCustomer = session.Kind == LegacySessionKind.Customer && session.UserId > 0;
    }
}
