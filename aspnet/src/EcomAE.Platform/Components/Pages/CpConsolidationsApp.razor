@page "/cp/consolidations-app"
@page "/erp/consolidations-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Consolidations · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Consolidations
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Save an entity, record financials, and post or remove an intercompany txn here. Consolidation run stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/consolidations-app" IsAdmin="_isAdmin" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/ajax/cons-entity-save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/consolidations-app" />
            <label>Code <input type="text" name="code" required /></label>
            <label>Name <input type="text" name="name" required /></label>
            <label>Currency <input type="text" name="currency_code" value="AED" style="width:5rem" /></label>
            <label>Ownership % <input type="number" name="ownership_pct" step="0.001" value="100" style="width:6rem" /></label>
            <label><input type="checkbox" name="is_home" value="1" /> Home</label>
            <button type="submit">Save entity</button>
        </form>
        <form method="post" action="/erp/consolidations/figures/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/consolidations-app" />
            <label>Entity code <input type="text" name="entity_code" required placeholder="SUB1" /></label>
            <label>Revenue <input type="number" name="revenue" step="0.01" style="width:7rem" /></label>
            <label>Expenses <input type="number" name="expenses" step="0.01" style="width:7rem" /></label>
            <label>Assets <input type="number" name="assets" step="0.01" style="width:7rem" /></label>
            <label>Liabilities <input type="number" name="liabilities" step="0.01" style="width:7rem" /></label>
            <label>Equity <input type="number" name="equity" step="0.01" style="width:7rem" /></label>
            <button type="submit">Save financials</button>
        </form>
        <form method="post" action="/erp/ajax/cons-entity-delete" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/cp/consolidations-app")" />
            <label>Entity id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <button type="submit">Remove entity</button>
        </form>
        <form method="post" action="/erp/ajax/cons-ic-delete" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/cp/consolidations-app")" />
            <label>IC id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <button type="submit">Remove IC txn</button>
        </form>
        <form method="post" action="/erp/consolidations/ic/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/consolidations-app" />
            <label>From <input type="text" name="from_entity" required placeholder="HOME" /></label>
            <label>To <input type="text" name="to_entity" required placeholder="SUB1" /></label>
            <label>Type <input type="text" name="txn_type" value="sale" style="width:6rem" /></label>
            <label>Amount <input type="number" name="amount" step="0.01" min="0.01" required style="width:7rem" /></label>
            <label>Date <input type="date" name="txn_date" /></label>
            <label>Ref <input type="text" name="ref" /></label>
            <label>Memo <input type="text" name="memo" /></label>
            <button type="submit">Record IC</button>
        </form>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Entities</div>
            <div class="panel-body">
                <p class="help-block">@_summary.EntityCount.ToString(CultureInfo.InvariantCulture) entities · @_summary.FigureCount.ToString(CultureInfo.InvariantCulture) figures · @_summary.IcCount.ToString(CultureInfo.InvariantCulture) IC txns · @_summary.OpenIcCount.ToString(CultureInfo.InvariantCulture) open IC.</p>
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Code</th>
                                <th>Name</th>
                                <th>CCY</th>
                                <th>Own %</th>
                                <th>Home</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (_rows.Count == 0)
                        {
                            <tr><td colspan="7">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr>
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Code) ? row.Code : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.CurrencyCode) ? row.CurrencyCode : "—")</td>
                                    <td>@row.OwnershipPct.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.IsHome.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.Active.ToString(CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=consolidations&tab=consolidation_bu";
    private bool _isAdmin;
    private CpConsolidationsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpConsolidationsEntityDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpConsolidationsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Entities;
        _source = result.Source;
        _message = result.Message;
    }
}
