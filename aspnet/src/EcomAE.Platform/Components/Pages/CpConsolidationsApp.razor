@page "/cp/consolidations-app"
@page "/erp/consolidations-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Consolidations · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Consolidations
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Open an entity for figures and intercompany rows. Save an entity, record financials, and post or remove an intercompany txn here. Consolidation run stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/consolidations-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedEntity is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/ajax/cons-entity-save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/consolidations-app" />
            <label>Code <input type="text" name="code" required value="@(_openedEntity is not null ? _openedEntity.Code : "")" /></label>
            <label>Name <input type="text" name="name" required value="@(_openedEntity is not null ? _openedEntity.Name : "")" /></label>
            <label>Currency <input type="text" name="currency_code" value="@(_openedEntity is not null && !string.IsNullOrWhiteSpace(_openedEntity.CurrencyCode) ? _openedEntity.CurrencyCode : "AED")" style="width:5rem" /></label>
            <label>Ownership % <input type="number" name="ownership_pct" step="0.001" value="@(_openedEntity is not null ? _openedEntity.OwnershipPct.ToString(CultureInfo.InvariantCulture) : "100")" style="width:6rem" /></label>
            <label><input type="checkbox" name="is_home" value="1" /> Home</label>
            <button type="submit">Save entity</button>
        </form>
        <form method="post" action="/erp/consolidations/figures/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/consolidations-app" />
            <label>Entity code <input type="text" name="entity_code" required placeholder="SUB1" value="@(_openedEntity is not null ? _openedEntity.Code : "")" /></label>
            <label>Revenue <input type="number" name="revenue" step="0.01" style="width:7rem" /></label>
            <label>Expenses <input type="number" name="expenses" step="0.01" style="width:7rem" /></label>
            <label>Assets <input type="number" name="assets" step="0.01" style="width:7rem" /></label>
            <label>Liabilities <input type="number" name="liabilities" step="0.01" style="width:7rem" /></label>
            <label>Equity <input type="number" name="equity" step="0.01" style="width:7rem" /></label>
            <button type="submit">Save financials</button>
        </form>
        <form method="post" action="/erp/ajax/cons-entity-delete" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/cp/consolidations-app")" />
            <label>Entity id <input type="number" name="id" min="1" required style="width:6rem" value="@(_openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "")" /></label>
            <button type="submit">Remove entity</button>
        </form>
        <form method="post" action="/erp/ajax/cons-ic-delete" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="@(Http.HttpContext?.Request.Path.Value ?? "/cp/consolidations-app")" />
            <label>IC id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <button type="submit">Remove IC txn</button>
        </form>
        <form method="post" action="/erp/consolidations/ic/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/consolidations-app" />
            <label>From <input type="text" name="from_entity" required placeholder="HOME" value="@(_openedEntity is not null ? _openedEntity.Code : "")" /></label>
            <label>To <input type="text" name="to_entity" required placeholder="SUB1" /></label>
            <label>Type <input type="text" name="txn_type" value="sale" style="width:6rem" /></label>
            <label>Amount <input type="number" name="amount" step="0.01" min="0.01" required style="width:7rem" /></label>
            <label>Date <input type="date" name="txn_date" /></label>
            <label>Ref <input type="text" name="ref" /></label>
            <label>Memo <input type="text" name="memo" /></label>
            <button type="submit">Record IC</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Consolidation KPIs">
        <div class="kpi"><div class="lbl">Entities</div><div class="val">@_summary.EntityCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Figures</div><div class="val">@_summary.FigureCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">IC txns</div><div class="val">@_summary.IcCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Opened IC</div><div class="val">@_openedIc.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedEntity is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedEntity.Name) ? _openedEntity.Name : (!string.IsNullOrWhiteSpace(_openedEntity.Code) ? _openedEntity.Code : ("Entity #" + _openedEntity.Id.ToString(CultureInfo.InvariantCulture))))
                    <span class="label label-default pull-right">@(_openedEntity.IsHome != 0 ? "home" : "member")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedEntity.Code) ? _openedEntity.Code : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedEntity.CurrencyCode) ? _openedEntity.CurrencyCode : "—")
                        · @_openedEntity.OwnershipPct.ToString(CultureInfo.InvariantCulture)%
                        · parent @(!string.IsNullOrWhiteSpace(_openedEntity.ParentCode) ? _openedEntity.ParentCode : "—")
                        · @(_openedEntity.Active != 0 ? "active" : "inactive")</p>
                    <p>Created @_openedEntity.TimeCreated.ToString(CultureInfo.InvariantCulture)</p>
                    @if (_openedFigure is not null)
                    {
                        <p>Revenue @_openedFigure.Revenue.ToString(CultureInfo.InvariantCulture)
                            · expenses @_openedFigure.Expenses.ToString(CultureInfo.InvariantCulture)
                            · assets @_openedFigure.Assets.ToString(CultureInfo.InvariantCulture)
                            · liabilities @_openedFigure.Liabilities.ToString(CultureInfo.InvariantCulture)
                            · equity @_openedFigure.Equity.ToString(CultureInfo.InvariantCulture)
                            · updated @_openedFigure.TimeUpdated.ToString(CultureInfo.InvariantCulture)</p>
                    }
                    else
                    {
                        <p class="text-muted">No figures yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Intercompany</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>From</th>
                                    <th>To</th>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Date</th>
                                    <th>Memo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedIc.Count == 0)
                                {
                                    <tr><td colspan="7">No IC rows yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var ic in _openedIc)
                                    {
                                        <tr>
                                            <td>@ic.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(ic.FromEntity) ? ic.FromEntity : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(ic.ToEntity) ? ic.ToEntity : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(ic.TxnType) ? ic.TxnType : "—")</td>
                                            <td>@ic.Amount.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(ic.TxnDate) ? ic.TxnDate : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(ic.Memo) ? ic.Memo : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Entities</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Code</th>
                                <th>Name</th>
                                <th>CCY</th>
                                <th>Own %</th>
                                <th>Home</th>
                                <th>Active</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!_isAdmin)
                        {
                            <tr><td colspan="8">Sign in for live data.</td></tr>
                        }
                        else if (_rows.Count == 0)
                        {
                            <tr><td colspan="8">@(!string.IsNullOrWhiteSpace(_message) ? _message : "No records yet.")</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Code) ? row.Code : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Name) ? row.Name : "—")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.CurrencyCode) ? row.CurrencyCode : "—")</td>
                                    <td>@row.OwnershipPct.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.IsHome.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.Active.ToString(CultureInfo.InvariantCulture)</td>
                                    <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "cons_id", row.Id)">Open</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=consolidations&tab=consolidation_bu";
    private bool _isAdmin;
    private CpConsolidationsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpConsolidationsEntityDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private string _listHref = "/cp/consolidations-app";
    private long _openedId;
    private CpConsolidationsEntityDigest? _openedEntity;
    private CpConsolidationsFigureDigest? _openedFigure;
    private IReadOnlyList<CpConsolidationsIcDigest> _openedIc = [];

    private string OpenedCaption => _openedEntity is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedEntity.Name)
            ? (string.IsNullOrWhiteSpace(_openedEntity.Code)
                ? ("Entity #" + _openedEntity.Id.ToString(CultureInfo.InvariantCulture))
                : _openedEntity.Code)
            : _openedEntity.Name);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var path = ctx.Request.Path.Value;
        _listHref = string.Equals(path, "/erp/consolidations-app", StringComparison.OrdinalIgnoreCase)
            ? "/erp/consolidations-app"
            : "/cp/consolidations-app";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "cons_id");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpConsolidationsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Entities;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpConsolidationsDetailAsync(_openedId, ctx.RequestAborted);
            _openedEntity = detail.Entity;
            _openedFigure = detail.Figure;
            _openedIc = detail.Ic;
            if (_openedEntity is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
