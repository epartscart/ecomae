@page "/storefront/eparts-cata-app"
@page "/en/eparts-cata"
@page "/en/partsapi-catalog"
@page "/en/papi-catalog"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation

<PageTitle>PAPI Catalog · eParts Cart</PageTitle>
<PhpChromeStyles Surface="storefront" />
<StorefrontAnalytics Enabled="true" IncludeClarity="true" />

<StorefrontCatalogWidgetBody Title="PAPI Catalog"
                            Subtitle="PartsAPI TecDoc vehicle tree — makes, models, modifications, parts groups and articles."
                            AnchorId="epc-papi-catalog"
                            Html="@_html">
    <a class="btn btn-sm btn-primary" href="@StorefrontSurfaceLinks.UmapiCatalog">UMAPI Catalog</a>
    <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.TurCatalog">TUR Catalog</a>
    <a class="btn btn-sm btn-default" href="@StorefrontSurfaceLinks.PartSearch">Part search</a>
</StorefrontCatalogWidgetBody>

@code {
    private string _html = "";

    protected override void OnInitialized()
    {
        _html = PhpHomeWidgetHtml.RenderStatic("content/general_pages/epc_rendered_widgets/catalog_papi.html");
        if (string.IsNullOrWhiteSpace(_html))
        {
            _html = "<p style=\"margin:0;color:#64748b\">PAPI Catalog is unavailable in this environment. "
                  + "<a href=\"" + StorefrontSurfaceLinks.PartSearch + "\">Open part search</a>.</p>";
        }
    }
}
