@page "/erp/approvals-app"
@page "/erp/approvals"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Components.Shared.Desktop
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject EcomAE.Platform.Erp.IErpBosWfRequestReadService ApprovalRequests
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>ERP Approvals · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Approvals" BreadcrumbArea="Home" BreadcrumbTab="Approvals">

    
    <PhpErpModulePageHeader Title="Approval queue" Subtitle="Pending sales orders, purchase orders, journals, invoices, and stock." />
    <ul class="nav nav-pills" style="margin-bottom:14px;">
        <li class="active"><a href="/erp/approvals-app">Queue</a></li>
        <li><a href="/erp/sales-orders-app">Sales orders</a></li>
        <li><a href="/erp/purchase-orders-app">Purchase orders</a></li>
        <li><a href="/erp/gl-journals-app">Journals</a></li>
    </ul>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/ajax/bos-wf-disable-rule" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/approvals-app" />
            <label>Rule id <input type="number" name="id" min="1" required style="width:6rem" /></label>
            <button type="submit">Disable rule</button>
        </form>
        <form method="post" action="/erp/approvals/requests/raise" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/approvals-app" />
            <label>Type <input type="text" name="entity_type" value="purchase_order" /></label>
            <label>Entity id <input type="number" name="entity_id" min="1" style="width:6rem" /></label>
            <label>Ref <input type="text" name="entity_ref" /></label>
            <label>Amount <input type="number" name="amount" step="0.01" /></label>
            <label>Title <input type="text" name="title" /></label>
            <button type="submit">Raise test request</button>
        </form>
        <form method="post" action="/erp/approvals/requests/decide" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/approvals-app" />
            <label>Request id <input type="number" name="request_id" min="1" required style="width:6rem" /></label>
            <label>Decision
                <select name="decision">
                    <option value="approve">Approve</option>
                    <option value="reject">Reject</option>
                </select>
            </label>
            <label>Comment <input type="text" name="comment" /></label>
            <button type="submit">Decide request</button>
        </form>
        <form method="post" action="/erp/approvals/rules/save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/approvals-app" />
            <label>Rule id <input type="number" name="rule_id" min="0" style="width:6rem" /></label>
            <label>Name <input type="text" name="name" required /></label>
            <label>Document type
                <select name="entity_type">
                    <option value="purchase_order">Purchase order</option>
                    <option value="sales_order">Sales order</option>
                    <option value="purchase_invoice">Purchase invoice / bill</option>
                    <option value="sales_invoice">Sales invoice</option>
                    <option value="payment_voucher">Payment voucher</option>
                    <option value="receipt_voucher">Receipt voucher</option>
                    <option value="gl_journal">GL journal</option>
                    <option value="expense">Expense claim</option>
                    <option value="rfq">RFQ</option>
                </select>
            </label>
            <label>Condition
                <select name="operator">
                    <option value=">=">amount ≥</option>
                    <option value=">">amount &gt;</option>
                    <option value="<=">amount ≤</option>
                    <option value="any">any amount</option>
                </select>
            </label>
            <label>Threshold <input type="number" step="0.01" name="threshold_amount" value="10000" style="width:7rem" /></label>
            <label>Priority <input type="number" name="priority" value="100" style="width:5rem" /></label>
            <label>Approver role <input type="text" name="step_role" value="Manager" /></label>
            <label>Step label <input type="text" name="step_label" placeholder="Approval" /></label>
            <button type="submit">Save rule</button>
        </form>
    }

    @if (_opened is not null)
    {
        <ErpDocumentWorkspace
            DocumentKind="Approval queue"
            Title="@_opened.Label"
            DocumentNumber="@_opened.Id"
            PartyLabel="Category"
            Party="@_opened.Category"
            ReferenceLabel="Target"
            Reference="@_opened.Link"
            Status="@_opened.Severity"
            ApprovalState="Action required"
            CompanyContext="Tenant / company"
            Currency="—"
            Fields="@ApprovalWorkspaceFields"
            Lines="@ApprovalWorkspaceLines"
            Tabs="@ApprovalWorkspaceTabs" />
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Approval queue stats">
        <div class="kpi"><div class="lbl">Queue rows</div><div class="val">@_queue.Count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Total items</div><div class="val">@_queue.Sum(i => i.Count).ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Draft sales orders</div><div class="val">@_queue.Where(i => i.Id == "draft_so").Sum(i => i.Count).ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Pending POs</div><div class="val">@_queue.Where(i => i.Id == "pending_po").Sum(i => i.Count).ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Category</th>
                    <th>Label</th>
                    <th>Count</th>
                    <th>Severity</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (_queue.Count == 0)
                {
                    <tr><td colspan="6">No approval queue items.</td></tr>
                }
                else
                {
                    @foreach (var item in _queue)
                    {
                        var href = AppHrefFor(item.Id);
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Category</td>
                            <td>@item.Label</td>
                            <td>@item.Count.ToString(CultureInfo.InvariantCulture)</td>
                            <td><span class="epc-ea-sev @item.Severity">@item.Severity</span></td>
                            <td>
                                <a class="btn btn-xs btn-default" href="@ApprovalHref(item.Id)">Open</a>
                                <a href="@href">@item.Action</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (_isAdmin)
    {
        <h4 style="margin:1.4rem 0 .6rem">Approval requests</h4>
        <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Approval request stats">
            <div class="kpi"><div class="lbl">Pending</div><div class="val">@_requests.Summary.Pending.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Approved</div><div class="val">@_requests.Summary.Approved.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Rejected</div><div class="val">@_requests.Summary.Rejected.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Active rules</div><div class="val">@_requests.Summary.Rules.ToString(CultureInfo.InvariantCulture)</div></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_requests.Message))
        {
            <p class="text-muted">@_requests.Message</p>
        }

        <h5>Pending approvals</h5>
        <div class="epc-erp-table-wrap">
            <table class="table table-bordered table-condensed table-epc epc-erp-table" aria-label="Pending approval requests">
                <thead><tr><th>Document</th><th>Type</th><th>Amount</th><th>Step</th><th>Raised</th><th>Decision</th></tr></thead>
                <tbody>
                    @foreach (var r in _requests.Pending)
                    {
                        <tr id="approval-request-@r.Id">
                            <td><strong>@r.Title</strong><br /><small class="text-muted">@r.EntityRef</small></td>
                            <td>@EcomAE.Platform.Erp.ErpBosWfRequestReadService.EntityTypeLabel(r.EntityType)</td>
                            <td>@r.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><span class="label label-warning">Step @((r.CurrentStep + 1).ToString(CultureInfo.InvariantCulture))/@r.StepCount.ToString(CultureInfo.InvariantCulture): @r.CurrentStepLabel</span></td>
                            <td><small>@Day(r.CreatedAt)</small></td>
                            <td style="white-space:nowrap">
                                <form method="post" action="/erp/approvals/requests/decide" style="display:inline-block;margin:0">
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="/erp/approvals-app" />
                                    <input type="hidden" name="request_id" value="@r.Id" />
                                    <input type="hidden" name="decision" value="approve" />
                                    <input type="text" name="comment" placeholder="Comment" style="width:120px" />
                                    <button class="btn btn-xs btn-success" type="submit">Approve</button>
                                </form>
                                <form method="post" action="/erp/approvals/requests/decide" style="display:inline-block;margin:0" onsubmit="return confirm('Reject this request?');">
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="/erp/approvals-app" />
                                    <input type="hidden" name="request_id" value="@r.Id" />
                                    <input type="hidden" name="decision" value="reject" />
                                    <button class="btn btn-xs btn-danger" type="submit">Reject</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (_requests.Pending.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted">No pending approvals.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <h5>History &amp; audit</h5>
        <div class="epc-erp-table-wrap">
            <table class="table table-bordered table-condensed table-epc epc-erp-table" aria-label="Approval request history">
                <thead><tr><th>Document</th><th>Type</th><th>Amount</th><th>Status</th><th>Decided</th><th>Audit trail</th></tr></thead>
                <tbody>
                    @foreach (var r in _requests.History)
                    {
                        <tr id="approval-history-@r.Id">
                            <td><strong>@r.Title</strong><br /><small class="text-muted">@r.EntityRef</small></td>
                            <td>@EcomAE.Platform.Erp.ErpBosWfRequestReadService.EntityTypeLabel(r.EntityType)</td>
                            <td>@r.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><span class="label label-@StatusClass(r.Status)">@r.Status</span></td>
                            <td><small>@(r.DecidedAt > 0 ? Day(r.DecidedAt) : "—")</small></td>
                            <td>
                                @foreach (var l in r.Log)
                                {
                                    <small>&rsaquo; <strong>@l.Action</strong>@(l.ActorName.Length > 0 ? " by " + l.ActorName : "")@(l.Comment.Length > 0 ? " — " + l.Comment : "") <span class="text-muted">(@Minute(l.Time))</span></small><br />
                                }
                            </td>
                        </tr>
                    }
                    @if (_requests.History.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted">No approval requests yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }

</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private IReadOnlyList<ErpApprovalQueueItemDigest> _queue = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private string _openedId = "";
    private ErpApprovalQueueItemDigest? _opened;
    private EcomAE.Platform.Erp.ErpBosWfRequestReadResult _requests = EcomAE.Platform.Erp.ErpBosWfRequestReadResult.Empty("n/a", "");
    private IReadOnlyList<string> ApprovalWorkspaceTabs => ["General", "Queue", "Target", "Actions"];

    private IReadOnlyList<ErpDocumentWorkspaceField> ApprovalWorkspaceFields => _opened is null
        ? []
        : [
            new("Category", _opened.Category, "General"),
            new("Queue key", _opened.Id, "Queue"),
            new("Count", _opened.Count.ToString(CultureInfo.InvariantCulture), "Queue"),
            new("Severity", _opened.Severity, "Queue"),
            new("Action", _opened.Action, "Actions"),
            new("Target link", _opened.Link, "Target"),
            new("Icon", _opened.Icon, "General")
        ];

    private IReadOnlyList<ErpDocumentWorkspaceLine> ApprovalWorkspaceLines => _opened is null
        ? []
        : [
            new("1", _opened.Label, _opened.Count, "items", _opened.Category, "approval queue", 0, 0, 0, 0, 0, _opened.Link)
        ];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _openedId = ctx.Request.Query["item"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildErpAsync(ctx.RequestAborted);
        _queue = result.ApprovalQueue;
        _source = result.Source;
        _message = result.Message;
        _opened = string.IsNullOrWhiteSpace(_openedId) ? null : _queue.FirstOrDefault(item => item.Id == _openedId);
        _requests = await ApprovalRequests.ReadAsync(ctx.RequestAborted);
    }

    private static string Day(long unix) => DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("dd MMM yyyy", CultureInfo.InvariantCulture);

    private static string Minute(long unix) => DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("dd MMM HH:mm", CultureInfo.InvariantCulture);

    private static string StatusClass(string status) => status switch
    {
        "approved" => "success",
        "rejected" => "danger",
        "pending" => "warning",
        _ => "default",
    };

    private static string AppHrefFor(string id) => id switch
    {
        "draft_so" => "/erp/sales-orders-app",
        "pending_po" => "/erp/purchase-orders-app",
        "unposted_gl" => "/erp/gl-journals-app",
        "overdue_invoices" => "/erp/invoices-app",
        "low_stock" => "/erp/inventory-stock-app",
        "pending_einvoice" => "/cp/einvoice-documents-app",
        _ => "/erp/dashboard-summary-app",
    };

    private static string ApprovalHref(string id) => "/erp/approvals-app?item=" + Uri.EscapeDataString(id);
}
