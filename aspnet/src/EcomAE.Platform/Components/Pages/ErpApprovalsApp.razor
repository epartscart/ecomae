@page "/erp/approvals-app"
@page "/erp/approvals"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Components.Shared.Desktop
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject EcomAE.Platform.Erp.IErpBosWfRequestReadService ApprovalRequests
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>ERP Approvals · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<style>
    .ap-guide{margin:0 0 14px;padding:12px 14px;border:1px solid #dbe4ea;background:#fff;}
    .ap-guide h3{margin:0 0 4px;font-size:15px;color:#0f172a;}
    .ap-guide__lead{margin:0 0 10px;color:#475569;}
    .ap-ladder{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:8px;list-style:none;margin:0;padding:0;}
    .ap-ladder li{border:1px solid #dbe4ea;border-top:3px solid #1d4f91;background:#f8fafc;padding:8px 10px;}
    .ap-lv{display:inline-block;width:18px;height:18px;border-radius:50%;background:#1d4f91;color:#fff;font-size:11px;font-weight:700;line-height:18px;text-align:center;margin-right:4px;}
    .ap-ladder strong{color:#0f172a;}
    .ap-band{display:block;font-size:12px;color:#0f172a;margin-top:4px;}
    .ap-ladder p{margin:4px 0 0;font-size:12px;color:#475569;}
    .ap-boards{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin:0 0 14px;}
    .ap-board{background:#fff;border:1px solid #dbe4ea;padding:12px;}
    .ap-board h3{margin:0 0 4px;font-size:14px;}
    .ap-board>p{margin:0 0 8px;color:#475569;font-size:12px;}
    .ap-level-form,.ap-maint form[data-epc-inline="1"]{display:flex !important;flex-wrap:wrap;gap:8px;align-items:flex-end;width:auto !important;max-width:none !important;margin:0 0 8px !important;padding:0 !important;border:0 !important;background:transparent !important;box-shadow:none !important;}
    .ap-level-form label,.ap-maint label{display:flex;flex-direction:column;gap:2px;margin:0;font-size:11px;font-weight:700;color:#475569;}
    .ap-row-actions{display:flex;flex-wrap:nowrap;gap:4px;align-items:center;}
    .ap-row-actions form[data-epc-inline="1"]{display:inline-flex !important;width:auto !important;margin:0 !important;padding:0 !important;border:0 !important;background:transparent !important;box-shadow:none !important;}
</style>
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Approvals" BreadcrumbArea="Home" BreadcrumbTab="Approvals">

    <PhpErpModulePageHeader Title="Approval levels" Subtitle="Save stores the document. Post is the step that hits the books. Each amount needs the level that covers it." />

    <section class="ap-guide" aria-label="How approval works">
        <h3>How approval works</h3>
        <p class="ap-guide__lead">Saving keeps the document as a draft. Posting confirms a purchase order, posts an invoice or journal, or releases a payment. A person may save up to their save level and post up to their post level. Above that, the next level must approve first. The person who saved the document cannot be the only approver of its post.</p>
        <ol class="ap-ladder">
            @foreach (var band in ErpApprovalLevelCatalog.Standard)
            {
                <li>
                    <span class="ap-lv">@band.Level</span><strong>@band.Role</strong>
                    <span class="ap-band">Save up to @band.SaveUpTo</span>
                    <span class="ap-band">Post up to @band.PostUpTo</span>
                    <p>@band.Meaning</p>
                </li>
            }
        </ol>
    </section>
    <ul class="nav nav-pills" style="margin-bottom:14px;">
        <li class="active"><a href="/erp/approvals-app">Queue</a></li>
        <li><a href="/erp/sales-orders-app">Sales orders</a></li>
        <li><a href="/erp/purchase-orders-app">Purchase orders</a></li>
        <li><a href="/erp/gl-journals-app">Journals</a></li>
    </ul>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    <div class="ap-boards" aria-label="Saved approval levels">
        <section class="ap-board">
            <h3>Save levels</h3>
            <p>Who may store a draft, and up to what amount, before it must be sent for approval.</p>
            @LevelTable(_rules.Where(rule => rule.Active && rule.Gate == "save").ToList(), "No save level yet. Set one below.")
        </section>
        <section class="ap-board">
            <h3>Post levels</h3>
            <p>Who may post the document to the books. Posting above a level waits for the next approver.</p>
            @LevelTable(_rules.Where(rule => rule.Active && rule.Gate != "save").ToList(), "No post level yet. Set one below.")
        </section>
    </div>

    @if (_isAdmin)
    {
        <section class="ap-board" style="margin-bottom:14px;">
            <h3>Set a level</h3>
            <p>Choose the document, whether this level covers save or post, the level number, the role, and the amount they may approve.</p>
            <form method="post" action="/erp/approvals/rules/save" class="ap-level-form" data-epc-inline="1">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@_returnUrl" />
                <input type="hidden" name="operator" value="@(">=")" />
                <input type="hidden" name="priority" value="100" />
                <label>Rule id <input type="number" name="rule_id" min="0" value="0" class="form-control input-sm" style="width:5rem" /></label>
                <label>Name <input type="text" name="name" required maxlength="160" class="form-control input-sm" placeholder="PO post · Manager" /></label>
                <label>Document
                    <select name="entity_type" class="form-control input-sm">
                        <option value="purchase_order">Purchase order</option>
                        <option value="sales_order">Sales order</option>
                        <option value="purchase_invoice">Purchase invoice / bill</option>
                        <option value="sales_invoice">Sales invoice</option>
                        <option value="payment_voucher">Payment voucher</option>
                        <option value="receipt_voucher">Receipt voucher</option>
                        <option value="gl_journal">GL journal</option>
                        <option value="expense">Expense claim</option>
                        <option value="rfq">RFQ</option>
                    </select>
                </label>
                <label>When
                    <select name="step_gate" class="form-control input-sm">
                        <option value="save">Save — store the draft</option>
                        <option value="post" selected>Post — hit the books</option>
                    </select>
                </label>
                <label>Level
                    <select name="step_level" class="form-control input-sm">
                        @foreach (var band in ErpApprovalLevelCatalog.Standard)
                        {
                            <option value="@band.Level.ToString(CultureInfo.InvariantCulture)">@band.Level · @band.Role</option>
                        }
                    </select>
                </label>
                <label>Approver role <input type="text" name="step_role" value="Manager" class="form-control input-sm" /></label>
                <label>Step label <input type="text" name="step_label" value="Post" class="form-control input-sm" /></label>
                <label>Up to amount <input type="number" step="0.01" name="threshold_amount" value="10000" class="form-control input-sm" style="width:8rem" /></label>
                <button type="submit" class="btn btn-sm btn-primary">Save rule</button>
            </form>
        </section>
    }

    @if (_opened is not null)
    {
        <ErpDocumentWorkspace
            DocumentKind="Approval queue"
            Title="@_opened.Label"
            DocumentNumber="@_opened.Id"
            PartyLabel="Category"
            Party="@_opened.Category"
            ReferenceLabel="Target"
            Reference="@_opened.Link"
            Status="@_opened.Severity"
            ApprovalState="Action required"
            CompanyContext="Tenant / company"
            Currency="—"
            Fields="@ApprovalWorkspaceFields"
            Lines="@ApprovalWorkspaceLines"
            Tabs="@ApprovalWorkspaceTabs" />
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Approval queue stats">
        <div class="kpi"><div class="lbl">Queue rows</div><div class="val">@_queue.Count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Total items</div><div class="val">@_queue.Sum(i => i.Count).ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Draft sales orders</div><div class="val">@_queue.Where(i => i.Id == "draft_so").Sum(i => i.Count).ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Pending POs</div><div class="val">@_queue.Where(i => i.Id == "pending_po").Sum(i => i.Count).ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Category</th>
                    <th>Label</th>
                    <th>Count</th>
                    <th>Severity</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (_queue.Count == 0)
                {
                    <tr><td colspan="6">No approval queue items.</td></tr>
                }
                else
                {
                    @foreach (var item in _queue)
                    {
                        var href = AppHrefFor(item.Id);
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Category</td>
                            <td>@item.Label</td>
                            <td>@item.Count.ToString(CultureInfo.InvariantCulture)</td>
                            <td><span class="epc-ea-sev @item.Severity">@item.Severity</span></td>
                            <td>
                                <a class="btn btn-xs btn-default" href="@ApprovalHref(item.Id)">Open</a>
                                <a href="@href">@item.Action</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (_isAdmin)
    {
        <h4 style="margin:1.4rem 0 .6rem">Approval requests</h4>
        <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Approval request stats">
            <div class="kpi"><div class="lbl">Pending</div><div class="val">@_requests.Summary.Pending.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Approved</div><div class="val">@_requests.Summary.Approved.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Rejected</div><div class="val">@_requests.Summary.Rejected.ToString(CultureInfo.InvariantCulture)</div></div>
            <div class="kpi"><div class="lbl">Active rules</div><div class="val">@_requests.Summary.Rules.ToString(CultureInfo.InvariantCulture)</div></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_requests.Message))
        {
            <p class="text-muted">@_requests.Message</p>
        }

        <h5>Pending approvals</h5>
        <div class="epc-erp-table-wrap">
            <table class="table table-bordered table-condensed table-epc epc-erp-table" aria-label="Pending approval requests">
                <thead><tr><th>Document</th><th>Type</th><th>Amount</th><th>Step</th><th>Raised</th><th>Decision</th></tr></thead>
                <tbody>
                    @foreach (var r in _requests.Pending)
                    {
                        <tr id="approval-request-@r.Id">
                            <td><strong>@r.Title</strong><br /><small class="text-muted">@r.EntityRef</small></td>
                            <td>@EcomAE.Platform.Erp.ErpBosWfRequestReadService.EntityTypeLabel(r.EntityType)</td>
                            <td>@r.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><span class="label label-warning">Step @((r.CurrentStep + 1).ToString(CultureInfo.InvariantCulture))/@r.StepCount.ToString(CultureInfo.InvariantCulture): @r.CurrentStepLabel</span></td>
                            <td><small>@Day(r.CreatedAt)</small></td>
                            <td class="ap-row-actions">
                                <form method="post" action="/erp/approvals/requests/decide" data-epc-inline="1">
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="@_returnUrl" />
                                    <input type="hidden" name="request_id" value="@r.Id" />
                                    <input type="hidden" name="decision" value="approve" />
                                    <input type="text" name="comment" placeholder="Comment" class="form-control input-sm" style="width:120px" />
                                    <button class="btn btn-xs btn-success" type="submit">Approve</button>
                                </form>
                                <form method="post" action="/erp/approvals/requests/decide" data-epc-inline="1">
                                    <input type="hidden" name="confirmWrites" value="true" />
                                    <input type="hidden" name="returnUrl" value="@_returnUrl" />
                                    <input type="hidden" name="request_id" value="@r.Id" />
                                    <input type="hidden" name="decision" value="reject" />
                                    <button class="btn btn-xs btn-danger" type="submit">Reject</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (_requests.Pending.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted">No pending approvals.</td></tr>
                    }
                    else
                    {
                        <tr style="font-weight:600;background:#f2f6fa">
                            <td>Total</td>
                            <td></td>
                            <td>@_requests.Pending.Sum(r => r.Amount).ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td colspan="3" class="text-muted">@_requests.Pending.Count pending</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h5>History &amp; audit</h5>
        <div class="epc-erp-table-wrap">
            <table class="table table-bordered table-condensed table-epc epc-erp-table" aria-label="Approval request history">
                <thead><tr><th>Document</th><th>Type</th><th>Amount</th><th>Status</th><th>Decided</th><th>Audit trail</th></tr></thead>
                <tbody>
                    @foreach (var r in _requests.History)
                    {
                        <tr id="approval-history-@r.Id">
                            <td><strong>@r.Title</strong><br /><small class="text-muted">@r.EntityRef</small></td>
                            <td>@EcomAE.Platform.Erp.ErpBosWfRequestReadService.EntityTypeLabel(r.EntityType)</td>
                            <td>@r.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><span class="label label-@StatusClass(r.Status)">@r.Status</span></td>
                            <td><small>@(r.DecidedAt > 0 ? Day(r.DecidedAt) : "—")</small></td>
                            <td>
                                @foreach (var l in r.Log)
                                {
                                    <small>&rsaquo; <strong>@l.Action</strong>@(l.ActorName.Length > 0 ? " by " + l.ActorName : "")@(l.Comment.Length > 0 ? " — " + l.Comment : "") <span class="text-muted">(@Minute(l.Time))</span></small><br />
                                }
                            </td>
                        </tr>
                    }
                    @if (_requests.History.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted">No approval requests yet.</td></tr>
                    }
                    else
                    {
                        <tr style="font-weight:600;background:#f2f6fa">
                            <td>Total</td>
                            <td></td>
                            <td>@_requests.History.Sum(r => r.Amount).ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td colspan="3" class="text-muted">@_requests.History.Count requests</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <section class="ap-board ap-maint" style="margin-top:14px;">
            <h3>Maintain a request</h3>
            <p>Turn a level off, raise a request for a document, or decide a request by its number. The queue above is the day-to-day path.</p>
            <form method="post" action="/erp/ajax/bos-wf-disable-rule" data-epc-inline="1">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@_returnUrl" />
                <label>Rule id <input type="number" name="id" min="1" required class="form-control input-sm" style="width:6rem" /></label>
                <button type="submit" class="btn btn-sm btn-default">Disable rule</button>
            </form>
            <form method="post" action="/erp/approvals/requests/raise" data-epc-inline="1">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@_returnUrl" />
                <label>Type <input type="text" name="entity_type" value="purchase_order" class="form-control input-sm" /></label>
                <label>Entity id <input type="number" name="entity_id" min="1" class="form-control input-sm" style="width:6rem" /></label>
                <label>Ref <input type="text" name="entity_ref" class="form-control input-sm" /></label>
                <label>Amount <input type="number" name="amount" step="0.01" class="form-control input-sm" /></label>
                <label>Title <input type="text" name="title" class="form-control input-sm" /></label>
                <button type="submit" class="btn btn-sm btn-default">Raise test request</button>
            </form>
            <form method="post" action="/erp/approvals/requests/decide" data-epc-inline="1">
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="returnUrl" value="@_returnUrl" />
                <label>Request id <input type="number" name="request_id" min="1" required class="form-control input-sm" style="width:6rem" /></label>
                <label>Decision
                    <select name="decision" class="form-control input-sm">
                        <option value="approve">Approve</option>
                        <option value="reject">Reject</option>
                    </select>
                </label>
                <label>Comment <input type="text" name="comment" class="form-control input-sm" /></label>
                <button type="submit" class="btn btn-sm btn-default">Decide request</button>
            </form>
        </section>
    }

</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private IReadOnlyList<ErpApprovalQueueItemDigest> _queue = [];
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private string _openedId = "";
    private ErpApprovalQueueItemDigest? _opened;
    private EcomAE.Platform.Erp.ErpBosWfRequestReadResult _requests = EcomAE.Platform.Erp.ErpBosWfRequestReadResult.Empty("n/a", "");
    private IReadOnlyList<EcomAE.Platform.Erp.ErpBosWfRuleRow> _rules = [];
    private int _companyId;
    private string _returnUrl = "/erp/approvals-app";
    private IReadOnlyList<string> ApprovalWorkspaceTabs => ["General", "Queue", "Target", "Actions"];

    private IReadOnlyList<ErpDocumentWorkspaceField> ApprovalWorkspaceFields => _opened is null
        ? []
        : [
            new("Category", _opened.Category, "General"),
            new("Queue key", _opened.Id, "Queue"),
            new("Count", _opened.Count.ToString(CultureInfo.InvariantCulture), "Queue"),
            new("Severity", _opened.Severity, "Queue"),
            new("Action", _opened.Action, "Actions"),
            new("Target link", _opened.Link, "Target"),
            new("Icon", _opened.Icon, "General")
        ];

    private IReadOnlyList<ErpDocumentWorkspaceLine> ApprovalWorkspaceLines => _opened is null
        ? []
        : [
            new("1", _opened.Label, _opened.Count, "items", _opened.Category, "approval queue", 0, 0, 0, 0, 0, _opened.Link)
        ];

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _openedId = ctx.Request.Query["item"].ToString() ?? "";
        _companyId = ErpHostContext.ActiveCompanyIdFromQuery(ctx.Request) ?? 0;
        _returnUrl = _companyId > 0
            ? "/erp/approvals-app?company=" + _companyId.ToString(CultureInfo.InvariantCulture)
            : "/erp/approvals-app";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildErpAsync(ctx.RequestAborted);
        _queue = result.ApprovalQueue;
        _source = result.Source;
        _message = result.Message;
        _opened = string.IsNullOrWhiteSpace(_openedId) ? null : _queue.FirstOrDefault(item => item.Id == _openedId);
        _requests = await ApprovalRequests.ReadAsync(ctx.RequestAborted);
        _rules = await ApprovalRequests.ReadRulesAsync(ctx.RequestAborted);
    }

    private static string Day(long unix) => DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("dd MMM yyyy", CultureInfo.InvariantCulture);

    private static string Minute(long unix) => DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("dd MMM HH:mm", CultureInfo.InvariantCulture);

    private static string StatusClass(string status) => status switch
    {
        "approved" => "success",
        "rejected" => "danger",
        "pending" => "warning",
        _ => "default",
    };

    private static string AppHrefFor(string id) => id switch
    {
        "draft_so" => "/erp/sales-orders-app",
        "pending_po" => "/erp/purchase-orders-app",
        "unposted_gl" => "/erp/gl-journals-app",
        "overdue_invoices" => "/erp/invoices-app",
        "low_stock" => "/erp/inventory-stock-app",
        "pending_einvoice" => "/erp/einvoice-documents-app",
        _ => "/erp/dashboard-summary-app",
    };

    private string ApprovalHref(string id)
    {
        var href = "/erp/approvals-app?item=" + Uri.EscapeDataString(id);
        return _companyId > 0 ? href + "&company=" + _companyId.ToString(CultureInfo.InvariantCulture) : href;
    }

    private RenderFragment LevelTable(IReadOnlyList<EcomAE.Platform.Erp.ErpBosWfRuleRow> rows, string empty) => __builder =>
    {
        <table class="table table-condensed table-bordered" style="margin:0;">
            <thead><tr><th>Level</th><th>Role</th><th>Document</th><th>Up to</th></tr></thead>
            <tbody>
                @if (rows.Count == 0)
                {
                    <tr><td colspan="4" class="text-muted">@empty</td></tr>
                }
                else
                {
                    @foreach (var rule in rows)
                    {
                        <tr>
                            <td>@(rule.Level > 0 ? rule.Level.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(rule.Role) ? rule.Name : rule.Role)</td>
                            <td>@EcomAE.Platform.Erp.ErpBosWfRequestReadService.EntityTypeLabel(rule.EntityType)</td>
                            <td>@rule.Threshold.ToString("N2", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    };
}
