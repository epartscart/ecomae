@page "/erp/approvals-app"
@page "/erp/approvals"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>ERP Approvals · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Approvals" BreadcrumbArea="Home" BreadcrumbTab="Approvals">

    
    <PhpErpModulePageHeader Title="Approval queue" Subtitle="Live shop digest. Writes stay on ERP ajax." />


    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Approval queue stats">
        <div class="kpi"><div class="lbl">Queue rows</div><div class="val">@_queue.Count.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Total items</div><div class="val">@_queue.Sum(i => i.Count).ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Source</div><div class="val">@_source</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Category</th>
                    <th>Label</th>
                    <th>Count</th>
                    <th>Severity</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (_queue.Count == 0)
                {
                    <tr><td colspan="6">No approval queue items.</td></tr>
                }
                else
                {
                    @foreach (var item in _queue)
                    {
                        var href = AppHrefFor(item.Id);
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Category</td>
                            <td>@item.Label</td>
                            <td>@item.Count.ToString(CultureInfo.InvariantCulture)</td>
                            <td><span class="epc-ea-sev @item.Severity">@item.Severity</span></td>
                            <td><a href="@href">@item.Action</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_source. @_message PHP command-center approval queue remains authoritative for live counts; this surface is read-only.
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private IReadOnlyList<ErpApprovalQueueItemDigest> _queue = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildErpAsync(ctx.RequestAborted);
        _queue = result.ApprovalQueue;
        _source = result.Source;
        _message = result.Message;
    }

    private static string AppHrefFor(string id) => id switch
    {
        "draft_so" => "/erp/sales-orders-app",
        "pending_po" => "/erp/purchase-orders-app",
        "unposted_gl" => "/erp/gl-journals-app",
        "overdue_invoices" => "/erp/invoices-app",
        "low_stock" => "/erp/inventory-stock-app",
        "pending_einvoice" => "/cp/einvoice-documents-app",
        _ => "/erp/dashboard-summary-app",
    };
}
