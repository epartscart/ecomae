@page "/cp/mobile-apps-app"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Mobile Apps · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Mobile Apps
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/mobile-apps-app")</p>
                <p>Save Android / iOS / PWA links here. Schema-ensure and SMTP stay on the Classic twin. This page does not invent a send.</p>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div>
    }

    <div class="epc-mapp-grid" aria-label="Mobile apps config">
        <div class="epc-mapp-card"><span>Enabled</span><strong>@(_summary.Enabled ? "yes" : "no")</strong></div>
        <div class="epc-mapp-card"><span>App name</span><strong>@(string.IsNullOrWhiteSpace(_summary.AppName) ? "—" : _summary.AppName)</strong></div>
        <div class="epc-mapp-card"><span>Bundle id</span><strong>@(string.IsNullOrWhiteSpace(_summary.BundleId) ? "—" : _summary.BundleId)</strong></div>
        <div class="epc-mapp-card"><span>PWA</span><strong>@(_summary.PwaEnabled ? "yes" : "no")</strong></div>
        <div class="epc-mapp-card"><span>Deep link scheme</span><strong>@(string.IsNullOrWhiteSpace(_summary.DeepLinkScheme) ? "—" : _summary.DeepLinkScheme)</strong></div>
        <div class="epc-mapp-card"><span>Deep link domain</span><strong>@(string.IsNullOrWhiteSpace(_summary.DeepLinkDomain) ? "—" : _summary.DeepLinkDomain)</strong></div>
        <div class="epc-mapp-card"><span>API base URL</span><strong>@(string.IsNullOrWhiteSpace(_summary.ApiBaseUrl) ? "—" : _summary.ApiBaseUrl)</strong></div>
        <div class="epc-mapp-card"><span>Push</span><strong>@(_summary.PushEnabled ? "yes" : "no")</strong></div>
        <div class="epc-mapp-card"><span>Play Store</span><strong>@(string.IsNullOrWhiteSpace(_summary.PlayStoreUrl) ? "—" : _summary.PlayStoreUrl)</strong></div>
        <div class="epc-mapp-card"><span>App Store</span><strong>@(string.IsNullOrWhiteSpace(_summary.AppStoreUrl) ? "—" : _summary.AppStoreUrl)</strong></div>
        <div class="epc-mapp-card"><span>Firebase project</span><strong>@(string.IsNullOrWhiteSpace(_summary.FirebaseProjectId) ? "—" : _summary.FirebaseProjectId)</strong></div>
    </div>

    @if (_isAdmin)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Save mobile settings</div>
                <div class="panel-body">
                    <form method="post" action="/cp/mobile-apps/write" class="well">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="/cp/mobile-apps-app" />
                        <input type="hidden" name="action" value="save_mobile" />
                        <div class="checkbox">
                            <label>
                                @if (_summary.Enabled)
                                {
                                    <input type="checkbox" name="enabled" value="1" checked />
                                }
                                else
                                {
                                    <input type="checkbox" name="enabled" value="1" />
                                }
                                Mobile app enabled for this tenant
                            </label>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>App display name</label>
                                    <input type="text" class="form-control" name="app_name" value="@_summary.AppName" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Bundle / package ID</label>
                                    <input type="text" class="form-control" name="bundle_id" value="@_summary.BundleId" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Storefront / API base URL</label>
                                    <input type="url" class="form-control" name="api_base_url" value="@_summary.ApiBaseUrl" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Deep link scheme</label>
                                    <input type="text" class="form-control" name="deep_link_scheme" value="@_summary.DeepLinkScheme" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Universal link domain</label>
                                    <input type="text" class="form-control" name="deep_link_domain" value="@_summary.DeepLinkDomain" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Google Play store URL</label>
                                    <input type="url" class="form-control" name="play_store_url" value="@_summary.PlayStoreUrl" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Apple App Store URL</label>
                                    <input type="url" class="form-control" name="app_store_url" value="@_summary.AppStoreUrl" />
                                </div>
                            </div>
                        </div>
                        @if (_isSuper)
                        {
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Firebase project ID (push template)</label>
                                        <input type="text" class="form-control" name="firebase_project_id" value="@_summary.FirebaseProjectId" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="checkbox" style="margin-top:28px">
                                        <label>
                                            @if (_summary.PushEnabled)
                                            {
                                                <input type="checkbox" name="push_enabled" value="1" checked />
                                            }
                                            else
                                            {
                                                <input type="checkbox" name="push_enabled" value="1" />
                                            }
                                            Push notifications (FCM/APNs) enabled
                                        </label>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" name="firebase_project_id" value="@_summary.FirebaseProjectId" />
                            @if (_summary.PushEnabled)
                            {
                                <input type="hidden" name="push_enabled" value="1" />
                            }
                        }
                        <div class="checkbox">
                            <label>
                                @if (_summary.PwaEnabled)
                                {
                                    <input type="checkbox" name="pwa_enabled" value="1" checked />
                                }
                                else
                                {
                                    <input type="checkbox" name="pwa_enabled" value="1" />
                                }
                                PWA manifest + service worker on storefront
                            </label>
                        </div>
                        <button type="submit" class="btn btn-success">Save mobile settings</button>
                    </form>
                    <p class="help-block" style="margin:.75rem 0 0">Schema-ensure stays Classic.</p>
                </div>
            </div>
        </div>
    }

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/control/portal/epc_mobile_apps";
    private bool _isAdmin;
    private bool _isSuper;
    private CpMobileAppsSummary _summary = new(false, "", "", "", "", "", "", "", true, "", false, "n/a", "");
    private string _source = "n/a";
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _isSuper = SuperCpHostGate.IsAllowed(ctx);
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpMobileAppsDigestAsync(ctx.RequestAborted);
        _summary = result.Summary;
        _source = result.Source;
        _message = result.Message;
    }
}
