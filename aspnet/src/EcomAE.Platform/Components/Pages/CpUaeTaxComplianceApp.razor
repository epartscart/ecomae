@page "/erp/uae-tax-compliance-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Components.Shared.Desktop
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Middleware
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject ICpCsrfGuard Csrf

<PageTitle>UAE Tax Compliance · ERP · eParts Cart</PageTitle>

<HeadContent>
    <style>
        .epc-tax-fetch{margin:0 0 14px;padding:16px 18px;border:1px solid #c7d2fe;border-radius:14px;background:linear-gradient(135deg,#eef2ff 0%,#fff 58%,#f0fdf4 100%);box-shadow:0 10px 24px rgba(15,23,42,.06);}
        .epc-tax-fetch__row{display:flex;flex-wrap:wrap;justify-content:space-between;gap:14px;align-items:flex-end;}
        .epc-tax-fetch h2{margin:0 0 6px;color:#1e1b4b;font-size:18px;font-weight:800;}
        .epc-tax-fetch p{margin:0;max-width:52rem;color:#475569;font-size:13px;line-height:1.5;}
        .epc-tax-fetch form{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:0;}
        .epc-tax-fetch .btn-primary{min-width:11rem;font-weight:800;}
        .epc-tax-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(132px,1fr));gap:10px;margin:0 0 14px;}
        .epc-tax-kpi{padding:12px 14px;border:1px solid #d8e3ef;border-radius:12px;background:#fff;}
        .epc-tax-kpi .lbl{color:#64748b;font-size:11px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;}
        .epc-tax-kpi .val{margin-top:4px;color:#0f172a;font-size:22px;font-weight:800;line-height:1.1;}
        .epc-tax-filters{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 12px;}
        .epc-tax-filters a{display:inline-flex;align-items:center;padding:5px 10px;border:1px solid #cbd5e1;border-radius:999px;background:#fff;color:#1d4ed8;font-size:11px;font-weight:700;text-decoration:none;}
        .epc-tax-filters a.is-on{background:#1d4ed8;border-color:#1d4ed8;color:#fff;}
        .epc-tax-empty{margin:0 0 14px;padding:28px 18px;border:1px dashed #93c5fd;border-radius:14px;background:#f8fbff;text-align:center;}
        .epc-tax-empty h3{margin:0 0 6px;color:#1e3a8a;font-size:16px;font-weight:800;}
        .epc-tax-empty p{margin:0 0 12px;color:#475569;font-size:13px;}
        .epc-tax-tools{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin:0 0 14px;}
        .epc-tax-card{padding:14px 16px;border:1px solid #d8e3ef;border-radius:12px;background:#fff;}
        .epc-tax-card h3{margin:0 0 4px;color:#1d2740;font-size:15px;font-weight:800;}
        .epc-tax-card p{margin:0 0 10px;color:#64748b;font-size:12px;}
        .epc-tax-card form{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end;margin:0;}
        .epc-tax-card label,.epc-ct-workspace__field{display:flex;flex-direction:column;gap:4px;color:#334155;font-size:11px;font-weight:700;}
        .epc-tax-links{display:flex;flex-wrap:wrap;gap:.5rem;margin:0 0 14px;}
        .epc-ct-workspace{margin-top:1rem;border:1px solid #d8e3ef;border-radius:12px;background:linear-gradient(180deg,#fff 0%,#f8fbff 100%);box-shadow:0 8px 20px rgba(15,23,42,.05);}
        .epc-ct-workspace__head{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px;padding:14px 16px;border-bottom:1px solid #d8e3ef;}
        .epc-ct-workspace__title{margin:0;color:#1d2740;font-size:17px;font-weight:800;}
        .epc-ct-workspace__sub{margin:4px 0 0;color:#64748b;font-size:12px;}
        .epc-ct-workspace__context{display:flex;flex-wrap:wrap;gap:6px;align-items:flex-start;}
        .epc-ct-workspace__chip{display:inline-flex;align-items:center;padding:4px 9px;border:1px solid #cbd5e1;border-radius:999px;background:#fff;color:#1d4ed8;font-size:11px;font-weight:700;white-space:nowrap;}
        .epc-ct-workspace__body{padding:14px 16px;}
        .epc-ct-workspace__form{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;margin:0;}
        .epc-ct-workspace__field small{color:#64748b;font-size:10px;font-weight:500;}
        .epc-ct-workspace__field input{min-width:110px;}
        @@media (max-width:720px){.epc-tax-fetch__row{display:block;}.epc-tax-fetch form,.epc-ct-workspace__field{width:100%;}.epc-ct-workspace__field input{width:100%;}}
    </style>
</HeadContent>

<TaxComplianceSurfaceChrome IsAdmin="_isAdmin">

    <PhpErpModulePageHeader Title="UAE tax compliance"
                            Subtitle="Fetch FTA legislation, ask the stored library, and keep VAT, Corporate Tax, e-invoicing, and excise work in one place."
                            ContextItems="@_headerChips">
        <a class="btn btn-sm btn-default" href="/cp/tax-toolkits-app">Tax toolkits</a>
    </PhpErpModulePageHeader>

    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/uae-tax-compliance-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-warning" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fffbeb;color:#92400e">@_message</div>
    }

    @if (_isAdmin)
    {
        <section class="epc-tax-fetch" aria-labelledby="epc-tax-fetch-title">
            <div class="epc-tax-fetch__row">
                <div>
                    <h2 id="epc-tax-fetch-title">Fetch FTA legislation</h2>
                    <p>Pulls tax.gov.ae legislation.aspx (VAT, Corporate Tax, e-invoicing, excise, procedures) into this company library. Cached 24 hours unless Force is ticked. If the live list is empty, the core UAE library is loaded so this workspace stays complete.</p>
                </div>
                <form method="post" action="@FetchAction" class="form-inline">
                    <input type="hidden" name="returnUrl" value="@ReturnHref" />
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                    <label><input type="checkbox" name="force" value="1" /> Force refetch (ignore 24h cache)</label>
                    <button type="submit" class="btn btn-primary btn-sm">Fetch FTA legislation</button>
                </form>
            </div>
        </section>
    }

    <div class="epc-tax-kpis epc-erp-stat-row" aria-label="UAE tax KPIs">
        <div class="epc-tax-kpi epc-erp-kpi"><div class="lbl">Legislation</div><div class="val">@_summary.LegislationCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="epc-tax-kpi epc-erp-kpi"><div class="lbl">VAT</div><div class="val">@CountCat("vat").ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="epc-tax-kpi epc-erp-kpi"><div class="lbl">Corporate Tax</div><div class="val">@CountCat("corporate_tax").ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="epc-tax-kpi epc-erp-kpi"><div class="lbl">E-invoicing</div><div class="val">@CountCat("einvoicing").ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="epc-tax-kpi epc-erp-kpi"><div class="lbl">Excise</div><div class="val">@CountCat("excise").ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="epc-tax-kpi epc-erp-kpi"><div class="lbl">VAT advance</div><div class="val">@_summary.VatAdvanceRows.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="epc-tax-kpi epc-erp-kpi"><div class="lbl">VAT refunds</div><div class="val">@_summary.VatRefundRows.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-tax-links" aria-label="Tax operations">
        <a class="btn btn-default btn-sm" href="@Href("/erp/vat-app")">VAT returns and boxes</a>
        <a class="btn btn-default btn-sm" href="@Href("/erp/einvoice-documents-app")">E-invoice documents</a>
        <a class="btn btn-default btn-sm" href="@Href("/erp/tax-external-reporting-app")">External reporting</a>
        <a class="btn btn-default btn-sm" href="@Href("/erp/guide-app")">Process guides</a>
    </div>

    @if (_isAdmin)
    {
        <div class="epc-tax-tools">
            <section class="epc-tax-card">
                <h3>Ask the library</h3>
                <p>Search + extract from the stored FTA library. Indicative only; confirm with a tax advisor and FTA EmaraTax.</p>
                <form method="post" action="@AskAction" class="form-inline">
                    <input type="hidden" name="returnUrl" value="@ReturnHref" />
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                    <label>Question <input class="form-control input-sm" type="text" name="question" required maxlength="500" style="width:18rem;" /></label>
                    <button type="submit" class="btn btn-primary btn-sm">Ask legislation</button>
                </form>
            </section>
            <section class="epc-tax-card">
                <h3>Regen summaries</h3>
                <p>Rebuilds ERP summaries and checklists from stored FTA titles. PDF excerpts are not available on this page.</p>
                <form method="post" action="@RegenAction" class="form-inline">
                    <input type="hidden" name="returnUrl" value="@ReturnHref" />
                    <input type="hidden" name="confirmWrites" value="true" />
                    <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                    <button type="submit" class="btn btn-default btn-sm">Regen summaries</button>
                </form>
            </section>
        </div>
    }

    @if (_isAdmin && _tab == "jw_tourist_vat")
    {
        <form method="post" action="@EcomAeRoutes.ErpJewelleryTouristVatSaveForm" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/uae-tax-compliance-app?tab=jw_tourist_vat" />
            <label>Tourist name <input type="text" name="tourist_name" required maxlength="120" /></label>
            <label>Passport <input type="text" name="passport_no" maxlength="20" /></label>
            <label>Nationality <input type="text" name="nationality" maxlength="50" /></label>
            <label>Invoice no <input type="text" name="invoice_no" maxlength="30" /></label>
            <label>VAT <input type="number" name="total_vat" step="0.01" value="0" style="width:6rem" /></label>
            <label>Refund <input type="number" name="refund_amount" step="0.01" value="0" style="width:6rem" /></label>
            <button type="submit">Save tourist VAT</button>
        </form>
        <p class="text-muted" style="margin:0 0 1rem;">Jewellery tourist VAT save is live when confirmed. Writes <code>epc_jewel_tourist_vat_refund</code>.</p>
    }

    @if (_opened is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @OpenedCaption
                    <a class="btn btn-xs btn-default pull-right" href="@_listHref">Close</a>
                </div>
                <div class="panel-body">
                    <dl class="epc-erp-facts">
                        <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                        <dt>Slug</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Slug) ? "—" : _opened.Slug)</dd>
                        <dt>Issue date</dt><dd>@(string.IsNullOrWhiteSpace(_opened.IssueDate) ? "—" : _opened.IssueDate)</dd>
                        <dt>Publish date</dt><dd>@(string.IsNullOrWhiteSpace(_opened.PublishDate) ? "—" : _opened.PublishDate)</dd>
                        <dt>Category</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Category) ? "—" : _opened.Category)</dd>
                        <dt>Tax category</dt><dd>@(string.IsNullOrWhiteSpace(_opened.TaxCategory) ? "—" : LabelCat(_opened.TaxCategory))</dd>
                        <dt>Pattern</dt><dd>@(string.IsNullOrWhiteSpace(_opened.PatternKey) ? "—" : _opened.PatternKey)</dd>
                        <dt>Flags</dt><dd>@(_opened.IsNew ? "new" : "—") · @(_opened.IsUpdated ? "updated" : "—")</dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(_opened.SummaryExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:.85rem 0 0">@_opened.SummaryExcerpt</pre>
                        @if (_opened.SummaryLen > _opened.SummaryExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_opened.SummaryExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.SummaryLen.ToString(CultureInfo.InvariantCulture) chars). PDF excerpts are not available on this page.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted" style="margin:.85rem 0 0">No ERP summary excerpt yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Same tax category</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Title</th>
                                    <th>Tax category</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="4">No same-category siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(string.IsNullOrWhiteSpace(sib.Title) ? "—" : sib.Title)</td>
                                            <td>@(string.IsNullOrWhiteSpace(sib.TaxCategory) ? "—" : LabelCat(sib.TaxCategory))</td>
                                            <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "leg_id", sib.Id)">Open</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <nav class="epc-tax-filters" aria-label="Filter by tax family">
        <a class="@(_cat.Length == 0 ? "is-on" : null)" href="@CatHref("")">All</a>
        <a class="@(_cat == "vat" ? "is-on" : null)" href="@CatHref("vat")">VAT</a>
        <a class="@(_cat == "corporate_tax" ? "is-on" : null)" href="@CatHref("corporate_tax")">Corporate Tax</a>
        <a class="@(_cat == "einvoicing" ? "is-on" : null)" href="@CatHref("einvoicing")">E-invoicing</a>
        <a class="@(_cat == "excise" ? "is-on" : null)" href="@CatHref("excise")">Excise</a>
        <a class="@(_cat == "procedures" ? "is-on" : null)" href="@CatHref("procedures")">Procedures</a>
    </nav>

    @if (_isAdmin && _visible.Count == 0)
    {
        <div class="epc-tax-empty">
            <h3>No legislation in this view yet</h3>
            <p>Use Fetch FTA legislation to load VAT, Corporate Tax, e-invoicing, excise, and procedures into this company.</p>
            <form method="post" action="@FetchAction" class="form-inline" style="display:inline-flex;gap:8px;align-items:center;">
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                <input type="hidden" name="force" value="1" />
                <button type="submit" class="btn btn-primary btn-sm">Fetch FTA legislation</button>
            </form>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Legislation items</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Slug</th>
                                <th>Title</th>
                                <th>Issue date</th>
                                <th>Category</th>
                                <th>Tax category</th>
                                <th>New</th>
                                <th>Updated</th>
                                <th>Synced</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!_isAdmin)
                            {
                                <tr><td colspan="10">Sign in for live data.</td></tr>
                            }
                            else if (_visible.Count == 0)
                            {
                                <tr><td colspan="10">No records yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var i in _visible)
                                {
                                    <tr id="erp-row-@i.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(i.Id, _openedId)">
                                        <td><strong>@i.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                                        <td>@(string.IsNullOrWhiteSpace(i.Slug) ? "—" : i.Slug)</td>
                                        <td>@(string.IsNullOrWhiteSpace(i.Title) ? "—" : i.Title)</td>
                                        <td>@(string.IsNullOrWhiteSpace(i.IssueDate) ? "—" : i.IssueDate)</td>
                                        <td>@(string.IsNullOrWhiteSpace(i.Category) ? "—" : i.Category)</td>
                                        <td>@(string.IsNullOrWhiteSpace(i.TaxCategory) ? "—" : LabelCat(i.TaxCategory))</td>
                                        <td>@(i.IsNew ? "yes" : "no")</td>
                                        <td>@(i.IsUpdated ? "yes" : "no")</td>
                                        <td>@(i.TimeSynced > 0 ? i.TimeSynced.ToString(CultureInfo.InvariantCulture) : "—")</td>
                                        <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "leg_id", i.Id)">Open</a></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

<section class="epc-ct-workspace" aria-labelledby="epc-ct-workspace-title">
    <div class="epc-ct-workspace__head">
        <div>
            <h2 id="epc-ct-workspace-title" class="epc-ct-workspace__title">Corporate Tax adjustments</h2>
            <p class="epc-ct-workspace__sub">Capture period-scoped add-backs and deductions before the CT calculation and filing workflow.</p>
        </div>
        <div class="epc-ct-workspace__context" aria-label="Corporate Tax context">
            <span class="epc-ct-workspace__chip">UAE registered country</span>
            <span class="epc-ct-workspace__chip">Period scoped</span>
            <span class="epc-ct-workspace__chip">Administration approval</span>
        </div>
    </div>
    <div class="epc-ct-workspace__body">
        <form method="post" action="@CtAction" class="epc-ct-workspace__form">
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                <label class="epc-ct-workspace__field">From <input class="form-control input-sm" type="date" name="date_from" required /></label>
                <label class="epc-ct-workspace__field">To <input class="form-control input-sm" type="date" name="date_to" required /></label>
                <label class="epc-ct-workspace__field">Non-deductible entertainment <input class="form-control input-sm" name="ct_non_deductible_entertainment" placeholder="0" inputmode="decimal" min="0" step="0.01" /><small>add-back</small></label>
                <label class="epc-ct-workspace__field">Fines / penalties <input class="form-control input-sm" name="ct_fines_penalties" placeholder="0" inputmode="decimal" min="0" step="0.01" /><small>add-back</small></label>
                <label class="epc-ct-workspace__field">Book depreciation excess <input class="form-control input-sm" name="ct_book_depreciation_excess" placeholder="0" inputmode="decimal" min="0" step="0.01" /><small>add-back</small></label>
                <label class="epc-ct-workspace__field">Related-party adjustments <input class="form-control input-sm" name="ct_related_party_adjustments" placeholder="0" inputmode="decimal" min="0" step="0.01" /><small>add-back</small></label>
                <label class="epc-ct-workspace__field">Other add-backs <input class="form-control input-sm" name="ct_other_add_backs" placeholder="0" inputmode="decimal" min="0" step="0.01" /><small>add-back</small></label>
                <label class="epc-ct-workspace__field">Exempt income <input class="form-control input-sm" name="ct_exempt_income" placeholder="0" inputmode="decimal" min="0" step="0.01" /><small>deduct</small></label>
                <label class="epc-ct-workspace__field">Foreign branch exemption <input class="form-control input-sm" name="ct_foreign_branch_exemption" placeholder="0" inputmode="decimal" min="0" step="0.01" /><small>deduct</small></label>
                <label class="epc-ct-workspace__field">Loss carryforward <input class="form-control input-sm" name="ct_loss_carryforward" placeholder="0" inputmode="decimal" min="0" step="0.01" /><small>deduct</small></label>
                <label class="epc-ct-workspace__field">Qualifying donations <input class="form-control input-sm" name="ct_qualifying_donations" placeholder="0" inputmode="decimal" min="0" step="0.01" /><small>deduct</small></label>
                <label class="epc-ct-workspace__field">Other deductions <input class="form-control input-sm" name="ct_other_deductions" placeholder="0" inputmode="decimal" min="0" step="0.01" /><small>deduct</small></label>
                <button type="submit" class="btn btn-primary btn-sm">Save CT adjustments</button>
        </form>
        <p class="text-muted" style="margin:.8rem 0 0;">Adjustments are period-scoped and use the same add-back/deduction field set as the compliance write service.</p>
    </div>
</section>

<ErpPhpCreateWell Title="Checklist step">
<form method="post" action="@ChecklistAction" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                <input type="hidden" name="returnUrl" value="@ReturnHref" />
                <input type="hidden" name="confirmWrites" value="true" />
                <input type="hidden" name="csrf_guard_key" value="@_csrf" />
                <label>Item key <input class="form-control input-sm" name="item_key" required style="width:180px;" /></label>
                <label>Action key <input class="form-control input-sm" name="action_key" required style="width:160px;" /></label>
                <label>Action text <input class="form-control input-sm" name="action_text" style="width:200px;" /></label>
                <label>Status
                    <select class="form-control input-sm" name="status">
                        <option value="pending">pending</option>
                        <option value="done">done</option>
                    </select>
                </label>
                <button type="submit" class="btn btn-primary btn-sm">Set status</button>
            </form>
</ErpPhpCreateWell>

</TaxComplianceSurfaceChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp/uae-tax-compliance?epc_erp_shell=1";
    private bool _isAdmin;
    private string _tab = "";
    private string _cat = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private CpUaeTaxComplianceSummary _summary = new(0, 0, 0, "n/a", "");
    private IReadOnlyList<CpUaeTaxItemDigest> _items = [];
    private IReadOnlyList<CpUaeTaxItemDigest> _visible = [];
    private string _source = "n/a";
    private string _message = "";
    private string _listHref = "/erp/uae-tax-compliance-app";
    private long _openedId;
    private CpUaeTaxItemDetail? _opened;
    private IReadOnlyList<CpUaeTaxItemDigest> _openedSiblings = [];
    private IReadOnlyList<string> _headerChips = ["UAE", "VAT 5%", "Corporate Tax 9%", "E-invoicing", "Excise"];
    private string _csrf = "";

    private string FetchAction => Href("/erp/uae-tax/fta-fetch");
    private string AskAction => Href("/erp/uae-tax/legislation/ask");
    private string RegenAction => Href("/erp/uae-tax/legislation/regen");
    private string CtAction => Href("/erp/uae-tax/ct-adjustments/save");
    private string ChecklistAction => Href("/erp/uae-tax/legislation/checklist/set");

    private string Href(string path) => ClientErpPath.PrefixIfBound(Http.HttpContext, path);

    private string OpenedCaption =>
        !string.IsNullOrWhiteSpace(_opened?.Title)
            ? _opened.Title
            : (_openedId > 0 ? ("Legislation #" + _openedId.ToString(CultureInfo.InvariantCulture)) : "");

    private string ReturnHref => BuildHref(_openedId, _tab, _cat);

    private int CountCat(string cat) => _items.Count(i => string.Equals(i.TaxCategory, cat, StringComparison.OrdinalIgnoreCase));

    private static string LabelCat(string cat) => cat switch
    {
        "vat" => "VAT",
        "corporate_tax" => "Corporate Tax",
        "einvoicing" => "E-invoicing",
        "excise" => "Excise",
        "procedures" => "Procedures",
        _ => string.IsNullOrWhiteSpace(cat) ? "—" : cat,
    };

    private string CatHref(string cat) => BuildHref(_openedId, _tab, cat);

    private string BuildHref(long legId, string tab, string cat)
    {
        var parts = new List<string>();
        if (legId > 0)
        {
            parts.Add("leg_id=" + legId.ToString(CultureInfo.InvariantCulture));
        }

        if (!string.IsNullOrWhiteSpace(tab))
        {
            parts.Add("tab=" + Uri.EscapeDataString(tab));
        }

        if (!string.IsNullOrWhiteSpace(cat))
        {
            parts.Add("cat=" + Uri.EscapeDataString(cat));
        }

        return parts.Count == 0 ? _listHref : _listHref + "?" + string.Join("&", parts);
    }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _listHref = "/erp/uae-tax-compliance-app";
        if (ctx.Items.TryGetValue(ClientErpPathRewriteMiddleware.OriginalPathItem, out var original)
            && original is string originalPath
            && originalPath.Contains("uae-tax-compliance-app", StringComparison.OrdinalIgnoreCase))
        {
            _listHref = originalPath.Split('?', 2)[0];
        }

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "leg_id");
        _tab = (ctx.Request.Query["tab"].ToString() ?? "").Trim();
        _cat = (ctx.Request.Query["cat"].ToString() ?? "").Trim();
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        _csrf = _isAdmin ? await Csrf.KeyForAsync(ctx, session, ctx.RequestAborted) : "";
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpUaeTaxComplianceDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _items = result.Items;
        _source = result.Source;
        _message = string.IsNullOrWhiteSpace(result.Message) ? result.Summary.Message : result.Message;
        _visible = string.IsNullOrWhiteSpace(_cat)
            ? _items
            : _items.Where(i => string.Equals(i.TaxCategory, _cat, StringComparison.OrdinalIgnoreCase)).ToList();
        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpUaeTaxComplianceDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Item;
            _openedSiblings = detail.Siblings;
        }
    }
}
