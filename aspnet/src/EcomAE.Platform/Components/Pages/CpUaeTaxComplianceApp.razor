@page "/cp/uae-tax-compliance-app"
@page "/erp/uae-tax-compliance-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>UAE Tax Compliance · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-uae-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-uae-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-uae-hero p { margin:0; color:#dcfce7; max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-uae-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-uae-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#14532d; background:#e0f2fe;
        }
        .epc-uae-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-uae-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-uae-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-uae-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-uae-kpi span { color:#64748b; font-size:.78rem; }
        .epc-uae-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-uae-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-uae-table th, .epc-uae-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-uae-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-uae-note { margin-top:1rem; padding:.75rem .9rem; background:#f0fdf4; border:1px solid #86efac; border-radius:.45rem; color:#14532d; font-size:.86rem; }
        @@media (max-width:900px){ .epc-uae-kpis{grid-template-columns:1fr;} }
    
</style>
</HeadContent>


<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-uae-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>UAE Tax Compliance</h1>
        <p>@CpPhpModuleCopy.PurposeFor(Nav.Uri)</p>
        <div class="epc-uae-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/cp/tax-toolkits-app">Tax toolkits</a>
        </div>
    </section>
    <PhpParityModuleBody AppPath="/cp/uae-tax-compliance-app" IsAdmin="_isAdmin" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 1rem;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }

    @if (_isAdmin && _tab == "jw_tourist_vat")
    {
        <form method="post" action="@EcomAeRoutes.ErpJewelleryTouristVatSaveForm" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/uae-tax-compliance-app?tab=jw_tourist_vat" />
            <label>Tourist name <input type="text" name="tourist_name" required maxlength="120" /></label>
            <label>Passport <input type="text" name="passport_no" maxlength="20" /></label>
            <label>Nationality <input type="text" name="nationality" maxlength="50" /></label>
            <label>Invoice no <input type="text" name="invoice_no" maxlength="30" /></label>
            <label>VAT <input type="number" name="total_vat" step="0.01" value="0" style="width:6rem" /></label>
            <label>Refund <input type="number" name="refund_amount" step="0.01" value="0" style="width:6rem" /></label>
            <button type="submit">Save tourist VAT</button>
        </form>
        <p class="text-muted" style="margin:0 0 1rem;">Jewellery tourist VAT save is live when confirmed. Writes <code>epc_jewel_tourist_vat_refund</code>.</p>
    }

    @if (_isAdmin)
    {
        <ErpPhpCreateWell Title="Save CT adjustments">
            <form method="post" action="/erp/uae-tax/ct-adjustments/save" class="form-inline" style="display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin-bottom:1rem;">
                <input type="hidden" name="returnUrl" value="/cp/uae-tax-compliance-app" />
                <input type="hidden" name="confirmWrites" value="true" />
                <label>From <input class="form-control input-sm" type="date" name="date_from" /></label>
                <label>To <input class="form-control input-sm" type="date" name="date_to" /></label>
                <label>Entertainment <input class="form-control input-sm" name="ct_non_deductible_entertainment" placeholder="0" style="width:90px;" /></label>
                <label>Fines <input class="form-control input-sm" name="ct_fines_penalties" placeholder="0" style="width:90px;" /></label>
                <label>Exempt income <input class="form-control input-sm" name="ct_exempt_income" placeholder="0" style="width:90px;" /></label>
                <button type="submit" class="btn btn-primary btn-sm">Save CT adjustments</button>
            </form>
        </ErpPhpCreateWell>
    }

    <div class="epc-uae-kpis" aria-label="UAE tax stats">
        <div class="epc-uae-kpi"><strong>@_summary.LegislationCount.ToString(CultureInfo.InvariantCulture)</strong><span>Legislation items</span></div>
        <div class="epc-uae-kpi"><strong>@_summary.VatAdvanceRows.ToString(CultureInfo.InvariantCulture)</strong><span>VAT advance rows</span></div>
        <div class="epc-uae-kpi"><strong>@_summary.VatRefundRows.ToString(CultureInfo.InvariantCulture)</strong><span>VAT refund rows</span></div>
    </div>

    <div class="epc-uae-table-wrap">
        <table class="epc-uae-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Slug</th>
                    <th>Title</th>
                    <th>Issue date</th>
                    <th>Category</th>
                    <th>Tax category</th>
                    <th>New</th>
                    <th>Updated</th>
                    <th>Synced</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_items.Count == 0)
                {
                    <tr><td colspan="10">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var i in _items)
                    {
                        <tr>
                            <td><strong>@i.Id.ToString(CultureInfo.InvariantCulture)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(i.Slug) ? "—" : i.Slug)</td>
                            <td>@(string.IsNullOrWhiteSpace(i.Title) ? "—" : i.Title)</td>
                            <td>@(string.IsNullOrWhiteSpace(i.IssueDate) ? "—" : i.IssueDate)</td>
                            <td>@(string.IsNullOrWhiteSpace(i.Category) ? "—" : i.Category)</td>
                            <td>@(string.IsNullOrWhiteSpace(i.TaxCategory) ? "—" : i.TaxCategory)</td>
                            <td>@(i.IsNew ? "yes" : "no")</td>
                            <td>@(i.IsUpdated ? "yes" : "no")</td>
                            <td>@(i.TimeSynced > 0 ? i.TimeSynced.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/finance/erp/uae-tax-compliance?epc_erp_shell=1";
    private bool _isAdmin;
    private string _tab = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private CpUaeTaxComplianceSummary _summary = new(0, 0, 0, "n/a", "");
    private IReadOnlyList<CpUaeTaxItemDigest> _items = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _tab = (ctx.Request.Query["tab"].ToString() ?? "").Trim();
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpUaeTaxComplianceDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _items = result.Items;
        _source = result.Source;
        _message = result.Message;
    }
}
