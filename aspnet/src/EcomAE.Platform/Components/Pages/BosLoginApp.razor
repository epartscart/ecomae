@page "/bos/login"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Routing
@inject NavigationManager Nav

<PageTitle>BOS — Business Operating System</PageTitle>
@* Do not load epc_bos_shell.js — it hijacks #bosLoginForm to PHP /bos/?action=login. *@
<PhpSurfaceHead Surface="bos" />
<PhpChromeBodyClass Surface="bos" LoginChrome="true" />

@*
  PHP same-to-same login from bos/index.php:
  dark bos-body--login theme, capability cards, stats, dual role forms
  (Platform Operator / ERP Customer). Posts to /auth/login/admin.
  Do NOT load epc_bos_shell.js here — it hijacks #bosLoginForm to PHP /bos/?action=login.
*@
<style>
    /* Harden dark theme even if body-class script is delayed/overridden */
    html:has(.bos-login),
    body:has(.bos-login),
    body.bos-body--login {
        background: linear-gradient(135deg, #020617 0%, #0c1222 30%, #091428 60%, #050d1a 100%) !important;
        color: #e2e8f0 !important;
        min-height: 100vh;
        overflow-x: hidden;
    }
    .epc-login-bos.bos-login {
        width: 100%;
        min-height: 100vh;
        display: flex;
        position: relative;
        background: transparent;
        color: #e2e8f0;
    }
    .bos-login__error.is-visible {
        display: flex;
        align-items: center;
        gap: .4rem;
    }
</style>

<div class="epc-login-bos bos-login">
    <div class="bos-login__bg">
        <div class="bos-login__grid-lines"></div>
        <div class="bos-login__particles" id="bosParticles"></div>
        <div class="bos-login__glow bos-login__glow--1"></div>
        <div class="bos-login__glow bos-login__glow--2"></div>
        <div class="bos-login__glow bos-login__glow--3"></div>
    </div>

    <div class="bos-login__hero">
        <div class="bos-login__hero-content">
            <div class="bos-login__brand-mark">
                <div class="bos-login__brand-icon">
                    <div class="bos-login__brand-icon-inner">
                        <i class="fa fa-th-large"></i>
                    </div>
                    <div class="bos-login__brand-ring"></div>
                    <div class="bos-login__brand-ring bos-login__brand-ring--2"></div>
                </div>
                <h1 class="bos-login__brand-title">BOS</h1>
                <p class="bos-login__brand-tagline">Business Operating System</p>
            </div>

            <div class="bos-login__capabilities">
                <div class="bos-login__cap-item bos-login__cap-item--1">
                    <div class="bos-login__cap-icon bos-login__cap-icon--erp"><i class="fa fa-university"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>Enterprise ERP</strong>
                        <span>Finance, HR, Inventory, Production</span>
                    </div>
                </div>
                <div class="bos-login__cap-item bos-login__cap-item--2">
                    <div class="bos-login__cap-icon bos-login__cap-icon--ecom"><i class="fa fa-shopping-cart"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>eCommerce Platform</strong>
                        <span>Multi-tenant, Multi-industry</span>
                    </div>
                </div>
                <div class="bos-login__cap-item bos-login__cap-item--3">
                    <div class="bos-login__cap-icon bos-login__cap-icon--compliance"><i class="fa fa-globe"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>Worldwide Compliance</strong>
                        <span>Auto-localized per country</span>
                    </div>
                </div>
                <div class="bos-login__cap-item bos-login__cap-item--4">
                    <div class="bos-login__cap-icon bos-login__cap-icon--ai"><i class="fa fa-magic"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>AI-Powered Operations</strong>
                        <span>Price engine, CRM, Automation</span>
                    </div>
                </div>
            </div>

            <div class="bos-login__stats-bar">
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="225">0</span>
                    <span class="bos-login__stat-label">Tenants</span>
                </div>
                <div class="bos-login__stat-divider"></div>
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="11">0</span>
                    <span class="bos-login__stat-label">Industries</span>
                </div>
                <div class="bos-login__stat-divider"></div>
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="95">0</span>
                    <span class="bos-login__stat-label">ERP Modules</span>
                </div>
                <div class="bos-login__stat-divider"></div>
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="15">0</span>
                    <span class="bos-login__stat-label">Countries</span>
                </div>
            </div>
        </div>
    </div>

    <div class="bos-login__panel">
        <div class="bos-login__panel-inner">
            <div class="bos-login__role-tabs">
                <button type="button" class="bos-login__role-tab bos-login__role-tab--active" data-role="provider" id="bosTabProvider">
                    <i class="fa fa-shield"></i>
                    <span>Platform Operator</span>
                </button>
                <button type="button" class="bos-login__role-tab" data-role="erp" id="bosTabErp">
                    <i class="fa fa-university"></i>
                    <span>ERP Customer</span>
                </button>
            </div>

            <div class="bos-login__form-wrap bos-login__form-wrap--active" id="bosFormProvider">
                <div class="bos-login__form-header">
                    <h2>Operator Access</h2>
                    <p>Manage your entire tenant fleet from one dashboard</p>
                </div>
                <form class="bos-login__form" id="bosLoginForm" method="post" action="@EcomAeRoutes.BosLogin">
                    <input type="hidden" name="surface" value="bos" />
                    <input type="hidden" name="redirect" value="/bos" />
                    <input type="hidden" name="contact_type" value="email" />
                    <div class="bos-login__field">
                        <label for="bosEmail"><i class="fa fa-envelope-o"></i> Email</label>
                        <input type="email" id="bosEmail" name="contact" required autocomplete="username" placeholder="operator@ecomae.com" />
                        <div class="bos-login__field-line"></div>
                    </div>
                    <div class="bos-login__field">
                        <label for="bosPassword"><i class="fa fa-lock"></i> Password</label>
                        <input type="password" id="bosPassword" name="password" required autocomplete="current-password" placeholder="Enter secure password" />
                        <div class="bos-login__field-line"></div>
                    </div>
                    @if (!string.IsNullOrEmpty(_error) && _errorSurface != "erp")
                    {
                        <div class="bos-login__error is-visible" id="bosLoginError">
                            <i class="fa fa-exclamation-circle"></i> @_error
                        </div>
                    }
                    else
                    {
                        <div class="bos-login__error" id="bosLoginError"></div>
                    }
                    <button type="submit" class="bos-login__btn">
                        <span class="bos-login__btn-text"><i class="fa fa-sign-in"></i> Sign In to BOS</span>
                        <span class="bos-login__btn-loading"><i class="fa fa-circle-o-notch fa-spin"></i> Authenticating...</span>
                    </button>
                </form>
                <div class="bos-login__secure-badge">
                    <i class="fa fa-lock"></i> 256-bit encrypted &middot; Session isolated &middot; Audit logged
                </div>
            </div>

            <div class="bos-login__form-wrap" id="bosFormErp">
                <div class="bos-login__form-header">
                    <h2>ERP Access</h2>
                    <p>Access your enterprise resource planning system</p>
                </div>
                <form class="bos-login__form" id="bosLoginFormErp" method="post" action="@EcomAeRoutes.ErpLogin">
                    <input type="hidden" name="surface" value="erp" />
                    <input type="hidden" name="redirect" value="/erp" />
                    <input type="hidden" name="contact_type" value="email" />
                    <div class="bos-login__field">
                        <label for="bosErpEmail"><i class="fa fa-envelope-o"></i> Business Email</label>
                        <input type="email" id="bosErpEmail" name="contact" required autocomplete="username" placeholder="finance@yourcompany.com" />
                        <div class="bos-login__field-line"></div>
                    </div>
                    <div class="bos-login__field">
                        <label for="bosErpPassword"><i class="fa fa-lock"></i> Password</label>
                        <input type="password" id="bosErpPassword" name="password" required autocomplete="current-password" placeholder="Enter your password" />
                        <div class="bos-login__field-line"></div>
                    </div>
                    @if (!string.IsNullOrEmpty(_error) && _errorSurface == "erp")
                    {
                        <div class="bos-login__error is-visible" id="bosLoginErrorErp">
                            <i class="fa fa-exclamation-circle"></i> @_error
                        </div>
                    }
                    else
                    {
                        <div class="bos-login__error" id="bosLoginErrorErp"></div>
                    }
                    <button type="submit" class="bos-login__btn bos-login__btn--erp">
                        <span class="bos-login__btn-text"><i class="fa fa-university"></i> Access ERP System</span>
                        <span class="bos-login__btn-loading"><i class="fa fa-circle-o-notch fa-spin"></i> Connecting...</span>
                    </button>
                </form>
                <div class="bos-login__erp-features">
                    <div class="bos-login__erp-feat"><i class="fa fa-check-circle"></i> General Ledger &amp; Financial Reporting</div>
                    <div class="bos-login__erp-feat"><i class="fa fa-check-circle"></i> Accounts Payable &amp; Receivable</div>
                    <div class="bos-login__erp-feat"><i class="fa fa-check-circle"></i> HR, Payroll &amp; Workforce Management</div>
                    <div class="bos-login__erp-feat"><i class="fa fa-check-circle"></i> Inventory, Production &amp; Warehouse</div>
                    <div class="bos-login__erp-feat"><i class="fa fa-check-circle"></i> Tax Compliance &amp; E-Invoicing</div>
                </div>
                <div class="bos-login__secure-badge">
                    <i class="fa fa-shield"></i> Database isolated &middot; Country-compliant &middot; Enterprise grade
                </div>
            </div>

            <div class="bos-login__footer">
                <div class="bos-login__footer-brand">
                    <span class="bos-login__footer-logo">ECOM<span>AE</span></span>
                    <span class="bos-login__footer-sep">&middot;</span>
                    <span>Business Operating System v1.5.0</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
  function reduceMotion() {
    return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }
  function bosCreateParticlesVisual() {
    var container = document.getElementById('bosParticles');
    if (!container || reduceMotion()) return;
    if (container.childElementCount > 0) return;
    var colors = [
      'rgba(14,165,233,.8)','rgba(14,165,233,.5)','rgba(14,165,233,.3)',
      'rgba(56,189,248,.7)','rgba(56,189,248,.4)',
      'rgba(99,102,241,.6)','rgba(99,102,241,.3)',
      'rgba(168,85,247,.5)','rgba(16,185,129,.4)',
      'rgba(255,255,255,.4)','rgba(255,255,255,.15)'
    ];
    for (var i = 0; i < 180; i++) {
      var p = document.createElement('div');
      p.className = 'bos-login__particle';
      p.style.left = Math.random() * 100 + '%';
      p.style.top = Math.random() * 10 + '%';
      var duration = 4 + Math.random() * 12;
      p.style.animationDuration = duration + 's';
      p.style.animationDelay = (Math.random() * duration) + 's';
      var size = 1 + Math.random() * 3.5;
      p.style.width = size + 'px';
      p.style.height = size + 'px';
      p.style.animationName = Math.random() < 0.35 ? 'bosFloatDrift' : 'bosFloat';
      var color = colors[Math.floor(Math.random() * colors.length)];
      p.style.background = color;
      if (size > 2) p.style.boxShadow = '0 0 ' + (size * 2) + 'px ' + color;
      container.appendChild(p);
    }
  }
  function bosAnimateCountersVisual() {
    var counters = document.querySelectorAll('.bos-login__stat-num[data-count]');
    if (!counters.length || reduceMotion()) {
      counters.forEach(function (el) { el.textContent = el.getAttribute('data-count') + '+'; });
      return;
    }
    setTimeout(function () {
      counters.forEach(function (el) {
        var target = parseInt(el.getAttribute('data-count'), 10) || 0;
        var startTime = null;
        function step(ts) {
          if (!startTime) startTime = ts;
          var progress = Math.min((ts - startTime) / 2000, 1);
          var eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target);
          if (progress < 1) requestAnimationFrame(step);
          else el.textContent = target + '+';
        }
        requestAnimationFrame(step);
      });
    }, 400);
  }
  function wireRoleTabs() {
    var tabProvider = document.getElementById('bosTabProvider');
    var tabErp = document.getElementById('bosTabErp');
    var formProvider = document.getElementById('bosFormProvider');
    var formErp = document.getElementById('bosFormErp');
    if (!tabProvider || !tabErp || !formProvider || !formErp) return;
    tabProvider.addEventListener('click', function () {
      tabProvider.classList.add('bos-login__role-tab--active');
      tabErp.classList.remove('bos-login__role-tab--active');
      formProvider.classList.add('bos-login__form-wrap--active');
      formErp.classList.remove('bos-login__form-wrap--active');
    });
    tabErp.addEventListener('click', function () {
      tabErp.classList.add('bos-login__role-tab--active');
      tabProvider.classList.remove('bos-login__role-tab--active');
      formErp.classList.add('bos-login__form-wrap--active');
      formProvider.classList.remove('bos-login__form-wrap--active');
    });
    // Prefer ERP tab when returning from an ERP login error
    if (document.body && document.body.getAttribute('data-bos-login-role') === 'erp') {
      tabErp.click();
    }
  }
  function forceBodyClass() {
    var meta = document.querySelector('meta[name="epc-body-class"]');
    var cls = meta ? meta.getAttribute('content') : '';
    if (cls) document.body.className = cls;
  }
  function boot() {
    forceBodyClass();
    bosCreateParticlesVisual();
    bosAnimateCountersVisual();
    wireRoleTabs();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>

@code {
    private string? _error;
    private string? _errorSurface;

    protected override void OnInitialized()
    {
        _error = LoginErrorHelper.FromUri(Nav.Uri);
        if (Uri.TryCreate(Nav.Uri, UriKind.Absolute, out var parsed))
        {
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(parsed.Query);
            // ERP form posts surface=erp and redirects errors to /erp/login; BOS page may also
            // receive ?role=erp when deep-linked. Default operator surface otherwise.
            if (query.TryGetValue("role", out var role) &&
                string.Equals(role.ToString(), "erp", StringComparison.OrdinalIgnoreCase))
            {
                _errorSurface = "erp";
            }
        }
    }
}
