@page "/bos/login"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@inject NavigationManager Nav

<PageTitle>BOS — Business Operating System</PageTitle>
<PhpSurfaceHead Surface="bos" IncludeBosLoginScripts="true" />

@*
  PHP-class graphical presentation from bos/index.php login screen:
  grid-lines, #bosParticles, glow orbs, brand rings, capability cards, animated stats.
  Shell CSS/JS: epc_bos_shell.css + epc_bos_shell.js (via PhpSurfaceHead).
*@
<style>
    /* Keep login-form controls readable inside PHP bos-login panel */
    .bos-login .epc-login-field { margin:0 0 .75rem; }
    .bos-login .epc-login-field label { display:block; font-size:.75rem; font-weight:700; letter-spacing:.04em; color:#94a3b8; margin-bottom:.25rem; }
    .bos-login .epc-login-field input, .bos-login .epc-login-field select {
        width:100%; padding:.65rem .75rem; border:1px solid #334155; border-radius:.5rem; background:#111827; color:#f8fafc;
    }
    .bos-login .epc-login-submit { width:100%; margin-top:.4rem; padding:.8rem 1rem; border:0; border-radius:.5rem; background:#2563eb; color:#fff; font-weight:700; cursor:pointer; }
    .bos-login .epc-login-error { background:#450a0a; color:#fecaca; border:1px solid #7f1d1d; border-radius:.4rem; padding:.55rem .7rem; margin-bottom:.75rem; }
    .bos-login .epc-login-bridge-note { color:#64748b; font-size:.78rem; line-height:1.4; margin:.85rem 0 .35rem; }
    .bos-login .epc-login-php { color:#93c5fd; font-weight:700; }
    .bos-login .epc-bos-bridge-warn {
        margin:0 0 1rem; padding:.65rem .75rem; border:1px solid #854d0e; background:#422006; color:#fde68a;
        border-radius:.45rem; font-size:.82rem; line-height:1.4;
    }
</style>

<div class="bos-login">
    <div class="bos-login__bg">
        <div class="bos-login__grid-lines"></div>
        <div class="bos-login__particles" id="bosParticles"></div>
        <div class="bos-login__glow bos-login__glow--1"></div>
        <div class="bos-login__glow bos-login__glow--2"></div>
        <div class="bos-login__glow bos-login__glow--3"></div>
    </div>

    <div class="bos-login__hero">
        <div class="bos-login__hero-content">
            <div class="bos-login__brand-mark">
                <div class="bos-login__brand-icon">
                    <div class="bos-login__brand-icon-inner">
                        <i class="fa fa-th-large"></i>
                    </div>
                    <div class="bos-login__brand-ring"></div>
                    <div class="bos-login__brand-ring bos-login__brand-ring--2"></div>
                </div>
                <h1 class="bos-login__brand-title">BOS</h1>
                <p class="bos-login__brand-tagline">Business Operating System</p>
            </div>

            <div class="bos-login__capabilities">
                <div class="bos-login__cap-item bos-login__cap-item--1">
                    <div class="bos-login__cap-icon bos-login__cap-icon--erp"><i class="fa fa-university"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>Enterprise ERP</strong>
                        <span>Finance, HR, Inventory, Production</span>
                    </div>
                </div>
                <div class="bos-login__cap-item bos-login__cap-item--2">
                    <div class="bos-login__cap-icon bos-login__cap-icon--ecom"><i class="fa fa-shopping-cart"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>eCommerce Platform</strong>
                        <span>Multi-tenant, Multi-industry</span>
                    </div>
                </div>
                <div class="bos-login__cap-item bos-login__cap-item--3">
                    <div class="bos-login__cap-icon bos-login__cap-icon--compliance"><i class="fa fa-globe"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>Worldwide Compliance</strong>
                        <span>Auto-localized per country</span>
                    </div>
                </div>
                <div class="bos-login__cap-item bos-login__cap-item--4">
                    <div class="bos-login__cap-icon bos-login__cap-icon--ai"><i class="fa fa-magic"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>AI-Powered Operations</strong>
                        <span>Price engine, CRM, Automation</span>
                    </div>
                </div>
            </div>

            <div class="bos-login__stats-bar">
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="225">0</span>
                    <span class="bos-login__stat-label">Tenants</span>
                </div>
                <div class="bos-login__stat-divider"></div>
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="11">0</span>
                    <span class="bos-login__stat-label">Industries</span>
                </div>
                <div class="bos-login__stat-divider"></div>
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="@PhpModuleCatalog.BosModuleCount">0</span>
                    <span class="bos-login__stat-label">BOS Modules</span>
                </div>
                <div class="bos-login__stat-divider"></div>
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="15">0</span>
                    <span class="bos-login__stat-label">Countries</span>
                </div>
            </div>
        </div>
    </div>

    <div class="bos-login__panel">
        <div class="bos-login__panel-inner">
            <div class="bos-login__role-tabs">
                <button type="button" class="bos-login__role-tab bos-login__role-tab--active" data-role="provider">
                    <i class="fa fa-shield"></i>
                    <span>Platform Operator</span>
                </button>
                <button type="button" class="bos-login__role-tab" data-role="erp">
                    <i class="fa fa-building"></i>
                    <span>ERP Customer</span>
                </button>
            </div>
            <h2 class="bos-login__panel-title">Operator Access</h2>
            <p class="bos-login__panel-sub">Manage your entire tenant fleet from one dashboard.</p>
            <div class="epc-bos-bridge-warn">
                Batch 3 decision: this form mints <strong>MySQL admin cookies</strong> for ASP.NET digests and <code>/bos/app</code> only.
                It is <strong>not</strong> PHP <code>$_SESSION['epc_bos_context']</code>. Full tenant module UX stays on
                <a class="epc-login-php" href="/BOS/">live /BOS/</a> (PHP-authoritative).
            </div>
            <LegacyAdminLoginForm Surface="LegacyLoginSurface.Bos" SurfaceLabel="BOS" PhpLoginHref="/BOS/" ErrorMessage="@_error" SubmitLabel="Sign In (admin bridge)" Accent="blue" />
            <p class="bos-login__secure"><i class="fa fa-lock"></i> Graphical chrome from PHP bos-login · Native BOS session remains PHP</p>
        </div>
    </div>
</div>

@code {
    private string? _error;
    protected override void OnInitialized() => _error = LoginErrorHelper.FromUri(Nav.Uri);
}
