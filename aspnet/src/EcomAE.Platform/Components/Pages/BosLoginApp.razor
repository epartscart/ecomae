@page "/bos/login"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@inject NavigationManager Nav

<PageTitle>BOS — Business Operating System</PageTitle>
<PhpSurfaceHead Surface="bos" IncludeBosLoginScripts="true" />
<PhpChromeBodyClass Surface="bos" LoginChrome="true" />

@*
  PHP-class graphical presentation from bos/index.php login screen:
  grid-lines, #bosParticles, glow orbs, brand rings, capability cards, animated stats.
  Shell CSS/JS: epc_bos_shell.css + epc_bos_shell.js (via PhpSurfaceHead).
*@
<style>
    /* Keep login-form controls readable inside PHP bos-login panel */
    .bos-login .epc-login-field { margin:0 0 .75rem; }
    .bos-login .epc-login-field label { display:block; font-size:.75rem; font-weight:700; letter-spacing:.04em; color:#94a3b8; margin-bottom:.25rem; }
    .bos-login .epc-login-field input, .bos-login .epc-login-field select {
        width:100%; padding:.65rem .75rem; border:1px solid #334155; border-radius:.5rem; background:#111827; color:#f8fafc;
    }
    .bos-login .epc-login-submit { width:100%; margin-top:.4rem; padding:.8rem 1rem; border:0; border-radius:.5rem; background:#0ea5e9; color:#fff; font-weight:700; cursor:pointer; }
    .bos-login .epc-login-error { background:#450a0a; color:#fecaca; border:1px solid #7f1d1d; border-radius:.4rem; padding:.55rem .7rem; margin-bottom:.75rem; }
    .bos-login .epc-login-bridge-note { color:#64748b; font-size:.78rem; line-height:1.4; margin:.85rem 0 .35rem; }
    .bos-login .epc-login-php { color:#93c5fd; font-weight:700; }
    .bos-login .bos-login__secure a.epc-login-php { color:#93c5fd; font-weight:700; }
    .bos-login__industries { margin-top:1.5rem; }
    .bos-login__industries-title { margin:0 0 .35rem; font-size:1rem; color:#e2e8f0; }
    .bos-login__industries-lead { margin:0 0 .85rem; color:#94a3b8; font-size:.82rem; line-height:1.45; max-width:36rem; }
    .bos-login__platform-deck { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.65rem; margin-top:1rem; }
    .bos-login__deck-item { display:flex; gap:.65rem; align-items:flex-start; background:rgba(15,23,42,.55); border:1px solid rgba(148,163,184,.2); border-radius:.55rem; padding:.65rem .75rem; }
    .bos-login__deck-item i { color:#38bdf8; margin-top:.15rem; }
    .bos-login__deck-item strong { display:block; font-size:.82rem; color:#f8fafc; }
    .bos-login__deck-item span { display:block; color:#94a3b8; font-size:.76rem; line-height:1.35; }
</style>

<div class="epc-asp-login-bos bos-login">
    <div class="bos-login__bg">
        <div class="bos-login__grid-lines"></div>
        <div class="bos-login__particles" id="bosParticles"></div>
        <div class="bos-login__glow bos-login__glow--1"></div>
        <div class="bos-login__glow bos-login__glow--2"></div>
        <div class="bos-login__glow bos-login__glow--3"></div>
    </div>

    <div class="bos-login__hero">
        <div class="bos-login__hero-content">
            <div class="bos-login__brand-mark">
                <div class="bos-login__brand-icon">
                    <div class="bos-login__brand-icon-inner">
                        <i class="fa fa-th-large"></i>
                    </div>
                    <div class="bos-login__brand-ring"></div>
                    <div class="bos-login__brand-ring bos-login__brand-ring--2"></div>
                </div>
                <h1 class="bos-login__brand-title">BOS</h1>
                <p class="bos-login__brand-tagline">Business Operating System</p>
            </div>

            <div class="bos-login__capabilities">
                <div class="bos-login__cap-item bos-login__cap-item--1">
                    <div class="bos-login__cap-icon bos-login__cap-icon--erp"><i class="fa fa-university"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>Enterprise ERP</strong>
                        <span>Finance, HR, Inventory, Production</span>
                    </div>
                </div>
                <div class="bos-login__cap-item bos-login__cap-item--2">
                    <div class="bos-login__cap-icon bos-login__cap-icon--ecom"><i class="fa fa-shopping-cart"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>eCommerce Platform</strong>
                        <span>Multi-tenant, Multi-industry</span>
                    </div>
                </div>
                <div class="bos-login__cap-item bos-login__cap-item--3">
                    <div class="bos-login__cap-icon bos-login__cap-icon--compliance"><i class="fa fa-globe"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>Worldwide Compliance</strong>
                        <span>Auto-localized per country</span>
                    </div>
                </div>
                <div class="bos-login__cap-item bos-login__cap-item--4">
                    <div class="bos-login__cap-icon bos-login__cap-icon--ai"><i class="fa fa-magic"></i></div>
                    <div class="bos-login__cap-text">
                        <strong>AI-Powered Operations</strong>
                        <span>Price engine, CRM, Automation</span>
                    </div>
                </div>
            </div>

            <div class="bos-login__stats-bar">
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="225">0</span>
                    <span class="bos-login__stat-label">Tenants</span>
                </div>
                <div class="bos-login__stat-divider"></div>
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="11">0</span>
                    <span class="bos-login__stat-label">Industries</span>
                </div>
                <div class="bos-login__stat-divider"></div>
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="95">0</span>
                    <span class="bos-login__stat-label">ERP Modules</span>
                </div>
                <div class="bos-login__stat-divider"></div>
                <div class="bos-login__stat">
                    <span class="bos-login__stat-num" data-count="15">0</span>
                    <span class="bos-login__stat-label">Countries</span>
                </div>
            </div>

            <div class="bos-login__industries">
                <h3 class="bos-login__industries-title"><i class="fa fa-industry"></i> Industry coverage</h3>
                <p class="bos-login__industries-lead">Multi-tenant commerce and ERP packs across verticals — same BOS fleet operators manage from one console.</p>
                <div class="bos-industry-grid">
                    @foreach (var ind in LoginIndustries)
                    {
                        <div class="bos-industry-card bos-industry-card--active" style="--industry-color:@ind.Color">
                            <i class="fa @ind.Icon" style="color:@ind.Color"></i>
                            <span class="bos-industry-card__name">@ind.Name</span>
                            <span class="bos-industry-card__count">@ind.PackHint</span>
                        </div>
                    }
                </div>
            </div>

            <div class="bos-login__platform-deck">
                @foreach (var deck in PlatformDeck)
                {
                    <div class="bos-login__deck-item">
                        <i class="fa @deck.Icon"></i>
                        <div>
                            <strong>@deck.Title</strong>
                            <span>@deck.Body</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="bos-login__panel">
        <div class="bos-login__panel-inner">
            <div class="bos-login__role-tabs">
                <button type="button" class="bos-login__role-tab bos-login__role-tab--active" data-role="provider">
                    <i class="fa fa-shield"></i>
                    <span>Platform Operator</span>
                </button>
                <button type="button" class="bos-login__role-tab" data-role="erp">
                    <i class="fa fa-building"></i>
                    <span>ERP Customer</span>
                </button>
            </div>
            <h2 class="bos-login__panel-title">Operator Access</h2>
            <p class="bos-login__panel-sub">Manage your entire tenant fleet from one dashboard.</p>
            <LegacyAdminLoginForm Surface="LegacyLoginSurface.Bos" SurfaceLabel="BOS" PhpLoginHref="/php-reference/bos" ErrorMessage="@_error" SubmitLabel="Sign In" Accent="blue" />
            <div class="bos-login__secure-badge">
                <i class="fa fa-lock"></i>
                256-bit encrypted · Session isolated · Audit logged
            </div>
            <p class="bos-login__secure">
                <i class="fa fa-lock"></i>
                Secure operator access to your tenant fleet.
            </p>
        </div>
    </div>
</div>

@*
  PHP epc_bos_shell.js only starts particles/counters when #bosLoginForm exists.
  Keep  bridge form IDs different; run visual-only init here (no PHP login hijack).
*@
<script>
(function () {
  function reduceMotion() {
    return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }
  function bosCreateParticlesVisual() {
    var container = document.getElementById('bosParticles');
    if (!container || reduceMotion()) return;
    if (container.childElementCount > 0) return;
    var colors = [
      'rgba(14,165,233,.8)','rgba(14,165,233,.5)','rgba(14,165,233,.3)',
      'rgba(56,189,248,.7)','rgba(56,189,248,.4)',
      'rgba(99,102,241,.6)','rgba(99,102,241,.3)',
      'rgba(168,85,247,.5)','rgba(16,185,129,.4)',
      'rgba(255,255,255,.4)','rgba(255,255,255,.15)'
    ];
    for (var i = 0; i < 180; i++) {
      var p = document.createElement('div');
      p.className = 'bos-login__particle';
      p.style.left = Math.random() * 100 + '%';
      p.style.top = Math.random() * 10 + '%';
      var duration = 4 + Math.random() * 12;
      p.style.animationDuration = duration + 's';
      p.style.animationDelay = (Math.random() * duration) + 's';
      var size = 1 + Math.random() * 3.5;
      p.style.width = size + 'px';
      p.style.height = size + 'px';
      p.style.animationName = Math.random() < 0.35 ? 'bosFloatDrift' : 'bosFloat';
      var color = colors[Math.floor(Math.random() * colors.length)];
      p.style.background = color;
      if (size > 2) p.style.boxShadow = '0 0 ' + (size * 2) + 'px ' + color;
      container.appendChild(p);
    }
  }
  function bosAnimateCountersVisual() {
    var counters = document.querySelectorAll('.bos-login__stat-num[data-count]');
    if (!counters.length || reduceMotion()) {
      counters.forEach(function (el) { el.textContent = el.getAttribute('data-count') + '+'; });
      return;
    }
    setTimeout(function () {
      counters.forEach(function (el) {
        var target = parseInt(el.getAttribute('data-count'), 10) || 0;
        var startTime = null;
        function step(ts) {
          if (!startTime) startTime = ts;
          var progress = Math.min((ts - startTime) / 2000, 1);
          var eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target);
          if (progress < 1) requestAnimationFrame(step);
          else el.textContent = target + '+';
        }
        requestAnimationFrame(step);
      });
    }, 400);
  }
  function wireRoleTabs() {
    var tabs = document.querySelectorAll('.bos-login__role-tab');
    if (!tabs.length) return;
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        tabs.forEach(function (t) { t.classList.remove('bos-login__role-tab--active'); });
        tab.classList.add('bos-login__role-tab--active');
      });
    });
  }
  function boot() {
    bosCreateParticlesVisual();
    bosAnimateCountersVisual();
    wireRoleTabs();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>

