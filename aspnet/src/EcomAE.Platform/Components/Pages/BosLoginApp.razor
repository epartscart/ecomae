@page "/bos/login"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Presentation
@inject NavigationManager Nav

<PageTitle>BOS — Business Operating System</PageTitle>
<PhpSurfaceHead Surface="bos" />

<style>
    .epc-asp-login-bos { min-height:100vh; margin:0; display:grid; grid-template-columns:1.15fr .85fr; background:#050505; color:#f5f5f5; font-family: @(LegacyPhpFontAssets.StackFor("bos")); }
    .epc-asp-login-bos .left {
        padding:2.2rem 2rem; background:
            radial-gradient(700px 400px at 30% 20%, rgba(37,99,235,.25), transparent 55%),
            radial-gradient(500px 300px at 70% 70%, rgba(168,85,247,.18), transparent 50%),
            #0a0a0a;
        display:flex; flex-direction:column; justify-content:center; gap:1rem;
    }
    .epc-asp-login-bos .bos-mark {
        width:64px; height:64px; border-radius:1rem; background:linear-gradient(135deg,#2563eb,#3b82f6);
        display:flex; align-items:center; justify-content:center; font-size:1.5rem; margin-bottom:.4rem;
    }
    .epc-asp-login-bos h1 { margin:0; font-size:clamp(2rem,4vw,2.8rem); letter-spacing:.04em; }
    .epc-asp-login-bos .eyebrow { color:#94a3b8; letter-spacing:.12em; font-size:.78rem; font-weight:700; }
    .epc-asp-login-bos .cards { display:grid; gap:.65rem; margin-top:1rem; max-width:28rem; }
    .epc-asp-login-bos .card { background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.1); border-radius:.7rem; padding:.85rem .9rem; }
    .epc-asp-login-bos .card strong { display:block; margin-bottom:.2rem; }
    .epc-asp-login-bos .card span { color:#94a3b8; font-size:.82rem; }
    .epc-asp-login-bos .right { background:#0b1220; border-left:1px solid #1f2937; padding:2rem 1.5rem; display:flex; flex-direction:column; justify-content:center; }
    .epc-asp-login-bos .right h2 { margin:.2rem 0 .35rem; }
    .epc-asp-login-bos .right p { color:#94a3b8; margin:0 0 1rem; font-size:.9rem; }
    .epc-asp-login-bos .role { display:flex; gap:.45rem; margin-bottom:1rem; }
    .epc-asp-login-bos .role span { flex:1; text-align:center; padding:.55rem .4rem; border-radius:.5rem; border:1px solid #334155; font-size:.8rem; font-weight:700; }
    .epc-asp-login-bos .role .on { background:#1d4ed8; border-color:#1d4ed8; }
    .epc-asp-login-bos .epc-login-field { margin:0 0 .75rem; }
    .epc-asp-login-bos .epc-login-field label { display:block; font-size:.75rem; font-weight:700; letter-spacing:.04em; color:#94a3b8; margin-bottom:.25rem; }
    .epc-asp-login-bos .epc-login-field input, .epc-asp-login-bos .epc-login-field select {
        width:100%; padding:.65rem .75rem; border:1px solid #334155; border-radius:.5rem; background:#111827; color:#f8fafc;
    }
    .epc-asp-login-bos .epc-login-submit { width:100%; margin-top:.4rem; padding:.8rem 1rem; border:0; border-radius:.5rem; background:#2563eb; color:#fff; font-weight:700; cursor:pointer; }
    .epc-asp-login-bos .epc-login-error { background:#450a0a; color:#fecaca; border:1px solid #7f1d1d; border-radius:.4rem; padding:.55rem .7rem; margin-bottom:.75rem; }
    .epc-asp-login-bos .epc-login-bridge-note { color:#64748b; font-size:.78rem; line-height:1.4; margin:.85rem 0 .35rem; }
    .epc-asp-login-bos .epc-login-php { color:#93c5fd; font-weight:700; }
    .epc-asp-login-bos .secure { margin-top:1rem; color:#86efac; font-size:.78rem; }
    .epc-asp-login-bos .foot { margin-top:auto; padding-top:1.5rem; color:#64748b; font-size:.75rem; }
    @@media (max-width:900px){ .epc-asp-login-bos{grid-template-columns:1fr;} .epc-asp-login-bos .right{border-left:0;border-top:1px solid #1f2937;} }
</style>

<div class="epc-asp-login-bos">
    <section class="left">
        <div class="bos-mark"><i class="fa fa-th-large"></i></div>
        <div class="eyebrow">BUSINESS OPERATING SYSTEM</div>
        <h1>BOS</h1>
        <div class="cards">
            <div class="card"><strong>Enterprise ERP</strong><span>Finance, HR, Inventory, Production</span></div>
            <div class="card"><strong>eCommerce Platform</strong><span>Multi-tenant, Multi-industry</span></div>
            <div class="card"><strong>Worldwide Compliance</strong><span>Auto-localized per country</span></div>
            @foreach (var mod in PhpModuleCatalog.BosModules.Take(12))
            {
                <a class="card" href="@mod.Href" style="color:inherit;text-decoration:none">
                    <strong><i class="fa @mod.Icon"></i> @mod.Label</strong>
                    <span>PHP module @mod.Id</span>
                </a>
            }
        </div>
        <p style="color:#94a3b8;font-size:.8rem;margin:0">@PhpModuleCatalog.BosModuleCount BOS modules catalogued — full directory on <a href="/bos/app" style="color:#93c5fd">/bos/app</a> after sign-in.</p>
    </section>
    <section class="right">
        <div class="role">
            <span class="on"><i class="fa fa-shield"></i> Platform Operator</span>
            <span><i class="fa fa-building"></i> ERP Customer</span>
        </div>
        <h2>Operator Access</h2>
        <p>Manage your entire tenant fleet from one dashboard.</p>
        <div class="epc-login-bridge-note" style="margin:0 0 1rem;padding:.65rem .75rem;border:1px solid #854d0e;background:#422006;color:#fde68a;border-radius:.45rem;font-size:.82rem;line-height:1.4">
            Batch 3 decision: this form mints <strong>MySQL admin cookies</strong> for ASP.NET digests and <code>/bos/app</code> only.
            It is <strong>not</strong> PHP <code>$_SESSION['epc_bos_context']</code>. Full tenant module UX stays on
            <a class="epc-login-php" href="/BOS/">live /BOS/</a> (PHP-authoritative).
        </div>
        <LegacyAdminLoginForm Surface="LegacyLoginSurface.Bos" SurfaceLabel="BOS" PhpLoginHref="/BOS/" ErrorMessage="@_error" SubmitLabel="Sign In (admin bridge)" Accent="blue" />
        <div class="secure"><i class="fa fa-lock"></i> Admin-cookie bridge · Native BOS session remains PHP</div>
        <div class="foot">ECOMAE · /bos/login ≠ /BOS/?action=login · keep /BOS/ PHP-authoritative</div>
    </section>
</div>

@code {
    private string? _error;
    protected override void OnInitialized() => _error = LoginErrorHelper.FromUri(Nav.Uri);
}
