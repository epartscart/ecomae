@page "/cp/finance-close-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Finance close · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Finance close
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/finance-close-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/finance-close-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_summary.BatchCount.ToString(CultureInfo.InvariantCulture) Batches · @_summary.PostedBatchCount.ToString(CultureInfo.InvariantCulture) Posted · @_summary.OpeningLineCount.ToString(CultureInfo.InvariantCulture) Lines · @_summary.PeriodCount.ToString(CultureInfo.InvariantCulture) Periods · @_summary.ClosedPeriodCount.ToString(CultureInfo.InvariantCulture) Closed · @_summary.CloseLogCount.ToString(CultureInfo.InvariantCulture) Close log.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Module</th>
                    <th>As of</th>
                    <th>Reference</th>
                    <th>Status</th>
                    <th>Admin</th>
                    <th>Created</th>
                    <th>Posted</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="9">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Module) ? row.Module : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.AsOfDate) ? row.AsOfDate : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Reference) ? row.Reference : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@row.AdminId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.TimeCreated.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.TimePosted.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=finance&tab=opening_balances";
    private bool _isAdmin;
    private CpFinanceCloseSummary _summary = new(0, 0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpFinanceCloseRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpFinanceCloseDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Batches;
        _source = result.Source;
        _message = result.Message;
    }
}
