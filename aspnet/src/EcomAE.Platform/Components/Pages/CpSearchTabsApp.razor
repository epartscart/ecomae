@page "/cp/search-tabs-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Cp
@using EcomAE.Platform.Presentation
@inject ICpSearchTabEditorService Tabs
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Search tabs · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">
<div class="col-lg-12">
<style>
    .epc-stab-toggle { border:0; background:transparent; padding:0; cursor:pointer; font-size:20px; line-height:1; }
    .epc-stab-toggle.on { color:#62cb31; }
    .epc-stab-toggle.off { color:#c0c4cc; }
    .epc-stab-actions .panel_a { display:inline-block; text-align:center; margin-right:18px; text-decoration:none; color:#333; }
    .epc-stab-actions .panel_a_img { width:48px; height:48px; margin:0 auto 4px; border-radius:8px; background:#f1f3f6; display:flex; align-items:center; justify-content:center; font-size:22px; color:#3498db; }
    .epc-stab-actions .panel_a_caption { font-size:12px; }
    .form-horizontal .control-label { text-align:right; }
    .epc-stab-ms { min-height:9rem; width:100%; }
</style>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
</div>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Actions
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body epc-stab-actions">
                @if (_editor is not null && _isAdmin)
                {
                    <a class="panel_a" href="javascript:void(0);" onclick="document.forms['save_form'].submit();">
                        <div class="panel_a_img"><i class="fa fa-save"></i></div>
                        <div class="panel_a_caption">Save</div>
                    </a>
                    <a class="panel_a" href="/cp/search-tabs-app">
                        <div class="panel_a_img"><i class="fa fa-folder-open"></i></div>
                        <div class="panel_a_caption">Search tabs</div>
                    </a>
                }
                <a class="panel_a" href="/cp">
                    <div class="panel_a_img"><i class="fa fa-power-off"></i></div>
                    <div class="panel_a_caption">Exit</div>
                </a>
            </div>
        </div>
    </div>

    @if (!_isAdmin)
    {
        <div class="col-lg-12"><div class="alert alert-warning" role="status">Sign in with an admin CP session to manage search tabs. <a href="/cp/login?returnUrl=/cp/search-tabs-app">Sign in</a></div></div>
    }
    else if (_editor is not null)
    {
        <form method="post" name="save_form" action="/cp/search-tabs/write">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="params_from_form" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/search-tabs-app?tab_id=@_editor.Id.ToString(CultureInfo.InvariantCulture)" />
            <input type="hidden" name="action" value="save" />
            <input type="hidden" name="tab_id" value="@_editor.Id.ToString(CultureInfo.InvariantCulture)" />
            <input type="hidden" name="langCode" value="@_lang" />
            <div class="col-lg-12">
                <div class="hpanel">
                    <div class="panel-heading hbuilt">General settings of tab @(_editor.Name.Length > 0 ? "· " + _editor.Name : "")</div>
                    <div class="panel-body form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Tab name</label>
                            <div class="col-sm-8">
                                <input type="text" class="form-control" name="tab_caption" value="@_editor.Caption" />
                                <input type="hidden" name="tab_caption_lang_str_id" value="@_editor.CaptionKey" />
                            </div>
                        </div>
                        <div class="hr-line-dashed"></div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Display order</label>
                            <div class="col-sm-8"><input type="number" class="form-control" name="tab_order" value="@_editor.Order.ToString(CultureInfo.InvariantCulture)" /></div>
                        </div>
                        <div class="hr-line-dashed"></div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Enabled</label>
                            <div class="col-sm-8"><input type="checkbox" name="tab_enabled" value="tab_enabled" checked="@(_editor.Enabled == 1)" /></div>
                        </div>
                    </div>
                </div>
            </div>
            @if (_editor.Groups.Count > 0)
            {
                <div class="col-lg-12">
                    <div class="hpanel">
                        <div class="panel-heading hbuilt">Special settings of tab</div>
                        <div class="panel-body form-horizontal">
                            @foreach (var group in _editor.Groups)
                            {
                                <div class="hpanel">
                                    <div class="panel-heading hbuilt">@group.Caption</div>
                                    <div class="panel-body">
                                        @{ var e = 0; }
                                        @foreach (var el in group.Elements)
                                        {
                                            if (e++ > 0)
                                            {
                                                <div class="hr-line-dashed"></div>
                                            }
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label">@el.Caption</label>
                                                <div class="col-sm-8">
                                                    @switch (el.Type)
                                                    {
                                                        case "text":
                                                            <input type="text" class="form-control" name="@el.Name" value="@el.Value" />
                                                            break;
                                                        case "number":
                                                            <input type="number" class="form-control" name="@el.Name" value="@el.Value" />
                                                            break;
                                                        case "checkbox":
                                                            <input type="checkbox" name="@el.Name" value="1" checked="@(el.Value is "1" or "on" or "true")" />
                                                            break;
                                                        case "multiselect":
                                                            <select multiple="multiple" class="form-control epc-stab-ms" name="@(el.Name)[]" id="@el.Name" size="@Math.Min(Math.Max(el.Options.Count, 3), 12)">
                                                                @foreach (var opt in el.Options)
                                                                {
                                                                    <option value="@opt.Value" selected="@el.Values.Contains(opt.Value)">@opt.Caption</option>
                                                                }
                                                            </select>
                                                            <span class="help-block">@el.Values.Count.ToString(CultureInfo.InvariantCulture) of @el.Options.Count.ToString(CultureInfo.InvariantCulture) selected · Ctrl/Cmd-click to multi-select</span>
                                                            break;
                                                        case "completed_html":
                                                            @((MarkupString)el.Html)
                                                            @foreach (var f in el.HtmlFieldValues)
                                                            {
                                                                <script>document.getElementById(@System.Text.Json.JsonSerializer.Serialize(f.Key)).value = @System.Text.Json.JsonSerializer.Serialize(f.Value);</script>
                                                            }
                                                            break;
                                                        default:
                                                            <input type="text" class="form-control" name="@el.Name" value="@el.Value" />
                                                            break;
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </form>
    }
    else
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Search tabs</div>
                <div class="panel-body">
                    @if (!string.IsNullOrWhiteSpace(_list.Message))
                    {
                        <div class="alert alert-warning" role="status">@_list.Message</div>
                    }
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" id="check_uncheck_all" onchange="document.querySelectorAll('.epc-stab-chk').forEach(c=>c.checked=this.checked)" /></th>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>Order</th>
                                    <th class="text-center">Enabled</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (_pageRows.Count == 0)
                            {
                                <tr><td colspan="5" class="text-muted">No search tabs.</td></tr>
                            }
                            @foreach (var row in _pageRows)
                            {
                                var href = "/cp/search-tabs-app?tab_id=" + row.Id.ToString(CultureInfo.InvariantCulture);
                                <tr>
                                    <td><input type="checkbox" class="epc-stab-chk" name="checked_@row.Id" /></td>
                                    <td><a href="@href">@row.Id.ToString(CultureInfo.InvariantCulture)</a></td>
                                    <td><a href="@href">@row.Caption</a>@(row.Name.Length > 0 ? " " : "")<small class="text-muted">@row.Name</small></td>
                                    <td><a href="@href">@row.Order.ToString(CultureInfo.InvariantCulture)</a></td>
                                    <td class="text-center">
                                        <form method="post" action="/cp/search-tabs/write" style="display:inline">
                                            <input type="hidden" name="confirmWrites" value="true" />
                                            <input type="hidden" name="returnUrl" value="/cp/search-tabs-app?s_page=@_page.ToString(CultureInfo.InvariantCulture)" />
                                            <input type="hidden" name="action" value="activation" />
                                            <input type="hidden" name="activate_tab" value="@(row.Enabled == 1 ? "0" : "1")" />
                                            <input type="hidden" name="tab_id" value="@row.Id.ToString(CultureInfo.InvariantCulture)" />
                                            <button type="submit" class="epc-stab-toggle @(row.Enabled == 1 ? "on" : "off")" title="@(row.Enabled == 1 ? "Enabled — click to disable" : "Disabled — click to enable")" aria-label="@(row.Enabled == 1 ? "Disable tab" : "Enable tab")">
                                                <i class="fa @(row.Enabled == 1 ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    @if (_pageCount > 1)
                    {
                        <div class="row"><div class="col-lg-12 text-center"><div class="dataTables_paginate paging_simple_numbers"><ul class="pagination">
                            @for (var i = 0; i < _pageCount; i++)
                            {
                                <li class="paginate_button @(i == _page ? "active" : "")"><a href="/cp/search-tabs-app?s_page=@i.ToString(CultureInfo.InvariantCulture)">@i.ToString(CultureInfo.InvariantCulture)</a></li>
                            }
                        </ul></div></div></div>
                    }
                </div>
            </div>
        </div>
    }
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/taby-poiska";
    private const int _pageSize = 20;
    private bool _isAdmin;
    private string _lang = "en";
    private string _flashOk = "";
    private string _flashErr = "";
    private CpSearchTabList _list = new([], "n/a", "");
    private IReadOnlyList<CpSearchTabListRow> _pageRows = [];
    private int _page;
    private int _pageCount;
    private CpSearchTabEditor? _editor;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        var openedId = long.TryParse(ctx.Request.Query["tab_id"], NumberStyles.Integer, CultureInfo.InvariantCulture, out var id) ? id : 0;
        if (openedId > 0)
        {
            _editor = await Tabs.OpenAsync(openedId, _lang, ctx.RequestAborted);
            if (_editor is null)
            {
                _flashErr = "Search tab #" + openedId.ToString(CultureInfo.InvariantCulture) + " was not found.";
            }
        }

        if (_editor is null)
        {
            _list = await Tabs.ListAsync(_lang, ctx.RequestAborted);
            _pageCount = (_list.Rows.Count + _pageSize - 1) / _pageSize;
            _page = int.TryParse(ctx.Request.Query["s_page"], NumberStyles.Integer, CultureInfo.InvariantCulture, out var p) ? Math.Clamp(p, 0, Math.Max(_pageCount - 1, 0)) : 0;
            _pageRows = _list.Rows.Skip(_page * _pageSize).Take(_pageSize).ToList();
        }
    }
}
