@page "/cp/search-tabs-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Search tabs · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />

<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Search tabs
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>Open a tab for a parameters excerpt. Enable or save a tab here. Full parameters JSON stays on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/cp/search-tabs-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedTab is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/cp/search-tabs/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 .65rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/search-tabs-app" />
            <input type="hidden" name="action" value="activation" />
            <label>Tab id <input type="number" name="tabId" min="1" required style="width:6rem" value="@(_openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "")" /></label>
            <label>Enabled
                <select name="enabled">
                    <option value="1">Yes</option>
                    <option value="0">No</option>
                </select>
            </label>
            <button type="submit">Set enabled</button>
        </form>
        <form method="post" action="/cp/search-tabs/write" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/cp/search-tabs-app" />
            <input type="hidden" name="action" value="save" />
            <label>Tab id <input type="number" name="tabId" min="1" required style="width:6rem" value="@(_openedId > 0 ? _openedId.ToString(CultureInfo.InvariantCulture) : "")" /></label>
            <label>Caption <input type="text" name="caption" required value="@(_openedTab is not null ? _openedTab.Caption : "")" /></label>
            <label>Sort <input type="number" name="sortOrder" value="@(_openedTab is not null ? _openedTab.SortOrder.ToString(CultureInfo.InvariantCulture) : "0")" style="width:5rem" /></label>
            <label>Enabled
                <select name="enabled">
                    <option value="1">Yes</option>
                    <option value="0">No</option>
                </select>
            </label>
            <label>Parameters JSON <input type="text" name="parametersValues" placeholder="{}" /></label>
            <button type="submit">Save tab</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Search tab KPIs">
        <div class="kpi"><div class="lbl">Tabs</div><div class="val">@_summary.TabCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Enabled</div><div class="val">@_summary.EnabledCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Disabled</div><div class="val">@_summary.DisabledCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Max order</div><div class="val">@_summary.MaxOrder.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedTab is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @OpenedCaption
                    <span class="label label-default pull-right">@(_openedTab.Enabled != 0 ? "enabled" : "disabled")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedTab.Name) ? _openedTab.Name : "—")
                        · order @_openedTab.SortOrder.ToString(CultureInfo.InvariantCulture)</p>
                    @if (!string.IsNullOrWhiteSpace(_openedTab.ParametersExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedTab.ParametersExcerpt</pre>
                        @if (_openedTab.ParametersLen > _openedTab.ParametersExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_openedTab.ParametersExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedTab.ParametersLen.ToString(CultureInfo.InvariantCulture) chars). Full parameters JSON stays on the Classic twin.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No parameters excerpt yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Enabled siblings</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Caption</th>
                                    <th>Order</th>
                                    <th>Enabled</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="5">No enabled siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Caption) ? sib.Caption : "—")</td>
                                            <td>@sib.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@sib.Enabled.ToString(CultureInfo.InvariantCulture)</td>
                                            <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "tab_id", sib.Id)">Open</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Tabs</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Caption</th>
                                <th>Order</th>
                                <th>Enabled</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!_isAdmin)
                        {
                            <tr><td colspan="5">Sign in for live data.</td></tr>
                        }
                        else if (_rows.Count == 0)
                        {
                            <tr><td colspan="5">No records yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                                    <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@(!string.IsNullOrWhiteSpace(row.Caption) ? row.Caption : "—")</td>
                                    <td>@row.SortOrder.ToString(CultureInfo.InvariantCulture)</td>
                                    <td>@row.Enabled.ToString(CultureInfo.InvariantCulture)</td>
                                    <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "tab_id", row.Id)">Open</a></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/CP/shop/taby-poiska";
    private bool _isAdmin;
    private CpSearchTabsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpSearchTabsRowDigest> _rows = [];
    private string _flashOk = "";
    private string _flashErr = "";
    private string _listHref = "/cp/search-tabs-app";
    private long _openedId;
    private CpSearchTabsDetail? _openedTab;
    private IReadOnlyList<CpSearchTabsRowDigest> _openedSiblings = [];

    private string OpenedCaption => _openedTab is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedTab.Caption)
            ? (string.IsNullOrWhiteSpace(_openedTab.Name)
                ? ("Tab #" + _openedTab.Id.ToString(CultureInfo.InvariantCulture))
                : _openedTab.Name)
            : _openedTab.Caption);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "tab_id");
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildCpSearchTabsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Tabs;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpSearchTabsDetailAsync(_openedId, ctx.RequestAborted);
            _openedTab = detail.Tab;
            _openedSiblings = detail.Siblings;
            if (_openedTab is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }
}
