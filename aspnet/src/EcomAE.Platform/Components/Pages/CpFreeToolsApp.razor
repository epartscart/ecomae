@page "/cp/free-tools-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Free tools · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
@if (_allowed)
{
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Free tools
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/free-tools-app")</p>
                <p>Open an account for last-login and saved-tool titles. Toggle a public tool on or off here. Tokens, passwords, save payloads, and send stay on the Classic twin. This page does not invent a send.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/free-tools-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedAccount is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Free tools KPIs">
        <div class="kpi"><div class="lbl">Accounts</div><div class="val">@_summary.AccountCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Saves</div><div class="val">@_summary.SaveCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Active (30d)</div><div class="val">@_summary.ActiveAccountCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Opened saves</div><div class="val">@_openedSaves.Count.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="col-lg-12"><div class="alert alert-success" role="status">@_flashOk</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="col-lg-12"><div class="alert alert-danger" role="status">@_flashErr</div></div>
    }

    @if (_isAdmin)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Toggle public tool</div>
                <div class="panel-body">
                    <form method="post" action="/cp/free-tools/write" style="display:flex;flex-wrap:wrap;gap:.45rem;align-items:end">
                        <input type="hidden" name="confirmWrites" value="true" />
                        <input type="hidden" name="returnUrl" value="@(_openedId > 0 ? ErpRecordOpen.Href(_listHref, "account_id", _openedId) : _listHref)" />
                        <input type="hidden" name="action" value="toggle" />
                        <label>Tool
                            <select name="tool">
                                <option value="vat">VAT / GST Return</option>
                                <option value="ct">Corporate Tax</option>
                                <option value="payroll">Payroll &amp; Gratuity</option>
                                <option value="ifrs">IFRS Financials</option>
                                <option value="einvoice">Electronic Invoicing</option>
                                <option value="extreport">External Reporting</option>
                                <option value="customs">Customs &amp; Logistics</option>
                                <option value="insurance">Insurance</option>
                                <option value="docexpiry">Document Expiry</option>
                                <option value="valuation">Business Valuation</option>
                                <option value="finmodel">Financial Model</option>
                                <option value="taxkit">Tax Worldwide Kit</option>
                                <option value="hrcompliance">HR Compliance Worldwide</option>
                                <option value="workflow">Approval Workflow</option>
                            </select>
                        </label>
                        <label>Active
                            <select name="active">
                                <option value="1" selected>on</option>
                                <option value="0">off</option>
                            </select>
                        </label>
                        <button type="submit" class="btn btn-primary btn-sm">Update tool</button>
                    </form>
                    <p class="help-block" style="margin:.75rem 0 0">Schema-ensure stays Classic.</p>
                </div>
            </div>
        </div>
    }

    @if (_openedAccount is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedAccount.Email) ? _openedAccount.Email : ("Account #" + _openedAccount.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedAccount.Country) ? _openedAccount.Country : "—")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedAccount.Company) ? _openedAccount.Company : "—")
                        · @_openedAccount.UseCount.ToString(CultureInfo.InvariantCulture) uses
                        · @_openedAccount.LoginCount.ToString(CultureInfo.InvariantCulture) logins</p>
                    <p>Created @_openedAccount.TimeCreated.ToString(CultureInfo.InvariantCulture)
                        · last seen @_openedAccount.TimeLastSeen.ToString(CultureInfo.InvariantCulture)
                        · last login @_openedAccount.TimeLastLogin.ToString(CultureInfo.InvariantCulture)</p>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Saved tools</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Tool</th>
                                    <th>Title</th>
                                    <th>Country</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSaves.Count == 0)
                                {
                                    <tr><td colspan="5">No saved tools yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var save in _openedSaves)
                                    {
                                        <tr>
                                            <td>@save.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(save.Tool) ? save.Tool : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(save.Title) ? save.Title : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(save.Country) ? save.Country : "—")</td>
                                            <td>@save.TimeCreated.ToString(CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Email</th>
                    <th>Company</th>
                    <th>Country</th>
                    <th>Uses</th>
                    <th>Logins</th>
                    <th>Last seen</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Email) ? row.Email : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Company) ? row.Company : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Country) ? row.Country : "—")</td>
                            <td>@row.UseCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.LoginCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.TimeLastSeen.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "account_id", row.Id)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>Free tools admin is available on the platform Super CP host only.</p>
        <p><a href="/cp">Open Control Panel</a></p>
    </div>
}

@code {
    private const string _phpTab = "/CP/control/portal/epc_free_tools_admin";
    private const string _listHref = "/cp/free-tools-app";
    private bool _allowed;
    private bool _isAdmin;
    private CpFreeToolsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpFreeToolsRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private CpFreeToolsAccountDetail? _openedAccount;
    private IReadOnlyList<CpFreeToolsSaveDigest> _openedSaves = [];
    private string _flashOk = "";
    private string _flashErr = "";

    private string OpenedCaption => _openedAccount is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedAccount.Email)
            ? ("Account #" + _openedAccount.Id.ToString(CultureInfo.InvariantCulture))
            : _openedAccount.Email)
            + (string.IsNullOrWhiteSpace(_openedAccount.Country) ? "" : (" · " + _openedAccount.Country));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "account_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpFreeToolsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Accounts;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpFreeToolsAccountDetailAsync(_openedId, ctx.RequestAborted);
            _openedAccount = detail.Account;
            _openedSaves = detail.Saves;
            if (_openedAccount is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
