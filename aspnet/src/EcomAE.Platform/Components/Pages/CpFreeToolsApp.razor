@page "/cp/free-tools-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@using EcomAE.Platform.Services
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Free tools · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
@if (_allowed)
{
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Free tools
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/free-tools-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/free-tools-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_summary.AccountCount.ToString(CultureInfo.InvariantCulture) Accounts · @_summary.SaveCount.ToString(CultureInfo.InvariantCulture) Saves · @_summary.SettingCount.ToString(CultureInfo.InvariantCulture) Settings · @_summary.ActiveAccountCount.ToString(CultureInfo.InvariantCulture) Active (30d).</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead>
            <tr>
                    <th>Id</th>
                    <th>Email</th>
                    <th>Company</th>
                    <th>Country</th>
                    <th>Uses</th>
                    <th>Logins</th>
                    <th>Last seen</th>
                    <th></th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="8">No records yet.</td></tr>
            }
            else
            {
                @foreach (var row in _rows)
                {
                    <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Email) ? row.Email : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Company) ? row.Company : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Country) ? row.Country : "—")</td>
                            <td>@row.UseCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.LoginCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.TimeLastSeen.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                    </tr>
                }
            }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>
}
else
{
    <div style="padding:2rem;font-family:sans-serif;">
        <h1>Not found</h1>
        <p>Free tools admin is available on the platform Super CP host only.</p>
        <p><a href="/cp">Open Control Panel</a></p>
    </div>
}

@code {
    private const string _phpTab = "/CP/control/portal/epc_free_tools_admin";
    private bool _allowed;
    private bool _isAdmin;
    private CpFreeToolsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpFreeToolsRowDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        _allowed = SuperCpHostGate.IsAllowed(ctx);
        if (!_allowed || ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpFreeToolsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Accounts;
        _source = result.Source;
        _message = result.Message;
    }
}
