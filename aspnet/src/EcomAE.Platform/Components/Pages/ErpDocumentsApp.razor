@page "/erp/documents-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Documents · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<HeadContent>
<style>
        .epc-docu-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#1d4ed8 45%,#2563eb 100%);
        }
        .epc-docu-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-docu-hero p { margin:0; color:#bfdbfe; max-width:42rem; font-size:.92rem; line-height:1.45; }
        .epc-docu-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-docu-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#fff; background:#2563eb;
        }
        .epc-docu-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); }
        .epc-docu-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-docu-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-docu-kpi strong { display:block; font-size:1.45rem; font-variant-numeric:tabular-nums; }
        .epc-docu-kpi span { color:#64748b; font-size:.78rem; }
        .epc-docu-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:.55rem; overflow:auto; }
        .epc-docu-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-docu-table th, .epc-docu-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-docu-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-docu-table a { color:#1d4ed8; font-weight:700; text-decoration:none; }
        .epc-docu-badge { display:inline-flex; padding:.15rem .45rem; border-radius:.3rem; font-size:.72rem; font-weight:700; background:#dbeafe; color:#1e3a8a; }
        .epc-docu-note { margin-top:1rem; padding:.75rem .9rem; background:#eff6ff; border:1px solid #bfdbfe; border-radius:.45rem; color:#1e3a8a; font-size:.86rem; }
        @@media (max-width:900px){ .epc-docu-kpis{grid-template-columns:1fr;} }
</style>
</HeadContent>

<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Documents" BreadcrumbArea="Document Control" BreadcrumbTab="Documents">

    <section class="epc-docu-hero">
        <h1>Documents</h1>
        <p>ECM attachment library linked to invoices, POs, orders, and CRM (PHP epc_erp_documents).</p>
        <div class="epc-docu-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
            <a class="ghost" href="/cp/doc-expiry-app">Doc expiry</a>
            <a class="ghost" href="/erp/invoices-app">Invoices</a>
            <a class="ghost" href="/erp/app">ERP dashboard</a>
        </div>
    </section>

    <div class="epc-docu-kpis" aria-label="Documents KPIs">
        <div class="epc-docu-kpi"><strong>@_docs.Count</strong><span>Shown (limit @_limit)</span></div>
        <div class="epc-docu-kpi"><strong>@_source</strong><span>Digest source</span></div>
        <div class="epc-docu-kpi"><strong>@(_isAdmin ? "live" : "guest")</strong><span>Session</span></div>
    </div>

    <div class="epc-docu-table-wrap">
        <table class="epc-docu-table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Category</th>
                    <th>Entity</th>
                    <th>Entity id</th>
                    <th>Size</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_docs.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "Nothing to show yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _docs)
                    {
                        <tr>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.FileName) ? $"#{row.Id}" : row.FileName)</strong></td>
                            <td><span class="epc-docu-badge">@row.DocCategory</span></td>
                            <td><span class="epc-docu-badge">@row.EntityType</span></td>
                            <td>@(row.EntityId > 0 ? row.EntityId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(row.FileSize > 0 ? row.FileSize.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@FormatTime(row.TimeCreated)</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="epc-docu-note">@_message</div>
    }

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=common&tab=documents";
    private bool _isAdmin;
    private IReadOnlyList<ErpDocumentDigest> _docs = [];
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpDocumentsAsync(_limit, ctx.RequestAborted);
        _docs = result.Documents;
        _source = result.Source;
        _message = result.Message;
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
