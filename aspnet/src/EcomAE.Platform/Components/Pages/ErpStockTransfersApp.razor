@page "/erp/stock-transfers-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Stock transfers · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Stock transfers" BreadcrumbArea="Inventory" BreadcrumbTab="Stock groups">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/stock-transfers-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Stock transfers" Subtitle="Open a row for ship/receive times and the 280-character notes excerpt. Line bodies omitted. Ship and receive stay on the Classic twin." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Stock transfer stats">
        <div class="kpi"><div class="lbl">Transfers</div><div class="val">@_summary.TransferCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Draft</div><div class="val">@_summary.DraftCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">In transit</div><div class="val">@_summary.InTransitCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Received</div><div class="val">@_summary.ReceivedCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Total qty</div><div class="val">@_summary.TotalQty.ToString("0.###", CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Transfer #</dt><dd>@(string.IsNullOrWhiteSpace(_opened.TransferNo) ? "—" : _opened.TransferNo)</dd>
                <dt>From</dt><dd>@_opened.FromWarehouseId.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>To</dt><dd>@_opened.ToWarehouseId.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Reason</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Reason) ? "—" : _opened.Reason)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Status) ? "—" : _opened.Status)</dd>
                <dt>Items</dt><dd>@_opened.TotalItems.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Qty</dt><dd>@_opened.TotalQty.ToString("0.###", CultureInfo.InvariantCulture)</dd>
                <dt>Shipped</dt><dd>@(string.IsNullOrWhiteSpace(_opened.ShippedAt) ? "—" : _opened.ShippedAt)</dd>
                <dt>Received</dt><dd>@(string.IsNullOrWhiteSpace(_opened.ReceivedAt) ? "—" : _opened.ReceivedAt)</dd>
                <dt>Created by</dt><dd>@_opened.CreatedBy.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Received by</dt><dd>@_opened.ReceivedBy.ToString(CultureInfo.InvariantCulture)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Line bodies omitted. Ship and receive stay on the Classic twin.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.NotesExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">notes excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.NotesExcerpt</pre>
                @if (_opened.NotesLen > _opened.NotesExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.NotesExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NotesLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No notes excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Transfer #</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.TransferNo) ? "—" : sib.TransferNo)</td>
                                <td>@sib.FromWarehouseId.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@sib.ToWarehouseId.ToString(CultureInfo.InvariantCulture)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "transfer_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Transfer #</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Items</th>
                    <th>Qty</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_transfers.Count == 0)
                {
                    <tr><td colspan="9">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _transfers)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.TransferNo) ? row.TransferNo : "—")</td>
                            <td>@row.FromWarehouseId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.ToWarehouseId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Reason) ? row.Reason : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@row.TotalItems.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.TotalQty.ToString("0.###", CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "transfer_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=inventory_mgmt&tab=inv_groups";
    private const string _listHref = "/erp/stock-transfers-app";
    private bool _isAdmin;
    private ErpStockTransfersSummary _summary = new(0, 0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<ErpStockTransferDigest> _transfers = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpStockTransferDetail? _opened;
    private IReadOnlyList<ErpStockTransferDigest> _openedSiblings = [];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.TransferNo)
            ? _opened.TransferNo
            : ("Transfer #" + _opened.Id.ToString(CultureInfo.InvariantCulture)));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?transfer_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "transfer_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildErpStockTransfersDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _transfers = result.Transfers;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpStockTransferDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Transfer;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _transfers.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _transfers = new[] { openedList }.Concat(_transfers.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }
}
