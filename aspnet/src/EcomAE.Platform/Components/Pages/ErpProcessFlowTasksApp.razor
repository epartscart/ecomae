@page "/erp/process-flow-tasks-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Process flow · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Process flow" BreadcrumbArea="Overview" BreadcrumbTab="Process flow">

    
    <PhpErpModulePageHeader Title="Process flow cases" Subtitle="Live shop digest. Writes stay on ERP ajax." PhpTabHref="@_phpTab" />


    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Process flow stats">
        <div class="kpi"><div class="lbl">Cases</div><div class="val">@_summary.TaskCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Open</div><div class="val">@_summary.OpenCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Done</div><div class="val">@_summary.DoneCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Overdue</div><div class="val">@_summary.OverdueCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Cancelled/rejected</div><div class="val">@_summary.CancelledCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Title</th>
                    <th>Reference</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Step</th>
                    <th>Assignee</th>
                    <th>Due</th>
                </tr>
            </thead>
            <tbody>
                @if (_tasks.Count == 0)
                {
                    <tr><td colspan="8">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "Nothing to show yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _tasks)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.Title</td>
                            <td>@row.Reference</td>
                            <td>@row.Priority</td>
                            <td>@row.Status</td>
                            <td>@row.CurrentStepNo.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CurrentAssigneeId.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.DueAt.ToString(CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">
        Source: @_summary.Source. PHP <code>epc_erp_processflow.php</code> remains authoritative for case create/approve/reject.
        @if (!string.IsNullOrWhiteSpace(_summary.Message)) { <span> @_summary.Message</span> }
    </div>
</PhpErpDesktopChrome>

@code {
    private bool _isAdmin;
    private string _message = "";
    private ErpProcessFlowTasksSummary _summary = new(0, 0, 0, 0, 0, "migration", string.Empty);
    private IReadOnlyList<ErpProcessFlowTaskDigest> _tasks = [];
    private readonly string _phpTab = "/ERP/?epc_erp_shell=1&area=overview&tab=processflow";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null)
        {
            return;
        }

        var session = await Sessions.ValidateAsync(ctx);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildErpProcessFlowTasksDigestAsync(100);
        _summary = result.Summary;
        _tasks = result.Tasks;
        _message = result.Message;
    }
}
