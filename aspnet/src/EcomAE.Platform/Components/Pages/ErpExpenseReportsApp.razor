@page "/erp/expense-reports-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Expense Reports · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Expense Reports" BreadcrumbArea="People" BreadcrumbTab="Expenses">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/expense-reports-app" IsAdmin="_isAdmin" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_opened is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <PhpErpModulePageHeader Title="Expense Reports" Subtitle="Open a row for period dates and the 280-character notes excerpt. Save stays on the Classic twin." PhpTabHref="@_phpTab" />
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Expense Reports KPIs">
        <div class="kpi"><div class="lbl">Shown (limit @_limit)</div><div class="val">@_reports.Count</div></div>
        <div class="kpi"><div class="lbl">Digest source</div><div class="val">@_source</div></div>
        <div class="kpi"><div class="lbl">Session</div><div class="val">@(_isAdmin ? "live" : "guest")</div></div>
    </div>

    @if (_opened is not null)
    {
        <div class="epc-erp-table-wrap" style="margin-bottom:12px">
            <p style="margin:0 0 .5rem"><strong>@OpenedCaption</strong>
                <a class="btn btn-xs btn-default" href="@OpenedReturnHref">This row</a>
                <a class="btn btn-xs btn-default" href="@_listHref">Close</a>
            </p>
            <dl style="display:grid;grid-template-columns:8rem 1fr;gap:.35rem .75rem;margin:0;font-size:.9rem;">
                <dt>ID</dt><dd>@_opened.Id.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Report #</dt><dd>@(string.IsNullOrWhiteSpace(_opened.ReportNo) ? "—" : _opened.ReportNo)</dd>
                <dt>Title</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Title) ? "—" : _opened.Title)</dd>
                <dt>Staff</dt><dd>@(_opened.StaffUserId > 0 ? _opened.StaffUserId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Amount</dt><dd>@_opened.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</dd>
                <dt>Status</dt><dd>@(string.IsNullOrWhiteSpace(_opened.Status) ? "—" : _opened.Status)</dd>
                <dt>Period from</dt><dd>@FormatTime(_opened.PeriodFrom)</dd>
                <dt>Period to</dt><dd>@FormatTime(_opened.PeriodTo)</dd>
                <dt>Cash entry</dt><dd>@(_opened.CashEntryId > 0 ? _opened.CashEntryId.ToString(CultureInfo.InvariantCulture) : "—")</dd>
                <dt>Updated</dt><dd>@FormatTime(_opened.TimeUpdated)</dd>
            </dl>
            <p class="text-muted" style="margin:.85rem 0 0">Save stays on the Classic twin.</p>
            @if (!string.IsNullOrWhiteSpace(_opened.NotesExcerpt))
            {
                <p class="text-muted" style="margin:.85rem 0 .35rem">notes excerpt</p>
                <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_opened.NotesExcerpt</pre>
                @if (_opened.NotesLen > _opened.NotesExcerpt.Length)
                {
                    <p class="text-muted">Excerpt only (@_opened.NotesExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_opened.NotesLen.ToString(CultureInfo.InvariantCulture) chars).</p>
                }
            }
            else
            {
                <p class="text-muted" style="margin:.85rem 0 0">No notes excerpt yet.</p>
            }
            @if (_openedSiblings.Count > 0)
            {
                <p class="text-muted" style="margin:1rem 0 .4rem">Same-status siblings</p>
                <table class="table table-bordered table-condensed table-epc epc-erp-table">
                    <thead>
                        <tr>
                            <th>Report #</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sib in _openedSiblings)
                        {
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(sib.ReportNo) ? "—" : sib.ReportNo)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Title) ? "—" : sib.Title)</td>
                                <td>@(string.IsNullOrWhiteSpace(sib.Status) ? "—" : sib.Status)</td>
                                <td><a class="btn btn-xs btn-default" href="@ErpRecordOpen.Href(_listHref, "expense_id", sib.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No same-status siblings yet.</p>
            }
        </div>
    }

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Report #</th>
                    <th>Title</th>
                    <th>Staff</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_reports.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _reports)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td><strong>@(string.IsNullOrWhiteSpace(row.ReportNo) ? $"#{row.Id}" : row.ReportNo)</strong></td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.Title) ? $"#{row.Id}" : row.Title)</strong></td>
                            <td>@(row.StaffUserId > 0 ? row.StaffUserId.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@row.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><span class="label label-default">@row.Status</span></td>
                            <td>@FormatTime(row.TimeUpdated)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "expense_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="epc-erp-empty" style="display:block;margin-top:12px;padding:8px 10px;border:1px solid #c5d4de;background:#f8fafc;color:#475569;font-size:12px;">@_message</div>
    }

</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=people&tab=expense_reports";
    private const string _listHref = "/erp/expense-reports-app";
    private bool _isAdmin;
    private IReadOnlyList<ErpExpenseReportDigest> _reports = [];
    private int _limit = 100;
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private ErpExpenseReportDetail? _opened;
    private IReadOnlyList<ErpExpenseReportDigest> _openedSiblings = [];

    private string OpenedCaption => _opened is null
        ? ""
        : (!string.IsNullOrWhiteSpace(_opened.ReportNo)
            ? _opened.ReportNo
            : (!string.IsNullOrWhiteSpace(_opened.Title)
                ? _opened.Title
                : ("Expense #" + _opened.Id.ToString(CultureInfo.InvariantCulture))));

    private string OpenedReturnHref => _openedId > 0
        ? _listHref + "?expense_id=" + _openedId.ToString(CultureInfo.InvariantCulture)
        : _listHref;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _openedId = ErpRecordOpen.ReadId(ctx.Request, "expense_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            _message = "Sign in for live data.";
            return;
        }

        var result = await Dashboards.ListErpExpenseReportsAsync(_limit, ctx.RequestAborted);
        _reports = result.Reports;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildErpExpenseReportDetailAsync(_openedId, ctx.RequestAborted);
            _opened = detail.Report;
            _openedSiblings = detail.Siblings;
            if (_opened is not null)
            {
                var openedList = _reports.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _reports = new[] { openedList }.Concat(_reports.Where(r => r.Id != _openedId)).ToList();
                }
            }
        }
    }

    private static string FormatTime(long unix)
    {
        if (unix <= 0) return "—";
        return DateTimeOffset.FromUnixTimeSeconds(unix).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }
}
