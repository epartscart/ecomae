@page "/erp/receivables-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Receivables · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Receivables" BreadcrumbArea="Accounts receivable" BreadcrumbTab="Receivables">

    <PhpErpModulePageHeader Title="Receivables"
                            Subtitle="Customer receivable balances — amounts owed on completed orders for this company."
                            PhpTabHref="@_phpTab">
        <a class="btn btn-sm btn-default" href="/erp/invoices-app">Invoices</a>
        <a class="btn btn-sm btn-default" href="/erp/aging-app">Aging</a>
    </PhpErpModulePageHeader>
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Receivables KPIs">
        <div class="kpi"><div class="lbl">Customers shown</div><div class="val">@_rows.Count</div></div>
        <div class="kpi"><div class="lbl">With open balance</div><div class="val">@_openCount</div></div>
        <div class="kpi"><div class="lbl">Receivable total</div><div class="val">@_summary.ArGrand.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Customer</th>
                    @foreach (var l in _labels) { <th>@l</th> }
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="@(_labels.Count + 2)">@(_isAdmin ? "Nothing to show yet." : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var r in _rows)
                    {
                        <tr>
                            <td>@r.Name</td>
                            <td>@r.Bucket0.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@r.Bucket1.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@r.Bucket2.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@r.Bucket3.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@r.Bucket4.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@r.Total.ToString("N2", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-note alert alert-info" style="margin-top:12px;">
        Matches ERP menu <strong>Receivables</strong> (Accounts receivable). Source: @_summary.Source.
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=ar&tab=receivables";
    private bool _isAdmin;
    private ErpAgingSummary _summary = new(30, 60, 90, 0, 0, 0, "migration", string.Empty);
    private IReadOnlyList<string> _labels = [];
    private IReadOnlyList<ErpAgingPartyDigest> _rows = [];
    private int _openCount;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("erp");
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildErpAgingDigestAsync(100, ctx.RequestAborted);
        _summary = result.Summary;
        _labels = result.ArLabels;
        _rows = result.ArRows;
        _openCount = _rows.Count(r => r.Total != 0m);
    }
}
