@page "/erp/receivables-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Receivables · ERP · eParts Cart</PageTitle>
<PhpChromeStyles Surface="erp" />
<PhpErpDesktopChrome IsAdmin="_isAdmin" Title="Receivables" BreadcrumbArea="Accounts receivable" BreadcrumbTab="Receivables">
    <PhpParityModuleBody ShowGhostScaffold="false" AppPath="/erp/receivables-app" IsAdmin="_isAdmin" />


    <PhpErpModulePageHeader Title="Receivables"
                            Subtitle="Customer receivable balances — shop accounting plus open order due."
                            PhpTabHref="@_phpTab">
        <a class="btn btn-sm btn-default" href="/erp/invoices-app">Invoices</a>
        <a class="btn btn-sm btn-default" href="/erp/aging-app">Aging</a>
    </PhpErpModulePageHeader>
    <PhpErpD365ActionPane PhpTabHref="@_phpTab" RefreshHref="@Nav.Uri" />
    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedRow is not null)" Caption="@OpenedCaption" ListHref="/erp/receivables-app" />

    @if (!string.IsNullOrWhiteSpace(_flashOk))
    {
        <div class="alert alert-success" role="status" style="margin:0 0 12px;padding:.7rem .9rem;border-radius:.4rem;background:#ecfdf5;color:#065f46">@_flashOk</div>
    }
    @if (!string.IsNullOrWhiteSpace(_flashErr))
    {
        <div class="alert alert-danger" role="status" style="margin:0 0 12px;padding:.7rem .9rem;border-radius:.4rem;background:#fef2f2;color:#991b1b">@_flashErr</div>
    }
    @if (_isAdmin)
    {
        <form method="post" action="/erp/customers/master-save" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/receivables-app" />
            <label>Customer ID <input type="number" name="customer_id" min="1" required style="width:6rem" /></label>
            <label>Account <input type="text" name="customer_account" maxlength="32" placeholder="C-0001" /></label>
            <label>Name <input type="text" name="customer_name" maxlength="255" /></label>
            <label>Credit limit <input type="text" name="credit_limit" placeholder="0.00" /></label>
            <label>Terms days <input type="number" name="terms_days" min="0" style="width:5rem" /></label>
            <label>Currency <input type="text" name="currency_code" maxlength="8" placeholder="AED" /></label>
            <label><input type="checkbox" name="on_hold" value="1" /> On credit hold</label>
            <button type="submit" class="btn btn-sm btn-primary">Save customer master</button>
        </form>
        <form method="post" action="/erp/customers/settlement" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:end;margin:0 0 1rem">
            <input type="hidden" name="confirmWrites" value="true" />
            <input type="hidden" name="returnUrl" value="/erp/receivables-app" />
            <label>Customer ID <input type="number" name="user_id" min="1" required style="width:6rem" /></label>
            <label>Amount <input type="text" name="amount" required placeholder="0.00" /></label>
            <label>Direction
                <select name="direction">
                    <option value="credit">credit</option>
                    <option value="debit">debit</option>
                </select>
            </label>
            <label>Kind
                <select name="entry_kind">
                    <option value="adjustment">adjustment</option>
                    <option value="settlement">settlement</option>
                    <option value="write_off">write_off</option>
                </select>
            </label>
            <label>Reference <input type="text" name="reference" /></label>
            <label>Note <input type="text" name="note" /></label>
            <button type="submit" class="btn btn-sm btn-primary">Post customer settlement</button>
        </form>
    }

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Receivables KPIs">
        <div class="kpi"><div class="lbl">Customers shown</div><div class="val">@_summary.CustomerCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">With open balance</div><div class="val">@_summary.WithOpenBalance.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Balance total</div><div class="val">@_summary.BalanceTotal.ToString("N2", CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Order due</div><div class="val">@_summary.DueTotal.ToString("N2", CultureInfo.InvariantCulture)</div></div>
    </div>

    <div class="epc-erp-table-wrap">
        <table class="table table-striped table-bordered table-condensed table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>User ID</th>
                    <th>Email</th>
                    <th>Balance</th>
                    <th>Order receivable due</th>
                    <th>Orders</th>
                    <th>Complete</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="7">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with ERP capability for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var r in _rows)
                    {
                        <tr id="erp-row-@r.UserId.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(r.UserId, _openedId)">
                            <td>@r.UserId.ToString(CultureInfo.InvariantCulture)</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(r.Email) ? $"#{r.UserId}" : r.Email)</strong></td>
                            <td>@r.Balance.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@r.OrderReceivableDue.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@r.OrderCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@r.CompleteOrderCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href("/erp/receivables-app", "customer_id", r.UserId)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="epc-erp-note alert alert-info" style="margin-top:12px;">
        Matches ERP menu <strong>Receivables</strong> (Accounts receivable). Source: @_summary.Source.
    </div>
</PhpErpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=ar&tab=receivables";
    private bool _isAdmin;
    private ErpReceivablesSummary _summary = new(0, 0, 0, 0, 0, "n/a", string.Empty);
    private IReadOnlyList<ErpReceivableDigest> _rows = [];
    private string _message = "";
    private string _flashOk = "";
    private string _flashErr = "";
    private long _openedId;
    private ErpReceivableDigest? _openedRow;
    private string OpenedCaption => _openedRow is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedRow.Email) ? $"Customer #{_openedRow.UserId}" : _openedRow.Email);

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        _flashOk = ctx.Request.Query["ok"].ToString() ?? "";
        _flashErr = ctx.Request.Query["err"].ToString() ?? "";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "customer_id", "user_id");
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return;
        }

        var result = await Dashboards.BuildErpReceivablesDigestAsync(300, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Customers;
        _openedRow = _openedId > 0 ? _rows.FirstOrDefault(r => r.UserId == _openedId) : null;
        if (_openedRow is not null)
        {
            _rows = new[] { _openedRow }.Concat(_rows.Where(r => r.UserId != _openedId)).ToList();
        }
        _message = result.Message;
    }
}
