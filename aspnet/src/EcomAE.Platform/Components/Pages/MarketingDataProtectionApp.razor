@page "/marketing/data-protection"
@layout Layout.PhpChromeLayout
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http

<PageTitle>ECOM AE — Data protection (PHP parity preview)</PageTitle>
<PhpChromeStyles Surface="marketing" />

<PhpEcomaeMarketingChrome ActiveKey="data_protection">
    <PhpHybridWorkspaceFrame PhpHref="@_phpHref" ClearHref="/marketing/data-protection" />

    @if (string.IsNullOrWhiteSpace(_phpHref))
    {
        <PhpEcomaeLegalAliasOverview
            Title="Data protection"
            Badge="Data protection"
            Icon="fa-database"
            GradientStart="#1e3a8a"
            GradientMid="#3b82f6"
            PhpSlug="data-protection"
            AspNetRoute="/marketing/data-protection"
            Lead="Data protection commitments across hosted commerce and ERP. Full policy text remains on live PHP until dual-sample."
            CardOne="How personal and tenant data is safeguarded." />
    }
</PhpEcomaeMarketingChrome>

@code {
    private string? _phpHref;

    protected override void OnInitialized()
    {
        var ctx = Http.HttpContext;
        if (ctx?.Request.Query.TryGetValue("php", out var php) == true && !string.IsNullOrWhiteSpace(php))
        {
            _phpHref = php.ToString();
        }
    }
}
