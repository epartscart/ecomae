@page "/cp/debug-console-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Debug console · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Debug console
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/debug-console-app")</p>
                <p>Allowlisted debug temp log metadata (basename dmY_Hi.php only). File contents are not exposed.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/debug-console-app" IsAdmin="_isAdmin" />

    <p class="help-block">@_summary.FileCount.ToString(CultureInfo.InvariantCulture) Files · @_summary.TmpRootPresent.ToString(CultureInfo.InvariantCulture) Tmp root · @_summary.AllowlistOnly.ToString(CultureInfo.InvariantCulture) Allowlist only · @_summary.TotalBytes.ToString(CultureInfo.InvariantCulture) Total bytes.</p>
    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
        <thead><tr><th>Basename</th><th>Size</th><th>Modified</th><th></th></tr></thead>
        <tbody>
        @if (_rows.Count==0) { <tr><td colspan="4">No records yet.</td></tr> }
        else { @foreach (var row in _rows) { <tr><td>@row.Basename</td><td>@row.SizeBytes</td><td>@row.LastModifiedUnix</td><td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td></tr> } }
        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>
@code {
    private const string _phpTab = "/CP/system/debug";
    private bool _isAdmin;
    private CpDebugConsoleSummary _summary = new(0, 0, 1, 0, "n/a", "");
    private IReadOnlyList<CpDebugConsoleRowDigest> _rows = [];
    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpDebugConsoleDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Files;
    }
}
