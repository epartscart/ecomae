@page "/cp/blockchain-proofs-app"
@page "/erp/blockchain-proofs-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Blockchain proofs · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Blockchain proofs
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/blockchain-proofs-app")</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/blockchain-proofs-app" IsAdmin="_isAdmin" />


    <p class="help-block">@_summary.ProofCount.ToString(CultureInfo.InvariantCulture) Proofs · @_summary.PendingCount.ToString(CultureInfo.InvariantCulture) Pending · @_summary.AnchoredCount.ToString(CultureInfo.InvariantCulture) Anchored · @_summary.BatchCount.ToString(CultureInfo.InvariantCulture) Batches.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Proof UID</th>
                    <th>Tenant</th>
                    <th>Type</th>
                    <th>Record</th>
                    <th>Status</th>
                    <th>Batch</th>
                    <th>Anchor</th>
                    <th>Hash</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="11">No records yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ProofUid) ? row.ProofUid : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.TenantKey) ? row.TenantKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.RecordType) ? row.RecordType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.RecordId) ? row.RecordId : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@(row.BatchId.HasValue ? row.BatchId.Value.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.AnchorRef) ? row.AnchorRef : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PayloadHash) ? row.PayloadHash : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CreatedAt) ? row.CreatedAt : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=tax&tab=blockchain_proofs";
    private bool _isAdmin;
    private CpBlockchainProofsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpBlockchainProofDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpBlockchainProofsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Proofs;
        _source = result.Source;
        _message = result.Message;
    }
}
