@page "/cp/blockchain-proofs-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http
@inject NavigationManager Nav

<PageTitle>Blockchain proofs · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<HeadContent>
<style>
        .epc-bc-hero {
            margin-bottom:1rem; padding:1.1rem 1.2rem; border-radius:.7rem; color:#fff;
            background:linear-gradient(135deg,#0c4a6e 0%,#2563eb 45%,#0ea5e9 100%);
        }
        .epc-bc-hero h1 { margin:.25rem 0 .35rem; font-size:clamp(1.35rem,2.8vw,1.85rem); }
        .epc-bc-hero p { margin:0; color:rgba(255,255,255,.88); max-width:44rem; font-size:.92rem; line-height:1.45; }
        .epc-bc-cta { display:flex; gap:.45rem; flex-wrap:wrap; margin-top:.85rem; }
        .epc-bc-cta a {
            display:inline-flex; padding:.5rem .8rem; border-radius:.4rem; font-weight:700; font-size:.82rem;
            text-decoration:none; color:#1e1b4b; background:#fff;
        }
        .epc-bc-cta a.ghost { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff; }
        .epc-bc-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin-bottom:1rem; }
        .epc-bc-kpi { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; padding:.85rem .9rem; }
        .epc-bc-kpi strong { display:block; font-size:1.2rem; word-break:break-word; }
        .epc-bc-kpi span { color:#64748b; font-size:.78rem; }
        .epc-bc-table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:.55rem; overflow:auto; }
        .epc-bc-table { width:100%; border-collapse:collapse; font-size:.86rem; }
        .epc-bc-table th, .epc-bc-table td { padding:.55rem .7rem; border-bottom:1px solid #f1f5f9; text-align:left; white-space:nowrap; }
        .epc-bc-table th { background:#f8fafc; color:#475569; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; }
        .epc-bc-note { margin-top:1rem; padding:.75rem .9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:.45rem; color:#334155; font-size:.86rem; }
        @@media (max-width:900px){ .epc-bc-kpis{grid-template-columns:1fr 1fr;} }
    
</style>
</HeadContent>


<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <section class="epc-bc-hero">
        <img src="@LegacyPresentationAssets.BrandMarkUrl" alt="ECOM AE" style="height:28px;background:#fff;border-radius:4px;padding:2px" />
        <h1>Blockchain proofs</h1>
        <p>Manage store operations, catalogue, and partner integrations from one control panel.</p>
        <div class="epc-bc-cta">
            <a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open module</a>
        </div>
    </section>

    <div class="epc-bc-kpis" aria-label="Blockchain proofs stats">
        <div class="epc-bc-kpi"><strong>@_summary.ProofCount.ToString(CultureInfo.InvariantCulture)</strong><span>Proofs</span></div>
        <div class="epc-bc-kpi"><strong>@_summary.PendingCount.ToString(CultureInfo.InvariantCulture)</strong><span>Pending</span></div>
        <div class="epc-bc-kpi"><strong>@_summary.AnchoredCount.ToString(CultureInfo.InvariantCulture)</strong><span>Anchored</span></div>
        <div class="epc-bc-kpi"><strong>@_summary.BatchCount.ToString(CultureInfo.InvariantCulture)</strong><span>Batches</span></div>
    </div>

    <div class="epc-bc-table-wrap">
        <table class="epc-bc-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Proof UID</th>
                    <th>Tenant</th>
                    <th>Type</th>
                    <th>Record</th>
                    <th>Status</th>
                    <th>Batch</th>
                    <th>Anchor</th>
                    <th>Hash</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="11">Nothing to show yet.</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ProofUid) ? row.ProofUid : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.TenantKey) ? row.TenantKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.RecordType) ? row.RecordType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.RecordId) ? row.RecordId : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@(row.BatchId.HasValue ? row.BatchId.Value.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.AnchorRef) ? row.AnchorRef : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PayloadHash) ? row.PayloadHash : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CreatedAt) ? row.CreatedAt : "—")</td>
                            <td><a href="@PhpSurfaceLinkMap.AspNetPrimaryHref(_phpTab)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=tax&tab=blockchain_proofs";
    private bool _isAdmin;
    private CpBlockchainProofsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpBlockchainProofDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = session.Kind == LegacySessionKind.Admin && session.Capabilities.Contains("cp");
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpBlockchainProofsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Proofs;
        _source = result.Source;
        _message = result.Message;
    }
}
