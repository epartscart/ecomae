@page "/cp/blockchain-proofs-app"
@page "/erp/blockchain-proofs-app"
@layout Layout.PhpChromeLayout
@using System.Globalization
@using EcomAE.Platform.Auth
@using EcomAE.Platform.Migration
@using EcomAE.Platform.Presentation
@inject ISurfaceDashboardSummaryReporter Dashboards
@inject ILegacySessionValidator Sessions
@inject IHttpContextAccessor Http

<PageTitle>Blockchain proofs · Control Panel · eParts Cart</PageTitle>
<PhpChromeStyles Surface="cp" />
<PhpCpDesktopChrome IsAdmin="_isAdmin">

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">
                Blockchain proofs
                <a class="btn btn-xs btn-default pull-right" href="@PhpSurfaceLinkMap.PhpReferenceOnlyHref(_phpTab)">Classic twin</a>
            </div>
            <div class="panel-body">
                <p>@CpPhpModuleCopy.PurposeFor("/cp/blockchain-proofs-app")</p>
                <p>Open a proof for hash, anchor, a short payload excerpt, and batch siblings. Verify and Merkle path stay on the Classic twin.</p>
            </div>
        </div>
    </div>
    <PhpParityModuleBody AppPath="/cp/blockchain-proofs-app" IsAdmin="_isAdmin" ShowGhostScaffold="false" />

    <ErpOpenedRecordBanner Id="_openedId" Found="@(_openedProof is not null)" Caption="@OpenedCaption" ListHref="@_listHref" />

    <div class="epc-erp-kpi epc-erp-stat-row" aria-label="Blockchain proof KPIs">
        <div class="kpi"><div class="lbl">Proofs</div><div class="val">@_summary.ProofCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Pending</div><div class="val">@_summary.PendingCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Anchored</div><div class="val">@_summary.AnchoredCount.ToString(CultureInfo.InvariantCulture)</div></div>
        <div class="kpi"><div class="lbl">Batches</div><div class="val">@_summary.BatchCount.ToString(CultureInfo.InvariantCulture)</div></div>
    </div>

    @if (_openedProof is not null)
    {
        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">
                    @(!string.IsNullOrWhiteSpace(_openedProof.ProofUid) ? _openedProof.ProofUid : ("Proof #" + _openedProof.Id.ToString(CultureInfo.InvariantCulture)))
                    <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedProof.Status) ? _openedProof.Status : "—")</span>
                </div>
                <div class="panel-body">
                    <p>@(!string.IsNullOrWhiteSpace(_openedProof.RecordType) ? _openedProof.RecordType : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedProof.RecordId) ? _openedProof.RecordId : "—")
                        · @(!string.IsNullOrWhiteSpace(_openedProof.TenantKey) ? _openedProof.TenantKey : "—")</p>
                    <p>Hash @(!string.IsNullOrWhiteSpace(_openedProof.PayloadHash) ? _openedProof.PayloadHash : "—")</p>
                    @if (!string.IsNullOrWhiteSpace(_openedProof.AnchorRef))
                    {
                        <p>Anchor @_openedProof.AnchorRef</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedProof.AnchoredAt))
                    {
                        <p>Anchored @_openedProof.AnchoredAt · index @_openedProof.MerkleIndex.ToString(CultureInfo.InvariantCulture)</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_openedProof.PayloadExcerpt))
                    {
                        <pre style="max-height:12rem;overflow:auto;white-space:pre-wrap;margin:0">@_openedProof.PayloadExcerpt</pre>
                        @if (_openedProof.PayloadLen > _openedProof.PayloadExcerpt.Length)
                        {
                            <p class="text-muted">Excerpt only (@_openedProof.PayloadExcerpt.Length.ToString(CultureInfo.InvariantCulture) of @_openedProof.PayloadLen.ToString(CultureInfo.InvariantCulture) chars). Full payload and Merkle path stay on the Classic twin.</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No payload excerpt yet.</p>
                    }
                </div>
            </div>
        </div>

        @if (_openedBatch is not null)
        {
            <div class="col-lg-12">
                <div class="hpanel">
                    <div class="panel-heading hbuilt">
                        @(!string.IsNullOrWhiteSpace(_openedBatch.BatchUid) ? _openedBatch.BatchUid : ("Batch #" + _openedBatch.Id.ToString(CultureInfo.InvariantCulture)))
                        <span class="label label-default pull-right">@(!string.IsNullOrWhiteSpace(_openedBatch.Status) ? _openedBatch.Status : "—")</span>
                    </div>
                    <div class="panel-body">
                        <p>@_openedBatch.ProofCount.ToString(CultureInfo.InvariantCulture) proofs
                            · @(!string.IsNullOrWhiteSpace(_openedBatch.AnchorNetwork) ? _openedBatch.AnchorNetwork : "—")
                            · @(!string.IsNullOrWhiteSpace(_openedBatch.AnchoredAt) ? _openedBatch.AnchoredAt : "—")</p>
                        <p>Root @(!string.IsNullOrWhiteSpace(_openedBatch.MerkleRoot) ? _openedBatch.MerkleRoot : "—")</p>
                    </div>
                </div>
            </div>
        }

        <div class="col-lg-12">
            <div class="hpanel">
                <div class="panel-heading hbuilt">Batch siblings</div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Proof UID</th>
                                    <th>Type</th>
                                    <th>Record</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_openedSiblings.Count == 0)
                                {
                                    <tr><td colspan="5">No batch siblings yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var sib in _openedSiblings)
                                    {
                                        <tr>
                                            <td>@sib.Id.ToString(CultureInfo.InvariantCulture)</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.ProofUid) ? sib.ProofUid : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.RecordType) ? sib.RecordType : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.RecordId) ? sib.RecordId : "—")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(sib.Status) ? sib.Status : "—")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <p class="help-block">@_summary.ProofCount.ToString(CultureInfo.InvariantCulture) Proofs · @_summary.PendingCount.ToString(CultureInfo.InvariantCulture) Pending · @_summary.AnchoredCount.ToString(CultureInfo.InvariantCulture) Anchored · @_summary.BatchCount.ToString(CultureInfo.InvariantCulture) Batches.</p>

    <div class="col-lg-12">
        <div class="hpanel">
            <div class="panel-heading hbuilt">Records</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table cellpadding="1" cellspacing="1" class="table table-condensed table-striped table-bordered table-epc epc-erp-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Proof UID</th>
                    <th>Tenant</th>
                    <th>Type</th>
                    <th>Record</th>
                    <th>Status</th>
                    <th>Batch</th>
                    <th>Anchor</th>
                    <th>Hash</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="11">@(_isAdmin ? (string.IsNullOrWhiteSpace(_message) ? "No records yet." : _message) : "Sign in with a staff session for live rows.")</td></tr>
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        <tr id="erp-row-@row.Id.ToString(CultureInfo.InvariantCulture)" class="@ErpRecordOpen.RowClass(row.Id, _openedId)">
                            <td>@row.Id.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.ProofUid) ? row.ProofUid : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.TenantKey) ? row.TenantKey : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.RecordType) ? row.RecordType : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.RecordId) ? row.RecordId : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.Status) ? row.Status : "—")</td>
                            <td>@(row.BatchId.HasValue ? row.BatchId.Value.ToString(CultureInfo.InvariantCulture) : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.AnchorRef) ? row.AnchorRef : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.PayloadHash) ? row.PayloadHash : "—")</td>
                            <td>@(!string.IsNullOrWhiteSpace(row.CreatedAt) ? row.CreatedAt : "—")</td>
                            <td><a class="btn btn-xs btn-primary" href="@ErpRecordOpen.Href(_listHref, "proof_id", row.Id)">Open</a></td>
                        </tr>
                    }
                }
            </tbody>
                        </table>
                </div>
            </div>
        </div>
    </div>

</PhpCpDesktopChrome>

@code {
    private const string _phpTab = "/ERP/?epc_erp_shell=1&area=tax&tab=blockchain_proofs";
    private bool _isAdmin;
    private CpBlockchainProofsSummary _summary = new(0, 0, 0, 0, "n/a", "");
    private IReadOnlyList<CpBlockchainProofDigest> _rows = [];
    private string _source = "n/a";
    private string _message = "";
    private long _openedId;
    private CpBlockchainProofDetail? _openedProof;
    private CpBlockchainBatchDetail? _openedBatch;
    private IReadOnlyList<CpBlockchainBatchSiblingDigest> _openedSiblings = [];
    private string _listHref = "/cp/blockchain-proofs-app";

    private string OpenedCaption => _openedProof is null
        ? ""
        : (string.IsNullOrWhiteSpace(_openedProof.ProofUid)
            ? ("Proof #" + _openedProof.Id.ToString(CultureInfo.InvariantCulture))
            : _openedProof.ProofUid)
            + (string.IsNullOrWhiteSpace(_openedProof.Status) ? "" : (" · " + _openedProof.Status));

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;

        var path = ctx.Request.Path.Value;
        _listHref = string.Equals(path, "/erp/blockchain-proofs-app", StringComparison.OrdinalIgnoreCase)
            ? "/erp/blockchain-proofs-app"
            : "/cp/blockchain-proofs-app";
        _openedId = ErpRecordOpen.ReadId(ctx.Request, "proof_id");

        var session = await Sessions.ValidateAsync(ctx, ctx.RequestAborted);
        _isAdmin = PhpParityDumpCatalog.HasStaffAccess(session);
        if (!_isAdmin)
        {
            return; // guest browse — Sign in for live data
        }

        var result = await Dashboards.BuildCpBlockchainProofsDigestAsync(200, ctx.RequestAborted);
        _summary = result.Summary;
        _rows = result.Proofs;
        _source = result.Source;
        _message = result.Message;

        if (_openedId > 0)
        {
            var detail = await Dashboards.BuildCpBlockchainProofDetailAsync(_openedId, ctx.RequestAborted);
            _openedProof = detail.Proof;
            _openedBatch = detail.Batch;
            _openedSiblings = detail.Siblings;
            if (_openedProof is not null)
            {
                var openedList = _rows.FirstOrDefault(r => r.Id == _openedId);
                if (openedList is not null)
                {
                    _rows = new[] { openedList }.Concat(_rows.Where(r => r.Id != _openedId)).ToList();
                }
            }
            else if (!string.IsNullOrWhiteSpace(detail.Message))
            {
                _message = detail.Message;
            }
        }
    }
}
