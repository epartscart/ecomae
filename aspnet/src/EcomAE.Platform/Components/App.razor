@using EcomAE.Platform.Middleware
@using EcomAE.Platform.Presentation
@inject IHttpContextAccessor Http
<!DOCTYPE html>
<html lang="@_htmlLang" dir="@_htmlDir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Public storefront/marketing: index,follow. CP/ERP/BOS and private apps: noindex.
       CHPU brand+article pages own stock-aware robots in StorefrontSearchApp (avoid dual tags). *@
    @if (!StorefrontPublicSeo.PageOwnsRobotsMeta(Http.HttpContext?.Request.Path.Value))
    {
        <meta name="robots" content="@StorefrontPublicSeo.RobotsContentFor(Http.HttpContext)" />
    }
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="/assets/media/logos/ecomae_mark.svg" />
    <AdminCsrfGuardBridge />
    <HeadOutlet />
</head>
<body>
    <Routes />
</body>
</html>

@code {
    private string _htmlLang = "en";
    private string _htmlDir = "ltr";

    /// <summary>RTL languages served by the lang homes: Arabic and Urdu.</summary>
    private static string DirFor(string lang)
        => lang is "ar" or "ur" ? "rtl" : "ltr";

    protected override void OnInitialized()
    {
        _htmlLang = LangHomeFallbackMiddleware.RequestCmsLang(Http.HttpContext, "en");
        _htmlDir = DirFor(_htmlLang);

        // An explicit lang home (/en/, /ar/, /ur/, /ru/) is a visitor pick — it wins over
        // the country host's configured language (e.g. /en/ on sa. stays English).
        var picked = Http.HttpContext?.Items[LangHomeFallbackMiddleware.LangItem] as string;
        if (!string.IsNullOrEmpty(picked))
        {
            _htmlLang = picked;
            _htmlDir = DirFor(picked);
            return;
        }

        // Country storefronts (ae./qa./sa.…) pin lang/dir to the country's configured
        // language unless the visitor picked a language in the URL/session.
        var cSub = Http.HttpContext is null
            ? null
            : EcomAE.Platform.Storefront.StorefrontCountryDefaults.SubdomainOf(Http.HttpContext.Request.Host.Host);
        var ctry = cSub is null ? null : EcomAE.Platform.Storefront.StorefrontCountryDefaults.Default(cSub);
        if (ctry is not null && string.IsNullOrWhiteSpace(Http.HttpContext!.Request.Query["lang"]))
        {
            _htmlLang = ctry.LanguageCode;
            _htmlDir = ctry.Direction;
        }
    }
}
