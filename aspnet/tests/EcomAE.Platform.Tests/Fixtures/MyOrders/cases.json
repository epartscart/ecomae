{
  "schema": [
    "CREATE TABLE `shop_orders` (`id` int(11) NOT NULL AUTO_INCREMENT, `user_id` int(11) NOT NULL DEFAULT 0, `time` int(11) NOT NULL DEFAULT 0, `office_id` int(11) NOT NULL DEFAULT 0, `status` int(11) NOT NULL DEFAULT 0, `paid` tinyint(4) NOT NULL DEFAULT 0, `paid_type` int(11) NOT NULL DEFAULT 0, `how_get` int(11) NOT NULL DEFAULT 0, PRIMARY KEY (`id`))",
    "CREATE TABLE `shop_orders_items` (`id` int(11) NOT NULL AUTO_INCREMENT, `order_id` int(11) NOT NULL, `status` int(11) NOT NULL DEFAULT 0, `price` decimal(12,2) NOT NULL DEFAULT 0, `count_need` int(11) NOT NULL DEFAULT 1, `t2_manufacturer` varchar(64) NOT NULL DEFAULT '', `t2_article` varchar(64) NOT NULL DEFAULT '', `t2_name` varchar(128) NOT NULL DEFAULT '', PRIMARY KEY (`id`))",
    "CREATE TABLE `shop_orders_statuses_ref` (`id` int(11) NOT NULL, `name` varchar(64) NOT NULL, `color` varchar(16) NOT NULL DEFAULT '', `order` int(11) NOT NULL DEFAULT 0, PRIMARY KEY (`id`))",
    "CREATE TABLE `shop_orders_items_statuses_ref` (`id` int(11) NOT NULL, `name` varchar(64) NOT NULL, `color` varchar(16) NOT NULL DEFAULT '', `order` int(11) NOT NULL DEFAULT 0, `count_flag` tinyint(1) NOT NULL DEFAULT 1, PRIMARY KEY (`id`))",
    "CREATE TABLE `shop_offices` (`id` int(11) NOT NULL, `caption` varchar(128) NOT NULL DEFAULT '', PRIMARY KEY (`id`))",
    "CREATE TABLE `shop_obtaining_modes` (`id` int(11) NOT NULL, `caption` varchar(128) NOT NULL DEFAULT '', PRIMARY KEY (`id`))",
    "CREATE TABLE `shop_orders_paid_type` (`id` int(11) NOT NULL, `name` varchar(64) NOT NULL, `active` tinyint(1) NOT NULL DEFAULT 1, `order` int(11) NOT NULL DEFAULT 0, PRIMARY KEY (`id`))",
    "CREATE TABLE `shop_docpart_garage` (`id` int(11) NOT NULL, `user_id` int(11) NOT NULL, `caption` varchar(128) NOT NULL DEFAULT '', `active` tinyint(1) NOT NULL DEFAULT 1, PRIMARY KEY (`id`))",
    "CREATE TABLE `shop_docpart_garage_orders` (`id` int(11) NOT NULL AUTO_INCREMENT, `order_id` int(11) NOT NULL, `garage_id` int(11) NOT NULL, PRIMARY KEY (`id`))",
    "CREATE TABLE `shop_orders_messages` (`id` int(11) NOT NULL AUTO_INCREMENT, `order_id` int(11) NOT NULL, `read` tinyint(1) NOT NULL DEFAULT 0, `is_customer` tinyint(1) NOT NULL DEFAULT 0, PRIMARY KEY (`id`))"
  ],
