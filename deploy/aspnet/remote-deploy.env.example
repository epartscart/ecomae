# Remote deployment environment template. Copy locally and export values from a secret-safe shell.
# Do not commit filled values.

ECOMAE_PROD_HOST=31.97.216.247
ECOMAE_PROD_SSH_USER=root
ECOMAE_PROD_SSH_PORT=22
ECOMAE_PROD_REPO_URL=git@github.com:your-org/ecomae.git
ECOMAE_PROD_BRANCH=work
ECOMAE_PROD_WORKDIR=/opt/ecomae-aspnet-source
ECOMAE_ASPNET_RELEASE_ROOT=/var/www/ecomae-aspnet

# Safety switches: dry-run unless explicitly enabled.
ECOMAE_RUN_REMOTE_DEPLOY=0
ECOMAE_RUN_SYSTEMD=0
ECOMAE_RUN_NGINX_RELOAD=0
