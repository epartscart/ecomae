# EcomAE ASP.NET production environment template.
# Copy to /etc/ecomae-aspnet/platform.env and set chmod 600.
# Never commit real credentials.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5100

# Keep PHP authoritative until parity/cutover reports approve each route.
MigrationRouteCutover__ApiShadowTrafficEnabled=true
MigrationRouteCutover__StorefrontAspNetEnabled=false
MigrationRouteCutover__AdminAspNetEnabled=false
MigrationRouteCutover__RequirePhpFallback=true

EcomAE__PlatformHost=www.ecomae.com
EcomAE__DefaultBackendPath=/CP
EcomAE__DefaultErpPath=/ERP
EcomAE__DefaultBosPath=/BOS
EcomAE__TenantRegistryConnectionStringName=TenantRegistry

# Fill on the server or in a secret manager; do not store real values in Git.
ConnectionStrings__TenantRegistry=Server=127.0.0.1;Database=ecomae;User=<db_user>;Password=<db_password>;TreatTinyAsBoolean=true;

# Price lookup repository selection:
# - FixtureCsvPath: captured PHP/staging CSV for offline parity only.
# - Leave FixtureCsvPath empty in staging/prod to use DbPriceOfferRepository
#   against shop_docpart_prices_data (read-only; PHP remains fallback).
PriceLookup__FixtureCsvPath=
PriceLookup__ConnectionStringName=TenantRegistry
PriceLookup__DatabaseName=
# Keep true for PHP-parity API-key auth on /api/v1/price/lookup.
PriceLookup__RequireApiClientAuth=true

# Optional final-gate smoke keys (server-only). Used by:
#   bash scripts/cloudpanel_validate_final_gate_env.sh
#   bash scripts/cloudpanel_capture_final_gate_artifacts.sh
#   bash scripts/cloudpanel_commit_final_gate_smoke.sh
# Do NOT flip StorefrontAspNetEnabled / AdminAspNetEnabled to true here.
# Do NOT set RequirePhpFallback=false until release-owner approval exists.
# Never commit real values.
ECOMAE_PRICE_LOOKUP_API_KEY=
# Must start with epc_pricepro_ (issued on onboarding / API clients).
ECOMAE_CATALOG_API_KEY=
# Must start with epc_catalog_.
# Admin digest smoke — provide ONE of:
# ECOMAE_ADMIN_COOKIE_HEADER='admin_session=...; admin_u_id=123'
# ECOMAE_ADMIN_COOKIE_JAR=/path/to/cookie.jar
# Cookie header must include both admin_session= and numeric admin_u_id=.
# ECOMAE_ADMIN_COOKIE_HEADER=
# ECOMAE_ADMIN_COOKIE_JAR=
# Optional storefront customer digests (not required for ReadyToRemovePhp checklist):
# ECOMAE_CUSTOMER_COOKIE_HEADER='session=...; u_id=123'
# ECOMAE_CUSTOMER_COOKIE_JAR=/path/to/customer.cookie.jar
# Then: RUN_STOREFRONT_DIGEST_SMOKE=1 bash tests/live_smoke/run_storefront_digest_exact_route_smoke.sh

# Smoke issuer: TenantRegistry Database= must be the DB ASP.NET reads for keys/sessions.
# Prefer Database= matching PHP DP_Config (often ecomae). If set to asap without DDL rights:
#   bash scripts/cloudpanel_diagnose_smoke_db.sh
#   ECOMAE_CONFIRM_APPLY_EPC_API_CLIENTS_DDL=YES bash scripts/cloudpanel_apply_epc_api_clients_ddl.sh  # clpctl master
#   # or C: ECOMAE_CONFIRM_USE_PHP_DP_CONFIG_AS_TENANT_REGISTRY=YES ECOMAE_CONFIRM_RESTART_PLATFORM=YES \
#   #         bash scripts/cloudpanel_use_php_dp_config_as_tenant_registry.sh
#   ECOMAE_CONFIRM_ISSUE_SMOKE_CREDS=YES ECOMAE_CONFIRM_SYNC_ADMIN_SESSION=YES \
#     bash scripts/cloudpanel_issue_smoke_credentials.sh
# ECOMAE_PHP_DOCROOT=/home/ecomae/htdocs/www.ecomae.com
# ECOMAE_SMOKE_DB_HOST=127.0.0.1
# ECOMAE_SMOKE_DB_NAME=
# ECOMAE_SMOKE_DB_USER=
# ECOMAE_SMOKE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Enterprise BOS scaffolding options (DESIGN ONLY — keep disabled).
# Full JSON example: deploy/aspnet/ecomae-scaffold-options.example.json
# Validate: bash scripts/validate_enterprise_bos_scaffold_guardrails.sh
# Also: python3 scripts/validate_migration_evidence_cutover_locks.py
#       python3 scripts/validate_presentation_hybrid_allowlist_sync.py
# Do NOT enable Replace*/AllowPublish/Register*/ExposePublicEndpoint flags.
# Do NOT invent RELEASE_OWNER_APPROVAL.md. cutoverAllowed stays false.
# ---------------------------------------------------------------------------
# EcomAe__Postgres__Enabled=false
# EcomAe__Postgres__ReplaceMysqlBridge=false
# EcomAe__Redis__Enabled=false
# EcomAe__Redis__ReplacePhpSessionCookies=false
# EcomAe__Kafka__Enabled=false
# EcomAe__Kafka__AllowPublish=false
# EcomAe__RabbitMq__Enabled=false
# EcomAe__RabbitMq__AllowPublish=false
# EcomAe__OpenSearch__Enabled=false
# EcomAe__OpenSearch__ReplacePhpSearch=false
# EcomAe__ObjectStorage__Enabled=false
# EcomAe__ObjectStorage__ReplaceLocalFilePaths=false
# EcomAe__Vault__Enabled=false
# EcomAe__Vault__ReplaceEnvFileSecrets=false
# EcomAe__OAuth__Enabled=false
# EcomAe__OAuth__ReplacePhpCookieBridge=false
# EcomAe__Spa__Enabled=false
# EcomAe__Spa__ReplaceBlazorHybridPresentation=false
# EcomAe__Serilog__Enabled=false
# EcomAe__Serilog__RegisterExporters=false
# EcomAe__Polly__Enabled=false
# EcomAe__Polly__RegisterPipelines=false
# EcomAe__GraphQl__Enabled=false
# EcomAe__GraphQl__ExposePublicEndpoint=false
# EcomAe__Grpc__Enabled=false
# EcomAe__Grpc__ExposePublicEndpoint=false
# EcomAe__Blockchain__Enabled=false
# EcomAe__Blockchain__UseAsBusinessSourceOfRecord=false
# EcomAe__RateLimit__Enabled=false
# EcomAe__RateLimit__ReplaceLegacyApiClientThrottle=false
# EcomAe__NativeAot__Enabled=false
# EcomAe__NativeAot__RequireForPlatformHost=false
# EcomAe__AiSidecar__Enabled=false
# EcomAe__AiSidecar__AllowBusinessWrites=false

# Dual-sample operators (always cutoverAllowed=false; never invent approval):
#   bash scripts/cloudpanel_run_all_dual_sample_operators.sh
#   bash scripts/cloudpanel_run_hybrid_ui_dual_sample_operator.sh
#   bash scripts/cloudpanel_run_login_cookie_dual_sample_operator.sh
#   bash scripts/cloudpanel_run_catalog_miss_dual_sample_operator.sh
#   bash scripts/cloudpanel_run_digest_dual_sample_operator.sh
