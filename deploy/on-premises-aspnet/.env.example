# ECOM AE ASP.NET on-premises. Copy to .env.
# Leave DB_PASSWORD empty until the operator supplies one.
# The installer will not invent a password or a MySQL user.

PUBLIC_HOST=erp.company.local
ASPNETCORE_URLS=http://0.0.0.0:5100
HTTP_PORT=5100

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=ecomae
DB_USER=ecomae
DB_PASSWORD=

# Optional license from Super CP. Empty disables license ping.
LICENSE_KEY=

# Do not set ECOMAE_CONFIRM_PHP_DECOMMISSION. This pack never installs PHP.
