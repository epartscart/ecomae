# ecomae ERP — Hybrid sync agent
# Copy to .env. Do not invent passwords. Leave LOCAL_DSN empty to use ./state JSON files.

SITE_KEY=acme
INSTALLATION_ID=inst_replace_me
ENROLLMENT_REQUEST_ID=enr_replace_me
CLOUD_BASE_URL=https://www.ecomae.com

# Optional. Operator-supplied DSN only. Never derived from an empty db_password.
# Example: mysql://ecomae:YOUR_PASSWORD@127.0.0.1:3306/ecomae_erp
LOCAL_DSN=

# Agent behaviour
CONFIRM_WRITES=0
CYCLE_SECONDS=300
STATE_DIR=./state
